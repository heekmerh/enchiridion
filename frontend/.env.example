# Server-only FastAPI URL for local development. Vercel Services injects this automatically.
BACKEND_URL=http://127.0.0.1:8000
# Flutterwave test public key for the book checkout; never put a secret key here.
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
# The same Supabase project the Android app uses (Project Settings > API). The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where "Open Enchiridion" sends website subscribers after payment.
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=YOUR_APPLICATION_ID
