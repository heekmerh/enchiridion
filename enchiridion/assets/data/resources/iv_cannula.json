      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "iv_cannula_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "iv_cannula_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/iv_cannula/image_01.png",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/iv_cannula/image_02.png",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "IV Cannula (Peripheral Venous Cannula)",
                    "Well-labelled parts"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Needle (Stylet) – sharp metal needle used to puncture the vein"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Catheter – flexible plastic tube that remains in the vein",
                    "Hub – connects catheter to IV line/syringe",
                    "Injection port – for drug administration without disconnecting line",
                    "Wings (Flanges) – help secure cannula to skin",
                    "Flashback chamber – shows blood return confirming venous entry",
                    "Protective cap – maintains sterility before use"
                  ]
                },
                {
                  "type": "checklist",
                  "items": [
                    "Uses",
                    "Administration of IV fluids (e.g., saline, dextrose)",
                    "Drug delivery (antibiotics, analgesics, emergency meds)",
                    "Blood transfusion",
                    "Parenteral nutrition",
                    "Repeated venous access (avoids multiple needle pricks)"
                  ]
                },
                {
                  "type": "checklist",
                  "items": [
                    "Advantages",
                    "Quick and easy to insert",
                    "Provides immediate vascular access",
                    "Less painful than repeated venepuncture",
                    "Allows continuous or intermittent drug/fluid administration",
                    "Widely available and cost-effective"
                  ]
                },
                {
                  "type": "checklist",
                  "items": [
                    "Disadvantages",
                    "Limited duration (usually 72–96 hours)",
                    "Risk of infection",
                    "Can cause discomfort or pain",
                    "Not suitable for long-term therapy (central line preferred)",
                    "May fail in patients with poor veins"
                  ]
                },
                {
                  "type": "checklist",
                  "items": [
                    "Precautions",
                    "Maintain strict aseptic technique",
                    "Choose appropriate site and size of cannula",
                    "Avoid areas of infection, edema, or joints if possible",
                    "Check for allergies (e.g., latex, antiseptics)",
                    "Secure properly to prevent dislodgement",
                    "Regularly inspect for signs of complications (redness, swelling)",
                    "Flush cannula to maintain patency",
                    "Remove as soon as no longer needed"
                  ]
                },
                {
                  "type": "checklist",
                  "items": [
                    "Complications",
                    "Phlebitis – inflammation of vein (pain, redness)",
                    "Infiltration – fluid leaks into surrounding tissue",
                    "Extravasation – leakage of irritant/vesicant drugs → tissue damage",
                    "Infection – local or systemic (sepsis)",
                    "Hematoma – due to vessel injury",
                    "Air embolism (rare but serious)",
                    "Thrombosis – clot formation in vein",
                    "Cannula blockage"
                  ]
                }
              ]
            }
          ]
        },
