              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“Hello, my name is ___, I’m a medical student. I’ve been asked to insert a cannula to give you fluids/medication.”"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Confirm patient identity",
                    "Explain procedure + purpose",
                    "Obtain consent"
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "iv_cannula_subsection_18",
          "subsection_title": "Preparation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "iv_cannula_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Wash hands 🧼"
                  ]
                }
              ]
            },
            {
              "group_id": "iv_cannula_group_2",
              "group_title": "Gather equipment",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Cannula (appropriate size)",
                    "Tourniquet",
                    "Alcohol swab",
                    "Gloves",
                    "Syringe + saline flush",
                    "Dressing",
                    "“Do you have any allergies (e.g., latex, antiseptics)?”"
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "iv_cannula_subsection_19",
          "subsection_title": "Position & Vein Selection",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "iv_cannula_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Apply tourniquet",
                    "Inspect & palpate vein",
                    "Say: “I will start distally and choose a suitable vein.”",
                    "👉 Preferred: dorsum of hand / forearm"
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "iv_cannula_subsection_20",
          "subsection_title": "Aseptic Technique",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "iv_cannula_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Clean skin with alcohol swab",
                    "Allow to air dry",
                    "Do not re-palpate (or re-clean if you do)"
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "iv_cannula_subsection_21",
          "subsection_title": "Insertion",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "iv_cannula_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Anchor skin",
                    "Insert cannula at 15–30° angle",
                    "Say: “I am advancing until I see a flashback.”",
                    "Once flashback seen → advance slightly",
                    "Thread catheter in, withdraw needle"
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "iv_cannula_subsection_22",
          "subsection_title": "Confirmation",
