              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Release tourniquet",
                    "Attach saline syringe",
                    "Flush gently",
                    "Say: “I’m checking for pain, swelling, or resistance.”",
                    "✔ Good = no pain, easy flow"
                  ]
                }
              ]
            }
          ]
        },
