      "section_id": "skin_hook_section_1",
      "section_title": "Skin hook",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "skin_hook_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "skin_hook_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/skin_hook_01.webp",
                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "skin_hook_subsection_2",
          "subsection_title": "Introduction and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "skin_hook_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A skin hook is a small surgical retraction instrument used to grasp and gently retract the skin or wound edges, improving exposure of the operative field."
                },
                {
                  "type": "paragraph",
                  "text": "It is particularly useful in plastic surgery, dermatological surgery, facial surgery and other procedures requiring precise handling of superficial tissues."
                },
                {
                  "type": "checklist",
                  "items": [
                    "OSCE identification card",
                    "Name: Skin hook",
                    "Classification: Retracting and tissue-holding instrument"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Primary function: Retracting skin and superficial wound edges."
                },
                {
                  "type": "paragraph",
                  "text": "Characteristic feature: A small, sharp, curved hook at the working end."
                },
                {
                  "type": "paragraph",
                  "text": "Mechanism: Usually a manually operated, non-locking instrument."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification clue: Look for a handle with one or more small, pointed hooks at its tip. Unlike a retractor with a broad blade, a skin hook engages the skin at a small point."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "skin_hook_subsection_3",
          "subsection_title": "Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "skin_hook_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/skin_hook_02.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Description and function"
                  ],
                  "rows": [
                    [
                      "Handle",
                      "Provides a grip for controlled manipulation."
                    ],
                    [
                      "Shaft",
                      "Connects the handle to the working end."
                    ],
                    [
                      "Hook tip",
                      "Engages the skin or wound edge."
                    ],
                    [
                      "Curved portion",
                      "Allows the tip to catch and retract the tissue."
                    ],
                    [
                      "Prong or prongs",
                      "One or more pointed projections that engage the tissue."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Some skin hooks have a fine, delicate handle; others have a broader handle for improved grip. The number, angle and sharpness of the hooks vary by design."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "skin_hook_subsection_4",
          "subsection_title": "Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "skin_hook_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/skin_hook_01.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "A. Single-prong skin hook"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Has one hook at the tip. Useful for precise, localized traction on a small skin edge."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/skin_hook_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Double-prong skin hook"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Has two hooks that engage a slightly broader area of skin and may distribute traction across two points."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/skin_hook_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "C. Gillies skin hook"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A recognized pattern used in plastic and reconstructive surgery for controlled retraction of skin and wound edges."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/skin_hook_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "D. Double-ended skin hook"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Has a hook at each end, sometimes of different sizes, allowing selection according to the tissue and operative requirements."
                },
                {
                  "type": "paragraph",
                  "text": "These designs are not interchangeable in every procedure. Selection depends on the wound, tissue thickness and the degree of retraction required."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "skin_hook_subsection_5",
          "subsection_title": "Uses and clinical applications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "skin_hook_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The principal function of a skin hook is to provide localized traction on the skin or superficial wound edges."
                },
                {
                  "type": "table",
                  "columns": [
                    "Use",
                    "Explanation"
                  ],
                  "rows": [
                    [
                      "Wound retraction",
                      "Pulls a skin edge aside to improve visibility."
                    ],
                    [
                      "Skin closure",
                      "Assists with positioning wound edges during suturing."
                    ],
                    [
                      "Plastic surgery",
                      "Provides delicate retraction during reconstructive procedures."
                    ],
                    [
                      "Dermatological surgery",
                      "Helps expose small operative sites during excision of skin lesions."
                    ],
                    [
                      "Facial surgery",
                      "Supports precise retraction where tissue exposure must be carefully controlled."
                    ],
                    [
                      "Superficial dissection",
                      "Maintains exposure while the surgeon works in a superficial tissue plane."
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "skin_hook_group_6",
              "group_title": "Procedures where skin hooks may be used",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Excision of skin lesions."
                },
                {
                  "type": "paragraph",
                  "text": "Facial laceration repair."
                },
                {
                  "type": "paragraph",
                  "text": "Plastic and reconstructive surgery."
                },
                {
                  "type": "paragraph",
                  "text": "Dermatological surgery."
                },
                {
                  "type": "paragraph",
                  "text": "Selected breast and head-and-neck procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Minor surgical procedures involving small incisions."
                },
                {
                  "type": "paragraph",
                  "text": "Important distinction: Skin hooks are used for superficial tissue retraction. They are not intended to retract large volumes of deep tissue or abdominal organs."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "skin_hook_subsection_6",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "skin_hook_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Precise retraction: Provides localized control of skin edges."
                },
                {
                  "type": "paragraph",
                  "text": "Small profile: Takes up little space in the operative field."
                },
                {
                  "type": "paragraph",
                  "text": "Good visibility: Can improve exposure without covering much of the wound."
                },
                {
                  "type": "paragraph",
                  "text": "Useful in delicate surgery: Particularly valuable where careful tissue alignment matters."
                },
                {
                  "type": "paragraph",
                  "text": "Simple design: Easy to manipulate and generally straightforward to inspect."
                },
                {
                  "type": "paragraph",
                  "text": "Varied configurations: Single- and double-prong designs accommodate different retraction needs."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "skin_hook_subsection_7",
          "subsection_title": "Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "skin_hook_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The pointed tip can puncture or tear skin."
                },
                {
                  "type": "paragraph",
                  "text": "Excessive traction may cause tissue injury or enlarge the wound."
                },
                {
                  "type": "paragraph",
                  "text": "The small contact point can concentrate force on a limited area."
                },
                {
                  "type": "paragraph",
                  "text": "It requires manual holding unless supported by another appropriate technique."
                },
                {
                  "type": "paragraph",
                  "text": "A small hook can slip out of the skin edge if poorly positioned."
                },
                {
                  "type": "paragraph",
                  "text": "It is unsuitable for substantial deep-tissue retraction."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "skin_hook_subsection_8",
          "subsection_title": "Complications of improper use",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "skin_hook_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Mechanism",
                    "Prevention"
                  ],
                  "rows": [
                    [
                      "Skin tearing",
                      "Excessive pulling or a hook placed too close to the wound edge",
                      "Apply controlled traction."
                    ],
                    [
                      "Bleeding",
                      "Injury to small vessels in the skin",
                      "Avoid unnecessary penetration and traction."
                    ],
                    [
                      "Tissue ischaemia",
                      "Sustained excessive tension",
                      "Release or reposition when appropriate."
                    ],
                    [
                      "Wound-edge damage",
                      "Hook slips or pulls through tissue",
                      "Select an appropriate hook and engage tissue carefully."
                    ],
                    [
                      "Scarring",
                      "Unnecessary tissue trauma",
                      "Minimize injury and use appropriate surgical technique."
                    ],
                    [
                      "Needlestick or puncture injury",
                      "Accidental contact with the sharp hook",
                      "Handle with awareness of the working tip."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "High-yield point: Skin hooks can cause injury because the retraction force is concentrated at a small point. Gentle traction and appropriate positioning are essential."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "skin_hook_subsection_9",
          "subsection_title": "Principles of proper handling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "skin_hook_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/skin_hook_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 1 — Inspect the hook"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Check the tip for bending or damage and ensure that the instrument is clean and appropriately sterile."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/skin_hook_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 2 — Engage the skin edge"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Under direct vision, engage an appropriate portion of the skin edge without unnecessary deep penetration."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/skin_hook_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 3 — Apply controlled traction"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Retract only as much as required for exposure. Avoid excessive pulling or levering the hook against the skin."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/skin_hook_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 4 — Release and reprocess"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Remove the hook carefully, protecting the sharp tip, and reprocess the reusable instrument according to validated procedures."
                }
              ]
            }
          ]
        },
