        {
          "subsection_id": "skin_hook_subsection_12",
          "subsection_title": "Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "skin_hook_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a skin hook, a retracting instrument used to provide localized traction on the skin or superficial wound edges. It has a handle, shaft and a small curved, pointed hook at the working end. It may be single-pronged or double-pronged. It is used in procedures such as skin lesion excision, facial wound repair and plastic surgery to improve exposure. Complications include puncture injury, skin tearing and bleeding if excessive traction is applied. Before use, I would inspect the hook tip, instrument integrity, cleanliness and sterility.”"
                }
              ]
            }
          ]
