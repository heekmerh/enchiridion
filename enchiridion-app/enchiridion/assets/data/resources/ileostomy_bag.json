        {
          "subsection_id": "ileostomy_bag_subsection_14",
          "subsection_title": "Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ileostomy_bag_group_18",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is an ileostomy bag, a drainable appliance used to collect intestinal contents from a surgically created opening of the ileum. Its components include the collection pouch, adhesive skin barrier, drainage outlet and, depending on the design, a coupling flange and gas filter. It may be a one-piece or two-piece system. It is used after procedures such as total colectomy, proctocolectomy and formation of a diverting loop ileostomy. Its major advantages are effective intestinal diversion and protection of selected distal anastomoses. Important complications include leakage, peristomal skin irritation, stoma prolapse, retraction, parastomal hernia and high-output fluid and electrolyte losses. Care involves appropriate appliance fitting, stoma inspection, output measurement, hydration monitoring and patient education.”"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}