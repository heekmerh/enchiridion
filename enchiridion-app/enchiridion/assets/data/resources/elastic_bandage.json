        {
          "subsection_id": "elastic_bandage_subsection_2",
          "subsection_title": "1. Introduction and definition",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "elastic_bandage_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "An elastic bandage is a stretchable medical bandage designed to provide support, compression or fixation of dressings, depending on its construction and intended use."
                },
                {
                  "type": "paragraph",
                  "text": "It is commonly used in orthopaedics, sports medicine, rehabilitation, wound care and the management of selected soft-tissue injuries."
                },
                {
                  "type": "paragraph",
                  "text": "Key identifying feature: A bandage that stretches under tension and recoils when the tension is released."
                },
                {
                  "type": "paragraph",
                  "text": "Elastic bandages are not all equivalent. An ordinary elastic support bandage may provide general support, whereas a purpose-made medical compression bandage is designed for a more specific compression function."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "elastic_bandage_subsection_3",
          "subsection_title": "2. Identification in an OSCE station",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "elastic_bandage_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/elastic_bandage_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Model identification"
                },
                {
                  "type": "paragraph",
                  "text": "“This is an elastic bandage, a stretchable bandage used to support injured soft tissues, provide compression when indicated, or secure dressings and padding.”",
                  "style": "quote"
                },
                {
                  "type": "paragraph",
                  "text": "Key properties"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Stretchable and resilient.",
                      "level": 0
                    },
                    {
                      "text": "Conforms to body contours.",
                      "level": 0
                    },
                    {
                      "text": "Provides variable pressure according to the product and application technique.",
                      "level": 0
                    },
                    {
                      "text": "Available in different widths and constructions.",
                      "level": 0
                    },
                    {
                      "text": "Does not harden like a POP bandage.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "elastic_bandage_subsection_4",
          "subsection_title": "3. Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "elastic_bandage_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/elastic_bandage_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "1. Bandage roll"
                },
                {
                  "type": "paragraph",
                  "text": "The rolled length of elastic material that is unwound during application."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/elastic_bandage_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "2. Elastic fabric"
                },
                {
                  "type": "paragraph",
                  "text": "The woven or knitted material contains elastic fibres or an elastic construction that allows stretching and recoil."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/elastic_bandage_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "3. Fastening clips or closure"
                },
                {
                  "type": "paragraph",
                  "text": "Hold the applied bandage in position. Some products are self-adherent and do not require separate clips."
                },
                {
                  "type": "paragraph",
                  "text": "The packaging may specify the bandage width, length, material composition, stretch characteristics, compression rating, reuse instructions and intended clinical application."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "elastic_bandage_subsection_5",
          "subsection_title": "4. Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "elastic_bandage_group_5",
              "group_title": "A. According to construction",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/elastic_bandage_08.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "1. Woven elastic bandage"
                },
                {
                  "type": "paragraph",
                  "text": "Made from woven fibres with elastic properties. Used for general support or compression according to the product's design."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/elastic_bandage_09.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "2. Knitted elastic bandage"
                },
                {
                  "type": "paragraph",
                  "text": "Stretchable knitted construction that conforms to the limb. Some tubular versions are used for support or to retain dressings."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/elastic_bandage_10.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "3. Cohesive elastic bandage"
                },
                {
                  "type": "paragraph",
                  "text": "Adheres to itself rather than necessarily sticking to the skin. Used for selected support and dressing applications."
                }
              ]
            },
            {
              "group_id": "elastic_bandage_group_6",
              "group_title": "B. According to clinical function",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Support bandage: Supports selected joints and soft tissues.",
                      "level": 0
                    },
                    {
                      "text": "Compression bandage: Applies compression for a prescribed clinical indication.",
                      "level": 0
                    },
                    {
                      "text": "Fixation bandage: Holds dressings or padding in place.",
                      "level": 0
                    },
                    {
                      "text": "Tubular elastic bandage: Provides support or dressing retention over a limb or joint, depending on the product.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "OSCE distinction: An elastic bandage is a broad category of devices. A cohesive bandage is a specific self-adherent type, and a medical compression bandage is designed for a particular compression purpose."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "elastic_bandage_subsection_6",
          "subsection_title": "5. Indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "elastic_bandage_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Elastic bandages may be used for:",
                  "items": [
                    {
                      "text": "Supporting selected sprains and strains.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Providing compression for selected soft-tissue injuries.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Securing dressings and wound padding.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Supporting selected joints during rehabilitation.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Holding a suitable splint in position.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Managing selected cases of limb oedema when compression is appropriate.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Applying prescribed compression as part of venous disease management.",
                      "level": 0,
                      "label": "7."
                    },
                    {
                      "text": "Providing support during selected sporting activities.",
                      "level": 0,
                      "label": "8."
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "elastic_bandage_group_8",
              "group_title": "Common examples",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Ankle sprain.",
                      "level": 0
                    },
                    {
                      "text": "Wrist sprain.",
                      "level": 0
                    },
                    {
                      "text": "Soft-tissue swelling.",
                      "level": 0
                    },
                    {
                      "text": "Securing padding over a wound dressing.",
                      "level": 0
                    },
                    {
                      "text": "Supporting a limb after selected orthopaedic procedures.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "An elastic bandage alone is not sufficient treatment for an unstable fracture or a limb with suspected compartment syndrome."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "elastic_bandage_subsection_7",
          "subsection_title": "6. Principles of application",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "elastic_bandage_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "OSCE practical sequence"
                },
                {
                  "type": "paragraph",
                  "text": "Step 1 — Assess"
                },
                {
                  "type": "paragraph",
                  "text": "Identify the purpose of bandaging. Inspect the skin and assess circulation, sensation and movement. Determine whether compression is appropriate, particularly if arterial disease is possible."
                },
                {
                  "type": "paragraph",
                  "text": "Step 2 — Position and prepare"
                },
                {
                  "type": "paragraph",
                  "text": "Position the limb appropriately. Apply a suitable wound dressing or protective padding where required."
                },
                {
                  "type": "paragraph",
                  "text": "Step 3 — Apply the bandage"
                },
                {
                  "type": "paragraph",
                  "text": "For limb compression, application often begins distally and progresses proximally, using the technique and tension specified for the product and indication."
                },
                {
                  "type": "paragraph",
                  "text": "Step 4 — Maintain even overlap"
                },
                {
                  "type": "paragraph",
                  "text": "Use consistent overlapping turns and avoid folds, excessive stretching and focal pressure over bony prominences."
                },
                {
                  "type": "paragraph",
                  "text": "Step 5 — Secure and reassess"
                },
                {
                  "type": "paragraph",
                  "text": "Secure the end without creating a tight constricting point. Recheck distal circulation, sensation, movement and comfort."
                }
              ]
            },
            {
              "group_id": "elastic_bandage_group_10",
              "group_title": "Important application principles",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Apply only the degree of compression appropriate to the indication and device.",
                      "level": 0
                    },
                    {
                      "text": "Avoid bunching or folds.",
                      "level": 0
                    },
                    {
                      "text": "Do not apply excessive tension.",
                      "level": 0
                    },
                    {
                      "text": "Keep exposed digits visible when appropriate for monitoring.",
                      "level": 0
                    },
                    {
                      "text": "Reassess the limb after application and whenever symptoms change.",
                      "level": 0
                    },
                    {
                      "text": "If new pain, numbness, tingling, pallor, cyanosis or coldness develops, loosen or remove the bandage as appropriate and obtain prompt clinical assessment.",
                      "level": 0
                    },
                    {
                      "text": "Do not use a standard elastic support bandage as a substitute for a prescribed graduated compression system.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "elastic_bandage_subsection_8",
          "subsection_title": "7. Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "elastic_bandage_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Flexible and conformable.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Easy to apply and remove.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Provides support without rigid immobilisation.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Useful for retaining wound dressings.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Available in multiple sizes and constructions.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Some types can be washed and reused according to manufacturer instructions.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Does not require water or a setting process.",
                      "level": 0,
                      "label": "7."
                    },
                    {
                      "text": "Certain designs can maintain their position better than ordinary non-elastic gauze.",
                      "level": 0,
                      "label": "8."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "elastic_bandage_subsection_9",
          "subsection_title": "8. Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "elastic_bandage_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Pressure varies with application technique.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "May loosen or slip during movement.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Can cause nerve compression or impaired circulation if applied too tightly.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "May irritate the skin.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Does not provide the rigid support of a suitable cast.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Some materials lose elasticity with repeated use.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "May be inappropriate in significant arterial insufficiency without specialist assessment.",
                      "level": 0,
                      "label": "7."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "elastic_bandage_subsection_10",
          "subsection_title": "9. Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "elastic_bandage_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Explanation"
                  ],
                  "rows": [
                    [
                      "Neurovascular compromise",
                      "Excessive pressure reduces circulation or compresses nerves"
                    ],
                    [
                      "Pressure injury",
                      "Folds or excessive pressure over bony prominences"
                    ],
                    [
                      "Skin irritation",
                      "Friction, moisture or material sensitivity"
                    ],
                    [
                      "Distal swelling",
                      "Inappropriate bandage configuration or impaired venous return"
                    ],
                    [
                      "Nerve compression",
                      "Localised pressure, potentially causing numbness or weakness"
                    ],
                    [
                      "Skin maceration",
                      "Moisture trapped under the bandage"
                    ],
                    [
                      "Delayed recognition of deterioration",
                      "Symptoms may be overlooked if the limb is not monitored"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Emergency warning: Increasing pain, pain on passive stretch, new sensory changes, progressive swelling or cold, discoloured digits require urgent reassessment. A palpable pulse does not exclude compartment syndrome."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "elastic_bandage_subsection_11",
          "subsection_title": "10. Contraindications and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "elastic_bandage_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Use particular caution when considering compression in patients with:",
                  "items": [
                    {
                      "text": "Suspected acute limb ischaemia.",
                      "level": 0
                    },
                    {
                      "text": "Significant peripheral arterial disease.",
                      "level": 0
                    },
                    {
                      "text": "Unexplained severe limb swelling.",
                      "level": 0
                    },
                    {
                      "text": "Severe sensory impairment or neuropathy.",
                      "level": 0
                    },
                    {
                      "text": "Fragile skin or pressure injury.",
                      "level": 0
                    },
                    {
                      "text": "Suspected compartment syndrome.",
                      "level": 0
                    },
                    {
                      "text": "A suspected fracture requiring definitive immobilisation.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These conditions require assessment and an appropriate management plan rather than automatic application of an elastic bandage."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "elastic_bandage_subsection_12",
          "subsection_title": "11. Elastic bandage versus crepe bandage versus POP bandage",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "elastic_bandage_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Elastic bandage",
                    "Crepe bandage",
                    "POP bandage"
                  ],
                  "rows": [
                    [
                      "Construction",
                      "Elastic fibres or stretchable fabric",
                      "Usually crimped woven fabric",
                      "Gauze impregnated with plaster"
                    ],
                    [
                      "Stretch and recoil",
                      "Usually designed for elastic recoil",
                      "Variable, often moderate",
                      "Limited once applied and set"
                    ],
                    [
                      "Hardens after application",
                      "No",
                      "No",
                      "Yes"
                    ],
                    [
                      "Main purpose",
                      "Support, compression or fixation, depending on type",
                      "Light support and dressing retention",
                      "Rigid immobilisation"
                    ],
                    [
                      "Compression control",
                      "Product-dependent",
                      "Usually limited",
                      "Not primarily a compression device"
                    ],
                    [
                      "Removal",
                      "Unwound or peeled away, depending on design",
                      "Unwound",
                      "Requires appropriate cast removal when hardened"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The categories overlap: some crepe bandages are elastic, and some elastic bandages are used for compression. In an OSCE, identify the actual product and its intended function rather than relying on its name alone."
                }
              ]
            }
          ]
        },
