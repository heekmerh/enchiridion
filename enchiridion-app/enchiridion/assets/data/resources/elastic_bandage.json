        {
          "subsection_id": "elastic_bandage_subsection_14",
          "subsection_title": "13. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "elastic_bandage_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is an elastic bandage, a stretchable medical bandage used for support, compression or fixation depending on its design. It consists of an elastic fabric roll and may have fastening clips or a self-adherent closure. It is used for selected sprains, soft-tissue injuries, dressing retention and prescribed compression therapy. Its advantages include flexibility, ease of application and conformity to body contours. Its disadvantages include variable pressure, slippage and the risk of neurovascular compromise if applied excessively tightly. Safe use requires assessment of the limb, appropriate application technique and reassessment of distal circulation, sensation and movement.”",
                  "style": "quote"
                }
              ]
            }
          ]
        }
      ]
    }
