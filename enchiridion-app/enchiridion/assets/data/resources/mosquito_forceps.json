  "sections": [
    {
      "section_id": "mosquito_forceps_section_1",
      "section_title": "Mosquito forceps",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "mosquito_forceps_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mosquito_forceps_group_1",
              "group_title": "Mosquito Forceps (Halsted Mosquito Haemostatic Forceps)",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/mosquito_forceps_01.webp",
                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mosquito_forceps_subsection_2",
          "subsection_title": "Introduction and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mosquito_forceps_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Mosquito forceps are small, delicate, ring-handled haemostatic instruments used primarily to clamp small bleeding vessels during surgery."
                },
                {
                  "type": "paragraph",
                  "text": "They are commonly called Halsted mosquito forceps and are smaller and finer than standard artery forceps."
                },
                {
                  "type": "paragraph",
                  "text": "Category: Haemostatic and clamping instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Primary function: Temporary control of bleeding from small vessels."
                },
                {
                  "type": "paragraph",
                  "text": "Material: Usually stainless steel."
                },
                {
                  "type": "paragraph",
                  "text": "Construction: Finger rings, shanks, a box joint, a ratchet and narrow serrated jaws."
                },
                {
                  "type": "paragraph",
                  "text": "Types: Straight and curved."
                },
                {
                  "type": "paragraph",
                  "text": "Operation: The jaws are closed around the target, and the ratchet maintains closure."
                }
              ]
            },
            {
              "group_id": "mosquito_forceps_group_3",
              "group_title": "How to identify it in an OSCE",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Look for:"
                },
                {
                  "type": "paragraph",
                  "text": "A small overall size."
                },
                {
                  "type": "paragraph",
                  "text": "Narrow, delicate jaws."
                },
                {
                  "type": "paragraph",
                  "text": "Two finger rings."
                },
                {
                  "type": "paragraph",
                  "text": "A locking ratchet."
                },
                {
                  "type": "paragraph",
                  "text": "A central box joint."
                },
                {
                  "type": "paragraph",
                  "text": "Fine serrations along the jaws."
                },
                {
                  "type": "paragraph",
                  "text": "A straight or curved jaw profile."
                },
                {
                  "type": "paragraph",
                  "text": "Model identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“This is a Halsted mosquito forceps, a small haemostatic instrument used to clamp small bleeding vessels temporarily. It has finger rings, a ratchet, a box joint and fine serrated jaws.”"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mosquito_forceps_subsection_3",
          "subsection_title": "Labelling of mosquito forceps",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mosquito_forceps_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/mosquito_forceps_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "The main parts are:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Finger rings"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Allow the operator to hold and control the instrument using the thumb and a finger."
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Ratchet"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Interlocking teeth that maintain closure at the selected locking position."
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Box joint"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The joint where the two halves cross and articulate."
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Shanks"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Transmit movement from the handles to the jaws."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/mosquito_forceps_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "5. Jaws and serrations"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The narrow working ends grip the target. Fine serrations improve grip on suitable structures."
                },
                {
                  "type": "checklist",
                  "items": [
                    "6. Tips"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The distal ends that engage the bleeding point or other intended target."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE tip: The ratchet, box joint and serrations have distinct functions. Do not confuse the locking mechanism with the joint that permits movement."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mosquito_forceps_subsection_4",
          "subsection_title": "Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mosquito_forceps_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/mosquito_forceps_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "A. Straight mosquito forceps"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The jaws follow a straight line."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: Clamping accessible, small bleeding points where a straight approach is appropriate."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/mosquito_forceps_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Curved mosquito forceps"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The jaws have a curved profile."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: Accessing small bleeding points when a curved approach improves visualisation or access."
                },
                {
                  "type": "paragraph",
                  "text": "Mosquito forceps also vary in length and jaw pattern. The appropriate size depends on the operative field and the target structure."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mosquito_forceps_subsection_5",
          "subsection_title": "Principles of use",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mosquito_forceps_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The principle is temporary mechanical haemostasis through controlled compression of a small bleeding vessel."
                },
                {
                  "type": "paragraph",
                  "text": "Identify the bleeding point and obtain adequate visualisation."
                },
                {
                  "type": "paragraph",
                  "text": "Select a suitable haemostatic forceps."
                },
                {
                  "type": "paragraph",
                  "text": "Grasp the intended bleeding point without unnecessarily including surrounding tissue."
                },
                {
                  "type": "paragraph",
                  "text": "Apply controlled pressure and engage the ratchet only as needed."
                },
                {
                  "type": "paragraph",
                  "text": "Use an appropriate definitive haemostatic method where indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm that bleeding has stopped before proceeding."
                },
                {
                  "type": "paragraph",
                  "text": "Important: Mosquito forceps are not substitutes for specialised atraumatic vascular clamps. Their narrow jaws can injure small vessels if excessive compression is applied."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mosquito_forceps_subsection_6",
          "subsection_title": "Uses and surgeries",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mosquito_forceps_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Clinical setting",
                    "Application"
                  ],
                  "rows": [
                    [
                      "Minor surgery",
                      "Clamping small bleeding points"
                    ],
                    [
                      "General surgery",
                      "Temporary control of small superficial vessels"
                    ],
                    [
                      "Dermatological surgery",
                      "Haemostasis during excision of suitable skin lesions"
                    ],
                    [
                      "Plastic surgery",
                      "Fine haemostasis during superficial dissection"
                    ],
                    [
                      "Wound exploration",
                      "Clamping accessible small bleeding vessels when indicated"
                    ],
                    [
                      "Paediatric surgery",
                      "Selected haemostatic tasks where the instrument's size is appropriate"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Their small size makes them useful for precision work, but they should not be used indiscriminately on fragile vessels or deeper structures."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mosquito_forceps_subsection_7",
          "subsection_title": "Advantages and disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mosquito_forceps_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Advantages"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Small and easy to manoeuvre in restricted spaces."
                },
                {
                  "type": "paragraph",
                  "text": "Fine jaws allow precise clamping of small bleeding points."
                },
                {
                  "type": "paragraph",
                  "text": "Ratchet maintains closure without continuous hand pressure."
                },
                {
                  "type": "paragraph",
                  "text": "Straight and curved designs provide different approaches."
                },
                {
                  "type": "paragraph",
                  "text": "Reusable models can be reprocessed appropriately."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Disadvantages"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Unsuitable for many larger vessels or heavy-duty clamping tasks."
                },
                {
                  "type": "paragraph",
                  "text": "Excessive pressure may injure small vessels."
                },
                {
                  "type": "paragraph",
                  "text": "Narrow jaws may be less suitable for bulky tissue."
                },
                {
                  "type": "paragraph",
                  "text": "A small instrument may be difficult to manipulate in some settings."
                },
                {
                  "type": "paragraph",
                  "text": "A faulty ratchet or misaligned jaw can compromise haemostasis."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mosquito_forceps_subsection_8",
          "subsection_title": "Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mosquito_forceps_group_9",
              "group_title": "Patient-related complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Persistent bleeding if the bleeding point is not adequately controlled."
                },
                {
                  "type": "paragraph",
                  "text": "Vessel-wall injury from excessive compression."
                },
                {
                  "type": "paragraph",
                  "text": "Damage to adjacent tissue."
                },
                {
                  "type": "paragraph",
                  "text": "Crushing injury from inappropriate clamping."
                },
                {
                  "type": "paragraph",
                  "text": "Wound contamination or infection if aseptic technique is breached."
                }
              ]
            },
            {
              "group_id": "mosquito_forceps_group_10",
              "group_title": "Instrument-related problems",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Blunt, bent or misaligned jaws."
                },
                {
                  "type": "paragraph",
                  "text": "Faulty ratchet or box joint."
                },
                {
                  "type": "paragraph",
                  "text": "Stiff movement or failure to lock securely."
                },
                {
                  "type": "paragraph",
                  "text": "Corrosion or damage from inadequate maintenance."
                },
                {
                  "type": "paragraph",
                  "text": "Before use, inspect the instrument's jaws, ratchet, joint and overall condition."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mosquito_forceps_subsection_9",
          "subsection_title": "Mosquito forceps versus standard artery forceps",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mosquito_forceps_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/mosquito_forceps_06.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/mosquito_forceps_07.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Mosquito forceps",
                    "Standard artery forceps"
                  ],
                  "rows": [
                    [
                      "Size",
                      "Small and delicate",
                      "Usually larger, depending on the model"
                    ],
                    [
                      "Jaws",
                      "Narrow and fine",
                      "Generally more robust"
                    ],
                    [
                      "Primary application",
                      "Small bleeding points",
                      "A broader range of haemostatic tasks"
                    ],
                    [
                      "Access",
                      "Useful in confined superficial fields",
                      "Depends on size and jaw design"
                    ],
                    [
                      "Main risk",
                      "Injury to small vessels from excessive compression",
                      "Tissue or vessel injury from inappropriate clamping"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Memory aid: Mosquito = mini haemostat."
                },
                {
                  "type": "paragraph",
                  "text": "Both are haemostatic instruments with ring handles and a ratchet. Their main distinction is size and intended application, not the fundamental locking mechanism."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mosquito_forceps_subsection_10",
          "subsection_title": "Common OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mosquito_forceps_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. Identify this instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Halsted mosquito forceps, a small haemostatic instrument used to clamp small bleeding vessels temporarily."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is its main function?"
                },
                {
                  "type": "paragraph",
                  "text": "Temporary control of bleeding from small vessels."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What are the two main types?"
                },
                {
                  "type": "paragraph",
                  "text": "Straight and curved mosquito forceps."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. How do they differ from standard artery forceps?"
                },
                {
                  "type": "paragraph",
                  "text": "Mosquito forceps are smaller, finer and intended primarily for small bleeding points."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What is the function of the ratchet?"
                },
                {
                  "type": "paragraph",
                  "text": "It holds the jaws closed at a selected locking position."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Can they permanently control all bleeding?"
                },
                {
                  "type": "paragraph",
                  "text": "No. They often provide temporary control while definitive haemostasis is achieved where necessary."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What are the complications?"
                },
                {
                  "type": "paragraph",
                  "text": "Persistent bleeding, vessel-wall damage, tissue crushing and injury to adjacent structures."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mosquito_forceps_subsection_11",
          "subsection_title": "High-yield revision card",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mosquito_forceps_group_13",
              "group_title": "Mosquito forceps — must know",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Category: Haemostatic instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Identifying feature: Small size and fine serrated jaws."
                },
                {
                  "type": "paragraph",
                  "text": "Primary use: Temporary clamping of small bleeding vessels."
                },
                {
                  "type": "paragraph",
                  "text": "Types: Straight and curved."
                },
                {
                  "type": "paragraph",
                  "text": "Key comparison: Smaller and more delicate than standard artery forceps."
                },
                {
                  "type": "paragraph",
                  "text": "Major complication: Vessel injury or persistent bleeding."
                },
                {
                  "type": "paragraph",
                  "text": "Safety principle: Use controlled pressure and confirm definitive haemostasis."
                }
              ]
            },
            {
              "group_id": "mosquito_forceps_group_14",
              "group_title": "Model 30-second OSCE presentation",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a Halsted mosquito forceps, a small haemostatic instrument used to clamp small bleeding vessels temporarily. It consists of finger rings, a ratchet, shanks, a box joint and fine serrated jaws. It is available in straight and curved forms. Its main advantage is precise access to small bleeding points, but excessive compression can injure vessels and surrounding tissues. I would inspect the jaws and locking mechanism before use and ensure definitive haemostasis where indicated.”"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
