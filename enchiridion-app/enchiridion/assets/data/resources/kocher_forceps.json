  "sections": [
    {
      "section_id": "kocher_forceps_section_1",
      "section_title": "Kocher forceps",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "kocher_forceps_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "kocher_forceps_group_1",
              "group_title": "Kocher Forceps (Ochsner–Kocher Forceps)",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/kocher_forceps_01.webp",
                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "kocher_forceps_subsection_2",
          "subsection_title": "Introduction and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "kocher_forceps_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Kocher forceps are robust, ring-handled surgical grasping forceps characterised by a prominent interlocking tooth at the tip, commonly in a 1 × 2 configuration. They are used to grasp and hold suitable tough tissues securely during surgery."
                },
                {
                  "type": "paragraph",
                  "text": "They are also known as Ochsner–Kocher forceps."
                },
                {
                  "type": "paragraph",
                  "text": "Category: Grasping and tissue-holding instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Primary function: Securely grasping suitable tissues during dissection and surgical manipulation."
                },
                {
                  "type": "paragraph",
                  "text": "Material: Usually stainless steel."
                },
                {
                  "type": "paragraph",
                  "text": "Construction: Finger rings, shanks, a box joint, a ratchet and toothed, serrated jaws."
                },
                {
                  "type": "paragraph",
                  "text": "Types: Straight and curved."
                },
                {
                  "type": "paragraph",
                  "text": "Key identifying feature: Interlocking teeth at the tips."
                }
              ]
            },
            {
              "group_id": "kocher_forceps_group_3",
              "group_title": "How to identify it in an OSCE",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Look for:"
                },
                {
                  "type": "paragraph",
                  "text": "Two finger rings."
                },
                {
                  "type": "paragraph",
                  "text": "A locking ratchet."
                },
                {
                  "type": "paragraph",
                  "text": "A box joint."
                },
                {
                  "type": "paragraph",
                  "text": "Robust jaws with serrations."
                },
                {
                  "type": "paragraph",
                  "text": "A prominent tooth at the tip that engages with the opposing jaw."
                },
                {
                  "type": "paragraph",
                  "text": "Model identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“This is a Kocher forceps, also called an Ochsner forceps. It is a toothed, locking surgical instrument used to grasp and hold suitable tough tissues securely. Its characteristic feature is the interlocking tooth at the tip, commonly arranged as one tooth engaging between two opposing teeth.”"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "kocher_forceps_subsection_3",
          "subsection_title": "Labelling of Kocher forceps",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "kocher_forceps_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/kocher_forceps_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "The important structures are:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Finger rings"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Allow the operator to hold and control the instrument with the thumb and a finger."
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Ratchet"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Maintains closure at a selected locking position without continuous hand pressure."
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Box joint"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Connects the two halves and allows controlled movement of the jaws."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/kocher_forceps_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Shanks"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Transmit the force applied at the handles to the jaws."
                },
                {
                  "type": "checklist",
                  "items": [
                    "5. Jaws and serrations"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The gripping surfaces that secure the tissue."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/kocher_forceps_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "6. Interlocking teeth"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The characteristic tip feature that helps prevent the grasped tissue from slipping."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE tip: If you are shown a Kocher forceps beside a standard artery forceps, inspect the distal tips. The prominent teeth are usually the quickest distinguishing feature."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "kocher_forceps_subsection_4",
          "subsection_title": "Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "kocher_forceps_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/kocher_forceps_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "A. Straight Kocher forceps"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The jaws follow a straight line."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: Grasping and holding suitable tough tissue when a straight approach is appropriate."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/kocher_forceps_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Curved Kocher forceps"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The jaws have a curved profile."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: Grasping suitable tissues where a curved approach improves access."
                },
                {
                  "type": "paragraph",
                  "text": "Kocher forceps are also available in different lengths and sizes. The exact tooth configuration and jaw pattern may vary by manufacturer and model."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "kocher_forceps_subsection_5",
          "subsection_title": "Principles of use",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "kocher_forceps_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The principle is to obtain a secure mechanical grip on tissue that can tolerate toothed grasping."
                },
                {
                  "type": "paragraph",
                  "text": "Identify the tissue to be grasped."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm that the tissue is suitable for a toothed instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Position the jaws under direct vision."
                },
                {
                  "type": "paragraph",
                  "text": "Apply controlled pressure and engage the ratchet only as required."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid including adjacent nerves, vessels or other vulnerable structures."
                },
                {
                  "type": "paragraph",
                  "text": "Release the grip when it is no longer needed."
                }
              ]
            },
            {
              "group_id": "kocher_forceps_group_7",
              "group_title": "Critical safety point",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Kocher forceps are traumatic tissue-holding instruments. Their teeth can penetrate tissue, so they should not be used indiscriminately on fragile organs, delicate vessels or structures where puncture injury would be harmful."
                },
                {
                  "type": "paragraph",
                  "text": "For delicate tissue handling, a suitable atraumatic instrument may be preferable."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "kocher_forceps_subsection_6",
          "subsection_title": "Uses and surgeries",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "kocher_forceps_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Procedure or specialty",
                    "Application"
                  ],
                  "rows": [
                    [
                      "General surgery",
                      "Grasping suitable tough tissues during dissection"
                    ],
                    [
                      "Abdominal surgery",
                      "Holding selected tissue edges during operative manipulation"
                    ],
                    [
                      "Thyroid surgery",
                      "Holding suitable tissue structures when indicated, with care to protect adjacent anatomy"
                    ],
                    [
                      "Orthopaedic surgery",
                      "Selected tough soft-tissue handling"
                    ],
                    [
                      "Gynaecological surgery",
                      "Grasping appropriate tissue during selected procedures"
                    ],
                    [
                      "Wound surgery",
                      "Holding suitable tissue edges during selected procedures"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The exact application depends on the operative technique and tissue involved. A Kocher forceps should not be used simply because a tissue is difficult to grasp; the risk of tissue injury must also be considered."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "kocher_forceps_subsection_7",
          "subsection_title": "Advantages and disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "kocher_forceps_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Advantages"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Provides a secure grip on suitable tough tissues."
                },
                {
                  "type": "paragraph",
                  "text": "Interlocking teeth reduce the tendency to slip."
                },
                {
                  "type": "paragraph",
                  "text": "The ratchet maintains the grip without continuous hand pressure."
                },
                {
                  "type": "paragraph",
                  "text": "Available in straight and curved forms."
                },
                {
                  "type": "paragraph",
                  "text": "Useful when ordinary smooth-tipped forceps would provide insufficient grip."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Disadvantages"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Teeth may puncture, crush or tear tissue."
                },
                {
                  "type": "paragraph",
                  "text": "Unsuitable for many delicate structures."
                },
                {
                  "type": "paragraph",
                  "text": "Excessive clamping pressure can increase tissue injury."
                },
                {
                  "type": "paragraph",
                  "text": "The ratchet can maintain damaging pressure if left engaged inappropriately."
                },
                {
                  "type": "paragraph",
                  "text": "May be less suitable for delicate dissection than non-toothed or atraumatic instruments."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "kocher_forceps_subsection_8",
          "subsection_title": "Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "kocher_forceps_group_10",
              "group_title": "Patient-related complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Puncture injury at the grasping site."
                },
                {
                  "type": "paragraph",
                  "text": "Tissue crushing or tearing."
                },
                {
                  "type": "paragraph",
                  "text": "Bleeding from traumatic grasping."
                },
                {
                  "type": "paragraph",
                  "text": "Damage to adjacent vessels, nerves or organs."
                },
                {
                  "type": "paragraph",
                  "text": "Local tissue injury from excessive or prolonged compression."
                },
                {
                  "type": "paragraph",
                  "text": "Wound contamination or infection if aseptic technique is breached."
                }
              ]
            },
            {
              "group_id": "kocher_forceps_group_11",
              "group_title": "Instrument-related problems",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Bent or damaged teeth."
                },
                {
                  "type": "paragraph",
                  "text": "Misaligned jaws."
                },
                {
                  "type": "paragraph",
                  "text": "A defective ratchet or box joint."
                },
                {
                  "type": "paragraph",
                  "text": "Stiff movement or failure to release properly."
                },
                {
                  "type": "paragraph",
                  "text": "Corrosion or inadequate reprocessing."
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the teeth, jaw alignment, joint and ratchet before use."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "kocher_forceps_subsection_9",
          "subsection_title": "Kocher versus artery versus Allis forceps",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "kocher_forceps_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This is a high-yield OSCE comparison."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/kocher_forceps_07.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/kocher_forceps_08.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Kocher forceps",
                    "Standard artery forceps",
                    "Allis tissue forceps"
                  ],
                  "rows": [
                    [
                      "Primary function",
                      "Secure grasping of suitable tough tissue",
                      "Haemostasis",
                      "Grasping and holding tissue"
                    ],
                    [
                      "Tip",
                      "Usually prominent 1 × 2 teeth",
                      "Usually serrated, without terminal teeth",
                      "Multiple interlocking teeth"
                    ],
                    [
                      "Main advantage",
                      "Strong, secure grip",
                      "Temporary vessel clamping",
                      "Secure grip over a broader tissue-contact area"
                    ],
                    [
                      "Tissue effect",
                      "Traumatic",
                      "Can injure tissue through compression",
                      "Traumatic"
                    ],
                    [
                      "Key identification clue",
                      "Prominent terminal teeth",
                      "Serrated jaws and ratchet",
                      "Multiple teeth at the tip"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Memory aid:"
                },
                {
                  "type": "paragraph",
                  "text": "Kocher: prominent terminal teeth."
                },
                {
                  "type": "paragraph",
                  "text": "Artery forceps: primarily haemostasis."
                },
                {
                  "type": "paragraph",
                  "text": "Allis: multiple interlocking teeth for tissue holding."
                },
                {
                  "type": "paragraph",
                  "text": "Remember that both Kocher and Allis forceps can damage tissue; neither is a universal substitute for atraumatic grasping instruments."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "kocher_forceps_subsection_10",
          "subsection_title": "Common OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "kocher_forceps_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. Identify this instrument."
                },
                {
                  "type": "paragraph",
                  "text": "This is a Kocher forceps, also called an Ochsner forceps, used to grasp and hold suitable tough tissues."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is its characteristic feature?"
                },
                {
                  "type": "paragraph",
                  "text": "Prominent interlocking teeth at the tip, commonly in a 1 × 2 configuration."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What is the function of the ratchet?"
                },
                {
                  "type": "paragraph",
                  "text": "It maintains jaw closure at a selected locking position."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Why is it considered a traumatic instrument?"
                },
                {
                  "type": "paragraph",
                  "text": "Its teeth penetrate the tissue to provide a secure grip and may cause puncture or tearing."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. How does it differ from standard artery forceps?"
                },
                {
                  "type": "paragraph",
                  "text": "Kocher forceps typically have terminal teeth and are primarily used for tissue grasping, whereas standard artery forceps are primarily designed for haemostasis."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. How does it differ from Allis forceps?"
                },
                {
                  "type": "paragraph",
                  "text": "Kocher forceps typically have a prominent terminal tooth configuration, while Allis forceps have multiple interlocking teeth designed to grasp tissue."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What are the complications?"
                },
                {
                  "type": "paragraph",
                  "text": "Tissue puncture, crushing, tearing, bleeding and injury to adjacent structures."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "kocher_forceps_subsection_11",
          "subsection_title": "High-yield revision card",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "kocher_forceps_group_14",
              "group_title": "Kocher forceps — must know",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Category: Toothed tissue-holding forceps."
                },
                {
                  "type": "paragraph",
                  "text": "Identifying feature: Prominent interlocking teeth at the tip."
                },
                {
                  "type": "paragraph",
                  "text": "Common configuration: 1 × 2 teeth."
                },
                {
                  "type": "paragraph",
                  "text": "Types: Straight and curved."
                },
                {
                  "type": "paragraph",
                  "text": "Primary function: Securely grasping suitable tough tissue."
                },
                {
                  "type": "paragraph",
                  "text": "Main disadvantage: Can cause puncture and tearing."
                },
                {
                  "type": "paragraph",
                  "text": "Safety principle: Use only when the tissue can tolerate toothed grasping."
                }
              ]
            },
            {
              "group_id": "kocher_forceps_group_15",
              "group_title": "Model 30-second OSCE presentation",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a Kocher forceps, also known as an Ochsner forceps. It is a locking, toothed surgical instrument used to grasp and hold suitable tough tissues. It consists of finger rings, a ratchet, shanks, a box joint and serrated jaws with prominent interlocking teeth. It provides a secure grip but is traumatic and may cause tissue puncture, tearing or bleeding. I would inspect the teeth, jaw alignment and ratchet before use and avoid applying it to delicate structures.”"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}