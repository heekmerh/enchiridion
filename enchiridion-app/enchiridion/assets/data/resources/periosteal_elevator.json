            },
            {
              "group_id": "periosteal_elevator_group_17",
              "group_title": "Final high-yield summary",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Identification: Instrument used to elevate periosteum from bone."
                },
                {
                  "type": "paragraph",
                  "text": "Main parts: Handle, shaft, and working tip or blade."
                },
                {
                  "type": "paragraph",
                  "text": "Principle: Controlled mechanical separation and leverage."
                },
                {
                  "type": "paragraph",
                  "text": "Common types: Molt, Freer, Key, and Cobb elevators."
                },
                {
                  "type": "paragraph",
                  "text": "Major uses: Orthopaedic exposure, oral surgery, spinal exposure, and selected ENT procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Major risk: Excessive periosteal stripping may compromise bone vascularity and healing."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
