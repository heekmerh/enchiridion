        {
          "subsection_id": "periosteal_elevator_subsection_2",
          "subsection_title": "1. Introduction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "periosteal_elevator_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A periosteal elevator is a surgical instrument used to separate and elevate the periosteum from the underlying bone."
                },
                {
                  "type": "paragraph",
                  "text": "The periosteum is a vascular, connective-tissue membrane covering the external surface of most bones, except at articular surfaces covered by cartilage and certain other specialized regions."
                },
                {
                  "type": "paragraph",
                  "text": "The instrument is commonly used in orthopaedic surgery, oral and maxillofacial surgery, dental surgery, ENT surgery, and neurosurgery."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“This is a periosteal elevator. It is a surgical dissecting instrument used to separate the periosteum and attached soft tissues from the underlying bone, thereby exposing the bone for surgical procedures.”",
                  "style": "quote"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "periosteal_elevator_subsection_3",
          "subsection_title": "2. Labelling and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "periosteal_elevator_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/periosteal_elevator_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "The design varies, so label only the components present on the instrument displayed at your station."
                },
                {
                  "type": "table",
                  "columns": [
                    "Label",
                    "Component",
                    "Function"
                  ],
                  "rows": [
                    [
                      "A",
                      "Handle",
                      "Provides grip and controlled force"
                    ],
                    [
                      "B",
                      "Shaft or neck",
                      "Connects the handle to the working end"
                    ],
                    [
                      "C",
                      "Working blade or tip",
                      "Separates the periosteum from bone"
                    ],
                    [
                      "D",
                      "Blunt or rounded edge",
                      "Helps elevate tissue while reducing the risk of cutting it"
                    ],
                    [
                      "E",
                      "Sharp or pointed edge, if present",
                      "Assists initial separation or dissection in selected designs"
                    ],
                    [
                      "F",
                      "Opposite working end, if double-ended",
                      "Provides a different blade shape or size for alternative applications"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important: A double-ended elevator may have two different working tips. For example, one end may be broader and rounded, while the other is narrower or more pointed."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "periosteal_elevator_subsection_4",
          "subsection_title": "3. Properties and construction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "periosteal_elevator_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "A periosteal elevator generally has the following characteristics:",
                  "items": [
                    {
                      "text": "Material: Usually surgical-grade stainless steel.",
                      "level": 0
                    },
                    {
                      "text": "Handle: May be solid, textured, or designed to improve grip.",
                      "level": 0
                    },
                    {
                      "text": "Shaft: Straight, curved, angled, or offset depending on the intended anatomical site.",
                      "level": 0
                    },
                    {
                      "text": "Working end: Flat, rounded, curved, pointed, or spatula-shaped.",
                      "level": 0
                    },
                    {
                      "text": "Edges: May be blunt or have a relatively sharp edge for controlled tissue separation.",
                      "level": 0
                    },
                    {
                      "text": "Design: Available as single-ended or double-ended instruments.",
                      "level": 0
                    },
                    {
                      "text": "Sterilization: Reusable instruments are processed using validated cleaning and sterilization protocols compatible with the manufacturer's instructions.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The working surface must be strong enough to elevate tissue without bending excessively, yet sufficiently shaped to follow the contour of the bone."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "periosteal_elevator_subsection_5",
          "subsection_title": "4. Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "periosteal_elevator_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/periosteal_elevator_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "1. Molt periosteal elevator"
                },
                {
                  "type": "paragraph",
                  "text": "Commonly used in oral and maxillofacial surgery and dentistry to elevate mucoperiosteal flaps. Often double-ended, with different working-end shapes."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/periosteal_elevator_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "2. Freer elevator"
                },
                {
                  "type": "paragraph",
                  "text": "A relatively slender elevator used in ENT and other delicate surgical procedures. It is frequently used for submucosal dissection and elevation of soft tissue, including work involving the nasal septum."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/periosteal_elevator_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "3. Key periosteal elevator"
                },
                {
                  "type": "paragraph",
                  "text": "A robust elevator used particularly in orthopaedic surgery to elevate periosteum and soft tissues from bone."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/periosteal_elevator_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "4. Cobb elevator"
                },
                {
                  "type": "paragraph",
                  "text": "A broad, curved instrument used to elevate paraspinal muscles and associated soft tissues from the vertebral elements during spinal surgery."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/periosteal_elevator_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "5. Dental periosteal elevator"
                },
                {
                  "type": "paragraph",
                  "text": "Used to separate gingival and mucoperiosteal tissues from alveolar bone during oral surgery and tooth extraction."
                },
                {
                  "type": "paragraph",
                  "text": "Exam distinction: Not every elevator is designed exclusively for periosteum. Some instruments, such as the Freer elevator, are also used for submucosal dissection and elevation of other tissues."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "periosteal_elevator_subsection_6",
          "subsection_title": "5. Principle of operation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "periosteal_elevator_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The periosteal elevator works by mechanical separation and elevation of tissue from bone."
                },
                {
                  "type": "list",
                  "title": "The basic principle involves:",
                  "items": [
                    {
                      "text": "Creating or identifying an appropriate tissue edge.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Introducing the working end between the periosteum and the underlying bone.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Advancing the instrument along the bone surface.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Applying controlled pressure to separate the tissue plane.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Elevating the periosteum and associated soft tissues to expose the required bone surface.",
                      "level": 0,
                      "label": "5."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The surgeon uses controlled leverage, with the bone providing a relatively firm supporting surface."
                },
                {
                  "type": "paragraph",
                  "text": "Key principle: Keep the working end in contact with the bone as appropriate for the procedure, rather than directing it blindly into surrounding soft tissues."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "periosteal_elevator_subsection_7",
          "subsection_title": "6. Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "periosteal_elevator_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "A periosteal elevator is used to:",
                  "items": [
                    {
                      "text": "Separate periosteum from underlying bone.",
                      "level": 0
                    },
                    {
                      "text": "Raise a periosteal or mucoperiosteal flap.",
                      "level": 0
                    },
                    {
                      "text": "Expose bone for surgical access.",
                      "level": 0
                    },
                    {
                      "text": "Elevate attached muscles and soft tissues from bone in selected procedures.",
                      "level": 0
                    },
                    {
                      "text": "Create access to the operative site while preserving the tissue flap.",
                      "level": 0
                    },
                    {
                      "text": "Assist exposure of bone for fixation, reconstruction, or removal of a lesion.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
