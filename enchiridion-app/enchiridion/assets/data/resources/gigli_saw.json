  "sections": [
    {
      "section_id": "gigli_saw_section_1",
      "section_title": "Gigli saw",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "gigli_saw_subsection_1",
          "subsection_title": "Introduction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "gigli_saw_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/gigli_saw_01.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/gigli_saw_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A Gigli saw is a flexible, manually operated wire saw used to cut bone. It consists of a flexible serrated wire with handles attached to its ends, allowing the surgeon to move the wire back and forth around the bone."
                },
                {
                  "type": "paragraph",
                  "text": "It is particularly useful when a rigid bone saw cannot easily access the required cutting site."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“This is a Gigli saw, a flexible wire bone saw consisting of a serrated metal wire and handles at either end. It is used to divide bone in selected surgical procedures, including craniotomy and certain amputations, where a flexible cutting instrument is advantageous.”"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "gigli_saw_subsection_2",
          "subsection_title": "Classification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "gigli_saw_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The Gigli saw belongs to the following categories:"
                },
                {
                  "type": "paragraph",
                  "text": "Orthopaedic surgical instrument: used for cutting bone."
                },
                {
                  "type": "paragraph",
                  "text": "Manual saw: powered by the operator rather than an electric or pneumatic motor."
                },
                {
                  "type": "paragraph",
                  "text": "Flexible wire saw: the cutting element is a flexible serrated wire rather than a rigid blade."
                },
                {
                  "type": "paragraph",
                  "text": "Reusable or single-use instrument: depending on the particular product and manufacturer."
                }
              ]
            },
            {
              "group_id": "gigli_saw_group_3",
              "group_title": "How it differs from other bone saws",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/gigli_saw_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Gigli saw"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Flexible wire with handles. Can be passed around bone and operated by reciprocal pulling movements."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/gigli_saw_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Rigid bone saw"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Has a fixed, rigid toothed blade. Requires sufficient space to position and manipulate the blade."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/gigli_saw_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Powered oscillating saw"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Uses a motor-driven blade that moves through a limited angle. Common in selected orthopaedic procedures."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "gigli_saw_subsection_3",
          "subsection_title": "Labelled components",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "gigli_saw_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/gigli_saw_01.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "ebay.co.uk"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The principal components are:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Flexible wire"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The main cutting element. It can bend around bone and is designed to tolerate repeated pulling when used correctly."
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Serrated cutting surface"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The wire's cutting texture or interwoven metal structure produces the sawing action against bone."
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. End attachments"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Connect the wire to the handles. Their design varies between models."
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Handles"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "One handle is attached to each end of the wire. They allow the operator to grip and move the wire in a controlled reciprocating motion."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE labelling tip: If shown an assembled Gigli saw, point out the flexible serrated wire and the two handles first. These are the most recognisable features."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "gigli_saw_subsection_4",
          "subsection_title": "Principles of operation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "gigli_saw_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The Gigli saw works by reciprocating mechanical friction."
                },
                {
                  "type": "paragraph",
                  "text": "The wire is passed around the bone to be divided."
                },
                {
                  "type": "paragraph",
                  "text": "The handles are used to move the wire back and forth."
                },
                {
                  "type": "paragraph",
                  "text": "The cutting surface progressively divides the bone."
                },
                {
                  "type": "paragraph",
                  "text": "The flexibility of the wire allows it to follow a curved path around the bone."
                },
                {
                  "type": "paragraph",
                  "text": "The wire must be appropriately positioned and controlled to reduce the risk of injury to nearby soft tissues."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "gigli_saw_subsection_5",
          "subsection_title": "Indications and clinical uses",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "gigli_saw_group_6",
              "group_title": "A. Craniotomy and neurosurgery",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Historically and in selected techniques, a Gigli saw can be used to cut cranial bone. Its flexible design permits cutting along a planned path when appropriately positioned."
                },
                {
                  "type": "paragraph",
                  "text": "Modern neurosurgical practice often uses powered craniotomes or other specialised equipment, depending on the procedure."
                }
              ]
            },
            {
              "group_id": "gigli_saw_group_7",
              "group_title": "B. Selected amputations",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A Gigli saw may be used to divide bone during selected amputations, depending on the surgeon's preference and operative circumstances."
                }
              ]
            },
            {
              "group_id": "gigli_saw_group_8",
              "group_title": "C. Other selected bone-cutting procedures",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "It may be useful when a flexible cutting wire is advantageous and the anatomy permits safe passage of the wire."
                },
                {
                  "type": "paragraph",
                  "text": "Important: The Gigli saw is not the routine instrument for every bone cut. Instrument selection depends on the operation, access, surrounding structures and the surgeon's technique."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "gigli_saw_subsection_6",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "gigli_saw_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Flexible enough to pass around appropriately accessible bone."
                },
                {
                  "type": "paragraph",
                  "text": "Does not require a motor or power supply."
                },
                {
                  "type": "paragraph",
                  "text": "Can be useful where a rigid blade has limited access."
                },
                {
                  "type": "paragraph",
                  "text": "Compact and relatively easy to transport."
                },
                {
                  "type": "paragraph",
                  "text": "Can produce a controlled cut along a planned path when correctly used."
                },
                {
                  "type": "paragraph",
                  "text": "Generally has a simple construction."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "gigli_saw_subsection_7",
          "subsection_title": "Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "gigli_saw_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Requires manual effort and coordination."
                },
                {
                  "type": "paragraph",
                  "text": "Cutting may be slower than with some powered saws."
                },
                {
                  "type": "paragraph",
                  "text": "The wire can break if damaged, fatigued or used incorrectly."
                },
                {
                  "type": "paragraph",
                  "text": "The cut may be difficult to control if the wire is poorly positioned."
                },
                {
                  "type": "paragraph",
                  "text": "Requires adequate access to pass the wire safely around the bone."
                },
                {
                  "type": "paragraph",
                  "text": "Can injure adjacent tissues if the wire is not controlled."
                },
                {
                  "type": "paragraph",
                  "text": "Wire damage may be difficult to detect without careful inspection."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "gigli_saw_subsection_8",
          "subsection_title": "Contraindications and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "gigli_saw_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "There is no single universal contraindication to the Gigli saw; suitability depends on the planned procedure."
                },
                {
                  "type": "paragraph",
                  "text": "Important precautions include:"
                },
                {
                  "type": "paragraph",
                  "text": "Do not pass the wire blindly around bone where vulnerable structures may be injured."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm that the intended path is anatomically safe."
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the wire for fraying, kinking, corrosion or damage before use."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure the handles and end attachments are secure."
                },
                {
                  "type": "paragraph",
                  "text": "Use the instrument only for an appropriate bone-cutting procedure."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid excessive force or uncontrolled pulling."
                },
                {
                  "type": "paragraph",
                  "text": "Follow the appropriate sterile technique and instrument-reprocessing requirements."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "gigli_saw_subsection_9",
          "subsection_title": "Basic principles of use",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "gigli_saw_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "For OSCE learning; actual use requires surgical training and appropriate supervision."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm the indication and planned cutting site."
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the wire and handles for damage."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure the bone and surrounding anatomy have been exposed appropriately."
                },
                {
                  "type": "paragraph",
                  "text": "Pass the wire around the bone under direct or otherwise appropriately controlled guidance."
                },
                {
                  "type": "paragraph",
                  "text": "Attach and secure the handles."
                },
                {
                  "type": "paragraph",
                  "text": "Use controlled reciprocal movements to divide the bone."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid excessive tension or sudden jerking."
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the cut and surrounding tissues."
                },
                {
                  "type": "paragraph",
                  "text": "Check the instrument for wire damage or breakage after use."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "gigli_saw_subsection_10",
          "subsection_title": "Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "gigli_saw_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Explanation"
                  ],
                  "rows": [
                    [
                      "Soft-tissue injury",
                      "The wire may damage muscle, skin or other tissues."
                    ],
                    [
                      "Neurovascular injury",
                      "Improper passage may injure nearby nerves or vessels."
                    ],
                    [
                      "Wire breakage",
                      "A damaged or fatigued wire may fail during use."
                    ],
                    [
                      "Incomplete bone division",
                      "May occur with poor positioning or ineffective technique."
                    ],
                    [
                      "Unintended bone fracture",
                      "Excessive or poorly controlled force may damage adjacent bone."
                    ],
                    [
                      "Thermal injury",
                      "Friction can generate heat, although the extent depends on technique and circumstances."
                    ],
                    [
                      "Infection",
                      "May occur if appropriate sterile practices are not maintained."
                    ],
                    [
                      "Injury to adjacent structures",
                      "Particularly important when working near the skull, major vessels or nerves."
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "gigli_saw_subsection_11",
          "subsection_title": "Common OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "gigli_saw_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. Identify this instrument."
                },
                {
                  "type": "paragraph",
                  "text": "This is a Gigli saw, a flexible manual wire saw used to divide bone."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What are its main components?"
                },
                {
                  "type": "paragraph",
                  "text": "A flexible serrated wire, end attachments and two handles."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What is its principle of action?"
                },
                {
                  "type": "paragraph",
                  "text": "Reciprocal movement of the serrated wire produces a sawing action that divides bone."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Mention two uses."
                },
                {
                  "type": "paragraph",
                  "text": "Selected cranial bone-cutting procedures and selected amputations."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. State two advantages over a rigid saw."
                },
                {
                  "type": "paragraph",
                  "text": "Its flexibility permits passage around accessible bone, and it does not require a powered drive system."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Name three complications."
                },
                {
                  "type": "paragraph",
                  "text": "Soft-tissue injury, neurovascular injury and wire breakage."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What should you inspect before use?"
                },
                {
                  "type": "paragraph",
                  "text": "Wire integrity, secure end attachments and handle condition."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. How does it differ from a powered oscillating saw?"
                },
                {
                  "type": "paragraph",
                  "text": "A Gigli saw uses a manually moved flexible wire; an oscillating saw uses a motor-driven rigid blade."
                }
              ]
            }
          ]
        },
