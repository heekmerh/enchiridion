        {
          "subsection_id": "gigli_saw_subsection_13",
          "subsection_title": "Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "gigli_saw_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a Gigli saw, a manual flexible wire saw used to divide bone. It consists of a serrated wire with handles attached at both ends. It works by reciprocal movement of the wire around the bone. It may be used in selected cranial bone-cutting procedures and amputations. Its advantages include flexibility and independence from a power source. Complications include soft-tissue injury, neurovascular injury and wire breakage. Safe passage around the bone and inspection of the wire before use are essential.”"
                }
              ]
            }
          ]
        }
      ]
