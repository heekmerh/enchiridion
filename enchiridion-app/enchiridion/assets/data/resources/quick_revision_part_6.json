        {
          "subsection_id": "quick_revision_part_6_subsection_4",
          "subsection_title": "Tension Pneumothorax",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_6_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Causes"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Chest trauma — blunt or penetrating."
                },
                {
                  "type": "paragraph",
                  "text": "Positive-pressure mechanical ventilation."
                },
                {
                  "type": "paragraph",
                  "text": "Complication of central venous catheter insertion."
                },
                {
                  "type": "paragraph",
                  "text": "Complication of thoracentesis or lung biopsy."
                },
                {
                  "type": "paragraph",
                  "text": "Spontaneous pneumothorax progressing to tension."
                },
                {
                  "type": "paragraph",
                  "text": "Rib fractures with lung injury."
                },
                {
                  "type": "paragraph",
                  "text": "Barotrauma."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Clinical Features"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Severe respiratory distress."
                },
                {
                  "type": "paragraph",
                  "text": "Hypoxaemia and cyanosis."
                },
                {
                  "type": "paragraph",
                  "text": "Unilateral absent or markedly reduced breath sounds."
                },
                {
                  "type": "paragraph",
                  "text": "Hyperresonance on affected side."
                },
                {
                  "type": "paragraph",
                  "text": "Reduced chest expansion."
                },
                {
                  "type": "paragraph",
                  "text": "Tachycardia."
                },
                {
                  "type": "paragraph",
                  "text": "Hypotension and obstructive shock."
                },
                {
                  "type": "paragraph",
                  "text": "Distended neck veins (may be absent in hypovolaemia)."
                },
                {
                  "type": "paragraph",
                  "text": "Tracheal deviation away from affected side (late and unreliable sign)."
                },
                {
                  "type": "paragraph",
                  "text": "Cardiac arrest if untreated."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Treatment"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Immediate decompression when clinically suspected; do not wait for X-ray."
                },
                {
                  "type": "paragraph",
                  "text": "Needle decompression using an appropriate large-bore cannula at the locally recommended site, or finger/open thoracostomy by trained personnel."
                },
                {
                  "type": "paragraph",
                  "text": "Definitive intercostal chest drain insertion."
                },
                {
                  "type": "paragraph",
                  "text": "High-concentration oxygen when indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Support circulation and treat associated injuries."
                },
                {
                  "type": "paragraph",
                  "text": "Reassess immediately for clinical improvement and drain function."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_6_subsection_5",
          "subsection_title": "X-ray Findings of Pleural Effusion",
