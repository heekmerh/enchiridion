              "group_id": "quick_revision_part_6_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Erect chest X-ray",
                    "Blunting of costophrenic angle",
                    "Blunting of cardiophrenic angle",
                    "Homogeneous basal opacity",
                    "Meniscus sign",
                    "Concave upper border of fluid",
                    "Loss of hemidiaphragm outline",
                    "Mediastinal shift away from a massive effusion",
                    "Compressive atelectasis",
                    "Reduced visibility of underlying lung markings",
                    "Supine chest X-ray",
                    "Diffuse haziness of the affected hemithorax",
                    "Increased density without a clear meniscus",
                    "Poorly defined costophrenic angle",
                    "Apical or lateral fluid tracking",
                    "Loculated effusion",
                    "Lenticular or biconvex opacity",
                    "Atypical fluid collection",
                    "No typical meniscus sign",
                    "Subpulmonic effusion",
                    "Apparent elevation of hemidiaphragm",
                    "Lateral displacement of the diaphragmatic dome"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Increased distance between the apparent diaphragm and gastric air bubble on the left"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_6_subsection_6",
          "subsection_title": "Pleural Effusion",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_6_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Symptoms"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Dyspnoea."
                },
                {
                  "type": "paragraph",
                  "text": "Pleuritic chest pain."
                },
                {
                  "type": "paragraph",
                  "text": "Dry cough."
                },
                {
                  "type": "paragraph",
                  "text": "Orthopnoea."
                },
                {
                  "type": "paragraph",
                  "text": "Fever (if infective)."
                },
                {
                  "type": "paragraph",
                  "text": "Weight loss, night sweats (if malignant/TB)."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Signs"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Reduced chest expansion on affected side."
                },
                {
                  "type": "paragraph",
                  "text": "Reduced tactile vocal fremitus."
                },
                {
                  "type": "paragraph",
                  "text": "Stony dull percussion note."
                },
                {
                  "type": "paragraph",
                  "text": "Reduced or absent breath sounds."
                },
                {
                  "type": "paragraph",
                  "text": "Reduced vocal resonance."
                },
                {
                  "type": "paragraph",
                  "text": "Tracheal deviation away from affected side (massive effusion)."
                },
                {
                  "type": "paragraph",
                  "text": "Reduced vocal fremitus."
                },
                {
                  "type": "paragraph",
                  "text": "Bronchial breathing/egophony just above the effusion."
                },
                {
                  "type": "paragraph",
                  "text": "Reduced movement of affected hemithorax."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Chest X-ray Features"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Homogeneous opacity at the lung base."
                },
                {
                  "type": "paragraph",
                  "text": "Blunting of the costophrenic angle."
                },
                {
                  "type": "paragraph",
                  "text": "Meniscus sign."
                },
                {
                  "type": "paragraph",
                  "text": "Loss of the hemidiaphragm outline."
                },
                {
                  "type": "paragraph",
                  "text": "Large effusion: extensive hemithoracic opacity."
                },
                {
                  "type": "paragraph",
                  "text": "Mediastinal shift away from the affected side if massive."
                },
                {
                  "type": "paragraph",
                  "text": "Loculated effusion: atypical, lenticular opacity."
                },
                {
                  "type": "paragraph",
                  "text": "Subpulmonic effusion: apparent elevation of the hemidiaphragm."
                },
                {
                  "type": "paragraph",
                  "text": "Supine film: diffuse hazy opacity without a clear meniscus."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Treatment"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Treat the underlying cause."
                },
                {
                  "type": "paragraph",
                  "text": "Small, asymptomatic effusion: observation and treatment of cause."
                },
                {
                  "type": "paragraph",
                  "text": "Symptomatic effusion: ultrasound-guided therapeutic thoracentesis."
                },
                {
                  "type": "paragraph",
                  "text": "Parapneumonic effusion/empyema: antibiotics ± chest tube drainage."
                },
                {
                  "type": "paragraph",
                  "text": "Complicated parapneumonic effusion: chest tube ± intrapleural tPA/DNase."
                },
                {
                  "type": "paragraph",
                  "text": "Recurrent malignant effusion: indwelling pleural catheter or talc pleurodesis."
                },
                {
                  "type": "paragraph",
                  "text": "Heart failure-related effusion: diuretics and heart failure treatment."
                },
                {
                  "type": "paragraph",
                  "text": "Tuberculous effusion: anti-tuberculosis therapy according to guidelines."
                },
                {
                  "type": "paragraph",
                  "text": "Massive effusion: controlled drainage with monitoring for re-expansion pulmonary oedema."
                }
              ]
            }
          ]
        },
