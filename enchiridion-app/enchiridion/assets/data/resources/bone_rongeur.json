      "section_title": "Bone rongeur",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "bone_rongeur_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "bone_rongeur_group_1",
