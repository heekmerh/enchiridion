                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "bone_rongeur_subsection_2",
          "subsection_title": "Introduction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "bone_rongeur_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A bone rongeur is a specialized surgical instrument used to bite, cut, nibble, and remove small pieces of bone during surgical procedures."
                },
                {
                  "type": "paragraph",
                  "text": "It is commonly used in orthopaedic surgery, neurosurgery, maxillofacial surgery, spinal surgery, and other procedures requiring controlled removal of bone."
                },
                {
                  "type": "paragraph",
                  "text": "The term rongeur comes from the French word meaning “to gnaw,” which describes its action of progressively removing small pieces of bone."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“This is a bone rongeur, a bone-cutting instrument used to remove small fragments of bone, trim irregular bony edges, and contour bone during surgical procedures. It typically has sharp, scoop-shaped or opposing cutting jaws and handles that transmit force to the jaws through a joint mechanism.”"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "bone_rongeur_subsection_3",
          "subsection_title": "Labelling and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "bone_rongeur_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/bone_rongeur_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "In an OSCE station, you may be asked to identify and label the instrument or its components."
                },
                {
                  "type": "table",
                  "columns": [
                    "Label",
                    "Part",
                    "Function"
                  ],
                  "rows": [
                    [
                      "A",
                      "Cutting jaws or biting tips",
                      "Bite and remove small pieces of bone"
                    ],
                    [
                      "B",
                      "Jaws' cutting edges",
                      "Cut bone when the handles are compressed"
                    ],
                    [
                      "C",
                      "Hinge or joint",
                      "Allows opening and closing of the jaws"
                    ],
                    [
                      "D",
                      "Handles",
                      "Provide grip and mechanical force"
                    ],
                    [
                      "E",
                      "Spring mechanism, if present",
                      "Helps reopen the instrument after compression"
                    ],
                    [
                      "F",
                      "Ratchet or locking mechanism, if present",
                      "Present only in certain designs; maintains closure where applicable"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important labelling distinction: Most standard bone rongeurs are not ratcheted locking instruments. Do not label a ratchet unless it is actually present on the instrument shown."
                }
              ]
            },
            {
              "group_id": "bone_rongeur_group_4",
              "group_title": "How to distinguish a bone rongeur from similar instruments",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/bone_rongeur_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Bone rongeur"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Has robust, sharp biting jaws for removing small pieces of bone."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/bone_rongeur_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Kerrison rongeur"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Has a narrow, often angled shaft and a punch-like cutting mechanism with a footplate. It is particularly useful in spinal decompression and removal of small portions of lamina or other bone."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/bone_rongeur_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Bone-cutting forceps"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Often have heavier cutting blades designed to cut or divide bone rather than nibble away small fragments."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "bone_rongeur_subsection_4",
          "subsection_title": "Properties and construction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "bone_rongeur_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A bone rongeur typically has the following properties:"
                },
                {
                  "type": "paragraph",
                  "text": "Material: Surgical-grade stainless steel; some designs use other specialized instrument materials."
                },
                {
                  "type": "paragraph",
                  "text": "Jaws: Sharp, strong cutting edges shaped to bite bone."
                },
                {
                  "type": "paragraph",
                  "text": "Handle: Designed to provide a secure grip and controlled force."
                },
                {
                  "type": "paragraph",
                  "text": "Joint: Transmits force from the handles to the cutting jaws."
                },
                {
                  "type": "paragraph",
                  "text": "Design: May be straight, curved, angled, or fitted with a narrow shaft."
                },
                {
                  "type": "paragraph",
                  "text": "Action: Single-action or double-action, depending on the design."
                },
                {
                  "type": "paragraph",
                  "text": "Sterilization: Reusable models are generally designed for validated cleaning and sterilization; disposable models must be handled according to their instructions for use."
                },
                {
                  "type": "paragraph",
                  "text": "The instrument should be rigid enough to cut bone without excessive deformation, while allowing precise control by the surgeon."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "bone_rongeur_subsection_5",
          "subsection_title": "Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "bone_rongeur_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/bone_rongeur_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Luer bone rongeur"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A common general-purpose rongeur with relatively broad biting jaws. Used for trimming bone and removing small bony projections."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/bone_rongeur_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Double-action rongeur"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Has a compound-joint mechanism that increases the mechanical advantage and cutting force applied to the jaws."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/bone_rongeur_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Kerrison rongeur"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A specialized punch-type instrument used to remove small pieces of bone, especially during spinal and neurosurgical procedures."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/bone_rongeur_10.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Curved or angled rongeur"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Provides access to bone in areas where a straight instrument would be difficult to position."
                },
                {
                  "type": "paragraph",
                  "text": "Other variations include different jaw widths, shaft lengths, and cutting-tip profiles. Some have small, cup-shaped jaws; others have narrow punch-like tips."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "bone_rongeur_subsection_6",
          "subsection_title": "Principle of operation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "bone_rongeur_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The bone rongeur works by converting force applied to its handles into a concentrated biting force at the cutting jaws."
                },
                {
                  "type": "paragraph",
                  "text": "The surgeon positions the jaws over the bone to be removed."
                },
                {
                  "type": "paragraph",
                  "text": "The handles are compressed."
                },
                {
                  "type": "paragraph",
                  "text": "The joint mechanism transmits force to the jaws."
                },
                {
                  "type": "paragraph",
                  "text": "The cutting edges bite into and remove a small fragment of bone."
                },
                {
                  "type": "paragraph",
                  "text": "The jaws are released and repositioned as necessary."
                },
                {
                  "type": "paragraph",
                  "text": "Mechanical principle: Leverage. In double-action designs, a compound linkage provides increased mechanical advantage."
                },
                {
                  "type": "paragraph",
                  "text": "The instrument is intended for controlled, incremental removal of bone rather than indiscriminate crushing or removal of large sections in one bite."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "bone_rongeur_subsection_7",
          "subsection_title": "Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "bone_rongeur_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The bone rongeur is used for:"
                },
                {
                  "type": "paragraph",
                  "text": "Removal of small bone fragments."
                },
                {
                  "type": "paragraph",
                  "text": "Trimming sharp or irregular bony edges."
                },
                {
                  "type": "paragraph",
                  "text": "Contouring bone during reconstructive procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Removing small osteophytes or bony projections."
                },
                {
                  "type": "paragraph",
                  "text": "Enlarging or refining a bony opening."
                },
                {
                  "type": "paragraph",
                  "text": "Removing selected portions of bone during decompression."
                },
                {
                  "type": "paragraph",
                  "text": "Preparing or refining bony margins during surgery."
                }
              ]
            },
            {
              "group_id": "bone_rongeur_group_9",
              "group_title": "Surgeries in which it is used",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Surgical specialty",
                    "Example procedure",
                    "Purpose"
                  ],
                  "rows": [
                    [
                      "Orthopaedics",
                      "Fracture surgery",
                      "Remove loose fragments or trim selected bone edges"
                    ],
                    [
                      "Neurosurgery",
                      "Laminectomy or spinal decompression",
                      "Remove small portions of bone to improve access or relieve compression"
                    ],
                    [
                      "Maxillofacial surgery",
                      "Jaw reconstruction",
                      "Contour bone and trim bony edges"
                    ],
                    [
                      "Cranial surgery",
                      "Craniotomy-related procedures",
                      "Remove or refine selected bone margins"
                    ],
                    [
                      "Podiatric surgery",
                      "Excision of selected bony prominences",
                      "Contour or remove small projections"
                    ],
                    [
                      "General surgery",
                      "Selected procedures involving bone",
                      "Trim bone when required"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Clinical note: The exact instrument depends on the bone, its thickness, proximity to nerves and vessels, and the degree of removal required. A rongeur is not a substitute for an appropriate saw or osteotome when large sections of bone must be divided."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "bone_rongeur_subsection_8",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "bone_rongeur_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Precision: Allows controlled removal of small amounts of bone."
                },
                {
                  "type": "paragraph",
                  "text": "Good access: Angled and narrow designs can reach confined spaces."
                },
                {
                  "type": "paragraph",
                  "text": "Versatility: Available in different sizes and configurations."
                },
                {
                  "type": "paragraph",
                  "text": "Controlled contouring: Useful for smoothing irregular bony margins."
                },
                {
                  "type": "paragraph",
                  "text": "Mechanical advantage: Double-action models can reduce the hand force required for a given cutting action."
                },
                {
                  "type": "paragraph",
                  "text": "Incremental removal: Permits progressive adjustment of the bone contour."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "bone_rongeur_subsection_9",
          "subsection_title": "Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "bone_rongeur_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Requires repeated bites when a substantial volume of bone must be removed."
                },
                {
                  "type": "paragraph",
                  "text": "Cutting effectiveness decreases if the jaws become blunt."
                },
                {
                  "type": "paragraph",
                  "text": "Excessive force can damage the instrument or surrounding structures."
                },
                {
                  "type": "paragraph",
                  "text": "Limited suitability for cutting large or thick sections of bone."
                },
                {
                  "type": "paragraph",
                  "text": "Poor technique can produce irregular bone edges or unintended fractures."
                },
                {
                  "type": "paragraph",
                  "text": "Narrow working tips may restrict visibility or control in deep operative fields."
                },
                {
                  "type": "paragraph",
                  "text": "Requires meticulous cleaning, particularly around the jaws and joint."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "bone_rongeur_subsection_10",
          "subsection_title": "Complications and risks",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "bone_rongeur_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Complications depend on the operative site, the type of bone being removed, and the surgeon's technique."
                },
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Explanation"
                  ],
                  "rows": [
                    [
                      "Unintended bone fracture",
                      "Excessive force or inappropriate positioning may cause fracture beyond the intended site"
                    ],
                    [
                      "Soft-tissue injury",
                      "The cutting jaws may injure adjacent muscles, tendons, or other tissues"
                    ],
                    [
                      "Neurovascular injury",
                      "Particularly important during spinal, cranial, and maxillofacial procedures"
                    ],
                    [
                      "Dural injury",
                      "A recognized risk when removing bone near the dura during spinal or cranial surgery"
                    ],
                    [
                      "Bleeding",
                      "May occur if nearby vessels or vascular bone are injured"
                    ],
                    [
                      "Irregular bony margins",
                      "May result from blunt jaws or uncontrolled biting"
                    ],
                    [
                      "Retained bone fragments",
                      "Loose fragments may remain in the operative field"
                    ],
                    [
                      "Instrument failure",
                      "Worn, damaged, or improperly used instruments may malfunction"
                    ],
                    [
                      "Infection",
                      "Possible if surgical asepsis or instrument reprocessing is inadequate"
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "bone_rongeur_group_13",
              "group_title": "Prevention of complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Select the appropriate rongeur for the anatomical site."
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the instrument and test its action before use."
                },
                {
                  "type": "paragraph",
                  "text": "Maintain direct visualization and protect adjacent soft tissues."
                },
                {
                  "type": "paragraph",
                  "text": "Remove bone incrementally rather than applying excessive force."
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the operative field for loose fragments."
                },
                {
                  "type": "paragraph",
                  "text": "Use the appropriate method of haemostasis."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure proper instrument cleaning, inspection, and sterilization."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "bone_rongeur_subsection_11",
          "subsection_title": "Contraindications and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "bone_rongeur_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A bone rongeur does not have many absolute contraindications as an instrument, but its use may be inappropriate in certain circumstances."
                },
                {
                  "type": "paragraph",
                  "text": "Do not use a standard bone rongeur to cut thick bone if the instrument is not designed for that purpose."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid uncontrolled biting near critical neurovascular structures."
                },
                {
                  "type": "paragraph",
                  "text": "Do not use damaged, blunt, loose-jointed, or poorly functioning instruments."
                },
                {
                  "type": "paragraph",
                  "text": "Do not apply excessive force to resistant bone."
                },
                {
                  "type": "paragraph",
                  "text": "Use specialized instruments when working near the spinal cord, nerve roots, dura, or major blood vessels."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "bone_rongeur_subsection_12",
          "subsection_title": "Care, cleaning and sterilization",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "bone_rongeur_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "For reusable bone rongeurs:"
                },
                {
                  "type": "paragraph",
                  "text": "Remove gross contamination promptly after use."
                },
                {
                  "type": "paragraph",
                  "text": "Open the instrument fully and clean the jaws, hinge, and joint."
                },
                {
                  "type": "paragraph",
                  "text": "Use a compatible cleaning method and appropriate instrument-cleaning products."
                },
                {
                  "type": "paragraph",
                  "text": "Rinse and dry according to the manufacturer's instructions."
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the cutting edges, alignment, joint, and spring mechanism."
                },
                {
                  "type": "paragraph",
                  "text": "Lubricate the joint if required by the manufacturer's instructions."
                },
                {
                  "type": "paragraph",
                  "text": "Sterilize using a validated method compatible with the instrument."
                },
                {
                  "type": "paragraph",
                  "text": "A blunt or misaligned rongeur should be removed from service until appropriately repaired or replaced."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "bone_rongeur_subsection_13",
          "subsection_title": "High-yield OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "bone_rongeur_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is a bone rongeur?"
                },
                {
                  "type": "paragraph",
                  "text": "A surgical instrument used to bite and remove small pieces of bone."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is its main function?"
                },
                {
                  "type": "paragraph",
                  "text": "Controlled removal and contouring of bone, including trimming irregular bony edges."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What is the principle of operation?"
                },
                {
                  "type": "paragraph",
                  "text": "Leverage: force applied to the handles is transmitted to the cutting jaws."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. What is a double-action rongeur?"
                },
                {
                  "type": "paragraph",
                  "text": "A rongeur with a compound-joint mechanism that provides greater mechanical advantage than a comparable single-action design."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What is a Kerrison rongeur used for?"
                },
                {
                  "type": "paragraph",
                  "text": "It is used particularly in spinal and neurosurgical procedures to remove small portions of bone, such as the lamina, during decompression."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Mention three complications."
                },
                {
                  "type": "paragraph",
                  "text": "Neurovascular injury, unintended fracture, and soft-tissue injury. Other possibilities include bleeding and dural injury in relevant operative sites."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. How does it differ from an osteotome?"
                },
                {
                  "type": "paragraph",
                  "text": "A rongeur bites away small pieces of bone using opposing cutting jaws, whereas an osteotome is a chisel-like instrument used to cut or divide bone, often with a mallet."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. Is a bone rongeur a crushing instrument?"
                },
                {
                  "type": "paragraph",
                  "text": "It applies a concentrated biting force, but its intended action is cutting and removing bone fragments, not clamping soft tissue."
                },
                {
                  "type": "paragraph",
                  "text": "Q9. What should you inspect before use?"
                },
                {
                  "type": "paragraph",
                  "text": "Sharpness, jaw alignment, joint stability, smooth opening and closing, and any damage or corrosion."
                },
                {
                  "type": "paragraph",
                  "text": "Q10. What is the main safety principle?"
                },
                {
                  "type": "paragraph",
                  "text": "Remove bone incrementally under direct visualization while protecting adjacent soft tissues and critical structures."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "bone_rongeur_subsection_14",
          "subsection_title": "OSCE examiner's checklist",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "bone_rongeur_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Revision checklist",
