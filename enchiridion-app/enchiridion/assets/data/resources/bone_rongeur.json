    {
      "section_id": "bone_rongeur_section_1",
      "section_title": "Bone rongeur",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "bone_rongeur_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "bone_rongeur_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/bone_rongeur_01.webp",
                  "caption": null
                },
                {
                  "type": "image",
