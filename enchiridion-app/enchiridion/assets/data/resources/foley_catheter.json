  "sections": [
    {
      "section_id": "foley_catheter_section_1",
      "section_title": "Foley catheter",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "foley_catheter_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "foley_catheter_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/foley_catheter_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "We will treat each instrument or device on your list individually, using a structured OSCE and viva format. We will cover identification, labelling, classification, indications, contraindications, insertion principles where applicable, advantages, disadvantages, complications, and high-yield examination questions."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "foley_catheter_subsection_2",
          "subsection_title": "Introduction and definition",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "foley_catheter_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A Foley catheter is an indwelling urinary catheter inserted through the urethra into the urinary bladder to drain urine. It has an inflatable balloon near its distal tip that retains the catheter within the bladder."
                },
                {
                  "type": "paragraph",
                  "text": "It is commonly used in surgery, urology, obstetrics and gynaecology, emergency medicine, and critical care."
                },
                {
                  "type": "paragraph",
                  "text": "Key identifying feature: An inflatable retention balloon distinguishes a Foley catheter from a simple straight urinary catheter."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "foley_catheter_subsection_3",
          "subsection_title": "Identification in an OSCE station",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "foley_catheter_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/foley_catheter_02.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Expected identification"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "“This is a Foley catheter, an indwelling urinary catheter with an inflatable retention balloon, used for continuous drainage of urine from the urinary bladder.”"
                },
                {
                  "type": "checklist",
                  "items": [
                    "What to mention immediately"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "It is usually made of silicone, latex, or silicone-coated latex."
                },
                {
                  "type": "paragraph",
                  "text": "It is available in different French sizes."
                },
                {
                  "type": "paragraph",
                  "text": "It may have two or three lumens."
                },
                {
                  "type": "paragraph",
                  "text": "It is connected to a sterile urinary drainage system."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "foley_catheter_subsection_4",
          "subsection_title": "Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "foley_catheter_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "For a labelled diagram station, identify the following components on the actual catheter or a diagram."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/foley_catheter_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Distal tip"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The rounded end inserted into the bladder. It is designed to facilitate atraumatic passage."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/foley_catheter_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Retention balloon"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Inflated with the specified sterile water volume after the catheter is correctly positioned inside the bladder. It prevents accidental expulsion."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/foley_catheter_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Drainage eyes"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Openings near the distal tip through which urine enters the catheter."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/foley_catheter_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Shaft"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The flexible tube extending from the bladder to the external connection."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/foley_catheter_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "5. Inflation valve"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The port used to inflate or deflate the retention balloon. It is connected to the balloon channel, not the urine drainage channel."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/foley_catheter_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "6. Drainage funnel or connector"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The external outlet connected to the urinary drainage tubing and collection bag."
                },
                {
                  "type": "paragraph",
                  "text": "Other features to recognise include the catheter size marking, balloon capacity marking, and the material or manufacturer information on the packaging."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "foley_catheter_subsection_5",
          "subsection_title": "Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "foley_catheter_group_5",
              "group_title": "A. According to the number of lumens",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/foley_catheter_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Two-way Foley catheter",
                    "Commonest"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "One lumen drains urine."
                },
                {
                  "type": "paragraph",
                  "text": "The other inflates the retention balloon."
                },
                {
                  "type": "paragraph",
                  "text": "Used for routine urinary catheterisation and urine output monitoring."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/foley_catheter_10.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Three-way Foley catheter"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "One lumen drains urine and irrigation fluid."
                },
                {
                  "type": "paragraph",
                  "text": "One lumen inflates the balloon."
                },
                {
                  "type": "paragraph",
                  "text": "One lumen delivers bladder irrigation fluid."
                },
                {
                  "type": "paragraph",
                  "text": "Used particularly for continuous bladder irrigation following selected urological procedures, such as transurethral resection of the prostate."
                }
              ]
            },
            {
              "group_id": "foley_catheter_group_6",
              "group_title": "B. According to material",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Type",
                    "Important properties"
                  ],
                  "rows": [
                    [
                      "Latex",
                      "Flexible and relatively inexpensive; may cause latex allergy."
                    ],
                    [
                      "Silicone-coated latex",
                      "Combines a latex core with a silicone coating; still relevant to patients with latex allergy because the core contains latex."
                    ],
                    [
                      "100% silicone",
                      "Suitable for many patients requiring longer-term catheterisation and those with latex allergy; may be relatively stiff and more expensive."
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "foley_catheter_group_7",
              "group_title": "C. According to tip design",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Straight-tip Foley: Standard design for routine catheterisation."
                },
                {
                  "type": "paragraph",
                  "text": "Coude or Tiemann-tip catheter: Curved tip that may facilitate passage in selected patients with prostatic enlargement or difficult urethral anatomy. It requires appropriate training."
                },
                {
                  "type": "paragraph",
                  "text": "Specialist designs: Include catheters with different balloon configurations or materials for particular clinical indications."
                },
                {
                  "type": "paragraph",
                  "text": "A Foley catheter should not be confused with a three-way irrigation catheter simply because both have balloons: the defining difference is the number and purpose of the lumens."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "foley_catheter_subsection_6",
          "subsection_title": "French gauge sizes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "foley_catheter_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The diameter of a urinary catheter is expressed in French (Fr or Ch)."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/foley_catheter_11.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Therefore:"
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/foley_catheter_12.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Size",
                    "Approximate external diameter",
                    "Typical context"
                  ],
                  "rows": [
                    [
                      "6 Fr",
                      "2 mm",
                      "Selected paediatric applications"
                    ],
                    [
                      "8 Fr",
                      "2.7 mm",
                      "Selected paediatric applications"
                    ],
                    [
                      "10 Fr",
                      "3.3 mm",
                      "Selected paediatric applications"
                    ],
                    [
                      "12 Fr",
                      "4 mm",
                      "Smaller-bore catheterisation"
                    ],
                    [
                      "14 Fr",
                      "4.7 mm",
                      "Routine adult catheterisation"
                    ],
                    [
                      "16 Fr",
                      "5.3 mm",
                      "Routine adult catheterisation"
                    ],
                    [
                      "18 Fr",
                      "6 mm",
                      "Selected adult indications"
                    ],
                    [
                      "20–24 Fr",
                      "6.7–8 mm",
                      "Selected urological procedures, including irrigation"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These are examples, not rigid age-based prescriptions. Select the smallest catheter that will adequately achieve the clinical objective. Larger sizes may be required for clots or irrigation under appropriate urological guidance."
                },
                {
                  "type": "paragraph",
                  "text": "High-yield viva point: French size measures the catheter's external diameter, not its circumference or internal lumen diameter."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "foley_catheter_subsection_7",
          "subsection_title": "Indications and clinical uses",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "foley_catheter_group_9",
              "group_title": "A. Diagnostic indications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Accurate hourly urine output monitoring in critically ill patients."
                },
                {
                  "type": "paragraph",
                  "text": "Monitoring urine output during selected major operations."
                },
                {
                  "type": "paragraph",
                  "text": "Obtaining a urine specimen when less invasive methods are unsuitable."
                },
                {
                  "type": "paragraph",
                  "text": "Measuring residual urine in selected circumstances, although bladder scanning is often preferable."
                }
              ]
            },
            {
              "group_id": "foley_catheter_group_10",
              "group_title": "B. Therapeutic indications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Acute urinary retention when urethral catheterisation is appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Relief of bladder outlet obstruction while the underlying cause is evaluated and treated."
                },
                {
                  "type": "paragraph",
                  "text": "Continuous bladder irrigation for selected patients with haematuria and clot formation."
                },
                {
                  "type": "paragraph",
                  "text": "Perioperative bladder drainage in selected procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Maintaining bladder drainage in selected patients with prolonged immobilisation or certain wounds when alternatives are unsuitable."
                },
                {
                  "type": "paragraph",
                  "text": "Comfort-focused management in selected palliative situations."
                }
              ]
            },
            {
              "group_id": "foley_catheter_group_11",
              "group_title": "C. Surgical procedures in which it may be used",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Major abdominal and pelvic surgery."
                },
                {
                  "type": "paragraph",
                  "text": "Selected colorectal operations."
                },
                {
                  "type": "paragraph",
                  "text": "Caesarean section and selected obstetric procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Hysterectomy and other pelvic operations."
                },
                {
                  "type": "paragraph",
                  "text": "Urological operations, including prostate and bladder procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Selected orthopaedic operations requiring prolonged surgery or close fluid monitoring."
                },
                {
                  "type": "paragraph",
                  "text": "Important: A Foley catheter is not automatically required for every operation. The indication, expected duration, infection risk and availability of alternatives should be considered."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "foley_catheter_subsection_8",
          "subsection_title": "Contraindications and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "foley_catheter_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The most important OSCE distinction is between a routine catheterisation situation and suspected urethral injury."
                }
              ]
            },
            {
              "group_id": "foley_catheter_group_13",
              "group_title": "Suspected urethral injury — do not insert blindly",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Suspect urethral injury following pelvic trauma when there is:"
                },
                {
                  "type": "paragraph",
                  "text": "Blood at the urethral meatus."
                },
                {
                  "type": "paragraph",
                  "text": "Pelvic fracture with concerning urinary or genital findings."
                },
                {
                  "type": "paragraph",
                  "text": "Perineal or scrotal bruising."
                },
                {
                  "type": "paragraph",
                  "text": "Difficulty passing urine with a concerning traumatic mechanism."
                },
                {
                  "type": "paragraph",
                  "text": "In these circumstances, avoid blind urethral catheterisation and obtain urgent urological assessment. Retrograde urethrography is commonly indicated in suspected male urethral injury before instrumentation, depending on the clinical circumstances and local trauma protocol."
                },
                {
                  "type": "paragraph",
                  "text": "Other important precautions include:"
                },
                {
                  "type": "paragraph",
                  "text": "Known or suspected urethral stricture."
                },
                {
                  "type": "paragraph",
                  "text": "Recent urethral or bladder reconstruction."
                },
                {
                  "type": "paragraph",
                  "text": "Artificial urinary sphincter or complex urological anatomy."
                },
                {
                  "type": "paragraph",
                  "text": "Previous difficult catheterisation."
                },
                {
                  "type": "paragraph",
                  "text": "Latex allergy when a latex-containing catheter is being considered."
                },
                {
                  "type": "paragraph",
                  "text": "These are not all absolute contraindications in every circumstance, but they may require specialist advice or an alternative approach."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "foley_catheter_subsection_9",
          "subsection_title": "Principles of insertion",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "foley_catheter_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "OSCE sequence: describe the procedure systematically and emphasise asepsis, consent and patient safety."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 1 — Confirm the indication"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Review the clinical need, allergies, relevant urological history and any evidence of urethral injury."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 2 — Consent and preparation"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Explain the procedure, obtain consent, provide privacy and appropriate analgesia, perform hand hygiene and prepare sterile equipment."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 3 — Maintain asepsis"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Use an appropriate sterile catheterisation technique, sterile gloves, suitable antiseptic or cleansing solution according to local protocol, and sterile lubricant or anaesthetic gel where indicated."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 4 — Insert gently"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Advance the lubricated catheter through the urethra without force. Use the appropriate technique for the patient's anatomy and local protocol."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 5 — Confirm bladder entry"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Observe urine drainage and advance sufficiently according to the catheter type and local protocol before balloon inflation. Urine return alone may not always exclude malposition."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 6 — Inflate and secure"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Inflate the balloon with the specified volume of sterile water only after correct intravesical positioning is established. Stop if there is pain or resistance. Secure the catheter without traction."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 7 — Complete and document"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Connect the closed drainage system, keep the bag below bladder level, ensure unobstructed tubing, document the indication, catheter size, balloon volume, urine appearance and relevant observations."
                }
              ]
            },
            {
              "group_id": "foley_catheter_group_15",
              "group_title": "Critical safety points",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Never inflate the balloon in the urethra."
                },
                {
                  "type": "paragraph",
                  "text": "Never force the catheter against resistance."
                },
                {
                  "type": "paragraph",
                  "text": "If there is significant pain, resistance, bleeding or uncertainty about placement, stop and reassess."
                },
                {
                  "type": "paragraph",
                  "text": "Do not inflate the balloon with air or an unspecified fluid."
                },
                {
                  "type": "paragraph",
                  "text": "Use the balloon volume printed on the catheter; do not assume every balloon takes 10 mL."
                },
                {
                  "type": "paragraph",
                  "text": "Do not routinely disconnect the closed drainage system."
                },
                {
                  "type": "paragraph",
                  "text": "Remove the catheter as soon as it is no longer clinically indicated."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "foley_catheter_subsection_10",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "foley_catheter_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Provides continuous urinary drainage."
                },
                {
                  "type": "paragraph",
                  "text": "Allows accurate measurement of urine output."
                },
                {
                  "type": "paragraph",
                  "text": "Can relieve urinary retention."
                },
                {
                  "type": "paragraph",
                  "text": "Permits bladder irrigation with an appropriate three-way catheter."
                },
                {
                  "type": "paragraph",
                  "text": "Is widely available and relatively straightforward to use when performed correctly."
                },
                {
                  "type": "paragraph",
                  "text": "Can be used perioperatively and in selected long-term care situations."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "foley_catheter_subsection_11",
          "subsection_title": "Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "foley_catheter_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Invasive and potentially uncomfortable."
                },
                {
                  "type": "paragraph",
                  "text": "Increases the risk of catheter-associated urinary tract infection (CAUTI)."
                },
                {
                  "type": "paragraph",
                  "text": "May cause urethral trauma or bleeding."
                },
                {
                  "type": "paragraph",
                  "text": "Can cause bladder spasms and bypass leakage."
                },
                {
                  "type": "paragraph",
                  "text": "May obstruct due to debris, encrustation or blood clots."
                },
                {
                  "type": "paragraph",
                  "text": "Can restrict mobility and affect patient dignity."
                },
                {
                  "type": "paragraph",
                  "text": "Long-term use may contribute to urethral erosion, stricture and bladder stones."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "foley_catheter_subsection_12",
          "subsection_title": "Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "foley_catheter_group_18",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Mechanism or clinical significance"
                  ],
                  "rows": [
                    [
                      "CAUTI",
                      "Bacterial entry and colonisation associated with catheter use; may progress to systemic infection."
                    ],
                    [
                      "Urethral trauma",
                      "Forceful insertion, incorrect technique or balloon inflation in the urethra."
                    ],
                    [
                      "Haematuria",
                      "Mucosal trauma or underlying urinary pathology."
                    ],
                    [
                      "False passage",
                      "Catheter creates an abnormal tract, particularly during difficult insertion."
                    ],
                    [
                      "Balloon-related injury",
                      "Premature inflation or incorrect positioning."
                    ],
                    [
                      "Catheter blockage",
                      "Blood clots, sediment or encrustation obstruct urine flow."
                    ],
                    [
                      "Bladder spasms",
                      "Irritation of the bladder by the catheter or balloon."
                    ],
                    [
                      "Bypassing",
                      "Urine leaks around the catheter, sometimes due to blockage or bladder spasms."
                    ],
                    [
                      "Urethral stricture",
                      "Scar formation following repeated or significant urethral trauma."
                    ],
                    [
                      "Paraphimosis",
                      "Possible complication of inadequate foreskin replacement after catheterisation in an uncircumcised male."
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "foley_catheter_group_19",
              "group_title": "Prevention of catheter-associated infection",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Insert only for an appropriate indication."
                },
                {
                  "type": "paragraph",
                  "text": "Use aseptic technique."
                },
                {
                  "type": "paragraph",
                  "text": "Maintain a closed drainage system."
                },
                {
                  "type": "paragraph",
                  "text": "Keep the collection bag below bladder level and off the floor."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid kinks and dependent loops in the tubing."
                },
                {
                  "type": "paragraph",
                  "text": "Obtain urine specimens from the designated sampling port using aseptic technique."
                },
                {
                  "type": "paragraph",
                  "text": "Review the ongoing indication daily and remove promptly when unnecessary."
                },
                {
                  "type": "paragraph",
                  "text": "Do not use routine prophylactic antibiotics solely because a catheter is present."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "foley_catheter_subsection_13",
          "subsection_title": "Post-insertion care",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "foley_catheter_group_20",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Monitor urine output and its trend."
                },
                {
                  "type": "paragraph",
                  "text": "Assess urine colour, clarity and the presence of clots when clinically relevant."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure the catheter drains freely."
                },
                {
                  "type": "paragraph",
                  "text": "Maintain appropriate catheter and perineal hygiene."
                },
                {
                  "type": "paragraph",
                  "text": "Check for pain, leakage, fever, suprapubic discomfort or new haematuria."
                },
                {
                  "type": "paragraph",
                  "text": "Reassess fluid status and renal function when clinically indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Document the continuing indication and plan for removal."
                },
                {
                  "type": "paragraph",
                  "text": "Clinical pearl: If a catheterised patient stops producing urine, first assess the patient and check the tubing for kinks, dependent loops, bag position and obstruction. Consider dehydration, acute kidney injury, retention and catheter malposition. Do not simply assume the catheter is blocked or flush it without an appropriate indication and protocol."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "foley_catheter_subsection_14",
          "subsection_title": "High-yield OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "foley_catheter_group_21",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "1. What is the defining feature of a Foley catheter?"
                },
                {
                  "type": "paragraph",
                  "text": "2. What is the difference between a two-way and three-way Foley catheter?"
                },
                {
                  "type": "paragraph",
                  "text": "3. What does 16 Fr mean?"
                },
                {
                  "type": "paragraph",
                  "text": "4. Why must urine return be confirmed before balloon inflation?"
                },
                {
                  "type": "paragraph",
                  "text": "5. What should you do if there is resistance during insertion?"
                },
                {
                  "type": "paragraph",
                  "text": "6. What is the most important infectious complication?"
                },
                {
                  "type": "paragraph",
                  "text": "7. How can CAUTI risk be reduced?"
                },
                {
                  "type": "paragraph",
                  "text": "8. What is the significance of blood at the urethral meatus after pelvic trauma?"
                },
                {
                  "type": "paragraph",
                  "text": "9. What fluid is used to inflate the balloon?"
                },
                {
                  "type": "paragraph",
                  "text": "10. Why is the urine bag kept below bladder level?"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "foley_catheter_subsection_15",
          "subsection_title": "Common examiner traps",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "foley_catheter_group_22",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Confusing a Foley catheter with a straight Nelaton catheter, which has no retention balloon."
                },
                {
                  "type": "paragraph",
                  "text": "Stating that every three-way catheter is used only for routine drainage rather than recognising its irrigation function."
                },
                {
                  "type": "paragraph",
                  "text": "Forgetting that French gauge refers to external diameter."
                },
                {
                  "type": "paragraph",
                  "text": "Inflating the balloon before establishing appropriate intravesical positioning."
                },
                {
                  "type": "paragraph",
                  "text": "Forcing a catheter through resistance."
                },
                {
                  "type": "paragraph",
                  "text": "Missing possible urethral injury in a trauma patient."
                },
                {
                  "type": "paragraph",
                  "text": "Forgetting closed-system drainage, bag position and early removal."
                },
                {
                  "type": "paragraph",
                  "text": "Treating cloudy or foul-smelling urine alone as proof of a symptomatic urinary tract infection."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "foley_catheter_subsection_16",
          "subsection_title": "Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "foley_catheter_group_23",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a Foley catheter, an indwelling urinary catheter with an inflatable retention balloon. It is commonly made of latex, silicone-coated latex or silicone. Its parts include the distal tip, drainage eyes, retention balloon, shaft, inflation valve and drainage connector. It is classified into two-way and three-way catheters according to the number of lumens. Its indications include urinary retention, accurate urine output monitoring, selected perioperative drainage and bladder irrigation when a three-way catheter is used. Complications include catheter-associated urinary tract infection, urethral trauma, haematuria, blockage and bladder spasms. Safe use requires an appropriate indication, aseptic insertion, confirmation of correct placement before balloon inflation, a closed drainage system and prompt removal when no longer necessary.”"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}