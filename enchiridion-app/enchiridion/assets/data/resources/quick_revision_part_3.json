              "blocks": [
                {
                  "type": "paragraph",
                  "text": "**1. Causes of Coma**"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Neurological:",
                      "level": 0
                    },
                    {
                      "text": "Stroke — ischaemic or haemorrhagic",
                      "level": 1
                    },
                    {
                      "text": "Traumatic brain injury",
                      "level": 1
                    },
                    {
                      "text": "Intracranial haemorrhage — subarachnoid, subdural, epidural",
                      "level": 1
                    },
                    {
                      "text": "Brain tumour or mass lesion",
                      "level": 1
                    },
                    {
                      "text": "Raised intracranial pressure and brain herniation",
                      "level": 1
                    },
                    {
                      "text": "CNS infections — meningitis, encephalitis, cerebral malaria, brain abscess",
                      "level": 1
                    },
                    {
                      "text": "Seizures/status epilepticus and postictal state",
                      "level": 1
                    },
                    {
                      "text": "Hydrocephalus",
                      "level": 1
                    },
                    {
                      "text": "Brainstem lesions",
                      "level": 1
                    },
                    {
                      "text": "Degenerative dxs (parkinsons, alzheimers)",
                      "level": 1
                    },
                    {
                      "text": "Metabolic/Endocrine:",
                      "level": 0
                    },
                    {
                      "text": "Hypoglycaemia, hyperglycaemia",
                      "level": 1
                    },
                    {
                      "text": "Diabetic ketoacidosis (DKA), hyperosmolar hyperglycaemic state (HHS)",
                      "level": 1
                    },
                    {
                      "text": "Uraemia",
                      "level": 1
                    },
                    {
                      "text": "Hepatic encephalopathy",
                      "level": 1
                    },
                    {
                      "text": "Electrolyte disturbances — sodium, calcium, magnesium",
                      "level": 1
                    },
                    {
                      "text": "Hypothyroidism/myxoedema coma",
                      "level": 1
                    },
                    {
                      "text": "Thyroid storm",
                      "level": 1
                    },
                    {
                      "text": "Adrenal crisis",
                      "level": 1
                    },
                    {
                      "text": "Hypothermia, hyperthermia",
                      "level": 1
                    },
                    {
                      "text": "Vitamin deficiency — thiamine deficiency/Wernicke encephalopathy",
                      "level": 1
                    },
                    {
                      "text": "Myxedema coma",
                      "level": 1
                    },
                    {
                      "text": "Respiratory:",
                      "level": 0
                    },
                    {
                      "text": "Hypoxia",
                      "level": 1
                    },
                    {
                      "text": "Hypercapnia",
                      "level": 1
                    },
                    {
                      "text": "Respiratory failure",
                      "level": 1
                    },
                    {
                      "text": "Severe asthma or COPD exacerbation",
                      "level": 1
                    },
                    {
                      "text": "Airway obstruction",
                      "level": 1
                    },
                    {
                      "text": "Cardiovascular:",
                      "level": 0
                    },
                    {
                      "text": "Shock — hypovolaemic, cardiogenic, distributive, obstructive",
                      "level": 1
                    },
                    {
                      "text": "Cardiac arrest",
                      "level": 1
                    },
                    {
                      "text": "Severe arrhythmias",
                      "level": 1
                    },
                    {
                      "text": "Hypertensive encephalopathy",
                      "level": 1
                    },
                    {
                      "text": "Infectious/Systemic:",
                      "level": 0
                    },
                    {
                      "text": "Sepsis-associated encephalopathy",
                      "level": 1
                    },
                    {
                      "text": "Severe malaria",
                      "level": 1
                    },
                    {
                      "text": "Septic shock",
                      "level": 1
                    },
                    {
                      "text": "Meningitis",
                      "level": 1
                    },
                    {
                      "text": "Encephalitis",
                      "level": 1
                    },
                    {
                      "text": "Brain abscess",
                      "level": 1
                    },
                    {
                      "text": "Toxicological/Drug-related:",
                      "level": 0
                    },
                    {
                      "text": "Alcohol intoxication",
                      "level": 1
                    },
                    {
                      "text": "Opioids",
                      "level": 1
                    },
                    {
                      "text": "Benzodiazepines and sedatives",
                      "level": 1
                    },
                    {
                      "text": "Barbiturates",
                      "level": 1
                    },
                    {
                      "text": "Carbon monoxide poisoning",
                      "level": 1
                    },
                    {
                      "text": "Organophosphate poisoning",
                      "level": 1
                    },
                    {
                      "text": "Drug overdose or polypharmacy",
                      "level": 1
                    },
                    {
                      "text": "Renal/Hepatic: Uraemic encephalopathy, hepatic encephalopathy.",
                      "level": 0
                    },
                    {
                      "text": "Psychiatric/Other: Catatonia, psychogenic unresponsiveness (diagnosis of exclusion).",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "**2. Features of Raised Intracranial Pressure (ICP)**"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Headache, often worse in the morning or with coughing/straining.",
                      "level": 0
                    },
                    {
                      "text": "Nausea and vomiting, sometimes projectile.",
                      "level": 0
                    },
                    {
                      "text": "Papilloedema.",
                      "level": 0
                    },
                    {
                      "text": "Reduced level of consciousness.",
                      "level": 0
                    },
                    {
                      "text": "Altered mental status and irritability.",
                      "level": 0
                    },
                    {
                      "text": "Diplopia.",
                      "level": 0
                    },
                    {
                      "text": "Sixth cranial nerve palsy.",
                      "level": 0
                    },
                    {
                      "text": "Blurred vision and transient visual obscurations.",
                      "level": 0
                    },
                    {
                      "text": "Seizures.",
                      "level": 0
                    },
                    {
                      "text": "Focal neurological deficits.",
                      "level": 0
                    },
                    {
                      "text": "Abnormal pupillary responses.",
                      "level": 0
                    },
                    {
                      "text": "Bradycardia.",
                      "level": 0
                    },
                    {
                      "text": "Systemic hypertension.",
                      "level": 0
                    },
                    {
                      "text": "Irregular respiration.",
                      "level": 0
                    },
                    {
                      "text": "Abnormal posturing — decorticate or decerebrate.",
                      "level": 0
                    },
                    {
                      "text": "Late sign: Cushing's triad.",
                      "level": 0
                    },
                    {
                      "text": "Decreased visual acquity",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
