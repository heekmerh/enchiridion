        {
          "subsection_id": "quick_revision_part_3_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_3_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "1. Causes of Coma"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Neurological:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Stroke — ischaemic or haemorrhagic",
                    "Traumatic brain injury",
                    "Intracranial haemorrhage — subarachnoid, subdural, epidural",
                    "Brain tumour or mass lesion",
                    "Raised intracranial pressure and brain herniation",
                    "CNS infections — meningitis, encephalitis, cerebral malaria, brain abscess",
                    "Seizures/status epilepticus and postictal state",
                    "Hydrocephalus",
                    "Brainstem lesions",
                    "Degenerative dxs (parkinsons, alzheimers)"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Metabolic/Endocrine:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Hypoglycaemia, hyperglycaemia",
                    "Diabetic ketoacidosis (DKA), hyperosmolar hyperglycaemic state (HHS)",
                    "Uraemia",
                    "Hepatic encephalopathy",
                    "Electrolyte disturbances — sodium, calcium, magnesium",
                    "Hypothyroidism/myxoedema coma",
                    "Thyroid storm",
                    "Adrenal crisis",
                    "Hypothermia, hyperthermia",
                    "Vitamin deficiency — thiamine deficiency/Wernicke encephalopathy",
                    "Myxedema coma"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Respiratory:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Hypoxia",
                    "Hypercapnia",
                    "Respiratory failure",
                    "Severe asthma or COPD exacerbation",
                    "Airway obstruction"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Cardiovascular:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Shock — hypovolaemic, cardiogenic, distributive, obstructive",
                    "Cardiac arrest",
                    "Severe arrhythmias",
                    "Hypertensive encephalopathy"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Infectious/Systemic:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Sepsis-associated encephalopathy",
                    "Severe malaria",
                    "Septic shock",
                    "Meningitis",
                    "Encephalitis",
                    "Brain abscess"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Toxicological/Drug-related:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Alcohol intoxication",
                    "Opioids",
                    "Benzodiazepines and sedatives",
                    "Barbiturates",
                    "Carbon monoxide poisoning",
                    "Organophosphate poisoning",
                    "Drug overdose or polypharmacy"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Renal/Hepatic: Uraemic encephalopathy, hepatic encephalopathy."
                },
                {
                  "type": "paragraph",
                  "text": "Psychiatric/Other: Catatonia, psychogenic unresponsiveness (diagnosis of exclusion)."
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Features of Raised Intracranial Pressure (ICP)"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Headache, often worse in the morning or with coughing/straining."
                },
                {
                  "type": "paragraph",
                  "text": "Nausea and vomiting, sometimes projectile."
                },
                {
                  "type": "paragraph",
                  "text": "Papilloedema."
                },
                {
                  "type": "paragraph",
                  "text": "Reduced level of consciousness."
                },
                {
                  "type": "paragraph",
                  "text": "Altered mental status and irritability."
                },
                {
                  "type": "paragraph",
                  "text": "Diplopia."
                },
                {
                  "type": "paragraph",
                  "text": "Sixth cranial nerve palsy."
                },
                {
                  "type": "paragraph",
                  "text": "Blurred vision and transient visual obscurations."
                },
                {
                  "type": "paragraph",
                  "text": "Seizures."
                },
                {
                  "type": "paragraph",
                  "text": "Focal neurological deficits."
                },
                {
                  "type": "paragraph",
                  "text": "Abnormal pupillary responses."
                },
                {
                  "type": "paragraph",
                  "text": "Bradycardia."
                },
                {
                  "type": "paragraph",
                  "text": "Systemic hypertension."
                },
                {
                  "type": "paragraph",
                  "text": "Irregular respiration."
                },
                {
                  "type": "paragraph",
                  "text": "Abnormal posturing — decorticate or decerebrate."
                },
                {
                  "type": "paragraph",
                  "text": "Late sign: Cushing's triad."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Decreased visual acquity"
                  ]
                }
              ]
            }
          ]
