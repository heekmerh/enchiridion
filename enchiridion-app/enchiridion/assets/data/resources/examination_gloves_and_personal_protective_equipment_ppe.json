{
  "chapter_metadata": {
    "chapter_id": "examination_gloves_and_personal_protective_equipment_ppe",
    "chapter_title": "Examination gloves and personal protective equipment (PPE)",
    "chapter_icon": null,
    "description": null,
    "position_in_book": 1,
    "tags": [
      "Examination gloves and personal protective equipment (PPE)"
    ],
    "chapter_color": null
  },
  "sections": [
    {
      "section_id": "examination_gloves_and_personal_protective_equipment_ppe_section_1",
      "section_title": "Examination gloves and personal protective equipment (PPE)",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "examination_gloves_and_personal_protective_equipment_ppe_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The goal of this station is not simply to identify gloves or protective clothing. You must demonstrate when PPE is needed, select the correct equipment for a clinical procedure, put it on and remove it safely, prevent cross-contamination, and explain its limitations."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "examination_gloves_and_personal_protective_equipment_ppe_subsection_2",
          "subsection_title": "1. Identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/examination_gloves_and_personal_protective_equipment_ppe_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Examination gloves: Disposable gloves worn to protect the healthcare worker's hands and reduce contamination of the patient, equipment, and environment."
                },
                {
                  "type": "paragraph",
                  "text": "Personal protective equipment (PPE): Equipment worn to protect the healthcare worker from exposure to infectious agents, blood, body fluids, chemicals, and other occupational hazards."
                },
                {
                  "type": "list",
                  "title": "PPE may include:",
                  "items": [
                    {
                      "text": "Gloves",
                      "level": 0
                    },
                    {
                      "text": "Apron or protective gown",
                      "level": 0
                    },
                    {
                      "text": "Surgical mask",
                      "level": 0
                    },
                    {
                      "text": "Respirator, such as an N95 or FFP2",
                      "level": 0
                    },
                    {
                      "text": "Goggles or face shield",
                      "level": 0
                    },
                    {
                      "text": "Head covering and footwear protection when indicated",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Examiner's expected answer:"
                },
                {
                  "type": "paragraph",
                  "text": "\"These are examination gloves and personal protective equipment. They are used according to the anticipated exposure risk to prevent transmission of infection and protect both healthcare workers and patients.\"",
                  "style": "quote"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "examination_gloves_and_personal_protective_equipment_ppe_subsection_3",
          "subsection_title": "2. Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Clinical situation",
                    "PPE required"
                  ],
                  "rows": [
                    [
                      "Routine physical examination with no anticipated exposure to body fluids",
                      "Hand hygiene; gloves are not routinely necessary"
                    ],
                    [
                      "Venepuncture and blood sampling",
                      "Gloves; additional protection if splashing is anticipated"
                    ],
                    [
                      "Wound dressing",
                      "Gloves and an apron or gown as indicated"
                    ],
                    [
                      "Contact with blood, secretions, or mucous membranes",
                      "Gloves and appropriate additional PPE"
                    ],
                    [
                      "Suspected airborne infection, e.g. pulmonary tuberculosis",
                      "Fit-tested respirator and other precautions appropriate to the situation"
                    ],
                    [
                      "Droplet precautions",
                      "Medical mask and other PPE according to exposure risk and local policy"
                    ],
                    [
                      "High splash-risk procedure",
                      "Gloves, gown, and eye/face protection"
                    ],
                    [
                      "Isolation nursing",
                      "PPE selected according to the mode of transmission and required precautions"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important OSCE distinction: Gloves do not replace hand hygiene. Hand hygiene is required before putting on gloves and after removing them."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "examination_gloves_and_personal_protective_equipment_ppe_subsection_4",
          "subsection_title": "3. Types, parts, and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_4",
              "group_title": "A. Types of examination gloves",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/examination_gloves_and_personal_protective_equipment_ppe_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "1. Nitrile gloves"
                },
                {
                  "type": "paragraph",
                  "text": "Synthetic rubber gloves widely used in clinical practice. They are a good option for people with latex allergy and generally offer good resistance to punctures and many chemicals."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/examination_gloves_and_personal_protective_equipment_ppe_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "2. Latex gloves"
                },
                {
                  "type": "paragraph",
                  "text": "Provide good fit, sensitivity, and elasticity. Avoid them in people with known or suspected latex allergy."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/examination_gloves_and_personal_protective_equipment_ppe_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "3. Vinyl gloves"
                },
                {
                  "type": "paragraph",
                  "text": "Often used for selected low-risk tasks. They generally provide a looser fit and less durability than nitrile or latex, making them less suitable for many procedures involving significant exposure risk."
                }
              ]
            },
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_5",
              "group_title": "B. Types of gloves by intended use",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Non-sterile examination gloves: Routine examinations and procedures where sterile gloves are not required.",
                      "level": 0
                    },
                    {
                      "text": "Sterile surgical gloves: Sterile procedures, including surgery and selected invasive procedures requiring a sterile field.",
                      "level": 0
                    },
                    {
                      "text": "Heavy-duty utility gloves: Cleaning, decontamination, and handling contaminated equipment when appropriate.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_6",
              "group_title": "C. PPE components",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Component",
                    "Function"
                  ],
                  "rows": [
                    [
                      "Gloves",
                      "Protect hands from contamination and exposure."
                    ],
                    [
                      "Apron",
                      "Protects clothing and exposed skin from splashes."
                    ],
                    [
                      "Gown",
                      "Provides broader body and arm protection."
                    ],
                    [
                      "Surgical mask",
                      "Provides source control and protection against droplets and splashes when appropriate."
                    ],
                    [
                      "N95/FFP2 respirator",
                      "Provides respiratory protection against airborne particles when properly fitted."
                    ],
                    [
                      "Goggles",
                      "Protect the eyes from splashes and droplets."
                    ],
                    [
                      "Face shield",
                      "Protects the face from splashes; it does not replace a respirator when respiratory protection is required."
                    ],
                    [
                      "Head cover",
                      "Used in selected settings according to procedural and infection-control requirements."
                    ],
                    [
                      "Shoe covers",
                      "Used selectively where contamination or procedural requirements justify them; not routinely necessary for all patient care."
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "examination_gloves_and_personal_protective_equipment_ppe_subsection_5",
          "subsection_title": "4. Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Reduces exposure to blood, body fluids, and infectious material.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Helps prevent cross-transmission between patients when combined with hand hygiene and appropriate technique.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Protects mucous membranes and skin when the correct PPE is selected.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Allows healthcare workers to perform procedures more safely.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Supports infection prevention and control in wards, clinics, operating theatres, and emergency settings.",
                      "level": 0,
                      "label": "5."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "examination_gloves_and_personal_protective_equipment_ppe_subsection_6",
          "subsection_title": "5. Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Gloves can tear, puncture, or leak.",
                      "level": 0
                    },
                    {
                      "text": "Prolonged use can cause sweating, skin irritation, or contact dermatitis.",
                      "level": 0
                    },
                    {
                      "text": "Latex may cause allergic reactions.",
                      "level": 0
                    },
                    {
                      "text": "Incorrect removal can contaminate hands or clothing.",
                      "level": 0
                    },
                    {
                      "text": "Gloves may reduce tactile sensitivity during examination.",
                      "level": 0
                    },
                    {
                      "text": "PPE can create heat and discomfort during prolonged use.",
                      "level": 0
                    },
                    {
                      "text": "Incorrectly selected PPE may provide inadequate protection.",
                      "level": 0
                    },
                    {
                      "text": "Respirators require appropriate fit testing and a proper seal; facial hair can interfere with the seal of tight-fitting models.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Key principle: PPE reduces exposure risk but does not eliminate it. Hand hygiene, environmental cleaning, safe sharps handling, and standard precautions remain essential."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "examination_gloves_and_personal_protective_equipment_ppe_subsection_7",
          "subsection_title": "6. Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Before selecting PPE:",
                  "items": [
                    {
                      "text": "Assess the task and anticipated exposure to blood, body fluids, droplets, or airborne particles.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Perform hand hygiene.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Select the correct glove type and size.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Inspect gloves for tears, holes, or damage.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Check that gowns, masks, respirators, and eye protection are appropriate and intact.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Ensure reusable equipment has been appropriately cleaned and disinfected.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Remove jewellery that may interfere with glove integrity or hand hygiene, according to local policy.",
                      "level": 0,
                      "label": "7."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Remember: Gloves should be changed between patients and between contaminated and clean tasks on the same patient when necessary. Never wash or disinfect disposable examination gloves for reuse."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "examination_gloves_and_personal_protective_equipment_ppe_subsection_8",
          "subsection_title": "7. How to use it — step-by-step OSCE demonstration",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_10",
              "group_title": "A. Donning (putting on) non-sterile examination gloves",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/examination_gloves_and_personal_protective_equipment_ppe_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 1: Hand hygiene"
                },
                {
                  "type": "paragraph",
                  "text": "Clean your hands with an appropriate alcohol-based hand rub or soap and water when indicated."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/examination_gloves_and_personal_protective_equipment_ppe_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 2: Inspect and select"
                },
                {
                  "type": "paragraph",
                  "text": "Select the correct size and confirm that the gloves are intact and suitable for the procedure."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/examination_gloves_and_personal_protective_equipment_ppe_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 3: Put on the first glove"
                },
                {
                  "type": "paragraph",
                  "text": "Hold the glove at the cuff and insert one hand without touching unnecessary surfaces."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/examination_gloves_and_personal_protective_equipment_ppe_08.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 4: Put on the second glove"
                },
                {
                  "type": "paragraph",
                  "text": "Insert the other hand and adjust the fit without contaminating the gloved hands."
                },
                {
                  "type": "paragraph",
                  "text": "Step 5: Perform the procedure"
                },
                {
                  "type": "paragraph",
                  "text": "Avoid touching your face, phone, door handles, or clean supplies with contaminated gloves. Change gloves when indicated."
                }
              ]
            },
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_11",
              "group_title": "B. Doffing (removing) contaminated examination gloves",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This is particularly important because the outside of the gloves may be contaminated."
                },
                {
                  "type": "paragraph",
                  "text": "Step 1"
                },
                {
                  "type": "paragraph",
                  "text": "Pinch the outside of one glove near the wrist without touching bare skin."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/examination_gloves_and_personal_protective_equipment_ppe_09.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 2"
                },
                {
                  "type": "paragraph",
                  "text": "Peel the glove away from the hand, turning it inside out. Hold the removed glove in the still-gloved hand."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/examination_gloves_and_personal_protective_equipment_ppe_10.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 3"
                },
                {
                  "type": "paragraph",
                  "text": "Slide the fingers of the ungloved hand under the cuff of the remaining glove, avoiding contact with its contaminated outer surface."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/examination_gloves_and_personal_protective_equipment_ppe_11.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 4"
                },
                {
                  "type": "paragraph",
                  "text": "Peel the second glove off over the first glove, enclosing the contaminated surfaces."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/examination_gloves_and_personal_protective_equipment_ppe_12.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 5"
                },
                {
                  "type": "paragraph",
                  "text": "Dispose of the gloves appropriately and perform hand hygiene immediately."
                }
              ]
            },
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_12",
              "group_title": "C. Donning PPE in a high-risk isolation setting",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The exact order depends on the PPE ensemble and institutional protocol. A common sequence is:"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Perform hand hygiene.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Put on the gown.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Put on the mask or respirator and ensure the correct fit.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Put on goggles or a face shield.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Put on gloves, extending them over the gown cuffs where appropriate.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Check that all exposed areas are adequately covered.",
                      "level": 0,
                      "label": "6."
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_13",
              "group_title": "D. Removing PPE",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Removal order varies with the ensemble and transmission-based precautions. A common approach is to remove the most contaminated items first, avoid touching contaminated surfaces, and perform hand hygiene at the indicated stages."
                },
                {
                  "type": "paragraph",
                  "text": "For airborne precautions, remove the respirator only after leaving the designated contaminated area, according to the applicable protocol."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "examination_gloves_and_personal_protective_equipment_ppe_subsection_9",
          "subsection_title": "8. Contraindications and complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_14",
              "group_title": "Contraindications and precautions",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "There is no general contraindication to wearing appropriate PPE. However:",
                  "items": [
                    {
                      "text": "Avoid latex gloves in people with known latex allergy.",
                      "level": 0
                    },
                    {
                      "text": "Ensure the selected gloves are compatible with the chemicals or substances being handled.",
                      "level": 0
                    },
                    {
                      "text": "Choose sterile rather than non-sterile gloves when a sterile procedure requires them.",
                      "level": 0
                    },
                    {
                      "text": "Select a properly fitted respirator when respiratory protection is indicated.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_15",
              "group_title": "Potential complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Problem",
                    "Prevention"
                  ],
                  "rows": [
                    [
                      "Latex allergy",
                      "Use an appropriate non-latex alternative, such as nitrile."
                    ],
                    [
                      "Contact dermatitis",
                      "Choose suitable materials, maintain skin care, and avoid unnecessary prolonged glove use."
                    ],
                    [
                      "Cross-contamination during removal",
                      "Use the correct removal technique and perform hand hygiene."
                    ],
                    [
                      "Glove perforation",
                      "Inspect gloves, use suitable gloves, and replace damaged gloves immediately."
                    ],
                    [
                      "Respirator leakage",
                      "Perform fit testing and a user seal check as required."
                    ],
                    [
                      "Contamination of clothing",
                      "Use an appropriate apron or gown for the anticipated exposure."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Examiner's question: Can gloves prevent all needlestick injuries?"
                },
                {
                  "type": "paragraph",
                  "text": "Model answer: No. Gloves may reduce contamination and sometimes reduce the volume of blood transferred, but they do not reliably prevent needlestick injury. Safe sharps handling and proper disposal are essential."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "examination_gloves_and_personal_protective_equipment_ppe_subsection_10",
          "subsection_title": "9. Normal and abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This is not primarily a diagnostic instrument station. Nevertheless, examiners may ask you to inspect PPE before use."
                },
                {
                  "type": "list",
                  "title": "Acceptable findings:",
                  "items": [
                    {
                      "text": "Gloves are intact and free of visible defects.",
                      "level": 0
                    },
                    {
                      "text": "The correct size and material have been selected.",
                      "level": 0
                    },
                    {
                      "text": "The mask or respirator is intact and appropriately fitted.",
                      "level": 0
                    },
                    {
                      "text": "The gown provides the required coverage.",
                      "level": 0
                    },
                    {
                      "text": "Eye protection is clean and undamaged.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "list",
                  "title": "Abnormal findings requiring correction:",
                  "items": [
                    {
                      "text": "Torn, punctured, or visibly damaged gloves.",
                      "level": 0
                    },
                    {
                      "text": "An expired or damaged respirator.",
                      "level": 0
                    },
                    {
                      "text": "Incorrectly sized gloves that compromise dexterity or integrity.",
                      "level": 0
                    },
                    {
                      "text": "A poorly fitting respirator.",
                      "level": 0
                    },
                    {
                      "text": "Contaminated or damaged reusable eye protection.",
                      "level": 0
                    },
                    {
                      "text": "Missing PPE components for the anticipated exposure risk.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "examination_gloves_and_personal_protective_equipment_ppe_subsection_11",
          "subsection_title": "10. Pediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Pediatric care requires the same infection prevention principles as adult care, with attention to the child's size and vulnerability."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Use appropriately sized gloves to preserve dexterity during neonatal cannulation, venepuncture, and other delicate procedures.",
                      "level": 0
                    },
                    {
                      "text": "Perform hand hygiene before and after contact with each child, even when gloves are worn.",
                      "level": 0
                    },
                    {
                      "text": "Change gloves between children and when moving from contaminated to clean tasks.",
                      "level": 0
                    },
                    {
                      "text": "Use appropriate eye and face protection during procedures likely to generate splashes.",
                      "level": 0
                    },
                    {
                      "text": "For neonatal resuscitation, choose PPE based on the procedure and anticipated exposure.",
                      "level": 0
                    },
                    {
                      "text": "Do not allow gloves to substitute for aseptic technique during umbilical catheterisation, central line insertion, or other invasive procedures.",
                      "level": 0
                    },
                    {
                      "text": "Keep unused gloves and PPE away from contaminated surfaces and clinical waste.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "High-yield point: Sterile gloves are required for procedures that demand sterility, not simply because the patient is a neonate."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "examination_gloves_and_personal_protective_equipment_ppe_subsection_12",
          "subsection_title": "11. Mnemonics and memory aids",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_18",
              "group_title": "PPE selection: RACE",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "R — Risk: Assess the anticipated exposure.",
                      "level": 0
                    },
                    {
                      "text": "A — Appropriate equipment: Select PPE for the task and transmission route.",
                      "level": 0
                    },
                    {
                      "text": "C — Correct fit: Check size, integrity, and respirator fit where applicable.",
                      "level": 0
                    },
                    {
                      "text": "E — Exit safely: Remove PPE correctly and perform hand hygiene.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_19",
              "group_title": "Glove removal: PINCH–PEEL–SLIDE–PEEL–CLEAN",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Pinch the outside of the first glove.",
                      "level": 0
                    },
                    {
                      "text": "Peel it off inside out.",
                      "level": 0
                    },
                    {
                      "text": "Slide fingers under the second glove's cuff.",
                      "level": 0
                    },
                    {
                      "text": "Peel it off over the first glove.",
                      "level": 0
                    },
                    {
                      "text": "Clean your hands.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_20",
              "group_title": "Remember the five moments of hand hygiene",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "The WHO framework identifies hand hygiene:",
                  "items": [
                    {
                      "text": "Before touching a patient.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Before a clean or aseptic procedure.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "After body fluid exposure risk.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "After touching a patient.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "After touching the patient's surroundings.",
                      "level": 0,
                      "label": "5."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Gloves do not replace any of these indications."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "examination_gloves_and_personal_protective_equipment_ppe_subsection_13",
          "subsection_title": "12. Common OSCE questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_21",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is the difference between sterile and non-sterile gloves?"
                },
                {
                  "type": "paragraph",
                  "text": "Sterile gloves are processed and packaged to meet sterility requirements and are used for procedures requiring a sterile field. Non-sterile examination gloves are used for routine care when sterility is not required."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Why is hand hygiene necessary after removing gloves?"
                },
                {
                  "type": "paragraph",
                  "text": "Gloves may have microscopic defects, and hands may become contaminated during removal. Hand hygiene removes or inactivates microorganisms acquired during care."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What is the difference between a surgical mask and an N95 respirator?"
                },
                {
                  "type": "paragraph",
                  "text": "A surgical mask provides source control and barrier protection against droplets and splashes, depending on its design. An N95 respirator is designed to filter airborne particles and requires appropriate fit and seal."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. When should gloves be changed?"
                },
                {
                  "type": "paragraph",
                  "text": "Between patients, when moving from a contaminated to a clean task, when damaged, and whenever contamination makes continued use inappropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. Should gloves be worn for every patient examination?"
                },
                {
                  "type": "paragraph",
                  "text": "No. Gloves are indicated when contact with blood, body fluids, mucous membranes, non-intact skin, or contaminated materials is anticipated. Hand hygiene is still required for routine contact."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What is the purpose of a face shield?"
                },
                {
                  "type": "paragraph",
                  "text": "It protects the face from splashes and sprays. It does not replace a respirator when airborne respiratory protection is required."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. Can you reuse disposable examination gloves?"
                },
                {
                  "type": "paragraph",
                  "text": "No. Disposable examination gloves must not be washed, disinfected, or reused between tasks or patients."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. What should you do if a glove tears during a procedure?"
                },
                {
                  "type": "paragraph",
                  "text": "Stop when safe, remove the damaged glove, perform hand hygiene as indicated, replace it with a new glove, and assess whether exposure occurred. Follow occupational exposure procedures if necessary."
                },
                {
                  "type": "paragraph",
                  "text": "Q9. What is the most important step before putting on gloves?"
                },
                {
                  "type": "paragraph",
                  "text": "Hand hygiene, together with selecting the appropriate glove type and size."
                },
                {
                  "type": "paragraph",
                  "text": "Q10. What are standard precautions?"
                },
                {
                  "type": "paragraph",
                  "text": "Infection prevention measures applied to all patients, regardless of suspected or confirmed infection status, including hand hygiene, risk-based PPE, respiratory hygiene, safe injection practices, and appropriate sharps handling."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "examination_gloves_and_personal_protective_equipment_ppe_subsection_14",
          "subsection_title": "13. Common mistakes and examiner tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "examination_gloves_and_personal_protective_equipment_ppe_group_22",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Mistake: Wearing gloves without hand hygiene"
                },
                {
                  "type": "paragraph",
                  "text": "Perform hand hygiene before putting on gloves and after removing them."
                },
                {
                  "type": "paragraph",
                  "text": "Mistake: Touching clean equipment with contaminated gloves"
                },
                {
                  "type": "paragraph",
                  "text": "Change gloves and clean your hands when moving from contaminated to clean tasks."
                },
                {
                  "type": "paragraph",
                  "text": "Mistake: Confusing a surgical mask with a respirator"
                },
                {
                  "type": "paragraph",
                  "text": "Explain the difference in filtration, fit, and intended use."
                },
                {
                  "type": "paragraph",
                  "text": "Mistake: Removing PPE carelessly"
                },
                {
                  "type": "paragraph",
                  "text": "Demonstrate controlled removal, avoiding contact with contaminated surfaces."
                },
                {
                  "type": "paragraph",
                  "text": "What impresses the examiner"
                },
                {
                  "type": "paragraph",
                  "text": "State that PPE selection is risk-based, demonstrate glove removal correctly, emphasise hand hygiene, and explain the difference between standard and transmission-based precautions."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}