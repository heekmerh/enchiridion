          "subsection_id": "splint_subsection_13",
          "subsection_title": "12. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "splint_group_20",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a splint, an external device used to immobilise and support an injured body part. It may be made from plaster, fibreglass, metal, plastic, foam or vacuum material. Splints may be static, dynamic, functional or designed for emergency immobilisation. They are used for selected fractures, soft-tissue injuries, postoperative protection and emergency transport. Their advantages include rapid application, support and accommodation of swelling in many designs. Disadvantages include possible slippage and less complete immobilisation than some casts. Complications include pressure injury, nerve compression, neurovascular compromise and compartment syndrome. Safe application requires appropriate padding, secure but non-constrictive fixation, and neurovascular assessment before and after application.”",
                  "style": "quote"
                }
              ]
            }
          ]
