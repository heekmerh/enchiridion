        },
        {
          "subsection_id": "splint_subsection_2",
          "subsection_title": "1. Introduction and definition",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "splint_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A splint is an external supportive device used to immobilise, protect or stabilise an injured body part, usually without completely enclosing the limb circumferentially."
                },
                {
                  "type": "paragraph",
                  "text": "Splints are commonly used in emergency medicine, orthopaedics, trauma care, sports medicine and rehabilitation."
                },
                {
                  "type": "paragraph",
                  "text": "They may be made from plaster, fibreglass, metal, plastic, wood, foam or inflatable or vacuum materials."
                },
                {
                  "type": "paragraph",
                  "text": "Key identifying feature: A rigid or semi-rigid support that holds an injured body part in a prescribed position, often secured with bandages or straps."
                }
              ]
            },
            {
              "group_id": "splint_group_3",
              "group_title": "Essential distinction",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Splint: Usually does not completely encircle the limb; many types accommodate swelling.",
                      "level": 0
                    },
                    {
                      "text": "Complete cast: Generally surrounds the limb circumferentially and provides sustained immobilisation.",
                      "level": 0
                    },
                    {
                      "text": "Brace: Often designed to support a joint while allowing a prescribed degree of movement.",
                      "level": 0
                    },
                    {
                      "text": "Traction device: Applies a controlled pulling force to maintain alignment or reduce muscle spasm in selected injuries.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A splint is not necessarily rigid. Some are soft or vacuum-based, and their degree of immobilisation varies."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "splint_subsection_3",
          "subsection_title": "2. Identification in an OSCE station",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "splint_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/splint_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Model identification"
                },
                {
                  "type": "paragraph",
                  "text": "“This is a splint, an external orthopaedic or emergency device used to immobilise and support an injured body part, reduce movement-related pain and protect tissues during transport or treatment.”",
                  "style": "quote"
                },
                {
                  "type": "paragraph",
                  "text": "Key properties"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "May be rigid, semi-rigid or flexible.",
                      "level": 0
                    },
                    {
                      "text": "Can be temporary or designed for ongoing use.",
                      "level": 0
                    },
                    {
                      "text": "May be adjustable or mouldable.",
                      "level": 0
                    },
                    {
                      "text": "Usually secured with straps or a bandage.",
                      "level": 0
                    },
                    {
                      "text": "Many designs permit repeated neurovascular assessment without complete removal.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "splint_subsection_4",
          "subsection_title": "3. Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "splint_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The components depend on the type of splint presented."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/splint_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "1. Supporting frame"
                },
                {
                  "type": "paragraph",
                  "text": "The rigid or semi-rigid component that limits movement and maintains the required position."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/splint_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "2. Padding"
                },
                {
                  "type": "paragraph",
                  "text": "Protects the skin and bony prominences from friction and pressure."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/splint_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "3. Straps or fastening bandages"
                },
                {
                  "type": "paragraph",
                  "text": "Secure the splint to the limb without excessive constriction."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/splint_08.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "4. Moulded or contoured surface"
                },
                {
                  "type": "paragraph",
                  "text": "Present in many designs to conform to the anatomy and improve stability."
                },
                {
                  "type": "paragraph",
                  "text": "Other components may include buckles, hinges, inflatable chambers, vacuum valves or a rigid base, depending on the device."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "splint_subsection_5",
          "subsection_title": "4. Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "splint_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Splints can be classified by their material, construction, anatomical site and clinical function."
                }
              ]
            },
            {
              "group_id": "splint_group_7",
              "group_title": "A. According to material and construction",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/splint_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "1. Plaster splint"
                },
                {
                  "type": "paragraph",
                  "text": "Constructed from POP layers and padding."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Highly mouldable.",
                      "level": 0
                    },
                    {
                      "text": "Useful for acute fractures when swelling is anticipated.",
                      "level": 0
                    },
                    {
                      "text": "Heavier and more vulnerable to water damage than many synthetic alternatives.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/splint_09.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "2. Fibreglass splint"
                },
                {
                  "type": "paragraph",
                  "text": "Made using synthetic casting material."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Generally lighter than POP.",
                      "level": 0
                    },
                    {
                      "text": "Durable once set.",
                      "level": 0
                    },
                    {
                      "text": "May be less forgiving during moulding, depending on the product.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/splint_10.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "3. Metal or aluminium splint"
                },
                {
                  "type": "paragraph",
                  "text": "Often padded and mouldable."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Commonly used for finger injuries.",
                      "level": 0
                    },
                    {
                      "text": "Lightweight and easy to shape.",
                      "level": 0
                    },
                    {
                      "text": "Can cause pressure injury if poorly fitted.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/splint_11.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "4. Mouldable foam or SAM-type splint"
                },
                {
                  "type": "paragraph",
                  "text": "A flexible core is shaped to provide rigidity."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Lightweight and portable.",
                      "level": 0
                    },
                    {
                      "text": "Useful for first aid and emergency immobilisation.",
                      "level": 0
                    },
                    {
                      "text": "Requires appropriate shaping and secure fixation.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/splint_12.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "5. Vacuum splint"
                },
                {
                  "type": "paragraph",
                  "text": "A flexible shell containing small particles becomes rigid when air is evacuated."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Conforms closely to the limb.",
                      "level": 0
                    },
                    {
                      "text": "Useful in emergency transport.",
                      "level": 0
                    },
                    {
                      "text": "Requires an intact system and a suitable vacuum source.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "splint_group_8",
              "group_title": "B. According to function",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Static splint: Holds a body part in a fixed position.",
                      "level": 0
                    },
                    {
                      "text": "Dynamic splint: Applies a controlled force to assist movement.",
                      "level": 0
                    },
                    {
                      "text": "Functional splint: Protects an injured structure while allowing selected movements.",
                      "level": 0
                    },
                    {
                      "text": "Emergency splint: Provides temporary immobilisation during first aid or transport.",
                      "level": 0
                    },
                    {
                      "text": "Postoperative splint: Protects a repair or surgical site.",
                      "level": 0
                    },
                    {
                      "text": "Serial splint: Adjusted or replaced progressively to improve a contracture or deformity.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These categories can overlap; for example, a finger splint may be static and postoperative."
                }
              ]
            },
            {
              "group_id": "splint_group_9",
              "group_title": "C. Common anatomical splints",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Splint",
                    "Common indication"
                  ],
                  "rows": [
                    [
                      "Finger splint",
                      "Selected phalangeal fractures and finger injuries"
                    ],
                    [
                      "Volar wrist splint",
                      "Selected wrist injuries and soft-tissue conditions"
                    ],
                    [
                      "Sugar-tong splint",
                      "Selected distal radius and forearm injuries"
                    ],
                    [
                      "Posterior long-leg splint",
                      "Selected acute knee or lower-leg injuries"
                    ],
                    [
                      "Ankle stirrup splint",
                      "Selected ankle injuries"
                    ],
                    [
                      "Thumb spica splint",
                      "Selected thumb injuries, including suspected scaphoid injury when appropriately designed"
                    ],
                    [
                      "Ulnar gutter splint",
                      "Selected fourth- and fifth-metacarpal or finger injuries"
                    ],
                    [
                      "Radial gutter splint",
                      "Selected index- and middle-finger metacarpal injuries"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The precise choice depends on the injury pattern and local orthopaedic protocol."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "splint_subsection_6",
          "subsection_title": "5. Indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "splint_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Splints are used to:",
                  "items": [
                    {
                      "text": "Immobilise suspected or confirmed fractures.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Reduce pain caused by movement at an injured site.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Protect injured ligaments, tendons and soft tissues.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Stabilise a limb during transport.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Accommodate swelling in acute injuries.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Protect postoperative repairs.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Maintain selected joints in a therapeutic position.",
                      "level": 0,
                      "label": "7."
                    },
                    {
                      "text": "Prevent or treat selected contractures.",
                      "level": 0,
                      "label": "8."
                    },
                    {
                      "text": "Restrict movement while further imaging or specialist assessment is arranged.",
                      "level": 0,
                      "label": "9."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Clinical principle: Immobilise the injury appropriately while avoiding unnecessary restriction of unaffected joints."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "splint_subsection_7",
          "subsection_title": "6. Principles of fracture splinting",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "splint_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A classic orthopaedic principle is to immobilise the injured area and the joints above and below the fracture when appropriate for the bone and injury."
                },
                {
                  "type": "paragraph",
                  "text": "For example, a suspected shaft fracture of the forearm generally requires control of the wrist and elbow."
                },
                {
                  "type": "paragraph",
                  "text": "However, this is not a universal rule for every injury. Some injuries require a specific splint configuration, and suspected spinal or pelvic injuries require their own protocols."
                }
              ]
            },
            {
              "group_id": "splint_group_12",
              "group_title": "Important principles",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Assess and document distal neurovascular status before application.",
                      "level": 0
                    },
                    {
                      "text": "Control major external bleeding and address immediately life-threatening problems first.",
                      "level": 0
                    },
                    {
                      "text": "Remove rings, watches and other constricting objects where feasible.",
                      "level": 0
                    },
                    {
                      "text": "Apply padding over bony prominences.",
                      "level": 0
                    },
                    {
                      "text": "Avoid unnecessary manipulation of the injured limb.",
                      "level": 0
                    },
                    {
                      "text": "Do not attempt fracture reduction unless trained, authorised and clinically indicated.",
                      "level": 0
                    },
                    {
                      "text": "Secure the splint without excessive pressure.",
                      "level": 0
                    },
                    {
                      "text": "Reassess circulation, sensation and movement after application.",
                      "level": 0
                    },
                    {
                      "text": "Document the findings and arrange appropriate imaging and definitive care.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "splint_subsection_8",
          "subsection_title": "7. General application technique",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "splint_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Step 1 — Assess"
                },
                {
                  "type": "paragraph",
                  "text": "Identify the injury, inspect for open wounds and check distal pulses, capillary refill, sensation and motor function as appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Step 2 — Prepare"
                },
                {
                  "type": "paragraph",
                  "text": "Select a suitable splint, gather padding and fixation materials, and remove constricting jewellery where possible."
                },
                {
                  "type": "paragraph",
                  "text": "Step 3 — Position and pad"
                },
                {
                  "type": "paragraph",
                  "text": "Support the limb in the appropriate position and pad the splint, particularly over bony prominences."
                },
                {
                  "type": "paragraph",
                  "text": "Step 4 — Apply"
                },
                {
                  "type": "paragraph",
                  "text": "Place the splint against the limb, maintaining appropriate alignment and avoiding unnecessary movement or forceful manipulation."
                },
                {
                  "type": "paragraph",
                  "text": "Step 5 — Secure"
                },
                {
                  "type": "paragraph",
                  "text": "Use straps or bandages to hold the splint in position. Ensure that fixation is secure but not constrictive."
                },
                {
                  "type": "paragraph",
                  "text": "Step 6 — Reassess and document"
                },
                {
                  "type": "paragraph",
                  "text": "Repeat the neurovascular examination, document the findings and arrange appropriate follow-up or transfer."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "splint_subsection_9",
          "subsection_title": "8. Advantages and disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "splint_group_14",
              "group_title": "Advantages",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Many designs accommodate swelling.",
                      "level": 0
                    },
                    {
                      "text": "Can be applied relatively quickly.",
                      "level": 0
                    },
                    {
                      "text": "Reduces movement-related pain.",
                      "level": 0
                    },
                    {
                      "text": "Often allows easier skin inspection.",
                      "level": 0
                    },
                    {
                      "text": "Useful during emergency transport.",
                      "level": 0
                    },
                    {
                      "text": "Available in reusable and disposable forms.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "splint_group_15",
              "group_title": "Disadvantages",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "May provide less complete immobilisation than a suitable cast.",
                      "level": 0
                    },
                    {
                      "text": "Can slip or become displaced.",
                      "level": 0
                    },
                    {
                      "text": "Poor padding may cause pressure injury.",
                      "level": 0
                    },
                    {
                      "text": "Requires secure fixation.",
                      "level": 0
                    },
                    {
                      "text": "Some designs are bulky.",
                      "level": 0
                    },
                    {
                      "text": "Incorrect application may worsen pain or compromise circulation.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "splint_subsection_10",
          "subsection_title": "9. Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "splint_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Explanation"
                  ],
                  "rows": [
                    [
                      "Neurovascular compromise",
                      "Excessive pressure from straps, bandages or swelling"
                    ],
                    [
                      "Compartment syndrome",
                      "Increased pressure within a closed muscle compartment"
                    ],
                    [
                      "Pressure sores",
                      "Poor padding or focal pressure"
                    ],
                    [
                      "Nerve compression",
                      "Local pressure over a superficial nerve"
                    ],
                    [
                      "Skin irritation",
                      "Friction, moisture or material sensitivity"
                    ],
                    [
                      "Loss of alignment",
                      "Inadequate support or splint displacement"
                    ],
                    [
                      "Increased pain",
                      "Poor positioning, movement or excessive pressure"
                    ],
                    [
                      "Joint stiffness",
                      "Prolonged immobilisation"
                    ],
                    [
                      "Delayed definitive treatment",
                      "Inappropriate reliance on temporary immobilisation without reassessment"
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "splint_group_17",
              "group_title": "Emergency warning signs",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Increasing pain, pain on passive stretch, paraesthesia, weakness, progressive swelling or cold, pale or blue digits require urgent reassessment."
                },
                {
                  "type": "paragraph",
                  "text": "A palpable distal pulse does not exclude compartment syndrome. Do not wait for all the classic signs before escalating care."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "splint_subsection_11",
          "subsection_title": "10. Splint versus cast",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "splint_group_18",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Splint",
                    "Complete cast"
                  ],
                  "rows": [
                    [
                      "Circumferential coverage",
                      "Usually incomplete",
                      "Usually circumferential"
                    ],
                    [
                      "Swelling accommodation",
                      "Generally better",
                      "More limited unless split or modified"
                    ],
                    [
                      "Application",
                      "Often quicker",
                      "May require more preparation and material"
                    ],
                    [
                      "Stability",
                      "Depends on design and injury",
                      "Often provides more sustained circumferential support"
                    ],
                    [
                      "Skin inspection",
                      "Usually easier",
                      "More difficult without removal or modification"
                    ],
                    [
                      "Common role",
                      "Acute injury and temporary immobilisation",
                      "Selected definitive fracture immobilisation"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Neither is universally superior. The choice depends on swelling, fracture stability, soft-tissue condition and the treatment plan."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "splint_subsection_12",
          "subsection_title": "11. High-yield OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "splint_group_19",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "1. What is a splint?"
                },
                {
                  "type": "paragraph",
                  "text": "2. Why is a splint often preferred during the acute phase of an injury?"
                },
                {
                  "type": "paragraph",
