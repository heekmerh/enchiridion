  "sections": [
    {
      "section_id": "nasal_speculum_section_1",
      "section_title": "Nasal speculum",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "nasal_speculum_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_speculum_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/nasal_speculum_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "The nasal speculum is an ENT examination instrument used to gently separate the nostril and allow visualisation of the anterior nasal cavity. It is commonly used during anterior rhinoscopy to assess the nasal septum, turbinates, mucosa, discharge, bleeding and visible foreign bodies."
                },
                {
                  "type": "paragraph",
                  "text": "The key OSCE skill is demonstrating safe insertion: introduce the closed blades gently into the nostril, then open them only enough to visualise the cavity without pressing against the sensitive nasal septum."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_speculum_subsection_2",
          "subsection_title": "Identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_speculum_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Name: Nasal speculum."
                },
                {
                  "type": "paragraph",
                  "text": "Classification: ENT diagnostic instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Common type: Thudichum nasal speculum."
                },
                {
                  "type": "paragraph",
                  "text": "Function: Retracts the nasal vestibule to improve visualisation of the anterior nasal cavity."
                },
                {
                  "type": "paragraph",
                  "text": "Distinguishing features: Two short, blunt blades joined by a hinge or spring mechanism, with handles that allow the blades to open and close."
                },
                {
                  "type": "paragraph",
                  "text": "Other designs may be incorporated into an otoscope or specialised ENT examination system."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_speculum_subsection_3",
          "subsection_title": "Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_speculum_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Indication",
                    "Purpose"
                  ],
                  "rows": [
                    [
                      "Anterior rhinoscopy",
                      "Examine the anterior nasal cavity"
                    ],
                    [
                      "Epistaxis",
                      "Identify a visible bleeding point or source"
                    ],
                    [
                      "Nasal obstruction",
                      "Look for swelling, septal deviation or visible lesions"
                    ],
                    [
                      "Rhinitis",
                      "Assess mucosal inflammation and secretions"
                    ],
                    [
                      "Suspected nasal foreign body",
                      "Inspect the anterior cavity when appropriate"
                    ],
                    [
                      "Nasal discharge",
                      "Assess the character and source of visible discharge"
                    ],
                    [
                      "Pre-procedure assessment",
                      "Inspect the nasal cavity before selected ENT procedures"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Limitation: A standard nasal speculum provides a view of the anterior nasal cavity; it does not adequately visualise all deeper nasal structures or the nasopharynx."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_speculum_subsection_4",
          "subsection_title": "Parts and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_speculum_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/nasal_speculum_02.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Blades"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Separate the nostril gently. Their tips should be smooth and blunt to minimise mucosal injury."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/nasal_speculum_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Hinge or spring mechanism"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Allows the blades to open and close in a controlled manner."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/nasal_speculum_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Handles"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Allow the examiner to control blade movement and maintain a stable grip."
                },
                {
                  "type": "paragraph",
                  "text": "Depending on the model, the instrument may have a screw, spring or other mechanism controlling blade movement."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_speculum_subsection_5",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_speculum_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Simple and quick to use."
                },
                {
                  "type": "paragraph",
                  "text": "Allows direct inspection of the anterior nasal cavity."
                },
                {
                  "type": "paragraph",
                  "text": "Portable and reusable when appropriately reprocessed."
                },
                {
                  "type": "paragraph",
                  "text": "Does not require complex equipment."
                },
                {
                  "type": "paragraph",
                  "text": "Useful in the initial assessment of common nasal complaints."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_speculum_subsection_6",
          "subsection_title": "Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_speculum_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "May cause discomfort if inserted too deeply or opened excessively."
                },
                {
                  "type": "paragraph",
                  "text": "Can injure the nasal mucosa and provoke bleeding if handled roughly."
                },
                {
                  "type": "paragraph",
                  "text": "Visualisation may be limited by severe oedema, crusting, blood or narrow nasal passages."
                },
                {
                  "type": "paragraph",
                  "text": "Does not replace nasal endoscopy when deeper visualisation is needed."
                },
                {
                  "type": "paragraph",
                  "text": "Requires an adequate light source and appropriate positioning."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_speculum_subsection_7",
          "subsection_title": "Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_speculum_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Before the examination:"
                },
                {
                  "type": "paragraph",
                  "text": "Explain the procedure and obtain consent."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm the patient's identity and symptoms, including pain, obstruction and recent nasal trauma."
                },
                {
                  "type": "paragraph",
                  "text": "Perform hand hygiene."
                },
                {
                  "type": "paragraph",
                  "text": "Check that the instrument is clean, intact and appropriately sterilised or reprocessed according to local policy."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure adequate illumination, such as a headlight or examination light."
                },
                {
                  "type": "paragraph",
                  "text": "Position the patient sitting upright, with the head supported and slightly tilted back as appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the external nose and nostrils before inserting the speculum."
                },
                {
                  "type": "paragraph",
                  "text": "Select an appropriately sized instrument."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Important precautions"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Use particular caution after recent nasal trauma or surgery."
                },
                {
                  "type": "paragraph",
                  "text": "Do not force the speculum into a narrow or obstructed nostril."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid excessive pressure on the nasal septum."
                },
                {
                  "type": "paragraph",
                  "text": "If there is active heavy bleeding, airway compromise or suspected significant facial injury, prioritise urgent assessment and stabilisation rather than routine examination."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_speculum_subsection_8",
          "subsection_title": "Step-by-step practical use",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_speculum_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Step 1 — Introduce and explain"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Introduce yourself, confirm the patient's identity, explain anterior rhinoscopy and obtain consent."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 2 — Position and illuminate"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Seat the patient comfortably, support the head and direct the examination light into the nostril."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 3 — Inspect externally"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Look for deformity, swelling, skin lesions, asymmetry and visible discharge. Inspect the nostril before introducing the instrument."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 4 — Insert the speculum"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Hold the speculum securely with its blades closed. Gently introduce the tips just inside the nasal vestibule, directing them appropriately along the nasal passage. Do not insert deeply or force them against resistance."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 5 — Open and examine"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Open the blades gently, only enough to separate the vestibule. Inspect the septum, inferior turbinate, mucosa, visible discharge, crusts, bleeding points, polyps or foreign bodies."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 6 — Withdraw and finish"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Close the blades before withdrawing the instrument. Repeat on the other side if appropriate, ask about discomfort, thank the patient and document the findings."
                }
              ]
            },
            {
              "group_id": "nasal_speculum_group_9",
              "group_title": "What should you inspect?",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/nasal_speculum_05.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/nasal_speculum_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Septum: Midline or deviated; look for perforation, crusting or bleeding."
                },
                {
                  "type": "paragraph",
                  "text": "Mucosa: Pink and moist normally; assess for pallor, erythema, oedema, dryness or ulceration."
                },
                {
                  "type": "paragraph",
                  "text": "Inferior turbinate: Assess size and swelling."
                },
                {
                  "type": "paragraph",
                  "text": "Discharge: Note whether it is clear, mucoid, purulent or blood-stained."
                },
                {
                  "type": "paragraph",
                  "text": "Other findings: Crusts, visible foreign bodies, polyps, masses or a bleeding point."
                },
                {
                  "type": "paragraph",
                  "text": "Do not claim a complete nasal examination from anterior rhinoscopy alone."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_speculum_subsection_9",
          "subsection_title": "Contraindications and complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_speculum_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A nasal speculum has few absolute contraindications, but certain situations require caution or an alternative approach."
                },
                {
                  "type": "table",
                  "columns": [
                    "Situation",
                    "Precaution"
                  ],
                  "rows": [
                    [
                      "Recent nasal trauma",
                      "Avoid forceful manipulation; consider fracture or other injury"
                    ],
                    [
                      "Active severe epistaxis",
                      "Prioritise assessment and haemorrhage control"
                    ],
                    [
                      "Severe nasal obstruction",
                      "Do not force the instrument through the passage"
                    ],
                    [
                      "Recent nasal surgery",
                      "Follow the treating clinician's instructions"
                    ],
                    [
                      "Uncooperative or distressed child",
                      "Use an age-appropriate approach and avoid restraint that risks injury"
                    ]
                  ]
                },
                {
                  "type": "checklist",
                  "items": [
                    "Possible complications"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Pain or discomfort."
                },
                {
                  "type": "paragraph",
                  "text": "Minor mucosal abrasion or epistaxis."
                },
                {
                  "type": "paragraph",
                  "text": "Aggravation of an existing nasal injury."
                },
                {
                  "type": "paragraph",
                  "text": "Rarely, injury from excessive force or incorrect insertion."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_speculum_subsection_10",
          "subsection_title": "Normal and abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_speculum_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Finding",
                    "Possible interpretation"
                  ],
                  "rows": [
                    [
                      "Pink, moist mucosa",
                      "Generally normal"
                    ],
                    [
                      "Midline septum",
                      "No obvious septal deviation"
                    ],
                    [
                      "Pale, swollen mucosa",
                      "May suggest allergic rhinitis"
                    ],
                    [
                      "Red, inflamed mucosa",
                      "May occur with rhinitis or irritation"
                    ],
                    [
                      "Purulent discharge",
                      "May occur with infective or inflammatory disease; interpret clinically"
                    ],
                    [
                      "Septal deviation",
                      "Structural cause of nasal obstruction"
                    ],
                    [
                      "Visible polyp",
                      "Suggests nasal polyp disease; requires appropriate assessment"
                    ],
                    [
                      "Fresh blood or visible bleeding point",
                      "May indicate epistaxis"
                    ],
                    [
                      "Crusting or ulceration",
                      "May occur with dryness, trauma or other nasal disease"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Findings should be interpreted alongside the patient's symptoms and the rest of the ENT examination."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_speculum_subsection_11",
          "subsection_title": "Paediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_speculum_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Use a smaller, age-appropriate nasal speculum when indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Explain the examination in simple language and obtain appropriate consent and assent."
                },
                {
                  "type": "paragraph",
                  "text": "A parent or caregiver may help reassure the child."
                },
                {
                  "type": "paragraph",
                  "text": "Keep the child comfortably positioned, with the head supported."
                },
                {
                  "type": "paragraph",
                  "text": "Use gentle, brief movements; children have delicate nasal mucosa and may move suddenly."
                },
                {
                  "type": "paragraph",
                  "text": "Never force the instrument into a narrow nostril or restrain a distressed child in a way that risks injury."
                },
                {
                  "type": "paragraph",
                  "text": "If a foreign body is suspected, assess its location and nature before deciding on removal. Suspected button batteries or paired magnets in the nose require urgent specialist management."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_speculum_subsection_12",
          "subsection_title": "Mnemonics and memory aids",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_speculum_group_13",
              "group_title": "What to inspect: S-M-T-D",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "S — Septum",
                    "M — Mucosa",
                    "T — Turbinates",
                    "D — Discharge"
                  ]
                }
              ]
            },
            {
              "group_id": "nasal_speculum_group_14",
              "group_title": "Safe technique: C-O-C",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "C — Closed blades for insertion."
                },
                {
                  "type": "paragraph",
                  "text": "O — Open gently for observation."
                },
                {
                  "type": "paragraph",
                  "text": "C — Close before coming out."
                },
                {
                  "type": "paragraph",
                  "text": "Remember: Never force, never open excessively, and never withdraw with the blades spread."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_speculum_subsection_13",
          "subsection_title": "Common OSCE questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_speculum_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. Identify this instrument."
                },
                {
                  "type": "paragraph",
                  "text": "This is a nasal speculum, commonly a Thudichum nasal speculum, used to separate the nasal vestibule and facilitate anterior rhinoscopy."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Mention four indications."
                },
                {
                  "type": "paragraph",
                  "text": "Anterior nasal examination, assessment of epistaxis, investigation of nasal obstruction and examination of nasal discharge."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Name the main parts."
                },
                {
                  "type": "paragraph",
                  "text": "The blades, hinge or spring mechanism, and handles."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. What structures do you examine during anterior rhinoscopy?"
                },
                {
                  "type": "paragraph",
                  "text": "The nasal septum, nasal mucosa, inferior turbinate and visible discharge, crusts, bleeding points, polyps or foreign bodies."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. How do you use a nasal speculum safely?"
                },
                {
                  "type": "paragraph",
                  "text": "I would explain the procedure, obtain consent, position the patient and provide adequate illumination. I would gently insert the closed blades just inside the vestibule, open them minimally to inspect the anterior cavity, then close them before withdrawal."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What are the complications?"
                },
                {
                  "type": "paragraph",
                  "text": "Pain, mucosal trauma and epistaxis; more serious injury is possible if the instrument is forced or used incorrectly."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What is the difference between anterior rhinoscopy and nasal endoscopy?"
                },
                {
                  "type": "paragraph",
                  "text": "Anterior rhinoscopy uses a speculum and light to inspect the anterior nasal cavity. Nasal endoscopy uses an endoscope to visualise deeper nasal structures and, when appropriate, the nasopharynx."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_speculum_subsection_14",
          "subsection_title": "Common mistakes and examiner tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_speculum_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Avoid these errors:"
                },
                {
                  "type": "paragraph",
                  "text": "Inserting the speculum with the blades already widely open."
                },
                {
                  "type": "paragraph",
                  "text": "Forcing the instrument into the nostril."
                },
                {
                  "type": "paragraph",
                  "text": "Applying pressure to the septum."
                },
                {
                  "type": "paragraph",
                  "text": "Opening the blades excessively."
                },
                {
                  "type": "paragraph",
                  "text": "Withdrawing without closing the blades."
                },
                {
                  "type": "paragraph",
                  "text": "Forgetting to examine both sides when appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Describing only the instrument without explaining its clinical use."
                },
                {
                  "type": "paragraph",
                  "text": "Claiming that anterior rhinoscopy visualises the entire nasal cavity."
                },
                {
                  "type": "paragraph",
                  "text": "Examiner tip: In a practical station, demonstrate the movement slowly and explain each action aloud. Safe technique is often as important as identifying the instrument."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_speculum_subsection_15",
          "subsection_title": "Mini-OSCE practice quiz",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_speculum_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "1. What is the primary purpose of a nasal speculum?"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Inspect the larynx",
                    "Separate the nasal vestibule for anterior examination",
                    "Measure hearing thresholds"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "2. How should the blades be positioned during insertion?"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Widely open",
                    "Closed and introduced gently",
                    "Fully open against the septum"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "3. Which structure is routinely assessed during anterior rhinoscopy?"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Inferior turbinate",
                    "Vocal cords",
                    "Tympanic membrane"
                  ]
                }
              ]
            },
            {
              "group_id": "nasal_speculum_group_18",
              "group_title": "High-yield summary",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Instrument: Nasal speculum, commonly the Thudichum type."
                },
                {
                  "type": "paragraph",
                  "text": "Purpose: Facilitates anterior rhinoscopy."
                },
                {
                  "type": "paragraph",
                  "text": "Main parts: Blades, hinge or spring, handles."
                },
                {
                  "type": "paragraph",
                  "text": "Key structures: Septum, mucosa, inferior turbinate and visible discharge."
                },
                {
                  "type": "paragraph",
                  "text": "Safe technique: Closed for insertion, gently open for inspection, closed for withdrawal."
                },
                {
                  "type": "paragraph",
