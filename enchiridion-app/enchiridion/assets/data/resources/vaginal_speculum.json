  "sections": [
    {
      "section_id": "vaginal_speculum_section_1",
      "section_title": "Vaginal speculum",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "vaginal_speculum_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "vaginal_speculum_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/vaginal_speculum_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A vaginal speculum is a gynaecological instrument used to separate the vaginal walls to allow direct visualisation of the vaginal canal and cervix. It is used during routine gynaecological examinations, cervical screening, diagnostic procedures and minor surgical interventions."
                },
                {
                  "type": "paragraph",
                  "text": "For an OSCE, you should be able to identify the instrument, label its parts, describe its mechanism, demonstrate its uses, explain its advantages and disadvantages, identify complications, and answer common viva questions."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "vaginal_speculum_subsection_2",
          "subsection_title": "Introduction and classification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "vaginal_speculum_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A vaginal speculum is classified as a diagnostic and examination instrument, although it may also facilitate therapeutic and surgical procedures."
                },
                {
                  "type": "paragraph",
                  "text": "The two principal types you must distinguish are:"
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/vaginal_speculum_02.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "A. Cusco's speculum"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A self-retaining, bivalve speculum."
                },
                {
                  "type": "paragraph",
                  "text": "Has two blades that separate the vaginal walls."
                },
                {
                  "type": "paragraph",
                  "text": "Uses a screw or locking mechanism to maintain the blades in position."
                },
                {
                  "type": "paragraph",
                  "text": "Commonly used for routine cervical examination, Pap smears and cervical sampling."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/vaginal_speculum_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Sims' speculum"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A non-self-retaining, usually double-ended instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Has a curved blade designed to retract the posterior vaginal wall."
                },
                {
                  "type": "paragraph",
                  "text": "Requires an assistant or the examiner to hold it in position."
                },
                {
                  "type": "paragraph",
                  "text": "Particularly useful for examining vaginal prolapse and the posterior vaginal wall."
                },
                {
                  "type": "paragraph",
                  "text": "Other designs include the Graves speculum, which is a bivalve self-retaining type, and disposable plastic specula."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "vaginal_speculum_subsection_3",
          "subsection_title": "Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "vaginal_speculum_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/vaginal_speculum_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "For a typical Cusco speculum, identify the following parts:"
                },
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Function"
                  ],
                  "rows": [
                    [
                      "Upper blade",
                      "Separates one vaginal wall from the other."
                    ],
                    [
                      "Lower blade",
                      "Separates the opposing vaginal wall."
                    ],
                    [
                      "Hinge or pivot",
                      "Allows the blades to open and close."
                    ],
                    [
                      "Handles",
                      "Provide grip and control during insertion and opening."
                    ],
                    [
                      "Screw/locking mechanism",
                      "Maintains the selected blade separation."
                    ],
                    [
                      "Adjustment mechanism",
                      "Allows the operator to control the opening, depending on the model."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important: The exact shape and position of the handles, screw and locking mechanism vary by manufacturer."
                },
                {
                  "type": "paragraph",
                  "text": "For Sims' speculum, the main structures to identify are the curved blade, handle or shaft, and the opposite-sized blade at the other end in double-ended models."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "vaginal_speculum_subsection_4",
          "subsection_title": "Properties and principles of operation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "vaginal_speculum_group_4",
              "group_title": "Properties of an ideal vaginal speculum",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Smooth, rounded edges to minimise mucosal injury."
                },
                {
                  "type": "paragraph",
                  "text": "Adequate strength and rigidity."
                },
                {
                  "type": "paragraph",
                  "text": "A design that permits good visualisation of the cervix."
                },
                {
                  "type": "paragraph",
                  "text": "An appropriate size for the patient's anatomy."
                },
                {
                  "type": "paragraph",
                  "text": "A secure locking mechanism in self-retaining models."
                },
                {
                  "type": "paragraph",
                  "text": "Corrosion resistance if reusable."
                },
                {
                  "type": "paragraph",
                  "text": "Compatibility with validated cleaning, disinfection and sterilisation processes."
                }
              ]
            },
            {
              "group_id": "vaginal_speculum_group_5",
              "group_title": "Principle of operation",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The speculum works by mechanically retracting the vaginal walls to create a clear visual field."
                },
                {
                  "type": "paragraph",
                  "text": "With a Cusco speculum, the blades are inserted in a closed position and then opened gradually. The locking mechanism holds them apart."
                },
                {
                  "type": "paragraph",
                  "text": "With a Sims' speculum, the blade retracts the vaginal wall, usually the posterior wall, while the operator maintains its position."
                },
                {
                  "type": "paragraph",
                  "text": "Neither instrument is designed to dilate the cervix routinely."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "vaginal_speculum_subsection_5",
          "subsection_title": "Uses and procedures",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "vaginal_speculum_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Use",
                    "Clinical application"
                  ],
                  "rows": [
                    [
                      "Cervical visualisation",
                      "Inspecting the cervix for lesions, inflammation, bleeding or discharge."
                    ],
                    [
                      "Cervical screening",
                      "Obtaining samples for cervical cytology or HPV testing, according to the screening protocol."
                    ],
                    [
                      "Vaginal examination",
                      "Assessing the vaginal walls, discharge, ulcers and lesions."
                    ],
                    [
                      "Infection assessment",
                      "Facilitating the collection of vaginal or cervical swabs."
                    ],
                    [
                      "Abnormal bleeding",
                      "Helping identify cervical or vaginal sources of bleeding."
                    ],
                    [
                      "Biopsy",
                      "Providing access for selected cervical or vaginal biopsies."
                    ],
                    [
                      "IUCD procedures",
                      "Insertion or removal of an intrauterine contraceptive device."
                    ],
                    [
                      "Minor gynaecological procedures",
                      "Assisting with selected cervical procedures and vaginal interventions."
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "vaginal_speculum_group_7",
              "group_title": "Procedures where it may be used",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Pap smear and cervical screening."
                },
                {
                  "type": "paragraph",
                  "text": "Cervical swab collection."
                },
                {
                  "type": "paragraph",
                  "text": "IUCD insertion and removal."
                },
                {
                  "type": "paragraph",
                  "text": "Colposcopy and cervical biopsy."
                },
                {
                  "type": "paragraph",
                  "text": "Selected vaginal and cervical procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Assessment of vaginal or cervical bleeding."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE distinction: The speculum provides visual access; it does not itself perform the biopsy, take the cytology sample or insert the IUCD."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "vaginal_speculum_subsection_6",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "vaginal_speculum_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Allows direct visualisation of the cervix and vaginal walls."
                },
                {
                  "type": "paragraph",
                  "text": "Facilitates targeted sample collection."
                },
                {
                  "type": "paragraph",
                  "text": "Can be used for several diagnostic and minor therapeutic procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Cusco's design is self-retaining, freeing the examiner's hands."
                },
                {
                  "type": "paragraph",
                  "text": "Reusable metal models are durable when properly maintained."
                },
                {
                  "type": "paragraph",
                  "text": "Disposable models reduce the need for instrument reprocessing between patients."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "vaginal_speculum_subsection_7",
          "subsection_title": "Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "vaginal_speculum_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Insertion may cause discomfort, particularly with inadequate lubrication, a poorly selected size or pelvic floor muscle tension."
                },
                {
                  "type": "paragraph",
                  "text": "May be difficult to use in patients with vaginal stenosis, scarring or marked anatomical distortion."
                },
                {
                  "type": "paragraph",
                  "text": "Cusco's speculum may not provide optimal exposure in every patient or examination position."
                },
                {
                  "type": "paragraph",
                  "text": "Sims' speculum requires continuous manual retraction."
                },
                {
                  "type": "paragraph",
                  "text": "Poor technique can cause mucosal trauma or bleeding."
                },
                {
                  "type": "paragraph",
                  "text": "Reusable instruments require appropriate decontamination and sterilisation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "vaginal_speculum_subsection_8",
          "subsection_title": "Complications and prevention",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "vaginal_speculum_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Prevention or response"
                  ],
                  "rows": [
                    [
                      "Vaginal discomfort or pain",
                      "Explain the procedure, obtain consent, use an appropriate size and insert gently."
                    ],
                    [
                      "Vaginal mucosal abrasion",
                      "Avoid force, keep blades controlled and use adequate lubrication compatible with the intended sampling test."
                    ],
                    [
                      "Minor bleeding",
                      "Use gentle technique and assess unexpected or persistent bleeding."
                    ],
                    [
                      "Cervical contact bleeding",
                      "Minimise unnecessary contact and assess any suspicious cervical lesion appropriately."
                    ],
                    [
                      "Infection transmission",
                      "Follow standard precautions and validated reprocessing procedures."
                    ],
                    [
                      "Entrapment or pinching of tissue",
                      "Open and close the blades under direct control; inspect before withdrawal."
                    ],
                    [
                      "Inadequate visualisation",
                      "Reposition, select a more suitable size or design, and consider patient positioning."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Clinical caution: severe pain, unexpected heavy bleeding or suspected injury warrants stopping the examination and assessing the patient."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "vaginal_speculum_subsection_9",
          "subsection_title": "OSCE demonstration: how to use a Cusco speculum",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "vaginal_speculum_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/vaginal_speculum_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 1 — Preparation"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Introduce yourself, confirm the patient's identity, explain the procedure, obtain informed consent and offer a chaperone according to local policy. Ensure privacy and appropriate positioning."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 2 — Inspection"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Check that the instrument is clean, intact and suitable for use. Ensure the blades are closed and the locking mechanism is released."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 3 — Insertion"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Separate the labia gently. Introduce the closed blades carefully, directing them along the vaginal axis and avoiding pressure on the urethra or anterior vaginal wall."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 4 — Visualisation"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Advance as appropriate, then open the blades gradually until the cervix is visible. Lock the instrument only as needed and avoid excessive opening."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 5 — Withdrawal"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Release the lock, partially close the blades while ensuring tissue is not trapped, and withdraw gently. Explain the findings, ensure comfort and document the examination."
                },
                {
                  "type": "paragraph",
                  "text": "Use the appropriate lubricant for the intended test: some lubricants can interfere with specimen quality, so follow the laboratory or screening protocol."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "vaginal_speculum_subsection_10",
          "subsection_title": "What to inspect once the speculum is inserted",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "vaginal_speculum_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Use a systematic approach:"
                },
                {
                  "type": "paragraph",
                  "text": "Vaginal walls: colour, lesions, ulcers, masses, discharge, bleeding and signs of atrophy."
                },
                {
                  "type": "paragraph",
                  "text": "Cervix: colour, position, surface, external os, discharge, ulcers, masses, polyps and contact bleeding."
                },
                {
                  "type": "paragraph",
                  "text": "Discharge: amount, colour, consistency and odour when relevant."
                },
                {
                  "type": "paragraph",
                  "text": "Bleeding: determine whether it appears to arise from the vaginal walls, cervix or cervical os."
                },
                {
                  "type": "paragraph",
                  "text": "Foreign body or prolapse: note any visible abnormality."
                },
                {
                  "type": "paragraph",
                  "text": "A speculum examination alone cannot establish every diagnosis. For example, cervical malignancy requires appropriate investigation, often including biopsy."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "vaginal_speculum_subsection_11",
          "subsection_title": "Cusco versus Sims' speculum",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "vaginal_speculum_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Cusco",
                    "Sims'"
                  ],
                  "rows": [
                    [
                      "Design",
                      "Bivalve",
                      "Usually single-bladed at the working end; often double-ended"
                    ],
                    [
                      "Self-retaining",
                      "Yes, typically",
                      "No"
                    ],
                    [
                      "Main action",
                      "Separates opposing vaginal walls",
                      "Retracts the vaginal wall, usually posteriorly"
                    ],
                    [
                      "Hands required",
                      "Can free both hands once secured",
                      "One hand is generally needed to hold it"
                    ],
                    [
                      "Common application",
                      "Cervical screening and routine cervical procedures",
                      "Vaginal wall examination and selected prolapse assessments"
                    ],
                    [
                      "Limitation",
                      "Exposure depends on anatomy and positioning",
                      "Requires sustained manual retraction"
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "vaginal_speculum_subsection_12",
          "subsection_title": "High-yield OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "vaginal_speculum_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. Identify this instrument."
                },
                {
                  "type": "paragraph",
                  "text": "It is a vaginal speculum, used to separate the vaginal walls and visualise the cervix and vaginal canal."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is the difference between Cusco's and Sims' specula?"
                },
                {
                  "type": "paragraph",
                  "text": "Cusco's is generally a self-retaining bivalve instrument, whereas Sims' is a non-self-retaining vaginal retractor that requires manual support."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Why is a Cusco speculum described as self-retaining?"
                },
                {
                  "type": "paragraph",
                  "text": "Its blades can be held apart by a locking or screw mechanism without continuous manual support."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Name four indications."
                },
                {
                  "type": "paragraph",
                  "text": "Cervical screening, cervical swab collection, assessment of abnormal vaginal bleeding, and IUCD insertion or removal."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What complications can occur?"
                },
                {
                  "type": "paragraph",
                  "text": "Pain, mucosal abrasion, minor bleeding, tissue pinching and infection transmission from inadequate reprocessing."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What precautions should you take before insertion?"
                },
                {
                  "type": "paragraph",
                  "text": "Consent, privacy, chaperone where appropriate, hand hygiene, appropriate instrument selection, explanation, gentle technique and correct positioning."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. Why should the speculum be withdrawn carefully?"
                },
                {
                  "type": "paragraph",
                  "text": "To prevent pinching or trapping the vaginal mucosa between the blades."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. Does a normal speculum examination exclude cervical cancer?"
                },
                {
                  "type": "paragraph",
                  "text": "No. Suspicious lesions require further assessment, and a visually normal cervix does not replace recommended cervical screening."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "vaginal_speculum_subsection_13",
          "subsection_title": "Examiner's checklist",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "vaginal_speculum_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "0 of 10",
                    "Correctly identifies the instrument",
                    "Names the principal parts",
                    "Explains the mechanism of action",
                    "States at least four indications",
                    "Distinguishes Cusco's from Sims' speculum",
                    "Describes preparation, consent and chaperone considerations",
                    "Explains insertion and withdrawal safely",
                    "Identifies complications and prevention",
                    "Describes systematic inspection of the cervix and vaginal walls",
                    "Mentions appropriate cleaning or sterilisation"
                  ]
                }
              ]
            },
            {
              "group_id": "vaginal_speculum_group_16",
              "group_title": "Final exam tip",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The most important distinction to remember is: Cusco = self-retaining, bivalve speculum; Sims' = non-self-retaining vaginal retractor. Always connect the instrument's design to its function, indications and safe handling."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
