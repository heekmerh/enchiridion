  "sections": [
    {
      "section_id": "woods_lamp_section_1",
      "section_title": "Wood’s lamp",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "woods_lamp_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "woods_lamp_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/woods_lamp_01.webp",
                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "woods_lamp_subsection_2",
          "subsection_title": "Identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "woods_lamp_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A Wood’s lamp is a diagnostic device that emits long-wave ultraviolet A (UVA) light, typically around 365 nm, to help identify certain skin conditions through characteristic fluorescence or differences in pigmentation."
                },
                {
                  "type": "paragraph",
                  "text": "Classification: Dermatological diagnostic instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Main function: Examination of selected skin and scalp disorders under ultraviolet illumination."
                },
                {
                  "type": "paragraph",
                  "text": "Principle: Some substances and microbial products fluoresce when exposed to UVA light."
                },
                {
                  "type": "paragraph",
                  "text": "Typical setting: A darkened room."
                },
                {
                  "type": "paragraph",
                  "text": "Common applications: Selected fungal infections, pigmentary disorders and detection of certain fluorescent substances."
                },
                {
                  "type": "paragraph",
                  "text": "Important: A Wood’s lamp is an adjunct to clinical examination. A negative result does not exclude a skin infection or pigmentary disorder."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "woods_lamp_subsection_3",
          "subsection_title": "Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "woods_lamp_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Condition or application",
                    "Possible finding"
                  ],
                  "rows": [
                    [
                      "Tinea capitis caused by some Microsporum species",
                      "Blue-green or greenish fluorescence of affected hairs in susceptible species."
                    ],
                    [
                      "Erythrasma",
                      "Coral-red fluorescence due to porphyrins produced by Corynebacterium minutissimum."
                    ],
                    [
                      "Pityriasis versicolor",
                      "Yellowish, gold or yellow-green fluorescence may occur, but it is inconsistent."
                    ],
                    [
                      "Vitiligo",
                      "Depigmented areas become more sharply demarcated under UVA illumination."
                    ],
                    [
                      "Selected pigmentary disorders",
                      "May help distinguish pigment loss from reduced pigmentation, depending on the condition and skin type."
                    ],
                    [
                      "Certain chemical or topical residues",
                      "Some substances fluoresce, although products and skin preparations may also produce misleading results."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "It may also be used in selected investigations of suspected porphyria or other disorders, but these require appropriate clinical and laboratory confirmation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "woods_lamp_subsection_4",
          "subsection_title": "Parts and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "woods_lamp_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/woods_lamp_02.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/woods_lamp_03.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/woods_lamp_04.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Function"
                  ],
                  "rows": [
                    [
                      "UV light source",
                      "Produces the UVA illumination used during examination."
                    ],
                    [
                      "Optical filter",
                      "Selects the appropriate wavelength range, depending on the device."
                    ],
                    [
                      "Housing or handle",
                      "Allows safe handling and positioning."
                    ],
                    [
                      "Power switch",
                      "Turns the device on and off."
                    ],
                    [
                      "Power supply or rechargeable battery",
                      "Supplies electrical power."
                    ],
                    [
                      "Protective eyewear, when indicated",
                      "Protects the examiner and patient from inappropriate UV exposure according to device instructions."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Unlike a slit-lamp microscope, a Wood’s lamp does not provide magnified, stereoscopic examination of the eye."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "woods_lamp_subsection_5",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "woods_lamp_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Non-invasive and generally painless."
                },
                {
                  "type": "paragraph",
                  "text": "Quick and easy to use."
                },
                {
                  "type": "paragraph",
                  "text": "Portable in many models."
                },
                {
                  "type": "paragraph",
                  "text": "May reveal subtle pigmentary changes."
                },
                {
                  "type": "paragraph",
                  "text": "Can provide useful diagnostic clues in selected infections."
                },
                {
                  "type": "paragraph",
                  "text": "Requires little preparation apart from darkening the room and preparing the examination area."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "woods_lamp_subsection_6",
          "subsection_title": "Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "woods_lamp_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Many fungal infections do not fluoresce."
                },
                {
                  "type": "paragraph",
                  "text": "Fluorescence varies by organism, skin condition and the products applied to the skin."
                },
                {
                  "type": "paragraph",
                  "text": "Cosmetics, soaps, fibres, detergents and topical preparations can produce misleading fluorescence."
                },
                {
                  "type": "paragraph",
                  "text": "It cannot reliably identify every causative organism."
                },
                {
                  "type": "paragraph",
                  "text": "It does not replace skin scrapings, microscopy, culture, dermoscopy or biopsy when these are indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Excessive or inappropriate UV exposure should be avoided."
                },
                {
                  "type": "paragraph",
                  "text": "Exam point: Most cases of tinea capitis do not reliably fluoresce under a Wood’s lamp. A negative examination does not rule it out."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "woods_lamp_subsection_7",
          "subsection_title": "Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "woods_lamp_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Before the examination:"
                },
                {
                  "type": "paragraph",
                  "text": "Explain the procedure and obtain consent."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm the area of concern and relevant symptoms."
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the skin under ordinary light first."
                },
                {
                  "type": "paragraph",
                  "text": "Move to a darkened room and allow your eyes to adapt to the low-light environment."
                },
                {
                  "type": "paragraph",
                  "text": "Follow the manufacturer's instructions for switching on and positioning the lamp."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid unnecessary exposure of the eyes to UV radiation and use protective measures specified by the device."
                },
                {
                  "type": "paragraph",
                  "text": "Consider whether creams, cosmetics, deodorants, soaps or other products could interfere with interpretation."
                },
                {
                  "type": "paragraph",
                  "text": "Do not apply substances solely to produce fluorescence unless this is part of an established diagnostic protocol."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "woods_lamp_subsection_8",
          "subsection_title": "How to use a Wood’s lamp — step-by-step OSCE demonstration",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "woods_lamp_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/woods_lamp_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 1 — Inspect under ordinary light"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Examine the affected skin or scalp, noting the distribution, colour, scale, borders, hair loss and other visible features. This provides a baseline for comparison."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/woods_lamp_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 2 — Darken the room"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Switch off unnecessary lights and allow the examiner's eyes to adapt. Explain that the lamp produces ultraviolet light and that the examination should not cause pain."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/woods_lamp_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 3 — Position the lamp"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Switch on the device and hold it at the distance recommended by the manufacturer, directed towards the affected area. Avoid touching the skin with the lamp."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/woods_lamp_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 4 — Observe the skin"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Look for changes in fluorescence, colour contrast and lesion margins. Compare affected and adjacent unaffected skin where appropriate."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/woods_lamp_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 5 — Examine the scalp or other areas systematically"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Part the hair if examining the scalp. Inspect all relevant areas and avoid overlooking lesions that do not fluoresce."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/woods_lamp_10.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 6 — Correlate and document"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Record the location and colour of any fluorescence. If infection is suspected, obtain appropriate specimens for microscopy or culture when indicated, and interpret the findings alongside the clinical picture."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "woods_lamp_subsection_9",
          "subsection_title": "Contraindications and complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "woods_lamp_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A brief, correctly performed Wood’s lamp examination is generally well tolerated."
                },
                {
                  "type": "table",
                  "columns": [
                    "Issue",
                    "Precaution"
                  ],
                  "rows": [
                    [
                      "Direct eye exposure",
                      "Avoid looking directly into the UV source; follow device-specific eye protection guidance."
                    ],
                    [
                      "Excessive UV exposure",
                      "Limit exposure to what is required for examination."
                    ],
                    [
                      "Photosensitivity",
                      "Use clinical judgement and device instructions where the patient has a photosensitivity disorder or is taking photosensitising medication."
                    ],
                    [
                      "Misleading fluorescence",
                      "Consider topical products, fibres and environmental contamination."
                    ],
                    [
                      "False reassurance",
                      "Do not exclude infection solely because fluorescence is absent."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The main practical risk in an OSCE is often misinterpretation of the findings, rather than the brief examination itself."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "woods_lamp_subsection_10",
          "subsection_title": "Normal and abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "woods_lamp_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/woods_lamp_11.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Normal or non-specific findings"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "No characteristic fluorescence is seen. This does not exclude fungal infection, bacterial infection or a pigmentary disorder."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/woods_lamp_12.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Coral-red fluorescence — erythrasma"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "May support erythrasma, a superficial infection caused by Corynebacterium minutissimum. Recent washing can reduce fluorescence."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/woods_lamp_01.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Blue-green fluorescence — selected tinea capitis"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Certain Microsporum species may produce fluorescent infected hairs. Many dermatophytes, including common Trichophyton species, do not fluoresce."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/woods_lamp_13.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Bright, sharply demarcated depigmentation — vitiligo"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Depigmented areas become more conspicuous against surrounding skin, helping define the extent of pigment loss."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/woods_lamp_14.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Yellowish or gold fluorescence — possible pityriasis versicolor"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Fluorescence can occur, but it is variable and may be absent. Clinical examination and fungal microscopy may be needed."
                }
              ]
            },
            {
              "group_id": "woods_lamp_group_11",
              "group_title": "How to report findings in an OSCE",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Example:"
                },
                {
                  "type": "paragraph",
                  "text": "“Under Wood’s lamp examination, the affected skin fold demonstrates coral-red fluorescence. In the appropriate clinical context, this finding supports erythrasma. I would correlate it with the clinical appearance and consider further testing if the diagnosis remains uncertain.”"
                },
                {
                  "type": "paragraph",
                  "text": "Another example:"
                },
                {
                  "type": "paragraph",
                  "text": "“The depigmented patches appear more sharply demarcated under ultraviolet illumination, supporting vitiligo in the appropriate clinical context.”"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "woods_lamp_subsection_11",
          "subsection_title": "Paediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "woods_lamp_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Explain the procedure to the child and caregiver in age-appropriate language."
                },
                {
                  "type": "paragraph",
                  "text": "Keep the examination brief and reassure the child that it should not hurt."
                },
                {
                  "type": "paragraph",
                  "text": "Prevent the child from looking directly into the UV source."
                },
                {
                  "type": "paragraph",
                  "text": "In suspected tinea capitis, examine the scalp systematically and remember that a negative result does not exclude infection."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid diagnosing a fungal infection based on fluorescence alone."
                },
                {
                  "type": "paragraph",
                  "text": "Arrange appropriate testing and treatment assessment for scalp scaling, broken hairs, alopecia or inflammatory lesions."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "woods_lamp_subsection_12",
          "subsection_title": "Mnemonic — WOOD",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "woods_lamp_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "W — Wavelength: Uses long-wave UVA illumination."
                },
                {
                  "type": "paragraph",
                  "text": "O — Observe: Examine the skin in a darkened room."
                },
                {
                  "type": "paragraph",
                  "text": "O — Organism clues: Some organisms or their products fluoresce."
                },
                {
                  "type": "paragraph",
                  "text": "D — Don't exclude: A negative result does not rule out disease."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "woods_lamp_subsection_13",
          "subsection_title": "Common OSCE viva questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "woods_lamp_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is a Wood’s lamp?"
                },
                {
                  "type": "paragraph",
                  "text": "A diagnostic device that emits long-wave UVA light to assist examination of selected skin disorders through fluorescence and changes in pigmentation."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What wavelength does it typically use?"
                },
                {
                  "type": "paragraph",
                  "text": "Approximately 365 nm, although specifications vary by device."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Why is the examination performed in a dark room?"
                },
                {
                  "type": "paragraph",
                  "text": "Darkness improves the visibility of fluorescence and subtle differences in skin pigmentation."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. What causes coral-red fluorescence in erythrasma?"
                },
                {
                  "type": "paragraph",
                  "text": "Porphyrins produced by Corynebacterium minutissimum."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. Which fungal infections may fluoresce?"
                },
                {
                  "type": "paragraph",
                  "text": "Certain Microsporum species causing tinea capitis can produce blue-green fluorescence. Many other dermatophytes do not fluoresce."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Does a negative Wood’s lamp examination rule out tinea capitis?"
                },
                {
                  "type": "paragraph",
                  "text": "No. Many causative organisms do not fluoresce, so microscopy and fungal culture or other appropriate tests may be required."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. How does a Wood’s lamp help assess vitiligo?"
                },
                {
                  "type": "paragraph",
                  "text": "It makes depigmented patches more conspicuous and helps define their margins."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. What can cause a false-positive result?"
                },
                {
                  "type": "paragraph",
                  "text": "Cosmetics, topical preparations, detergents, fibres and other fluorescent substances."
                },
                {
                  "type": "paragraph",
                  "text": "Q9. Is a Wood’s lamp sufficient to diagnose every fungal infection?"
                },
                {
                  "type": "paragraph",
                  "text": "No. It is an adjunct, and its usefulness depends on the suspected organism and condition."
                },
                {
                  "type": "paragraph",
                  "text": "Q10. What precautions should be taken?"
                },
                {
                  "type": "paragraph",
                  "text": "Avoid direct eye exposure, follow manufacturer instructions, limit unnecessary UV exposure and consider factors that could affect interpretation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "woods_lamp_subsection_14",
          "subsection_title": "Common mistakes and examiner tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "woods_lamp_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Common mistakes"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Calling the Wood’s lamp a visible-light torch."
                },
                {
                  "type": "paragraph",
                  "text": "Forgetting to darken the room."
                },
                {
                  "type": "paragraph",
                  "text": "Assuming every fungal infection fluoresces."
                },
                {
                  "type": "paragraph",
                  "text": "Confusing coral-red fluorescence with the blue-green fluorescence associated with certain Microsporum infections."
                },
                {
                  "type": "paragraph",
                  "text": "Diagnosing a condition from fluorescence alone."
                },
                {
                  "type": "paragraph",
                  "text": "Ignoring topical products that can interfere with interpretation."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Examiner tips"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "State the wavelength and principle if asked."
                },
                {
                  "type": "paragraph",
                  "text": "Give the classic example of coral-red fluorescence in erythrasma."
                },
                {
                  "type": "paragraph",
                  "text": "Mention selected Microsporum species in tinea capitis."
                },
                {
                  "type": "paragraph",
                  "text": "Explain its role in defining vitiligo margins."
                },
                {
                  "type": "paragraph",
                  "text": "Always mention that a negative examination does not exclude disease."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "woods_lamp_subsection_15",
          "subsection_title": "Mini-OSCE practice station",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "woods_lamp_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Practice station",
                    "Scenario"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A child presents with a scaly scalp and patchy hair loss. You are shown a Wood’s lamp and asked to identify it and explain how it may assist in the assessment."
                },
                {
                  "type": "paragraph",
                  "text": "Your tasks:"
                },
                {
                  "type": "paragraph",
                  "text": "Identify the instrument and state its principle."
                },
                {
                  "type": "paragraph",
                  "text": "Describe how you would perform the examination."
                },
                {
                  "type": "paragraph",
                  "text": "Explain the significance of blue-green fluorescence."
                },
                {
