        {
          "subsection_id": "quick_revision_part_14_subsection_1",
          "subsection_title": "1. Tetrad of Multiple Myeloma and Signs",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_14_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "CRAB features"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "C — HyperCalcaemia: nausea, constipation, polyuria, polydipsia, confusion",
                      "level": 0
                    },
                    {
                      "text": "R — Renal impairment: elevated creatinine, reduced urine output, proteinuria",
                      "level": 0
                    },
                    {
                      "text": "A — Anaemia: pallor, fatigue, dyspnoea, tachycardia",
                      "level": 0
                    },
                    {
                      "text": "B — Bone lesions: bone pain, pathological fractures, lytic lesions, vertebral collapse",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Other signs/features"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Recurrent bacterial infections",
                      "level": 0
                    },
                    {
                      "text": "Raised ESR",
                      "level": 0
                    },
                    {
                      "text": "Monoclonal protein (M protein)",
                      "level": 0
                    },
                    {
                      "text": "Bence Jones proteinuria",
                      "level": 0
                    },
                    {
                      "text": "Rouleaux formation",
                      "level": 0
                    },
                    {
                      "text": "Spinal cord compression",
                      "level": 0
                    },
                    {
                      "text": "Hyperviscosity syndrome",
                      "level": 0
                    },
                    {
                      "text": "Peripheral neuropathy",
                      "level": 0
                    },
                    {
                      "text": "Amyloidosis",
                      "level": 0
                    },
                    {
                      "text": "Plasmacytoma",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_14_subsection_2",
          "subsection_title": "2. Osmolar Gap in Multiple Myeloma — Definition and Calculation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_14_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Definition"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Difference between measured serum osmolality and calculated serum osmolality.",
                      "level": 0
                    },
                    {
                      "text": "Multiple myeloma may cause a raised globulin concentration and occasionally contribute to analytical interference or pseudohyponatraemia, depending on the laboratory method.",
                      "level": 0
                    },
                    {
                      "text": "Multiple myeloma itself does not characteristically cause a raised osmolar gap.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Calculation"
                },
                {
                  "type": "paragraph",
                  "text": "When glucose, BUN and sodium are in mg/dL:"
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/quick_revision/quick_revision_part_14_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "When glucose and urea are in mmol/L:"
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/quick_revision/quick_revision_part_14_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Typical reference: approximately 10 mOsm/kg or less, depending on the laboratory and equation."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Raised gap: methanol, ethylene glycol, isopropanol, propylene glycol, mannitol, ketoacidosis, lactic acidosis and other unmeasured osmoles.",
                      "level": 0
                    },
                    {
                      "text": "Paraproteinaemia can cause pseudohyponatraemia with some indirect ion-selective electrode methods; confirm sodium using a direct ion-selective electrode when suspected.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_14_subsection_3",
          "subsection_title": "3. Kaposi Sarcoma — Differential Diagnosis, Investigations, Types, Histology and Treatment",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_14_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Differential diagnosis"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Bacillary angiomatosis",
                      "level": 0
                    },
                    {
                      "text": "Pyogenic granuloma",
                      "level": 0
                    },
                    {
                      "text": "Haemangioma",
                      "level": 0
                    },
                    {
                      "text": "Angiosarcoma",
                      "level": 0
                    },
                    {
                      "text": "Dermatofibroma",
                      "level": 0
                    },
                    {
                      "text": "Cherry angioma",
                      "level": 0
                    },
                    {
                      "text": "Purpura or ecchymosis",
                      "level": 0
                    },
                    {
                      "text": "Cutaneous lymphoma",
                      "level": 0
                    },
                    {
                      "text": "Pigmented skin lesions",
                      "level": 0
                    },
                    {
                      "text": "Molluscum contagiosum in HIV-associated skin disease",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Types"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Classic Mediterranean Kaposi sarcoma",
                      "level": 0
                    },
                    {
                      "text": "Endemic African Kaposi sarcoma",
                      "level": 0
                    },
                    {
                      "text": "Iatrogenic/immunosuppression-associated Kaposi sarcoma",
                      "level": 0
                    },
                    {
                      "text": "Epidemic HIV-associated Kaposi sarcoma",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Clinical features"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Violaceous, red-brown or purple macules, plaques or nodules",
                      "level": 0
                    },
                    {
                      "text": "Lesions on lower limbs, feet, face or oral mucosa",
                      "level": 0
                    },
                    {
                      "text": "Oral lesions, particularly palate",
                      "level": 0
                    },
                    {
                      "text": "Lymphoedema",
                      "level": 0
                    },
                    {
                      "text": "Gastrointestinal involvement: bleeding, pain, obstruction",
                      "level": 0
                    },
                    {
                      "text": "Pulmonary involvement: cough, dyspnoea, haemoptysis",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Investigations"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Skin or lesion biopsy with histopathology",
                      "level": 0
                    },
                    {
                      "text": "HHV-8 (KSHV) immunohistochemistry, e.g. LANA-1",
                      "level": 0
                    },
                    {
                      "text": "HIV test and CD4 count when status is unknown or HIV is suspected",
                      "level": 0
                    },
                    {
                      "text": "HIV viral load if HIV-positive",
                      "level": 0
                    },
                    {
                      "text": "FBC, renal function, liver function",
                      "level": 0
                    },
                    {
                      "text": "Chest X-ray or CT if pulmonary disease suspected",
                      "level": 0
                    },
                    {
                      "text": "Bronchoscopy for suspected pulmonary involvement when appropriate",
                      "level": 0
                    },
                    {
                      "text": "Endoscopy for suspected gastrointestinal disease",
                      "level": 0
                    },
                    {
                      "text": "CT imaging for suspected visceral or extensive disease",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Histology"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Spindle-cell proliferation",
                      "level": 0
                    },
                    {
                      "text": "Irregular, slit-like vascular spaces",
                      "level": 0
                    },
                    {
                      "text": "Extravasated erythrocytes",
                      "level": 0
                    },
                    {
                      "text": "Haemosiderin-laden macrophages",
                      "level": 0
                    },
                    {
                      "text": "Inflammatory cell infiltrate",
                      "level": 0
                    },
                    {
                      "text": "HHV-8 LANA-1 nuclear positivity",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Treatment modalities"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Observation for selected limited, indolent lesions",
                      "level": 0
                    },
                    {
                      "text": "Antiretroviral therapy (ART) for HIV-associated Kaposi sarcoma",
                      "level": 0
                    },
                    {
                      "text": "Local excision",
                      "level": 0
                    },
                    {
                      "text": "Cryotherapy",
                      "level": 0
                    },
                    {
                      "text": "Intralesional chemotherapy in selected lesions",
                      "level": 0
                    },
                    {
                      "text": "Radiotherapy for localised symptomatic disease",
                      "level": 0
                    },
                    {
                      "text": "Systemic chemotherapy: liposomal doxorubicin; paclitaxel in selected cases",
                      "level": 0
                    },
                    {
                      "text": "Manage lymphoedema and wound complications",
                      "level": 0
                    },
                    {
                      "text": "Reduce immunosuppression when feasible in iatrogenic disease, under specialist supervision",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}