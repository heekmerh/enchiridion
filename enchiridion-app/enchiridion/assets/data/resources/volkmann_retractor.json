        {
          "subsection_id": "volkmann_retractor_subsection_12",
          "subsection_title": "11. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "volkmann_retractor_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a Volkmann retractor, also known as a rake retractor. It is a handheld surgical instrument used to retract skin and superficial soft tissues to improve operative exposure. It has a handle, shaft and a rake-like working end with multiple prongs, which may be sharp or blunt. It is used in selected superficial general surgical, orthopaedic and plastic surgical procedures. Complications of improper use include puncture injury, tissue tearing, bleeding and pressure injury. Before use, I would inspect the prongs, handle, instrument integrity, cleanliness and sterility.”",
                  "style": "quote"
                }
              ]
            }
