        {
          "subsection_id": "plaster_of_paris_subsection_2",
          "subsection_title": "1. Introduction and definition",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "plaster_of_paris_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Plaster of Paris (POP) is a casting material made primarily from calcium sulfate hemihydrate. When mixed with water, it undergoes a chemical reaction, setting into a firm, rigid structure that can immobilise injured bones and joints."
                },
                {
                  "type": "paragraph",
                  "text": "In orthopaedics, POP is commonly supplied as a powder for casting or as gauze bandages impregnated with plaster."
                },
                {
                  "type": "paragraph",
                  "text": "Key identifying feature: A white, rigid immobilisation material that moulds to the shape of a limb and hardens after wetting."
                }
              ]
            },
            {
              "group_id": "plaster_of_paris_group_3",
              "group_title": "Important distinction",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Plaster of Paris: The material used to create a cast.",
                      "level": 0
                    },
                    {
                      "text": "POP bandage: Gauze impregnated with plaster powder, supplied in rolls.",
                      "level": 0
                    },
                    {
                      "text": "POP cast: The rigid immobilisation applied around a body part using the material.",
                      "level": 0
                    },
                    {
                      "text": "Splint: An immobilising support that may leave part of the limb uncovered to accommodate swelling.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These terms are related but are not interchangeable in every OSCE question."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "plaster_of_paris_subsection_3",
          "subsection_title": "2. Identification in an OSCE station",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "plaster_of_paris_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/plaster_of_paris_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Model identification"
                },
                {
                  "type": "paragraph",
                  "text": "“This is Plaster of Paris, an orthopaedic casting material used to immobilise fractures, maintain reduction and support injured bones and joints.”",
                  "style": "quote"
                },
                {
                  "type": "paragraph",
                  "text": "Properties to mention"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Mouldable when wet.",
                      "level": 0
                    },
                    {
                      "text": "Hardens after application.",
                      "level": 0
                    },
                    {
                      "text": "Provides a rigid supporting structure.",
                      "level": 0
                    },
                    {
                      "text": "Conforms well to anatomical contours.",
                      "level": 0
                    },
                    {
                      "text": "Generally inexpensive and widely available.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "plaster_of_paris_subsection_4",
          "subsection_title": "3. Composition and chemistry",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "plaster_of_paris_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "POP is produced by heating gypsum, which is calcium sulfate dihydrate, to remove some of its water of crystallisation."
                },
                {
                  "type": "paragraph",
                  "text": "The resulting material is calcium sulfate hemihydrate."
                },
                {
                  "type": "paragraph",
                  "text": "When water is added, it rehydrates and forms calcium sulfate dihydrate again, releasing heat as it sets."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/plaster_of_paris_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "High-yield viva point: POP setting is an exothermic reaction. Excessive heat can cause thermal burns, particularly when thick casts are applied, hot water is used, or the setting material is insulated against the skin."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "plaster_of_paris_subsection_5",
          "subsection_title": "4. Classification and types of POP applications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "plaster_of_paris_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/plaster_of_paris_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A. Complete POP cast"
                },
                {
                  "type": "paragraph",
                  "text": "Encloses the limb circumferentially."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Provides good immobilisation.",
                      "level": 0
                    },
                    {
                      "text": "Useful after fracture reduction when appropriate.",
                      "level": 0
                    },
                    {
                      "text": "May become constrictive if swelling develops.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/plaster_of_paris_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "B. POP backslab"
                },
                {
                  "type": "paragraph",
                  "text": "A slab of plaster applied to one side of a limb and secured with a bandage."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Accommodates swelling better than a complete circumferential cast.",
                      "level": 0
                    },
                    {
                      "text": "Commonly used during the acute phase of an injury.",
                      "level": 0
                    },
                    {
                      "text": "Provides less circumferential support.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/plaster_of_paris_08.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "C. Long-arm cast"
                },
                {
                  "type": "paragraph",
                  "text": "Extends from the upper arm to the hand, generally incorporating the elbow."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Used for selected forearm, elbow and paediatric fractures.",
                      "level": 0
                    },
                    {
                      "text": "Restricts elbow movement.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/plaster_of_paris_09.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "D. Short-arm cast"
                },
                {
                  "type": "paragraph",
                  "text": "Extends from below the elbow to the hand."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Used for selected wrist and distal forearm fractures.",
                      "level": 0
                    },
                    {
                      "text": "Allows elbow movement.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/plaster_of_paris_10.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "E. Long-leg cast"
                },
                {
                  "type": "paragraph",
                  "text": "Extends from the thigh to the foot."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Used for selected knee, tibial and paediatric lower-limb conditions.",
                      "level": 0
                    },
                    {
                      "text": "Restricts knee movement and requires appropriate mobility precautions.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/plaster_of_paris_11.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "F. Short-leg cast"
                },
                {
                  "type": "paragraph",
                  "text": "Extends from below the knee to the foot."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Used for selected foot, ankle and lower-leg injuries.",
                      "level": 0
                    },
                    {
                      "text": "Weight-bearing status depends on the injury, cast design and treating clinician's instructions.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These are configurations of POP immobilisation, rather than different chemical forms of plaster."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "plaster_of_paris_subsection_6",
          "subsection_title": "5. Properties of POP",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "plaster_of_paris_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Property",
                    "Clinical significance"
                  ],
                  "rows": [
                    [
                      "Mouldability when wet",
                      "Allows shaping around the limb and fracture"
                    ],
                    [
                      "Rigid setting",
                      "Maintains immobilisation"
                    ],
                    [
                      "Exothermic setting",
                      "Creates a risk of thermal burns"
                    ],
                    [
                      "Good contouring",
                      "Can provide a close anatomical fit"
                    ],
                    [
                      "Relatively inexpensive",
                      "Widely accessible"
                    ],
                    [
                      "Heavier than many synthetic alternatives",
                      "May reduce comfort and mobility"
                    ],
                    [
                      "Slow drying",
                      "Requires careful handling while setting"
                    ],
                    [
                      "Radiolucency",
                      "Generally allows radiographic assessment through the cast, although the cast can affect image quality"
                    ],
                    [
                      "Poor water resistance",
                      "Can soften or deteriorate when wet unless appropriately protected"
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "plaster_of_paris_subsection_7",
          "subsection_title": "6. Indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "plaster_of_paris_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "POP is used for:",
                  "items": [
                    {
                      "text": "Immobilisation of fractures following appropriate assessment and reduction.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Conservative management of selected undisplaced or stable fractures.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Maintaining fracture alignment during healing.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Immobilisation after selected orthopaedic procedures.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Support following selected ligamentous or soft-tissue injuries.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Temporary immobilisation while awaiting definitive treatment.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Selected paediatric orthopaedic conditions.",
                      "level": 0,
                      "label": "7."
                    },
                    {
                      "text": "Application of serial casts in selected deformities, including clubfoot management.",
                      "level": 0,
                      "label": "8."
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "plaster_of_paris_group_9",
              "group_title": "Common fractures managed with POP",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Distal radius fractures.",
                      "level": 0
                    },
                    {
                      "text": "Selected forearm fractures.",
                      "level": 0
                    },
                    {
                      "text": "Selected metacarpal and phalangeal fractures.",
                      "level": 0
                    },
                    {
                      "text": "Selected paediatric fractures.",
                      "level": 0
                    },
                    {
                      "text": "Selected ankle and foot fractures.",
                      "level": 0
                    },
                    {
                      "text": "Selected tibial fractures.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important: Not every fracture is suitable for a cast. Open fractures, unstable or significantly displaced fractures, injuries with neurovascular compromise, and fractures requiring operative fixation need appropriate urgent orthopaedic assessment."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "plaster_of_paris_subsection_8",
          "subsection_title": "7. Contraindications and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "plaster_of_paris_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "There are few absolute contraindications to all plaster immobilisation, but several circumstances require an alternative technique, modification or close monitoring."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Marked acute swelling: a circumferential cast may cause dangerous constriction.",
                      "level": 0
                    },
                    {
                      "text": "Suspected compartment syndrome: urgent assessment and pressure-relieving measures are required.",
                      "level": 0
                    },
                    {
                      "text": "Compromised distal circulation or nerve function.",
                      "level": 0
                    },
                    {
                      "text": "Open wounds requiring repeated inspection or wound care.",
                      "level": 0
                    },
                    {
                      "text": "Severe skin disease or fragile skin.",
                      "level": 0
                    },
                    {
                      "text": "Significant limb deformity that prevents safe application.",
                      "level": 0
                    },
                    {
                      "text": "Patients unable to report pain or pressure reliably, including some patients with neuropathy or impaired consciousness.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "OSCE pearl: A backslab or split cast is often preferred initially when substantial swelling is anticipated. However, suspected compartment syndrome is an emergency; merely applying a backslab does not replace urgent evaluation and definitive management."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "plaster_of_paris_subsection_9",
          "subsection_title": "8. Equipment required for applying a POP cast",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "plaster_of_paris_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/plaster_of_paris_12.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/plaster_of_paris_13.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/plaster_of_paris_14.webp",
                  "caption": null
                },
                {
                  "type": "list",
                  "title": "Common equipment includes:",
                  "items": [
                    {
                      "text": "POP bandages or plaster material.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Bowl of water at an appropriate temperature.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Stockinette, where indicated.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Orthopaedic padding.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Gloves and an apron.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Bandage scissors.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "A suitable support or positioning aid.",
                      "level": 0,
                      "label": "7."
                    },
                    {
                      "text": "Cast saw and spreader for removal, when required.",
                      "level": 0,
                      "label": "8."
                    },
                    {
                      "text": "Equipment for neurovascular assessment.",
                      "level": 0,
                      "label": "9."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The exact equipment depends on the cast type and the clinical setting."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "plaster_of_paris_subsection_10",
          "subsection_title": "9. Principles of POP application",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "plaster_of_paris_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "OSCE practical station: explain the sequence, demonstrate safe handling and state the checks before and after application."
                },
                {
                  "type": "paragraph",
                  "text": "Step 1 — Assess and prepare"
                },
                {
                  "type": "paragraph",
                  "text": "Confirm the indication, examine the injury, document baseline distal pulses, capillary refill, sensation and motor function, and obtain appropriate imaging where indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Step 2 — Position the limb"
                },
                {
                  "type": "paragraph",
                  "text": "Position the patient and limb appropriately. Perform reduction first if required and within the treating clinician's competence."
                },
                {
                  "type": "paragraph",
                  "text": "Step 3 — Apply stockinette and padding"
                },
                {
                  "type": "paragraph",
                  "text": "Protect bony prominences, including the malleoli, heel, elbow and styloid processes. Avoid wrinkles and excessive pressure."
                },
                {
                  "type": "paragraph",
                  "text": "Step 4 — Wet the plaster"
                },
                {
                  "type": "paragraph",
                  "text": "Immerse the POP bandage in appropriately tempered water according to the product instructions. Avoid excessively hot water because it increases the risk of thermal injury."
                },
                {
                  "type": "paragraph",
                  "text": "Step 5 — Apply and mould"
                },
                {
                  "type": "paragraph",
                  "text": "Apply the plaster evenly, with appropriate overlap. Smooth it with the palms rather than fingertips to avoid creating pressure points. Maintain the prescribed position until the cast is sufficiently set."
                },
                {
                  "type": "paragraph",
                  "text": "Step 6 — Check the cast"
                },
                {
                  "type": "paragraph",
                  "text": "Ensure the edges are safe, the cast is not constrictive, and the limb is appropriately supported. Reassess distal circulation, sensation and movement immediately after application."
                },
                {
                  "type": "paragraph",
                  "text": "Step 7 — Monitor and document"
                },
                {
                  "type": "paragraph",
                  "text": "Continue neurovascular observations as indicated. Document the cast applied, limb position, examination findings, instructions and follow-up plan."
                }
              ]
            },
            {
              "group_id": "plaster_of_paris_group_13",
              "group_title": "Critical technical principles",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Avoid wrinkles in the padding.",
                      "level": 0
                    },
                    {
                      "text": "Pad bony prominences adequately.",
                      "level": 0
                    },
                    {
                      "text": "Avoid excessive tightness.",
                      "level": 0
                    },
                    {
                      "text": "Do not use fingertips to mould wet plaster because local indentations may cause pressure injury.",
                      "level": 0
                    },
                    {
                      "text": "Support wet POP with the palms and appropriate positioning.",
                      "level": 0
                    },
                    {
                      "text": "Allow the cast to dry and harden adequately; drying time varies with thickness and conditions.",
                      "level": 0
                    },
                    {
                      "text": "Keep the limb elevated initially when appropriate to reduce swelling.",
                      "level": 0
                    },
                    {
                      "text": "Do not permit weight-bearing unless specifically allowed.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "plaster_of_paris_subsection_11",
          "subsection_title": "10. Advantages and disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "plaster_of_paris_group_14",
              "group_title": "Advantages",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Low cost.",
                      "level": 0
                    },
                    {
                      "text": "Widely available.",
                      "level": 0
                    },
                    {
                      "text": "Excellent mouldability.",
                      "level": 0
                    },
                    {
                      "text": "Conforms well to irregular contours.",
                      "level": 0
                    },
                    {
                      "text": "Can maintain reduction in selected fractures.",
                      "level": 0
                    },
                    {
                      "text": "Easily shaped to make slabs or complete casts.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "plaster_of_paris_group_15",
              "group_title": "Disadvantages",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Relatively heavy.",
                      "level": 0
                    },
                    {
                      "text": "Slow drying.",
                      "level": 0
                    },
                    {
                      "text": "Weakens when wet.",
                      "level": 0
                    },
                    {
                      "text": "Risk of pressure sores.",
                      "level": 0
                    },
                    {
                      "text": "Risk of thermal burns.",
                      "level": 0
                    },
                    {
                      "text": "May conceal swelling and skin injury.",
                      "level": 0
                    },
                    {
                      "text": "Can restrict movement and daily activities.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "plaster_of_paris_subsection_12",
          "subsection_title": "11. Complications of POP casting",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "plaster_of_paris_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Mechanism / warning signs"
                  ],
                  "rows": [
                    [
                      "Compartment syndrome",
                      "Increasing pain, pain on passive stretch, tense swelling and evolving sensory or motor changes"
                    ],
                    [
                      "Pressure sores",
                      "Excessive pressure over bony prominences or wrinkled padding"
                    ],
                    [
                      "Thermal burns",
                      "Excessive heat during the setting reaction"
                    ],
                    [
                      "Neurovascular compromise",
                      "Compression of nerves or blood vessels"
                    ],
                    [
                      "Joint stiffness",
                      "Prolonged immobilisation"
                    ],
                    [
                      "Muscle wasting",
                      "Reduced use of the immobilised limb"
                    ],
                    [
                      "Skin maceration",
                      "Moisture trapped beneath the cast"
                    ],
                    [
                      "Cast breakdown",
                      "Wetting, cracking or mechanical damage"
                    ],
                    [
                      "Loss of fracture reduction",
                      "Poor cast fit, inadequate immobilisation or changing swelling"
                    ],
                    [
                      "Deep-vein thrombosis",
                      "Risk in susceptible patients, especially with lower-limb immobilisation"
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "plaster_of_paris_group_17",
              "group_title": "The five Ps of neurovascular assessment",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "A classic examination mnemonic is:",
                  "items": [
                    {
                      "text": "Pain — especially increasing or disproportionate pain.",
                      "level": 0
                    },
                    {
                      "text": "Pallor — pale skin.",
                      "level": 0
                    },
                    {
                      "text": "Pulselessness — absent distal pulse, a late and concerning sign.",
                      "level": 0
                    },
                    {
                      "text": "Paraesthesia — tingling or altered sensation.",
                      "level": 0
                    },
                    {
                      "text": "Paralysis — impaired movement, generally a late sign.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Some teaching systems add poikilothermia, meaning an unusually cold limb."
                },
                {
                  "type": "paragraph",
                  "text": "Do not wait for all five signs. Compartment syndrome can occur despite palpable pulses. Increasing pain and pain on passive stretch are important early warning signs."
                },
                {
                  "type": "paragraph",
                  "text": "If compartment syndrome or significant neurovascular compromise is suspected, urgent assessment and escalation are essential. A tight cast may need immediate splitting or removal by a trained clinician, alongside definitive management."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "plaster_of_paris_subsection_13",
          "subsection_title": "12. Patient education and cast care",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "plaster_of_paris_group_18",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Teach the patient to:",
                  "items": [
                    {
                      "text": "Keep the cast dry and avoid inserting objects beneath it.",
                      "level": 0
                    },
                    {
                      "text": "Elevate the limb initially as advised.",
                      "level": 0
                    },
                    {
                      "text": "Move exposed fingers or toes regularly if permitted.",
                      "level": 0
                    },
                    {
                      "text": "Attend follow-up and imaging appointments as directed.",
                      "level": 0
                    },
                    {
                      "text": "Avoid bearing weight until authorised.",
                      "level": 0
                    },
                    {
                      "text": "Inspect exposed digits for colour, warmth, sensation and movement.",
                      "level": 0
                    },
                    {
                      "text": "Avoid cutting or modifying the cast themselves.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "plaster_of_paris_group_19",
              "group_title": "Red flags requiring urgent review",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Increasing or severe pain despite prescribed analgesia.",
                      "level": 0
                    },
                    {
                      "text": "New numbness or tingling.",
                      "level": 0
                    },
                    {
                      "text": "Pale, blue or cold fingers or toes.",
                      "level": 0
                    },
                    {
                      "text": "Increasing swelling or difficulty moving exposed digits.",
                      "level": 0
                    },
                    {
                      "text": "A wet, cracked, loose or excessively tight cast.",
                      "level": 0
                    },
                    {
                      "text": "Foul odour, discharge or fever.",
                      "level": 0
                    },
                    {
                      "text": "A burning sensation beneath the cast.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "plaster_of_paris_subsection_14",
          "subsection_title": "13. POP versus fibreglass casting",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "plaster_of_paris_group_20",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "POP",
                    "Fibreglass"
                  ],
                  "rows": [
                    [
                      "Cost",
                      "Usually cheaper",
                      "Usually more expensive"
                    ],
                    [
                      "Mouldability",
                      "Excellent",
                      "Good, but often less forgiving"
                    ],
                    [
                      "Weight",
                      "Heavier",
                      "Lighter"
                    ],
                    [
                      "Setting",
                      "Generally slower",
                      "Generally faster"
                    ],
                    [
                      "Strength-to-weight ratio",
                      "Lower",
                      "Higher"
                    ],
                    [
                      "Water resistance",
                      "Poor",
                      "Fibreglass material may tolerate moisture better, but padding and the specific cast system determine whether it can be wet"
                    ],
                    [
                      "Radiographic assessment",
                      "Generally possible",
                      "Generally possible"
                    ],
                    [
                      "Typical use",
                      "Acute moulding and many conventional casts",
                      "Selected definitive casts and situations where light weight is beneficial"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Neither material is universally superior. The decision depends on the injury, swelling, need for moulding, cost, availability and clinical protocol."
                }
              ]
            }
          ]
