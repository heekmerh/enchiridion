        {
          "subsection_id": "plaster_of_paris_subsection_16",
          "subsection_title": "15. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "plaster_of_paris_group_22",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is Plaster of Paris, an orthopaedic casting material composed mainly of calcium sulfate hemihydrate. When mixed with water, it undergoes an exothermic setting reaction and forms a rigid structure. It is used for immobilising selected fractures, maintaining reduction and supporting injured bones and joints. Its advantages include low cost, availability and excellent mouldability. Its disadvantages include relatively heavy weight, slow drying and poor water resistance. Complications include pressure sores, thermal burns, neurovascular compromise, joint stiffness and compartment syndrome. Safe application requires appropriate padding, careful moulding, baseline and post-application neurovascular assessment, patient education and timely follow-up.”",
                  "style": "quote"
                }
              ]
            }
          ]
