  "sections": [
    {
      "section_id": "nasal_cannula_section_1",
      "section_title": "Nasal cannula",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "nasal_cannula_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_cannula_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The goal of this station is to identify the nasal cannula, explain how it delivers oxygen, select an appropriate flow rate, demonstrate correct application, interpret its limitations, and recognize complications in adults, children, and neonates."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_cannula_subsection_2",
          "subsection_title": "Identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_cannula_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/nasal_cannula_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Name: Nasal cannula (nasal prongs)."
                },
                {
                  "type": "paragraph",
                  "text": "Classification: Low-flow oxygen delivery device when used at conventional flows."
                },
                {
                  "type": "paragraph",
                  "text": "Principle: Delivers supplemental oxygen through two small prongs positioned inside the nostrils. The oxygen mixes with room air during inspiration, so the inspired oxygen concentration (FiO₂) varies with the patient's breathing pattern, respiratory rate, tidal volume, and oxygen flow."
                },
                {
                  "type": "paragraph",
                  "text": "Typical adult flow: 1–6 L/min for a conventional nasal cannula, subject to local protocols and the clinical indication."
                },
                {
                  "type": "paragraph",
                  "text": "Examiner's expected answer:"
                },
                {
                  "type": "paragraph",
                  "text": "\"This is a nasal cannula. It is a low-flow oxygen delivery device used to administer supplemental oxygen to patients who are breathing spontaneously. It is relatively comfortable and allows the patient to talk, eat, and drink.\""
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_cannula_subsection_3",
          "subsection_title": "Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_cannula_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Clinical situation",
                    "Purpose"
                  ],
                  "rows": [
                    [
                      "Mild hypoxaemia",
                      "Provides supplemental oxygen to improve oxygen saturation."
                    ],
                    [
                      "Pneumonia",
                      "Supports oxygenation when indicated."
                    ],
                    [
                      "Recovery after surgery",
                      "Treats or prevents hypoxaemia according to the patient's needs and prescribed target."
                    ],
                    [
                      "Chronic respiratory disease",
                      "Provides controlled supplemental oxygen when appropriate, with an individualised target saturation."
                    ],
                    [
                      "Pediatric respiratory illness",
                      "Provides supplemental oxygen to a spontaneously breathing child when conventional nasal oxygen is suitable."
                    ],
                    [
                      "Home oxygen therapy",
                      "Delivers prescribed oxygen during daily activities."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important: Oxygen is a treatment for hypoxaemia, not a substitute for assessing and treating its cause. A patient with severe respiratory distress, apnoea, or inadequate ventilation may require more advanced respiratory support."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_cannula_subsection_4",
          "subsection_title": "Parts and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_cannula_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/nasal_cannula_02.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "A. Nasal prongs"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Two short projections inserted gently into the nostrils to deliver oxygen."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/nasal_cannula_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Connecting tubing"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Carries oxygen from the source to the nasal prongs."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/nasal_cannula_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "C. Tubing adjuster"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Helps secure and adjust the tubing around the cheeks, under the chin, or behind the head, depending on the design."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/nasal_cannula_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "D. Oxygen source and flowmeter"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The oxygen source supplies gas, while the flowmeter controls the prescribed flow rate in litres per minute."
                },
                {
                  "type": "paragraph",
                  "text": "Other accessories may include a humidifier, oxygen tubing connectors, and skin-protection dressings."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_cannula_subsection_5",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_cannula_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Comfortable and generally well tolerated."
                },
                {
                  "type": "paragraph",
                  "text": "Allows speech, eating, and drinking."
                },
                {
                  "type": "paragraph",
                  "text": "Easy to apply without covering the mouth."
                },
                {
                  "type": "paragraph",
                  "text": "Allows access to the face for examination and many routine procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Relatively inexpensive and widely available."
                },
                {
                  "type": "paragraph",
                  "text": "Suitable for many patients requiring low-flow supplemental oxygen."
                },
                {
                  "type": "paragraph",
                  "text": "Available in adult, pediatric, and neonatal sizes."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_cannula_subsection_6",
          "subsection_title": "Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_cannula_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The delivered FiO₂ is variable and cannot be reliably fixed at a precise concentration with a conventional low-flow cannula."
                },
                {
                  "type": "paragraph",
                  "text": "High respiratory rates and increased inspiratory demand can reduce the effective inspired oxygen concentration."
                },
                {
                  "type": "paragraph",
                  "text": "Oxygen delivery may be inadequate in severe hypoxaemia or respiratory distress."
                },
                {
                  "type": "paragraph",
                  "text": "Nasal obstruction, mouth breathing, or displacement can reduce effectiveness."
                },
                {
                  "type": "paragraph",
                  "text": "Prolonged use may cause nasal dryness, irritation, or pressure injury."
                },
                {
                  "type": "paragraph",
                  "text": "Conventional low-flow cannulae do not provide reliable positive airway pressure or ventilatory support."
                },
                {
                  "type": "paragraph",
                  "text": "Oxygen remains a fire hazard and must be handled safely."
                },
                {
                  "type": "paragraph",
                  "text": "Important distinction: A conventional nasal cannula is not the same as a high-flow nasal cannula (HFNC). HFNC delivers heated, humidified gas at substantially higher flow rates and can provide more stable oxygen delivery and some positive airway pressure effects."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/nasal_cannula_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "NCBI Bookshelf",
                    "+1"
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_cannula_subsection_7",
          "subsection_title": "Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_cannula_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Before applying the cannula:"
                },
                {
                  "type": "paragraph",
                  "text": "Perform hand hygiene and explain the procedure."
                },
                {
                  "type": "paragraph",
                  "text": "Assess respiratory rate, work of breathing, oxygen saturation, and the patient's general condition."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm the prescribed oxygen target and delivery method."
                },
                {
                  "type": "paragraph",
                  "text": "Check the oxygen source, flowmeter, tubing, and cannula for damage or obstruction."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm that the tubing is connected securely."
                },
                {
                  "type": "paragraph",
                  "text": "Set the prescribed flow rate."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure that the prongs are clean and appropriately sized."
                },
                {
                  "type": "paragraph",
                  "text": "Check the skin around the nostrils and ears for irritation or pressure injury."
                },
                {
                  "type": "paragraph",
                  "text": "Keep oxygen away from flames, smoking, sparks, and oil-based products."
                },
                {
                  "type": "paragraph",
                  "text": "Arrange appropriate monitoring and escalation if oxygenation does not improve."
                },
                {
                  "type": "paragraph",
                  "text": "Exam tip: Do not simply turn on oxygen at an arbitrary flow rate. The flow and target saturation should be appropriate for the patient's clinical condition."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_cannula_subsection_8",
          "subsection_title": "How to use it — step-by-step OSCE demonstration",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_cannula_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/nasal_cannula_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 1: Assess the patient"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Introduce yourself, confirm identity, explain the procedure, and assess respiratory status and oxygen saturation."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 2: Prepare the equipment"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Check the oxygen source and flowmeter. Connect the nasal cannula tubing securely to the oxygen outlet."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 3: Set the flow rate"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Set the prescribed flow. Confirm oxygen is flowing using the appropriate equipment check; do not rely on the absence of visible movement in the tubing."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/nasal_cannula_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 4: Position the prongs"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Gently insert the prongs into the nostrils, with the curved prongs oriented according to the device design. Do not force them into the nose."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 5: Secure the cannula"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Place the tubing around the ears or according to the manufacturer's design. Adjust the slider so the cannula is secure but not tight."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 6: Reassess"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Check comfort, breathing effort, cannula position, and oxygen saturation. Confirm that the patient is responding to treatment."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 7: Maintain and document"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Reassess as indicated, inspect pressure areas, document the device and flow rate, and record the patient's response."
                }
              ]
            },
            {
              "group_id": "nasal_cannula_group_9",
              "group_title": "What to say during the OSCE",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "\"I would assess the patient's oxygenation, check the prescribed target saturation, inspect and connect the cannula, set the prescribed flow rate, insert and secure the prongs, and monitor the patient's response. I would escalate care if oxygenation or respiratory distress failed to improve.\""
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_cannula_subsection_9",
          "subsection_title": "Contraindications and complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_cannula_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "There are few absolute contraindications to nasal cannula oxygen when oxygen is clinically indicated. However, the device may be unsuitable when the patient needs more reliable or more advanced respiratory support."
                }
              ]
            },
            {
              "group_id": "nasal_cannula_group_11",
              "group_title": "Limitations or situations requiring an alternative",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Severe hypoxaemia that does not respond adequately to conventional low-flow oxygen."
                },
                {
                  "type": "paragraph",
                  "text": "Apnoea or inadequate ventilation."
                },
                {
                  "type": "paragraph",
                  "text": "Severe respiratory distress requiring urgent escalation."
                },
                {
                  "type": "paragraph",
                  "text": "Significant nasal obstruction or facial anatomy that prevents effective application."
                }
              ]
            },
            {
              "group_id": "nasal_cannula_group_12",
              "group_title": "Complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Prevention or management"
                  ],
                  "rows": [
                    [
                      "Nasal dryness",
                      "Assess comfort; consider humidification when clinically indicated."
                    ],
                    [
                      "Skin breakdown",
                      "Check the nostrils and ears regularly; adjust tubing and use appropriate skin protection."
                    ],
                    [
                      "Persistent hypoxaemia",
                      "Check the source and connections, reassess the patient, and escalate oxygen or respiratory support."
                    ],
                    [
                      "Oxygen toxicity",
                      "Avoid unnecessarily high oxygen concentrations or prolonged hyperoxia, especially in vulnerable patients."
                    ],
                    [
                      "Hypercapnia in susceptible patients",
                      "Use an appropriate target saturation and assess blood gases when indicated."
                    ],
                    [
                      "Fire hazard",
                      "Enforce oxygen safety and prohibit smoking or naked flames nearby."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "High-yield exception: In patients at risk of hypercapnic respiratory failure, such as some patients with COPD, oxygen is usually titrated to a target SpO₂ of 88–92% initially, pending blood gas assessment and an individualised plan. Do not withhold oxygen from a critically hypoxaemic patient; administer it appropriately while urgently assessing and treating the cause."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_cannula_subsection_10",
          "subsection_title": "Normal and abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_cannula_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The cannula does not itself produce a diagnostic result. You assess oxygenation and the patient's response to therapy."
                },
                {
                  "type": "table",
                  "columns": [
                    "Finding",
                    "Interpretation"
                  ],
                  "rows": [
                    [
                      "SpO₂ reaches the prescribed target",
                      "Oxygenation is responding to treatment."
                    ],
                    [
                      "SpO₂ remains below target",
                      "Check equipment and patient status; consider escalation."
                    ],
                    [
                      "Reduced work of breathing",
                      "May indicate clinical improvement."
                    ],
                    [
                      "Persistent tachypnoea or accessory muscle use",
                      "Suggests ongoing respiratory distress despite oxygen."
                    ],
                    [
                      "New drowsiness or confusion",
                      "May indicate deterioration, hypoxaemia, hypercapnia, or another cause."
                    ],
                    [
                      "Cyanosis or exhaustion",
                      "Serious warning signs requiring urgent assessment and escalation."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Pulse oximetry should be interpreted alongside the clinical examination. A satisfactory SpO₂ does not exclude hypercapnia or inadequate ventilation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_cannula_subsection_11",
          "subsection_title": "Pediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_cannula_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Pediatric oxygen delivery is a particularly important OSCE topic because infants and children have different flow requirements, oxygen targets, and risks."
                }
              ]
            },
            {
              "group_id": "nasal_cannula_group_15",
              "group_title": "A. Typical conventional low-flow nasal cannula ranges",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "These are commonly taught starting ranges, not universal prescriptions. Follow the local pediatric or neonatal protocol and titrate according to the patient's condition and target saturation."
                },
                {
                  "type": "table",
                  "columns": [
                    "Patient group",
                    "Common conventional flow range"
                  ],
                  "rows": [
                    [
                      "Neonates",
                      "Often 0.5–1 L/min, with lower flows sometimes used according to the neonatal protocol"
                    ],
                    [
                      "Infants",
                      "Often 1–2 L/min"
                    ],
                    [
                      "Older children",
                      "Often 2–4 L/min; conventional devices may be used up to 6 L/min in selected circumstances"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "WHO pediatric emergency guidance gives initial standard flows of 0.5–1 L/min for neonates, 1–2 L/min for infants, and 2–4 L/min for older children, with subsequent adjustment to the clinical response."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/nasal_cannula_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "--",
                    "+1"
                  ]
                }
              ]
            },
            {
              "group_id": "nasal_cannula_group_16",
              "group_title": "B. Important precautions",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Use a cannula appropriate for the child's size."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure the prongs do not obstruct the nostrils."
                },
                {
                  "type": "paragraph",
                  "text": "Monitor oxygen saturation and respiratory effort."
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the skin around the nostrils and ears."
                },
                {
                  "type": "paragraph",
                  "text": "Do not delay escalation when a child has severe respiratory distress or persistent hypoxaemia."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid applying adult flow settings indiscriminately to neonates."
                }
              ]
            },
            {
              "group_id": "nasal_cannula_group_17",
              "group_title": "C. Neonatal oxygen safety",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Premature infants are particularly vulnerable to both hypoxaemia and hyperoxia. Oxygen must be carefully titrated against gestational-age-appropriate and condition-specific targets. During neonatal resuscitation, oxygen concentration is guided by gestational age, pulse oximetry, and the resuscitation protocol; a nasal cannula is not a substitute for effective positive-pressure ventilation when ventilation is required."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/nasal_cannula_10.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "American Academy of Pediatrics",
                    "+1"
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_cannula_subsection_12",
          "subsection_title": "Mnemonics and memory aids",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_cannula_group_18",
              "group_title": "N",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Nostrils"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Check patency and position the prongs correctly."
                }
              ]
            },
            {
              "group_id": "nasal_cannula_group_19",
              "group_title": "A",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Assess"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Assess oxygen saturation and respiratory distress."
                }
              ]
            },
            {
              "group_id": "nasal_cannula_group_20",
              "group_title": "S",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Set"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Set the prescribed oxygen flow."
                }
              ]
            },
            {
              "group_id": "nasal_cannula_group_21",
              "group_title": "A",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Adjust"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Adjust and secure the tubing comfortably."
                }
              ]
            },
            {
              "group_id": "nasal_cannula_group_22",
              "group_title": "L",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Look again"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Reassess oxygenation, comfort, and skin integrity."
                }
              ]
            },
            {
              "group_id": "nasal_cannula_group_23",
              "group_title": "Approximate adult FiO₂: the 4–6 rule",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "For conventional adult nasal cannulae, a commonly taught rough estimate is:"
                },
                {
                  "type": "paragraph",
                  "text": "Room air: 21% oxygen."
                },
                {
                  "type": "paragraph",
                  "text": "Each additional 1 L/min may increase FiO₂ by approximately 3–4 percentage points."
                },
                {
                  "type": "paragraph",
                  "text": "At 4 L/min, the rough estimate is around 33–37%."
                },
                {
                  "type": "paragraph",
                  "text": "At 6 L/min, the rough estimate is around 39–45%."
                },
                {
                  "type": "paragraph",
                  "text": "These are estimates only, not guaranteed concentrations. Actual FiO₂ varies with breathing pattern, minute ventilation, and cannula fit. Do not use this rule as a substitute for pulse oximetry and clinical assessment."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_cannula_subsection_13",
          "subsection_title": "Common OSCE questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_cannula_group_24",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is the principle of a nasal cannula?"
                },
                {
                  "type": "paragraph",
                  "text": "It delivers supplemental oxygen through nasal prongs, where the oxygen mixes with room air during inspiration."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Why is it classified as a low-flow device?"
                },
                {
                  "type": "paragraph",
                  "text": "Its flow does not reliably meet the patient's entire inspiratory demand, so room air is entrained and the delivered FiO₂ varies."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What is the usual adult flow rate?"
                },
                {
                  "type": "paragraph",
                  "text": "Conventionally 1–6 L/min, adjusted to the patient's condition and prescribed target. Higher flow requirements may indicate the need for another device or respiratory support."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Can a patient eat and speak while using a nasal cannula?"
                },
                {
                  "type": "paragraph",
                  "text": "Generally, yes, because the device does not cover the mouth."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What would you do if SpO₂ remains low?"
                },
                {
                  "type": "paragraph",
                  "text": "Assess the patient urgently, check the oxygen source, flowmeter, connections and cannula position, confirm the pulse oximeter signal, and escalate oxygen delivery and respiratory support as clinically indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What is the difference between a nasal cannula and a Venturi mask?"
                },
                {
                  "type": "paragraph",
                  "text": "A conventional nasal cannula provides variable FiO₂. A Venturi mask uses an air-entrainment system to deliver a more controlled oxygen concentration at the specified flow conditions."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What is the difference between a conventional nasal cannula and HFNC?"
                },
                {
                  "type": "paragraph",
                  "text": "HFNC delivers heated, humidified gas at much higher flows and can provide more stable FiO₂ and some positive airway pressure effects. Conventional cannulae do not provide the same support."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. Why should oxygen be used cautiously in COPD?"
                },
                {
                  "type": "paragraph",
                  "text": "Some patients with COPD are at risk of oxygen-associated worsening hypercapnia. Oxygen should be titrated to the appropriate target, often 88–92% initially in those at risk, while blood gases and clinical status guide ongoing treatment."
                },
                {
                  "type": "paragraph",
                  "text": "Q9. What complications can prolonged cannula use cause?"
                },
                {
                  "type": "paragraph",
                  "text": "Nasal dryness, irritation, and pressure injuries around the nostrils and ears."
                },
                {
                  "type": "paragraph",
                  "text": "Q10. What is the priority if a child is apnoeic?"
                },
                {
                  "type": "paragraph",
                  "text": "Immediate assessment and effective ventilation with appropriate resuscitation equipment. A nasal cannula alone is inadequate for apnoea."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "nasal_cannula_subsection_14",
          "subsection_title": "Common mistakes and examiner tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "nasal_cannula_group_25",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Mistake: Assuming a fixed FiO₂"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Explain that conventional nasal cannula FiO₂ is variable."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Mistake: Ignoring the prescribed target"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "State the target saturation and titrate oxygen appropriately."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Mistake: Using adult settings in a neonate"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Select age-appropriate flow and monitor carefully."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Mistake: Treating the saturation rather than the patient"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Assess work of breathing, consciousness, circulation, and the underlying cause."
                },
                {
                  "type": "checklist",
                  "items": [
                    "What impresses the examiner"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Identify the device, state its typical flow range, explain variable FiO₂, demonstrate correct placement, and describe monitoring and escalation."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}