  "sections": [
    {
      "section_id": "radiant_warmer_section_1",
      "section_title": "Radiant warmer",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "radiant_warmer_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "radiant_warmer_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/radiant_warmer_01.webp",
                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "radiant_warmer_subsection_2",
          "subsection_title": "Identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "radiant_warmer_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A radiant warmer is an open-care neonatal device that provides heat to a newborn using an overhead radiant heating element. It helps maintain the infant's body temperature while allowing healthcare professionals unrestricted access for examination, procedures, and resuscitation."
                },
                {
                  "type": "paragraph",
                  "text": "Classification: Neonatal thermal-support equipment."
                },
                {
                  "type": "paragraph",
                  "text": "Common locations: Delivery rooms, neonatal intensive care units (NICUs), operating theatres, and newborn stabilization areas."
                },
                {
                  "type": "paragraph",
                  "text": "Key identification feature: An open infant bed with an overhead heating element, usually accompanied by a temperature-control panel and a skin-temperature probe."
                },
                {
                  "type": "paragraph",
                  "text": "Unlike an incubator, which maintains a warm microenvironment within an enclosed compartment, a radiant warmer delivers heat from above and leaves the infant accessible."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "radiant_warmer_subsection_3",
          "subsection_title": "Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "radiant_warmer_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A radiant warmer is used when a newborn needs thermal support and frequent clinical access."
                },
                {
                  "type": "paragraph",
                  "text": "Delivery-room stabilization: Maintains warmth during assessment and resuscitation."
                },
                {
                  "type": "paragraph",
                  "text": "Prematurity: Helps prevent heat loss in preterm infants."
                },
                {
                  "type": "paragraph",
                  "text": "Low birth weight: Supports temperature regulation in infants with limited thermal reserves."
                },
                {
                  "type": "paragraph",
                  "text": "Neonatal procedures: Provides warmth during intravenous access, intubation, and other interventions."
                },
                {
                  "type": "paragraph",
                  "text": "Resuscitation: Allows access to the infant during ventilation and advanced life support."
                },
                {
                  "type": "paragraph",
                  "text": "Temperature instability: Helps maintain an appropriate thermal environment under continuous monitoring."
                },
                {
                  "type": "paragraph",
                  "text": "Selected neonatal emergencies: Allows rapid access when intensive assessment or intervention is required."
                },
                {
                  "type": "paragraph",
                  "text": "Important: A radiant warmer does not treat the underlying cause of hypothermia. Temperature must be monitored, and the infant's condition and the cause of heat loss must be assessed."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "radiant_warmer_subsection_4",
          "subsection_title": "Parts and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "radiant_warmer_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/radiant_warmer_02.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Radiant heating element"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Emits infrared radiation that warms the infant and nearby surfaces without requiring an enclosed chamber."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/radiant_warmer_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Control panel"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Allows selection of operating modes and temperature settings, with alarms and displays depending on the model."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/radiant_warmer_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Skin-temperature probe"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Measures the infant's skin temperature and feeds information to the control system when servo-controlled mode is used."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/radiant_warmer_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Mattress and bed platform"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Supports the newborn and allows access for examination, monitoring, and procedures."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/radiant_warmer_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "5. Alarm system"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Alerts staff to selected temperature abnormalities, probe problems, or equipment faults, depending on the model."
                },
                {
                  "type": "paragraph",
                  "text": "Other features may include examination lights, weighing scales, oxygen and suction connections, resuscitation equipment mounts, and storage shelves."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "radiant_warmer_subsection_5",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "radiant_warmer_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Excellent access: The open design allows immediate examination and intervention."
                },
                {
                  "type": "paragraph",
                  "text": "Useful during resuscitation: Ventilation, intubation, and other procedures can be performed without moving the infant into an enclosed incubator."
                },
                {
                  "type": "paragraph",
                  "text": "Continuous thermal support: Servo-controlled models adjust heat output according to the skin-temperature probe."
                },
                {
                  "type": "paragraph",
                  "text": "Facilitates monitoring: Staff can observe breathing, colour, movement, and monitoring equipment easily."
                },
                {
                  "type": "paragraph",
                  "text": "Convenient for procedures: Provides a warm environment during blood sampling, intravenous access, and emergency interventions."
                },
                {
                  "type": "paragraph",
                  "text": "Useful in delivery rooms: Can be prepared before an anticipated high-risk birth."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "radiant_warmer_subsection_6",
          "subsection_title": "Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "radiant_warmer_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Increased evaporative heat loss: The open environment exposes the infant's skin to surrounding air."
                },
                {
                  "type": "paragraph",
                  "text": "Risk of overheating: Excessive heating or incorrect probe placement can cause hyperthermia."
                },
                {
                  "type": "paragraph",
                  "text": "Risk of hypothermia: Inadequate heat output or poor temperature monitoring may allow continued heat loss."
                },
                {
                  "type": "paragraph",
                  "text": "Fluid loss: Prolonged exposure can increase insensible water loss, particularly in very preterm infants."
                },
                {
                  "type": "paragraph",
                  "text": "Radiant heat exposure: Incorrect use can cause thermal injury."
                },
                {
                  "type": "paragraph",
                  "text": "Environmental exposure: The open bed provides less protection against drafts and environmental contamination than an enclosed incubator."
                },
                {
                  "type": "paragraph",
                  "text": "Dependence on electricity: Most units require a reliable power supply."
                },
                {
                  "type": "paragraph",
                  "text": "Examiner distinction: Radiant warmers are particularly useful when immediate access is needed. Incubators are often more suitable for prolonged thermal care when a controlled enclosed environment is beneficial."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "radiant_warmer_subsection_7",
          "subsection_title": "Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "radiant_warmer_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Before placing a newborn under a radiant warmer:"
                },
                {
                  "type": "paragraph",
                  "text": "Check that the device is clean, functional, and connected to an appropriate power supply."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm that the mattress and surrounding surfaces are clean and dry."
                },
                {
                  "type": "paragraph",
                  "text": "Switch on the warmer and allow it to operate according to the manufacturer's instructions."
                },
                {
                  "type": "paragraph",
                  "text": "Check the control panel, alarm system, and temperature probe."
                },
                {
                  "type": "paragraph",
                  "text": "Select the appropriate operating mode."
                },
                {
                  "type": "paragraph",
                  "text": "Position the skin-temperature probe correctly if using servo control."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure that oxygen, suction, ventilation equipment, and monitoring are available when clinically indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm that emergency equipment is accessible for high-risk deliveries."
                },
                {
                  "type": "paragraph",
                  "text": "Maintain appropriate infection-prevention precautions."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure that the infant is positioned safely, with the airway accessible."
                }
              ]
            },
            {
              "group_id": "radiant_warmer_group_8",
              "group_title": "Temperature probe placement",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The probe is commonly placed on the upper abdomen or another manufacturer-approved site, often away from direct bone prominences."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure good contact with the skin."
                },
                {
                  "type": "paragraph",
                  "text": "Secure the probe according to the manufacturer's instructions."
                },
                {
                  "type": "paragraph",
                  "text": "Keep it away from areas directly heated by the element in a way that could distort readings."
                },
                {
                  "type": "paragraph",
                  "text": "Check that it has not detached or become displaced."
                },
                {
                  "type": "paragraph",
                  "text": "Critical safety point: A detached probe may cause the control system to respond inappropriately. Never assume that a displayed temperature accurately reflects the infant's condition without checking probe placement and the infant itself."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "radiant_warmer_subsection_8",
          "subsection_title": "How to use a radiant warmer: step-by-step OSCE demonstration",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "radiant_warmer_group_9",
              "group_title": "Step 1: Introduce and prepare",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Explain the procedure to the parent when circumstances permit. Perform hand hygiene and ensure that the equipment is ready."
                }
              ]
            },
            {
              "group_id": "radiant_warmer_group_10",
              "group_title": "Step 2: Switch on the warmer",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Activate the device and check its operational status. Select the appropriate mode according to the clinical situation and manufacturer's instructions."
                }
              ]
            },
            {
              "group_id": "radiant_warmer_group_11",
              "group_title": "Step 3: Select the operating mode",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Most warmers provide one or both of the following modes:"
                },
                {
                  "type": "paragraph",
                  "text": "Pre-warm/manual mode: Heat output is selected by the operator. The infant's temperature must be monitored closely."
                },
                {
                  "type": "paragraph",
                  "text": "Servo-control mode: Heat output is automatically adjusted in response to the skin-temperature probe."
                },
                {
                  "type": "paragraph",
                  "text": "Servo control is commonly used when continuous thermal regulation is required."
                }
              ]
            },
            {
              "group_id": "radiant_warmer_group_12",
              "group_title": "Step 4: Position the newborn",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Place the infant safely on the mattress, maintaining airway patency. Dry the term newborn and remove wet towels when appropriate. For very preterm infants, follow the local thermal-protection protocol, which may include a plastic wrap or bag and a hat."
                }
              ]
            },
            {
              "group_id": "radiant_warmer_group_13",
              "group_title": "Step 5: Apply the temperature probe",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Place and secure the probe at the recommended site. Confirm that the temperature reading is plausible and that the probe is correctly connected."
                }
              ]
            },
            {
              "group_id": "radiant_warmer_group_14",
              "group_title": "Step 6: Set the prescribed target",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "For a servo-controlled warmer, select the prescribed skin-temperature target according to the neonatal protocol. A commonly used target for newborn thermal care is approximately 36.5–37.5°C for body temperature."
                },
                {
                  "type": "paragraph",
                  "text": "Do not confuse the infant's target temperature with the warmer's heat-output setting."
                }
              ]
            },
            {
              "group_id": "radiant_warmer_group_15",
              "group_title": "Step 7: Monitor the newborn",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Monitor temperature, breathing, heart rate, and general condition. Assess for signs of overheating or ongoing heat loss."
                }
              ]
            },
            {
              "group_id": "radiant_warmer_group_16",
              "group_title": "Step 8: Respond to abnormalities",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "If the infant becomes too warm or remains cold:"
                },
                {
                  "type": "paragraph",
                  "text": "Recheck the infant's temperature using an appropriate method."
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the probe position and connections."
                },
                {
                  "type": "paragraph",
                  "text": "Review the operating mode and settings."
                },
                {
                  "type": "paragraph",
                  "text": "Assess the infant for underlying illness."
                },
                {
                  "type": "paragraph",
                  "text": "Adjust treatment according to the clinical situation and local protocol."
                }
              ]
            },
            {
              "group_id": "radiant_warmer_group_17",
              "group_title": "Step 9: Document and continue care",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Record temperature, relevant settings, observations, and interventions as required. Reassess the ongoing need for the warmer and transfer to another thermal-care environment when clinically appropriate."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "radiant_warmer_subsection_9",
          "subsection_title": "Contraindications and complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "radiant_warmer_group_18",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "There are no routine absolute contraindications to radiant warming when clinically indicated. The principal concerns are inappropriate use, failure to monitor temperature, and device-related hazards."
                },
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Cause or prevention"
                  ],
                  "rows": [
                    [
                      "Hypothermia",
                      "Inadequate heat delivery, poor probe contact, or excessive heat loss"
                    ],
                    [
                      "Hyperthermia",
                      "Excessive heating or an incorrectly positioned probe"
                    ],
                    [
                      "Thermal injury",
                      "Excessive radiant heat or equipment malfunction"
                    ],
                    [
                      "Increased insensible water loss",
                      "Prolonged open-care exposure, particularly in very preterm infants"
                    ],
                    [
                      "Temperature instability",
                      "Probe displacement, environmental factors, or underlying illness"
                    ],
                    [
                      "Electrical injury",
                      "Damaged equipment or unsafe electrical connections"
                    ],
                    [
                      "Infection risk",
                      "Poor hand hygiene or contaminated equipment"
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "radiant_warmer_group_19",
              "group_title": "Important precautions",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Never leave a newborn without appropriate observation simply because the warmer is operating."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid placing materials or objects in positions that obstruct the heater or interfere with its operation."
                },
                {
                  "type": "paragraph",
                  "text": "Do not cover the skin-temperature probe with material that may alter its readings unless specifically instructed by the manufacturer."
                },
                {
                  "type": "paragraph",
                  "text": "Do not use the warmer as a substitute for assessment and treatment of sepsis, hypoglycaemia, respiratory distress, or other underlying illness."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "radiant_warmer_subsection_10",
          "subsection_title": "Normal and abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "radiant_warmer_group_20",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The radiant warmer is a thermal-support device rather than a diagnostic instrument. Assessment focuses on the infant's temperature, clinical response, and equipment performance."
                }
              ]
            },
            {
              "group_id": "radiant_warmer_group_21",
              "group_title": "Normal findings",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The newborn's body temperature remains within the target range."
                },
                {
                  "type": "paragraph",
                  "text": "The infant is not showing signs of overheating or excessive heat loss."
                },
                {
                  "type": "paragraph",
                  "text": "The temperature probe is secure and displays a plausible reading."
                },
                {
                  "type": "paragraph",
                  "text": "The warmer responds appropriately in servo-control mode."
                },
                {
                  "type": "paragraph",
                  "text": "No equipment alarms or faults are present."
                }
              ]
            },
            {
              "group_id": "radiant_warmer_group_22",
              "group_title": "Abnormal findings",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Finding",
                    "Possible interpretation"
                  ],
                  "rows": [
                    [
                      "Temperature below 36.5°C",
                      "Neonatal hypothermia"
                    ],
                    [
                      "Temperature above 37.5°C",
                      "Possible hyperthermia"
                    ],
                    [
                      "Rapidly fluctuating temperature",
                      "Probe displacement, environmental changes, or illness"
                    ],
                    [
                      "High heater output despite a warm infant",
                      "Probe malfunction, incorrect placement, or control-system problem"
                    ],
                    [
                      "Repeated equipment alarms",
                      "Probe, temperature-control, or device fault"
                    ],
                    [
                      "Persistent hypothermia despite warming",
                      "Inadequate heat delivery or an underlying clinical problem"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "OSCE note: Neonatal temperature is generally maintained at 36.5–37.5°C. Interpret readings in context and confirm abnormal measurements using an appropriate method."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "radiant_warmer_subsection_11",
          "subsection_title": "Pediatric and neonatal considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "radiant_warmer_group_23",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Very preterm infants"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Have thin skin, limited fat stores, and immature thermoregulation. They are especially vulnerable to heat loss and may require a combination of radiant warming, plastic wrapping, a hat, and close temperature monitoring."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Skin-temperature monitoring"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Probe placement and contact are crucial. An inaccurate reading may cause the warmer to deliver too much or too little heat."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Fluid balance"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Very preterm infants may have increased insensible water losses. Fluid management should account for gestational age, weight, renal function, and the clinical situation."
                },
                {
                  "type": "paragraph",
                  "text": "Additional considerations:"
                },
                {
                  "type": "paragraph",
                  "text": "Avoid excessive heat, especially in very low birth weight infants."
                },
                {
                  "type": "paragraph",
                  "text": "Maintain a neutral thermal environment appropriate to the infant's gestational age and condition."
                },
                {
                  "type": "paragraph",
                  "text": "Consider hypoglycaemia and sepsis when hypothermia persists or recurs."
                },
                {
                  "type": "paragraph",
                  "text": "Use an incubator or another appropriate thermal-care system when prolonged enclosed environmental control is needed."
                },
                {
                  "type": "paragraph",
                  "text": "Monitor temperature closely during transport and transfers between devices."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "radiant_warmer_subsection_12",
          "subsection_title": "Mnemonic: “WARM BABY”",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "radiant_warmer_group_24",
              "group_title": "W",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Warm the environment"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Prepare the warmer before use."
                }
              ]
            },
            {
              "group_id": "radiant_warmer_group_25",
              "group_title": "A",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Attach the probe"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Ensure secure, correct placement."
                }
              ]
            },
            {
              "group_id": "radiant_warmer_group_26",
              "group_title": "R",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Read the temperature"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Confirm a plausible measurement."
                }
              ]
            },
            {
              "group_id": "radiant_warmer_group_27",
              "group_title": "M",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Monitor continuously"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Watch temperature and clinical condition."
                }
              ]
            },
            {
              "group_id": "radiant_warmer_group_28",
              "group_title": "B",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Beware overheating"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Prevent excessive heat exposure."
                }
              ]
            },
            {
              "group_id": "radiant_warmer_group_29",
              "group_title": "A",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
