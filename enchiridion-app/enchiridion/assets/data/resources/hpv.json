      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "hpv_subsection_1",
          "subsection_title": "Human Papillomavirus (HPV)",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "hpv_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/hpv_01.webp",
                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "hpv_subsection_2",
          "subsection_title": "What the station may say",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "hpv_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Scenario A — Counsellin"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A 27-year-old woman has tested positive for high-risk HPV. She is worried that she has cervical cancer. Counsel her."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Scenario B — Sexual health"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A woman asks how HPV is transmitted and whether a positive test means her partner has been unfaithful."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Scenario C — HPV vaccination"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A parent asks whether her 12-year-old daughter should receive the HPV vaccine. Explain the benefits, schedule and safety."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Scenario D — Clinical interpretation"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A woman has HPV 16 detected on cervical screening, but her cytology is negative. Explain the result and the next step."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Scenario E — Examination question"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Discuss the relationship between persistent high-risk HPV infection and cervical carcinogenesis."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "hpv_subsection_3",
          "subsection_title": "Definition and classification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "hpv_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Human papillomavirus is a group of DNA viruses that infect epithelial tissues, including the skin and mucous membranes."
                },
                {
                  "type": "paragraph",
                  "text": "More than 200 HPV types have been identified. They are broadly classified by their association with malignancy."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/hpv_02.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "High-risk HPV types"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Types associated with cancer include HPV 16 and 18, along with several others such as 31, 33, 45, 52 and 58."
                },
                {
                  "type": "paragraph",
                  "text": "Persistent infection can lead to cervical precancer and cancer."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/hpv_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Low-risk HPV types"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "HPV 6 and 11 are responsible for most anogenital warts."
                },
                {
                  "type": "paragraph",
                  "text": "They are not the usual causes of cervical cancer."
                }
              ]
            },
            {
              "group_id": "hpv_group_4",
              "group_title": "HPV-associated diseases",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Cervical intraepithelial neoplasia and cervical cancer."
                },
                {
                  "type": "paragraph",
                  "text": "Vulval and vaginal precancer and cancer."
                },
                {
                  "type": "paragraph",
                  "text": "Anal cancer."
                },
                {
                  "type": "paragraph",
                  "text": "Penile cancer."
                },
                {
                  "type": "paragraph",
                  "text": "Oropharyngeal cancer."
                },
                {
                  "type": "paragraph",
                  "text": "Anogenital warts."
                },
                {
                  "type": "paragraph",
                  "text": "Recurrent respiratory papillomatosis, associated particularly with HPV 6 and 11."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "hpv_subsection_4",
          "subsection_title": "Transmission and risk factors",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "hpv_group_5",
              "group_title": "A. How is HPV transmitted?",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "HPV is transmitted primarily through intimate skin-to-skin or mucosal contact."
                },
                {
                  "type": "paragraph",
                  "text": "Transmission can occur through:"
                },
                {
                  "type": "paragraph",
                  "text": "Vaginal intercourse."
                },
                {
                  "type": "paragraph",
                  "text": "Anal intercourse."
                },
                {
                  "type": "paragraph",
                  "text": "Oral sexual contact."
                },
                {
                  "type": "paragraph",
                  "text": "Genital contact without penetrative intercourse."
                },
                {
                  "type": "paragraph",
                  "text": "A person can transmit HPV without having visible warts or other symptoms."
                },
                {
                  "type": "paragraph",
                  "text": "Condoms reduce exposure but do not eliminate the risk because HPV can infect skin not covered by a condom."
                }
              ]
            },
            {
              "group_id": "hpv_group_6",
              "group_title": "B. Risk factors for persistent infection and disease",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Persistent infection with high-risk HPV."
                },
                {
                  "type": "paragraph",
                  "text": "Smoking."
                },
                {
                  "type": "paragraph",
                  "text": "HIV infection or other immunosuppression."
                },
                {
                  "type": "paragraph",
                  "text": "Lack of cervical screening."
                },
                {
                  "type": "paragraph",
                  "text": "Previous high-grade cervical lesions."
                },
                {
                  "type": "paragraph",
                  "text": "Inadequate HPV vaccination coverage."
                },
                {
                  "type": "paragraph",
                  "text": "Having multiple sexual partners may increase the chance of exposure, but HPV infection is common and can occur in people with only one lifetime partner."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE pearl: Do not use an HPV result to make assumptions about a patient's sexual behaviour, fidelity or character."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "hpv_subsection_5",
          "subsection_title": "Natural history of HPV infection",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "hpv_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Understanding the natural history helps you counsel patients correctly."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Exposure to HPV",
                    "HPV infection",
                    "Most infections"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Become undetectable through the immune response, often within 1–2 years."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Persistent high-risk infection"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "May lead to precancerous cellular changes over time."
                },
                {
                  "type": "paragraph",
                  "text": "In a minority of cases, untreated precancer progresses to invasive cancer"
                },
                {
                  "type": "paragraph",
                  "text": "Progression usually occurs over years rather than weeks. However, the rate varies, and immunosuppressed patients may be at greater risk of persistent infection and progression."
                },
                {
                  "type": "paragraph",
                  "text": "A positive HPV test cannot reliably establish when infection was acquired. HPV may remain undetectable for a period and subsequently become detectable."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "hpv_subsection_6",
          "subsection_title": "Pathogenesis: how HPV causes cervical cancer",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "hpv_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This is a common viva question."
                },
                {
                  "type": "paragraph",
                  "text": "High-risk HPV infects basal epithelial cells, often through small epithelial disruptions. Persistent infection can produce abnormal cellular proliferation."
                },
                {
                  "type": "paragraph",
                  "text": "Two important viral oncoproteins are:"
                },
                {
                  "type": "paragraph",
                  "text": "E6: promotes degradation of the tumour-suppressor protein p53."
                },
                {
                  "type": "paragraph",
                  "text": "E7: disrupts the retinoblastoma (Rb) tumour-suppressor pathway."
                },
                {
                  "type": "paragraph",
                  "text": "These actions interfere with normal cell-cycle regulation, allowing abnormal cells to survive and proliferate."
                }
              ]
            },
            {
              "group_id": "hpv_group_9",
              "group_title": "Sequence of cervical carcinogenesis",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "High-risk HPV infection."
                },
                {
                  "type": "paragraph",
                  "text": "Persistent infection in a subset of patients."
                },
                {
                  "type": "paragraph",
                  "text": "Development of cervical intraepithelial neoplasia."
                },
                {
                  "type": "paragraph",
                  "text": "Progression of some high-grade lesions if untreated."
                },
                {
                  "type": "paragraph",
                  "text": "Invasion through the basement membrane, producing invasive cervical cancer."
                },
                {
                  "type": "paragraph",
                  "text": "Not every HPV infection progresses to CIN, and not every CIN lesion progresses to cancer."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "hpv_subsection_7",
          "subsection_title": "Clinical presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "hpv_group_10",
              "group_title": "A. HPV infection without symptoms",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Most HPV infections are asymptomatic and are detected through screening."
                }
              ]
            },
            {
              "group_id": "hpv_group_11",
              "group_title": "B. Genital warts",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Typically associated with HPV 6 and 11."
                },
                {
                  "type": "paragraph",
                  "text": "Findings may include:"
                },
                {
                  "type": "paragraph",
                  "text": "Small papules or raised lesions."
                },
                {
                  "type": "paragraph",
                  "text": "Multiple exophytic, cauliflower-like growths."
                },
                {
                  "type": "paragraph",
                  "text": "Lesions on the vulva, perineum, perianal skin or other genital sites."
                },
                {
                  "type": "paragraph",
                  "text": "Itching, irritation or occasional bleeding."
                },
                {
                  "type": "paragraph",
                  "text": "The diagnosis is usually clinical. Biopsy may be needed for atypical, pigmented, ulcerated, indurated or otherwise suspicious lesions."
                }
              ]
            },
            {
              "group_id": "hpv_group_12",
              "group_title": "C. High-risk HPV-associated disease",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Persistent infection may lead to cervical, vulval, vaginal, anal, penile or oropharyngeal precancer and cancer."
                },
                {
                  "type": "paragraph",
                  "text": "Patients may have no symptoms in the precancerous stage. Symptoms depend on the anatomical site and stage of any cancer that develops."
                },
                {
                  "type": "paragraph",
                  "text": "Important: HPV positivity alone does not diagnose cancer. Screening results, clinical examination and biopsy when indicated establish the appropriate next steps."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "hpv_subsection_8",
          "subsection_title": "History taking and counselling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "hpv_group_13",
              "group_title": "A. Introduction",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Introduce yourself and confirm the patient's identity."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure privacy and confidentiality."
                },
                {
                  "type": "paragraph",
                  "text": "Ask what the patient understands about HPV."
                },
                {
                  "type": "paragraph",
                  "text": "Explore her concerns without judgement."
                },
                {
                  "type": "paragraph",
                  "text": "Obtain consent before discussing sexual history or performing any examination."
                },
                {
                  "type": "paragraph",
                  "text": "Suggested opening:"
                },
                {
                  "type": "paragraph",
                  "text": "\"HPV is a very common virus, and I understand that receiving a positive result can be worrying. I'd like to explain what the test means, what it does not mean, and what follow-up may be needed.\""
                }
              ]
            },
            {
              "group_id": "hpv_group_14",
              "group_title": "B. Focused history",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Ask about:"
                },
                {
                  "type": "paragraph",
                  "text": "The exact HPV result and whether a genotype is reported."
                },
                {
                  "type": "paragraph",
                  "text": "Cervical cytology findings."
                },
                {
                  "type": "paragraph",
                  "text": "Previous HPV tests and cervical screening results."
                },
                {
                  "type": "paragraph",
                  "text": "Previous colposcopy, cervical biopsy or treatment."
                },
                {
                  "type": "paragraph",
                  "text": "Any abnormal vaginal bleeding or persistent discharge."
                },
                {
                  "type": "paragraph",
                  "text": "HPV vaccination history."
                },
                {
                  "type": "paragraph",
                  "text": "Immunosuppression, including HIV where clinically relevant."
                },
                {
                  "type": "paragraph",
                  "text": "Smoking."
                },
                {
                  "type": "paragraph",
                  "text": "Pregnancy or fertility concerns if treatment is being considered."
                }
              ]
            },
            {
              "group_id": "hpv_group_15",
              "group_title": "C. Assess the patient's concerns",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "She may ask:"
                },
                {
                  "type": "paragraph",
                  "text": "Does this mean I have cancer?"
                },
                {
                  "type": "paragraph",
                  "text": "How did I acquire HPV?"
                },
                {
                  "type": "paragraph",
                  "text": "Has my partner been unfaithful?"
                },
                {
                  "type": "paragraph",
                  "text": "Will the infection go away?"
                },
                {
                  "type": "paragraph",
                  "text": "Can I still have children?"
                },
                {
                  "type": "paragraph",
                  "text": "Does my partner need testing?"
                },
                {
                  "type": "paragraph",
                  "text": "Can I have sex?"
                },
                {
                  "type": "paragraph",
                  "text": "Should I receive the HPV vaccine?"
                },
                {
                  "type": "paragraph",
                  "text": "Answer these questions directly, using non-stigmatising language."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "hpv_subsection_9",
          "subsection_title": "Interpreting HPV screening results",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "hpv_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Result",
                    "Interpretation and general next step"
                  ],
                  "rows": [
                    [
                      "High-risk HPV negative",
                      "Lower current risk of HPV-related cervical disease; return to the recommended screening interval unless other factors require assessment"
                    ],
                    [
                      "High-risk HPV positive, cytology negative",
                      "HPV detected without cytological abnormality; manage according to genotype, screening history and programme"
                    ],
                    [
                      "HPV 16 or 18 positive",
                      "Higher-risk genotype; commonly prompts colposcopy even when cytology is negative, according to the applicable guideline"
                    ],
                    [
                      "Other high-risk HPV positive with abnormal cytology",
                      "Risk-based triage, often including colposcopy"
                    ],
                    [
                      "Persistent high-risk HPV",
                      "Requires appropriate follow-up because persistence increases the risk of significant precancer"
                    ],
                    [
                      "Suspicious cervical lesion or symptoms",
                      "Diagnostic assessment regardless of the screening result"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The precise pathway varies by screening programme. A positive result is not itself an indication for chemotherapy, hysterectomy or treatment of the cervix without appropriate assessment."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "hpv_subsection_10",
          "subsection_title": "HPV vaccination",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "hpv_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/hpv_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "HPV vaccines prevent infection with important HPV types before exposure. They are prophylactic vaccines: they prevent new infections but do not eradicate an established infection or treat existing precancer or cancer."
                }
              ]
            },
            {
              "group_id": "hpv_group_18",
              "group_title": "A. Gardasil 9",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The 9-valent vaccine covers:"
                },
                {
                  "type": "paragraph",
                  "text": "HPV 6 and 11, which cause most genital warts."
                },
                {
                  "type": "paragraph",
                  "text": "HPV 16 and 18."
                },
                {
                  "type": "paragraph",
                  "text": "HPV 31, 33, 45, 52 and 58."
                },
                {
                  "type": "paragraph",
                  "text": "Other HPV vaccines may cover fewer types."
                }
              ]
            },
            {
              "group_id": "hpv_group_19",
              "group_title": "B. Who should receive the vaccine?",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The primary target is children and adolescents before sexual exposure. Catch-up vaccination may be offered to older adolescents and adults according to national recommendations."
                },
                {
                  "type": "paragraph",
                  "text": "The WHO supports one- or two-dose schedules for girls aged 9–14 years, two doses for girls and women aged 15–20 years, and two doses six months apart for women older than 21 years; immunocompromised individuals, including those living with HIV, should receive at least two doses and, where possible, three."
                },
                {
                  "type": "paragraph",
                  "text": "National schedules may differ, so follow the current immunisation programme and product-specific guidance."
                }
              ]
            },
            {
              "group_id": "hpv_group_20",
              "group_title": "C. Contraindications and precautions",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Severe allergic reaction to a previous dose or vaccine component is a contraindication."
                },
                {
                  "type": "paragraph",
                  "text": "Moderate or severe acute illness may justify postponement."
                },
                {
                  "type": "paragraph",
                  "text": "HPV vaccination is generally deferred during pregnancy, with remaining doses given after pregnancy."
                },
                {
                  "type": "paragraph",
                  "text": "Immunocompromised individuals may have a reduced immune response but should generally still be vaccinated when eligible."
                },
                {
                  "type": "paragraph",
                  "text": "Common adverse effects include injection-site pain, redness or swelling, headache and mild fever. Syncope can occur after vaccination, so recipients should be seated or observed according to local guidance."
                }
              ]
            },
            {
              "group_id": "hpv_group_21",
              "group_title": "D. Does vaccination eliminate the need for screening?",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "No. Vaccines do not cover every oncogenic HPV type, and vaccination does not treat infections acquired before vaccination. Eligible women should continue cervical screening according to their national programme."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "hpv_subsection_11",
          "subsection_title": "Management of HPV infection",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "hpv_group_22",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "There is no routine antiviral treatment that reliably eradicates asymptomatic HPV infection."
                },
                {
                  "type": "paragraph",
                  "text": "Management focuses on preventing complications and treating clinically significant disease."
                }
              ]
            },
            {
              "group_id": "hpv_group_23",
              "group_title": "A. Asymptomatic high-risk HPV",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Explain the result and its limitations."
                },
                {
                  "type": "paragraph",
                  "text": "Review cytology, genotype and previous screening history."
                },
                {
                  "type": "paragraph",
                  "text": "Arrange repeat testing or colposcopy according to the applicable guideline."
                },
                {
                  "type": "paragraph",
                  "text": "Encourage attendance for follow-up."
                },
                {
                  "type": "paragraph",
                  "text": "Discuss HPV vaccination if eligible."
                }
              ]
            },
            {
              "group_id": "hpv_group_24",
              "group_title": "B. Genital warts",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Treatment options may include:"
                },
                {
                  "type": "paragraph",
                  "text": "Patient-applied topical therapies, such as imiquimod or podophyllotoxin, where appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Clinician-administered cryotherapy."
                },
                {
                  "type": "paragraph",
                  "text": "Trichloroacetic acid."
                },
                {
                  "type": "paragraph",
                  "text": "Surgical removal, electrosurgery or laser treatment in selected cases."
                },
                {
                  "type": "paragraph",
                  "text": "Choice depends on pregnancy status, lesion site, size, patient preference and local availability. Some treatments are unsuitable during pregnancy."
                },
                {
                  "type": "paragraph",
                  "text": "Treatment removes visible warts but may not eliminate HPV from surrounding skin, so recurrence is possible."
                }
              ]
            },
            {
              "group_id": "hpv_group_25",
              "group_title": "C. Cervical precancer",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Management depends on the degree of abnormality and may involve surveillance, colposcopy, biopsy and treatment such as LLETZ/LEEP or cone biopsy."
                }
              ]
            },
            {
              "group_id": "hpv_group_26",
              "group_title": "D. HPV-associated cancer",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Treatment depends on the anatomical site, histology, stage and patient factors. It may include surgery, radiotherapy, systemic therapy or a combination."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "hpv_subsection_12",
          "subsection_title": "Counselling scenarios: model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "hpv_group_27",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Question 1: \"Does HPV mean I have cervical cancer?\""
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "\"No. HPV is a common virus, and a positive test does not mean you have cancer. Many infections become undetectable naturally. We need to follow your result through the recommended screening pathway to determine whether any cell changes are present.\""
                },
                {
                  "type": "checklist",
                  "items": [
                    "Question 2: \"Does this mean my partner cheated on me?\""
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "\"No. HPV can remain undetected for months or years. A test cannot tell us when the infection was acquired or who transmitted it, so the result is not proof of infidelity.\""
                },
                {
                  "type": "checklist",
                  "items": [
                    "Question 3: \"Can I still have sex?\""
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "\"An HPV-positive result does not automatically mean you must stop having sex. You can discuss barrier protection, transmission and any specific advice related to visible genital lesions or treatment. Condoms reduce but do not eliminate HPV transmission.\""
                },
                {
                  "type": "checklist",
                  "items": [
                    "Question 4: \"Should my partner be tested?\""
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "\"There is no routine screening test recommended for every asymptomatic male partner for genital HPV. If your partner has lesions or symptoms, they should seek clinical assessment. Other sexually transmitted infection testing may be appropriate based on individual risk.\""
                },
                {
                  "type": "checklist",
                  "items": [
                    "Question 5: \"Will the vaccine cure my HPV?\""
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "\"The vaccine prevents new infections with the HPV types it covers, but it does not clear an infection that is already present. You still need the follow-up recommended for your current result.\""
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "hpv_subsection_13",
          "subsection_title": "Common examiner questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "hpv_group_28",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. Which HPV types are most strongly associated with cervical cancer?"
                },
                {
                  "type": "paragraph",
                  "text": "HPV 16 and 18 are particularly important high-risk types, although several other oncogenic types also cause cervical cancer."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Which HPV types cause most genital warts?"
                },
                {
                  "type": "paragraph",
                  "text": "HPV 6 and 11."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What do the E6 and E7 proteins do?"
                },
                {
                  "type": "paragraph",
                  "text": "E6 promotes degradation of p53, while E7 disrupts the Rb tumour-suppressor pathway. Both interfere with normal cell-cycle control."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Can HPV be transmitted without penetrative intercourse?"
                },
                {
                  "type": "paragraph",
                  "text": "Yes. Genital skin-to-skin contact and oral sexual contact can transmit HPV."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. Can a woman acquire HPV from a partner despite using condoms?"
                },
                {
                  "type": "paragraph",
                  "text": "Yes. Condoms reduce exposure but do not cover all potentially infected skin."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Does a negative HPV test mean the patient will never develop cervical cancer?"
                },
                {
                  "type": "paragraph",
                  "text": "No. It indicates a low current risk of HPV-related cervical disease but does not eliminate all future risk or replace symptom-based assessment."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. Is HPV vaccination therapeutic?"
                },
                {
                  "type": "paragraph",
                  "text": "No. It is prophylactic and prevents new infections with the HPV types covered by the vaccine."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. Does every woman with persistent HPV need a cervical excision?"
                },
                {
                  "type": "paragraph",
                  "text": "No. Management depends on cytology, genotype, histology where available, screening history and the relevant guideline. Some women need surveillance, while others need colposcopy or treatment."
                },
                {
                  "type": "paragraph",
                  "text": "Q9. Can HPV cause cancer in men?"
                },
                {
                  "type": "paragraph",
                  "text": "Yes. HPV is associated with penile, anal and oropharyngeal cancers, among other diseases."
                },
                {
                  "type": "paragraph",
                  "text": "Q10. Why is screening important even after HPV vaccination?"
                },
                {
                  "type": "paragraph",
                  "text": "Vaccination does not cover every oncogenic HPV type and may occur after exposure. Screening remains important for eligible women."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "hpv_subsection_14",
          "subsection_title": "Common OSCE mistakes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "hpv_group_29",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Telling the patient that HPV positivity means cancer."
                },
                {
                  "type": "paragraph",
                  "text": "Implying that a positive result proves infidelity."
                },
                {
                  "type": "paragraph",
                  "text": "Confusing high-risk HPV types with the types that cause most genital warts."
                },
                {
                  "type": "paragraph",
                  "text": "Claiming that condoms completely prevent transmission."
                },
                {
                  "type": "paragraph",
                  "text": "Describing HPV vaccination as a treatment for an established infection."
                },
                {
                  "type": "paragraph",
                  "text": "Forgetting that persistent infection is more concerning than a single positive result."
                },
                {
                  "type": "paragraph",
                  "text": "Failing to explain follow-up based on genotype and cytology."
                },
                {
                  "type": "paragraph",
                  "text": "Assuming asymptomatic male partners require routine HPV testing."
                },
                {
                  "type": "paragraph",
                  "text": "Forgetting that vaccinated women still need screening."
                },
                {
                  "type": "paragraph",
                  "text": "Ignoring symptoms that require diagnostic assessment independently of screening results."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "hpv_subsection_15",
          "subsection_title": "Mnemonics and rapid revision",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "hpv_group_30",
              "group_title": "High-risk versus low-risk: 16/18 = Cancer; 6/11 = Warts",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "HPV 16 and 18: major oncogenic types."
                },
                {
                  "type": "paragraph",
                  "text": "HPV 6 and 11: responsible for most genital warts."
                }
              ]
            },
            {
              "group_id": "hpv_group_31",
              "group_title": "HPV counselling: VIRUS",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "V — Very common infection."
                },
                {
                  "type": "paragraph",
                  "text": "I — Infection often becomes undetectable spontaneously."
                },
                {
                  "type": "paragraph",
                  "text": "R — Risk increases with persistent high-risk infection."
                },
                {
                  "type": "paragraph",
                  "text": "U — Understand that a positive result does not prove cancer or infidelity."
                },
                {
                  "type": "paragraph",
                  "text": "S — Screening, vaccination and follow-up reduce harm."
                }
              ]
            },
            {
              "group_id": "hpv_group_32",
              "group_title": "Five exam facts",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "HPV is a DNA virus transmitted mainly through intimate skin-to-skin or mucosal contact."
                },
                {
                  "type": "paragraph",
                  "text": "Persistent high-risk HPV is the principal cause of cervical cancer."
                },
                {
                  "type": "paragraph",
                  "text": "Most infections become undetectable spontaneously."
                },
                {
                  "type": "paragraph",
                  "text": "Vaccination prevents new infections but does not treat existing HPV."
                },
                {
                  "type": "paragraph",
                  "text": "An HPV-positive result must be managed according to the patient's screening history, genotype and cytology."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "hpv_subsection_16",
          "subsection_title": "Mini OSCE practice",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "hpv_group_33",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Exam practice"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A 29-year-old woman tests positive for HPV 16 during cervical screening. Her cytology is negative for intraepithelial lesion or malignancy. She asks whether she has cancer."
                },
                {
                  "type": "paragraph",
                  "text": "Which is the best response?"
                },
                {
                  "type": "paragraph",
                  "text": "She definitely has invasive cervical cancer."
                },
                {
                  "type": "paragraph",
                  "text": "The result is irrelevant because her cytology is negative."
                },
                {
                  "type": "paragraph",
                  "text": "HPV 16 is a high-risk type; the result does not prove cancer, but requires management according to the appropriate pathway, commonly including colposcopy."
                },
                {
                  "type": "paragraph",
                  "text": "She should immediately undergo hysterectomy."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}