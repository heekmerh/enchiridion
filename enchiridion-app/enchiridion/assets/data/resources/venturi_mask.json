  "sections": [
    {
      "section_id": "venturi_mask_section_1",
      "section_title": "Venturi mask",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "venturi_mask_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "venturi_mask_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The goal of this station is to identify the Venturi mask, explain how it delivers a controlled oxygen concentration, identify the colour-coded adapters, demonstrate correct application, and explain why it is particularly useful in patients at risk of hypercapnic respiratory failure."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "venturi_mask_subsection_2",
          "subsection_title": "Identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "venturi_mask_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/venturi_mask_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Name: Venturi mask (air-entrainment mask)."
                },
                {
                  "type": "paragraph",
                  "text": "Classification: Fixed-performance oxygen delivery device, provided it is operated at the manufacturer's specified settings."
                },
                {
                  "type": "paragraph",
                  "text": "Principle: Oxygen passes through a narrow jet, entraining a controlled amount of room air through side openings. This dilutes the oxygen to produce a specified oxygen concentration."
                },
                {
                  "type": "paragraph",
                  "text": "Typical adult oxygen concentrations: Commonly 24%, 28%, 31%, 35%, 40%, or 60%, depending on the device design. Not every Venturi system offers every concentration."
                },
                {
                  "type": "paragraph",
                  "text": "Examiner's expected answer:"
                },
                {
                  "type": "paragraph",
                  "text": "\"This is a Venturi mask. It is an air-entrainment oxygen delivery device that uses the Venturi principle to deliver a relatively controlled inspired oxygen concentration. It is particularly useful when accurate oxygen titration is important, such as in patients at risk of hypercapnic respiratory failure.\""
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "venturi_mask_subsection_3",
          "subsection_title": "Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "venturi_mask_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Clinical situation",
                    "Purpose"
                  ],
                  "rows": [
                    [
                      "COPD with risk of hypercapnia",
                      "Allows controlled oxygen delivery to a prescribed target saturation."
                    ],
                    [
                      "Hypercapnic respiratory failure risk",
                      "Helps avoid unnecessary exposure to excessive oxygen while correcting hypoxaemia."
                    ],
                    [
                      "Patients requiring a specified FiO₂",
                      "Provides a more predictable oxygen concentration than conventional low-flow devices."
                    ],
                    [
                      "Acute respiratory illness",
                      "Supports oxygenation when a controlled concentration is clinically appropriate."
                    ],
                    [
                      "Oxygen titration in monitored care",
                      "Allows selection of a specified oxygen concentration using the appropriate adapter."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "High-yield clinical point: In patients with COPD or another risk factor for hypercapnic respiratory failure, an initial target SpO₂ of 88–92% is commonly used pending blood gas results, unless an individualised target is indicated. Oxygen must still be given promptly to patients who are hypoxaemic."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "venturi_mask_subsection_4",
          "subsection_title": "Parts and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "venturi_mask_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/venturi_mask_01.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "A. Face mask"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Covers the nose and mouth and directs the oxygen–air mixture toward the patient's airway."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/venturi_mask_02.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Colour-coded Venturi adapter"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Contains a calibrated jet and air-entrainment openings. The selected adapter specifies the intended oxygen concentration and required driving oxygen flow."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/venturi_mask_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "C. Air-entrainment ports"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Allow room air to enter and mix with oxygen. These openings must remain unobstructed."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/venturi_mask_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "D. Oxygen tubing"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Carries oxygen from the source to the Venturi adapter."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/venturi_mask_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "E. Oxygen source and flowmeter"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Supply and regulate the driving oxygen flow specified for the selected adapter."
                },
                {
                  "type": "paragraph",
                  "text": "Other components may include an elastic strap, adjustable nose clip, and connector tubing."
                },
                {
                  "type": "paragraph",
                  "text": "Examiner's favourite question: Why must the side openings remain unobstructed?"
                },
                {
                  "type": "paragraph",
                  "text": "Because the mask depends on entrainment of room air through these openings. Obstruction can alter the delivered oxygen concentration and compromise performance."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "venturi_mask_subsection_5",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "venturi_mask_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Provides a more predictable oxygen concentration than a conventional nasal cannula or simple face mask."
                },
                {
                  "type": "paragraph",
                  "text": "Allows controlled oxygen titration."
                },
                {
                  "type": "paragraph",
                  "text": "Particularly useful for patients at risk of oxygen-associated hypercapnia."
                },
                {
                  "type": "paragraph",
                  "text": "Different adapters allow selection of different oxygen concentrations."
                },
                {
                  "type": "paragraph",
                  "text": "Does not require an airtight facial seal."
                },
                {
                  "type": "paragraph",
                  "text": "Allows spontaneous breathing without providing invasive ventilatory support."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "venturi_mask_subsection_6",
          "subsection_title": "Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "venturi_mask_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Requires the correct adapter and driving oxygen flow."
                },
                {
                  "type": "paragraph",
                  "text": "The delivered concentration can be affected by incorrect assembly or obstruction of air-entrainment ports."
                },
                {
                  "type": "paragraph",
                  "text": "Some systems require relatively high driving oxygen flows, especially at higher respiratory rates."
                },
                {
                  "type": "paragraph",
                  "text": "The mask can interfere with eating, drinking, and speaking."
                },
                {
                  "type": "paragraph",
                  "text": "It may cause discomfort, claustrophobia, or pressure injury."
                },
                {
                  "type": "paragraph",
                  "text": "It does not provide adequate ventilatory support for apnoea or severe ventilatory failure."
                },
                {
                  "type": "paragraph",
                  "text": "It may not meet the oxygen requirements of a patient with severe hypoxaemia or very high inspiratory demand."
                },
                {
                  "type": "paragraph",
                  "text": "Important distinction: A Venturi mask controls the intended oxygen concentration; it does not guarantee adequate oxygenation in every patient. Always assess the clinical response."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "venturi_mask_subsection_7",
          "subsection_title": "Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "venturi_mask_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Before applying the mask:"
                },
                {
                  "type": "paragraph",
                  "text": "Perform hand hygiene and explain the procedure."
                },
                {
                  "type": "paragraph",
                  "text": "Assess respiratory rate, work of breathing, consciousness, and SpO₂."
                },
                {
                  "type": "paragraph",
                  "text": "Establish the prescribed oxygen target."
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the mask, adapter, tubing, flowmeter, and oxygen source."
                },
                {
                  "type": "paragraph",
                  "text": "Select the adapter corresponding to the prescribed FiO₂."
                },
                {
                  "type": "paragraph",
                  "text": "Set the driving oxygen flow specified on the adapter or by the manufacturer."
                },
                {
                  "type": "paragraph",
                  "text": "Check that the air-entrainment ports are unobstructed."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure the mask is correctly positioned and secured."
                },
                {
                  "type": "paragraph",
                  "text": "Reassess oxygen saturation and clinical response after application."
                },
                {
                  "type": "paragraph",
                  "text": "Do not assume that all colour-coded Venturi adapters have the same oxygen concentrations or flow requirements across manufacturers."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "venturi_mask_subsection_8",
          "subsection_title": "How to use it — step-by-step OSCE demonstration",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "venturi_mask_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Step 1: Assess the patient"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Introduce yourself, confirm identity, explain the procedure, and assess oxygenation and respiratory distress."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/venturi_mask_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 2: Select the adapter"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Choose the adapter that provides the prescribed oxygen concentration. Check its label rather than relying on colour alone."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 3: Connect the oxygen supply"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Attach the tubing to the correct adapter and connect it to the oxygen source."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/venturi_mask_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 4: Set the driving flow"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Set the flow rate specified by the manufacturer for that adapter. Do not use an arbitrary flow setting."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 5: Apply the mask"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Position the mask over the nose and mouth, secure the strap comfortably, and adjust the nose clip."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/venturi_mask_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 6: Check the system"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Ensure that the ports are not covered by bedding, clothing, or other objects and that the tubing is not kinked."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 7: Monitor and document"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Reassess SpO₂, respiratory effort, mental state, and response to treatment. Record the selected adapter, oxygen flow, target saturation, and findings."
                }
              ]
            },
            {
              "group_id": "venturi_mask_group_9",
              "group_title": "What to say during the OSCE",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "\"I would assess the patient, select the adapter corresponding to the prescribed FiO₂, set the specified driving oxygen flow, apply the mask, ensure the entrainment ports remain unobstructed, and monitor oxygen saturation and clinical response.\""
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "venturi_mask_subsection_9",
          "subsection_title": "Contraindications and complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "venturi_mask_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "There is no general absolute contraindication to oxygen therapy when indicated. However, a Venturi mask may be inadequate if the patient needs urgent ventilatory support or a higher level of oxygen delivery."
                }
              ]
            },
            {
              "group_id": "venturi_mask_group_11",
              "group_title": "Potential complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Prevention or response"
                  ],
                  "rows": [
                    [
                      "Persistent hypoxaemia",
                      "Reassess the patient, verify the system, and escalate respiratory support."
                    ],
                    [
                      "Incorrect FiO₂",
                      "Confirm the adapter, flow setting, and unobstructed entrainment ports."
                    ],
                    [
                      "Hypercapnia",
                      "Use the prescribed target and obtain blood gases when indicated."
                    ],
                    [
                      "Nasal bridge or facial pressure injury",
                      "Check fit and inspect the skin regularly."
                    ],
                    [
                      "Anxiety or discomfort",
                      "Explain the procedure and assess alternative interfaces when appropriate."
                    ],
                    [
                      "Delayed escalation",
                      "Recognise deterioration and obtain urgent help."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Clinical warning: Increasing oxygen concentration alone will not correct inadequate ventilation. A drowsy patient with rising CO₂ may require ventilatory support, such as non-invasive ventilation or invasive ventilation, depending on the clinical situation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "venturi_mask_subsection_10",
          "subsection_title": "Normal and abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "venturi_mask_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Finding",
                    "Interpretation"
                  ],
                  "rows": [
                    [
                      "SpO₂ reaches the prescribed target",
                      "Oxygenation is responding appropriately."
                    ],
                    [
                      "SpO₂ remains below target",
                      "Reassess equipment, the patient's condition, and the need for escalation."
                    ],
                    [
                      "Reduced respiratory distress",
                      "May indicate improvement."
                    ],
                    [
                      "Increasing respiratory rate or accessory muscle use",
                      "Persistent or worsening respiratory distress."
                    ],
                    [
                      "New confusion, drowsiness, or headache",
                      "May indicate hypercapnia, hypoxaemia, or another cause of deterioration."
                    ],
                    [
                      "Reduced consciousness or respiratory exhaustion",
                      "Emergency warning signs requiring immediate assessment."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A normal SpO₂ does not exclude hypercapnia. In patients at risk of CO₂ retention, blood gas analysis may be necessary to assess PaCO₂ and pH."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "venturi_mask_subsection_11",
          "subsection_title": "Pediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "venturi_mask_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Select an appropriately sized mask for the child's face."
                },
                {
                  "type": "paragraph",
                  "text": "Follow pediatric oxygen protocols for the prescribed FiO₂ and target saturation."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure the child tolerates the mask and that the ports remain unobstructed."
                },
                {
                  "type": "paragraph",
                  "text": "Monitor respiratory rate, effort, SpO₂, and mental status."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid delaying escalation in a child with severe distress or persistent hypoxaemia."
                },
                {
                  "type": "paragraph",
                  "text": "In neonates requiring resuscitation, use appropriate neonatal resuscitation equipment rather than relying on a Venturi mask."
                },
                {
                  "type": "paragraph",
                  "text": "A Venturi mask is not automatically the best device for every child requiring controlled oxygen. Device choice depends on the child's age, respiratory condition, required oxygen concentration, and ability to tolerate the interface."
                }
              ]
            }
          ]
        },
        {
