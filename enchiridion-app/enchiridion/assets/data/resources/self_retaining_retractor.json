                {
                  "type": "table",
                  "columns": [
                    "Type",
                    "Distinguishing feature",
                    "Common application"
                  ],
                  "rows": [
                    [
                      "Weitlaner",
                      "Usually has multiple prongs, commonly blunt or sharp",
                      "Superficial to moderately deep soft-tissue retraction"
                    ],
                    [
                      "Gelpi",
                      "Typically has a single prominent pointed prong on each arm",
                      "Focused retraction in relatively small operative fields"
                    ],
                    [
                      "Balfour",
                      "Adjustable lateral blades, often with a central blade",
                      "Open abdominal surgery"
                    ],
                    [
                      "Bookwalter",
                      "Frame-supported system with adjustable blades",
                      "Major abdominal and pelvic surgery"
                    ],
                    [
                      "Finochietto",
                      "Ratcheted spreading mechanism with curved blades",
                      "Thoracic surgery, especially rib spreading"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Exam trap: A Finochietto retractor is a self-retaining thoracic retractor, but it is specifically designed for spreading ribs. Do not confuse it with general-purpose soft-tissue retractors."
                }
              ]
            }
