      "section_id": "self_retaining_retractor_section_1",
      "section_title": "Self-retaining retractor",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "self_retaining_retractor_subsection_1",
          "subsection_title": "1. Introduction and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "self_retaining_retractor_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/self_retaining_retractor_01.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/self_retaining_retractor_02.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/self_retaining_retractor_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A self-retaining retractor is a surgical instrument designed to hold tissues apart and maintain exposure of an operative field without requiring continuous manual holding. It usually achieves this through a ratchet, locking mechanism, screw or adjustable frame."
                },
                {
                  "type": "paragraph",
                  "text": "Unlike a handheld retractor, which must be held by the surgeon or an assistant, a self-retaining retractor remains in its selected position once properly applied and locked."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“This is a self-retaining surgical retractor. It is used to maintain separation of tissues and provide sustained exposure of the operative field. It incorporates a locking or adjustment mechanism that allows it to remain in position without continuous manual support.”",
                  "style": "quote"
                }
              ]
            },
            {
              "group_id": "self_retaining_retractor_group_2",
              "group_title": "Identification card",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Instrument class"
                },
                {
                  "type": "paragraph",
                  "text": "Surgical retractor"
                },
                {
                  "type": "paragraph",
                  "text": "Retraction type"
                },
                {
                  "type": "paragraph",
                  "text": "Self-retaining"
                },
                {
                  "type": "paragraph",
                  "text": "Key feature"
                },
                {
                  "type": "paragraph",
                  "text": "Locking or adjustable mechanism"
                },
                {
                  "type": "paragraph",
                  "text": "Main purpose"
                },
                {
                  "type": "paragraph",
                  "text": "Maintains exposure while freeing the assistant's hands"
                },
