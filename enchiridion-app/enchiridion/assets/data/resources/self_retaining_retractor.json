        {
          "subsection_id": "self_retaining_retractor_subsection_11",
          "subsection_title": "11. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "self_retaining_retractor_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a self-retaining surgical retractor. It is used to maintain separation of tissues and provide sustained exposure of the operative field without continuous manual holding. Examples include the Weitlaner, Gelpi, Balfour and Bookwalter retractors. Its main advantage is that it frees the assistant's hands. Potential complications include tissue trauma, vascular compression and ischaemia from excessive or prolonged retraction. Before use, I would inspect the instrument and its locking mechanism, select the appropriate size, apply controlled tension and ensure careful release after use.”",
                  "style": "quote"
                }
              ]
            }
          ]
