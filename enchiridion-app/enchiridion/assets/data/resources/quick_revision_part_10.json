      "section_id": "quick_revision_part_10_section_1",
      "section_title": "Part 10: Drugs",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "quick_revision_part_10_subsection_1",
          "subsection_title": "1. Investigations Before Starting Anti-Tuberculosis Drugs",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_10_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Baseline investigations"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Clinical assessment and TB symptom review",
                      "level": 0
                    },
                    {
                      "text": "Sputum Xpert MTB/RIF Ultra or another WHO-recommended rapid molecular test",
                      "level": 0
                    },
                    {
                      "text": "Sputum smear microscopy for acid-fast bacilli, where indicated",
                      "level": 0
                    },
                    {
                      "text": "Mycobacterial culture and drug-susceptibility testing, as indicated",
                      "level": 0
                    },
                    {
                      "text": "Chest X-ray for pulmonary TB assessment",
                      "level": 0
                    },
                    {
                      "text": "HIV test and counselling",
                      "level": 0
                    },
                    {
                      "text": "FBC",
                      "level": 0
                    },
                    {
                      "text": "Liver function tests: ALT, AST, bilirubin",
                      "level": 0
                    },
                    {
                      "text": "Renal function: urea, creatinine, eGFR",
                      "level": 0
                    },
                    {
                      "text": "Baseline visual acuity and colour vision before ethambutol when feasible",
                      "level": 0
                    },
                    {
                      "text": "Pregnancy test where relevant",
                      "level": 0
                    },
                    {
                      "text": "Hepatitis B/C testing where risk factors or clinical indications exist",
                      "level": 0
                    },
                    {
                      "text": "Blood glucose or HbA1c, particularly in patients at risk of diabetes",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Additional investigations according to presentation"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Lymph node aspirate/biopsy for suspected extrapulmonary TB",
                      "level": 0
                    },
                    {
                      "text": "CSF studies and neuroimaging for suspected TB meningitis",
                      "level": 0
                    },
                    {
                      "text": "Pleural fluid studies for suspected pleural TB",
                      "level": 0
                    },
                    {
                      "text": "Abdominal ultrasound or CT for suspected abdominal TB",
                      "level": 0
                    },
                    {
                      "text": "ECG when QT-prolonging drugs or cardiac risk factors are relevant",
                      "level": 0
                    },
                    {
                      "text": "Hearing assessment when injectable aminoglycosides are used",
                      "level": 0
                    },
                    {
                      "text": "Drug-resistance testing when rifampicin resistance or treatment failure is suspected",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Before and during treatment"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Review drug interactions, especially with antiretroviral therapy",
                      "level": 0
                    },
                    {
                      "text": "Review alcohol use and hepatotoxicity risk",
                      "level": 0
                    },
                    {
                      "text": "Assess previous TB treatment and drug resistance risk",
                      "level": 0
                    },
                    {
                      "text": "Educate on adherence and adverse effects",
                      "level": 0
                    },
                    {
                      "text": "Monitor symptoms, sputum conversion and treatment response",
                      "level": 0
                    },
                    {
                      "text": "Repeat liver or renal tests when indicated by symptoms, risk factors or regimen",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_10_subsection_2",
          "subsection_title": "2. HIV Antiretroviral Therapy: First, Second and Third Line",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_10_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Line",
                    "Regimens",
                    "Important adverse effects"
                  ],
                  "rows": [
                    [
                      "First-line",
                      "TDF + 3TC + DTG (TLD)",
                      "TDF: renal toxicity, reduced bone mineral density; 3TC: headache, rare pancreatitis; DTG: insomnia, headache, weight gain"
                    ],
                    [
                      "Alternative first-line",
                      "TAF + 3TC + DTG; ABC + 3TC + DTG in selected patients",
                      "TAF: weight gain, lipid changes; ABC: hypersensitivity reaction, HLA-B*57:01 association"
                    ],
                    [
                      "Second-line",
                      "Optimised NRTI backbone + boosted darunavir (DRV/r or DRV/c), or an appropriate boosted PI-based regimen; DTG-based options depend on prior regimen and resistance",
                      "Darunavir: GI upset, rash, hepatotoxicity; ritonavir/cobicistat: drug interactions, dyslipidaemia"
                    ],
                    [
                      "Third-line / salvage",
                      "Resistance-guided combinations: DRV/r, DTG, and/or other fully active agents such as fostemsavir, ibalizumab, maraviroc or enfuvirtide, depending on resistance and availability",
                      "Enfuvirtide: injection-site reactions; maraviroc: hepatotoxicity, postural hypotension; fostemsavir: nausea, QT prolongation risk; ibalizumab: diarrhoea, rash"
                    ]
                  ]
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Common ART adverse effects: nausea, diarrhoea, headache, rash, sleep disturbances, metabolic abnormalities.",
                      "level": 0
                    },
                    {
                      "text": "Nevirapine: hepatotoxicity, severe rash/Stevens–Johnson syndrome.",
                      "level": 0
                    },
                    {
                      "text": "Efavirenz: vivid dreams, dizziness, neuropsychiatric effects.",
                      "level": 0
                    },
                    {
                      "text": "Zidovudine: anaemia, neutropenia, myopathy.",
                      "level": 0
                    },
                    {
                      "text": "Abacavir: potentially fatal hypersensitivity reaction.",
                      "level": 0
                    },
                    {
                      "text": "Tenofovir disoproxil fumarate: proximal renal tubulopathy, Fanconi syndrome, osteomalacia.",
                      "level": 0
                    },
                    {
                      "text": "Protease inhibitors: dyslipidaemia, insulin resistance, drug interactions.",
                      "level": 0
                    },
                    {
                      "text": "Nevirapine, efavirenz and zidovudine: older regimens; use depends on current national guidelines and clinical circumstances.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_10_subsection_3",
          "subsection_title": "3. Aspirin — Conditions in Which It Is Used",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_10_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Antiplatelet indications"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Acute coronary syndrome (ACS)",
                      "level": 0
                    },
                    {
                      "text": "Acute myocardial infarction",
                      "level": 0
                    },
                    {
                      "text": "Secondary prevention after myocardial infarction",
                      "level": 0
                    },
                    {
                      "text": "Secondary prevention after non-cardioembolic ischaemic stroke or TIA",
                      "level": 0
                    },
                    {
                      "text": "Established coronary artery disease",
                      "level": 0
                    },
                    {
                      "text": "After selected coronary interventions/stenting, usually as part of a defined antiplatelet regimen",
                      "level": 0
                    },
                    {
                      "text": "Symptomatic peripheral arterial disease",
                      "level": 0
                    },
                    {
                      "text": "Selected patients after coronary artery bypass grafting",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Other indications"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Kawasaki disease",
                      "level": 0
                    },
                    {
                      "text": "Selected pregnancy patients for pre-eclampsia prevention, under obstetric guidance",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Not routinely indicated"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Primary prevention in most adults without established cardiovascular disease",
                      "level": 0
                    },
                    {
                      "text": "Atrial fibrillation as a substitute for anticoagulation",
                      "level": 0
                    },
                    {
                      "text": "Haemorrhagic stroke",
                      "level": 0
                    },
                    {
                      "text": "Active significant bleeding",
                      "level": 0
                    },
                    {
                      "text": "Aspirin allergy or aspirin-exacerbated respiratory disease",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Cautions"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Peptic ulcer disease or GI bleeding",
                      "level": 0
                    },
                    {
                      "text": "Thrombocytopenia",
                      "level": 0
                    },
                    {
                      "text": "Bleeding disorders",
                      "level": 0
                    },
                    {
                      "text": "Severe renal impairment",
                      "level": 0
                    },
                    {
                      "text": "Children with viral illnesses (Reye syndrome risk)",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_10_subsection_4",
          "subsection_title": "4. Uses of Calcium Gluconate",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_10_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Acute symptomatic hypocalcaemia",
                      "level": 0
                    },
                    {
                      "text": "Hypocalcaemic tetany",
                      "level": 0
                    },
                    {
                      "text": "Hypocalcaemic seizures",
                      "level": 0
                    },
                    {
                      "text": "Calcium replacement in selected cases of severe hypocalcaemia",
                      "level": 0
                    },
                    {
                      "text": "Cardiac membrane stabilisation in severe hyperkalaemia with ECG changes",
                      "level": 0
                    },
                    {
                      "text": "Calcium-channel blocker toxicity, as an adjunct",
                      "level": 0
                    },
                    {
                      "text": "Hypermagnesaemia with cardiac or neuromuscular toxicity",
                      "level": 0
                    },
                    {
                      "text": "Hydrofluoric acid exposure — systemic calcium replacement and selected local treatments under specialist protocols",
                      "level": 0
                    },
                    {
                      "text": "Calcium replacement during massive transfusion when clinically indicated",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important precautions"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Does not lower serum potassium in hyperkalaemia",
                      "level": 0
                    },
                    {
                      "text": "ECG monitoring for IV administration in emergencies",
                      "level": 0
                    },
                    {
                      "text": "Avoid extravasation; tissue injury may occur",
                      "level": 0
                    },
                    {
                      "text": "Use caution in patients taking digoxin",
                      "level": 0
                    },
                    {
                      "text": "Do not mix with bicarbonate- or phosphate-containing solutions",
                      "level": 0
                    },
                    {
                      "text": "In neonates, avoid simultaneous administration with ceftriaxone due to precipitation risk",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "**5. Drugs Used in Nebulisers**"
                },
                {
                  "type": "table",
                  "columns": [
                    "Drug",
                    "Main uses"
                  ],
                  "rows": [
                    [
                      "Salbutamol",
                      "Acute asthma, bronchospasm, COPD exacerbation"
                    ],
                    [
                      "Ipratropium bromide",
                      "COPD exacerbation; adjunct in severe acute asthma"
                    ],
                    [
                      "Budesonide",
                      "Selected asthma/croup protocols; inhaled anti-inflammatory treatment"
                    ],
                    [
                      "Adrenaline (epinephrine)",
                      "Croup with significant upper airway obstruction"
                    ],
                    [
                      "Hypertonic saline",
                      "Selected cases of bronchiolitis or mucus clearance protocols"
                    ],
                    [
                      "Normal saline 0.9%",
                      "Diluent; selected humidification or secretion-management protocols"
                    ],
                    [
                      "Acetylcysteine",
                      "Selected cases of thick secretions; may cause bronchospasm"
                    ],
                    [
                      "Nebulised antibiotics (e.g. tobramycin)",
                      "Selected chronic airway infections, particularly Pseudomonas in cystic fibrosis"
                    ],
                    [
                      "Nebulised magnesium sulfate",
                      "Selected specialist protocols for severe acute asthma; not routine"
                    ],
                    [
                      "Pentamidine",
                      "Selected prophylaxis/treatment protocols for Pneumocystis jirovecii pneumonia"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "High-yield cautions"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Salbutamol: tachycardia, tremor, hypokalaemia",
                      "level": 0
                    },
                    {
                      "text": "Ipratropium: dry mouth; avoid eye exposure, especially in narrow-angle glaucoma",
                      "level": 0
                    },
                    {
                      "text": "Adrenaline: tachycardia, hypertension, arrhythmias",
                      "level": 0
                    },
                    {
                      "text": "Budesonide: oral candidiasis; rinse mouth after use",
                      "level": 0
                    },
                    {
                      "text": "Nebulised magnesium sulfate is not routinely recommended in standard acute asthma treatment.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
