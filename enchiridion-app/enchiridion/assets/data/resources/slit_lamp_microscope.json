  "sections": [
    {
      "section_id": "slit_lamp_microscope_section_1",
      "section_title": "Slit-lamp microscope",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "slit_lamp_microscope_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "slit_lamp_microscope_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/slit_lamp_microscope_01.webp",
                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "slit_lamp_microscope_subsection_2",
          "subsection_title": "Identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "slit_lamp_microscope_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The slit-lamp microscope is an ophthalmic diagnostic instrument that provides a magnified, illuminated view of the structures of the eye. Its narrow, adjustable beam of light allows the examiner to examine different layers of the eye in detail."
                },
                {
                  "type": "paragraph",
                  "text": "Classification: Ophthalmic diagnostic instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Main function: Examination of the anterior segment of the eye."
                },
                {
                  "type": "paragraph",
                  "text": "Structures examined: Eyelids, conjunctiva, cornea, anterior chamber, iris and lens."
                },
                {
                  "type": "paragraph",
                  "text": "Additional capability: Examination of the vitreous and retina using suitable auxiliary lenses, often after pupil dilation."
                },
                {
                  "type": "paragraph",
                  "text": "Distinguishing feature: A binocular microscope combined with an adjustable slit-shaped light beam."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "slit_lamp_microscope_subsection_3",
          "subsection_title": "Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "slit_lamp_microscope_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The slit lamp is used to assess:"
                },
                {
                  "type": "paragraph",
                  "text": "Cornea: Corneal abrasions, ulcers, foreign bodies, oedema, scars and keratitis."
                },
                {
                  "type": "paragraph",
                  "text": "Conjunctiva: Conjunctivitis, inflammation, discharge and foreign bodies."
                },
                {
                  "type": "paragraph",
                  "text": "Anterior chamber: Depth, inflammation, cells and flare, or blood (hyphema)."
                },
                {
                  "type": "paragraph",
                  "text": "Iris and pupil: Iris abnormalities, pupil appearance and some signs of trauma."
                },
                {
                  "type": "paragraph",
                  "text": "Lens: Cataract and other lens opacities."
                },
                {
                  "type": "paragraph",
                  "text": "Contact lens assessment: Fit, movement and effects on the ocular surface."
                },
                {
                  "type": "paragraph",
                  "text": "Fluorescein examination: Corneal epithelial defects and tear-film assessment using cobalt-blue illumination."
                },
                {
                  "type": "paragraph",
                  "text": "Glaucoma assessment: Anterior chamber assessment and, with appropriate additional equipment, gonioscopy or intraocular pressure measurement."
                },
                {
                  "type": "paragraph",
                  "text": "Posterior segment examination: With a suitable auxiliary lens, assessment of the vitreous, optic disc and retina."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "slit_lamp_microscope_subsection_4",
          "subsection_title": "Parts and their functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "slit_lamp_microscope_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/slit_lamp_microscope_02.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/slit_lamp_microscope_03.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Function"
                  ],
                  "rows": [
                    [
                      "Binocular eyepieces",
                      "Allow stereoscopic, magnified viewing."
                    ],
                    [
                      "Microscope",
                      "Magnifies ocular structures."
                    ],
                    [
                      "Slit illumination system",
                      "Produces a narrow beam of light to examine tissue layers."
                    ],
                    [
                      "Beam-width and beam-height controls",
                      "Adjust the dimensions of the illuminated area."
                    ],
                    [
                      "Illumination intensity control",
                      "Regulates brightness."
                    ],
                    [
                      "Filter controls",
                      "Select filters, such as cobalt blue or red-free, depending on the model."
                    ],
                    [
                      "Joystick",
                      "Moves and focuses the instrument precisely."
                    ],
                    [
                      "Chin rest",
                      "Supports the patient's chin."
                    ],
                    [
                      "Forehead band",
                      "Stabilises the patient's head."
                    ],
                    [
                      "Magnification selector",
                      "Changes the level of magnification."
                    ],
                    [
                      "Base and examination table",
                      "Support the instrument and permit positioning."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important distinction: A slit lamp is not itself an ophthalmoscope, and it does not automatically measure intraocular pressure. Tonometry and gonioscopy require the appropriate additional equipment and technique."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "slit_lamp_microscope_subsection_5",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "slit_lamp_microscope_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Provides high magnification and detailed visualisation."
                },
                {
                  "type": "paragraph",
                  "text": "Allows examination of different corneal layers using a narrow optical section."
                },
                {
                  "type": "paragraph",
                  "text": "Can reveal subtle abnormalities not easily seen with a pen torch."
                },
                {
                  "type": "paragraph",
                  "text": "Supports fluorescein examination under cobalt-blue light."
                },
                {
                  "type": "paragraph",
                  "text": "Is useful for diagnosing and monitoring many anterior-segment conditions."
                },
                {
                  "type": "paragraph",
                  "text": "Can be combined with accessories for tonometry, gonioscopy and posterior-segment examination."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "slit_lamp_microscope_subsection_6",
          "subsection_title": "Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "slit_lamp_microscope_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Requires training to interpret findings correctly."
                },
                {
                  "type": "paragraph",
                  "text": "Requires the patient to sit still and cooperate."
                },
                {
                  "type": "paragraph",
                  "text": "Bright illumination may cause discomfort or photophobia."
                },
                {
                  "type": "paragraph",
                  "text": "Equipment may be expensive and requires maintenance."
                },
                {
                  "type": "paragraph",
                  "text": "A routine anterior-segment examination does not adequately assess every posterior-segment condition."
                },
                {
                  "type": "paragraph",
                  "text": "Findings depend on correct positioning, illumination, magnification and examination technique."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "slit_lamp_microscope_subsection_7",
          "subsection_title": "Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "slit_lamp_microscope_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Before starting the examination:"
                },
                {
                  "type": "paragraph",
                  "text": "Introduce yourself and confirm the patient's identity."
                },
                {
                  "type": "paragraph",
                  "text": "Explain the procedure and obtain consent."
                },
                {
                  "type": "paragraph",
                  "text": "Ask about eye pain, photophobia, trauma, contact lens use and relevant eye history."
                },
                {
                  "type": "paragraph",
                  "text": "Perform hand hygiene and clean the chin rest and forehead support according to infection-control protocol."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure the patient is comfortably seated at the correct height."
                },
                {
                  "type": "paragraph",
                  "text": "Remove spectacles if necessary for the examination; contact lenses may need to be removed depending on the indication."
                },
                {
                  "type": "paragraph",
                  "text": "Begin with low magnification and relatively low illumination, increasing them as needed."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid unnecessarily bright or prolonged illumination, particularly in patients with photophobia."
                },
                {
                  "type": "paragraph",
                  "text": "Safety point: Severe eye pain, chemical injury, penetrating trauma or sudden visual loss requires urgent assessment and treatment. Do not delay emergency care to complete a slit-lamp examination."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "slit_lamp_microscope_subsection_8",
          "subsection_title": "How to use the slit lamp — step-by-step OSCE demonstration",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "slit_lamp_microscope_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/slit_lamp_microscope_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 1 — Position the patient"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Ask the patient to sit comfortably, place the chin on the chin rest and press the forehead gently against the headband. Adjust the table and chin-rest height."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/slit_lamp_microscope_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 2 — Adjust the microscope"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Adjust the eyepieces for the examiner's interpupillary distance and focus. Begin with low magnification and diffuse illumination to locate the eye."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/slit_lamp_microscope_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 3 — Examine the external eye"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the eyelids, eyelashes, lid margins, conjunctiva and visible sclera. Look for swelling, redness, discharge, lesions or foreign bodies."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/slit_lamp_microscope_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 4 — Examine the cornea"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Narrow the slit beam and direct it across the cornea. Examine clarity, surface irregularities, opacities, oedema, infiltrates and foreign bodies. Change the beam angle and focus to examine different layers."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/slit_lamp_microscope_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 5 — Examine the anterior chamber, iris and lens"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Assess anterior chamber depth, look for cells, flare or blood, inspect the iris and pupil, and examine the lens for opacities such as cataracts."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/slit_lamp_microscope_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 6 — Perform special examination if indicated"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Apply fluorescein using an appropriate technique and examine under cobalt-blue illumination to identify epithelial defects. Use appropriate adjuncts for tonometry, gonioscopy or posterior-segment examination when indicated."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 7 — Complete and document"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Examine both eyes as appropriate, compare findings, make the patient comfortable and document the structures examined, abnormalities identified and any additional tests performed."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "slit_lamp_microscope_subsection_9",
          "subsection_title": "Contraindications and complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "slit_lamp_microscope_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The slit-lamp examination itself is generally non-invasive and has no major absolute contraindication."
                },
                {
                  "type": "table",
                  "columns": [
                    "Issue",
                    "OSCE explanation"
                  ],
                  "rows": [
                    [
                      "Photophobia",
                      "Bright illumination may cause discomfort; adjust intensity and exposure."
                    ],
                    [
                      "Poor cooperation",
                      "Head movement may limit the examination, particularly in children."
                    ],
                    [
                      "Suspected penetrating injury",
                      "Avoid pressure or contact with the injured eye and arrange emergency ophthalmic assessment."
                    ],
                    [
                      "Contact procedures",
                      "Tonometry or gonioscopy may require topical anaesthetic and carry additional risks."
                    ],
                    [
                      "Fluorescein use",
                      "Use only when indicated and follow local protocols, including allergy precautions."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Routine slit-lamp examination does not normally damage the eye when performed correctly. Contact-based adjunct procedures have additional precautions."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "slit_lamp_microscope_subsection_10",
          "subsection_title": "Normal and abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "slit_lamp_microscope_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/slit_lamp_microscope_10.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Normal findings"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Clear cornea without epithelial defects or infiltrates."
                },
                {
                  "type": "paragraph",
                  "text": "Quiet anterior chamber without visible inflammatory cells or flare."
                },
                {
                  "type": "paragraph",
                  "text": "No abnormal blood or pus in the anterior chamber."
                },
                {
                  "type": "paragraph",
                  "text": "Iris without obvious abnormality."
                },
                {
                  "type": "paragraph",
                  "text": "Lens without clinically significant visible opacity."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/slit_lamp_microscope_11.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Corneal abrasion"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Fluorescein highlights an area of epithelial loss under cobalt-blue illumination. A traumatic abrasion may have a linear or irregular pattern."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/slit_lamp_microscope_12.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Hyphema"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Blood is visible within the anterior chamber, sometimes forming a dependent level. This warrants urgent assessment, especially following trauma."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/slit_lamp_microscope_13.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Anterior uveitis"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Inflammatory cells and flare may be seen in the anterior chamber using an appropriately narrow beam in a darkened examination environment."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/slit_lamp_microscope_14.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Cataract"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Lens opacity may appear as cortical spokes, nuclear changes or posterior subcapsular opacity, depending on the type."
                },
                {
                  "type": "paragraph",
                  "text": "Other abnormalities include corneal oedema, ulcers, keratic precipitates, conjunctival inflammation and foreign bodies."
                }
              ]
            },
            {
              "group_id": "slit_lamp_microscope_group_11",
              "group_title": "Example of OSCE reporting",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“On slit-lamp examination, the conjunctiva is mildly injected. There is a focal corneal epithelial defect that stains with fluorescein. The anterior chamber is formed, with no visible hyphema. These findings are consistent with a corneal epithelial injury; further assessment is required to exclude an associated corneal foreign body or infection.”"
                },
                {
                  "type": "paragraph",
                  "text": "Report what you observe first, followed by the likely interpretation. Do not describe an ulcer, infection or uveitis as confirmed if the examination findings are insufficient."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "slit_lamp_microscope_subsection_11",
          "subsection_title": "Paediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "slit_lamp_microscope_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Explain the examination in age-appropriate language and involve the caregiver."
                },
                {
                  "type": "paragraph",
                  "text": "Allow the child to become familiar with the equipment."
                },
                {
                  "type": "paragraph",
                  "text": "Adjust the chin rest and table for the child's height."
                },
                {
                  "type": "paragraph",
                  "text": "Use brief examination periods and avoid unnecessarily intense illumination."
                },
                {
                  "type": "paragraph",
                  "text": "A caregiver may help reassure and stabilise a cooperative child."
                },
                {
                  "type": "paragraph",
                  "text": "If the child cannot cooperate, consider alternative examination techniques or specialist assessment."
                },
                {
                  "type": "paragraph",
                  "text": "Suspected corneal injury, chemical injury, serious infection or other sight-threatening conditions require prompt assessment even if a full slit-lamp examination is difficult."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "slit_lamp_microscope_subsection_12",
          "subsection_title": "Mnemonic — LIGHT",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "slit_lamp_microscope_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Use LIGHT to remember the basic examination sequence."
                },
                {
                  "type": "paragraph",
                  "text": "L — Locate: Position the patient and centre the eye."
                },
                {
                  "type": "paragraph",
                  "text": "I — Inspect: Examine the external eye and conjunctiva."
                },
                {
                  "type": "paragraph",
                  "text": "G — Generate: Produce and align the slit beam."
                },
                {
                  "type": "paragraph",
                  "text": "H — Hone: Adjust magnification, beam width, angle and focus."
                },
                {
                  "type": "paragraph",
                  "text": "T — Test and tell: Perform indicated special tests, then document and report findings."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "slit_lamp_microscope_subsection_13",
          "subsection_title": "Common OSCE viva questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "slit_lamp_microscope_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is a slit-lamp microscope?"
                },
                {
                  "type": "paragraph",
                  "text": "A binocular ophthalmic microscope combined with an adjustable slit-shaped illumination system for magnified examination of the eye."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Which structures can you examine?"
                },
                {
                  "type": "paragraph",
                  "text": "The eyelids, conjunctiva, cornea, anterior chamber, iris and lens. The posterior segment can also be examined with suitable auxiliary lenses and technique."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Why is the beam narrow?"
                },
                {
                  "type": "paragraph",
                  "text": "It provides an optical section that helps assess the depth and different layers of transparent ocular structures, particularly the cornea and lens."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. What is the purpose of cobalt-blue illumination?"
                },
                {
                  "type": "paragraph",
                  "text": "It enhances the visibility of fluorescein, helping identify corneal epithelial defects and assess aspects of the tear film."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What is fluorescein used for?"
                },
                {
                  "type": "paragraph",
                  "text": "It stains areas of corneal epithelial disruption and can help identify abrasions, certain ulcers and foreign-body-related injuries."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. How would you identify anterior chamber inflammation?"
                },
                {
                  "type": "paragraph",
                  "text": "Cells and flare may be visible when the anterior chamber is examined with a narrow beam under suitable lighting conditions."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. Does the slit lamp measure intraocular pressure?"
                },
                {
                  "type": "paragraph",
                  "text": "Not by itself. Intraocular pressure measurement requires a tonometer, such as a compatible Goldmann applanation tonometer."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. How does a slit lamp differ from a direct ophthalmoscope?"
                },
                {
                  "type": "paragraph",
                  "text": "A slit lamp provides magnified, stereoscopic examination, especially of the anterior segment. A direct ophthalmoscope is primarily used to examine the fundus through the pupil."
                },
                {
                  "type": "paragraph",
                  "text": "Q9. What is gonioscopy?"
                },
                {
                  "type": "paragraph",
                  "text": "Examination of the anterior chamber angle using a specialised contact lens or goniolens, commonly in the assessment of glaucoma."
                },
                {
                  "type": "paragraph",
                  "text": "Q10. Name two urgent findings on slit-lamp examination."
                },
                {
                  "type": "paragraph",
                  "text": "Examples include a corneal ulcer with concerning features and hyphema following trauma. A suspected open-globe injury is also an emergency, but the eye should not be pressed or manipulated to complete the examination."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "slit_lamp_microscope_subsection_14",
          "subsection_title": "Common mistakes and examiner tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "slit_lamp_microscope_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Common mistakes"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Calling the instrument a direct ophthalmoscope."
                },
                {
                  "type": "paragraph",
                  "text": "Forgetting to position the patient's chin and forehead."
                },
                {
                  "type": "paragraph",
                  "text": "Starting with unnecessarily high magnification or intense illumination."
                },
                {
                  "type": "paragraph",
                  "text": "Examining only the cornea and ignoring the other anterior-segment structures."
                },
                {
                  "type": "paragraph",
                  "text": "Claiming that fluorescein is required in every examination."
                },
                {
                  "type": "paragraph",
                  "text": "Confusing the slit lamp with a tonometer."
                },
                {
                  "type": "paragraph",
                  "text": "Failing to document the location and extent of an abnormality."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Examiner tips"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Identify the instrument and state its main function immediately."
                },
                {
                  "type": "paragraph",
                  "text": "Demonstrate patient positioning before adjusting the microscope."
                },
                {
                  "type": "paragraph",
                  "text": "Describe a systematic examination from external structures to the cornea, anterior chamber, iris and lens."
                },
                {
                  "type": "paragraph",
                  "text": "Explain that posterior-segment assessment requires appropriate additional optics."
                },
                {
                  "type": "paragraph",
                  "text": "Mention fluorescein and cobalt-blue illumination when discussing corneal epithelial defects."
                }
              ]
            }
          ]
