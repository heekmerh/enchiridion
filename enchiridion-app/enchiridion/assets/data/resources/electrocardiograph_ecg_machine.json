        {
          "subsection_id": "electrocardiograph_ecg_machine_subsection_10",
          "subsection_title": "mm/s",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electrocardiograph_ecg_machine_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Calibration",
                    "Standard gain"
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electrocardiograph_ecg_machine_subsection_11",
          "subsection_title": "mm/mV",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electrocardiograph_ecg_machine_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Small square",
                    "At 25 mm/s and standard gain"
                  ]
                }
              ]
            },
            {
              "group_id": "electrocardiograph_ecg_machine_group_14",
              "group_title": "0.04 s",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Large square",
                    "Five small squares"
                  ]
                }
              ]
            },
            {
              "group_id": "electrocardiograph_ecg_machine_group_15",
              "group_title": "0.20 s",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "At the standard paper speed of 25 mm/s:"
                },
                {
                  "type": "paragraph",
                  "text": "5 large squares = 1 second."
                },
                {
                  "type": "paragraph",
                  "text": "30 large squares = 6 seconds."
                },
                {
                  "type": "paragraph",
                  "text": "300 large squares = 1 minute."
                }
              ]
            },
            {
              "group_id": "electrocardiograph_ecg_machine_group_16",
              "group_title": "Estimating heart rate",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "For a regular rhythm:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "\\[ \\text{Heart rate}=\\frac{300}{\\text{large squares between R waves}} \\]"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Example: If there are four large squares between successive R waves:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "\\[ 300\\div4=75\\text{ beats/min} \\]"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "For an irregular rhythm, count the QRS complexes in a known time interval and calculate the rate, or use an appropriate longer rhythm strip."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electrocardiograph_ecg_machine_subsection_12",
          "subsection_title": "Common ECG artefacts and troubleshooting",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electrocardiograph_ecg_machine_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Problem",
                    "Possible cause",
                    "What to do"
                  ],
                  "rows": [
                    [
                      "Wandering baseline",
                      "Patient movement, breathing, poor contact",
                      "Reassure the patient and check electrode contact"
                    ],
                    [
                      "Muscle artefact",
                      "Shivering, tension, tremor",
                      "Relax the patient and keep them warm"
                    ],
                    [
                      "Electrical interference",
                      "Nearby electrical equipment or poor grounding",
                      "Check cables and equipment setup"
                    ],
                    [
                      "Flat or missing lead",
                      "Disconnected cable or electrode",
                      "Check the relevant connection"
                    ],
                    [
                      "Unexpected waveform pattern",
                      "Misplaced electrodes or incorrect lead connection",
                      "Verify placement and repeat if appropriate"
                    ],
                    [
                      "Excessive noise",
                      "Dry electrodes, sweaty skin, loose cables",
                      "Prepare the skin and replace faulty electrodes"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "OSCE tip: Before interpreting an unusual ECG, check the patient, recording quality, calibration, and electrode placement. However, never delay urgent clinical assessment because a tracing is technically imperfect."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electrocardiograph_ecg_machine_subsection_13",
          "subsection_title": "Precautions and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electrocardiograph_ecg_machine_group_18",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Ensure patient privacy and appropriate exposure."
                },
                {
                  "type": "paragraph",
                  "text": "Use clean equipment and replace disposable electrodes as recommended."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid placing electrodes over wounds or areas where contact is unsuitable."
                },
                {
                  "type": "paragraph",
                  "text": "Document modified lead placement where relevant."
                },
                {
                  "type": "paragraph",
                  "text": "Do not mistake movement artefact for an arrhythmia."
                },
                {
                  "type": "paragraph",
                  "text": "Do not assume a normal ECG excludes serious disease."
                },
                {
                  "type": "paragraph",
                  "text": "In suspected acute coronary syndrome, urgent assessment and repeat ECGs may be needed even if the first tracing is non-diagnostic."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electrocardiograph_ecg_machine_subsection_14",
          "subsection_title": "Pediatric ECG considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electrocardiograph_ecg_machine_group_19",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electrocardiograph_ecg_machine_15.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Use appropriately sized electrodes and ensure good skin contact."
                },
                {
                  "type": "paragraph",
                  "text": "Keep the child warm, comfortable, and as still as possible."
                },
                {
                  "type": "paragraph",
                  "text": "Correct anatomical placement remains essential."
                },
                {
                  "type": "paragraph",
                  "text": "Normal ECG patterns vary with age; for example, right ventricular dominance and certain repolarisation patterns may be normal in young children."
                },
                {
                  "type": "paragraph",
                  "text": "Interpret pediatric ECGs using age-appropriate reference values rather than adult criteria alone."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electrocardiograph_ecg_machine_subsection_15",
          "subsection_title": "Memory aid: V1 to V6",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electrocardiograph_ecg_machine_group_20",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "V1–V2: Fourth intercostal space, on opposite sides of the sternum."
                },
                {
                  "type": "paragraph",
                  "text": "V3: Between V2 and V4."
                },
                {
                  "type": "paragraph",
                  "text": "V4: Fifth intercostal space, midclavicular line."
                },
                {
                  "type": "paragraph",
                  "text": "V5: Anterior axillary line, level with V4."
                },
                {
                  "type": "paragraph",
                  "text": "V6: Midaxillary line, level with V4 and V5."
                },
                {
                  "type": "paragraph",
                  "text": "For a quick recall of the six chest leads, remember: 4th space, 4th space, between, 5th space, anterior axillary, midaxillary."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electrocardiograph_ecg_machine_subsection_16",
          "subsection_title": "Common OSCE examiner questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electrocardiograph_ecg_machine_group_21",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is an ECG?"
                },
                {
                  "type": "paragraph",
                  "text": "A non-invasive recording of the electrical activity of the heart."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Why does a 12-lead ECG use 10 electrodes?"
                },
                {
                  "type": "paragraph",
                  "text": "Four limb electrodes and six chest electrodes generate 12 electrical views of the heart."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What are the standard paper speed and gain?"
                },
                {
                  "type": "paragraph",
                  "text": "25 mm/s and 10 mm/mV, respectively, unless the recording indicates otherwise."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Where is V1 placed?"
                },
                {
                  "type": "paragraph",
                  "text": "The fourth intercostal space at the right sternal border."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. Where is V4 placed?"
                },
                {
                  "type": "paragraph",
                  "text": "The fifth intercostal space at the left midclavicular line."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What are common causes of ECG artefacts?"
                },
                {
                  "type": "paragraph",
                  "text": "Patient movement, muscle activity, poor electrode contact, loose cables, and electrical interference."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. Can a normal ECG rule out a myocardial infarction?"
                },
                {
                  "type": "paragraph",
                  "text": "No. Clinical assessment, serial ECGs, cardiac biomarkers, and other investigations may be required."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. What should you do if the ECG shows a potentially life-threatening abnormality?"
                },
                {
                  "type": "paragraph",
                  "text": "Assess the patient immediately, activate the appropriate emergency response, and escalate treatment without unnecessary delay."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electrocardiograph_ecg_machine_subsection_17",
          "subsection_title": "Mini OSCE station",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electrocardiograph_ecg_machine_group_22",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Scenario: You are asked to record a 12-lead ECG on a stable adult patient."
                },
                {
                  "type": "paragraph",
                  "text": "Expected approach:"
                },
                {
                  "type": "paragraph",
                  "text": "Confirm identity, explain the procedure, and obtain consent."
                },
                {
                  "type": "paragraph",
                  "text": "Position the patient appropriately and prepare the skin."
                },
                {
                  "type": "paragraph",
                  "text": "Attach four limb electrodes and six chest electrodes."
                },
                {
                  "type": "paragraph",
                  "text": "Correctly locate V1–V6 using anatomical landmarks."
                },
                {
                  "type": "paragraph",
                  "text": "Check the cables, calibration, and recording quality."
                },
                {
                  "type": "paragraph",
                  "text": "Record and label the ECG."
                },
                {
                  "type": "paragraph",
                  "text": "Check that all leads are present and interpretable."
                },
                {
                  "type": "paragraph",
                  "text": "Recognise and escalate significant abnormalities."
                },
                {
                  "type": "paragraph",
                  "text": "Examiner's key point: Accurate electrode placement is fundamental. Incorrect placement can create misleading ECG patterns and lead to diagnostic errors."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}