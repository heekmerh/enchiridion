      "section_id": "electrocardiograph_ecg_machine_section_1",
      "section_title": "ECG machine",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "electrocardiograph_ecg_machine_subsection_1",
          "subsection_title": "ECG Machine (Electrocardiogram)",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electrocardiograph_ecg_machine_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electrocardiograph_ecg_machine_01.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electrocardiograph_ecg_machine_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "An electrocardiogram (ECG or EKG) machine records the electrical activity of the heart using electrodes placed on the skin. The machine displays or prints the electrical signals as waveforms that clinicians interpret to assess heart rate, rhythm, conduction, and evidence of cardiac abnormalities."
                },
                {
                  "type": "paragraph",
                  "text": "It is a high-yield OSCE station because candidates are commonly asked to identify the machine, prepare the patient, position the electrodes, record a standard 12-lead ECG, recognise artefacts, and explain clinical uses."
                },
                {
                  "type": "paragraph",
                  "text": "Key principle: An ECG records the heart's electrical activity, not its mechanical pumping function. A normal ECG does not exclude every serious cardiac condition."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electrocardiograph_ecg_machine_subsection_2",
          "subsection_title": "Identification and definition",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electrocardiograph_ecg_machine_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Name: Electrocardiogram machine."
                },
                {
                  "type": "paragraph",
                  "text": "Abbreviation: ECG or EKG."
                },
                {
                  "type": "paragraph",
                  "text": "Function: Records electrical potentials generated by cardiac depolarisation and repolarisation."
                },
                {
                  "type": "paragraph",
                  "text": "Standard clinical recording: A 12-lead ECG."
                },
                {
                  "type": "paragraph",
                  "text": "Output: Waveforms displayed on a screen or printed on ECG paper."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electrocardiograph_ecg_machine_subsection_3",
          "subsection_title": "Main components and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electrocardiograph_ecg_machine_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electrocardiograph_ecg_machine_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Main unit and display"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Processes the electrical signals and displays patient information, settings, and ECG waveforms."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electrocardiograph_ecg_machine_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Lead wires and cables"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Connect the electrodes to the ECG machine and transmit the electrical signals."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electrocardiograph_ecg_machine_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Electrodes"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Detect electrical potentials at the skin surface. A standard 12-lead ECG uses 10 physical electrodes."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electrocardiograph_ecg_machine_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Thermal printer or digital storage"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Produces a paper tracing or stores the recording electronically for review and comparison."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electrocardiograph_ecg_machine_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "5. Controls and power supply"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Allow the operator to enter patient details, select settings, record the ECG, and print or save the tracing."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electrocardiograph_ecg_machine_subsection_4",
          "subsection_title": "Why is it called a 12-lead ECG if it uses 10 electrodes?",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electrocardiograph_ecg_machine_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This is a very common OSCE question."
                },
                {
                  "type": "paragraph",
                  "text": "A standard 12-lead ECG uses 10 physical electrodes to produce 12 electrical views (leads) of the heart."
                },
                {
                  "type": "paragraph",
                  "text": "4 limb electrodes: Right arm, left arm, right leg, and left leg."
                },
                {
                  "type": "paragraph",
                  "text": "6 chest electrodes: V1, V2, V3, V4, V5, and V6."
                },
                {
                  "type": "paragraph",
                  "text": "The limb electrodes generate leads I, II, III, aVR, aVL, and aVF. The six chest electrodes produce leads V1–V6."
                },
                {
                  "type": "paragraph",
                  "text": "Memory tip: 10 electrodes produce 12 leads."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electrocardiograph_ecg_machine_subsection_5",
          "subsection_title": "Clinical uses of an ECG",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electrocardiograph_ecg_machine_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "An ECG may be used to assess:"
                },
                {
                  "type": "paragraph",
                  "text": "Arrhythmias: Such as atrial fibrillation, atrial flutter, supraventricular tachycardia, and ventricular tachycardia."
                },
                {
                  "type": "paragraph",
                  "text": "Myocardial ischaemia and infarction: Including patterns suggestive of acute coronary syndrome."
                },
                {
                  "type": "paragraph",
                  "text": "Conduction abnormalities: Such as atrioventricular block and bundle branch block."
                },
                {
                  "type": "paragraph",
                  "text": "Electrolyte disturbances: Particularly abnormalities in potassium and calcium that affect cardiac electrical activity."
                },
                {
                  "type": "paragraph",
                  "text": "Chamber enlargement or hypertrophy: ECG patterns may suggest atrial or ventricular enlargement, although echocardiography is generally more definitive."
                },
                {
                  "type": "paragraph",
                  "text": "Drug effects and toxicity: For example, QT prolongation or certain sodium-channel-blocking drug effects."
                },
                {
                  "type": "paragraph",
                  "text": "Monitoring: Assessment of rhythm before, during, or after treatment and comparison with previous recordings."
                },
                {
                  "type": "paragraph",
                  "text": "An ECG is interpreted alongside the history, examination, and other investigations. A normal tracing does not exclude acute coronary syndrome or an intermittent arrhythmia."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electrocardiograph_ecg_machine_subsection_6",
          "subsection_title": "Preparation before recording",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electrocardiograph_ecg_machine_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Before starting, the candidate should:"
                },
                {
                  "type": "paragraph",
                  "text": "Confirm the patient's identity and explain the procedure."
                },
                {
                  "type": "paragraph",
                  "text": "Obtain consent and ensure privacy."
                },
                {
                  "type": "paragraph",
                  "text": "Perform hand hygiene."
                },
                {
                  "type": "paragraph",
                  "text": "Position the patient comfortably, usually lying supine or semi-recumbent."
                },
                {
                  "type": "paragraph",
                  "text": "Expose the chest appropriately while maintaining dignity."
                },
                {
                  "type": "paragraph",
                  "text": "Check the ECG machine, cables, electrodes, paper, and power supply."
                },
                {
                  "type": "paragraph",
                  "text": "Prepare the skin by ensuring it is clean and dry; remove excessive hair if necessary for good electrode contact."
                },
                {
                  "type": "paragraph",
                  "text": "Enter the correct patient details."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure the patient is relaxed, warm, and still during the recording."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE point: An ECG is non-invasive and usually painless. The electrodes detect electrical activity; they do not deliver an electric shock."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electrocardiograph_ecg_machine_subsection_7",
          "subsection_title": "Standard 12-lead ECG electrode placement",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electrocardiograph_ecg_machine_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electrocardiograph_ecg_machine_08.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electrocardiograph_ecg_machine_09.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electrocardiograph_ecg_machine_10.webp",
                  "caption": null
                }
              ]
            },
            {
              "group_id": "electrocardiograph_ecg_machine_group_8",
              "group_title": "A. Limb electrodes",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The conventional limb electrode labels are:"
                },
                {
                  "type": "table",
                  "columns": [
                    "Electrode",
                    "Placement"
                  ],
                  "rows": [
                    [
                      "RA",
                      "Right arm"
                    ],
                    [
                      "LA",
                      "Left arm"
                    ],
                    [
                      "RL",
                      "Right leg — commonly the reference/ground electrode"
                    ],
                    [
                      "LL",
                      "Left leg"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Electrodes may be placed on the limbs or in appropriate modified positions when clinically necessary. Document non-standard placement where relevant, because it can alter the tracing."
                }
              ]
            },
            {
              "group_id": "electrocardiograph_ecg_machine_group_9",
              "group_title": "B. Chest electrodes — memorise these landmarks",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electrocardiograph_ecg_machine_11.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "V1: Fourth intercostal space, right sternal border."
                },
                {
                  "type": "paragraph",
                  "text": "V2: Fourth intercostal space, left sternal border."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electrocardiograph_ecg_machine_12.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "V3: Midway between V2 and V4."
                },
                {
                  "type": "paragraph",
                  "text": "V4: Fifth intercostal space, left midclavicular line."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electrocardiograph_ecg_machine_13.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "V5: Same horizontal level as V4, at the left anterior axillary line."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electrocardiograph_ecg_machine_14.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "V6: Same horizontal level as V4, at the left midaxillary line."
                },
                {
                  "type": "paragraph",
                  "text": "Important placement rule: Identify the intercostal spaces by palpating anatomical landmarks rather than estimating by eye. V4, V5, and V6 must lie on the same horizontal level."
                },
                {
                  "type": "paragraph",
                  "text": "For patients with breasts, place chest electrodes against the chest wall at the correct anatomical locations rather than simply on top of breast tissue."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electrocardiograph_ecg_machine_subsection_8",
          "subsection_title": "How to record a standard ECG",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electrocardiograph_ecg_machine_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Verify the patient's identity and explain the procedure."
                },
                {
                  "type": "paragraph",
                  "text": "Position the patient and prepare the skin."
                },
                {
                  "type": "paragraph",
                  "text": "Attach the four limb electrodes."
                },
                {
                  "type": "paragraph",
                  "text": "Place V1–V6 at the correct anatomical landmarks."
                },
                {
                  "type": "paragraph",
                  "text": "Connect the cables to their corresponding electrodes."
                },
                {
                  "type": "paragraph",
                  "text": "Ask the patient to relax, avoid talking, and remain still."
                },
                {
                  "type": "paragraph",
                  "text": "Check the tracing for baseline stability and excessive artefact."
                },
                {
                  "type": "paragraph",
                  "text": "Use standard settings unless there is a clinical reason to change them."
                },
                {
                  "type": "paragraph",
                  "text": "Record the ECG and review whether all leads are present and interpretable."
                },
                {
                  "type": "paragraph",
                  "text": "Label the recording with the patient's details, date, time, and relevant clinical information."
                },
                {
                  "type": "paragraph",
                  "text": "Recognise urgent abnormalities and escalate immediately rather than delaying care."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electrocardiograph_ecg_machine_subsection_9",
          "subsection_title": "Standard ECG settings and paper interpretation",
