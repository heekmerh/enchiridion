        {
          "subsection_id": "cervical_collar_subsection_2",
          "subsection_title": "Introduction and definition",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cervical_collar_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A cervical collar is an external orthopaedic support placed around the neck to limit cervical spine movement and provide support in selected traumatic, postoperative or musculoskeletal conditions."
                },
                {
                  "type": "paragraph",
                  "text": "It is commonly used in trauma care, emergency medicine, orthopaedics, neurosurgery and rehabilitation."
                },
                {
                  "type": "paragraph",
                  "text": "Key identifying feature: A collar-shaped device that surrounds the neck and supports the head, often with a chin rest and an occipital support."
                }
              ]
            },
            {
              "group_id": "cervical_collar_group_3",
              "group_title": "Essential clinical distinction",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A cervical collar is an adjunct to spinal motion restriction, not a definitive treatment for a cervical spine fracture and not a guarantee that all neck movement has been eliminated."
                },
                {
                  "type": "paragraph",
                  "text": "In trauma, appropriate handling, clinical assessment and transfer are essential. A collar should not delay airway management or other life-saving interventions."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cervical_collar_subsection_3",
          "subsection_title": "Identification in an OSCE station",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cervical_collar_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/cervical_collar_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Model identification"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "“This is a cervical collar, an external support used to restrict cervical spine movement in selected patients, particularly during the initial management of suspected cervical spine injury.”"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Properties"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Available in rigid, semi-rigid and soft designs."
                },
                {
                  "type": "paragraph",
                  "text": "May be adjustable or available in fixed sizes."
                },
                {
                  "type": "paragraph",
                  "text": "Some rigid collars have separate anterior and posterior components."
                },
                {
                  "type": "paragraph",
                  "text": "Correct sizing is essential."
                },
                {
                  "type": "paragraph",
                  "text": "It is used alongside appropriate spinal motion restriction and clinical assessment."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cervical_collar_subsection_4",
          "subsection_title": "Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cervical_collar_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/cervical_collar_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Anterior panel"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The front section of a rigid collar. It commonly includes a chin support and may have an opening to facilitate access to the anterior neck."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/cervical_collar_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Posterior panel"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Supports the back of the neck and occipital region and helps limit movement when correctly fitted."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/cervical_collar_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Chin support"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Supports the mandible and helps limit flexion when the collar is correctly sized and positioned."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/cervical_collar_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Fastening straps"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Secure the collar around the neck and maintain the intended fit."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/cervical_collar_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "5. Height adjustment mechanism, if present"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Allows the collar height to be adjusted to the patient's neck dimensions."
                },
                {
                  "type": "paragraph",
                  "text": "Other features may include ventilation openings, foam padding, a tracheostomy access opening and manufacturer-specific sizing indicators."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE tip: Not every collar has separate anterior and posterior panels or an adjustable mechanism. Label only the components actually present on the device."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cervical_collar_subsection_5",
          "subsection_title": "Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cervical_collar_group_6",
              "group_title": "A. According to rigidity",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/cervical_collar_10.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Rigid cervical collar"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Made from relatively firm material, often with padded contact surfaces."
                },
                {
                  "type": "paragraph",
                  "text": "Used in selected trauma and postoperative settings."
                },
                {
                  "type": "paragraph",
                  "text": "Provides greater restriction of movement than a soft collar."
                },
                {
                  "type": "paragraph",
                  "text": "Does not completely eliminate cervical spine movement."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/cervical_collar_01.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Semi-rigid cervical collar"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Provides intermediate support and restriction, depending on the design."
                },
                {
                  "type": "paragraph",
                  "text": "Used in selected clinical settings."
                },
                {
                  "type": "paragraph",
                  "text": "May offer a balance between support and comfort."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/cervical_collar_11.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Soft cervical collar"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Usually made of foam or similar flexible material."
                },
                {
                  "type": "paragraph",
                  "text": "Provides gentle support and may improve comfort."
                },
                {
                  "type": "paragraph",
                  "text": "Offers limited mechanical restriction."
                },
                {
                  "type": "paragraph",
                  "text": "Is not an adequate substitute for rigid spinal motion restriction in a patient with a suspected unstable cervical spine injury."
                }
              ]
            },
            {
              "group_id": "cervical_collar_group_7",
              "group_title": "B. According to design",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "One-piece collar: A single integrated structure."
                },
                {
                  "type": "paragraph",
                  "text": "Two-piece collar: Separate anterior and posterior sections."
                },
                {
                  "type": "paragraph",
                  "text": "Adjustable collar: Height or size can be modified."
                },
                {
                  "type": "paragraph",
                  "text": "Fixed-size collar: Supplied in predefined sizes."
                },
                {
                  "type": "paragraph",
                  "text": "Specialist postoperative collar: Selected designs used after cervical spine surgery or for specific spinal conditions."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cervical_collar_subsection_6",
          "subsection_title": "Indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cervical_collar_group_8",
              "group_title": "A. Trauma-related indications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A cervical collar may be used as part of spinal motion restriction when a patient has suspected cervical spine injury, depending on the trauma protocol and clinical assessment."
                },
                {
                  "type": "paragraph",
                  "text": "Examples include:"
                },
                {
                  "type": "paragraph",
                  "text": "Blunt trauma with concerning neck pain or tenderness."
                },
                {
                  "type": "paragraph",
                  "text": "Selected high-risk road traffic collisions."
                },
                {
                  "type": "paragraph",
                  "text": "Falls with suspected cervical injury."
                },
                {
                  "type": "paragraph",
                  "text": "Neurological symptoms following trauma."
                },
                {
                  "type": "paragraph",
                  "text": "Selected patients with altered consciousness who cannot be reliably assessed."
                },
                {
                  "type": "paragraph",
                  "text": "A collar is not automatically required after every trauma. Clinical decision rules, the patient's condition and local protocols guide its use."
                }
              ]
            },
            {
              "group_id": "cervical_collar_group_9",
              "group_title": "B. Non-traumatic indications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Selected postoperative cervical spine conditions."
                },
                {
                  "type": "paragraph",
                  "text": "Temporary support for certain painful cervical conditions."
                },
                {
                  "type": "paragraph",
                  "text": "Selected specialist-directed management of cervical spine injuries."
                },
                {
                  "type": "paragraph",
                  "text": "Support during rehabilitation when specifically indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Important: A soft collar may be prescribed for comfort in selected neck conditions, but routine prolonged use is not appropriate for every patient with neck pain."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cervical_collar_subsection_7",
          "subsection_title": "Principles of application",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cervical_collar_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "OSCE practical station: demonstrate safe handling, appropriate sizing and reassessment."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 1 — Assess and prioritise"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Assess airway, breathing and circulation first. Identify possible cervical spine injury and initiate the appropriate trauma protocol. Do not delay life-saving treatment to apply a collar."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 2 — Maintain manual stabilisation when indicated"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A trained rescuer maintains the head and neck in the appropriate position while another team member selects and applies the collar, when staffing allows."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 3 — Select the correct size"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Measure or assess the neck according to the manufacturer's instructions. The collar must support the head without forcing the neck into flexion or extension."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 4 — Apply and secure"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Apply the collar using the device-specific technique while maintaining appropriate alignment. Secure the fastening without excessive tightness."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 5 — Reassess"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Reassess airway access, breathing, comfort, skin pressure points and neurological status as clinically appropriate. Continue the spinal motion restriction and monitoring required by the trauma protocol."
                }
              ]
            },
            {
              "group_id": "cervical_collar_group_11",
              "group_title": "Critical application principles",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Do not force the neck into a neutral position if this causes pain, resistance or neurological deterioration."
                },
                {
                  "type": "paragraph",
                  "text": "Maintain manual stabilisation when indicated during application and removal."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid excessive pressure over the mandible, occiput and clavicles."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure the collar does not obstruct the airway or compromise ventilation."
                },
                {
                  "type": "paragraph",
                  "text": "Reassess fit and skin condition during ongoing care."
                },
                {
                  "type": "paragraph",
                  "text": "Follow the appropriate protocol for removal or clearance; do not remove a collar simply because the patient feels comfortable."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cervical_collar_subsection_8",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cervical_collar_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Provides external support for the neck."
                },
                {
                  "type": "paragraph",
                  "text": "Can limit cervical spine movement during selected trauma situations."
                },
                {
                  "type": "paragraph",
                  "text": "Helps maintain the intended position during transfer and assessment."
                },
                {
                  "type": "paragraph",
                  "text": "Rigid designs provide greater restriction than soft collars."
                },
                {
                  "type": "paragraph",
                  "text": "Adjustable designs allow fitting to different neck dimensions."
                },
                {
                  "type": "paragraph",
                  "text": "Some designs allow access to the anterior neck for selected procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Can be used alongside other spinal motion restriction measures."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cervical_collar_subsection_9",
          "subsection_title": "Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cervical_collar_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Does not completely immobilise the cervical spine."
                },
                {
                  "type": "paragraph",
                  "text": "May cause discomfort and anxiety."
                },
                {
                  "type": "paragraph",
                  "text": "Can make swallowing more difficult in some patients."
                },
                {
                  "type": "paragraph",
                  "text": "May interfere with airway access or complicate airway management."
                },
                {
                  "type": "paragraph",
                  "text": "Can increase pressure over the skin, particularly during prolonged use."
                },
                {
                  "type": "paragraph",
                  "text": "Incorrect sizing may worsen positioning or provide inadequate support."
                },
                {
                  "type": "paragraph",
                  "text": "May complicate assessment and care in some patients."
                },
                {
                  "type": "paragraph",
                  "text": "Does not replace appropriate imaging, clinical clearance or definitive treatment."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cervical_collar_subsection_10",
          "subsection_title": "Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cervical_collar_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Explanation"
                  ],
                  "rows": [
                    [
                      "Pressure injury",
                      "Prolonged pressure over the occiput, mandible or other contact areas"
                    ],
                    [
                      "Skin breakdown",
                      "Moisture, friction and sustained pressure"
                    ],
                    [
                      "Discomfort and pain",
                      "Poor fit or prolonged use"
                    ],
                    [
                      "Dysphagia",
                      "Difficulty swallowing in some patients"
                    ],
                    [
                      "Respiratory compromise",
                      "Poor fit or interaction with other factors affecting ventilation"
                    ],
                    [
                      "Raised intracranial pressure",
                      "A tightly fitted collar may impede venous drainage in susceptible patients"
                    ],
                    [
                      "Inadequate spinal motion restriction",
                      "Incorrect sizing, poor application or reliance on the collar alone"
                    ],
                    [
                      "Neurological deterioration",
                      "Possible with inappropriate positioning or movement of an unstable injury"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "High-yield point: A collar that is too small or too large can be ineffective or harmful. Correct sizing and reassessment are essential."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cervical_collar_subsection_11",
          "subsection_title": "Cervical collar versus cervical traction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cervical_collar_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Cervical collar",
                    "Cervical traction"
                  ],
                  "rows": [
                    [
                      "Main function",
                      "External support and motion restriction",
                      "Applies a controlled pulling force"
                    ],
                    [
                      "Mechanism",
                      "Mechanical support around the neck",
                      "Force transmitted through a prescribed traction system"
                    ],
                    [
                      "Common setting",
                      "Selected trauma and cervical support situations",
                      "Selected specialist-managed spinal conditions"
                    ],
                    [
                      "Application",
                      "Collar fitted around the neck",
                      "Requires a dedicated traction system and clinical supervision"
                    ],
                    [
                      "Main risk",
                      "Pressure injury and inadequate restriction",
                      "Neurological injury, over-distraction or other traction-related complications"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These are different devices with different indications. Cervical traction is not a routine extension of collar application."
                }
              ]
            }
          ]
        },
