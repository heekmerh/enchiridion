        {
          "subsection_id": "cervical_collar_subsection_13",
          "subsection_title": "Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cervical_collar_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a cervical collar, an external orthopaedic device used to support the neck and restrict cervical spine movement in selected clinical situations, particularly suspected cervical spine injury. It may be soft, semi-rigid or rigid, and some rigid collars have anterior and posterior panels, chin support, fastening straps and an adjustment mechanism. It is used alongside appropriate spinal motion restriction and clinical assessment. Its advantages include portability and external support, while its disadvantages include incomplete immobilisation, discomfort and the risk of pressure injury. Complications include skin breakdown, dysphagia, inadequate spinal motion restriction and, in susceptible patients, raised intracranial pressure. Safe use requires appropriate sizing, avoidance of forced positioning, airway monitoring and regular reassessment.”"
                }
              ]
            }
          ]
        }
      ]
