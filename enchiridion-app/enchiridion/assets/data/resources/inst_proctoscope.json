  "sections": [
    {
      "section_id": "inst_proctoscope_section_1",
      "section_title": "Proctoscope",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "inst_proctoscope_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_proctoscope_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_proctoscope_01.webp",
                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_proctoscope_subsection_2",
          "subsection_title": "Identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_proctoscope_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A proctoscope is an instrument used to examine the anal canal and lower rectum. It allows direct visualization of the lining of these structures and may facilitate selected diagnostic or therapeutic procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Classification: Surgical and colorectal diagnostic instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Principle: Direct visualization through a short, hollow tube inserted into the anal canal and rectum."
                },
                {
                  "type": "paragraph",
                  "text": "Key identifying features: A short, rigid or disposable tubular instrument, usually with an obturator to facilitate insertion."
                },
                {
                  "type": "paragraph",
                  "text": "Common indications: Assessment of rectal bleeding, anal or rectal lesions, suspected distal proctitis and selected anorectal disorders."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE distinction: A proctoscope examines the anal canal and lower rectum. A sigmoidoscope examines a longer section of the rectum and sigmoid colon."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_proctoscope_subsection_3",
          "subsection_title": "Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_proctoscope_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Investigating rectal bleeding and selected anorectal symptoms."
                },
                {
                  "type": "paragraph",
                  "text": "Assessing suspected internal haemorrhoids."
                },
                {
                  "type": "paragraph",
                  "text": "Identifying anal canal or distal rectal lesions."
                },
                {
                  "type": "paragraph",
                  "text": "Evaluating selected cases of suspected proctitis."
                },
                {
                  "type": "paragraph",
                  "text": "Supporting selected procedures, such as haemorrhoid treatment, when indicated and performed by appropriately trained clinicians."
                },
                {
                  "type": "paragraph",
                  "text": "Obtaining targeted biopsies or other samples when the instrument and clinical setting permit."
                },
                {
                  "type": "paragraph",
                  "text": "The examination should be guided by the patient's symptoms, clinical stability and the need for further investigation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_proctoscope_subsection_4",
          "subsection_title": "Parts and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_proctoscope_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_proctoscope_02.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_proctoscope_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "A. Tubular barrel"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Forms the passage through which the anal canal and distal rectum are viewed. It may be reusable metal or single-use plastic."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_proctoscope_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Obturator"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A smooth, rounded insert that fills the barrel opening during insertion, helping reduce trauma. It is removed once the instrument is appropriately positioned."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_proctoscope_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "C. Handle or grip"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Allows the examiner to control and stabilize the instrument during examination."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_proctoscope_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "D. Light source or illumination attachment"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Illuminates the lumen to improve visualization. The arrangement varies with the model."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_proctoscope_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "E. Lubricant"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Reduces friction during insertion and helps minimize discomfort and mucosal trauma."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_proctoscope_subsection_5",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_proctoscope_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Provides direct visualization of the anal canal and lower rectum."
                },
                {
                  "type": "paragraph",
                  "text": "Helps identify internal haemorrhoids, mucosal inflammation and distal lesions."
                },
                {
                  "type": "paragraph",
                  "text": "Can support targeted sampling and selected therapeutic procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Relatively quick and usually does not require general anaesthesia for a routine examination."
                },
                {
                  "type": "paragraph",
                  "text": "Reusable models can be sterilized according to the manufacturer's instructions."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_proctoscope_subsection_6",
          "subsection_title": "Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_proctoscope_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "May cause discomfort, pain or embarrassment."
                },
                {
                  "type": "paragraph",
                  "text": "Examines only a limited portion of the lower gastrointestinal tract."
                },
                {
                  "type": "paragraph",
                  "text": "Cannot exclude disease higher in the colon."
                },
                {
                  "type": "paragraph",
                  "text": "Poor preparation, faecal material or bleeding may obscure visualization."
                },
                {
                  "type": "paragraph",
                  "text": "Insertion may be difficult in patients with anal stenosis, severe pain or abnormal anatomy."
                },
                {
                  "type": "paragraph",
                  "text": "Mucosal injury, bleeding and, rarely, perforation can occur."
                },
                {
                  "type": "paragraph",
                  "text": "Important: A normal proctoscopic examination does not exclude colorectal malignancy or other disease outside the area visualized. Further investigation may be necessary."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_proctoscope_subsection_7",
          "subsection_title": "Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_proctoscope_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Before the examination:"
                },
                {
                  "type": "paragraph",
                  "text": "Confirm the patient's identity, indication and relevant history."
                },
                {
                  "type": "paragraph",
                  "text": "Explain the procedure, including expected discomfort, and obtain informed consent."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure privacy and offer a chaperone according to local policy and patient preference."
                },
                {
                  "type": "paragraph",
                  "text": "Review symptoms such as rectal bleeding, severe anal pain, altered bowel habits and previous anorectal surgery."
                },
                {
                  "type": "paragraph",
                  "text": "Check whether bowel preparation, such as a prescribed enema, is indicated under local protocol."
                },
                {
                  "type": "paragraph",
                  "text": "Prepare the proctoscope, lubricant, gloves, appropriate light source and any required specimen containers."
                },
                {
                  "type": "paragraph",
                  "text": "Position the patient comfortably, commonly in the left lateral position."
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the perianal region before insertion."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Precautions"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Do not force the instrument against resistance."
                },
                {
                  "type": "paragraph",
                  "text": "Stop if severe pain, unexpected resistance or significant bleeding occurs."
                },
                {
                  "type": "paragraph",
                  "text": "Assess suspected acute anorectal injury or perforation before attempting instrumentation."
                },
                {
                  "type": "paragraph",
                  "text": "Use an appropriate infection-prevention procedure for reusable or disposable equipment."
                },
                {
                  "type": "paragraph",
                  "text": "A digital rectal examination may be performed first when appropriate, but it should not be forced when contraindicated or intolerable."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_proctoscope_subsection_8",
          "subsection_title": "How to use it — step-by-step OSCE demonstration",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_proctoscope_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_proctoscope_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 1: Introduce and explain"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Confirm the indication, explain what the patient will experience, obtain consent and arrange a chaperone according to local policy."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_proctoscope_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 2: Position and inspect"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Position the patient, usually in the left lateral position with knees flexed. Inspect the perianal region for lesions, fissures, inflammation or external haemorrhoids."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_proctoscope_10.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 3: Prepare the instrument"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Check the instrument and illumination, apply suitable lubricant and ensure the obturator is correctly fitted. Perform a digital rectal examination first if indicated and appropriate."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 4: Insert gently"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A trained examiner introduces the lubricated instrument gently, following the appropriate anatomical direction and device instructions. Never force insertion against resistance."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 5: Remove the obturator"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Once the instrument is appropriately positioned, remove the obturator carefully according to the device instructions."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 6: Inspect the mucosa"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Use the illumination to inspect the visible anal canal and lower rectum systematically. Note mucosal inflammation, haemorrhoids, lesions, blood or other abnormalities."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 7: Withdraw and document"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Withdraw gently, reassess the patient and document the findings, tolerance of the examination and any samples or follow-up investigations required."
                }
              ]
            },
            {
              "group_id": "inst_proctoscope_group_9",
              "group_title": "What should you inspect?",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Structure or feature",
                    "Findings to look for"
                  ],
                  "rows": [
                    [
                      "Anal canal",
                      "Haemorrhoids, ulceration, lesions or inflammation"
                    ],
                    [
                      "Distal rectal mucosa",
                      "Erythema, friability, ulceration or masses"
                    ],
                    [
                      "Bleeding",
                      "Fresh blood, clots or a suspected bleeding point"
                    ],
                    [
                      "Secretions",
                      "Mucus, pus or abnormal discharge"
                    ],
                    [
                      "Lesions",
                      "Site, size, appearance and any contact bleeding"
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_proctoscope_subsection_9",
          "subsection_title": "Contraindications and complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_proctoscope_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Contraindications are context-dependent. Severe anal pain, suspected perforation, significant anorectal trauma or severe narrowing may require deferral or specialist assessment."
                },
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Recognition or prevention"
                  ],
                  "rows": [
                    [
                      "Pain or discomfort",
                      "Explain the procedure, lubricate adequately and proceed gently."
                    ],
                    [
                      "Mucosal trauma",
                      "Avoid forceful insertion or movement."
                    ],
                    [
                      "Bleeding",
                      "Stop and assess if significant or unexpected bleeding occurs."
                    ],
                    [
                      "Vasovagal episode",
                      "Watch for pallor, sweating, nausea, dizziness or fainting."
                    ],
                    [
                      "Infection transmission",
                      "Use appropriate cleaning, disinfection or sterilization procedures."
                    ],
                    [
                      "Perforation",
                      "Rare but serious; avoid force and stop if unexpected resistance or severe pain occurs."
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_proctoscope_subsection_10",
          "subsection_title": "Normal and abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_proctoscope_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Normal findings"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "No visible mass or suspicious lesion in the examined area."
                },
                {
                  "type": "paragraph",
                  "text": "Mucosa appears healthy without significant ulceration or inflammation."
                },
                {
                  "type": "paragraph",
                  "text": "No unexpected bleeding or abnormal discharge."
                },
                {
                  "type": "paragraph",
                  "text": "Examination is tolerated without significant complications."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Abnormal findings"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Enlarged internal haemorrhoids."
                },
                {
                  "type": "paragraph",
                  "text": "Friable, inflamed or ulcerated mucosa."
                },
                {
                  "type": "paragraph",
                  "text": "A visible mass or suspicious lesion."
                },
                {
                  "type": "paragraph",
                  "text": "Fresh blood, pus or abnormal discharge."
                }
              ]
            },
            {
              "group_id": "inst_proctoscope_group_12",
              "group_title": "Example of OSCE reporting",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“On proctoscopy, the visible anal canal and distal rectal mucosa appear erythematous and friable, with contact bleeding. These findings suggest distal mucosal inflammation. I would correlate them with the history and other examination findings and arrange appropriate investigations, including microbiological testing or biopsy if indicated.”"
                },
                {
                  "type": "paragraph",
                  "text": "Do not diagnose malignancy, inflammatory bowel disease or infection from visual appearance alone."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_proctoscope_subsection_11",
          "subsection_title": "Pediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_proctoscope_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Use an appropriately sized instrument and only when clinically indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Explain the procedure in age-appropriate language and obtain consent and assent as appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Involve a parent or guardian according to local policy while maintaining the child's privacy and safeguarding."
                },
                {
                  "type": "paragraph",
                  "text": "Consider appropriate analgesia, comfort measures and specialist support."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid forceful examination in a distressed child or where trauma or another contraindication is suspected."
                },
                {
                  "type": "paragraph",
                  "text": "Pediatric anorectal examination should be performed by clinicians with suitable training."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_proctoscope_subsection_12",
          "subsection_title": "Mnemonic — SCOPE",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_proctoscope_group_14",
              "group_title": "S",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Set up"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Obtain consent, position the patient and prepare the instrument."
                }
              ]
            },
            {
              "group_id": "inst_proctoscope_group_15",
              "group_title": "C",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Check externally"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the perianal region first."
                }
              ]
            },
            {
              "group_id": "inst_proctoscope_group_16",
              "group_title": "O",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Obturator"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Use it correctly for gentle insertion and remove it as instructed."
                }
              ]
            },
            {
              "group_id": "inst_proctoscope_group_17",
              "group_title": "P",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Perform inspection"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the visible mucosa systematically."
                }
              ]
            },
            {
              "group_id": "inst_proctoscope_group_18",
              "group_title": "E",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Evaluate and document"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Record findings, tolerance and follow-up."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_proctoscope_subsection_13",
          "subsection_title": "Common OSCE questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_proctoscope_group_19",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is a proctoscope used for?"
                },
                {
                  "type": "paragraph",
                  "text": "It is used to visualize the anal canal and lower rectum for diagnostic assessment and selected therapeutic procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is the purpose of the obturator?"
                },
                {
                  "type": "paragraph",
                  "text": "It provides a smooth, rounded leading surface during insertion and is removed before the internal examination."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. How does a proctoscope differ from a sigmoidoscope?"
                },
                {
                  "type": "paragraph",
                  "text": "A proctoscope examines the anal canal and lower rectum, whereas a sigmoidoscope examines a longer segment of the rectum and sigmoid colon."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. What position is commonly used?"
                },
                {
                  "type": "paragraph",
                  "text": "The left lateral position with the knees flexed is commonly used, although other positions may be appropriate depending on the setting and patient."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. Name four indications."
                },
                {
                  "type": "paragraph",
                  "text": "Investigation of rectal bleeding, assessment of internal haemorrhoids, evaluation of distal rectal lesions and investigation of suspected proctitis."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What are the complications?"
                },
                {
                  "type": "paragraph",
                  "text": "Pain, mucosal trauma, bleeding, vasovagal symptoms, infection and, rarely, perforation."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What would you do if the patient developed severe pain during insertion?"
                },
                {
                  "type": "paragraph",
                  "text": "I would stop immediately, avoid forcing the instrument, withdraw safely if appropriate and reassess the patient before deciding whether the examination should be abandoned or further evaluation is needed."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. Does a normal proctoscopy exclude colorectal cancer?"
                },
                {
                  "type": "paragraph",
                  "text": "No. It only examines the area within view and cannot exclude lesions higher in the colon. Further investigations may be indicated by the symptoms and clinical risk."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_proctoscope_subsection_14",
          "subsection_title": "Common mistakes and examiner tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_proctoscope_group_20",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Common mistakes"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Confusing a proctoscope with a sigmoidoscope."
                },
                {
                  "type": "paragraph",
                  "text": "Forgetting consent, privacy or a chaperone when indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Failing to inspect the perianal area first."
                },
                {
                  "type": "paragraph",
                  "text": "Inserting without adequate lubrication."
                },
                {
                  "type": "paragraph",
                  "text": "Forcing the instrument against resistance."
                },
                {
                  "type": "paragraph",
                  "text": "Forgetting to remove the obturator before inspection."
                },
                {
                  "type": "paragraph",
                  "text": "Failing to document the location and appearance of lesions."
