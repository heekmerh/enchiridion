        {
          "subsection_id": "bone_saw_subsection_14",
          "subsection_title": "14. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "bone_saw_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a bone saw, an orthopaedic instrument used to cut bone during operations such as osteotomy, amputation and joint replacement. It may be manual or powered, and powered types include oscillating and reciprocating saws. Its advantages include controlled bone division and, with powered designs, rapid cutting. Complications include thermal injury, soft-tissue damage, neurovascular injury and inaccurate bone cuts. Correct blade selection, controlled technique and protection of adjacent structures are essential.”",
                  "style": "quote"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}