                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dressing_forceps_subsection_2",
          "subsection_title": "Introduction and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dressing_forceps_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Dressing forceps are instruments used to hold, manipulate and apply dressings, gauze, swabs and other materials during wound care and surgical procedures. They may also be used to handle tissue, depending on their design."
                },
                {
                  "type": "paragraph",
                  "text": "They are commonly encountered in dressing rooms, minor procedure rooms, operating theatres and clinical skills OSCE stations."
                },
                {
                  "type": "checklist",
                  "items": [
                    "OSCE identification card",
                    "Name: Dressing forceps",
                    "Classification: Grasping and holding instrument"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Primary function: Handling dressings, swabs and other materials during wound care."
                },
                {
                  "type": "paragraph",
                  "text": "Characteristic feature: Slender arms with opposed tips, commonly serrated; some patterns have teeth."
                },
                {
                  "type": "paragraph",
                  "text": "Mechanism: Usually a spring-action, non-locking design."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE tip: Many dressing forceps resemble tweezers rather than ring-handled instruments. They are usually operated by squeezing the arms together and releasing pressure to open them."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dressing_forceps_subsection_3",
          "subsection_title": "Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dressing_forceps_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/dressing_forceps_02.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Description and function"
                  ],
                  "rows": [
                    [
                      "Handle or grip area",
                      "Where the fingers apply pressure to control the instrument."
                    ],
                    [
                      "Arms",
                      "Transfer the applied force towards the tips."
                    ],
                    [
                      "Spring section",
                      "Allows the arms to reopen when pressure is released."
                    ],
                    [
                      "Tips",
                      "Contact and hold dressings, gauze or other material."
                    ],
                    [
                      "Serrations",
                      "Improve grip and reduce slipping."
                    ],
                    [
                      "Teeth, if present",
                      "Provide a more secure grip on selected tissues or materials."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Unlike Mayo-Hegar needle holders, ordinary dressing forceps do not usually have ring handles, a box joint or a ratchet."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dressing_forceps_subsection_4",
          "subsection_title": "Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dressing_forceps_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/dressing_forceps_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "A. Plain dressing forceps"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Have opposed tips without prominent interlocking teeth, often with fine serrations. Commonly used for handling gauze, dressings and swabs."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/dressing_forceps_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Toothed dressing forceps"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Have teeth at the tips to provide a firmer grip. Depending on the pattern, they may be suitable for selected tissue handling, but can traumatize delicate tissue."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/dressing_forceps_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "C. Adson-pattern forceps"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Short forceps with a broad, comfortable grip and relatively fine tips. Plain and toothed versions exist; the toothed type is commonly used for precise skin handling."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/dressing_forceps_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "D. Angled dressing forceps"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Have tips angled relative to the shaft to improve access or visibility in particular wound locations."
                },
                {
                  "type": "paragraph",
                  "text": "Important: Dressing forceps is a broad functional term. Adson forceps, plain dissecting forceps and other patterns may overlap in clinical use, but their precise designs and intended applications differ."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dressing_forceps_subsection_5",
          "subsection_title": "Uses and clinical applications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dressing_forceps_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Use",
                    "Explanation"
                  ],
                  "rows": [
                    [
                      "Wound dressing",
                      "Holding and applying gauze or dressing material."
                    ],
                    [
                      "Wound cleaning",
                      "Holding a swab while cleaning a wound according to the appropriate protocol."
                    ],
                    [
                      "Foreign-material removal",
                      "Removing accessible superficial debris when clinically appropriate."
                    ],
                    [
                      "Suture assistance",
                      "Handling material or assisting with selected superficial procedures."
                    ],
                    [
                      "Skin handling",
                      "Toothed patterns may grasp skin edges during suturing or minor surgery."
                    ],
                    [
                      "Minor procedures",
                      "Holding gauze or manipulating material during incision and drainage or other procedures."
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "dressing_forceps_group_6",
              "group_title": "Clinical procedures where they are used",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Routine wound dressing and wound cleaning."
                },
                {
                  "type": "paragraph",
                  "text": "Suturing of superficial wounds."
                },
                {
                  "type": "paragraph",
                  "text": "Incision and drainage of selected superficial abscesses."
                },
                {
                  "type": "paragraph",
                  "text": "Minor surgical procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Removal of dressings and accessible superficial debris."
                },
                {
                  "type": "paragraph",
                  "text": "Postoperative wound care."
                },
                {
                  "type": "paragraph",
                  "text": "Key distinction: Plain dressing forceps are generally preferred for handling dressings and swabs. Toothed forceps may be appropriate for selected tissue handling, depending on the specific instrument and procedure."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dressing_forceps_subsection_6",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dressing_forceps_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Precise handling: Allows small dressings and swabs to be manipulated accurately."
                },
                {
                  "type": "paragraph",
                  "text": "Improved asepsis: Helps minimize direct hand contact with materials used in the wound."
                },
                {
                  "type": "paragraph",
                  "text": "Good visibility: Slender tips allow access to relatively small areas."
                },
                {
                  "type": "paragraph",
                  "text": "Simple operation: Spring-action designs are straightforward to use."
                },
                {
                  "type": "paragraph",
                  "text": "Variety of tips: Different patterns accommodate dressing work, skin handling and other specific tasks."
                },
                {
                  "type": "paragraph",
                  "text": "Reusable options: Stainless-steel instruments can be reprocessed using validated procedures."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dressing_forceps_subsection_7",
          "subsection_title": "Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dressing_forceps_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Fine tips can slip if the instrument is poorly positioned."
                },
                {
                  "type": "paragraph",
                  "text": "Excessive pressure can damage delicate tissue."
                },
                {
                  "type": "paragraph",
                  "text": "Toothed versions may puncture or tear tissue."
                },
                {
                  "type": "paragraph",
                  "text": "Very small forceps may be difficult to control when wearing gloves or when tactile feedback is reduced."
                },
                {
                  "type": "paragraph",
                  "text": "Spring arms can lose tension or become misaligned with repeated use."
                },
                {
                  "type": "paragraph",
                  "text": "Narrow tips and serrations require thorough cleaning."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dressing_forceps_subsection_8",
          "subsection_title": "Complications of improper use",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dressing_forceps_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Cause",
                    "Prevention"
                  ],
                  "rows": [
                    [
                      "Tissue trauma",
                      "Excessive pressure or inappropriate toothed tips",
                      "Choose the correct pattern and use controlled pressure."
                    ],
                    [
                      "Bleeding",
                      "Grasping or tearing fragile tissue",
                      "Avoid unnecessary traction."
                    ],
                    [
                      "Wound contamination",
                      "Poor aseptic technique or contaminated instrument",
                      "Follow appropriate infection prevention procedures."
                    ],
                    [
                      "Delayed healing",
                      "Repeated trauma to the wound bed",
                      "Handle tissue gently."
                    ],
                    [
                      "Retained dressing material",
                      "Poor visibility or incomplete removal",
                      "Inspect the wound and account for dressing materials."
                    ],
                    [
                      "Instrument-related injury",
                      "Slipping or misdirected tips",
                      "Maintain a stable grip and clear view."
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dressing_forceps_subsection_9",
          "subsection_title": "Principles of proper handling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dressing_forceps_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/dressing_forceps_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 1 — Select the correct type"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Use plain forceps for routine dressing manipulation and a suitable toothed pattern only when the task requires it."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/dressing_forceps_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 2 — Establish a controlled grip"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Hold the forceps in a way that allows fine control of the tips. Avoid squeezing harder than necessary."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/dressing_forceps_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 3 — Handle the dressing or tissue appropriately"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Keep the tips visible where possible and avoid dragging contaminated material across a clean wound or sterile field."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/dressing_forceps_10.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 4 — Inspect and reprocess"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Check the tips for alignment, serrations and damage. Clean and sterilize reusable instruments according to the applicable protocol."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dressing_forceps_subsection_10",
          "subsection_title": "Dressing forceps versus dissecting forceps",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dressing_forceps_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Plain dressing forceps",
                    "Toothed dissecting forceps"
                  ],
                  "rows": [
                    [
                      "Primary function",
                      "Handle dressings, swabs and materials",
                      "Grasp tissue during surgery"
                    ],
                    [
                      "Tip design",
                      "Usually plain or finely serrated",
                      "Often includes interlocking teeth"
                    ],
                    [
                      "Typical use",
                      "Wound care and swabbing",
                      "Skin handling and tissue manipulation"
                    ],
                    [
                      "Tissue trauma",
                      "Generally lower when used appropriately",
                      "Can be greater, depending on the design and tissue"
                    ],
                    [
                      "Locking mechanism",
                      "Usually absent",
                      "Usually absent"
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "dressing_forceps_group_12",
              "group_title": "Dressing forceps versus sponge-holding forceps",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Dressing forceps: Usually small, spring-action forceps used for precise handling of dressings and swabs."
                },
                {
                  "type": "paragraph",
                  "text": "Sponge-holding forceps: Usually larger, ring-handled instruments with oval or loop-like jaws used to hold larger swabs during surgical preparation and operations."
                },
                {
                  "type": "paragraph",
                  "text": "This distinction is particularly useful when the examiner presents several instruments on a tray."
                }
              ]
            }
          ]
        },
