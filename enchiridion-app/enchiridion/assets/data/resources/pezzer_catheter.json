        {
          "subsection_id": "pezzer_catheter_subsection_2",
          "subsection_title": "Introduction and definition",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pezzer_catheter_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A Pezzer catheter is a flexible drainage catheter characterised by a rounded, mushroom-shaped distal head with drainage openings. The enlarged head helps retain the catheter within a cavity, while its hollow lumen allows fluid to drain externally."
                },
                {
                  "type": "paragraph",
                  "text": "It is traditionally associated with suprapubic bladder drainage and may be used in other selected surgical drainage procedures, depending on the device design and clinical indication."
                },
                {
                  "type": "paragraph",
                  "text": "Key OSCE identifying feature: The Pezzer catheter has a smooth, mushroom-shaped retention head, whereas a Malecot catheter has an expanded, winged or flower-shaped tip."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pezzer_catheter_subsection_3",
          "subsection_title": "Identification and characteristic features",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pezzer_catheter_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/pezzer_catheter_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Identification: Pezzer catheter."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Characteristic features"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Flexible, hollow drainage tube."
                },
                {
                  "type": "paragraph",
                  "text": "Rounded, mushroom-shaped distal head."
                },
                {
                  "type": "paragraph",
                  "text": "Drainage openings in or near the enlarged head."
                },
                {
                  "type": "paragraph",
                  "text": "Long shaft providing a drainage pathway."
                },
                {
                  "type": "paragraph",
                  "text": "Proximal connector for attachment to compatible drainage tubing."
                },
                {
                  "type": "paragraph",
                  "text": "Classic designs do not use an inflatable retention balloon."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pezzer_catheter_subsection_4",
          "subsection_title": "Labelling and parts",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pezzer_catheter_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/pezzer_catheter_05.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Function"
                  ],
                  "rows": [
                    [
                      "Mushroom-shaped distal head",
                      "Helps retain the catheter within the cavity."
                    ],
                    [
                      "Drainage openings",
                      "Allow fluid to enter the catheter lumen."
                    ],
                    [
                      "Main shaft",
                      "Conducts fluid away from the cavity."
                    ],
                    [
                      "Proximal connector",
                      "Connects to compatible drainage tubing or a collection system."
                    ],
                    [
                      "External fixation, if required",
                      "Helps prevent accidental displacement."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The exact number and arrangement of drainage openings vary by manufacturer."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pezzer_catheter_subsection_5",
          "subsection_title": "Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pezzer_catheter_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Pezzer catheters may be classified according to:"
                },
                {
                  "type": "paragraph",
                  "text": "Size: Different French gauge sizes are available to suit the anatomical site and drainage requirements."
                },
                {
                  "type": "paragraph",
                  "text": "Material: Traditional rubber designs and modern medical-grade polymer or silicone variants."
                },
                {
                  "type": "paragraph",
                  "text": "Intended use: Urinary drainage and selected surgical cavity drainage."
                },
                {
                  "type": "paragraph",
                  "text": "Configuration: Variations in mushroom-head shape, drainage-hole arrangement and proximal connector."
                },
                {
                  "type": "paragraph",
                  "text": "The term Pezzer catheter describes the characteristic catheter design rather than one universal size or material."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pezzer_catheter_subsection_6",
          "subsection_title": "Principle of operation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pezzer_catheter_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The Pezzer catheter provides drainage through a hollow lumen. Its enlarged mushroom-shaped head helps prevent accidental withdrawal from the cavity."
                },
                {
                  "type": "paragraph",
                  "text": "The principle is straightforward:"
                },
                {
                  "type": "paragraph",
                  "text": "The catheter is placed in the intended cavity using an appropriate clinical or surgical technique."
                },
                {
                  "type": "paragraph",
                  "text": "Fluid enters through the openings near the distal head."
                },
                {
                  "type": "paragraph",
                  "text": "Fluid travels through the lumen."
                },
                {
                  "type": "paragraph",
                  "text": "The proximal end drains into a suitable collection system."
                },
                {
                  "type": "paragraph",
                  "text": "The catheter is secured and monitored to maintain effective drainage."
                },
                {
                  "type": "paragraph",
                  "text": "The mushroom head provides mechanical retention; it does not function like an inflatable Foley balloon."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pezzer_catheter_subsection_7",
          "subsection_title": "Indications and surgical applications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pezzer_catheter_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "A. Suprapubic bladder drainage"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A traditional application is drainage of the urinary bladder through a surgically or procedurally created suprapubic tract when this catheter design is appropriate."
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Selected urinary drainage procedures"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "May be encountered in selected urological procedures requiring drainage through an established tract. The specific catheter and insertion technique depend on the indication."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/pezzer_catheter_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "C. Selected surgical drainage"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Certain designs may be used for cavity drainage when their construction and intended use are appropriate. Do not assume every Pezzer catheter is suitable for every abscess or body cavity."
                }
              ]
            },
            {
              "group_id": "pezzer_catheter_group_8",
              "group_title": "Procedures where it may be encountered",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Selected suprapubic cystostomy procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Selected urological drainage procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Certain surgical drainage procedures using a compatible mushroom-head catheter."
                },
                {
                  "type": "paragraph",
                  "text": "Modern practice often uses other catheter designs, so the Pezzer is not necessarily the first choice in every setting."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pezzer_catheter_subsection_8",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pezzer_catheter_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Mushroom-shaped head provides mechanical retention."
                },
                {
                  "type": "paragraph",
                  "text": "Does not require balloon inflation."
                },
                {
                  "type": "paragraph",
                  "text": "Simple, hollow drainage design."
                },
                {
                  "type": "paragraph",
                  "text": "Can provide effective drainage when correctly positioned."
                },
                {
                  "type": "paragraph",
                  "text": "Available in different sizes for selected applications."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pezzer_catheter_subsection_9",
          "subsection_title": "Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pezzer_catheter_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Insertion and removal may be more difficult than with some other catheter designs."
                },
                {
                  "type": "paragraph",
                  "text": "The enlarged head can cause tissue trauma if manipulated incorrectly."
                },
                {
                  "type": "paragraph",
                  "text": "May become blocked by blood clots, debris or thick fluid."
                },
                {
                  "type": "paragraph",
                  "text": "Requires securement and regular monitoring."
                },
                {
                  "type": "paragraph",
                  "text": "May leak around the insertion site if displaced or obstructed."
                },
                {
                  "type": "paragraph",
                  "text": "Is not suitable for all drainage sites or all urinary catheterisation needs."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pezzer_catheter_subsection_10",
          "subsection_title": "Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pezzer_catheter_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "A. Tissue trauma and bleeding"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The enlarged mushroom head may injure surrounding tissue during insertion, traction or removal."
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Catheter blockage"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Blood clots, debris or thick secretions may obstruct the drainage openings or lumen."
                },
                {
                  "type": "checklist",
                  "items": [
                    "C. Leakage around the catheter"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Blockage, displacement or poor positioning may result in fluid leakage around the insertion site."
                },
                {
                  "type": "checklist",
                  "items": [
                    "D. Infection"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Infection may affect the insertion site or the drained urinary tract or cavity."
                },
                {
                  "type": "checklist",
                  "items": [
                    "E. Displacement or difficult removal"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The catheter may slip out, become trapped or cause injury if excessive traction is applied."
                },
                {
                  "type": "paragraph",
                  "text": "Additional complications depend on the anatomical site and may include urinary tract infection, haematuria, urine extravasation and injury to adjacent structures."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pezzer_catheter_subsection_11",
          "subsection_title": "Care and safety precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pezzer_catheter_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Confirm the intended drainage site and the catheter's suitability."
                },
                {
                  "type": "paragraph",
                  "text": "Maintain aseptic technique during insertion and catheter care."
                },
                {
                  "type": "paragraph",
                  "text": "Secure the external shaft and connect it to the prescribed drainage system."
                },
                {
                  "type": "paragraph",
                  "text": "Monitor drainage volume, colour, patency and leakage."
                },
                {
                  "type": "paragraph",
                  "text": "Assess for fever, pain, bleeding and signs of infection."
                },
                {
                  "type": "paragraph",
                  "text": "Follow the prescribed protocol for flushing or managing suspected blockage."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid pulling forcefully on the catheter."
                },
                {
                  "type": "paragraph",
                  "text": "If the catheter becomes displaced, blocked or difficult to remove, obtain appropriate clinical assistance rather than manipulating it blindly."
                },
                {
                  "type": "paragraph",
                  "text": "Important: If a suprapubic catheter becomes dislodged, prompt clinical assessment is necessary because the tract can narrow or close. Reinsertion should be undertaken by an appropriately trained clinician."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pezzer_catheter_subsection_12",
          "subsection_title": "Pezzer versus Malecot versus Foley catheter",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pezzer_catheter_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This comparison is particularly useful in surgical and urological OSCE stations."
                },
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Pezzer",
                    "Malecot",
                    "Foley"
                  ],
                  "rows": [
                    [
                      "Distal tip",
                      "Mushroom-shaped",
                      "Winged or flower-shaped",
                      "Smooth tip with drainage eyes"
                    ],
                    [
                      "Retention",
                      "Enlarged mushroom head",
                      "Expanded wings",
                      "Inflatable balloon"
                    ],
                    [
                      "Balloon inflation channel",
                      "Absent in classic design",
                      "Absent in classic design",
                      "Present"
                    ],
                    [
                      "Common association",
                      "Suprapubic bladder drainage",
                      "Selected urinary and surgical cavity drainage",
                      "Indwelling bladder catheterisation"
                    ],
                    [
                      "Key identifying feature",
                      "Rounded mushroom head",
                      "Multiple projecting wings",
                      "Balloon-retention system"
                    ],
                    [
                      "Important risk",
                      "Tissue trauma or difficult removal",
                      "Wing-related trauma or difficult removal",
                      "Balloon-related urethral injury if inflated in the wrong location"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Memory aid:"
                },
                {
                  "type": "paragraph",
                  "text": "Pezzer = Petal-less mushroom head."
                },
                {
                  "type": "paragraph",
                  "text": "Malecot = Multiple wings."
                },
                {
                  "type": "paragraph",
                  "text": "Foley = Filled balloon."
                },
                {
                  "type": "paragraph",
                  "text": "These are visual memory aids, not substitutes for examining the actual device."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pezzer_catheter_subsection_13",
          "subsection_title": "High-yield OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pezzer_catheter_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. Identify the instrument."
                },
                {
                  "type": "paragraph",
                  "text": "This is a Pezzer catheter, a hollow drainage catheter characterised by an enlarged, mushroom-shaped distal head."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is the function of the mushroom-shaped head?"
                },
                {
                  "type": "paragraph",
                  "text": "It helps retain the catheter within the intended cavity and reduces accidental withdrawal."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What is a traditional use of the Pezzer catheter?"
                },
                {
                  "type": "paragraph",
                  "text": "Suprapubic bladder drainage in selected surgical or urological circumstances."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. How does it differ from a Malecot catheter?"
                },
                {
                  "type": "paragraph",
                  "text": "The Pezzer has a rounded mushroom-shaped head, while the Malecot has an expanded, winged or flower-shaped tip."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. How does it differ from a Foley catheter?"
                },
                {
                  "type": "paragraph",
                  "text": "A classic Pezzer relies on its enlarged head for retention, whereas a Foley uses an inflatable balloon."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What are its main complications?"
                },
                {
                  "type": "paragraph",
                  "text": "Tissue trauma, bleeding, blockage, leakage, infection, displacement and difficult removal."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What would you do if drainage suddenly stopped?"
                },
                {
                  "type": "paragraph",
                  "text": "Assess the patient and drainage system, check for kinking or displacement, and seek clinical review. Do not forcefully flush or manipulate the catheter without an appropriate order and protocol."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pezzer_catheter_subsection_14",
          "subsection_title": "High-yield examination tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pezzer_catheter_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Identify the mushroom-shaped distal head immediately."
                },
                {
                  "type": "paragraph",
                  "text": "Label the head, drainage openings, shaft and proximal connector."
                },
                {
                  "type": "paragraph",
                  "text": "State that it relies on mechanical retention rather than a balloon."
                },
                {
                  "type": "paragraph",
                  "text": "Know its traditional association with suprapubic bladder drainage."
                },
                {
                  "type": "paragraph",
                  "text": "Differentiate it clearly from the winged Malecot and balloon-retained Foley."
                },
                {
                  "type": "paragraph",
                  "text": "Mention blockage, infection, bleeding and difficult removal."
                },
                {
                  "type": "paragraph",
                  "text": "Emphasise securement, drainage monitoring and safe handling."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pezzer_catheter_subsection_15",
          "subsection_title": "Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pezzer_catheter_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a Pezzer catheter, a flexible hollow drainage catheter with a characteristic mushroom-shaped distal head. The enlarged head helps retain the catheter within the intended cavity, while the drainage openings allow fluid to enter the lumen and pass to an external collection system. It is traditionally associated with selected suprapubic bladder drainage procedures. Its advantages include a simple design and mechanical retention without a balloon. Complications include tissue trauma, bleeding, blockage, leakage, infection, displacement and difficult removal.”"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}