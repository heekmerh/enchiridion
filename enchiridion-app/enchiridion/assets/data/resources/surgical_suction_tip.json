        {
          "subsection_id": "surgical_suction_tip_subsection_2",
          "subsection_title": "1. Introduction and definition",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "surgical_suction_tip_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A surgical suction tip is an instrument connected to a suction system to remove blood, irrigation fluid, secretions and other fluids from an operative field."
                },
                {
                  "type": "paragraph",
                  "text": "It helps the surgeon maintain visibility, identify anatomical structures, reduce fluid accumulation and perform procedures safely."
                },
                {
                  "type": "paragraph",
                  "text": "The tip is attached to suction tubing, which connects to a suction source or collection system."
                },
                {
                  "type": "list",
                  "title": "Key OSCE point: The three classic suction tips you should distinguish are:",
                  "items": [
                    {
                      "text": "Yankauer: General-purpose suction, commonly used in the mouth and oropharynx and for superficial operative suction.",
                      "level": 0
                    },
                    {
                      "text": "Poole: Designed primarily for suctioning larger volumes of fluid from the abdominal cavity.",
                      "level": 0
                    },
                    {
                      "text": "Frazier: A narrow suction cannula used for precise suction in small, confined operative fields, particularly neurosurgery and ENT procedures.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "surgical_suction_tip_subsection_3",
          "subsection_title": "2. Identification and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "surgical_suction_tip_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/surgical_suction_tip_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A. Yankauer suction tip"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Rigid, curved cannula.",
                      "level": 0
                    },
                    {
                      "text": "Rounded, bulbous distal head.",
                      "level": 0
                    },
                    {
                      "text": "Multiple openings near the tip, depending on the design.",
                      "level": 0
                    },
                    {
                      "text": "Handle or shaft with a suction-control vent on many models.",
                      "level": 0
                    },
                    {
                      "text": "Commonly made from plastic or metal.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/surgical_suction_tip_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "B. Poole suction tip"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Usually has a perforated outer sheath.",
                      "level": 0
                    },
                    {
                      "text": "Inner suction tube connects to the suction source.",
                      "level": 0
                    },
                    {
                      "text": "Numerous side openings distribute suction over a larger area.",
                      "level": 0
                    },
                    {
                      "text": "The outer sheath helps reduce the risk of drawing bowel or omentum directly into a single large opening.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/surgical_suction_tip_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "C. Frazier suction tip"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Long, narrow, slender cannula.",
                      "level": 0
                    },
                    {
                      "text": "Small distal opening.",
                      "level": 0
                    },
                    {
                      "text": "Often has a curved or angled tip.",
                      "level": 0
                    },
                    {
                      "text": "Usually features a finger-control vent to regulate suction.",
                      "level": 0
                    },
                    {
                      "text": "Designed for controlled suction in narrow operative spaces.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "surgical_suction_tip_subsection_4",
          "subsection_title": "3. Parts and their functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "surgical_suction_tip_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Function"
                  ],
                  "rows": [
                    [
                      "Distal tip/opening",
                      "Directs suction to the target area."
                    ],
                    [
                      "Side holes/perforated sheath",
                      "Distribute suction and may reduce tissue capture, depending on design."
                    ],
                    [
                      "Cannula or shaft",
                      "Carries fluid from the operative field."
                    ],
                    [
                      "Finger-control vent",
                      "Allows the operator to regulate suction by covering or uncovering the vent."
                    ],
                    [
                      "Proximal connector",
                      "Attaches the tip to suction tubing."
                    ],
                    [
                      "Suction tubing",
                      "Transports fluid to the collection canister."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Not every model has every component. In an OSCE, label only the features present on the instrument displayed."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "surgical_suction_tip_subsection_5",
          "subsection_title": "4. Classification of surgical suction tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "surgical_suction_tip_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Suction tips may be classified by their design, intended anatomical site, and degree of suction control."
                },
                {
                  "type": "table",
                  "columns": [
                    "Type",
                    "Main characteristic",
                    "Common application"
                  ],
                  "rows": [
                    [
                      "Yankauer",
                      "Rigid, rounded, relatively broad head",
                      "Oropharyngeal and general surgical suction"
                    ],
                    [
                      "Poole",
                      "Perforated outer sheath",
                      "Abdominal cavity suction"
                    ],
                    [
                      "Frazier",
                      "Fine, narrow cannula",
                      "Neurosurgery, ENT and delicate operative fields"
                    ],
                    [
                      "Baron",
                      "Fine suction cannula, commonly used in otology",
                      "Ear surgery"
                    ],
                    [
                      "Adson",
                      "Small suction tip in certain instrument ranges",
                      "Selected delicate surgical procedures"
                    ],
                    [
                      "Flexible suction catheter",
                      "Soft, flexible tubing",
                      "Airway suction and selected drainage procedures"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Exam pearl: Baron and Frazier tips may look similar because both can be narrow. Identify the instrument by its design and intended use rather than diameter alone."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "surgical_suction_tip_subsection_6",
          "subsection_title": "5. Principle of operation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "surgical_suction_tip_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Surgical suction works by creating a pressure difference between the operative field and the suction collection system."
                },
                {
                  "type": "paragraph",
                  "text": "When suction is activated, fluid is drawn through the distal opening, travels along the cannula and tubing, and enters a collection canister."
                },
                {
                  "type": "paragraph",
                  "text": "The operator controls suction by positioning the tip, adjusting the suction source where permitted, and using the finger-control vent if the device has one."
                },
                {
                  "type": "list",
                  "title": "Important principles include:",
                  "items": [
                    {
                      "text": "Maintain adequate visibility without damaging tissue.",
                      "level": 0
                    },
                    {
                      "text": "Use the lowest effective suction for the task.",
                      "level": 0
                    },
                    {
                      "text": "Avoid prolonged suction against bowel, mucosa, vessels or delicate structures.",
                      "level": 0
                    },
                    {
                      "text": "Prevent blockage by clots, tissue fragments or debris.",
                      "level": 0
                    },
                    {
                      "text": "Maintain a closed, functioning suction pathway and appropriate infection-control practices.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "surgical_suction_tip_subsection_7",
          "subsection_title": "6. Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "surgical_suction_tip_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/surgical_suction_tip_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A. General and abdominal surgery"
                },
                {
                  "type": "paragraph",
                  "text": "Removes blood, irrigation fluid and accumulated fluid from the operative field. The Poole tip is especially useful for evacuating larger fluid volumes during laparotomy."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/surgical_suction_tip_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "B. Oral and airway-related procedures"
                },
                {
                  "type": "paragraph",
                  "text": "A Yankauer tip can remove secretions, blood and vomitus from the mouth and oropharynx when clinically indicated. It is not a substitute for a suitable fine catheter when deep airway suction is required."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/surgical_suction_tip_08.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "C. Neurosurgery"
                },
                {
                  "type": "paragraph",
                  "text": "A Frazier tip provides controlled suction in narrow operative spaces where precision is important."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/surgical_suction_tip_09.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "D. ENT and microsurgery"
                },
                {
                  "type": "paragraph",
                  "text": "Fine suction cannulas remove small amounts of fluid from confined spaces, including selected ear and nasal procedures."
                }
              ]
            },
            {
              "group_id": "surgical_suction_tip_group_8",
              "group_title": "Surgical procedures in which suction tips may be used",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Laparotomy and bowel surgery.",
                      "level": 0
                    },
                    {
                      "text": "Appendicectomy and cholecystectomy.",
                      "level": 0
                    },
                    {
                      "text": "Caesarean section and selected gynaecological operations.",
                      "level": 0
                    },
                    {
                      "text": "Thyroid and neck surgery.",
                      "level": 0
                    },
                    {
                      "text": "Neurosurgical procedures.",
                      "level": 0
                    },
                    {
                      "text": "ENT and otological surgery.",
                      "level": 0
                    },
                    {
                      "text": "Oral and maxillofacial surgery.",
                      "level": 0
                    },
                    {
                      "text": "Wound irrigation and debridement.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The precise tip is selected according to the anatomical site, required suction volume and tissue fragility."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "surgical_suction_tip_subsection_8",
          "subsection_title": "7. Advantages and disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "surgical_suction_tip_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Instrument",
                    "Advantages",
                    "Disadvantages"
                  ],
                  "rows": [
                    [
                      "Yankauer",
                      "Robust, easy to handle, useful for general suction",
                      "Bulky for delicate spaces; may injure tissue if used carelessly"
                    ],
                    [
                      "Poole",
                      "Efficient removal of large fluid volumes; distributed openings",
                      "Larger and less precise; perforations can become blocked"
                    ],
                    [
                      "Frazier",
                      "Precise suction; narrow profile; often has controllable suction",
                      "Small lumen is prone to blockage; may cause focal tissue injury if suction is excessive"
                    ],
                    [
                      "Flexible catheter",
                      "Can reach curved or narrow passages",
                      "May kink or collapse; less rigid control"
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "surgical_suction_tip_subsection_9",
          "subsection_title": "8. Complications and risks",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "surgical_suction_tip_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Tissue trauma"
                },
                {
                  "type": "paragraph",
                  "text": "Excessive suction may injure bowel, mucosa, vessels or delicate neural structures."
                },
                {
                  "type": "paragraph",
                  "text": "Bleeding"
                },
                {
                  "type": "paragraph",
                  "text": "Suction may damage fragile tissue or disrupt small vessels and clots."
                },
                {
                  "type": "paragraph",
                  "text": "Blockage"
                },
                {
                  "type": "paragraph",
                  "text": "Blood clots, tissue fragments and debris can obstruct the lumen and reduce suction effectiveness."
                },
                {
                  "type": "paragraph",
                  "text": "Contamination and infection"
                },
                {
                  "type": "paragraph",
                  "text": "Improper handling, reuse of single-use devices or inadequate reprocessing of reusable instruments can introduce pathogens."
                },
                {
                  "type": "paragraph",
                  "text": "Other risks include accidental injury during insertion, damage from inappropriate suction pressure, and loss of visibility if the instrument becomes blocked or disconnected."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "surgical_suction_tip_subsection_10",
          "subsection_title": "9. Care, handling and safety",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "surgical_suction_tip_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Check the instrument for damage, blockage and correct assembly before use.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Confirm that the suction tubing, connector and collection canister are functioning.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Select the appropriate tip for the procedure.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Set suction according to the clinical indication, device instructions and local protocol.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Avoid applying suction directly to delicate tissue for prolonged periods.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "If the tip becomes blocked, stop suction and clear or replace it using the approved procedure.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Dispose of single-use tips appropriately. Reusable instruments must undergo validated cleaning and sterilisation according to their instructions for use.",
                      "level": 0,
                      "label": "7."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "surgical_suction_tip_subsection_11",
          "subsection_title": "10. High-yield OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "surgical_suction_tip_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. Identify the three common surgical suction tips."
                },
                {
                  "type": "paragraph",
                  "text": "Yankauer, Poole and Frazier suction tips."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Which suction tip is preferred for abdominal cavity suction? Why?"
                },
                {
                  "type": "paragraph",
                  "text": "The Poole suction tip. Its perforated outer sheath distributes suction across multiple openings and is designed for evacuating larger volumes of fluid while reducing direct tissue capture."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Which tip is used for delicate neurosurgical procedures?"
                },
                {
                  "type": "paragraph",
                  "text": "The Frazier suction tip, because its narrow cannula allows precise, controlled suction in confined operative spaces."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. What is the purpose of the finger-control vent?"
                },
                {
                  "type": "paragraph",
                  "text": "It allows the operator to regulate suction by covering or uncovering the vent, depending on the instrument's design."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. Why should a Poole tip be used instead of a fine Frazier tip for large-volume abdominal suction?"
                },
                {
                  "type": "paragraph",
                  "text": "The Poole is designed for higher-volume fluid evacuation, whereas the narrow Frazier lumen is intended for more precise suction and is more susceptible to blockage."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What would you do if the suction tip stopped working during surgery?"
                },
                {
                  "type": "paragraph",
                  "text": "Alert the surgical team as appropriate, check the suction source, tubing, connections and collection system, and assess for blockage. Restore suction using an approved method or replace the instrument. Maintain haemostasis and operative visibility while the problem is corrected."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What are the main complications of surgical suction?"
                },
                {
                  "type": "paragraph",
                  "text": "Tissue trauma, bleeding, mucosal injury, blockage, contamination and injury to delicate anatomical structures."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "surgical_suction_tip_subsection_12",
          "subsection_title": "11. Quick identification challenge",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "surgical_suction_tip_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "1. A perforated outer sheath is characteristic of:"
                },
                {
                  "type": "paragraph",
                  "text": "Frazier tip"
                },
                {
                  "type": "paragraph",
                  "text": "Poole tip"
                },
                {
                  "type": "paragraph",
                  "text": "Yankauer tip"
                },
                {
                  "type": "paragraph",
                  "text": "2. A slender cannula with a fine opening is most characteristic of:"
                },
                {
                  "type": "paragraph",
                  "text": "Poole tip"
                },
                {
                  "type": "paragraph",
                  "text": "Yankauer tip"
                },
                {
                  "type": "paragraph",
                  "text": "Frazier tip"
                },
                {
                  "type": "paragraph",
                  "text": "3. Which tip is commonly used for oropharyngeal suction?"
                },
                {
                  "type": "paragraph",
                  "text": "Yankauer tip"
                },
                {
                  "type": "paragraph",
                  "text": "Poole tip"
                },
                {
                  "type": "paragraph",
                  "text": "Frazier tip"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "surgical_suction_tip_subsection_13",
          "subsection_title": "12. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "surgical_suction_tip_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a surgical suction tip, an instrument connected to a suction system for removing blood, irrigation fluid and secretions from the operative field. Common types include the Yankauer, Poole and Frazier tips. The Yankauer is commonly used for oropharyngeal suction, the Poole for large-volume abdominal suction, and the Frazier for precise suction in confined operative spaces. Its advantages include improved visibility and fluid removal. Complications include tissue trauma, bleeding, blockage and contamination.”",
                  "style": "quote"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
