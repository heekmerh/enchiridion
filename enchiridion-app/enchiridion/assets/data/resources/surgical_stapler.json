      "section_id": "surgical_stapler_section_1",
      "section_title": "Surgical stapler",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "surgical_stapler_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "surgical_stapler_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
