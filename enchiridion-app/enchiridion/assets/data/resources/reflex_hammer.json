  "sections": [
    {
      "section_id": "reflex_hammer_section_1",
      "section_title": "Reflex hammer",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "reflex_hammer_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "reflex_hammer_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/reflex_hammer_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A reflex hammer is a neurological examination instrument used to elicit deep tendon reflexes and assess the integrity of the reflex arc, including peripheral nerves, spinal cord segments, and descending motor pathways."
                },
                {
                  "type": "paragraph",
                  "text": "It is commonly tested in OSCEs involving the neurological examination, especially assessment of the biceps, triceps, brachioradialis, patellar, and Achilles tendon reflexes."
                },
                {
                  "type": "paragraph",
                  "text": "Key principle: Reflexes help distinguish upper motor neuron patterns from lower motor neuron patterns when interpreted alongside muscle tone, power, sensation, and other neurological findings."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "reflex_hammer_subsection_2",
          "subsection_title": "1. Identification and definition",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "reflex_hammer_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Name: Reflex hammer.",
                      "level": 0
                    },
                    {
                      "text": "Main function: Elicitation of tendon reflexes.",
                      "level": 0
                    },
                    {
                      "text": "Common examination areas: Upper and lower limbs.",
                      "level": 0
                    },
                    {
                      "text": "Clinical purpose: Assessment of neurological function and localisation of lesions.",
                      "level": 0
                    },
                    {
                      "text": "Typical construction: A handle with a rubber or synthetic striking head.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "reflex_hammer_subsection_3",
          "subsection_title": "2. Types of reflex hammers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "reflex_hammer_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/reflex_hammer_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A. Taylor hammer"
                },
                {
                  "type": "paragraph",
                  "text": "Has a triangular or wedge-shaped rubber head. Commonly used for routine deep tendon reflex testing."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/reflex_hammer_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "B. Queen Square hammer"
                },
                {
                  "type": "paragraph",
                  "text": "Has a long handle and a relatively small head. The long handle can help the examiner deliver a controlled strike."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/reflex_hammer_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "C. Babinski hammer"
                },
                {
                  "type": "paragraph",
                  "text": "Typically has a larger striking head and a long handle. Some models have a pointed end for selected neurological examination manoeuvres."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "reflex_hammer_subsection_4",
          "subsection_title": "3. Components and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "reflex_hammer_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/reflex_hammer_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "1. Striking head"
                },
                {
                  "type": "paragraph",
                  "text": "Delivers a brief, controlled tap to the tendon or relevant examination point."
                },
                {
                  "type": "paragraph",
                  "text": "2. Handle"
                },
                {
                  "type": "paragraph",
                  "text": "Allows the examiner to control the force and direction of the strike."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/reflex_hammer_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "3. Pointed or specialised end, if present"
                },
                {
                  "type": "paragraph",
                  "text": "May be used for selected neurological examination manoeuvres, depending on the hammer design. It is not used to strike a tendon."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "reflex_hammer_subsection_5",
          "subsection_title": "4. Clinical uses",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "reflex_hammer_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "A reflex hammer is used to:",
                  "items": [
                    {
                      "text": "Assess deep tendon reflexes.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Compare reflexes on the right and left sides.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Identify reduced, absent, or exaggerated reflexes.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Help localise neurological lesions when interpreted with other findings.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Assess the plantar response using the appropriate blunt end or a separate suitable instrument.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Support neurological assessment in patients with suspected neuropathy, radiculopathy, spinal cord disease, or motor pathway disorders.",
                      "level": 0,
                      "label": "6."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important: Reflex findings alone do not establish a diagnosis. They must be interpreted in the context of the complete examination."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "reflex_hammer_subsection_6",
          "subsection_title": "5. How to test deep tendon reflexes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "reflex_hammer_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/reflex_hammer_07.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/reflex_hammer_08.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/reflex_hammer_09.webp",
                  "caption": null
                }
              ]
            },
            {
              "group_id": "reflex_hammer_group_7",
              "group_title": "General technique",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Explain the examination and obtain consent.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Position the patient comfortably and expose the relevant limb appropriately.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Ensure the muscle is relaxed and the tendon is accessible.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Identify the tendon by palpation where necessary.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Hold the reflex hammer loosely and deliver a brief, controlled strike to the tendon.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Observe the resulting muscle contraction and joint movement.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Compare the response with the opposite side.",
                      "level": 0,
                      "label": "7."
                    },
                    {
                      "text": "If the reflex is difficult to elicit, reposition the patient, ensure relaxation, and use reinforcement where appropriate.",
                      "level": 0,
                      "label": "8."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Examiner's tip: Do not repeatedly strike the tendon forcefully. A relaxed limb and correct technique are more important than using excessive force."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "reflex_hammer_subsection_7",
          "subsection_title": "6. Deep tendon reflexes and their spinal levels",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "reflex_hammer_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "These are particularly important for OSCEs."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/reflex_hammer_08.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "1. Biceps reflex"
                },
                {
                  "type": "paragraph",
                  "text": "Spinal roots: C5–C6, predominantly C5"
                },
                {
                  "type": "paragraph",
                  "text": "Support the patient's relaxed forearm, place your thumb over the biceps tendon in the antecubital fossa, and tap your thumb. Look for biceps contraction and elbow flexion."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/reflex_hammer_10.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "2. Triceps reflex"
                },
                {
                  "type": "paragraph",
                  "text": "Spinal roots: C7–C8, predominantly C7"
                },
                {
                  "type": "paragraph",
                  "text": "Support the arm with the elbow flexed and tap the triceps tendon just above its insertion near the olecranon. Look for elbow extension."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/reflex_hammer_11.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "3. Brachioradialis reflex"
                },
                {
                  "type": "paragraph",
                  "text": "Spinal roots: C5–C6, predominantly C6"
                },
                {
                  "type": "paragraph",
                  "text": "Tap the brachioradialis tendon near the distal radius. Look for elbow flexion and forearm movement."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/reflex_hammer_12.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "4. Patellar reflex (knee jerk)"
                },
                {
                  "type": "paragraph",
                  "text": "Spinal roots: L2–L4, predominantly L4"
                },
                {
                  "type": "paragraph",
                  "text": "With the knee flexed and the leg relaxed, tap the patellar tendon below the patella. Look for quadriceps contraction and knee extension."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/reflex_hammer_13.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "5. Achilles reflex (ankle jerk)"
                },
                {
                  "type": "paragraph",
                  "text": "Spinal roots: S1–S2, predominantly S1"
                },
                {
                  "type": "paragraph",
                  "text": "Slightly dorsiflex the foot and tap the Achilles tendon. Look for plantar flexion of the foot."
                }
              ]
            },
            {
              "group_id": "reflex_hammer_group_9",
              "group_title": "Reflex root mnemonic",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“C5, 6, 7; L4; S1”",
                  "style": "quote"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Biceps — C5–C6",
                      "level": 0
                    },
                    {
                      "text": "Brachioradialis — C5–C6",
                      "level": 0
                    },
                    {
                      "text": "Triceps — C7–C8",
                      "level": 0
                    },
                    {
                      "text": "Knee — L2–L4",
                      "level": 0
                    },
                    {
                      "text": "Ankle — S1–S2",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Remember the predominant roots shown above, but reflexes are not supplied by a single root exclusively."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "reflex_hammer_subsection_8",
          "subsection_title": "7. Grading deep tendon reflexes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "reflex_hammer_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A common clinical grading scale is:"
                },
                {
                  "type": "table",
                  "columns": [
                    "Grade",
                    "Meaning"
                  ],
                  "rows": [
                    [
                      "0",
                      "Absent"
                    ],
                    [
                      "1+",
                      "Reduced or diminished"
                    ],
                    [
                      "2+",
                      "Normal"
                    ],
                    [
                      "3+",
                      "Brisk or increased; significance depends on context"
                    ],
                    [
                      "4+",
                      "Very brisk, often with clonus"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Some scales use slightly different descriptions. Always document the scale used and compare sides."
                },
                {
                  "type": "paragraph",
                  "text": "Interpretation matters: A symmetrical 3+ reflex may be normal in some healthy individuals. Asymmetry, associated weakness, altered tone, or clonus is often more informative than the numerical grade alone."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "reflex_hammer_subsection_9",
          "subsection_title": "8. Clinical interpretation: upper versus lower motor neuron patterns",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "reflex_hammer_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Finding",
                    "Upper motor neuron pattern",
                    "Lower motor neuron pattern"
                  ],
                  "rows": [
                    [
                      "Tendon reflexes",
                      "Often increased",
                      "Often reduced or absent"
                    ],
                    [
                      "Muscle tone",
                      "Often increased/spastic",
                      "Often reduced/flaccid"
                    ],
                    [
                      "Muscle wasting",
                      "Usually less prominent initially",
                      "May be prominent"
                    ],
                    [
                      "Plantar response",
                      "May be extensor (Babinski sign)",
                      "Usually flexor or absent"
                    ],
                    [
                      "Fasciculations",
                      "Not typical",
                      "May occur"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These are patterns rather than absolute rules. Acute spinal cord injury, shock, peripheral neuropathy, and mixed neurological disorders can alter the expected findings."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "reflex_hammer_subsection_10",
          "subsection_title": "9. Reinforcement techniques",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "reflex_hammer_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Sometimes a reflex is difficult to elicit despite correct technique."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Jendrassik manoeuvre: The patient hooks their fingers together and pulls against their own hands while the examiner tests the lower-limb reflexes.",
                      "level": 0
                    },
                    {
                      "text": "Upper-limb reinforcement: Ask the patient to clench their teeth or perform another suitable distracting manoeuvre when appropriate.",
                      "level": 0
                    },
                    {
                      "text": "Repositioning: Ensure the limb is relaxed and the tendon is correctly identified.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Reinforcement should help reveal a reflex, not substitute for correct positioning and technique."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "reflex_hammer_subsection_11",
          "subsection_title": "10. Advantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "reflex_hammer_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Advantages"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Simple, portable, and inexpensive.",
                      "level": 0
                    },
                    {
                      "text": "Non-invasive and usually painless.",
                      "level": 0
                    },
                    {
                      "text": "Helps assess peripheral nerves, spinal reflex arcs, and motor pathways.",
                      "level": 0
                    },
                    {
                      "text": "Allows comparison between limbs and serial examinations.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Limitations"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Results depend on examiner technique and patient relaxation.",
                      "level": 0
                    },
                    {
                      "text": "Reflexes can vary between healthy individuals.",
                      "level": 0
                    },
                    {
                      "text": "Abnormal reflexes do not independently establish a diagnosis.",
                      "level": 0
                    },
                    {
                      "text": "Severe weakness, pain, poor positioning, or patient anxiety can affect examination quality.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "reflex_hammer_subsection_12",
          "subsection_title": "11. Precautions and common mistakes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "reflex_hammer_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Explain the examination and obtain consent.",
                      "level": 0
                    },
                    {
                      "text": "Support the limb and ensure the muscle is relaxed.",
                      "level": 0
                    },
                    {
                      "text": "Use a controlled tap rather than striking forcefully.",
                      "level": 0
                    },
                    {
                      "text": "Avoid striking bones or areas of injury.",
                      "level": 0
                    },
                    {
                      "text": "Compare corresponding reflexes on both sides.",
                      "level": 0
                    },
                    {
                      "text": "If a reflex is absent, check positioning and technique before concluding it is pathological.",
                      "level": 0
                    },
                    {
                      "text": "Document the grade, symmetry, and any associated clonus or abnormal movements.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "reflex_hammer_subsection_13",
          "subsection_title": "12. Pediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "reflex_hammer_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Use an appropriately sized hammer and a gentle technique.",
                      "level": 0
                    },
                    {
                      "text": "Keep the child comfortable and explain the procedure in age-appropriate language.",
                      "level": 0
                    },
                    {
                      "text": "Young children may be frightened or unable to relax the limb; distraction can help.",
                      "level": 0
                    },
                    {
                      "text": "Reflexes change with neurological maturation, so findings must be interpreted according to age.",
                      "level": 0
                    },
                    {
                      "text": "Primitive reflexes in infants, such as the Moro reflex and rooting reflex, are assessed using specific techniques and are not the same as deep tendon reflexes.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "reflex_hammer_subsection_14",
          "subsection_title": "13. Mnemonic: B-T-B-K-A",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "reflex_hammer_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Use this sequence to remember the five common deep tendon reflexes:",
                  "items": [
                    {
                      "text": "B — Biceps: C5–C6",
                      "level": 0
                    },
                    {
                      "text": "T — Triceps: C7–C8",
                      "level": 0
                    },
                    {
                      "text": "B — Brachioradialis: C5–C6",
                      "level": 0
                    },
                    {
                      "text": "K — Knee: L2–L4",
                      "level": 0
                    },
                    {
                      "text": "A — Ankle: S1–S2",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "reflex_hammer_subsection_15",
          "subsection_title": "14. Common OSCE examiner questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "reflex_hammer_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is the function of a reflex hammer?"
                },
                {
                  "type": "paragraph",
                  "text": "To elicit deep tendon reflexes during neurological examination."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Which spinal roots supply the knee jerk?"
                },
                {
                  "type": "paragraph",
                  "text": "L2–L4, predominantly L4."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Which spinal root is most associated with the ankle jerk?"
                },
                {
                  "type": "paragraph",
                  "text": "S1."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. What does a brisk reflex suggest?"
                },
                {
                  "type": "paragraph",
                  "text": "It may suggest increased reflex excitability, as can occur with an upper motor neuron lesion, but must be interpreted with the rest of the neurological examination."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What does an absent reflex suggest?"
                },
                {
                  "type": "paragraph",
                  "text": "It may indicate dysfunction of the reflex arc, peripheral nerve, nerve root, or related structures. Technique and positioning should be checked first."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What is the Jendrassik manoeuvre?"
                },
                {
                  "type": "paragraph",
                  "text": "A reinforcement technique in which the patient hooks their fingers together and pulls while the examiner tests a reflex, commonly the knee jerk."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What is clonus?"
                },
                {
                  "type": "paragraph",
                  "text": "A series of rhythmic, involuntary muscle contractions triggered by sudden sustained stretching of a muscle. Sustained clonus can indicate an upper motor neuron disorder in the appropriate clinical context."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "reflex_hammer_subsection_16",
          "subsection_title": "15. Mini OSCE station",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "reflex_hammer_group_18",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Scenario: You are asked to examine the lower-limb deep tendon reflexes in a patient with suspected neurological disease."
                },
                {
                  "type": "list",
                  "title": "Expected approach:",
                  "items": [
                    {
                      "text": "Explain the examination and obtain consent.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Position the patient comfortably and ensure the legs are relaxed.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Elicit the patellar reflex by tapping the patellar tendon.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Elicit the Achilles reflex by tapping the Achilles tendon.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Compare both sides and grade the responses.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Use reinforcement if a reflex is difficult to elicit.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Document the findings and interpret them alongside tone, power, sensation, and plantar responses.",
                      "level": 0,
                      "label": "7."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Example report: “The knee and ankle reflexes are present and symmetrical bilaterally, graded 2+. No clonus is elicited.”"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}