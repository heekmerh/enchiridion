            {
              "group_id": "bone_lever_group_17",
              "group_title": "Final high-yield summary",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Identification: Instrument used for controlled leverage, bone manipulation, or bone-associated retraction, depending on the design.",
                      "level": 0
                    },
                    {
                      "text": "Main parts: Handle, shaft, and working end.",
                      "level": 0
                    },
                    {
                      "text": "Principle: Mechanical leverage.",
                      "level": 0
                    },
                    {
                      "text": "Important distinction: A Hohmann retractor is primarily a retractor, while a bone hook is intended to engage bone.",
                      "level": 0
                    },
                    {
                      "text": "Major risks: Unintended fracture, instrument slippage, and injury to adjacent neurovascular structures.",
                      "level": 0
                    },
                    {
                      "text": "Safety priority: Use the correct instrument for the intended task and avoid excessive force.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}