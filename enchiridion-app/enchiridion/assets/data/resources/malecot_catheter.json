        },
        {
          "subsection_id": "malecot_catheter_subsection_2",
          "subsection_title": "1. Introduction and definition",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "malecot_catheter_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A Malecot catheter is a drainage catheter characterised by an expanded, winged or flower-shaped distal tip. The wings help retain the catheter within a cavity or organ while allowing fluid to drain through openings near the tip."
                },
                {
                  "type": "paragraph",
                  "text": "It is commonly associated with drainage of the urinary bladder or kidney and may also be used for selected surgical drainage procedures, depending on its design."
                },
                {
                  "type": "paragraph",
                  "text": "Key OSCE identifying feature: The Malecot catheter has an expanded distal tip with several flexible wings, unlike the smooth, balloon-retained tip of a Foley catheter."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "malecot_catheter_subsection_3",
          "subsection_title": "2. Identification and characteristic features",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "malecot_catheter_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/malecot_catheter_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Identification: Malecot drainage catheter."
                },
                {
                  "type": "paragraph",
                  "text": "Characteristic features"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Flexible hollow tube.",
                      "level": 0
                    },
                    {
                      "text": "Expanded distal tip with multiple wings, commonly four.",
                      "level": 0
                    },
                    {
                      "text": "Drainage openings near the distal tip.",
                      "level": 0
                    },
                    {
                      "text": "Long drainage shaft.",
                      "level": 0
                    },
                    {
                      "text": "Proximal connector for attachment to suitable drainage tubing.",
                      "level": 0
                    },
                    {
                      "text": "No retention balloon in the classic design.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The number and shape of the wings vary between models. In an OSCE, describe the actual tip presented."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "malecot_catheter_subsection_4",
          "subsection_title": "3. Labelling and parts",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "malecot_catheter_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/malecot_catheter_04.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Function"
                  ],
                  "rows": [
                    [
                      "Expanded winged tip",
                      "Helps retain the catheter within the intended cavity."
                    ],
                    [
                      "Drainage openings",
                      "Permit fluid to enter the catheter."
                    ],
                    [
                      "Main shaft",
                      "Conducts fluid from the cavity to the drainage system."
                    ],
                    [
                      "Proximal connector",
                      "Connects to compatible drainage tubing."
                    ],
                    [
                      "External fixation, if used",
                      "Helps prevent accidental displacement."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The wings are designed to assist retention, but they do not guarantee secure placement. Correct positioning and appropriate fixation remain important."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "malecot_catheter_subsection_5",
          "subsection_title": "4. Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "malecot_catheter_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Malecot catheters can be classified according to their intended application, material and size."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Urinary Malecot catheter: Used for selected bladder drainage procedures.",
                      "level": 0
                    },
                    {
                      "text": "Nephrostomy Malecot catheter: Used in selected situations to drain urine from the renal collecting system.",
                      "level": 0
                    },
                    {
                      "text": "Surgical cavity drainage catheter: Used for drainage of selected cavities or collections when the design and clinical circumstances are appropriate.",
                      "level": 0
                    },
                    {
                      "text": "Different-calibre catheters: Selected according to the anatomy, drainage requirements and procedural plan.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "They are commonly made from medical-grade rubber, silicone or other suitable materials, depending on the model."
                },
                {
                  "type": "paragraph",
                  "text": "Important distinction: A Malecot catheter is not interchangeable with every urinary or surgical drain. The intended anatomical site and manufacturer's instructions determine its suitability."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "malecot_catheter_subsection_6",
          "subsection_title": "5. Principle of operation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "malecot_catheter_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The Malecot catheter works by providing a hollow drainage pathway and using its expanded distal wings to help retain it in the intended cavity."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "The catheter is placed in the target cavity by an appropriate surgical or image-guided technique.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "The expanded tip helps prevent the catheter from slipping out.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Fluid enters through the drainage openings.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Fluid travels through the catheter lumen to a suitable collection system.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "The catheter is secured and monitored to maintain drainage.",
                      "level": 0,
                      "label": "5."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The wings provide mechanical retention rather than balloon inflation. They must be handled carefully because forceful manipulation or traction can injure surrounding tissue."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "malecot_catheter_subsection_7",
          "subsection_title": "6. Indications and surgical applications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "malecot_catheter_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A. Selected bladder drainage procedures"
                },
                {
                  "type": "paragraph",
                  "text": "A Malecot catheter may be used for bladder drainage in selected surgical circumstances, including some suprapubic drainage procedures."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/malecot_catheter_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "B. Selected renal drainage procedures"
                },
                {
                  "type": "paragraph",
                  "text": "Some Malecot designs are used for drainage of the renal collecting system. The precise catheter type depends on the procedure and the clinician's plan."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/malecot_catheter_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "C. Selected surgical cavity drainage"
                },
                {
                  "type": "paragraph",
                  "text": "A suitable Malecot-type drain may be used when a winged-tip catheter is appropriate for the cavity and the intended drainage function."
                }
              ]
            },
            {
              "group_id": "malecot_catheter_group_8",
              "group_title": "Procedures in which it may be encountered",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Selected suprapubic cystostomy procedures.",
                      "level": 0
                    },
                    {
                      "text": "Selected nephrostomy or renal drainage procedures.",
                      "level": 0
                    },
                    {
                      "text": "Selected surgical drainage procedures involving cavities or collections.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The exact use varies by specialty and device design. A Malecot catheter should not be assumed to be the routine first choice for every urinary obstruction or abscess."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "malecot_catheter_subsection_8",
          "subsection_title": "7. Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "malecot_catheter_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "The expanded wings help retain the catheter without a balloon.",
                      "level": 0
                    },
                    {
                      "text": "Provides a drainage route through a hollow lumen.",
                      "level": 0
                    },
                    {
                      "text": "Can be useful in selected surgical cavities where secure retention is needed.",
                      "level": 0
                    },
                    {
                      "text": "Available in different sizes and configurations.",
                      "level": 0
                    },
                    {
                      "text": "Has a relatively simple design without a balloon inflation system.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "malecot_catheter_subsection_9",
          "subsection_title": "8. Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "malecot_catheter_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "The winged tip can cause tissue trauma during insertion, manipulation or removal.",
                      "level": 0
                    },
                    {
                      "text": "May be more difficult to remove than a smooth catheter if the wings are damaged, trapped or embedded.",
                      "level": 0
                    },
                    {
                      "text": "Can become blocked by clots, debris or thick material.",
                      "level": 0
                    },
                    {
                      "text": "May become displaced if inadequately secured.",
                      "level": 0
                    },
                    {
                      "text": "Requires appropriate procedural expertise and monitoring.",
                      "level": 0
                    },
                    {
                      "text": "Is not suitable for every drainage site or every type of collection.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "malecot_catheter_subsection_10",
          "subsection_title": "9. Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "malecot_catheter_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A. Tissue injury"
                },
                {
                  "type": "paragraph",
                  "text": "The expanded wings can injure the bladder, renal collecting system or surrounding tissues if inserted, manipulated or removed incorrectly."
                },
                {
                  "type": "paragraph",
                  "text": "B. Blockage"
                },
                {
                  "type": "paragraph",
                  "text": "Blood clots, tissue debris or thick fluid may obstruct the drainage openings or lumen."
                },
                {
                  "type": "paragraph",
                  "text": "C. Leakage"
                },
                {
                  "type": "paragraph",
                  "text": "Fluid may leak around the catheter if the device is displaced, blocked or inadequately positioned."
                },
                {
                  "type": "paragraph",
                  "text": "D. Infection"
                },
                {
                  "type": "paragraph",
                  "text": "Infection may develop at the insertion site or within the drained urinary tract or cavity."
                },
                {
                  "type": "paragraph",
                  "text": "E. Displacement or difficult removal"
                },
                {
                  "type": "paragraph",
                  "text": "The catheter may become dislodged, or the wings may catch on tissue during removal, potentially causing bleeding or injury."
                },
                {
                  "type": "paragraph",
                  "text": "Other complications depend on the insertion site and include haematuria, bleeding, urine extravasation, and injury to adjacent structures."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "malecot_catheter_subsection_11",
          "subsection_title": "10. Care and safety precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "malecot_catheter_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Confirm the indication, intended insertion site and correct catheter type.",
                      "level": 0
                    },
                    {
                      "text": "Maintain aseptic technique during insertion and dressing changes.",
                      "level": 0
                    },
                    {
                      "text": "Ensure that the catheter is correctly positioned and adequately secured.",
                      "level": 0
                    },
                    {
                      "text": "Monitor drainage volume, colour, patency and leakage.",
                      "level": 0
                    },
                    {
                      "text": "Assess for pain, fever, bleeding and signs of obstruction.",
                      "level": 0
                    },
                    {
                      "text": "Follow the prescribed flushing protocol, if one exists; never force fluid through a blocked catheter.",
                      "level": 0
                    },
                    {
                      "text": "Avoid traction on the catheter, especially when the expanded tip is inside a cavity.",
                      "level": 0
                    },
                    {
                      "text": "Do not attempt to remove a catheter that appears trapped or cannot be withdrawn gently; seek appropriate specialist assistance.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "malecot_catheter_subsection_12",
          "subsection_title": "11. Malecot catheter versus Foley catheter",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "malecot_catheter_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This is a particularly important comparison for surgical and urological OSCEs."
                },
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Malecot catheter",
                    "Foley catheter"
                  ],
                  "rows": [
                    [
                      "Distal tip",
                      "Expanded winged or flower-shaped tip",
                      "Smooth tip with drainage eyes and an inflatable retention balloon"
                    ],
                    [
                      "Retention mechanism",
                      "Mechanical retention by the expanded wings",
                      "Inflated balloon"
                    ],
                    [
                      "Balloon inflation channel",
                      "Absent in the classic design",
                      "Present"
                    ],
                    [
                      "Typical uses",
                      "Selected surgical cavity, bladder or renal drainage",
                      "Commonly used for indwelling urinary bladder drainage"
                    ],
                    [
                      "Removal",
                      "Requires appropriate handling of the winged tip",
                      "Balloon must be completely deflated before removal"
                    ],
                    [
                      "Main safety concern",
                      "Wing-related tissue injury or difficult removal",
                      "Balloon inflation in the urethra or removal with the balloon inflated"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Exam pearl: Never inflate a Foley catheter balloon until correct placement in the bladder has been established according to the appropriate clinical protocol."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "malecot_catheter_subsection_13",
          "subsection_title": "12. High-yield OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "malecot_catheter_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. Identify the instrument."
                },
                {
                  "type": "paragraph",
                  "text": "This is a Malecot catheter, a drainage catheter with an expanded, winged distal tip that helps retain it within a cavity."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is the distinguishing feature of a Malecot catheter?"
                },
                {
                  "type": "paragraph",
                  "text": "Its expanded winged tip, which provides mechanical retention without the balloon used in a classic Foley catheter."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What is the function of the drainage openings?"
                },
                {
                  "type": "paragraph",
                  "text": "They allow fluid to enter the catheter lumen and pass to the external drainage system."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Name some uses of a Malecot catheter."
                },
                {
                  "type": "paragraph",
                  "text": "Selected suprapubic bladder drainage, renal collecting-system drainage and other appropriate surgical cavity drainage procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What are the important complications?"
                },
                {
                  "type": "paragraph",
                  "text": "Tissue trauma, bleeding, blockage, leakage, infection, displacement and difficult removal."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. How does a Malecot catheter differ from a Foley catheter?"
                },
                {
                  "type": "paragraph",
                  "text": "The Malecot uses an expanded winged tip for retention, whereas the Foley uses an inflatable balloon. The Foley is widely used for routine indwelling urinary bladder drainage."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What would you do if a Malecot catheter could not be removed easily?"
                },
                {
                  "type": "paragraph",
                  "text": "Stop applying traction, assess the situation and obtain appropriate specialist assistance. Forceful removal may injure the tissue surrounding the expanded tip."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "malecot_catheter_subsection_14",
          "subsection_title": "13. High-yield examination tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "malecot_catheter_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Identify the expanded, winged distal tip first.",
                      "level": 0
                    },
                    {
                      "text": "State that retention is achieved mechanically, not by balloon inflation.",
                      "level": 0
                    },
                    {
                      "text": "Identify the shaft, drainage openings and proximal connector.",
                      "level": 0
                    },
                    {
                      "text": "Mention selected bladder and renal drainage applications.",
                      "level": 0
                    },
                    {
                      "text": "Remember that the wings can cause trauma during manipulation or removal.",
                      "level": 0
                    },
                    {
                      "text": "Do not confuse the Malecot with the Foley, Pezzer or other drainage catheters.",
                      "level": 0
                    },
                    {
                      "text": "Emphasise patency, securement, output monitoring and safe removal.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "malecot_catheter_subsection_15",
          "subsection_title": "14. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "malecot_catheter_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a Malecot catheter, a hollow drainage catheter characterised by an expanded, winged distal tip. The wings help retain the catheter within the intended cavity, while the drainage openings permit fluid to enter the lumen and pass to an external collection system. It is used in selected bladder, renal and surgical drainage procedures. Its advantages include mechanical retention without a balloon. Complications include tissue trauma, bleeding, blockage, leakage, infection, displacement and difficult removal.”",
                  "style": "quote"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}