      "section_id": "malecot_catheter_section_1",
      "section_title": "Malecot catheter",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "malecot_catheter_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "malecot_catheter_group_1",
              "group_title": "",
