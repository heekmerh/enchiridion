  "sections": [
    {
      "section_id": "oxygen_delivery_devices_section_1",
      "section_title": "Oxygen delivery devices",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "oxygen_delivery_devices_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Oxygen delivery devices are used to administer supplemental oxygen to patients with hypoxaemia or at risk of hypoxaemia. The device selected depends on the patient's clinical condition, required oxygen concentration, respiratory pattern and need for respiratory support."
                },
                {
                  "type": "paragraph",
                  "text": "High-yield OSCE distinction: Oxygen is a treatment that should be prescribed or administered according to the clinical situation and applicable emergency protocol. It is not a substitute for assessing and treating the underlying cause of respiratory distress."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_2",
          "subsection_title": "Identification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/oxygen_delivery_devices_01.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "A. Nasal cannula"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Two small prongs deliver oxygen into the nostrils."
                },
                {
                  "type": "paragraph",
                  "text": "Typical adult flow: 1–6 L/min. The delivered FiO₂ is variable and depends on breathing pattern and other factors."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/oxygen_delivery_devices_02.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Simple face mask"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Covers the nose and mouth and delivers oxygen through a connected tube."
                },
                {
                  "type": "paragraph",
                  "text": "Typical adult flow: 5–10 L/min. Do not use below 5 L/min because of the risk of carbon dioxide rebreathing."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/oxygen_delivery_devices_03.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/oxygen_delivery_devices_04.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/oxygen_delivery_devices_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "C. Venturi mask"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Uses an air-entrainment system to deliver a more controlled oxygen concentration."
                },
                {
                  "type": "paragraph",
                  "text": "Common fixed settings include 24%, 28%, 31%, 35%, 40% and 60%, depending on the model. Follow the manufacturer's specified flow for the selected adapter."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_3",
          "subsection_title": "Venturi Mask: Mnemonic for Sizes and Oxygen Percentages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The easiest way to remember Venturi mask colours, oxygen concentrations and flow rates is to memorize the “24–28–31–35–40–60 rule” (common values; devices vary by manufacturer)."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_4",
          "subsection_title": "%",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Blue — 2 L/min"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Mnemonic: Blue is low."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_5",
          "subsection_title": "%",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "White — 4 L/min"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Mnemonic: White comes next."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_6",
          "subsection_title": "%",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Orange — 6 L/min"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Mnemonic: Orange at six."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_7",
          "subsection_title": "%",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Yellow — 8 L/min"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Mnemonic: Yellow at eight."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_8",
          "subsection_title": "%",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Red — 10 L/min"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Mnemonic: Red at ten."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_9",
          "subsection_title": "%",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Green — 15 L/min"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Mnemonic: Green gives more."
                },
                {
                  "type": "paragraph",
                  "text": "Important: These are common colour/concentration/flow combinations, not universal specifications. Always check the printed percentage and flow requirement on the actual Venturi valve or manufacturer’s instructions. Some commonly used sets include a 31% or 35% adapter, while others differ."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_10",
          "subsection_title": "One-line OSCE mnemonic",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“Blue White Orange Yellow Red Green — 24, 28, 31, 35, 40, 60.”"
                },
                {
                  "type": "paragraph",
                  "text": "Remember the flow rates as 2, 4, 6, 8, 10, 15 L/min for this commonly taught set."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_11",
          "subsection_title": "Mnemonic for Color Order",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "To remember the order of colors from lowest $\\text{FiO}_2$ to highest $\\text{FiO}_2$ (Blue $\\rightarrow$ White $\\rightarrow$ Yellow $\\rightarrow$ Red $\\rightarrow$ Green):"
                },
                {
                  "type": "checklist",
                  "items": [
                    "\"Blue Whales Yawn Red Gills\""
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The BLUE sky (24%) turned WHITE with clouds (28%), then an ORANGE sun (31%) shone YELLOW (35%), turning RED hot (40%), until the GREEN grass grew (60%)."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/oxygen_delivery_devices_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "D. Non-rebreather mask"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Has a reservoir bag and one-way valves designed to limit rebreathing and provide a high oxygen concentration."
                },
                {
                  "type": "paragraph",
                  "text": "Typical adult flow: 10–15 L/min, adjusted to maintain the reservoir appropriately inflated during inspiration."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_12",
          "subsection_title": "Important terminology",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "FiO₂: Fraction of inspired oxygen, expressed as a fraction or percentage."
                },
                {
                  "type": "paragraph",
                  "text": "Hypoxaemia: Abnormally low oxygen level in arterial blood."
                },
                {
                  "type": "paragraph",
                  "text": "Hypoxia: Inadequate oxygen availability at tissue level."
                },
                {
                  "type": "paragraph",
                  "text": "Flow rate: Oxygen supplied per minute, measured in L/min."
                },
                {
                  "type": "paragraph",
                  "text": "Humidification: Addition of moisture to inspired gas when indicated by the clinical situation or equipment."
                },
                {
                  "type": "paragraph",
                  "text": "Room air contains approximately 21% oxygen. With low-flow devices such as nasal cannulae, the actual FiO₂ varies considerably with inspiratory flow, tidal volume, respiratory rate and fit."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_13",
          "subsection_title": "Comparison table — essential OSCE facts",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Device",
                    "Typical adult flow",
                    "Approximate oxygen concentration",
                    "Key point"
                  ],
                  "rows": [
                    [
                      "Nasal cannula",
                      "1–6 L/min",
                      "Roughly 24–44%",
                      "Comfortable; variable FiO₂"
                    ],
                    [
                      "Simple face mask",
                      "5–10 L/min",
                      "Roughly 35–60%",
                      "Minimum 5 L/min"
                    ],
                    [
                      "Venturi mask",
                      "Adapter-specific",
                      "Fixed concentration for a given adapter",
                      "Controlled FiO₂"
                    ],
                    [
                      "Non-rebreather mask",
                      "10–15 L/min",
                      "Often approximately 60–90% or higher under suitable conditions",
                      "Reservoir bag and one-way valves"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These are approximate adult values, not guarantees of the oxygen concentration reaching the lungs. Actual performance varies by device, fit, breathing pattern and flow."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_14",
          "subsection_title": "Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Oxygen delivery devices are used in:"
                },
                {
                  "type": "paragraph",
                  "text": "Hypoxaemia due to pneumonia, asthma, COPD or other respiratory disorders."
                },
                {
                  "type": "paragraph",
                  "text": "Acute respiratory distress while the cause is assessed and treated."
                },
                {
                  "type": "paragraph",
                  "text": "Shock, cardiac arrest and other emergencies according to resuscitation protocols."
                },
                {
                  "type": "paragraph",
                  "text": "Perioperative and postoperative care when supplemental oxygen is indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Selected cardiac conditions associated with hypoxaemia."
                },
                {
                  "type": "paragraph",
                  "text": "Neonatal care using appropriate neonatal oxygen delivery equipment and monitoring."
                },
                {
                  "type": "paragraph",
                  "text": "Controlled oxygen therapy in patients at risk of hypercapnic respiratory failure."
                },
                {
                  "type": "paragraph",
                  "text": "Important: Oxygen is not routinely required for every patient with breathlessness if oxygenation is adequate. The target should be based on clinical condition and applicable guidance."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_15",
          "subsection_title": "Advantages and disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Device",
                    "Advantages",
                    "Disadvantages"
                  ],
                  "rows": [
                    [
                      "Nasal cannula",
                      "Comfortable, permits eating and speaking",
                      "Variable FiO₂; nasal irritation and dryness"
                    ],
                    [
                      "Simple face mask",
                      "Easy to apply; provides more oxygen than a cannula in many circumstances",
                      "Obstructs eating and drinking; uncomfortable for some patients"
                    ],
                    [
                      "Venturi mask",
                      "More controlled FiO₂",
                      "Requires correct adapter and flow; may be less comfortable"
                    ],
                    [
                      "Non-rebreather mask",
                      "Rapid delivery of a high oxygen concentration in emergencies",
                      "Requires adequate flow and a functional reservoir; does not provide ventilatory support"
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_16",
          "subsection_title": "How to apply oxygen delivery devices: OSCE demonstration",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_16",
              "group_title": "General oxygen administration checklist",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "0 of 12 steps completed"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "1. Perform hand hygiene, introduce yourself, confirm identity and explain the procedure if the patient is conscious."
                },
                {
                  "type": "paragraph",
                  "text": "2. Assess airway, breathing and circulation, respiratory rate, work of breathing, mental status and oxygen saturation."
                },
                {
                  "type": "paragraph",
                  "text": "3. Identify the indication for oxygen and select an appropriate target saturation according to the clinical situation."
                },
                {
                  "type": "paragraph",
                  "text": "4. Choose a suitable device based on the patient's condition and the required oxygen concentration."
                },
                {
                  "type": "paragraph",
                  "text": "5. Check the oxygen source, flowmeter, tubing, connections and device integrity."
                },
                {
                  "type": "paragraph",
                  "text": "6. Connect the device and set the prescribed or protocol-directed flow rate."
                },
                {
                  "type": "paragraph",
                  "text": "7. Apply the device correctly and check fit, comfort and unobstructed airflow."
                },
                {
                  "type": "paragraph",
                  "text": "8. For a non-rebreather mask, inflate the reservoir before application when feasible and ensure it does not collapse substantially during inspiration."
                },
                {
                  "type": "paragraph",
                  "text": "9. For a Venturi mask, use the correct adapter and the manufacturer's specified flow rate."
                },
                {
                  "type": "paragraph",
                  "text": "10. Monitor oxygen saturation, respiratory effort, pulse, mental status and response to treatment."
                },
                {
                  "type": "paragraph",
                  "text": "11. Document the device, flow rate or FiO₂ setting, saturation and clinical response."
                },
                {
                  "type": "paragraph",
                  "text": "12. Escalate promptly if the patient deteriorates or the target saturation cannot be achieved."
                }
              ]
            },
            {
              "group_id": "oxygen_delivery_devices_group_17",
              "group_title": "A. Nasal cannula",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/oxygen_delivery_devices_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Connect the cannula to the oxygen tubing and flowmeter."
                },
                {
                  "type": "paragraph",
                  "text": "Set the prescribed flow."
                },
                {
                  "type": "paragraph",
                  "text": "Place the prongs gently into the nostrils, following the device design."
                },
                {
                  "type": "paragraph",
                  "text": "Secure the tubing over the ears and adjust it comfortably."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm that the prongs are correctly positioned and the patient is tolerating the device."
                },
                {
                  "type": "paragraph",
                  "text": "Reassess oxygen saturation and respiratory status."
                },
                {
                  "type": "paragraph",
                  "text": "Precaution: Check the skin behind the ears and around the nostrils during prolonged use."
                }
              ]
            },
            {
              "group_id": "oxygen_delivery_devices_group_18",
              "group_title": "B. Simple face mask",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/oxygen_delivery_devices_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "doccheckshop.fr"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Connect the mask to the oxygen supply."
                },
                {
                  "type": "paragraph",
                  "text": "Set a flow of at least 5 L/min for a standard adult simple mask."
                },
                {
                  "type": "paragraph",
                  "text": "Place the mask over the nose and mouth."
                },
                {
                  "type": "paragraph",
                  "text": "Adjust the elastic strap and nose clip for a comfortable fit."
                },
                {
                  "type": "paragraph",
                  "text": "Check that airflow is adequate and the patient is tolerating the mask."
                },
                {
                  "type": "paragraph",
                  "text": "Monitor saturation and clinical response."
                },
                {
                  "type": "paragraph",
                  "text": "Common OSCE question: Why must a simple mask not be run at a very low flow? Because inadequate fresh gas flow can allow carbon dioxide to accumulate in the mask and increase rebreathing."
                }
              ]
            },
            {
              "group_id": "oxygen_delivery_devices_group_19",
              "group_title": "C. Venturi mask",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/oxygen_delivery_devices_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "storage.googleapis.com"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Select the prescribed oxygen concentration."
                },
                {
                  "type": "paragraph",
                  "text": "Attach the matching adapter."
                },
                {
                  "type": "paragraph",
                  "text": "Set the oxygen flow specified by the manufacturer for that adapter."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure the air-entrainment ports are not blocked by bedding or clothing."
                },
                {
                  "type": "paragraph",
                  "text": "Fit the mask over the nose and mouth."
                },
                {
                  "type": "paragraph",
                  "text": "Reassess saturation and the patient's clinical condition."
                },
                {
                  "type": "paragraph",
                  "text": "Examiner's point: A Venturi mask provides a more controlled oxygen concentration than a low-flow nasal cannula, provided it is assembled and operated correctly."
                }
              ]
            },
            {
              "group_id": "oxygen_delivery_devices_group_20",
              "group_title": "D. Non-rebreather mask",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/oxygen_delivery_devices_10.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "indonesian.nasalendotracheal.com"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Connect the mask to the oxygen supply."
                },
                {
                  "type": "paragraph",
                  "text": "Set the flow, commonly 10–15 L/min in adults, according to the clinical protocol and device instructions."
                },
                {
                  "type": "paragraph",
                  "text": "Allow the reservoir bag to inflate before placing the mask on the patient when feasible."
                },
                {
                  "type": "paragraph",
                  "text": "Apply the mask securely."
                },
                {
                  "type": "paragraph",
                  "text": "Check that the reservoir remains adequately inflated during inspiration."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm that valves are present and functioning as designed."
                },
                {
                  "type": "paragraph",
                  "text": "Monitor saturation and clinical response continuously or at an appropriate frequency."
                },
                {
                  "type": "paragraph",
                  "text": "Emergency point: If the patient is critically hypoxaemic, do not delay emergency oxygen and resuscitative support while troubleshooting a mask. A non-rebreather mask does not ventilate a patient who is apnoeic or inadequately breathing."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_17",
          "subsection_title": "Oxygen saturation targets",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_21",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "For most acutely ill adults receiving oxygen, a common target is SpO₂ 94–98%. For patients at risk of hypercapnic respiratory failure, such as some patients with COPD, a target of 88–92% is commonly used pending blood gas assessment and individualized clinical decisions."
                },
                {
                  "type": "table",
                  "columns": [
                    "Clinical situation",
                    "Common target or approach"
                  ],
                  "rows": [
                    [
                      "Most acutely ill adults requiring oxygen",
                      "94–98%"
                    ],
                    [
                      "Risk of hypercapnic respiratory failure",
                      "88–92% pending assessment, unless individualized otherwise"
                    ],
                    [
                      "Severe hypoxaemia or critical illness",
                      "Immediate oxygen and emergency assessment; titrate as appropriate"
                    ],
                    [
                      "Neonates",
                      "Use gestational age-, condition- and protocol-specific targets"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These are general adult targets, not universal rules for every patient. Neonatal oxygen targets differ substantially and should follow neonatal protocols."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_18",
          "subsection_title": "Contraindications and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_22",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "There is no general absolute contraindication to oxygen when it is needed to correct hypoxaemia. However, oxygen must be administered thoughtfully."
                },
                {
                  "type": "paragraph",
                  "text": "Risk of hypercapnia: Some patients with COPD or other causes of chronic ventilatory failure require controlled oxygen and blood gas monitoring."
                },
                {
                  "type": "paragraph",
                  "text": "Fire risk: Oxygen supports combustion. Keep it away from smoking, flames, sparks and oil-based products."
                },
                {
                  "type": "paragraph",
                  "text": "Pressure injury: Check the skin around the nose, cheeks and ears."
                },
                {
                  "type": "paragraph",
                  "text": "Dryness and irritation: Prolonged oxygen use can cause nasal dryness or discomfort."
                },
                {
                  "type": "paragraph",
                  "text": "CO₂ rebreathing: Avoid using a simple face mask below its minimum recommended flow."
                },
                {
                  "type": "paragraph",
                  "text": "Equipment failure: Check the supply, tubing, flowmeter and connections if saturation does not improve."
                }
              ]
            },
            {
              "group_id": "oxygen_delivery_devices_group_23",
              "group_title": "Complications of excessive or inappropriate oxygen",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Worsening hypercapnia in susceptible patients."
                },
                {
                  "type": "paragraph",
                  "text": "Oxygen toxicity with prolonged exposure to high concentrations."
                },
                {
                  "type": "paragraph",
                  "text": "Absorption atelectasis in certain circumstances."
                },
                {
                  "type": "paragraph",
                  "text": "Dryness and mucosal irritation."
                },
                {
                  "type": "paragraph",
                  "text": "Fire-related injury if oxygen is used near an ignition source."
                },
                {
                  "type": "paragraph",
                  "text": "Important: Do not withhold oxygen from a severely hypoxaemic patient because of concern about CO₂ retention. Give oxygen promptly, target it appropriately, and arrange urgent assessment and blood gas monitoring when indicated."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_19",
          "subsection_title": "Pediatric and neonatal considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_24",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/oxygen_delivery_devices_11.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Select an age- and size-appropriate interface."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure that the mask or cannula does not obstruct the airway."
                },
                {
                  "type": "paragraph",
                  "text": "Monitor respiratory effort, oxygen saturation and general appearance."
                },
                {
                  "type": "paragraph",
                  "text": "Check the skin and nasal passages during prolonged treatment."
                },
                {
                  "type": "paragraph",
                  "text": "Do not apply adult flow rates indiscriminately to children."
                },
                {
                  "type": "paragraph",
                  "text": "In neonates, carefully titrate oxygen to the prescribed saturation target because both hypoxaemia and excessive oxygen exposure can be harmful."
                },
                {
                  "type": "paragraph",
                  "text": "Escalate urgently if a child has exhaustion, altered consciousness, cyanosis, poor air entry or worsening respiratory distress."
                },
                {
                  "type": "paragraph",
                  "text": "A child with severe respiratory distress may require more than supplemental oxygen, including bronchodilator therapy, assisted ventilation or advanced respiratory support."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_20",
          "subsection_title": "Mnemonics and memory tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_25",
              "group_title": "Oxygen devices: N–S–V–NRB",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "N — Nasal cannula: comfortable, variable FiO₂."
                },
                {
                  "type": "paragraph",
                  "text": "S — Simple mask: minimum 5 L/min."
                },
                {
                  "type": "paragraph",
                  "text": "V — Venturi: controlled FiO₂."
                },
                {
                  "type": "paragraph",
                  "text": "NRB — Non-rebreather: high oxygen concentration with reservoir."
                }
              ]
            },
            {
              "group_id": "oxygen_delivery_devices_group_26",
              "group_title": "Before administration: FLOW",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "F — Find the indication and target."
                },
                {
                  "type": "paragraph",
                  "text": "L — Link the device correctly."
                },
                {
                  "type": "paragraph",
                  "text": "O — Observe the patient and oxygen saturation."
                },
                {
                  "type": "paragraph",
                  "text": "W — Write down the device, flow and response."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_21",
          "subsection_title": "Common OSCE questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_27",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. Which device delivers a controlled oxygen concentration?"
                },
                {
                  "type": "paragraph",
                  "text": "The Venturi mask, when the correct adapter and manufacturer-specified flow are used."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is the minimum usual flow for a standard simple face mask in adults?"
                },
                {
                  "type": "paragraph",
                  "text": "5 L/min, to reduce the risk of carbon dioxide rebreathing."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Why must the reservoir bag on a non-rebreather mask remain adequately inflated?"
                },
                {
                  "type": "paragraph",
                  "text": "It provides a reservoir of oxygen for inspiration. Excessive collapse suggests inadequate supply or excessive inspiratory demand and requires immediate assessment."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Which oxygen target is commonly used in patients at risk of hypercapnic respiratory failure?"
                },
                {
                  "type": "paragraph",
                  "text": "88–92% pending blood gas assessment and individualized clinical review, unless a different target is indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What should you do if SpO₂ remains low despite a non-rebreather mask?"
                },
                {
                  "type": "paragraph",
                  "text": "Reassess airway, breathing and circulation immediately, check the oxygen supply and device, and escalate urgently for advanced respiratory support. Do not delay emergency treatment."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Can a non-rebreather mask treat apnoea?"
                },
                {
                  "type": "paragraph",
                  "text": "No. It delivers oxygen but does not provide adequate ventilation to an apnoeic patient. Assisted ventilation with an appropriate device is required."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oxygen_delivery_devices_subsection_22",
          "subsection_title": "Common mistakes that lose OSCE marks",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oxygen_delivery_devices_group_28",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Choosing a device without assessing the patient's condition."
                },
                {
                  "type": "paragraph",
                  "text": "Failing to check the oxygen supply."
                },
                {
                  "type": "paragraph",
                  "text": "Running a simple mask below 5 L/min."
                },
                {
                  "type": "paragraph",
                  "text": "Using the wrong Venturi adapter or flow."
                },
                {
                  "type": "paragraph",
                  "text": "Applying a non-rebreather mask before ensuring adequate reservoir inflation when feasible."
                },
                {
                  "type": "paragraph",
                  "text": "Failing to reassess oxygen saturation."
                },
                {
                  "type": "paragraph",
                  "text": "Ignoring the risk of hypercapnia in susceptible patients."
                },
                {
                  "type": "paragraph",
                  "text": "Failing to document oxygen delivery settings."
                },
                {
                  "type": "paragraph",
                  "text": "Forgetting oxygen fire-safety precautions."
                },
                {
                  "type": "paragraph",
                  "text": "Delaying emergency escalation in a deteriorating patient."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}