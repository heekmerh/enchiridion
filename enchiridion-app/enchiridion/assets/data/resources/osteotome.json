        {
          "subsection_id": "osteotome_subsection_14",
          "subsection_title": "14. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "osteotome_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is an osteotome, a chisel-like surgical instrument used to cut, divide or shape bone. It consists of a bevelled cutting edge, a strong shaft and a handle or striking end, depending on its design. It is used in osteotomy, bone remodelling and selected reconstructive procedures. Its advantages include controlled bone cutting without a powered drive. Complications include uncontrolled fracture propagation, neurovascular injury and soft-tissue damage. Correct instrument selection, controlled force and protection of adjacent structures are essential.”",
                  "style": "quote"
                }
              ]
            }
          ]
        }
      ]
    }
