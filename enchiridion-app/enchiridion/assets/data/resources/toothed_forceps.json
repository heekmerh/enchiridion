                }
              ]
            }
          ]
        },
        {
          "subsection_id": "toothed_forceps_subsection_2",
          "subsection_title": "Introduction and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "toothed_forceps_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Toothed forceps are spring-operated surgical grasping instruments with teeth at their opposing tips. The teeth engage with one another when the instrument is closed, providing a secure grip on tissues."
                },
                {
                  "type": "paragraph",
                  "text": "They are commonly used to grasp skin edges during suturing and to manipulate tissues that can tolerate a firmer grip."
                },
                {
                  "type": "paragraph",
                  "text": "Category: Grasping and tissue-manipulating instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Primary function: Securely holding tissue during surgical procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Material: Usually stainless steel."
                },
                {
                  "type": "paragraph",
                  "text": "Construction: Two resilient arms with interlocking teeth at the tips."
                },
                {
                  "type": "paragraph",
                  "text": "Common configuration: 1 × 2 teeth."
                },
                {
                  "type": "paragraph",
                  "text": "Operation: Manual compression of the arms; no finger rings or ratchet."
                }
              ]
            },
            {
              "group_id": "toothed_forceps_group_3",
              "group_title": "How to identify it in an OSCE",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Look for:"
                },
                {
                  "type": "paragraph",
                  "text": "Two elongated spring arms."
                },
                {
                  "type": "paragraph",
                  "text": "No finger rings."
                },
                {
                  "type": "paragraph",
                  "text": "No locking ratchet."
                },
                {
                  "type": "paragraph",
                  "text": "Sharp or pointed teeth at the tips."
                },
                {
                  "type": "paragraph",
                  "text": "A design in which the teeth on one side engage between those on the opposing side."
                },
                {
                  "type": "paragraph",
                  "text": "Model identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“These are toothed dissecting forceps, used to grasp and manipulate tissues securely, particularly skin edges during suturing. A common design has one tooth on one tip and two teeth on the opposing tip.”"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "toothed_forceps_subsection_3",
          "subsection_title": "Labelling of toothed forceps",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "toothed_forceps_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/toothed_forceps_02.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/toothed_forceps_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "mymortuarycooler.com"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The important parts are:"
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/toothed_forceps_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Arms or handles"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The two resilient sections squeezed by the fingers and thumb to close the forceps."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/toothed_forceps_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Spring portion"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Allows the arms to reopen when pressure is released."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/toothed_forceps_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Teeth"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The interlocking projections that improve grip by engaging the tissue."
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Tips or jaws"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The distal ends that contact and hold the tissue."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "toothed_forceps_subsection_4",
          "subsection_title": "Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "toothed_forceps_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Toothed forceps vary according to their size, tip configuration and intended surgical application."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/toothed_forceps_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "A. Standard 1 × 2 toothed forceps"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "One tooth on one tip engages between two teeth on the opposing tip."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: Holding skin edges and suitable tougher tissues during suturing or dissection."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/toothed_forceps_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Adson toothed forceps"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Short forceps with relatively broad gripping arms and fine tips."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: Precise grasping of skin edges during wound closure and superficial surgery."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/toothed_forceps_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "C. Fine toothed forceps"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Designed for controlled grasping where the instrument's size and tooth pattern are appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: Selected delicate procedures; the tissue must be suitable for toothed grasping."
                },
                {
                  "type": "paragraph",
                  "text": "Important: Toothed forceps are not automatically appropriate for all delicate tissue. For fragile structures, a suitable atraumatic instrument may be preferable."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "toothed_forceps_subsection_5",
          "subsection_title": "Understanding the 1 × 2 tooth configuration",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "toothed_forceps_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/toothed_forceps_10.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "surgicalinstruments.com"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "This is a frequent instrument-identification question."
                },
                {
                  "type": "paragraph",
                  "text": "One tip has a single tooth."
                },
                {
                  "type": "paragraph",
                  "text": "The opposing tip has two teeth."
                },
                {
                  "type": "paragraph",
                  "text": "When closed, the single tooth fits between the two opposing teeth."
                },
                {
                  "type": "paragraph",
                  "text": "This arrangement improves grip and helps reduce slippage when used correctly."
                },
                {
                  "type": "paragraph",
                  "text": "Viva question: Why are toothed forceps useful for skin suturing?"
                },
                {
                  "type": "paragraph",
                  "text": "Answer: The teeth provide a secure grip on the skin edge, allowing controlled positioning and alignment while the suture is placed."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "toothed_forceps_subsection_6",
          "subsection_title": "Principles of use",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "toothed_forceps_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The objective is to hold the tissue securely without causing unnecessary trauma."
                },
                {
                  "type": "paragraph",
                  "text": "Select an appropriate tooth pattern for the tissue."
                },
                {
                  "type": "paragraph",
                  "text": "Maintain a clear view of the tissue being grasped."
                },
                {
                  "type": "paragraph",
                  "text": "Apply only enough pressure to achieve a secure hold."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid repeatedly puncturing or crushing the same tissue."
                },
                {
                  "type": "paragraph",
                  "text": "Release the grip when it is no longer needed."
                },
                {
                  "type": "paragraph",
                  "text": "Maintain aseptic technique throughout the procedure."
                },
                {
                  "type": "paragraph",
                  "text": "During skin closure, the forceps should help position the wound edge rather than crush it or obstruct the needle's path."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "toothed_forceps_subsection_7",
          "subsection_title": "Uses and surgeries",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "toothed_forceps_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Procedure or specialty",
                    "Application"
                  ],
                  "rows": [
                    [
                      "General surgery",
                      "Holding skin edges during wound closure"
                    ],
                    [
                      "Emergency medicine",
                      "Grasping suitable wound edges during suturing"
                    ],
                    [
                      "Plastic surgery",
                      "Precise alignment of skin edges"
                    ],
                    [
                      "Orthopaedic surgery",
                      "Holding suitable skin and soft-tissue edges"
                    ],
                    [
                      "Obstetrics and gynaecology",
                      "Selected superficial wound-closure procedures"
                    ],
                    [
                      "Dermatological surgery",
                      "Holding suitable skin edges during biopsy or excision closure"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The instrument should be selected according to the tissue's strength, fragility and the task being performed."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "toothed_forceps_subsection_8",
          "subsection_title": "Advantages and disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "toothed_forceps_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Advantages"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Provides a secure grip with less tendency to slip than smooth tips."
                },
                {
                  "type": "paragraph",
                  "text": "Facilitates precise positioning of skin edges."
                },
                {
                  "type": "paragraph",
                  "text": "Allows one-handed operation."
                },
                {
                  "type": "paragraph",
                  "text": "Does not require a ratchet or locking mechanism."
                },
                {
                  "type": "paragraph",
                  "text": "Available in multiple sizes and tip configurations."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Disadvantages"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Teeth can puncture, tear or damage tissue."
                },
                {
                  "type": "paragraph",
                  "text": "Excessive pressure may cause crushing injury."
                },
                {
                  "type": "paragraph",
                  "text": "May be unsuitable for fragile vessels, nerves or delicate organs."
                },
                {
                  "type": "paragraph",
                  "text": "Damaged or misaligned teeth can impair grip."
                },
                {
                  "type": "paragraph",
                  "text": "Reusable instruments require appropriate cleaning and sterilisation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "toothed_forceps_subsection_9",
          "subsection_title": "Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "toothed_forceps_group_10",
              "group_title": "Patient-related complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Puncture injury from the teeth."
                },
                {
                  "type": "paragraph",
                  "text": "Tissue tearing or crushing."
                },
                {
                  "type": "paragraph",
                  "text": "Bleeding from traumatic grasping."
                },
                {
                  "type": "paragraph",
                  "text": "Injury to adjacent structures."
                },
                {
                  "type": "paragraph",
                  "text": "Wound contamination or infection if aseptic technique is breached."
                }
              ]
            },
            {
              "group_id": "toothed_forceps_group_11",
              "group_title": "Instrument-related complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Bent or damaged teeth."
                },
                {
                  "type": "paragraph",
                  "text": "Misalignment of the opposing tips."
                },
                {
                  "type": "paragraph",
                  "text": "Reduced grip due to wear."
                },
                {
                  "type": "paragraph",
                  "text": "Corrosion or other damage."
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the teeth and check that the tips engage correctly before use."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "toothed_forceps_subsection_10",
          "subsection_title": "Toothed versus plain dissecting forceps",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "toothed_forceps_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/toothed_forceps_01.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/toothed_forceps_11.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/toothed_forceps_12.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Toothed forceps",
                    "Plain forceps"
                  ],
                  "rows": [
                    [
                      "Tip design",
                      "Interlocking teeth",
                      "No prominent teeth; may have serrations"
                    ],
                    [
                      "Grip",
                      "More secure engagement",
                      "Relies on surface contact and pressure"
                    ],
                    [
                      "Common use",
                      "Skin edges and suitable tougher tissues",
                      "Suitable tissue handling where atraumatic grip is important"
                    ],
                    [
                      "Main risk",
                      "Puncture or tearing",
                      "Slipping or crushing from excessive pressure"
                    ],
                    [
                      "Selection principle",
                      "Use when the tissue can tolerate toothed grasping",
                      "Use when its design is appropriate for the tissue's fragility"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Neither design is universally safer. The correct choice depends on the tissue and intended task."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "toothed_forceps_subsection_11",
          "subsection_title": "Common OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "toothed_forceps_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. Identify this instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Toothed dissecting forceps, used to grasp and manipulate suitable tissues securely."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What does 1 × 2 mean?"
                },
                {
                  "type": "paragraph",
                  "text": "One tooth on one tip and two teeth on the opposing tip."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Give one common use."
                },
                {
                  "type": "paragraph",
                  "text": "Holding skin edges during suturing."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Why might they be preferred to plain forceps for skin closure?"
                },
                {
                  "type": "paragraph",
                  "text": "The teeth provide a more secure grip and help reduce slippage during positioning."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. Why should they not be used indiscriminately on delicate structures?"
                },
                {
                  "type": "paragraph",
                  "text": "The teeth may puncture or tear fragile tissue."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What complications can occur?"
                },
                {
                  "type": "paragraph",
                  "text": "Tissue puncture, tearing, crushing, bleeding and injury to adjacent structures."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What should be checked before use?"
                },
                {
                  "type": "paragraph",
                  "text": "Tooth integrity, alignment of the tips, spring action and overall condition."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "toothed_forceps_subsection_12",
          "subsection_title": "High-yield revision card",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "toothed_forceps_group_14",
              "group_title": "Toothed forceps — must know",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Category: Grasping instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Identifying feature: Interlocking teeth at the tips."
                },
                {
                  "type": "paragraph",
                  "text": "Common pattern: 1 × 2 teeth."
                },
                {
                  "type": "paragraph",
                  "text": "Common use: Grasping skin edges during suturing."
                },
                {
                  "type": "paragraph",
                  "text": "Advantage: Secure grip with reduced slippage."
                },
                {
                  "type": "paragraph",
                  "text": "Main complication: Puncture or tearing of tissue."
                },
                {
                  "type": "paragraph",
                  "text": "Safety principle: Use only where toothed grasping is appropriate."
                }
              ]
            },
            {
              "group_id": "toothed_forceps_group_15",
              "group_title": "Model 30-second OSCE presentation",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“These are toothed dissecting forceps, spring-operated surgical instruments used to grasp and manipulate tissues securely. They commonly have a 1 × 2 tooth configuration, with one tooth engaging between two opposing teeth. They are frequently used to hold skin edges during suturing. Their main advantage is a secure grip, but the teeth may puncture or tear tissue if used incorrectly. I would inspect the teeth and tip alignment and select the instrument according to the tissue being handled.”"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}