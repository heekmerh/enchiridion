      "section_id": "toothed_forceps_section_1",
      "section_title": "Toothed forceps",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "toothed_forceps_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "toothed_forceps_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
