              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Instrument: Electromyograph (EMG).",
                      "level": 0
                    },
                    {
                      "text": "Purpose: Records electrical activity of skeletal muscle.",
                      "level": 0
                    },
                    {
                      "text": "Key distinction: Needle EMG examines muscle electrical activity; NCS assesses nerve responses.",
                      "level": 0
                    },
                    {
                      "text": "Main indications: Neuropathy, radiculopathy, myopathy and motor neuron disease.",
                      "level": 0
                    },
                    {
                      "text": "Neurogenic pattern: Often large, long-duration units with reduced recruitment.",
                      "level": 0
                    },
                    {
                      "text": "Myopathic pattern: Often small, short-duration units with early recruitment.",
                      "level": 0
                    },
                    {
                      "text": "Main precautions: Consent, bleeding risk, local infection and safe muscle selection.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        }
