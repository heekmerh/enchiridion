  "sections": [
    {
      "section_id": "electromyograph_emg_section_1",
      "section_title": "Electromyograph",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "electromyograph_emg_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electromyograph_emg_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electromyograph_emg_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "The electromyograph (EMG) is a diagnostic instrument used to record and analyse the electrical activity of skeletal muscles. It helps clinicians determine whether muscle weakness is caused by a problem involving the muscle itself, the peripheral nerve, the nerve root, or another part of the neuromuscular system."
                },
                {
                  "type": "paragraph",
                  "text": "For OSCE purposes, distinguish needle EMG, which records electrical activity within a muscle, from nerve conduction studies (NCS), which stimulate peripheral nerves and record their responses. They are often performed together but are not the same test."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electromyograph_emg_subsection_2",
          "subsection_title": "1. Identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electromyograph_emg_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Name: Electromyograph (EMG) machine.",
                      "level": 0
                    },
                    {
                      "text": "Classification: Diagnostic neurophysiological equipment.",
                      "level": 0
                    },
                    {
                      "text": "Main function: Records and analyses the electrical activity of skeletal muscle.",
                      "level": 0
                    },
                    {
                      "text": "Distinguishing features: An electronic recording unit with a display, amplifier, analysis software and electrodes. Needle EMG uses a fine needle electrode inserted into selected muscles; NCS uses surface recording electrodes and electrical stimulation.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electromyograph_emg_subsection_3",
          "subsection_title": "2. Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electromyograph_emg_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Clinical indication",
                    "Purpose"
                  ],
                  "rows": [
                    [
                      "Peripheral neuropathy",
                      "Assess peripheral nerve dysfunction"
                    ],
                    [
                      "Radiculopathy",
                      "Investigate nerve-root injury, such as cervical or lumbar radiculopathy"
                    ],
                    [
                      "Myopathy",
                      "Help distinguish muscle disease from nerve disease"
                    ],
                    [
                      "Motor neuron disease",
                      "Identify evidence of widespread denervation and reinnervation"
                    ],
                    [
                      "Plexopathy",
                      "Assess brachial or lumbosacral plexus lesions"
                    ],
                    [
                      "Unexplained weakness or wasting",
                      "Localise and characterise neuromuscular dysfunction"
                    ],
                    [
                      "Fasciculations",
                      "Assess spontaneous muscle activity in the appropriate clinical context"
                    ],
                    [
                      "Carpal tunnel syndrome",
                      "NCS can assess median nerve function across the wrist"
                    ],
                    [
                      "Neuromuscular junction disorders",
                      "Specialised tests, such as repetitive nerve stimulation or single-fibre EMG, may be indicated"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important: EMG findings must be interpreted alongside the clinical history, physical examination and other investigations. EMG alone does not establish every diagnosis."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electromyograph_emg_subsection_4",
          "subsection_title": "3. Parts and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electromyograph_emg_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electromyograph_emg_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Recording unit and display"
                },
                {
                  "type": "paragraph",
                  "text": "Shows electrical signals as waveforms and allows the examiner to review and analyse recorded activity."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electromyograph_emg_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Needle electrode"
                },
                {
                  "type": "paragraph",
                  "text": "Records electrical activity from muscle fibres near its tip during insertion, rest and voluntary contraction."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electromyograph_emg_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Surface electrodes"
                },
                {
                  "type": "paragraph",
                  "text": "Record nerve or muscle responses during nerve conduction studies."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electromyograph_emg_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Electrical stimulator"
                },
                {
                  "type": "paragraph",
                  "text": "Delivers controlled electrical stimuli to a peripheral nerve during NCS."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/electromyograph_emg_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Reference and ground electrodes"
                },
                {
                  "type": "paragraph",
                  "text": "Help establish the recording reference and reduce electrical interference, depending on the system configuration."
                },
                {
                  "type": "paragraph",
                  "text": "Other components may include an amplifier, filters, speakers for audio monitoring, cables and disposable supplies."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electromyograph_emg_subsection_5",
          "subsection_title": "4. Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electromyograph_emg_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Helps distinguish neurogenic disorders from primary muscle disorders.",
                      "level": 0
                    },
                    {
                      "text": "Can localise lesions to nerve roots, plexuses or peripheral nerves when appropriate muscles and nerves are sampled.",
                      "level": 0
                    },
                    {
                      "text": "Detects electrical abnormalities that may not be apparent on routine examination.",
                      "level": 0
                    },
                    {
                      "text": "Complements nerve conduction studies and clinical assessment.",
                      "level": 0
                    },
                    {
                      "text": "Can provide evidence of denervation, reinnervation and abnormal motor-unit recruitment.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electromyograph_emg_subsection_6",
          "subsection_title": "5. Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electromyograph_emg_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Needle insertion may cause discomfort or anxiety.",
                      "level": 0
                    },
                    {
                      "text": "Results depend on the examiner's experience and the muscles selected.",
                      "level": 0
                    },
                    {
                      "text": "It does not identify every cause of weakness, pain or sensory disturbance.",
                      "level": 0
                    },
                    {
                      "text": "Very early disease, intermittent symptoms or sampling the wrong muscles can result in a normal study despite disease.",
                      "level": 0
                    },
                    {
                      "text": "Needle EMG assesses selected muscles; it does not examine every muscle in the body.",
                      "level": 0
                    },
                    {
                      "text": "It is less useful for disorders that do not produce detectable abnormalities in the sampled muscles.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electromyograph_emg_subsection_7",
          "subsection_title": "6. Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electromyograph_emg_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Before the procedure:",
                  "items": [
                    {
                      "text": "Explain the purpose, steps, expected discomfort and possible complications.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Obtain informed consent and confirm the patient's identity.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Review the symptoms, relevant medical history and the clinical question.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Ask about anticoagulants, bleeding disorders, local skin infection, relevant implanted devices and previous procedures.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Inspect the intended insertion sites.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Ensure appropriate hand hygiene, skin antisepsis and sterile single-use needle electrodes.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Position the patient comfortably and expose only the required area.",
                      "level": 0,
                      "label": "7."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Precaution: Anticoagulation is not automatically a contraindication. The clinician should assess bleeding risk, medication details, the muscle being sampled and local protocols. Avoid inserting a needle through infected skin. Additional caution is required when sampling deep or anatomically high-risk muscles."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electromyograph_emg_subsection_8",
          "subsection_title": "7. Step-by-step practical procedure",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electromyograph_emg_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Step 1 — Confirm and explain"
                },
                {
                  "type": "paragraph",
                  "text": "Verify identity, indication and consent. Explain that brief discomfort may occur during needle insertion."
                },
                {
                  "type": "paragraph",
                  "text": "Step 2 — Position the patient"
                },
                {
                  "type": "paragraph",
                  "text": "Support the limb or body part so the selected muscles can relax and then contract on command."
                },
                {
                  "type": "paragraph",
                  "text": "Step 3 — Prepare the equipment"
                },
                {
                  "type": "paragraph",
                  "text": "Check the machine, cables, recording settings and electrodes. Prepare the skin and use the appropriate sterile needle electrode."
                },
                {
                  "type": "paragraph",
                  "text": "Step 4 — Record insertional activity and rest"
                },
                {
                  "type": "paragraph",
                  "text": "A trained clinician inserts the needle into selected muscles and observes electrical activity during insertion and while the muscle is relaxed."
                },
                {
                  "type": "paragraph",
                  "text": "Step 5 — Assess voluntary contraction"
                },
                {
                  "type": "paragraph",
                  "text": "Ask the patient to contract the muscle gently, then more strongly as directed. Observe motor-unit action potentials and recruitment patterns."
                },
                {
                  "type": "paragraph",
                  "text": "Step 6 — Complete and document"
                },
                {
                  "type": "paragraph",
                  "text": "Remove the needle, apply pressure if needed, check the site and document the muscles examined and findings. If NCS is included, record nerve responses and relevant measurements."
                }
              ]
            },
            {
              "group_id": "electromyograph_emg_group_9",
              "group_title": "What is assessed during needle EMG?",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Insertional activity: Electrical activity associated with needle movement.",
                      "level": 0
                    },
                    {
                      "text": "Spontaneous activity at rest: For example, fibrillation potentials, positive sharp waves or fasciculation potentials.",
                      "level": 0
                    },
                    {
                      "text": "Motor-unit action potentials (MUAPs): Their amplitude, duration, phases and morphology.",
                      "level": 0
                    },
                    {
                      "text": "Recruitment pattern: How motor units are activated as the patient increases voluntary effort.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "electromyograph_emg_group_10",
              "group_title": "What is measured during nerve conduction studies?",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Latency: Time between stimulation and the recorded response.",
                      "level": 0
                    },
                    {
                      "text": "Amplitude: Size of the recorded response.",
                      "level": 0
                    },
                    {
                      "text": "Conduction velocity: Speed at which an impulse travels along the tested nerve segment, when the required measurements are available.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electromyograph_emg_subsection_9",
          "subsection_title": "8. Contraindications and complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electromyograph_emg_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "There are few absolute contraindications to needle EMG, but the risks must be assessed individually."
                },
                {
                  "type": "table",
                  "columns": [
                    "Issue",
                    "OSCE point"
                  ],
                  "rows": [
                    [
                      "Local skin infection",
                      "Avoid needle insertion through the infected area"
                    ],
                    [
                      "Bleeding disorder or anticoagulation",
                      "Assess bleeding risk and use appropriate precautions"
                    ],
                    [
                      "Severe needle anxiety",
                      "Explain the procedure, offer reassurance and consider whether the test can be adapted"
                    ],
                    [
                      "Deep or high-risk muscle sampling",
                      "Requires specific expertise because of nearby structures"
                    ],
                    [
                      "Implanted electrical devices",
                      "Review the device and planned stimulation, particularly for specialised NCS protocols"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Possible complications"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Temporary pain or tenderness.",
                      "level": 0
                    },
                    {
                      "text": "Minor bleeding or bruising.",
                      "level": 0
                    },
                    {
                      "text": "Rare local infection.",
                      "level": 0
                    },
                    {
                      "text": "Very rarely, pneumothorax when certain thoracic or nearby muscles are sampled.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electromyograph_emg_subsection_10",
          "subsection_title": "9. Normal and abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electromyograph_emg_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Normal needle EMG"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Appropriate insertional activity.",
                      "level": 0
                    },
                    {
                      "text": "No abnormal spontaneous activity at rest.",
                      "level": 0
                    },
                    {
                      "text": "Normal-appearing motor-unit potentials for the muscle and clinical context.",
                      "level": 0
                    },
                    {
                      "text": "Appropriate recruitment with voluntary contraction.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Abnormal needle EMG"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Fibrillation potentials and positive sharp waves: May indicate muscle-fibre denervation or membrane irritability.",
                      "level": 0
                    },
                    {
                      "text": "Fasciculation potentials: May occur in several conditions, including benign fasciculation and motor neuron disorders; they are not diagnostic alone.",
                      "level": 0
                    },
                    {
                      "text": "Neurogenic pattern: Often large, long-duration motor-unit potentials with reduced recruitment due to reinnervation and loss of functioning motor units.",
                      "level": 0
                    },
                    {
                      "text": "Myopathic pattern: Often small, short-duration motor-unit potentials with early recruitment.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "electromyograph_emg_group_13",
              "group_title": "Nerve conduction study abnormalities",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Prolonged distal latency can suggest focal nerve dysfunction or demyelination.",
                      "level": 0
                    },
                    {
                      "text": "Slowed conduction velocity may suggest demyelination or focal nerve compression, depending on the pattern.",
                      "level": 0
                    },
                    {
                      "text": "Reduced response amplitude may indicate axonal loss or loss of functioning motor units.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Interpretation depends on temperature, age, the nerve tested, technical factors and the clinical context. No single finding should be interpreted in isolation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electromyograph_emg_subsection_11",
          "subsection_title": "10. Paediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electromyograph_emg_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Explain the procedure in age-appropriate language and obtain appropriate consent and assent.",
                      "level": 0
                    },
                    {
                      "text": "A parent or caregiver may provide reassurance and support.",
                      "level": 0
                    },
                    {
                      "text": "Use appropriate electrode sizes and carefully select the muscles examined.",
                      "level": 0
                    },
                    {
                      "text": "Minimise distress by explaining each step and allowing breaks where possible.",
                      "level": 0
                    },
                    {
                      "text": "Interpret results using age-appropriate reference values.",
                      "level": 0
                    },
                    {
                      "text": "The decision to perform needle EMG in a child should be based on the clinical indication and the expected diagnostic benefit.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electromyograph_emg_subsection_12",
          "subsection_title": "11. Mnemonics and memory aids",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electromyograph_emg_group_15",
              "group_title": "The EMG procedure: R-R-C",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "R — Rest: assess spontaneous activity.",
                      "level": 0
                    },
                    {
                      "text": "R — Recruitment: assess activation with voluntary contraction.",
                      "level": 0
                    },
                    {
                      "text": "C — Configuration: analyse motor-unit potential morphology.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "electromyograph_emg_group_16",
              "group_title": "Neurogenic versus myopathic patterns",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Neurogenic pattern",
                    "Myopathic pattern"
                  ],
                  "rows": [
                    [
                      "Typical MUAP size",
                      "Larger",
                      "Smaller"
                    ],
                    [
                      "Duration",
                      "Often longer",
                      "Often shorter"
                    ],
                    [
                      "Recruitment",
                      "Reduced",
                      "Often early"
                    ],
                    [
                      "Main mechanism",
                      "Nerve or motor-unit loss with reinnervation",
                      "Muscle-fibre disease"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Memory aid: “Neurogenic = Large and Less; Myopathic = Small and Soon.”"
                },
                {
                  "type": "paragraph",
                  "text": "This is a simplified exam aid; real findings vary by disease, stage and muscle sampled."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electromyograph_emg_subsection_13",
          "subsection_title": "12. Common OSCE questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electromyograph_emg_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is an electromyograph?"
                },
                {
                  "type": "paragraph",
                  "text": "An electromyograph is a diagnostic instrument that records and analyses the electrical activity of skeletal muscle to help investigate neuromuscular disorders."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is the difference between EMG and nerve conduction studies?"
                },
                {
                  "type": "paragraph",
                  "text": "Needle EMG records electrical activity within muscles. Nerve conduction studies electrically stimulate peripheral nerves and measure the resulting nerve or muscle responses. The tests are often performed together."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Mention four indications for EMG."
                },
                {
                  "type": "paragraph",
                  "text": "Peripheral neuropathy, radiculopathy, myopathy and motor neuron disease. Other indications include plexopathy and unexplained muscle weakness."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. What are fibrillation potentials?"
                },
                {
                  "type": "paragraph",
                  "text": "They are spontaneous electrical discharges from individual muscle fibres that can be associated with denervation or muscle-fibre membrane irritability. They are not specific to one diagnosis."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What is the typical difference between neurogenic and myopathic EMG findings?"
                },
                {
                  "type": "paragraph",
                  "text": "Neurogenic disorders often produce large, long-duration motor-unit potentials with reduced recruitment. Myopathic disorders often produce small, short-duration potentials with early recruitment."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Is EMG painful?"
                },
                {
                  "type": "paragraph",
                  "text": "Needle insertion and movement can cause brief discomfort, and some muscles may be more sensitive than others. The procedure is generally well tolerated, but the experience varies."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. Name two complications."
                },
                {
                  "type": "paragraph",
                  "text": "Minor bleeding or bruising and temporary pain. Infection and pneumothorax are rare complications in the relevant circumstances."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "electromyograph_emg_subsection_14",
          "subsection_title": "13. Common mistakes and examiner tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "electromyograph_emg_group_18",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Calling EMG and NCS the same investigation.",
                      "level": 0
                    },
                    {
                      "text": "Forgetting to explain the procedure and obtain consent.",
                      "level": 0
                    },
                    {
                      "text": "Failing to ask about bleeding risk or inspect the insertion site.",
                      "level": 0
                    },
                    {
                      "text": "Saying that fasciculations alone diagnose motor neuron disease.",
                      "level": 0
                    },
                    {
                      "text": "Assuming every abnormal EMG finding is diagnostic of one condition.",
                      "level": 0
                    },
                    {
                      "text": "Forgetting that a normal study does not exclude all neuromuscular disease.",
                      "level": 0
                    },
                    {
                      "text": "Failing to mention that the test is operator-dependent and must be interpreted alongside clinical findings.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Examiner tip: When shown an EMG machine, identify the instrument first, state its function, give three indications, describe the needle electrode and explain the difference between neurogenic and myopathic patterns."
                }
              ]
            }
