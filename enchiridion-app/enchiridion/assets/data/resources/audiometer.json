      "section_id": "audiometer_section_1",
      "section_title": "Audiometer",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "audiometer_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "audiometer_group_1",
              "group_title": "Audiometer — ENT OSCE Instrument Guide",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/audiometer_01.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/audiometer_02.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/audiometer_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "An audiometer is a diagnostic instrument used to assess hearing sensitivity by presenting sounds at controlled frequencies and intensities. It is commonly used in pure-tone audiometry to determine hearing thresholds and help classify hearing loss."
                },
                {
                  "type": "paragraph",
                  "text": "For OSCE purposes, know how to identify the instrument, explain air- and bone-conduction testing, describe the procedure, and interpret a basic audiogram."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "audiometer_subsection_2",
          "subsection_title": "1. Identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "audiometer_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Name: Audiometer.",
                      "level": 0
                    },
                    {
                      "text": "Classification: ENT diagnostic and audiological equipment.",
                      "level": 0
                    },
                    {
                      "text": "Common type: Pure-tone audiometer.",
                      "level": 0
                    },
                    {
                      "text": "Function: Measures hearing thresholds at selected frequencies and sound intensities.",
                      "level": 0
                    },
                    {
                      "text": "Distinguishing features: A control unit with frequency and intensity settings, response controls, earphones and usually a bone-conduction vibrator.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Other audiometers may be designed for speech audiometry, screening or specialised hearing assessments."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "audiometer_subsection_3",
          "subsection_title": "2. Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "audiometer_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Indication",
                    "Purpose"
                  ],
                  "rows": [
                    [
                      "Suspected hearing loss",
                      "Determine hearing thresholds"
                    ],
                    [
                      "Conductive versus sensorineural loss",
                      "Compare air- and bone-conduction thresholds"
                    ],
                    [
                      "Tinnitus assessment",
                      "Evaluate hearing function associated with tinnitus"
                    ],
                    [
                      "Occupational hearing surveillance",
                      "Detect changes related to noise exposure"
                    ],
                    [
                      "Hearing-aid assessment",
                      "Characterise the degree and type of hearing loss"
                    ],
                    [
                      "Follow-up of ear disease",
                      "Monitor hearing over time"
                    ],
                    [
                      "Screening and referral",
                      "Identify people who need further audiological assessment"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important: Pure-tone audiometry measures hearing thresholds. It does not, by itself, identify the exact cause of hearing loss."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "audiometer_subsection_4",
          "subsection_title": "3. Parts and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "audiometer_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/audiometer_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Control unit"
                },
                {
                  "type": "paragraph",
                  "text": "Allows the examiner to select test frequencies, presentation intensity and test mode."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/audiometer_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Air-conduction earphones"
                },
                {
                  "type": "paragraph",
                  "text": "Deliver sounds through the external and middle ear to the cochlea."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/audiometer_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Bone-conduction vibrator"
                },
                {
                  "type": "paragraph",
                  "text": "Delivers vibration through the skull, helping assess cochlear hearing while bypassing much of the external and middle ear."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/audiometer_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Patient response button or signal"
                },
                {
                  "type": "paragraph",
                  "text": "Allows the patient to indicate when a tone is heard."
                },
                {
                  "type": "paragraph",
                  "text": "Other components may include a talk-forward microphone, masking controls and a sound-treated booth or quiet test room."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "audiometer_subsection_5",
          "subsection_title": "4. Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "audiometer_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Provides quantitative hearing-threshold measurements.",
                      "level": 0
                    },
                    {
                      "text": "Helps distinguish conductive, sensorineural and mixed hearing loss.",
                      "level": 0
                    },
                    {
                      "text": "Can test each ear separately.",
                      "level": 0
                    },
                    {
                      "text": "Is useful for baseline assessment and follow-up.",
                      "level": 0
                    },
                    {
                      "text": "Supports clinical decisions about referral, further investigations and hearing rehabilitation.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "audiometer_subsection_6",
          "subsection_title": "5. Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "audiometer_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Requires patient cooperation and understanding.",
                      "level": 0
                    },
                    {
                      "text": "Results can be affected by background noise, poor headphone placement or equipment calibration.",
                      "level": 0
                    },
                    {
                      "text": "Standard pure-tone testing depends on behavioural responses and may be difficult in very young children or people unable to respond reliably.",
                      "level": 0
                    },
                    {
                      "text": "It does not establish the anatomical cause of hearing loss.",
                      "level": 0
                    },
                    {
                      "text": "Bone-conduction results may require masking to ensure the tested ear is being assessed correctly.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "audiometer_subsection_7",
          "subsection_title": "6. Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "audiometer_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Before testing:",
                  "items": [
                    {
                      "text": "Explain the procedure and obtain consent.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Check the instrument, transducers and calibration status according to local policy.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Ensure the room is sufficiently quiet or use a suitable sound-treated booth.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Ask about hearing symptoms, ear surgery, noise exposure and relevant ear disease.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Inspect the external ears and, where indicated, perform otoscopy before placing the earphones.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Ensure the patient understands how to respond, even when the tone is faint.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Position the earphones correctly and remove obstructing hair, glasses or earrings if necessary.",
                      "level": 0,
                      "label": "7."
                    },
                    {
                      "text": "Follow local infection-control procedures for equipment contacting the patient.",
                      "level": 0,
                      "label": "8."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Precaution: If there is suspected acute ear disease, significant ear pain, or a possible obstruction such as impacted wax, assess the ear and determine whether testing should proceed or be deferred."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "audiometer_subsection_8",
          "subsection_title": "7. Step-by-step practical procedure",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "audiometer_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Step 1 — Explain the test"
                },
                {
                  "type": "paragraph",
                  "text": "Tell the patient they will hear tones of different pitches and loudness. Ask them to signal whenever they hear a tone, however faint, and explain that some tones may be very difficult to hear."
                },
                {
                  "type": "paragraph",
                  "text": "Step 2 — Position the transducers"
                },
                {
                  "type": "paragraph",
                  "text": "Place the correctly labelled earphones over the ears, ensuring the right and left channels are not reversed. Position the bone vibrator on the mastoid when bone-conduction testing is required."
                },
                {
                  "type": "paragraph",
                  "text": "Step 3 — Establish that the patient understands"
                },
                {
                  "type": "paragraph",
                  "text": "Present a clearly audible tone, often at 1,000 Hz, and confirm a reliable response before beginning threshold determination."
                },
                {
                  "type": "paragraph",
                  "text": "Step 4 — Determine air-conduction thresholds"
                },
                {
                  "type": "paragraph",
                  "text": "Test standard frequencies, commonly 250, 500, 1,000, 2,000, 4,000 and 8,000 Hz, with additional frequencies when indicated. Use the laboratory's standard threshold procedure, testing each ear separately."
                },
                {
                  "type": "paragraph",
                  "text": "Step 5 — Determine bone-conduction thresholds"
                },
                {
                  "type": "paragraph",
                  "text": "When indicated, place the bone vibrator correctly and assess selected frequencies. Use masking when required to prevent the opposite ear from responding to the stimulus."
                },
                {
                  "type": "paragraph",
                  "text": "Step 6 — Plot and interpret"
                },
                {
                  "type": "paragraph",
                  "text": "Record thresholds in dB HL against frequency in Hz on an audiogram. Compare air and bone conduction and assess the degree, type and configuration of hearing loss."
                }
              ]
            },
            {
              "group_id": "audiometer_group_9",
              "group_title": "How is a hearing threshold determined?",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "A common approach is the modified Hughson–Westlake method:",
                  "items": [
                    {
                      "text": "Present a tone at a clearly audible level.",
                      "level": 0
                    },
                    {
                      "text": "After a response, decrease intensity by 10 dB.",
                      "level": 0
                    },
                    {
                      "text": "When there is no response, increase intensity by 5 dB.",
                      "level": 0
                    },
                    {
                      "text": "Continue until the threshold criterion is met, commonly responses at least 50% of ascending presentations at that level.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Exact protocols vary by setting. The key OSCE point is that threshold is not simply the quietest sound heard once."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "audiometer_subsection_9",
          "subsection_title": "8. Contraindications and complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "audiometer_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Pure-tone audiometry is non-invasive and generally safe, with few absolute contraindications."
                },
                {
                  "type": "table",
                  "columns": [
                    "Situation",
                    "Consideration"
                  ],
                  "rows": [
                    [
                      "Severe ear pain or acute ear disease",
                      "Assess first and consider whether testing should be deferred"
                    ],
                    [
                      "Impacted cerumen",
                      "May affect results; assess and manage appropriately"
                    ],
                    [
                      "Inability to understand or perform the task",
                      "Use adapted methods or objective tests where indicated"
                    ],
                    [
                      "Excessive environmental noise",
                      "Can invalidate thresholds; repeat in a suitable environment"
                    ],
                    [
                      "Poorly fitted transducers",
                      "Correct positioning before interpreting results"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Complications: There are no usual physical complications from routine pure-tone testing. The main risks are discomfort from poorly fitted earphones, unreliable results and misinterpretation of an invalid test."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "audiometer_subsection_10",
          "subsection_title": "9. Normal and abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "audiometer_group_11",
              "group_title": "Typical adult hearing thresholds",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "**Hearing level in dB HL**"
                },
                {
                  "type": "paragraph",
                  "text": "Lower thresholds indicate that quieter sounds can be detected."
                },
                {
                  "type": "paragraph",
                  "text": "−10 to 20 dB HL"
                },
                {
                  "type": "paragraph",
                  "text": "Typically normal"
                },
                {
                  "type": "paragraph",
                  "text": "Above 20 dB HL"
                },
                {
                  "type": "paragraph",
                  "text": "May indicate hearing loss"
                },
                {
                  "type": "paragraph",
                  "text": "Interpretation depends on age, frequency, testing standards and clinical context. Paediatric criteria may differ."
                }
              ]
            },
            {
              "group_id": "audiometer_group_12",
              "group_title": "Common patterns on an audiogram",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Pattern",
                    "Air conduction",
                    "Bone conduction",
                    "Interpretation"
                  ],
                  "rows": [
                    [
                      "Normal hearing",
                      "Within normal limits",
                      "Within normal limits",
                      "No significant threshold elevation"
                    ],
                    [
                      "Conductive hearing loss",
                      "Elevated thresholds",
                      "Relatively preserved",
                      "Air–bone gap present"
                    ],
                    [
                      "Sensorineural hearing loss",
                      "Elevated thresholds",
                      "Similarly elevated",
                      "No significant air–bone gap"
                    ],
                    [
                      "Mixed hearing loss",
                      "Elevated thresholds",
                      "Elevated, but better than air",
                      "Air–bone gap plus bone-threshold elevation"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A significant air–bone gap suggests a conductive component, but the size and clinical meaning must be assessed against the applicable testing criteria and masking requirements."
                }
              ]
            },
            {
              "group_id": "audiometer_group_13",
              "group_title": "How to describe an audiogram in an OSCE",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "State:",
                  "items": [
                    {
                      "text": "The hearing thresholds in each ear.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "The degree of loss, if present.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Whether the pattern is conductive, sensorineural or mixed.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "The configuration across frequencies, such as flat, high-frequency sloping or low-frequency loss.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Any limitations affecting reliability.",
                      "level": 0,
                      "label": "5."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Do not diagnose a specific disease from an audiogram pattern alone."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "audiometer_subsection_11",
          "subsection_title": "10. Paediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "audiometer_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Use age-appropriate instructions and demonstrations.",
                      "level": 0
                    },
                    {
                      "text": "Young children may require visual reinforcement, play audiometry or other adapted behavioural methods.",
                      "level": 0
                    },
                    {
                      "text": "Very young infants may need objective tests such as otoacoustic emissions (OAE) or auditory brainstem response (ABR), depending on the clinical question.",
                      "level": 0
                    },
                    {
                      "text": "Use appropriately sized transducers and minimise anxiety.",
                      "level": 0
                    },
                    {
                      "text": "Interpret results using age-appropriate reference standards.",
                      "level": 0
                    },
                    {
                      "text": "If responses are inconsistent, do not assume normal hearing; arrange an appropriate alternative assessment.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "audiometer_subsection_12",
          "subsection_title": "11. Mnemonics and memory aids",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "audiometer_group_15",
              "group_title": "Audiogram interpretation: A-B-G",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "A — Air conduction.",
                      "level": 0
                    },
                    {
                      "text": "B — Bone conduction.",
                      "level": 0
                    },
                    {
                      "text": "G — Gap between them.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "An air–bone gap suggests a conductive component."
                }
              ]
            },
            {
              "group_id": "audiometer_group_16",
              "group_title": "Degree of hearing loss: N-S-M-S-P",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "N — Normal",
                      "level": 0
                    },
                    {
                      "text": "S — Slight",
                      "level": 0
                    },
                    {
                      "text": "M — Mild",
                      "level": 0
                    },
                    {
                      "text": "S — Severe",
                      "level": 0
                    },
                    {
                      "text": "P — Profound",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "This is a memory aid, not a universal classification: formal categories and cut-offs vary across guidelines. For examinations, use the classification specified by the examiner or local standard."
                }
              ]
            },
            {
              "group_id": "audiometer_group_17",
              "group_title": "Common audiogram symbols",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "**O**"
                },
                {
                  "type": "paragraph",
                  "text": "Right-ear air conduction"
                },
                {
                  "type": "paragraph",
                  "text": "Commonly plotted as a red circle."
                }
              ]
            },
            {
              "group_id": "audiometer_group_18",
              "group_title": "X",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Left-ear air conduction"
                },
                {
                  "type": "paragraph",
                  "text": "Commonly plotted as a blue cross."
                }
              ]
            },
            {
              "group_id": "audiometer_group_19",
              "group_title": "[",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Bone-conduction notation"
                },
                {
                  "type": "paragraph",
                  "text": "Brackets and related symbols distinguish bone-conduction thresholds; exact notation varies by masking status and convention."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "audiometer_subsection_13",
          "subsection_title": "12. Common OSCE questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "audiometer_group_20",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. Identify this instrument."
                },
                {
                  "type": "paragraph",
                  "text": "This is an audiometer, a diagnostic instrument used to assess hearing thresholds at different frequencies and intensities."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is the difference between air and bone conduction?"
                },
                {
                  "type": "paragraph",
                  "text": "Air conduction assesses sound transmission through the external and middle ear as well as the cochlea and auditory pathways. Bone conduction stimulates the cochlea through skull vibration, largely bypassing the external and middle ear."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. How do you distinguish conductive from sensorineural hearing loss?"
                },
                {
                  "type": "paragraph",
                  "text": "Conductive loss typically produces elevated air-conduction thresholds with relatively preserved bone-conduction thresholds, creating an air–bone gap. Sensorineural loss elevates both air- and bone-conduction thresholds without a significant gap."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. What does dB HL mean?"
                },
                {
                  "type": "paragraph",
                  "text": "Decibels hearing level. It expresses hearing thresholds relative to standardised reference levels for normal hearing, rather than simply describing the physical intensity of a sound in dB SPL."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What is an audiogram?"
                },
                {
                  "type": "paragraph",
                  "text": "A graph showing hearing thresholds at different frequencies for each ear."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Why is masking sometimes required?"
                },
                {
                  "type": "paragraph",
                  "text": "A sufficiently loud tone presented to one ear may be heard by the opposite cochlea. Masking helps ensure that the measured response represents the intended ear."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What are the limitations of pure-tone audiometry?"
                },
                {
                  "type": "paragraph",
                  "text": "It requires reliable patient responses, is affected by environmental noise and equipment calibration, and does not independently identify the underlying cause of hearing loss."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "audiometer_subsection_14",
          "subsection_title": "13. Common mistakes and examiner tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "audiometer_group_21",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Avoid these common errors:",
                  "items": [
                    {
                      "text": "Confusing an audiometer with a tympanometer.",
                      "level": 0
                    },
                    {
                      "text": "Forgetting to test each ear separately.",
                      "level": 0
                    },
                    {
                      "text": "Mixing up frequency, measured in Hz, with intensity, expressed in dB HL.",
                      "level": 0
                    },
                    {
                      "text": "Interpreting air conduction alone when the question asks for the type of hearing loss.",
                      "level": 0
                    },
                    {
                      "text": "Forgetting that bone-conduction testing may require masking.",
                      "level": 0
                    },
                    {
                      "text": "Calling every elevated threshold sensorineural hearing loss.",
                      "level": 0
                    },
                    {
                      "text": "Ignoring the patient's reliability or the testing environment.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Examiner tip: When given an audiogram, first identify the axes, then describe the right and left ears, compare air and bone conduction, and finally state the likely type and degree of hearing loss."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "audiometer_subsection_15",
          "subsection_title": "14. Mini-OSCE practice quiz",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "audiometer_group_22",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "1. What does the horizontal axis of a standard audiogram represent?"
                },
                {
                  "type": "paragraph",
                  "text": "Sound intensity in dB HL"
                },
                {
                  "type": "paragraph",
                  "text": "Frequency in Hz"
                },
                {
                  "type": "paragraph",
                  "text": "Age in years"
                },
                {
                  "type": "paragraph",
                  "text": "2. What pattern most strongly suggests conductive hearing loss?"
                },
                {
                  "type": "paragraph",
                  "text": "Elevated air thresholds with relatively preserved bone thresholds"
                },
                {
                  "type": "paragraph",
                  "text": "Air and bone thresholds equally elevated without a gap"
                },
                {
                  "type": "paragraph",
                  "text": "Normal air and bone thresholds"
                },
                {
                  "type": "paragraph",
                  "text": "3. Why might masking be used during audiometry?"
                },
                {
                  "type": "paragraph",
                  "text": "To make all sounds louder"
                },
                {
                  "type": "paragraph",
                  "text": "To prevent the non-test ear from detecting the test tone"
                },
                {
                  "type": "paragraph",
                  "text": "To measure middle-ear pressure"
                }
              ]
            },
            {
              "group_id": "audiometer_group_23",
              "group_title": "High-yield summary",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Instrument: Audiometer.",
                      "level": 0
                    },
                    {
                      "text": "Purpose: Measures hearing thresholds at selected frequencies.",
                      "level": 0
                    },
                    {
                      "text": "Main components: Control unit, earphones, bone-conduction vibrator and response control.",
                      "level": 0
                    },
                    {
                      "text": "Key distinction: Conductive loss produces an air–bone gap; sensorineural loss generally elevates both thresholds without a significant gap.",
                      "level": 0
                    },
                    {
                      "text": "Audiogram axes: Frequency in Hz horizontally and hearing level in dB HL vertically.",
                      "level": 0
                    },
                    {
                      "text": "Important limitation: Pure-tone audiometry does not independently determine the cause of hearing loss.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "."
                }
              ]
            }
          ]
        }
      ]
