      "section_id": "endotracheal_tube_section_1",
      "section_title": "Endotracheal tube",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "endotracheal_tube_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "endotracheal_tube_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/endotracheal_tube_01.webp",
                  "caption": null
                },
                {
