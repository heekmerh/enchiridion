    {
      "section_id": "scalpel_section_1",
      "section_title": "Scalpel",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "scalpel_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "scalpel_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/scalpel_01.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/scalpel_02.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/scalpel_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A scalpel is one of the most fundamental surgical instruments. It is a sharp cutting instrument used to make precise incisions through the skin and other tissues during surgical procedures."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "scalpel_subsection_2",
          "subsection_title": "Introduction and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "scalpel_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Instrument: Scalpel (surgical knife)."
                },
                {
                  "type": "paragraph",
                  "text": "Category: Cutting and dissecting instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Primary function: To make clean, controlled incisions through tissues."
                },
                {
                  "type": "paragraph",
                  "text": "Material: Usually stainless steel; reusable handles may be made from stainless steel, while some disposable scalpels have plastic handles."
                },
                {
                  "type": "paragraph",
                  "text": "Sterility: The scalpel and blade must be sterile when used in a sterile surgical field."
                }
              ]
            },
            {
              "group_id": "scalpel_group_3",
              "group_title": "How to identify it in an OSCE",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Look for the following features:"
                },
                {
                  "type": "paragraph",
                  "text": "A narrow, sharp cutting blade or a detachable blade mounted on a handle."
                },
                {
                  "type": "paragraph",
                  "text": "A handle designed to provide grip, stability and controlled movement."
                },
                {
                  "type": "paragraph",
                  "text": "A cutting edge that may be straight, curved, pointed or rounded, depending on the blade type."
                },
                {
                  "type": "paragraph",
                  "text": "A reusable handle with a detachable blade, or a complete disposable scalpel."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Typical examiner question: “What is this instrument?”"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Model answer: “This is a surgical scalpel, a cutting instrument used to make precise incisions in skin and other tissues. It may consist of a reusable handle with a detachable sterile blade or be supplied as a disposable unit.”"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "scalpel_subsection_3",
          "subsection_title": "Labelling of the scalpel",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "scalpel_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/scalpel_04.webp",
                  "caption": "3. Classification and types"
                },
                {
                  "type": "paragraph",
                  "text": "Scalpels can be classified according to their construction and blade design."
                }
              ]
            },
            {
              "group_id": "scalpel_group_5",
              "group_title": "A. According to construction",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Reusable scalpel handle"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A metal handle onto which a compatible sterile, single-use blade is mounted. The handle is cleaned, inspected and sterilised between procedures according to its instructions for use."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/scalpel_02.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Disposable scalpel"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A complete unit supplied sterile, generally intended for single use and discarded into the appropriate sharps container after use."
                }
              ]
            },
            {
              "group_id": "scalpel_group_6",
              "group_title": "B. According to blade shape and number",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The following are high-yield blade types for surgical OSCEs."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/scalpel_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "No. 10 blade",
                    "High yield"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Broad, curved cutting edge."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: General skin incisions, including many abdominal and limb incisions."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/scalpel_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "No. 11 blade"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Long, triangular blade with a sharp point."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: Small stab incisions, opening abscesses, and certain drain or catheter access incisions when indicated."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/scalpel_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "No. 12 blade"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Hook-shaped blade with a curved cutting edge."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: Selected procedures requiring a hooked cutting profile, including certain ENT and dental procedures."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/scalpel_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "No. 15 blade"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Small blade with a curved cutting edge."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: Short, precise incisions, minor surgery, skin lesions and delicate surgical work."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/scalpel_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "No. 20 blade"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Larger version of the broad, curved blade pattern."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: Larger incisions where a broader cutting edge is appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Important distinction: Blade numbers and handle compatibility are related but not interchangeable. For example, No. 10, 11, 12 and 15 blades commonly fit a No. 3-family handle, whereas larger blades such as No. 20 commonly fit a No. 4-family handle. Always check the manufacturer's compatibility specifications."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "scalpel_subsection_4",
          "subsection_title": "Principles of scalpel use",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "scalpel_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The objective is to create an incision with controlled depth, direction and minimal unnecessary tissue injury."
                }
              ]
            },
            {
              "group_id": "scalpel_group_8",
              "group_title": "A. Basic surgical principles",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Precision: The incision should follow the planned surgical line."
                },
                {
                  "type": "paragraph",
                  "text": "Control: The surgeon should maintain a stable grip and controlled movement."
                },
                {
                  "type": "paragraph",
                  "text": "Adequate exposure: The operator should be able to see the intended incision site clearly."
                },
                {
                  "type": "paragraph",
                  "text": "Tissue preservation: Avoid unnecessary damage to surrounding tissues and important structures."
                },
                {
                  "type": "paragraph",
                  "text": "Haemostasis: Control bleeding arising from divided vessels."
                },
                {
                  "type": "paragraph",
                  "text": "Asepsis: Use a sterile blade and maintain the sterile field."
                },
                {
                  "type": "paragraph",
                  "text": "Safety: Avoid accidental injury to the patient and theatre personnel."
                }
              ]
            },
            {
              "group_id": "scalpel_group_9",
              "group_title": "B. Common scalpel grips",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/scalpel_10.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Pencil grip"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Held similarly to a writing pen."
                },
                {
                  "type": "paragraph",
                  "text": "Purpose: Fine control for short, delicate incisions and superficial precision work."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/scalpel_11.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Palmar grip"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The handle rests in the palm with the fingers controlling movement."
                },
                {
                  "type": "paragraph",
                  "text": "Purpose: Greater stability and control for longer incisions, when appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "The choice of grip depends on the procedure, blade, tissue and surgeon's training. In an OSCE, explain the grip rather than attempting an unfamiliar manoeuvre with a sharp instrument."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "scalpel_subsection_5",
          "subsection_title": "Uses and surgeries",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "scalpel_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Procedure or specialty",
                    "Role of the scalpel"
                  ],
                  "rows": [
                    [
                      "General surgery",
                      "Skin and soft-tissue incisions for laparotomy, hernia repair and other open procedures"
                    ],
                    [
                      "Orthopaedic surgery",
                      "Skin incision for fracture fixation and other operations"
                    ],
                    [
                      "Obstetrics and gynaecology",
                      "Skin incision for caesarean delivery and selected open operations"
                    ],
                    [
                      "Plastic surgery",
                      "Precise incisions in reconstructive and cosmetic procedures"
                    ],
                    [
                      "Dermatology",
                      "Excision or biopsy of selected skin lesions"
                    ],
                    [
                      "Neurosurgery",
                      "Selected skin and soft-tissue incisions"
                    ],
                    [
                      "ENT surgery",
                      "Selected incisions in the ear, nose and throat"
                    ],
                    [
                      "Emergency surgery",
                      "Incisions for indicated procedures such as abscess drainage"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A scalpel is not limited to skin. It can be used to divide selected soft tissues, but the technique and instrument must be appropriate for the tissue and procedure."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "scalpel_subsection_6",
          "subsection_title": "Advantages and disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "scalpel_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Advantages"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Produces a sharp, precise incision."
                },
                {
                  "type": "paragraph",
                  "text": "Allows excellent tactile feedback and fine control."
                },
                {
                  "type": "paragraph",
                  "text": "Does not require electrical power."
                },
                {
                  "type": "paragraph",
                  "text": "Is available in a wide range of blade shapes and sizes."
                },
                {
                  "type": "paragraph",
                  "text": "Has a relatively low acquisition cost."
                },
                {
                  "type": "paragraph",
                  "text": "Avoids the thermal tissue damage associated with electrosurgery when used correctly."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Disadvantages"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Can cause accidental cuts and sharps injuries."
                },
                {
                  "type": "paragraph",
                  "text": "Provides no inherent coagulation or haemostasis."
                },
                {
                  "type": "paragraph",
                  "text": "May cause bleeding if vessels are divided."
                },
                {
                  "type": "paragraph",
                  "text": "Can injure underlying structures if incision depth is poorly controlled."
                },
                {
                  "type": "paragraph",
                  "text": "Requires careful blade handling and disposal."
                },
                {
                  "type": "paragraph",
                  "text": "Blade mounting and removal introduce additional risks with reusable handles."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "scalpel_subsection_7",
          "subsection_title": "Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "scalpel_group_12",
              "group_title": "A. Patient-related complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Haemorrhage: Injury to blood vessels."
                },
                {
                  "type": "paragraph",
                  "text": "Damage to adjacent structures: Injury to nerves, tendons, vessels or organs."
                },
                {
                  "type": "paragraph",
                  "text": "Wound infection: May occur if aseptic technique is breached or the wound becomes contaminated."
                },
                {
                  "type": "paragraph",
                  "text": "Poor wound healing: May follow excessive tissue trauma, infection or impaired tissue perfusion."
                },
                {
                  "type": "paragraph",
                  "text": "Scarring: Excessive or poorly planned incisions may lead to undesirable scars."
                },
                {
                  "type": "paragraph",
                  "text": "Wound dehiscence: Separation of wound edges may occur because of multiple contributing factors."
                },
                {
                  "type": "paragraph",
                  "text": "Unintended deep injury: An incision may extend beyond the intended tissue plane."
                }
              ]
            },
            {
              "group_id": "scalpel_group_13",
              "group_title": "B. Operator-related complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Accidental cuts to the surgeon or assistant."
                },
                {
                  "type": "paragraph",
                  "text": "Percutaneous exposure to blood-borne pathogens following a contaminated sharps injury."
                },
                {
                  "type": "paragraph",
                  "text": "Injury during passing, blade mounting or blade removal."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE distinction: A scalpel creates a mechanical cutting injury. Electrosurgical devices can produce thermal injuries in addition to other electrical hazards."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "scalpel_subsection_8",
          "subsection_title": "Safe handling and infection prevention",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "scalpel_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/scalpel_12.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/scalpel_13.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/scalpel_14.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Key safety principles include:"
                },
                {
                  "type": "paragraph",
                  "text": "Confirm the correct instrument and inspect it for damage."
                },
                {
                  "type": "paragraph",
                  "text": "Maintain aseptic technique and use the correct personal protective equipment."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid blind handling of sharp instruments."
                },
                {
                  "type": "paragraph",
                  "text": "Use a neutral zone or an agreed safe passing technique when passing sharps between team members."
                },
                {
                  "type": "paragraph",
                  "text": "Use an appropriate blade-removal device or approved technique for removing detachable blades."
                },
                {
                  "type": "paragraph",
                  "text": "Never discard a used scalpel into ordinary clinical waste."
                },
                {
                  "type": "paragraph",
                  "text": "Place disposable scalpels and detached blades in an approved sharps container."
                },
                {
                  "type": "paragraph",
                  "text": "Report and manage sharps injuries promptly according to institutional exposure protocols."
                },
                {
                  "type": "paragraph",
                  "text": "Scalpel blades are generally single-use. Reusable handles require appropriate reprocessing and sterilisation according to the manufacturer's instructions."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "scalpel_subsection_9",
          "subsection_title": "Common OSCE questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "scalpel_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is the difference between a scalpel and a surgical blade?"
                },
                {
                  "type": "paragraph",
                  "text": "Answer: A scalpel is the complete cutting instrument. It may consist of a handle and a detachable blade. The surgical blade is the sharp cutting component itself."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Which blade is commonly used for a general skin incision?"
                },
                {
                  "type": "paragraph",
                  "text": "Answer: The No. 10 blade is commonly used for general skin incisions."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Which blade is commonly used for a small stab incision?"
                },
                {
                  "type": "paragraph",
                  "text": "Answer: The No. 11 blade, because of its pointed triangular design."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Which blade is useful for short, precise incisions?"
                },
                {
                  "type": "paragraph",
                  "text": "Answer: The No. 15 blade, because its small curved cutting edge allows fine control."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. Does a scalpel provide haemostasis?"
                },
                {
                  "type": "paragraph",
                  "text": "Answer: No. It cuts tissue but does not coagulate bleeding vessels. Haemostasis may be achieved using pressure, ligatures, clips or appropriate electrosurgical methods."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Why is a scalpel preferred over electrosurgery for some incisions?"
                },
                {
                  "type": "paragraph",
                  "text": "Answer: It produces a precise mechanical incision without the thermal tissue effects associated with electrosurgery."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What are the complications of scalpel use?"
                },
                {
                  "type": "paragraph",
                  "text": "Answer: Haemorrhage, damage to adjacent structures, infection, poor wound healing, scarring, accidental operator injury and sharps-related exposure."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. How would you safely dispose of a used scalpel blade?"
                },
                {
                  "type": "paragraph",
                  "text": "Answer: I would place it directly into an approved sharps container using the appropriate safe handling method, without recapping or manually manipulating the exposed blade."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "scalpel_subsection_10",
          "subsection_title": "High-yield exam revision",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "scalpel_group_16",
              "group_title": "Blade number memory table",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Blade",
                    "Key feature",
                    "Main association"
                  ],
                  "rows": [
                    [
                      "No. 10",
                      "Broad, curved",
                      "General skin incision"
                    ],
                    [
                      "No. 11",
                      "Pointed, triangular",
                      "Stab incision"
                    ],
                    [
                      "No. 12",
                      "Hook-shaped",
                      "Selected hooked cuts"
                    ],
                    [
                      "No. 15",
                      "Small, curved",
                      "Fine, short incisions"
                    ],
                    [
                      "No. 20",
                      "Large, curved",
                      "Larger incisions"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Quick mnemonic: “10 is general, 11 is a point, 12 is a hook, 15 is precise.”"
                },
                {
                  "type": "paragraph",
                  "text": "These are common associations, not exclusive indications. Blade selection depends on the operation and the required cutting profile."
                }
              ]
            },
            {
              "group_id": "scalpel_group_17",
              "group_title": "What examiners especially want you to know",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Correct identification and function."
                },
                {
                  "type": "paragraph",
                  "text": "Recognition of blade numbers 10, 11, 12 and 15."
                },
                {
                  "type": "paragraph",
                  "text": "Difference between a scalpel handle and a blade."
                },
                {
                  "type": "paragraph",
                  "text": "Uses in common surgical procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Advantages over electrosurgery for selected incisions."
                },
                {
                  "type": "paragraph",
                  "text": "Complications, especially haemorrhage and sharps injuries."
                },
                {
                  "type": "paragraph",
                  "text": "Safe handling, sterile technique and sharps disposal."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "scalpel_subsection_11",
          "subsection_title": "A complete 30-second OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "scalpel_group_18",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a surgical scalpel, a cutting instrument used to make precise incisions in the skin and other soft tissues. It consists of a handle and a blade, which may be detachable or integral in a disposable model. Common blade types include No. 10 for general skin incisions, No. 11 for stab incisions, No. 12 for selected hooked incisions and No. 15 for short, precise incisions. Its advantages include precision, good tactile feedback and the absence of thermal injury from the cutting mechanism. Complications include bleeding, injury to adjacent structures, infection, scarring and sharps injuries. Safe use requires sterile technique, controlled handling and appropriate sharps disposal.”"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}