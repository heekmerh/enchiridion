      "subsections": [
        {
          "subsection_id": "quick_revision_part_15_subsection_1",
          "subsection_title": "Brain Injury Classification by Glasgow Coma Scale (GCS)",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_15_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Severity",
                    "GCS score"
                  ],
                  "rows": [
                    [
                      "Mild traumatic brain injury",
                      "13–15"
                    ],
                    [
                      "Moderate traumatic brain injury",
                      "9–12"
                    ],
                    [
                      "Severe traumatic brain injury",
                      "3–8"
                    ]
                  ]
                },
                {
                  "type": "checklist",
                  "items": [
                    "GCS components"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Eye opening (E): 4 spontaneous, 3 to voice, 2 to pressure, 1 none."
                },
                {
                  "type": "paragraph",
                  "text": "Verbal response (V): 5 oriented, 4 confused, 3 inappropriate words, 2 incomprehensible sounds, 1 none."
                },
                {
                  "type": "paragraph",
                  "text": "Motor response (M): 6 obeys commands, 5 localises pain, 4 withdraws, 3 abnormal flexion, 2 extension, 1 none."
                },
                {
                  "type": "paragraph",
                  "text": "Total: E + V + M = 3–15."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Signs and Symptoms of Brain Injury"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Loss or alteration of consciousness."
                },
                {
                  "type": "paragraph",
                  "text": "Headache."
                },
                {
                  "type": "paragraph",
                  "text": "Vomiting."
                },
                {
                  "type": "paragraph",
                  "text": "Amnesia."
                },
                {
                  "type": "paragraph",
                  "text": "Confusion or agitation."
                },
                {
                  "type": "paragraph",
                  "text": "Seizures."
                },
                {
                  "type": "paragraph",
                  "text": "Scalp wound or haematoma."
                },
                {
                  "type": "paragraph",
                  "text": "Periorbital ecchymosis (raccoon eyes)."
                },
                {
                  "type": "paragraph",
                  "text": "Mastoid ecchymosis (Battle sign)."
                },
                {
                  "type": "paragraph",
                  "text": "CSF rhinorrhoea or otorrhoea."
                },
                {
                  "type": "paragraph",
                  "text": "Unequal or poorly reactive pupils."
                },
                {
                  "type": "paragraph",
                  "text": "Focal neurological deficits."
                },
                {
                  "type": "paragraph",
                  "text": "Abnormal posturing."
                },
                {
                  "type": "paragraph",
                  "text": "Bradycardia, hypertension and irregular respiration (late signs of raised ICP)."
                },
                {
                  "type": "paragraph",
                  "text": "Reduced GCS."
                },
                {
                  "type": "paragraph",
                  "text": "Skull fracture signs."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_15_subsection_2",
          "subsection_title": "Risk Factors for Brain Abscess",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_15_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Contiguous spread:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "otitis media,",
                    "mastoiditis,",
                    "sinusitis,",
                    "dental infections"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Haematogenous spread:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "infective endocarditis,",
                    "cyanotic congenital heart disease,",
                    "lung abscess,",
                    "bronchiectasis,",
                    "pulmonary arteriovenous malformation"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Direct inoculation:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "penetrating head injury,",
                    "neurosurgery,",
                    "skull fracture"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Immunocompromise:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "HIV/AIDS,",
                    "transplantation,",
                    "chemotherapy,",
                    "immunosuppressive therapy",
                    "Diabetes mellitus",
                    "Chronic suppurative infections",
                    "Congenital heart disease with right-to-left shunt",
                    "Congenital dermal sinus",
                    "Intracranial foreign body",
                    "Cryptogenic infection (no identifiable source)"
                  ]
                }
              ]
            }
          ]
        },
