              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Before completing the station, ensure you can:"
                },
                {
                  "type": "paragraph",
                  "text": "Identify the drain and state its purpose."
                },
                {
                  "type": "paragraph",
                  "text": "Label the tubing, fenestrations, connectors and reservoir where present."
                },
                {
                  "type": "paragraph",
                  "text": "Distinguish passive from suction drains."
                },
                {
                  "type": "paragraph",
                  "text": "Distinguish open from closed systems."
                },
                {
                  "type": "paragraph",
                  "text": "Give examples of Penrose, JP, Redivac and chest drains."
                },
                {
                  "type": "paragraph",
                  "text": "List indications, advantages, disadvantages and complications."
                },
                {
                  "type": "paragraph",
                  "text": "Interpret common changes in drainage output."
                },
                {
                  "type": "paragraph",
                  "text": "Describe drain care and the principles of safe removal."
                }
              ]
            },
            {
              "group_id": "surgical_drain_group_25",
              "group_title": "Final exam pearls",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Penrose: Open, passive drain."
                },
                {
                  "type": "paragraph",
                  "text": "Jackson-Pratt: Closed suction drain with a bulb."
                },
                {
                  "type": "paragraph",
                  "text": "Redivac: Closed suction drain with a vacuum reservoir."
                },
                {
                  "type": "paragraph",
                  "text": "Chest drain: Specialised pleural drainage system."
                },
                {
                  "type": "paragraph",
                  "text": "Safety rule: Sudden fresh bleeding, loss of function with clinical deterioration, or signs of distal or adjacent tissue compromise require prompt assessment."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}