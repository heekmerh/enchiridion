                  "caption": null
                }
              ]
            },
            {
              "group_id": "stethoscope_group_2",
              "group_title": "1. Identification",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A stethoscope is a non-invasive clinical instrument used to listen to sounds produced within the body. This process is called auscultation."
                },
                {
                  "type": "paragraph",
                  "text": "It is commonly used in cardiovascular, respiratory, abdominal, and general physical examinations."
                },
                {
                  "type": "paragraph",
                  "text": "Common OSCE station wording:"
                },
                {
                  "type": "paragraph",
                  "text": "Identify the instrument and state five uses."
                },
                {
                  "type": "paragraph",
                  "text": "Demonstrate how to examine the heart using a stethoscope."
                },
                {
                  "type": "paragraph",
                  "text": "Explain the difference between the diaphragm and bell."
                },
                {
                  "type": "paragraph",
                  "text": "Demonstrate respiratory auscultation and describe abnormal breath sounds."
                },
                {
                  "type": "paragraph",
                  "text": "Identify the causes of poor sound transmission through a stethoscope."
                }
              ]
            },
            {
              "group_id": "stethoscope_group_3",
              "group_title": "2. Types of stethoscopes",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/stethoscope_02.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "A. Acoustic stethoscope"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The most common type. It transmits body sounds through tubing to the examiner's ears."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: Heart sounds, breath sounds, bowel sounds, and blood pressure measurement by auscultation."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/stethoscope_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Electronic stethoscope"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Amplifies and may filter or digitally record body sounds."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: Hearing faint sounds, recording sounds, and selected teaching or telemedicine applications."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/stethoscope_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "C. Pediatric stethoscope"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Has a smaller chestpiece suited to the smaller chest surface of infants and children."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: Neonatal and pediatric cardiac and respiratory examinations."
                }
              ]
            },
            {
              "group_id": "stethoscope_group_4",
              "group_title": "3. Parts and their functions",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/stethoscope_05.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Function"
                  ],
                  "rows": [
                    [
                      "Earpieces",
                      "Direct sound into the ear canals."
                    ],
                    [
                      "Ear tubes/binaurals",
                      "Connect the earpieces to the tubing."
                    ],
                    [
                      "Flexible tubing",
                      "Transmits acoustic vibrations."
                    ],
                    [
                      "Chestpiece",
                      "Contacts the patient's skin to collect sounds."
                    ],
                    [
                      "Diaphragm",
                      "Best for most higher-frequency sounds."
                    ],
                    [
                      "Bell",
                      "Useful for lower-frequency sounds when applied lightly, particularly with a traditional acoustic stethoscope."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "High-yield distinction: The diaphragm and bell are not interchangeable in every situation."
                },
                {
                  "type": "paragraph",
                  "text": "Diaphragm: Use for breath sounds, normal heart sounds, and higher-pitched murmurs."
                },
                {
                  "type": "paragraph",
                  "text": "Bell: Use for low-pitched sounds, such as the murmur of mitral stenosis, and the low-pitched component of a third or fourth heart sound when audible."
                },
                {
                  "type": "paragraph",
                  "text": "With many modern dual-head stethoscopes, the bell may be very small or use a tunable diaphragm. Follow the manufacturer's design."
                }
              ]
            },
            {
              "group_id": "stethoscope_group_5",
              "group_title": "4. Uses and indications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The stethoscope is used for:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Cardiovascular examination"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Assess heart rate and rhythm."
                },
                {
                  "type": "paragraph",
                  "text": "Identify normal S1 and S2."
                },
                {
                  "type": "paragraph",
                  "text": "Detect murmurs, extra heart sounds, and pericardial friction rubs."
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Respiratory examination"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Assess air entry."
                },
                {
                  "type": "paragraph",
                  "text": "Identify wheeze, crackles, stridor, and bronchial breathing."
                },
                {
                  "type": "paragraph",
                  "text": "Assess symmetry of breath sounds."
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Abdominal examination"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Listen for bowel sounds."
                },
                {
                  "type": "paragraph",
                  "text": "Assess for vascular bruits when indicated."
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Blood pressure measurement"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Detect Korotkoff sounds during manual sphygmomanometry."
                },
                {
                  "type": "checklist",
                  "items": [
                    "5. Pediatrics and neonatology"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Assess heart sounds, respiratory distress, air entry, and selected abdominal findings."
                },
                {
                  "type": "checklist",
                  "items": [
                    "6. Other clinical assessments"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Listen for vascular bruits and selected sounds over other body regions when clinically indicated."
                }
              ]
            },
            {
              "group_id": "stethoscope_group_6",
              "group_title": "5. Advantages",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Non-invasive and painless."
                },
                {
                  "type": "paragraph",
                  "text": "Portable and reusable."
                },
                {
                  "type": "paragraph",
                  "text": "Relatively inexpensive."
                },
                {
                  "type": "paragraph",
                  "text": "Does not require electricity for conventional acoustic models."
                },
                {
                  "type": "paragraph",
                  "text": "Provides immediate bedside information."
                },
                {
                  "type": "paragraph",
                  "text": "Useful in adults, children, and neonates with an appropriate chestpiece."
                },
                {
                  "type": "paragraph",
                  "text": "Can help identify findings that guide further investigation."
                }
              ]
            },
            {
              "group_id": "stethoscope_group_7",
              "group_title": "6. Disadvantages and limitations",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Results depend heavily on the examiner's experience."
                },
                {
                  "type": "paragraph",
                  "text": "Environmental noise can interfere with auscultation."
                },
                {
                  "type": "paragraph",
                  "text": "Poor positioning or an incorrect technique can produce misleading findings."
                },
                {
                  "type": "paragraph",
                  "text": "Clothing, movement, and inadequate skin contact can reduce sound quality."
                },
                {
                  "type": "paragraph",
                  "text": "It cannot reliably exclude serious disease when examination findings are normal."
                },
                {
                  "type": "paragraph",
                  "text": "Subtle murmurs or abnormal breath sounds may be missed."
                },
                {
                  "type": "paragraph",
                  "text": "Conventional acoustic models do not automatically record or quantify sounds."
                },
                {
                  "type": "paragraph",
                  "text": "Examiner's point: A stethoscope supports clinical assessment; it does not replace investigations such as ECG, echocardiography, chest imaging, or laboratory tests when indicated."
                }
              ]
            },
            {
              "group_id": "stethoscope_group_8",
              "group_title": "7. Preparation and precautions",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Before using the stethoscope:"
                },
                {
                  "type": "paragraph",
                  "text": "Perform hand hygiene."
                },
                {
                  "type": "paragraph",
                  "text": "Introduce yourself, confirm the patient's identity, explain the examination, and obtain consent."
                },
                {
                  "type": "paragraph",
                  "text": "Provide privacy and expose only the area required."
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the chestpiece, tubing, and earpieces for damage."
                },
                {
                  "type": "paragraph",
                  "text": "Clean the chestpiece between patients according to local infection-control policy and manufacturer instructions."
                },
                {
                  "type": "paragraph",
                  "text": "Warm the chestpiece in your hand if it is cold, particularly before examining a child."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure the room is quiet enough for auscultation."
                },
                {
                  "type": "paragraph",
                  "text": "Position the patient appropriately for the examination."
                },
                {
                  "type": "paragraph",
                  "text": "Important: Do not place the chestpiece over clothing when accurate auscultation is required. Hair, clothing friction, and movement can produce artefacts."
                }
              ]
            },
            {
              "group_id": "stethoscope_group_9",
              "group_title": "Practical demonstration checklist",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A general sequence for a clinical skills station."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Reset"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "1. Perform hand hygiene and introduce yourself."
                },
                {
                  "type": "paragraph",
                  "text": "2. Confirm the patient's identity, explain the procedure, and obtain consent."
                },
                {
                  "type": "paragraph",
                  "text": "3. Position the patient and expose the examination area appropriately."
                },
                {
                  "type": "paragraph",
                  "text": "4. Inspect the stethoscope and clean the chestpiece if needed."
                },
                {
                  "type": "paragraph",
                  "text": "5. Insert the earpieces so they point forward, following the natural direction of the ear canals."
                },
                {
                  "type": "paragraph",
                  "text": "6. Select the appropriate chestpiece surface for the sounds being assessed."
                },
                {
                  "type": "paragraph",
                  "text": "7. Place the chestpiece directly on the skin with adequate contact."
                },
                {
                  "type": "paragraph",
                  "text": "8. Listen systematically, comparing corresponding areas where appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "9. Ask the patient to breathe through the mouth during respiratory auscultation, if tolerated."
                },
                {
                  "type": "paragraph",
                  "text": "10. Thank the patient, ensure comfort and privacy, clean the equipment, and perform hand hygiene."
                },
                {
                  "type": "checklist",
                  "items": [
                    "A. During cardiac auscultation"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Listen systematically at the usual four valve areas:"
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/stethoscope_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Aortic area"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Right 2nd intercostal space, close to the sternal edge."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/stethoscope_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Pulmonary area"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Left 2nd intercostal space, close to the sternal edge."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/stethoscope_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Tricuspid area"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Lower left sternal border, commonly around the 4th–5th intercostal spaces."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/stethoscope_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Mitral area (apex)"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Usually the 5th intercostal space at or near the midclavicular line in an adult."
                },
                {
                  "type": "paragraph",
                  "text": "At each area, assess:"
                },
                {
                  "type": "paragraph",
                  "text": "Rate and rhythm."
                },
                {
                  "type": "paragraph",
                  "text": "S1 and S2."
                },
                {
                  "type": "paragraph",
                  "text": "Additional sounds."
                },
                {
                  "type": "paragraph",
                  "text": "Murmurs, including timing, pitch, intensity, location, radiation, and response to manoeuvres when indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Pediatric note: The position of the apex and the best listening areas can differ with age and cardiac anatomy. Adapt the examination to the child."
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. During respiratory auscultation"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Ask the patient to breathe through the mouth, a little deeper than usual, if tolerated."
                },
                {
                  "type": "paragraph",
                  "text": "Listen over corresponding areas on both sides of the chest."
                },
                {
                  "type": "paragraph",
                  "text": "Compare air entry and the intensity of breath sounds."
                },
                {
                  "type": "paragraph",
                  "text": "Identify added sounds, such as wheeze or crackles."
                },
                {
                  "type": "paragraph",
                  "text": "Listen over the back and lateral chest as well as the anterior chest where appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Stop briefly if the patient becomes dizzy or distressed."
                }
              ]
            },
            {
              "group_id": "stethoscope_group_10",
              "group_title": "9. Common findings and their clinical significance",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Finding",
                    "Possible significance"
                  ],
                  "rows": [
                    [
                      "Vesicular breath sounds",
                      "Normal breath sounds over most peripheral lung fields."
                    ],
                    [
                      "Wheeze",
                      "Often associated with narrowed airways, e.g. asthma."
                    ],
                    [
                      "Crackles",
                      "May occur in pulmonary oedema, pneumonia, or interstitial lung disease."
                    ],
                    [
                      "Reduced breath sounds",
                      "May occur with pleural effusion, pneumothorax, airway obstruction, or shallow breathing."
                    ],
                    [
                      "Bronchial breath sounds over peripheral lung fields",
                      "May indicate consolidation, depending on the clinical context."
                    ],
                    [
                      "Heart murmur",
                      "May reflect valvular disease, congenital heart disease, or a benign flow murmur."
                    ],
                    [
                      "Pericardial friction rub",
                      "May suggest pericardial inflammation."
                    ],
                    [
                      "Absent or very poor air entry in a severely breathless patient",
                      "A potentially urgent finding requiring immediate assessment."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Auscultatory findings must be interpreted alongside symptoms, vital signs, and the rest of the examination."
                }
              ]
            },
            {
              "group_id": "stethoscope_group_11",
              "group_title": "10. Contraindications and complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Contraindications: There are no absolute contraindications to routine external auscultation using a stethoscope."
                },
                {
                  "type": "paragraph",
                  "text": "Potential problems and precautions:"
                },
                {
                  "type": "paragraph",
                  "text": "Discomfort from a cold chestpiece."
                },
                {
                  "type": "paragraph",
                  "text": "Cross-infection if the equipment is not cleaned appropriately."
                },
                {
                  "type": "paragraph",
                  "text": "Ear discomfort from incorrectly fitted earpieces."
                },
                {
                  "type": "paragraph",
                  "text": "Misinterpretation due to poor technique or environmental noise."
                },
                {
                  "type": "paragraph",
                  "text": "Delay in urgent treatment if the examiner relies on auscultation alone despite clinical deterioration."
                }
              ]
            },
            {
              "group_id": "stethoscope_group_12",
              "group_title": "11. Pediatric and neonatal considerations",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Use a small chestpiece if it improves contact and access."
                },
                {
                  "type": "paragraph",
                  "text": "Warm the chestpiece before placing it on an infant."
                },
                {
                  "type": "paragraph",
                  "text": "Minimize crying and movement where possible; crying can alter heart rate and respiratory sounds."
                },
                {
                  "type": "paragraph",
                  "text": "Observe respiratory effort and colour before disturbing the infant."
                },
                {
                  "type": "paragraph",
                  "text": "Auscultate when the child is calm whenever feasible."
                },
                {
                  "type": "paragraph",
                  "text": "In neonates, interpret findings alongside gestational age, oxygen saturation, perfusion, and overall clinical status."
                },
                {
                  "type": "paragraph",
                  "text": "Do not assume that a normal-sounding chest excludes hypoxaemia or significant congenital heart disease."
                }
              ]
            },
            {
              "group_id": "stethoscope_group_13",
              "group_title": "12. Mnemonics and memory tips",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "For the four cardiac auscultation areas: “All Physicians Take Money.”",
                    "A — Aortic",
                    "P — Pulmonary",
                    "T — Tricuspid",
                    "M — Mitral"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Remember that the sequence describes the conventional listening areas, not the physical order of the valves in the heart."
                },
                {
                  "type": "paragraph",
                  "text": "For breath sounds, remember “W-C-R”:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "W — Wheeze",
                    "C — Crackles",
                    "R — Reduced breath sounds"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "This is a quick prompt for added or abnormal respiratory sounds, not a complete diagnostic checklist."
                }
              ]
            },
            {
              "group_id": "stethoscope_group_14",
              "group_title": "13. Common OSCE questions and model answers",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is the function of the diaphragm?"
                },
                {
                  "type": "paragraph",
                  "text": "It transmits sounds more effectively at relatively higher frequencies and is used for most routine cardiac and respiratory auscultation."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is the function of the bell?"
                },
                {
                  "type": "paragraph",
                  "text": "It is useful for low-frequency sounds when applied lightly, such as the murmur of mitral stenosis."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Why should the stethoscope be placed directly on the skin?"
                },
                {
                  "type": "paragraph",
                  "text": "Clothing can attenuate sounds and create friction artefacts, reducing the reliability of findings."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Why should the earpieces point forwards?"
                },
                {
                  "type": "paragraph",
                  "text": "This aligns them with the direction of the ear canals and improves fit and sound transmission."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. How do you prevent cross-infection?"
                },
                {
                  "type": "paragraph",
                  "text": "Perform hand hygiene and clean the chestpiece between patients according to infection-control guidance and manufacturer instructions."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Can a normal stethoscope examination rule out pneumonia or congenital heart disease?"
                },
                {
                  "type": "paragraph",
                  "text": "No. Auscultation has limitations. Further assessment and investigations may be required based on the clinical presentation."
                }
              ]
            },
            {
              "group_id": "stethoscope_group_15",
              "group_title": "14. Common mistakes that lose OSCE marks",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Failing to obtain consent or explain the procedure."
                },
                {
                  "type": "paragraph",
                  "text": "Listening through clothing."
                },
                {
                  "type": "paragraph",
                  "text": "Inserting the earpieces backwards."
                },
                {
                  "type": "paragraph",
                  "text": "Using the wrong side of the chestpiece."
                },
                {
                  "type": "paragraph",
                  "text": "Listening at only one site rather than following a systematic sequence."
                },
                {
                  "type": "paragraph",
                  "text": "Failing to compare the two sides during respiratory examination."
                },
                {
                  "type": "paragraph",
                  "text": "Forgetting to assess the patient's comfort and respiratory effort."
                },
                {
                  "type": "paragraph",
                  "text": "Making a definitive diagnosis from one auscultatory finding alone."
                },
                {
                  "type": "paragraph",
                  "text": "Failing to clean the chestpiece between patients."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}