      "section_id": "stethoscope_section_1",
      "section_title": "Stethoscope",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "stethoscope_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "stethoscope_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
