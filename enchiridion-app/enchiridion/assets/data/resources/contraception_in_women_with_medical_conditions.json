  "sections": [
    {
      "section_id": "contraception_in_women_with_medical_conditions_section_1",
      "section_title": "Contraception in women with medical conditions",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "contraception_in_women_with_medical_conditions_subsection_1",
          "subsection_title": "1. Common OSCE station scenarios",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "You may be asked to:",
                  "items": [
                    {
                      "text": "Counsel a woman with hypertension who wants contraception.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Choose contraception for a patient with migraine with aura.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Advise a woman with a history of deep-vein thrombosis (DVT) or pulmonary embolism (PE).",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Counsel a patient with diabetes mellitus.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Recommend contraception for a woman living with HIV or taking antiretroviral therapy.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Advise a woman with epilepsy who is taking anti-seizure medication.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Counsel a woman with breast cancer or significant liver disease.",
                      "level": 0,
                      "label": "7."
                    },
                    {
                      "text": "Select contraception for a woman with obesity, smoking history or multiple cardiovascular risk factors.",
                      "level": 0,
                      "label": "8."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Main OSCE objective: identify the medical condition, assess its severity and associated risks, apply medical eligibility criteria, and recommend a safe, effective method that respects the patient's preferences."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "contraception_in_women_with_medical_conditions_subsection_2",
          "subsection_title": "2. Introduction and consent",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“Hello, my name is Dr ____. I understand you would like advice about contraception, and that you have a medical condition that may affect which methods are suitable. I will ask a few questions about your health and medications, then explain the options, their benefits and risks. We can choose a method together. Is that okay?”",
                  "style": "quote"
                },
                {
                  "type": "paragraph",
                  "text": "Maintain a non-judgemental approach. Do not automatically deny contraception because a patient has a chronic illness."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "contraception_in_women_with_medical_conditions_subsection_3",
          "subsection_title": "3. Focused history",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_3",
              "group_title": "A. Reproductive history",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Ask about:",
                  "items": [
                    {
                      "text": "Last menstrual period and menstrual regularity.",
                      "level": 0
                    },
                    {
                      "text": "Possibility of current pregnancy.",
                      "level": 0
                    },
                    {
                      "text": "Previous pregnancies and complications.",
                      "level": 0
                    },
                    {
                      "text": "Current contraceptive method and reason for changing it.",
                      "level": 0
                    },
                    {
                      "text": "Future pregnancy plans and preferred duration of contraception.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_4",
              "group_title": "B. Medical history",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Clarify:",
                  "items": [
                    {
                      "text": "The specific diagnosis and its duration.",
                      "level": 0
                    },
                    {
                      "text": "Disease severity and whether it is controlled.",
                      "level": 0
                    },
                    {
                      "text": "Previous complications, hospitalisations or relevant surgery.",
                      "level": 0
                    },
                    {
                      "text": "Other cardiovascular or metabolic conditions.",
                      "level": 0
                    },
                    {
                      "text": "Current medications, including over-the-counter and herbal products.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_5",
              "group_title": "C. Contraceptive preferences",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Ask whether the patient prefers:",
                  "items": [
                    {
                      "text": "A long-acting reversible method.",
                      "level": 0
                    },
                    {
                      "text": "A daily pill.",
                      "level": 0
                    },
                    {
                      "text": "An injectable method.",
                      "level": 0
                    },
                    {
                      "text": "A hormone-free option.",
                      "level": 0
                    },
                    {
                      "text": "Condoms for STI protection.",
                      "level": 0
                    },
                    {
                      "text": "Permanent contraception, if appropriate and desired.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_6",
              "group_title": "D. Examination and investigations",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Perform examinations or request investigations when indicated by the history or proposed method."
                },
                {
                  "type": "list",
                  "title": "Examples include:",
                  "items": [
                    {
                      "text": "Blood pressure before prescribing combined hormonal contraception.",
                      "level": 0
                    },
                    {
                      "text": "Pregnancy testing when pregnancy cannot reasonably be excluded.",
                      "level": 0
                    },
                    {
                      "text": "Assessment of VTE risk where relevant.",
                      "level": 0
                    },
                    {
                      "text": "Review of glucose control and vascular complications in diabetes.",
                      "level": 0
                    },
                    {
                      "text": "Medication reconciliation for enzyme-inducing drug interactions.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "OSCE principle: do not order unnecessary investigations or delay a suitable contraceptive method when investigations are not required for safe initiation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "contraception_in_women_with_medical_conditions_subsection_4",
          "subsection_title": "4. The medical eligibility framework",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The WHO and other national guidelines use medical eligibility categories to guide contraceptive choice."
                },
                {
                  "type": "table",
                  "columns": [
                    "Category",
                    "Meaning"
                  ],
                  "rows": [
                    [
                      "1",
                      "No restriction on use"
                    ],
                    [
                      "2",
                      "Advantages generally outweigh theoretical or proven risks"
                    ],
                    [
                      "3",
                      "Risks generally outweigh advantages; use only when more appropriate methods are unavailable or unacceptable, with clinical judgement"
                    ],
                    [
                      "4",
                      "Unacceptable health risk; do not use"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The category applies to a specific contraceptive method in a specific medical condition. It is not a blanket category for all contraception."
                },
                {
                  "type": "paragraph",
                  "text": "For example, a woman with hypertension may be unsuitable for combined hormonal contraception but may still be eligible for a progestogen-only method or an intrauterine device."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "contraception_in_women_with_medical_conditions_subsection_5",
          "subsection_title": "5. Contraception in specific medical conditions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_8",
              "group_title": "A. Hypertension",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Oestrogen-containing contraception can increase cardiovascular risk, particularly in women with severe or uncontrolled hypertension."
                },
                {
                  "type": "table",
                  "columns": [
                    "Clinical situation",
                    "General approach"
                  ],
                  "rows": [
                    [
                      "Controlled hypertension",
                      "Usually avoid combined hormonal contraception where safer alternatives are suitable; assess eligibility carefully"
                    ],
                    [
                      "BP 140–159 systolic or 90–99 diastolic",
                      "Combined hormonal contraception is generally not recommended under commonly used medical eligibility criteria"
                    ],
                    [
                      "BP ≥160 systolic or ≥100 diastolic",
                      "Combined hormonal contraception is contraindicated under commonly used criteria"
                    ],
                    [
                      "Hypertension with vascular disease",
                      "Avoid combined hormonal contraception"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Preferred options to consider: copper IUD, levonorgestrel IUS, implant or progestogen-only pill, depending on individual eligibility."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE question: Why is combined hormonal contraception a concern in hypertension?"
                },
                {
                  "type": "paragraph",
                  "text": "Because oestrogen-containing methods can increase the risk of stroke, myocardial infarction and other cardiovascular complications in susceptible patients."
                },
                {
                  "type": "paragraph",
                  "text": "Clinical note: confirm properly measured blood pressure and apply the current local medical eligibility guidance. A single elevated reading alone does not establish chronic hypertension."
                }
              ]
            },
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_9",
              "group_title": "B. Migraine",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The key distinction is whether the patient experiences migraine with aura."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/contraception_in_women_with_medical_conditions_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Migraine without aura"
                },
                {
                  "type": "paragraph",
                  "text": "Combined hormonal contraception may be considered in selected patients after assessment of age, smoking, blood pressure and other stroke risks."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/contraception_in_women_with_medical_conditions_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Migraine with aura"
                },
                {
                  "type": "paragraph",
                  "text": "Combined hormonal contraception is contraindicated under commonly used eligibility criteria because of increased ischaemic stroke risk."
                },
                {
                  "type": "paragraph",
                  "text": "Preferred alternatives: progestogen-only pill, implant, copper IUD or LNG-IUS, subject to other medical factors."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE tip: ask about visual disturbances, flashing lights, zigzag lines, sensory symptoms or speech disturbance preceding the headache. Do not assume every severe headache is migraine with aura."
                }
              ]
            },
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_10",
              "group_title": "C. Previous DVT or pulmonary embolism",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Oestrogen increases the risk of venous thromboembolism."
                },
                {
                  "type": "list",
                  "title": "Ask about:",
                  "items": [
                    {
                      "text": "Previous DVT or PE.",
                      "level": 0
                    },
                    {
                      "text": "Whether the event was provoked or unprovoked.",
                      "level": 0
                    },
                    {
                      "text": "Recurrent thrombosis or known thrombophilia.",
                      "level": 0
                    },
                    {
                      "text": "Current anticoagulant treatment.",
                      "level": 0
                    },
                    {
                      "text": "Family history of early or recurrent thrombosis.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "table",
                  "columns": [
                    "Method",
                    "General consideration"
                  ],
                  "rows": [
                    [
                      "Copper IUD",
                      "Often suitable; no hormonal effect"
                    ],
                    [
                      "LNG-IUS",
                      "Often suitable; may reduce heavy menstrual bleeding"
                    ],
                    [
                      "Implant",
                      "Often suitable, depending on individual eligibility"
                    ],
                    [
                      "Progestogen-only pill",
                      "Often suitable"
                    ],
                    [
                      "Combined pill, patch or ring",
                      "Generally avoided in patients with significant VTE risk; may be contraindicated"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important: eligibility can differ according to whether the patient has active VTE, is receiving anticoagulation, has a history of thrombosis or has thrombophilia. Consult the relevant guideline rather than treating all cases identically."
                },
                {
                  "type": "paragraph",
                  "text": "Examiner question: What if the patient is taking anticoagulants and has heavy menstrual bleeding?"
                },
                {
                  "type": "paragraph",
                  "text": "The LNG-IUS may be a useful option because it can reduce menstrual blood loss, provided it is appropriate for the individual patient. Insertion planning should account for the anticoagulant and bleeding history."
                }
              ]
            },
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_11",
              "group_title": "D. Diabetes mellitus",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The main issue is whether the patient has uncomplicated diabetes or vascular complications."
                },
                {
                  "type": "paragraph",
                  "text": "Uncomplicated diabetes"
                },
                {
                  "type": "paragraph",
                  "text": "Many contraceptive methods are suitable. Choice depends on the patient's preferences and other risks."
                },
                {
                  "type": "paragraph",
                  "text": "Diabetes with vascular complications"
                },
                {
                  "type": "list",
                  "title": "Examples include:",
                  "items": [
                    {
                      "text": "Nephropathy.",
                      "level": 0
                    },
                    {
                      "text": "Retinopathy.",
                      "level": 0
                    },
                    {
                      "text": "Neuropathy.",
                      "level": 0
                    },
                    {
                      "text": "Other established vascular disease.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Combined hormonal contraception may be unsuitable, particularly with longstanding diabetes or multiple cardiovascular risk factors."
                },
                {
                  "type": "paragraph",
                  "text": "Options to consider: copper IUD, LNG-IUS, implant or progestogen-only pill, according to eligibility."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE tip: ask about disease duration, glucose control, kidney disease, eye complications, hypertension, smoking and cardiovascular history."
                }
              ]
            },
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_12",
              "group_title": "E. Epilepsy and anti-seizure medication",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The diagnosis of epilepsy alone does not automatically preclude contraception. The important issue is the medication."
                },
                {
                  "type": "list",
                  "title": "Some enzyme-inducing anti-seizure medicines can reduce the effectiveness of hormonal contraception, including:",
                  "items": [
                    {
                      "text": "Carbamazepine.",
                      "level": 0
                    },
                    {
                      "text": "Phenytoin.",
                      "level": 0
                    },
                    {
                      "text": "Phenobarbital.",
                      "level": 0
                    },
                    {
                      "text": "Primidone.",
                      "level": 0
                    },
                    {
                      "text": "Certain doses of topiramate.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Lamotrigine has a different interaction: combined hormonal contraception can lower lamotrigine concentrations, potentially affecting seizure control."
                },
                {
                  "type": "list",
                  "title": "Options to consider:",
                  "items": [
                    {
                      "text": "Copper IUD.",
                      "level": 0
                    },
                    {
                      "text": "LNG-IUS.",
                      "level": 0
                    },
                    {
                      "text": "Depot medroxyprogesterone acetate in suitable patients, because its effectiveness is generally not reduced by enzyme induction.",
                      "level": 0
                    },
                    {
                      "text": "Other methods after checking specific drug interactions and guidelines.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Examiner question: Why is the implant not always the best option in a patient taking carbamazepine?"
                },
                {
                  "type": "paragraph",
                  "text": "Carbamazepine can increase the metabolism of implant hormones, reducing contraceptive effectiveness. An intrauterine method may be more reliable."
                },
                {
                  "type": "paragraph",
                  "text": "Never advise a patient to stop anti-seizure medication without specialist input."
                }
              ]
            },
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_13",
              "group_title": "F. Breast cancer",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Current breast cancer is a major contraindication to hormonal contraception under commonly used eligibility criteria."
                },
                {
                  "type": "list",
                  "title": "Options to consider include:",
                  "items": [
                    {
                      "text": "Copper IUD, if appropriate.",
                      "level": 0
                    },
                    {
                      "text": "Condoms.",
                      "level": 0
                    },
                    {
                      "text": "Permanent contraception if desired.",
                      "level": 0
                    },
                    {
                      "text": "Other non-hormonal approaches where suitable.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "For a patient with a history of breast cancer, eligibility depends on the clinical circumstances and guideline. Involve the treating oncology team when necessary."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE tip: do not automatically recommend an implant, hormonal IUS or progestogen-only pill simply because it contains no oestrogen. These are still hormonal methods."
                }
              ]
            },
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_14",
              "group_title": "G. Obesity",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Obesity alone does not automatically exclude most contraceptive methods."
                },
                {
                  "type": "list",
                  "title": "However, assess additional risks:",
                  "items": [
                    {
                      "text": "Hypertension.",
                      "level": 0
                    },
                    {
                      "text": "Smoking.",
                      "level": 0
                    },
                    {
                      "text": "Migraine with aura.",
                      "level": 0
                    },
                    {
                      "text": "Diabetes and vascular disease.",
                      "level": 0
                    },
                    {
                      "text": "Previous VTE.",
                      "level": 0
                    },
                    {
                      "text": "Reduced mobility or recent surgery.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Combined hormonal contraception may be inappropriate when obesity is accompanied by significant additional cardiovascular or thrombotic risks."
                },
                {
                  "type": "paragraph",
                  "text": "The implant and intrauterine methods are highly effective options to discuss. Do not assume that a patient with obesity cannot use hormonal contraception."
                }
              ]
            },
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_15",
              "group_title": "H. Smoking",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Combined hormonal contraception becomes increasingly concerning with age and cardiovascular risk."
                },
                {
                  "type": "paragraph",
                  "text": "In commonly used eligibility criteria, women aged 35 years or older who smoke may face substantial restrictions on combined hormonal contraception, especially with heavier smoking."
                },
                {
                  "type": "list",
                  "title": "Assess:",
                  "items": [
                    {
                      "text": "Age.",
                      "level": 0
                    },
                    {
                      "text": "Cigarettes smoked per day.",
                      "level": 0
                    },
                    {
                      "text": "Blood pressure.",
                      "level": 0
                    },
                    {
                      "text": "Migraine history.",
                      "level": 0
                    },
                    {
                      "text": "Previous thrombosis.",
                      "level": 0
                    },
                    {
                      "text": "Other cardiovascular risks.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Preferred alternatives to consider: copper IUD, LNG-IUS, implant or progestogen-only pill."
                }
              ]
            },
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_16",
              "group_title": "I. HIV and antiretroviral treatment",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "HIV infection itself does not automatically prohibit hormonal contraception. However, certain antiretroviral medicines interact with contraceptive hormones."
                },
                {
                  "type": "list",
                  "title": "Ask about the specific regimen and assess:",
                  "items": [
                    {
                      "text": "Drug interactions.",
                      "level": 0
                    },
                    {
                      "text": "Other medical conditions.",
                      "level": 0
                    },
                    {
                      "text": "Pregnancy plans.",
                      "level": 0
                    },
                    {
                      "text": "STI prevention.",
                      "level": 0
                    },
                    {
                      "text": "Whether condoms are desired alongside a highly effective contraceptive method.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Condoms remain important for STI prevention and may provide additional protection against unintended pregnancy."
                },
                {
                  "type": "paragraph",
                  "text": "For a patient taking efavirenz or another interacting medicine, check current drug-interaction guidance before choosing an implant or oral hormonal method."
                }
              ]
            },
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_17",
              "group_title": "J. Liver disease",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The severity and type of liver disease matter."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Severe or decompensated liver disease: hormonal method eligibility may be restricted.",
                      "level": 0
                    },
                    {
                      "text": "Hepatocellular adenoma or certain liver tumours: hormonal contraception may be contraindicated or require specialist assessment.",
                      "level": 0
                    },
                    {
                      "text": "Stable, uncomplicated liver disease: some methods may remain suitable.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A copper IUD may be an option where hormonal methods are unsuitable."
                },
                {
                  "type": "paragraph",
                  "text": "Do not apply the same rule to all liver conditions; check the diagnosis and current medical eligibility criteria."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "contraception_in_women_with_medical_conditions_subsection_6",
          "subsection_title": "6. Quick method-selection table",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_18",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This table is a revision aid, not a substitute for formal eligibility criteria."
                },
                {
                  "type": "table",
                  "columns": [
                    "Medical condition",
                    "Methods to consider first",
                    "Key caution"
                  ],
                  "rows": [
                    [
                      "Hypertension",
                      "Copper IUD, LNG-IUS, implant, POP",
                      "Severe hypertension or vascular disease makes combined hormonal contraception unsuitable"
                    ],
                    [
                      "Migraine with aura",
                      "Copper IUD, LNG-IUS, implant, POP",
                      "Avoid combined hormonal contraception"
                    ],
                    [
                      "Previous VTE",
                      "Copper IUD, LNG-IUS, implant, POP",
                      "Assess thrombosis history and anticoagulation"
                    ],
                    [
                      "Diabetes with vascular complications",
                      "IUDs, implant or other eligible progestogen-only methods",
                      "Assess vascular disease and duration"
                    ],
                    [
                      "Epilepsy on enzyme-inducing medication",
                      "Copper IUD, LNG-IUS; consider DMPA",
                      "Check interactions with implant and pills"
                    ],
                    [
                      "Current breast cancer",
                      "Copper IUD and non-hormonal methods",
                      "Avoid hormonal contraception unless specialist guidance indicates otherwise"
                    ],
                    [
                      "Obesity",
                      "IUDs, implant and other eligible methods",
                      "Assess combined cardiovascular and VTE risks"
                    ],
                    [
                      "Smoking at age ≥35",
                      "IUDs, implant, POP",
                      "Combined hormonal contraception may be contraindicated"
                    ],
                    [
                      "HIV on interacting medication",
                      "IUDs or an eligible alternative",
                      "Check the exact antiretroviral regimen"
                    ],
                    [
                      "Significant liver disease",
                      "Often consider non-hormonal options",
                      "Eligibility depends on the specific diagnosis"
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "contraception_in_women_with_medical_conditions_subsection_7",
          "subsection_title": "7. How to present your recommendation in an OSCE",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_19",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Use this four-part structure:",
                  "items": [
                    {
                      "text": "Identify the risk: “Your history of migraine with aura means that oestrogen-containing contraception would increase your stroke risk.”",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Explain the restriction: “For that reason, I would not recommend the combined pill, patch or vaginal ring.”",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Offer alternatives: “We can consider an implant, a progestogen-only pill or an intrauterine device, depending on your preferences and medical history.”",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Make a shared decision: “Would you prefer a long-acting method or one you can stop yourself?”",
                      "level": 0,
                      "label": "4."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "This demonstrates clinical reasoning rather than simply memorising contraindications."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "contraception_in_women_with_medical_conditions_subsection_8",
          "subsection_title": "8. Common examiner questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_20",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What are the four medical eligibility categories?"
                },
                {
                  "type": "paragraph",
                  "text": "Category 1: no restriction; Category 2: benefits generally outweigh risks; Category 3: risks generally outweigh benefits; Category 4: unacceptable health risk."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Which contraceptive method is contraindicated in migraine with aura?"
                },
                {
                  "type": "paragraph",
                  "text": "Combined hormonal contraception, including the combined pill, patch and vaginal ring."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Why should enzyme-inducing medicines be considered before prescribing an implant?"
                },
                {
                  "type": "paragraph",
                  "text": "They may accelerate hormone metabolism and reduce contraceptive effectiveness."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Can a woman with hypertension use contraception?"
                },
                {
                  "type": "paragraph",
                  "text": "Yes. Many methods remain available. The method must be selected according to blood pressure, vascular risk and the relevant eligibility criteria."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. Can a woman with diabetes use an IUD?"
                },
                {
                  "type": "paragraph",
                  "text": "Yes, an IUD may be appropriate. Assess the type of diabetes, vascular complications, other medical conditions and individual eligibility."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Is obesity an absolute contraindication to hormonal contraception?"
                },
                {
                  "type": "paragraph",
                  "text": "No. Obesity alone does not automatically exclude most methods, although associated cardiovascular and thrombotic risks must be assessed."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What is the safest approach when a patient has several interacting medical conditions?"
                },
                {
                  "type": "paragraph",
                  "text": "Review all conditions and medicines, use current medical eligibility and drug-interaction guidance, and seek specialist advice when needed. Offer a suitable alternative rather than leaving the patient without contraception."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "contraception_in_women_with_medical_conditions_subsection_9",
          "subsection_title": "9. Common OSCE mistakes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_21",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Treating all hormonal contraception as equivalent.",
                      "level": 0
                    },
                    {
                      "text": "Confusing progestogen-only contraception with combined hormonal contraception.",
                      "level": 0
                    },
                    {
                      "text": "Failing to ask about migraine aura.",
                      "level": 0
                    },
                    {
                      "text": "Ignoring drug interactions in epilepsy or HIV.",
                      "level": 0
                    },
                    {
                      "text": "Recommending combined hormonal contraception without assessing blood pressure and VTE risk.",
                      "level": 0
                    },
                    {
                      "text": "Assuming obesity alone is a contraindication.",
                      "level": 0
                    },
                    {
                      "text": "Forgetting to ask about current breast cancer.",
                      "level": 0
                    },
                    {
                      "text": "Applying a blanket rule to every liver condition.",
                      "level": 0
                    },
                    {
                      "text": "Failing to respect patient preferences or explain alternatives.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "contraception_in_women_with_medical_conditions_subsection_10",
          "subsection_title": "10. Quick revision mnemonic: SAFE CHOICE",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "contraception_in_women_with_medical_conditions_group_22",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "S — Smoking status.",
                      "level": 0
                    },
                    {
                      "text": "A — Aura with migraine.",
                      "level": 0
                    },
                    {
                      "text": "F — Factor in previous thrombosis.",
                      "level": 0
                    },
                    {
                      "text": "E — Evaluate blood pressure.",
                      "level": 0
                    },
                    {
                      "text": "C — Check current medicines.",
                      "level": 0
                    },
                    {
                      "text": "H — Hormone-sensitive cancers.",
                      "level": 0
                    },
                    {
                      "text": "O — Obesity and other cardiovascular risks.",
                      "level": 0
                    },
                    {
                      "text": "I — Identify diabetes complications.",
                      "level": 0
                    },
                    {
                      "text": "C — Consider liver disease and other comorbidities.",
                      "level": 0
                    },
                    {
                      "text": "E — Explain suitable alternatives and agree on a method.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}