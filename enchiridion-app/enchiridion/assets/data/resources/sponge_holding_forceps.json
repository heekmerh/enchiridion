                    "Babcock forceps"
                  ],
                  "rows": [
                    [
                      "Primary function",
                      "Hold a swab or sponge",
                      "Hold and manipulate tissue"
                    ],
                    [
                      "Typical working end",
                      "Oval or loop-like jaws",
                      "Rounded, fenestrated jaws"
                    ],
                    [
                      "Common application",
                      "Swabbing and skin preparation",
                      "Tissue grasping during surgery"
                    ],
                    [
                      "Main safety concern",
                      "Swab slipping or being retained",
                      "Tissue crushing or tearing"
                    ],
                    [
