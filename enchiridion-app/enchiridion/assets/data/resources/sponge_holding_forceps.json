                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "sponge_holding_forceps_group_13",
              "group_title": "Sponge-holding forceps versus artery forceps",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Sponge-holding forceps",
                    "Artery forceps"
                  ],
                  "rows": [
                    [
                      "Main purpose",
                      "Hold swabs",
                      "Clamp vessels or tissue for haemostasis"
                    ],
                    [
                      "Jaw design",
                      "Commonly oval or loop-like",
                      "Usually narrow, serrated jaws"
                    ],
                    [
                      "Typical use",
                      "Swabbing and fluid absorption",
                      "Temporary vessel clamping"
                    ],
                    [
                      "Key distinction",
                      "Designed around holding a sponge",
                      "Designed around controlled clamping"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Viva trap: Do not identify every ring-handled, ratcheted instrument as artery forceps. The working end and intended function are essential to identification."
                }
              ]
            }
          ]
        },
