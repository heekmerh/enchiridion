                },
                {
                  "type": "paragraph",
                  "text": "Sponge-holding forceps"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Designed primarily to hold gauze or swabs.",
                      "level": 0
                    },
                    {
                      "text": "Often have elongated oval or ring-like jaws.",
                      "level": 0
                    },
                    {
                      "text": "Commonly used for skin preparation and swabbing.",
                      "level": 0
                    },
                    {
                      "text": "Can assist with selected gentle tissue handling.",
                      "level": 0
                    }
                  ]
                },
                {
