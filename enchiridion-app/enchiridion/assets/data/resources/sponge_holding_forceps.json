        {
          "subsection_id": "sponge_holding_forceps_subsection_13",
          "subsection_title": "12. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sponge_holding_forceps_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a sponge-holding forceps, commonly called a Foerster sponge forceps. It is a grasping and holding instrument with ring handles, a ratchet-locking mechanism, a box joint and long shafts terminating in oval or rounded jaws. It is primarily used to hold gauze swabs for skin preparation, swabbing and absorption of blood or other fluids during surgical procedures. Complications of improper use include tissue trauma, contamination and swab retention. Before use, I would check its integrity, jaw alignment, locking mechanism, cleanliness and sterility.”",
                  "style": "quote"
                }
              ]
            },
