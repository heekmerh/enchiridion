                  "assetPath": "assets/resources/content/surgical/sponge_holding_forceps_10.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Babcock forceps"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Designed primarily to grasp tissue.",
                      "level": 0
                    },
                    {
                      "text": "Have rounded, fenestrated tissue-grasping jaws.",
                      "level": 0
                    },
                    {
                      "text": "Commonly used for the appendix and suitable bowel or tubular tissues.",
                      "level": 0
                    },
                    {
                      "text": "Selected for relatively atraumatic tissue manipulation.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "table",
                  "columns": [
                    "Feature",
