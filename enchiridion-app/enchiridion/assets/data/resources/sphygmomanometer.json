  "sections": [
    {
      "section_id": "sphygmomanometer_section_1",
      "section_title": "Sphygmomanometer",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "sphygmomanometer_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sphygmomanometer_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A sphygmomanometer is an instrument used to measure arterial blood pressure (BP). It is one of the most frequently encountered instruments in clinical examinations because blood pressure measurement is a fundamental skill in general medicine, emergency medicine, pediatrics, and cardiovascular assessment."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/sphygmomanometer_01.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/sphygmomanometer_02.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/sphygmomanometer_03.webp",
                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sphygmomanometer_subsection_2",
          "subsection_title": "Identification and classification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sphygmomanometer_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "OSCE definition: A sphygmomanometer is a device used to measure systolic and diastolic arterial blood pressure, usually expressed in millimetres of mercury (mmHg)."
                },
                {
                  "type": "paragraph",
                  "text": "There are three major types."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/sphygmomanometer_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "A. Aneroid sphygmomanometer"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Uses a mechanical pressure gauge, an inflatable cuff, tubing, and an inflation bulb."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE point: Requires periodic calibration and is commonly used with a stethoscope."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/sphygmomanometer_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Digital or automated sphygmomanometer"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Uses electronic sensors and typically an oscillometric method to estimate systolic and diastolic pressure."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE point: Convenient and requires less operator skill, but device validation and correct cuff sizing remain essential."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/sphygmomanometer_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "C. Mercury sphygmomanometer"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Measures pressure using the height of a mercury column."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE point: Historically an important reference method, but mercury's toxicity has led to restrictions or phase-outs in many settings."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sphygmomanometer_subsection_3",
          "subsection_title": "Parts and their functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sphygmomanometer_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Component",
                    "Function"
                  ],
                  "rows": [
                    [
                      "Inflatable cuff",
                      "Compresses the artery when inflated."
                    ],
                    [
                      "Inflatable bladder",
                      "Applies pressure to the arm or limb."
                    ],
                    [
                      "Inflation bulb",
                      "Pumps air into the cuff."
                    ],
                    [
                      "Air-release valve",
                      "Allows controlled deflation."
                    ],
                    [
                      "Pressure gauge or display",
                      "Indicates measured or estimated pressure."
                    ],
                    [
                      "Connecting tubing",
                      "Transfers air between the bulb, cuff and gauge."
                    ],
                    [
                      "Stethoscope",
                      "Used with the manual method to hear Korotkoff sounds."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important distinction: The cuff is not the same as the bladder inside it. The cuff holds the bladder in position, while the bladder applies pressure."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sphygmomanometer_subsection_4",
          "subsection_title": "Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sphygmomanometer_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Routine blood pressure assessment during outpatient and inpatient care."
                },
                {
                  "type": "paragraph",
                  "text": "Screening for hypertension."
                },
                {
                  "type": "paragraph",
                  "text": "Assessment of hypotension, including possible shock."
                },
                {
                  "type": "paragraph",
                  "text": "Monitoring patients receiving antihypertensive medication."
                },
                {
                  "type": "paragraph",
                  "text": "Antenatal assessment for hypertension and pre-eclampsia."
                },
                {
                  "type": "paragraph",
                  "text": "Assessment of critically ill patients, alongside other observations."
                },
                {
                  "type": "paragraph",
                  "text": "Pediatric blood pressure measurement when the correct cuff and appropriate technique are used."
                },
                {
                  "type": "paragraph",
                  "text": "Assessment of postural blood pressure changes when orthostatic hypotension is suspected."
                },
                {
                  "type": "paragraph",
                  "text": "Blood pressure should be interpreted alongside the patient's symptoms, clinical condition, and other vital signs. A single reading does not always establish a diagnosis of hypertension."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sphygmomanometer_subsection_5",
          "subsection_title": "Advantages and disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sphygmomanometer_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Type",
                    "Advantages",
                    "Disadvantages"
                  ],
                  "rows": [
                    [
                      "Aneroid",
                      "Portable, reusable, no electricity needed",
                      "Requires calibration; readings depend on technique and hearing"
                    ],
                    [
                      "Automated digital",
                      "Convenient, often reduces observer bias, useful for repeated readings",
                      "May be inaccurate with movement, some arrhythmias, or an unsuitable cuff"
                    ],
                    [
                      "Mercury",
                      "Historically reliable when correctly used",
                      "Mercury toxicity, breakage risk, and regulatory restrictions"
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "sphygmomanometer_group_6",
              "group_title": "General limitations",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Incorrect cuff size can produce misleading readings."
                },
                {
                  "type": "paragraph",
                  "text": "Talking, movement, anxiety, and recent exercise may affect the result."
                },
                {
                  "type": "paragraph",
                  "text": "Arrhythmias can make readings more difficult to obtain accurately."
                },
                {
                  "type": "paragraph",
                  "text": "A poorly maintained device can give incorrect readings."
                },
                {
                  "type": "paragraph",
                  "text": "Blood pressure varies naturally with time, posture, medication, and physiological state."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sphygmomanometer_subsection_6",
          "subsection_title": "Cuff selection — a high-yield OSCE topic",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sphygmomanometer_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Choosing the correct cuff size is essential for accurate measurement, especially in children."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/sphygmomanometer_07.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/sphygmomanometer_08.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/sphygmomanometer_09.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "The inflatable bladder should generally have a width of approximately 40% of the arm circumference and a length that encircles approximately 75–100% of the arm circumference."
                },
                {
                  "type": "table",
                  "columns": [
                    "Cuff problem",
                    "Likely effect on reading"
                  ],
                  "rows": [
                    [
                      "Cuff too small or narrow",
                      "Falsely high BP"
                    ],
                    [
                      "Cuff too large",
                      "May produce a falsely low reading"
                    ],
                    [
                      "Cuff too loose or incorrectly positioned",
                      "Unreliable reading"
                    ],
                    [
                      "Cuff placed over clothing",
                      "Potentially inaccurate reading"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Memory tip: Small cuff, high reading."
                },
                {
                  "type": "paragraph",
                  "text": "For children, select the cuff according to measured arm circumference rather than simply choosing one based on age."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sphygmomanometer_subsection_7",
          "subsection_title": "How to measure blood pressure manually",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sphygmomanometer_group_8",
              "group_title": "Step-by-step OSCE checklist",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "0 of 13 steps"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "1. Perform hand hygiene, introduce yourself, confirm identity, explain the procedure and obtain consent."
                },
                {
                  "type": "paragraph",
                  "text": "2. Ensure the patient has rested quietly for about 5 minutes where circumstances permit."
                },
                {
                  "type": "paragraph",
                  "text": "3. Position the patient seated, with back supported, feet flat on the floor and legs uncrossed."
                },
                {
                  "type": "paragraph",
                  "text": "4. Expose the upper arm and support it at heart level."
                },
                {
                  "type": "paragraph",
                  "text": "5. Choose the correct cuff size and apply it snugly to the bare arm, with the artery marker positioned appropriately."
                },
                {
                  "type": "paragraph",
                  "text": "6. Palpate the brachial artery and estimate systolic pressure by inflating until the radial pulse disappears, then deflating."
                },
                {
                  "type": "paragraph",
                  "text": "7. Deflate fully and wait briefly before proceeding with auscultation."
                },
                {
                  "type": "paragraph",
                  "text": "8. Place the stethoscope over the brachial artery, avoiding placement beneath the cuff."
                },
                {
                  "type": "paragraph",
                  "text": "9. Inflate to approximately 20–30 mmHg above the estimated systolic pressure."
                },
                {
                  "type": "paragraph",
                  "text": "10. Deflate slowly at approximately 2–3 mmHg per second while listening."
                },
                {
                  "type": "paragraph",
                  "text": "11. Record the first clear Korotkoff sound as systolic pressure."
                },
                {
                  "type": "paragraph",
                  "text": "12. Record the disappearance of Korotkoff sounds as diastolic pressure in most adults."
                },
                {
                  "type": "paragraph",
                  "text": "13. Deflate completely, remove the cuff, ensure patient comfort and document the reading, arm, position and relevant observations."
                }
              ]
            },
            {
              "group_id": "sphygmomanometer_group_9",
              "group_title": "Understanding Korotkoff sounds",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Korotkoff sounds are sounds heard over an artery during gradual cuff deflation."
                }
              ]
            },
            {
              "group_id": "sphygmomanometer_group_10",
              "group_title": "I",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Phase I — first clear tapping sound"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Indicates systolic blood pressure."
                }
              ]
            },
            {
              "group_id": "sphygmomanometer_group_11",
              "group_title": "II",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Phase II — swishing or murmuring"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Sounds become softer or acquire a whooshing quality."
                }
              ]
            },
            {
              "group_id": "sphygmomanometer_group_12",
              "group_title": "III",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Phase III — louder, crisper sounds"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The sounds become more distinct."
                }
              ]
            },
            {
              "group_id": "sphygmomanometer_group_13",
              "group_title": "IV",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Phase IV — muffling"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Sounds become muffled before disappearing in some patients."
                }
              ]
            },
            {
              "group_id": "sphygmomanometer_group_14",
              "group_title": "V",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Phase V — disappearance of sounds"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Usually indicates diastolic pressure in adults."
                },
                {
                  "type": "paragraph",
                  "text": "Exam exception: In some children, pregnancy, or high-flow states, Korotkoff sounds may persist close to zero. If phase V cannot be identified reliably, phase IV may be used for diastolic pressure according to the applicable clinical guideline, and the finding should be documented."
                }
              ]
            },
            {
              "group_id": "sphygmomanometer_group_15",
              "group_title": "Example of a BP reading",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Suppose the first Korotkoff sound occurs at 120 mmHg and the sounds disappear at 80 mmHg."
                },
                {
                  "type": "paragraph",
                  "text": "The reading is:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "BP = 120/80 mmHg"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "120 mmHg = systolic pressure."
                },
                {
                  "type": "paragraph",
                  "text": "80 mmHg = diastolic pressure."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sphygmomanometer_subsection_8",
          "subsection_title": "Automated blood pressure measurement",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sphygmomanometer_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Select a validated upper-arm monitor when possible."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure the patient is rested, seated and appropriately positioned."
                },
                {
                  "type": "paragraph",
                  "text": "Apply the correct cuff to the bare arm."
                },
                {
                  "type": "paragraph",
                  "text": "Support the arm at heart level."
                },
                {
                  "type": "paragraph",
                  "text": "Ask the patient not to talk or move during measurement."
                },
                {
                  "type": "paragraph",
                  "text": "Start the measurement and allow the device to complete its cycle."
                },
                {
                  "type": "paragraph",
                  "text": "Repeat readings according to the relevant protocol; for routine assessment, two readings about one minute apart are commonly recommended."
                },
                {
                  "type": "paragraph",
                  "text": "Record the readings and investigate unexpected values or device error messages."
                },
                {
                  "type": "paragraph",
                  "text": "If a reading is inconsistent with the clinical picture, repeat the measurement and consider manual confirmation or another validated method."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sphygmomanometer_subsection_9",
          "subsection_title": "Precautions and contraindications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sphygmomanometer_group_17",
              "group_title": "Precautions",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Avoid measurement immediately after exercise, smoking or caffeine intake when assessing routine resting BP; ideally allow at least 30 minutes after these exposures."
                },
                {
                  "type": "paragraph",
                  "text": "Use a cuff of the correct size."
                },
                {
                  "type": "paragraph",
                  "text": "Do not measure over clothing."
                },
                {
                  "type": "paragraph",
                  "text": "Minimize talking and movement."
                },
                {
                  "type": "paragraph",
                  "text": "Use a suitable device for patients with arrhythmias or other conditions that interfere with oscillometric measurement."
                },
                {
                  "type": "paragraph",
                  "text": "Follow local guidance on which arm to use after surgery, vascular procedures or in the presence of vascular access."
                }
              ]
            },
            {
              "group_id": "sphygmomanometer_group_18",
              "group_title": "When should you avoid a particular arm?",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Avoid routine cuff placement on an arm with a relevant contraindication or where the treating team has advised against it, such as:"
                },
                {
                  "type": "paragraph",
                  "text": "An arm with an arteriovenous fistula or graft used for haemodialysis."
                },
                {
                  "type": "paragraph",
                  "text": "An arm with significant injury, burns or wounds where cuff inflation could cause harm."
                },
                {
                  "type": "paragraph",
                  "text": "An arm with an intravenous line or vascular device when cuff inflation may compromise the device or treatment."
                },
                {
                  "type": "paragraph",
                  "text": "An arm with specific postoperative or vascular restrictions."
                },
                {
                  "type": "paragraph",
                  "text": "A history of mastectomy or axillary lymph node surgery requires individualized assessment and adherence to local guidance; it should not automatically be treated as an absolute lifelong contraindication to measuring BP on that side."
                }
              ]
            },
            {
              "group_id": "sphygmomanometer_group_19",
              "group_title": "Complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Serious complications are uncommon. Possible problems include:"
                },
                {
                  "type": "paragraph",
                  "text": "Temporary discomfort or pain."
                },
                {
                  "type": "paragraph",
                  "text": "Bruising or petechiae with repeated or excessive inflation."
                },
                {
                  "type": "paragraph",
                  "text": "Aggravation of pain in an injured limb."
                },
                {
                  "type": "paragraph",
                  "text": "Interference with vascular access or an infusion if the cuff is used inappropriately."
                },
                {
                  "type": "paragraph",
                  "text": "Misdiagnosis or inappropriate treatment due to inaccurate measurements."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sphygmomanometer_subsection_10",
          "subsection_title": "Pediatric blood pressure measurement",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sphygmomanometer_group_20",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Pediatric BP is particularly important in Medicine and Pediatrics OSCEs."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/sphygmomanometer_10.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/sphygmomanometer_11.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Key points:"
                },
                {
                  "type": "paragraph",
                  "text": "Use an appropriately sized pediatric cuff."
                },
                {
                  "type": "paragraph",
                  "text": "Measure arm circumference where needed."
                },
                {
                  "type": "paragraph",
                  "text": "Keep the child calm and correctly positioned."
                },
                {
                  "type": "paragraph",
                  "text": "Use age-appropriate reference standards to interpret results."
                },
                {
                  "type": "paragraph",
                  "text": "Repeat an unexpectedly high reading and confirm it using the recommended technique."
                },
                {
                  "type": "paragraph",
                  "text": "Do not apply adult hypertension thresholds indiscriminately to children."
                },
                {
                  "type": "paragraph",
                  "text": "In children younger than 13 years, commonly used pediatric guidelines interpret BP using age-, sex- and height-related percentiles. For adolescents, some guidelines transition to fixed thresholds. Always use the applicable guideline and clinical context."
                },
                {
                  "type": "paragraph",
                  "text": "In neonates and very small infants, specialized cuffs and neonatal reference ranges may be needed."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sphygmomanometer_subsection_11",
          "subsection_title": "Important clinical interpretation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sphygmomanometer_group_21",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Finding",
                    "Clinical consideration"
                  ],
                  "rows": [
                    [
                      "Persistently elevated BP",
                      "Consider hypertension, measurement error, pain, anxiety and other causes"
                    ],
                    [
                      "Low BP with altered consciousness or poor perfusion",
                      "Possible shock or circulatory compromise; urgent assessment is required"
                    ],
                    [
                      "Difference between arms",
                      "May reflect measurement variation or vascular pathology; confirm and investigate if persistent or clinically significant"
                    ],
                    [
                      "Postural BP fall",
                      "May suggest orthostatic hypotension in the appropriate context"
                    ],
                    [
                      "Normal BP despite concerning symptoms",
                      "Does not exclude serious illness, especially early shock or other acute disease"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "In suspected shock, do not wait for hypotension before acting. Tachycardia, altered mental status, prolonged capillary refill and poor peripheral perfusion can be important early findings, particularly in children."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sphygmomanometer_subsection_12",
          "subsection_title": "Mnemonics and memory tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sphygmomanometer_group_22",
              "group_title": "For accurate BP measurement: REST",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "R — Rest before measurement."
                },
                {
                  "type": "paragraph",
                  "text": "E — Ensure correct cuff size."
                },
                {
                  "type": "paragraph",
                  "text": "S — Support the arm at heart level."
                },
                {
                  "type": "paragraph",
                  "text": "T — Take the reading without talking or movement."
                }
              ]
            },
            {
              "group_id": "sphygmomanometer_group_23",
              "group_title": "For manual measurement: First sound = systolic; disappearance = diastolic",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This is one of the most important facts to remember for a practical OSCE."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sphygmomanometer_subsection_13",
          "subsection_title": "Common OSCE questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sphygmomanometer_group_24",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is a sphygmomanometer used for?"
                },
                {
                  "type": "paragraph",
                  "text": "It measures arterial blood pressure, usually expressed in mmHg."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What are Korotkoff sounds?"
                },
                {
                  "type": "paragraph",
                  "text": "They are sounds heard over an artery during cuff deflation in manual BP measurement, caused by blood flow through the partially compressed artery."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What is the most common cuff-size error?"
                },
                {
                  "type": "paragraph",
                  "text": "Using a cuff that is too small, which can falsely elevate the reading."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Why is the arm positioned at heart level?"
                },
                {
                  "type": "paragraph",
                  "text": "To minimize hydrostatic effects that can distort the measured pressure."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What is the auscultatory gap?"
                },
                {
                  "type": "paragraph",
                  "text": "A temporary disappearance of Korotkoff sounds during cuff deflation. If missed, it can lead to underestimation of systolic pressure or overestimation of diastolic pressure. Estimating systolic pressure by palpation first helps reduce this error."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What is the difference between systolic and diastolic pressure?"
                },
                {
                  "type": "paragraph",
                  "text": "Systolic pressure is the arterial pressure during ventricular contraction; diastolic pressure is the arterial pressure during ventricular relaxation."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. Why might an automated monitor give an unreliable reading?"
                },
                {
                  "type": "paragraph",
                  "text": "Movement, an incorrect cuff size, some arrhythmias, poor peripheral perfusion, or use of an unsuitable or unvalidated device may affect accuracy."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sphygmomanometer_subsection_14",
          "subsection_title": "Common mistakes that lose OSCE marks",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sphygmomanometer_group_25",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Selecting the wrong cuff size."
                },
                {
                  "type": "paragraph",
                  "text": "Failing to allow adequate rest before routine BP measurement."
                },
                {
                  "type": "paragraph",
                  "text": "Measuring over clothing."
                },
                {
                  "type": "paragraph",
                  "text": "Allowing the arm to hang unsupported."
                },
                {
                  "type": "paragraph",
                  "text": "Placing the stethoscope beneath the cuff."
                },
                {
                  "type": "paragraph",
                  "text": "Deflating too quickly."
                },
                {
                  "type": "paragraph",
                  "text": "Failing to estimate systolic pressure by palpation when performing the full manual technique."
                },
                {
                  "type": "paragraph",
                  "text": "Recording a reading without documenting units."
                },
                {
                  "type": "paragraph",
                  "text": "Diagnosing hypertension from one isolated reading without appropriate confirmation."
                },
                {
                  "type": "paragraph",
                  "text": "Using adult reference thresholds for a child."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}