  "sections": [
    {
      "section_id": "ecg_electrodes_section_1",
      "section_title": "ECG electrodes",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "ecg_electrodes_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ecg_electrodes_group_1",
              "group_title": "ECG Electrodes and Lead Placement",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/ecg_electrodes_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "ECG electrodes are conductive sensors placed on the patient's skin to detect the electrical potentials generated by the heart. They connect to an ECG machine through lead wires and allow the machine to record the heart's electrical activity from different directions."
                },
                {
                  "type": "paragraph",
                  "text": "This is a high-yield OSCE topic because examiners may ask you to identify electrodes, state their functions, recall colour codes, demonstrate the 12-lead ECG setup, and identify errors that can produce misleading tracings."
                },
                {
                  "type": "paragraph",
                  "text": "Key distinction: An electrode is the physical sensor attached to the skin. An ECG lead is an electrical view of the heart generated from the signals recorded by the electrodes."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ecg_electrodes_subsection_2",
          "subsection_title": "1. Types of ECG electrodes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ecg_electrodes_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/ecg_electrodes_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A. Disposable adhesive electrodes"
                },
                {
                  "type": "paragraph",
                  "text": "Commonly used for standard ECG recordings. They stick to the skin and often contain conductive gel to improve electrical contact."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/ecg_electrodes_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "B. Limb clip electrodes"
                },
                {
                  "type": "paragraph",
                  "text": "Clips or attaches to the limbs for ECG recording, depending on the system. They are commonly encountered in clinical ECG equipment and teaching demonstrations."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/ecg_electrodes_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "C. Reusable chest electrodes"
                },
                {
                  "type": "paragraph",
                  "text": "Suction-cup electrodes may be used for precordial recordings. They require appropriate cleaning and maintenance between patients."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ecg_electrodes_subsection_3",
          "subsection_title": "2. Number of electrodes and leads",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ecg_electrodes_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "A standard 12-lead ECG uses 10 physical electrodes:",
                  "items": [
                    {
                      "text": "Four limb electrodes: RA, LA, RL, LL.",
                      "level": 0
                    },
                    {
                      "text": "Six chest electrodes: V1, V2, V3, V4, V5, V6.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "list",
                  "title": "These produce 12 leads:",
                  "items": [
                    {
                      "text": "Six limb leads: I, II, III, aVR, aVL, aVF.",
                      "level": 0
                    },
                    {
                      "text": "Six chest leads: V1–V6.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Remember: 10 electrodes, 12 leads."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ecg_electrodes_subsection_4",
          "subsection_title": "3. ECG electrode colour codes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ecg_electrodes_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Colour codes can vary between systems and standards. The two common conventions you should recognise are:"
                }
              ]
            },
            {
              "group_id": "ecg_electrodes_group_5",
              "group_title": "A. IEC convention",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Commonly encountered in many countries, including systems using European/International colour coding."
                },
                {
                  "type": "table",
                  "columns": [
                    "Electrode",
                    "Colour"
                  ],
                  "rows": [
                    [
                      "RA — right arm",
                      "Red"
                    ],
                    [
                      "LA — left arm",
                      "Yellow"
                    ],
                    [
                      "RL — right leg",
                      "Black"
                    ],
                    [
                      "LL — left leg",
                      "Green"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Memory aid: Red, Yellow, Black, Green — go around the limbs in the IEC pattern."
                }
              ]
            },
            {
              "group_id": "ecg_electrodes_group_6",
              "group_title": "B. AHA convention",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The American Heart Association convention uses a different colour scheme."
                },
                {
                  "type": "table",
                  "columns": [
                    "Electrode",
                    "Colour"
                  ],
                  "rows": [
                    [
                      "RA — right arm",
                      "White"
                    ],
                    [
                      "LA — left arm",
                      "Black"
                    ],
                    [
                      "RL — right leg",
                      "Green"
                    ],
                    [
                      "LL — left leg",
                      "Red"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "OSCE safety tip: Never rely on colour alone. Read the labels on the ECG cables and follow the manufacturer's markings."
                },
                {
                  "type": "paragraph",
                  "text": "Chest electrodes V1–V6 are identified primarily by their labels and anatomical positions; do not assume their wire colours are universal."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ecg_electrodes_subsection_5",
          "subsection_title": "4. Limb electrode placement",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ecg_electrodes_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/ecg_electrodes_05.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Label",
                    "Anatomical position"
                  ],
                  "rows": [
                    [
                      "RA",
                      "Right arm or appropriate equivalent limb position"
                    ],
                    [
                      "LA",
                      "Left arm or appropriate equivalent limb position"
                    ],
                    [
                      "RL",
                      "Right leg; reference/ground electrode"
                    ],
                    [
                      "LL",
                      "Left leg"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Electrodes are commonly placed on the distal limbs. If movement, tremor, injury, or another clinical factor requires placement on the torso, use an appropriate modified configuration and document it where necessary."
                },
                {
                  "type": "paragraph",
                  "text": "Important: Moving limb electrodes onto the torso changes the electrical axes and can alter the ECG. A modified placement should not be assumed equivalent to a standard diagnostic 12-lead recording."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ecg_electrodes_subsection_6",
          "subsection_title": "5. Chest electrode placement: V1–V6",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ecg_electrodes_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/ecg_electrodes_06.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/ecg_electrodes_07.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Lead",
                    "Correct position"
                  ],
                  "rows": [
                    [
                      "V1",
                      "Fourth intercostal space, right sternal border"
                    ],
                    [
                      "V2",
                      "Fourth intercostal space, left sternal border"
                    ],
                    [
                      "V3",
                      "Midway between V2 and V4"
                    ],
                    [
                      "V4",
                      "Fifth intercostal space, left midclavicular line"
                    ],
                    [
                      "V5",
                      "Left anterior axillary line, level with V4"
                    ],
                    [
                      "V6",
                      "Left midaxillary line, level with V4 and V5"
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "ecg_electrodes_group_9",
              "group_title": "Landmarking sequence",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Locate the sternal angle.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Identify the second rib and second intercostal space.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Count down to the fourth intercostal space for V1 and V2.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Locate the fifth intercostal space and left midclavicular line for V4.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Place V3 midway between V2 and V4.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Place V5 and V6 horizontally level with V4.",
                      "level": 0,
                      "label": "6."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Common error: Placing V1 and V2 too high can produce abnormal-looking waveforms and misleading diagnostic patterns."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ecg_electrodes_subsection_7",
          "subsection_title": "6. How to apply electrodes correctly",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ecg_electrodes_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Explain the procedure, obtain consent, and ensure privacy.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Clean and dry the skin.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Remove excessive hair if necessary for good contact.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Attach the electrodes firmly at the correct locations.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Connect the labelled cables to their corresponding electrodes.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Check the machine for loose connections or artefact.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Ask the patient to relax, remain still, and avoid talking during recording.",
                      "level": 0,
                      "label": "7."
                    },
                    {
                      "text": "Confirm that the tracing is interpretable before completing the procedure.",
                      "level": 0,
                      "label": "8."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Do not place electrodes over clothing, and avoid placing them directly over thick dressings or areas that prevent adequate skin contact."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ecg_electrodes_subsection_8",
          "subsection_title": "7. Errors caused by incorrect electrode placement",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ecg_electrodes_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Error",
                    "Possible consequence"
                  ],
                  "rows": [
                    [
                      "V1 or V2 placed too high",
                      "Misleading R-wave progression or repolarisation changes"
                    ],
                    [
                      "V4–V6 placed at different vertical levels",
                      "Altered chest-lead patterns"
                    ],
                    [
                      "RA and LA cables reversed",
                      "Changes in lead I and limb-lead patterns"
                    ],
                    [
                      "Limb electrodes moved to non-standard positions",
                      "Changes in the electrical axis and waveform morphology"
                    ],
                    [
                      "Loose or dry electrodes",
                      "Artefact or poor-quality recording"
                    ],
                    [
                      "Incorrect cable connection",
                      "Misleading tracing or lead-off warnings"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "If the ECG is unexpected, check the patient first, then review electrode placement and connections. Repeat the recording when appropriate, but do not delay emergency care when serious pathology is suspected."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ecg_electrodes_subsection_9",
          "subsection_title": "8. Precautions and infection prevention",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ecg_electrodes_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Perform hand hygiene before and after the procedure.",
                      "level": 0
                    },
                    {
                      "text": "Use disposable electrodes according to the manufacturer's instructions.",
                      "level": 0
                    },
                    {
                      "text": "Clean reusable electrodes and cables between patients.",
                      "level": 0
                    },
                    {
                      "text": "Avoid damaging fragile skin when removing adhesive electrodes.",
                      "level": 0
                    },
                    {
                      "text": "Maintain privacy and dignity during chest electrode placement.",
                      "level": 0
                    },
                    {
                      "text": "Do not allow cable tension to pull electrodes off the skin.",
                      "level": 0
                    },
                    {
                      "text": "Record any non-standard electrode positions that could affect interpretation.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ecg_electrodes_subsection_10",
          "subsection_title": "9. Pediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ecg_electrodes_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Use appropriately sized electrodes for infants and children.",
                      "level": 0
                    },
                    {
                      "text": "Keep the child warm and minimise movement.",
                      "level": 0
                    },
                    {
                      "text": "Ensure accurate chest-lead placement; do not estimate locations solely by age.",
                      "level": 0
                    },
                    {
                      "text": "Interpret pediatric ECGs using age-appropriate standards.",
                      "level": 0
                    },
                    {
                      "text": "In neonates and infants, follow local protocols for lead placement and monitoring.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ecg_electrodes_subsection_11",
          "subsection_title": "10. Mnemonic: “4–4–Between–5–Axillary”",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ecg_electrodes_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "V1: Fourth intercostal space, right sternal border.",
                      "level": 0
                    },
                    {
                      "text": "V2: Fourth intercostal space, left sternal border.",
                      "level": 0
                    },
                    {
                      "text": "V3: Between V2 and V4.",
                      "level": 0
                    },
                    {
                      "text": "V4: Fifth intercostal space, midclavicular line.",
                      "level": 0
                    },
                    {
                      "text": "V5: Anterior axillary line, level with V4.",
                      "level": 0
                    },
                    {
                      "text": "V6: Midaxillary line, level with V4.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ecg_electrodes_subsection_12",
          "subsection_title": "11. Common OSCE examiner questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ecg_electrodes_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is the difference between an electrode and a lead?"
                },
                {
                  "type": "paragraph",
                  "text": "An electrode is the physical sensor attached to the skin; a lead is an electrical view of the heart derived from electrode signals."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. How many electrodes are used for a standard 12-lead ECG?"
                },
                {
                  "type": "paragraph",
                  "text": "Ten: four limb electrodes and six chest electrodes."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Where is V1 placed?"
                },
                {
                  "type": "paragraph",
                  "text": "The fourth intercostal space at the right sternal border."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Where is V4 placed?"
                },
                {
                  "type": "paragraph",
                  "text": "The fifth intercostal space at the left midclavicular line."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What is the IEC colour for the right arm electrode?"
                },
                {
                  "type": "paragraph",
                  "text": "Red. However, always check the cable label because colour conventions vary."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What may happen if RA and LA are reversed?"
                },
                {
                  "type": "paragraph",
                  "text": "The limb-lead pattern may be altered, potentially mimicking or obscuring abnormalities."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. Why must V4, V5, and V6 be on the same horizontal level?"
                },
                {
                  "type": "paragraph",
                  "text": "To maintain standard anatomical placement and avoid misleading differences in the chest-lead waveforms."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ecg_electrodes_subsection_13",
          "subsection_title": "12. Mini OSCE station",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ecg_electrodes_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Scenario: You are shown a set of ECG electrodes and cables. Demonstrate how you would prepare the patient and place the electrodes for a standard 12-lead ECG."
                },
                {
                  "type": "list",
                  "title": "Expected approach:",
                  "items": [
                    {
                      "text": "Identify the electrodes and explain their purpose.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Explain the difference between electrodes and leads.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Place RA, LA, RL, and LL using the labelled cable connections.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Identify the anatomical landmarks for V1–V6.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Apply the electrodes with good skin contact.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Check connections and tracing quality.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Explain common placement errors and their potential consequences.",
                      "level": 0,
                      "label": "7."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}