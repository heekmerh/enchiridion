  "sections": [
    {
      "section_id": "syringes_and_needles_section_1",
      "section_title": "Syringes and needles",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "syringes_and_needles_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "syringes_and_needles_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/syringes_and_needles_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Syringes and needles are medical devices used to draw up, measure, transfer and administer medications or fluids, and to obtain specimens or aspirate fluid when clinically indicated."
                },
                {
                  "type": "paragraph",
                  "text": "In an OSCE, you should be able to identify different syringe types, select the correct needle, demonstrate safe preparation and administration, explain injection routes, and prevent needlestick injuries and medication errors."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "syringes_and_needles_subsection_2",
          "subsection_title": "Identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "syringes_and_needles_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Syringe: A calibrated barrel with a plunger and a tip or connector used to draw up or expel fluid."
                },
                {
                  "type": "paragraph",
                  "text": "Needle: A hollow, sharp metal instrument used to penetrate tissue or access a compatible device."
                },
                {
                  "type": "paragraph",
                  "text": "Classification: Medical devices used for medication administration, aspiration, specimen collection and related procedures."
                }
              ]
            },
            {
              "group_id": "syringes_and_needles_group_3",
              "group_title": "Common types of syringes",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "1. 1 mL syringe"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Used for small-volume measurements, including selected pediatric medications and intradermal testing. Tuberculin and insulin syringes are distinct designs; they are not interchangeable."
                },
                {
                  "type": "checklist",
                  "items": [
                    "2–5 mL syringes"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Commonly used for small-volume medication preparation and administration."
                },
                {
                  "type": "checklist",
                  "items": [
                    "10–20 mL syringes"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Used for larger volumes, medication preparation and selected flushing procedures when appropriate."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/syringes_and_needles_02.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Insulin syringe"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Calibrated in insulin units for a specified insulin concentration, commonly U-100. It must not be confused with a general-purpose syringe calibrated in mL."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/syringes_and_needles_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Oral or enteral syringe"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Used to measure and administer oral or enteral preparations. It should not connect to IV equipment, reducing the risk of wrong-route administration."
                }
              ]
            },
            {
              "group_id": "syringes_and_needles_group_4",
              "group_title": "Common types of needles",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/syringes_and_needles_04.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/syringes_and_needles_05.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/syringes_and_needles_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Needles vary by:"
                },
                {
                  "type": "paragraph",
                  "text": "Gauge (G): Indicates needle diameter. A higher gauge number means a smaller external diameter."
                },
                {
                  "type": "paragraph",
                  "text": "Length: Selected according to the route, injection site, tissue depth and patient."
                },
                {
                  "type": "paragraph",
                  "text": "Bevel: The angled tip designed to facilitate tissue penetration."
                },
                {
                  "type": "paragraph",
                  "text": "Hub: The part connecting the needle to the syringe."
                },
                {
                  "type": "paragraph",
                  "text": "Lumen: The hollow channel through which fluid passes."
                },
                {
                  "type": "paragraph",
                  "text": "Needles may be designed for intramuscular, subcutaneous, intradermal or other specific procedures. Blunt filling needles are intended for drawing up medication where appropriate, not routine injection into tissue."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "syringes_and_needles_subsection_3",
          "subsection_title": "Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "syringes_and_needles_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Intramuscular (IM) injection: Vaccines and other medications intended for muscle administration."
                },
                {
                  "type": "paragraph",
                  "text": "Subcutaneous (SC) injection: Insulin, selected anticoagulants and other subcutaneous medications."
                },
                {
                  "type": "paragraph",
                  "text": "Intradermal (ID) injection: Selected skin tests, such as tuberculin testing."
                },
                {
                  "type": "paragraph",
                  "text": "Intravenous (IV) administration: Drawing up or administering medications through compatible IV access when prescribed and appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Medication preparation: Measuring and transferring a prescribed dose."
                },
                {
                  "type": "paragraph",
                  "text": "Aspiration: Obtaining fluid or withdrawing contents when indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Specimen collection: Selected blood or fluid collection procedures with appropriate equipment."
                },
                {
                  "type": "paragraph",
                  "text": "Oral or enteral medication administration: Using a dedicated oral/enteral syringe without a needle."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE distinction: A syringe is not inherently suitable for every route. Use the correct syringe, connector and needle for the procedure, and never administer a medication by a route not authorized by its prescription."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "syringes_and_needles_subsection_4",
          "subsection_title": "Parts and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "syringes_and_needles_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/syringes_and_needles_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Barrel"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Holds the fluid. Its graduated markings allow measurement of volume or, in specific syringe types, dose units."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/syringes_and_needles_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Plunger and stopper"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Draw fluid into the barrel when withdrawn and expel fluid when depressed. The stopper helps create a seal."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/syringes_and_needles_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Tip or connector"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Connects to a compatible needle, extension set or other device. Luer-lock connectors screw into place; Luer-slip connectors fit by friction."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/syringes_and_needles_10.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Needle hub, shaft and bevel"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The hub attaches to the syringe, the shaft penetrates tissue, and the bevel forms the angled tip."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/syringes_and_needles_11.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "5. Protective cap"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Maintains needle sterility before use. Once the needle has been used, it should not be routinely recapped."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "syringes_and_needles_subsection_5",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "syringes_and_needles_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Accurate measurement when an appropriate syringe is selected and read correctly."
                },
                {
                  "type": "paragraph",
                  "text": "Enables controlled administration of prescribed small medication volumes."
                },
                {
                  "type": "paragraph",
                  "text": "Available in a range of sizes and designs."
                },
                {
                  "type": "paragraph",
                  "text": "Single-use sterile devices reduce cross-contamination risk."
                },
                {
                  "type": "paragraph",
                  "text": "Can be used for multiple routes when the device is designed and approved for that route."
                },
                {
                  "type": "paragraph",
                  "text": "Safety-engineered needles and needle-protection systems can reduce sharps injuries."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "syringes_and_needles_subsection_6",
          "subsection_title": "Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "syringes_and_needles_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Incorrect measurement can cause serious medication errors."
                },
                {
                  "type": "paragraph",
                  "text": "Needle use carries a risk of needlestick injury and blood-borne infection."
                },
                {
                  "type": "paragraph",
                  "text": "Wrong needle length or injection technique may lead to incorrect tissue deposition."
                },
                {
                  "type": "paragraph",
                  "text": "Syringe markings may be too coarse for very small doses."
                },
                {
                  "type": "paragraph",
                  "text": "Dead space can retain a small volume of medication."
                },
                {
                  "type": "paragraph",
                  "text": "Incompatible syringe and connector designs may cause leakage or connection errors."
                },
                {
                  "type": "paragraph",
                  "text": "Some medications require specific syringes, filters, needles or administration devices."
                },
                {
                  "type": "paragraph",
                  "text": "Reuse can transmit infection and compromise device integrity."
                },
                {
                  "type": "paragraph",
                  "text": "Important: A syringe marked in units is not automatically interchangeable with one marked in mL. Always verify the concentration and intended calibration."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "syringes_and_needles_subsection_7",
          "subsection_title": "Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "syringes_and_needles_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Before preparing an injection, state that you would:"
                },
                {
                  "type": "paragraph",
                  "text": "Perform hand hygiene."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm the patient's identity using the required identifiers."
                },
                {
                  "type": "paragraph",
                  "text": "Check the prescription, medication, dose, route, timing and relevant allergies."
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the medication, expiry date, concentration and integrity of its container."
                },
                {
                  "type": "paragraph",
                  "text": "Select an appropriate sterile syringe and needle."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm that the syringe calibration is appropriate for the dose."
                },
                {
                  "type": "paragraph",
                  "text": "Prepare the medication using aseptic non-touch technique."
                },
                {
                  "type": "paragraph",
                  "text": "Label a prepared syringe when it will not be administered immediately, according to local policy."
                },
                {
                  "type": "paragraph",
                  "text": "Check the injection site and relevant contraindications or precautions for the particular medication."
                },
                {
                  "type": "paragraph",
                  "text": "Explain the procedure, obtain consent and position the patient appropriately."
                },
                {
                  "type": "paragraph",
                  "text": "Dispose of used needles immediately into an approved sharps container."
                },
                {
                  "type": "paragraph",
                  "text": "Document administration and the patient's response as required."
                }
              ]
            },
            {
              "group_id": "syringes_and_needles_group_10",
              "group_title": "The five rights of medication administration",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A useful starting point is:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Right patient",
                    "Right medication",
                    "Right dose",
                    "Right route",
                    "Right time"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Many institutions extend this to include the right documentation, indication, assessment, education and evaluation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "syringes_and_needles_subsection_8",
          "subsection_title": "How to use a syringe and needle — OSCE demonstration",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "syringes_and_needles_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The precise technique depends on the injection route. The following outlines general medication preparation and common injection principles."
                }
              ]
            },
            {
              "group_id": "syringes_and_needles_group_12",
              "group_title": "A. Drawing up medication from an ampoule or vial",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Step 1 — Verify the medication"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Confirm the medication name, concentration, prescribed dose, expiry and route."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/syringes_and_needles_12.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 2 — Prepare the container"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "For an ampoule, use the appropriate safe opening technique. For a vial, disinfect the rubber stopper and allow it to dry."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/syringes_and_needles_13.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 3 — Draw up the medication"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Use the appropriate sterile syringe and drawing-up device. A filter needle or filter straw may be indicated for glass ampoules, according to policy and manufacturer guidance."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/syringes_and_needles_14.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 4 — Measure the dose"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Align the correct graduation with the appropriate part of the stopper and check the volume at eye level. Remove air according to the intended procedure without contaminating the needle or wasting medication."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/syringes_and_needles_15.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 5 — Prepare for administration"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Change the needle if indicated by the procedure and institutional policy. Maintain sterility, label the syringe when required, and perform the required dose check."
                }
              ]
            },
            {
              "group_id": "syringes_and_needles_group_13",
              "group_title": "B. General injection procedure",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Confirm the patient and explain the procedure."
                },
                {
                  "type": "paragraph",
                  "text": "Perform hand hygiene and wear appropriate PPE."
                },
                {
                  "type": "paragraph",
                  "text": "Select the correct injection site, needle length and gauge."
                },
                {
                  "type": "paragraph",
                  "text": "Position the patient and expose the site appropriately."
                },
                {
                  "type": "paragraph",
                  "text": "Clean the site if required by the procedure or local protocol, allowing antiseptic to dry."
                },
                {
                  "type": "paragraph",
                  "text": "Insert the needle using the correct route-specific technique."
                },
                {
                  "type": "paragraph",
                  "text": "Administer the medication according to its instructions."
                },
                {
                  "type": "paragraph",
                  "text": "Withdraw the needle safely and activate its safety mechanism if present."
                },
                {
                  "type": "paragraph",
                  "text": "Apply appropriate pressure or a dressing if needed."
                },
                {
                  "type": "paragraph",
                  "text": "Dispose of the needle and syringe immediately in the designated sharps container."
                },
                {
                  "type": "paragraph",
                  "text": "Document the medication, dose, route, time, site and response as required."
                },
                {
                  "type": "paragraph",
                  "text": "Route-specific caution: Aspiration practices differ between procedures. Routine aspiration is generally not recommended for vaccination at recommended IM sites, whereas some other procedures have different requirements. Follow the relevant guideline rather than applying one technique to every injection."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "syringes_and_needles_subsection_9",
          "subsection_title": "Contraindications and complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "syringes_and_needles_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "There is no single contraindication to all syringes or needles. Suitability depends on the medication, route, site and device."
                }
              ]
            },
            {
              "group_id": "syringes_and_needles_group_15",
              "group_title": "Contraindications and precautions",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Avoid injecting into an infected, inflamed or otherwise unsuitable site."
                },
                {
                  "type": "paragraph",
                  "text": "Consider bleeding risk, tissue integrity and medication-specific precautions."
                },
                {
                  "type": "paragraph",
                  "text": "Check for medication allergy and route-specific contraindications."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid using damaged, contaminated, expired or incompatible equipment."
                },
                {
                  "type": "paragraph",
                  "text": "Never reuse a single-use syringe or needle, even if the needle is changed."
                }
              ]
            },
            {
              "group_id": "syringes_and_needles_group_16",
              "group_title": "Common complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Explanation"
                  ],
                  "rows": [
                    [
                      "Pain and bruising",
                      "Tissue trauma or bleeding"
                    ],
                    [
                      "Haematoma",
                      "Blood collects in surrounding tissue"
                    ],
                    [
                      "Infection",
                      "Breach of aseptic technique"
                    ],
                    [
                      "Nerve or vascular injury",
                      "Incorrect site or needle placement"
                    ],
                    [
                      "Tissue damage",
                      "Wrong route, unsuitable medication or extravasation"
                    ],
                    [
                      "Needlestick injury",
                      "Accidental penetration of the skin with a used sharp"
                    ],
                    [
                      "Medication error",
                      "Wrong patient, drug, dose, route or concentration"
                    ],
                    [
                      "Allergic reaction",
                      "Reaction to the administered medication"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "If a needlestick injury occurs: Wash the area with soap and water, report immediately and seek urgent occupational-health or emergency assessment for risk evaluation and time-sensitive post-exposure management. Do not squeeze or aggressively scrub the wound."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "syringes_and_needles_subsection_10",
          "subsection_title": "Normal and abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "syringes_and_needles_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Syringes and needles do not generate diagnostic results themselves, but you must assess the equipment and patient response."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Satisfactory findings"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Correct sterile device and calibration selected."
                },
                {
                  "type": "paragraph",
                  "text": "Correct medication volume drawn up."
                },
                {
                  "type": "paragraph",
                  "text": "No visible contamination, cracks or leakage."
                },
                {
                  "type": "paragraph",
                  "text": "Appropriate administration technique completed."
                },
                {
                  "type": "paragraph",
                  "text": "No unexpected pain, swelling, bleeding or immediate adverse reaction."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Abnormal or concerning findings"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Incorrect dose or unexpected syringe markings."
                },
                {
                  "type": "paragraph",
                  "text": "Damaged packaging or suspected contamination."
                },
                {
                  "type": "paragraph",
                  "text": "Excessive pain, swelling, bleeding or resistance during administration."
                },
                {
                  "type": "paragraph",
                  "text": "Signs of allergy, anaphylaxis or other medication toxicity."
                },
                {
                  "type": "paragraph",
                  "text": "Needlestick injury or accidental wrong-route administration."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "syringes_and_needles_subsection_11",
          "subsection_title": "Pediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "syringes_and_needles_group_18",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This section is particularly important for pediatric and neonatal OSCEs."
                },
                {
                  "type": "paragraph",
                  "text": "Weight-based doses: Verify the child's current weight in kilograms and calculate the prescribed dose using the correct protocol."
                },
                {
                  "type": "paragraph",
                  "text": "Small volumes: Select a syringe with graduations that allow reliable measurement of the intended volume."
                },
                {
                  "type": "paragraph",
                  "text": "Concentration: Confirm the medication concentration before calculating the volume to administer."
                },
                {
                  "type": "paragraph",
                  "text": "Needle length: Choose according to the child's size, injection site, route and tissue depth."
                },
                {
                  "type": "paragraph",
                  "text": "Injection sites: For infant IM injections, the anterolateral thigh is commonly preferred. The deltoid may be appropriate in older children when muscle mass and the product's guidance permit."
                },
                {
                  "type": "paragraph",
                  "text": "Vaccination: Use age- and site-appropriate needles and follow current immunization guidance."
                },
                {
                  "type": "paragraph",
                  "text": "Insulin: Use the syringe or pen system designed for the prescribed insulin concentration. Never estimate insulin doses using an uncalibrated general-purpose syringe."
                },
                {
                  "type": "paragraph",
                  "text": "Oral medicines: Use an oral/enteral syringe, not a hypodermic syringe with a needle."
                },
                {
                  "type": "paragraph",
                  "text": "Restraint and comfort: Use developmentally appropriate explanation, caregiver support and safe positioning."
                },
                {
                  "type": "paragraph",
                  "text": "Monitoring: Observe for pain, bleeding, local reactions and medication-specific adverse effects."
                },
                {
                  "type": "paragraph",
                  "text": "High-yield warning: Small errors in volume can represent large errors in dose in neonates. Use an appropriately sized syringe, verify the concentration and obtain an independent check when required."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "syringes_and_needles_subsection_12",
          "subsection_title": "Mnemonics and memory aids",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "syringes_and_needles_group_19",
              "group_title": "Mnemonic: “SCALE” — before drawing up medication",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "S — Select the correct syringe and needle."
                },
                {
                  "type": "paragraph",
                  "text": "C — Check the patient, drug, dose and concentration."
                },
                {
                  "type": "paragraph",
                  "text": "A — Apply aseptic technique."
                },
                {
                  "type": "paragraph",
                  "text": "L — Look at the graduations at eye level."
                },
                {
                  "type": "paragraph",
                  "text": "E — Ensure safe administration and disposal."
                }
              ]
            },
            {
              "group_id": "syringes_and_needles_group_20",
              "group_title": "Needle gauge memory aid",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Higher gauge = smaller diameter."
                },
                {
                  "type": "paragraph",
                  "text": "For example, a 25G needle has a smaller external diameter than a 21G needle."
                },
                {
                  "type": "paragraph",
                  "text": "Do not memorize one needle size for every procedure. Gauge and length selection depend on the route, medication viscosity, injection site, patient size and relevant guideline."
                }
              ]
            },
            {
              "group_id": "syringes_and_needles_group_21",
              "group_title": "Calculating the volume to administer",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/syringes_and_needles_16.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Example: A child is prescribed 75 mg of a medication available at 25 mg/mL."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/syringes_and_needles_17.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "The required volume is 3 mL, assuming the prescription and concentration are correct and the formulation is appropriate."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "syringes_and_needles_subsection_13",
          "subsection_title": "Common OSCE questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "syringes_and_needles_group_22",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is a syringe?"
                },
                {
                  "type": "paragraph",
                  "text": "A calibrated device consisting of a barrel and plunger, used to draw up, measure and administer fluids or medications."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is the difference between gauge and needle length?"
                },
                {
                  "type": "paragraph",
                  "text": "Gauge describes the needle's diameter; length describes the distance from the hub to the tip."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What does a higher gauge number mean?"
                },
                {
                  "type": "paragraph",
                  "text": "A smaller external needle diameter."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Why are insulin syringes different?"
                },
                {
                  "type": "paragraph",
                  "text": "They are calibrated for specified insulin concentrations in units rather than ordinary volume markings alone. The wrong syringe can cause a serious dosing error."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. Why might a filter needle be used with an ampoule?"
                },
                {
                  "type": "paragraph",
                  "text": "To reduce the risk of drawing up glass particles when required by the procedure. It is not used to inject into tissue."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Why must syringes and needles not be reused?"
                },
                {
                  "type": "paragraph",
                  "text": "Reuse risks contamination, transmission of infection and device damage."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What is the difference between Luer-lock and Luer-slip?"
                },
                {
                  "type": "paragraph",
                  "text": "Luer-lock connectors screw together for a more secure connection, whereas Luer-slip connectors fit by friction."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. What would you do after a needlestick injury?"
                },
                {
                  "type": "paragraph",
                  "text": "Wash the affected area, report the incident immediately and seek urgent assessment for post-exposure management."
                },
                {
                  "type": "paragraph",
                  "text": "Q9. Why should used needles not be recapped?"
                },
                {
                  "type": "paragraph",
                  "text": "Recapping can cause accidental needlestick injuries. Dispose of the sharp immediately in an approved sharps container."
                },
                {
                  "type": "paragraph",
                  "text": "Q10. Which syringe is appropriate for oral medication in a child?"
                },
                {
                  "type": "paragraph",
                  "text": "A dedicated oral/enteral syringe without a needle, with appropriate volume markings."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "syringes_and_needles_subsection_14",
          "subsection_title": "Common mistakes and examiner tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "syringes_and_needles_group_23",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Common mistakes include:"
                },
                {
                  "type": "paragraph",
                  "text": "Failing to verify the medication and patient."
                },
                {
                  "type": "paragraph",
                  "text": "Confusing mg, micrograms, mL and insulin units."
                },
                {
                  "type": "paragraph",
                  "text": "Using the wrong syringe calibration."
                },
                {
                  "type": "paragraph",
                  "text": "Choosing an inappropriate needle length or gauge."
                },
                {
                  "type": "paragraph",
                  "text": "Touching sterile parts during medication preparation."
                },
                {
                  "type": "paragraph",
                  "text": "Failing to check the concentration before calculating the volume."
                },
                {
                  "type": "paragraph",
                  "text": "Recapping a used needle."
                },
                {
                  "type": "paragraph",
                  "text": "Disposing of sharps in ordinary waste."
                },
                {
                  "type": "paragraph",
                  "text": "Using an oral syringe for an IV medication or vice versa."
                },
                {
                  "type": "paragraph",
                  "text": "Forgetting to document administration and monitor the patient."
                },
                {
                  "type": "paragraph",
                  "text": "Examiner tip: When asked to draw up a medication, state the intended dose, the available concentration and your calculated volume before proceeding. This demonstrates that you understand the medication calculation rather than merely the mechanics of using a syringe."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}