      "section_title": "Breast biopsy needle",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "breast_biopsy_needle_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "breast_biopsy_needle_group_1",
