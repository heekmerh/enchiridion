              "blocks": [
                {
                  "type": "list",
                  "title": "Before leaving the station, make sure you can:",
                  "items": [
                    {
                      "text": "Identify the instrument and distinguish FNA, core biopsy and vacuum-assisted systems.",
                      "level": 0
                    },
                    {
                      "text": "Label the needle, shaft, sampling notch, cutting cannula and trigger where present.",
                      "level": 0
                    },
                    {
                      "text": "Explain the principle of sampling.",
                      "level": 0
                    },
                    {
                      "text": "List indications and guidance methods.",
                      "level": 0
                    },
                    {
                      "text": "State advantages and disadvantages.",
                      "level": 0
                    },
                    {
                      "text": "Identify bleeding, haematoma, infection and sampling error as relevant complications.",
                      "level": 0
                    },
                    {
                      "text": "Describe specimen labelling and handling.",
                      "level": 0
                    },
                    {
                      "text": "Explain the importance of radiology–pathology concordance.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "breast_biopsy_needle_group_19",
              "group_title": "Final exam pearl",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "FNA = cells; core needle biopsy = tissue architecture; vacuum-assisted biopsy = multiple tissue samples using suction."
                },
                {
                  "type": "paragraph",
                  "text": "The most important clinical principle is that a biopsy result must agree with the clinical and imaging findings. A benign but discordant result requires further evaluation."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}