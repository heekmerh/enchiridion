              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Identification: Surgical scissors used for cutting or dissecting tissue.",
                      "level": 0
                    },
                    {
                      "text": "Main parts: Finger rings, shanks, joint, blades, and tips.",
                      "level": 0
                    },
                    {
                      "text": "Principle: Two opposing blades cut tissue as they close.",
                      "level": 0
                    },
                    {
                      "text": "Common examples: Metzenbaum and Mayo scissors.",
                      "level": 0
                    },
                    {
                      "text": "Main uses: Soft-tissue dissection and selected cutting tasks during gastrointestinal surgery.",
                      "level": 0
                    },
                    {
                      "text": "Major risks: Bowel injury, bleeding, and injury to adjacent structures.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
