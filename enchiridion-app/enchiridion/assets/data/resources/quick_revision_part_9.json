      "subsections": [
        {
          "subsection_id": "quick_revision_part_9_subsection_1",
          "subsection_title": "1. Cholecystitis + Pre-renal, Renal and Post-renal Causes of AKI",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_9_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Acute cholecystitis — causes"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Gallstone obstruction of cystic duct",
                      "level": 0
                    },
                    {
                      "text": "Acalculous cholecystitis: critical illness, trauma, burns, prolonged fasting, major surgery",
                      "level": 0
                    },
                    {
                      "text": "Biliary sludge",
                      "level": 0
                    },
                    {
                      "text": "Rarely, parasitic or infectious causes",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Features of acute cholecystitis"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Right upper quadrant pain",
                      "level": 0
                    },
                    {
                      "text": "Fever",
                      "level": 0
                    },
                    {
                      "text": "Nausea and vomiting",
                      "level": 0
                    },
                    {
                      "text": "Positive Murphy's sign",
                      "level": 0
                    },
                    {
                      "text": "Right upper quadrant tenderness",
                      "level": 0
                    },
                    {
                      "text": "Leukocytosis",
                      "level": 0
                    },
                    {
                      "text": "Ultrasound: gallstones, gallbladder wall thickening, pericholecystic fluid, sonographic Murphy's sign",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "AKI causes"
                },
                {
                  "type": "paragraph",
                  "text": "Pre-renal"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Dehydration",
                      "level": 0
                    },
                    {
                      "text": "Haemorrhage",
                      "level": 0
                    },
                    {
                      "text": "Vomiting and diarrhoea",
                      "level": 0
                    },
                    {
                      "text": "Sepsis and shock",
                      "level": 0
                    },
                    {
                      "text": "Heart failure",
                      "level": 0
                    },
                    {
                      "text": "Cirrhosis with reduced effective circulating volume",
                      "level": 0
                    },
                    {
                      "text": "Renal artery stenosis",
                      "level": 0
                    },
                    {
                      "text": "NSAIDs, ACE inhibitors/ARBs in susceptible patients",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Intrinsic renal"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Acute tubular injury/necrosis",
                      "level": 0
                    },
                    {
                      "text": "Acute interstitial nephritis",
                      "level": 0
                    },
                    {
                      "text": "Acute glomerulonephritis",
                      "level": 0
                    },
                    {
                      "text": "Vasculitis",
                      "level": 0
                    },
                    {
                      "text": "Rhabdomyolysis",
                      "level": 0
                    },
                    {
                      "text": "Haemolysis",
                      "level": 0
                    },
                    {
                      "text": "Acute cortical necrosis",
                      "level": 0
                    },
                    {
                      "text": "Nephrotoxic drugs or contrast-associated kidney injury",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Post-renal"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Benign prostatic hyperplasia",
                      "level": 0
                    },
                    {
                      "text": "Prostate cancer",
                      "level": 0
                    },
                    {
                      "text": "Urethral stricture",
                      "level": 0
                    },
                    {
                      "text": "Bilateral ureteric obstruction",
                      "level": 0
                    },
                    {
                      "text": "Bilateral obstructing stones",
                      "level": 0
                    },
                    {
                      "text": "Bladder or ureteric tumours",
                      "level": 0
                    },
                    {
                      "text": "Retroperitoneal fibrosis",
                      "level": 0
                    },
                    {
                      "text": "Neurogenic bladder",
                      "level": 0
                    },
                    {
                      "text": "Blocked urinary catheter",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_9_subsection_2",
          "subsection_title": "2. Causes of Normal-Sized and Enlarged Kidneys in CKD",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_9_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Normal-sized kidneys"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Diabetic nephropathy — early or intermediate disease",
                      "level": 0
                    },
                    {
                      "text": "HIV-associated nephropathy may cause enlargement, but advanced disease can show reduced size",
                      "level": 0
                    },
                    {
                      "text": "Early chronic glomerulonephritis",
                      "level": 0
                    },
                    {
                      "text": "Polycystic kidney disease may enlarge kidneys",
                      "level": 0
                    },
                    {
                      "text": "Amyloidosis",
                      "level": 0
                    },
                    {
                      "text": "Infiltrative disorders",
                      "level": 0
                    },
                    {
                      "text": "Obstructive uropathy — early disease",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Small kidneys"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Chronic glomerulonephritis",
                      "level": 0
                    },
                    {
                      "text": "Chronic pyelonephritis",
                      "level": 0
                    },
                    {
                      "text": "Reflux nephropathy",
                      "level": 0
                    },
                    {
                      "text": "Hypertensive nephrosclerosis",
                      "level": 0
                    },
                    {
                      "text": "Chronic ischaemic nephropathy",
                      "level": 0
                    },
                    {
                      "text": "Analgesic nephropathy",
                      "level": 0
                    },
                    {
                      "text": "Advanced diabetic nephropathy",
                      "level": 0
                    },
                    {
                      "text": "End-stage renal disease of many causes",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Large kidneys"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Diabetic nephropathy",
                      "level": 0
                    },
                    {
                      "text": "HIV-associated nephropathy",
                      "level": 0
                    },
                    {
                      "text": "Autosomal dominant polycystic kidney disease",
                      "level": 0
                    },
                    {
                      "text": "Autosomal recessive polycystic kidney disease",
                      "level": 0
                    },
                    {
                      "text": "Amyloidosis",
                      "level": 0
                    },
                    {
                      "text": "Multiple myeloma/light-chain deposition disease",
                      "level": 0
                    },
                    {
                      "text": "Renal lymphoma or leukaemic infiltration",
                      "level": 0
                    },
                    {
                      "text": "Hydronephrosis",
                      "level": 0
                    },
                    {
                      "text": "Renal vein thrombosis",
                      "level": 0
                    },
                    {
                      "text": "Bilateral renal tumours or infiltrative disease",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_9_subsection_3",
          "subsection_title": "3. RIFLE Criteria for Acute Kidney Injury (AKI)",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_9_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "| Category | Serum creatinine/GFR criteria | Urine output criteria | |---|---|---| | R — Risk | Creatinine ×1.5 baseline or GFR decrease >25% | 50% | 75% | 4 weeks | Persistent kidney failure | | E — End-stage kidney disease | Kidney failure lasting >3 months | Persistent kidney failure |"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_9_subsection_4",
          "subsection_title": "4. Common Causes of Chronic Kidney Disease (CKD)",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_9_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Diabetic: Diabetic kidney disease.",
                      "level": 0
                    },
                    {
                      "text": "Hypertensive: Hypertensive nephrosclerosis.",
                      "level": 0
                    },
                    {
                      "text": "Glomerular: Chronic glomerulonephritis, IgA nephropathy, lupus nephritis.",
                      "level": 0
                    },
                    {
                      "text": "Hereditary/congenital: Autosomal dominant polycystic kidney disease (ADPKD), congenital renal abnormalities, Alport syndrome.",
                      "level": 0
                    },
                    {
                      "text": "Obstructive: Benign prostatic hyperplasia, urethral stricture, recurrent obstructive uropathy, urinary calculi.",
                      "level": 0
                    },
                    {
                      "text": "Tubulointerstitial: Chronic pyelonephritis, reflux nephropathy, chronic interstitial nephritis, analgesic nephropathy.",
                      "level": 0
                    },
                    {
                      "text": "Systemic: Multiple myeloma, amyloidosis, systemic lupus erythematosus, vasculitis.",
                      "level": 0
                    },
                    {
                      "text": "Vascular: Renal artery stenosis, chronic renal ischaemia.",
                      "level": 0
                    },
                    {
                      "text": "Infectious: Recurrent renal infections, HIV-associated nephropathy.",
                      "level": 0
                    },
                    {
                      "text": "Other: Reflux nephropathy, sickle cell nephropathy, chronic nephrotoxic drug exposure, unknown/idiopathic causes.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_9_subsection_5",
          "subsection_title": "5. CKD With Enlarged Kidneys",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_9_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Diabetic kidney disease (especially early stages).",
                      "level": 0
                    },
                    {
                      "text": "Autosomal dominant polycystic kidney disease (ADPKD).",
                      "level": 0
                    },
                    {
                      "text": "Autosomal recessive polycystic kidney disease (ARPKD).",
                      "level": 0
                    },
                    {
                      "text": "HIV-associated nephropathy.",
                      "level": 0
                    },
                    {
                      "text": "Amyloidosis.",
                      "level": 0
                    },
                    {
                      "text": "Multiple myeloma (infiltrative disease).",
                      "level": 0
                    },
                    {
                      "text": "Renal lymphoma/leukaemic infiltration.",
                      "level": 0
                    },
                    {
                      "text": "Renal sarcoidosis.",
                      "level": 0
                    },
                    {
                      "text": "Hydronephrosis due to chronic obstruction.",
                      "level": 0
                    },
                    {
                      "text": "Medullary cystic disorders in selected cases.",
                      "level": 0
                    },
                    {
                      "text": "Fabry disease.",
                      "level": 0
                    },
                    {
                      "text": "Sickle cell nephropathy (occasionally).",
                      "level": 0
                    },
                    {
                      "text": "Bilateral renal malignancy/infiltrative disease.",
                      "level": 0
                    },
                    {
                      "text": "Atelectasis with patent bronchi.",
                      "level": 0
                    },
                    {
                      "text": "Pulmonary contusion.",
                      "level": 0
                    },
                    {
                      "text": "Eosinophilic pneumonia.",
                      "level": 0
                    },
                    {
                      "text": "Lipoid pneumonia.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_9_subsection_6",
          "subsection_title": "6. Causes of Urethral Stricture",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_9_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Traumatic:",
                      "level": 0
                    },
                    {
                      "text": "Pelvic fracture,",
                      "level": 1
                    },
                    {
                      "text": "straddle injury,",
                      "level": 1
                    },
                    {
                      "text": "urethral instrumentation,",
                      "level": 1
                    },
                    {
                      "text": "traumatic catheterisation.",
                      "level": 1
                    },
                    {
                      "text": "Iatrogenic:",
                      "level": 0
                    },
                    {
                      "text": "Repeated catheterisation,",
                      "level": 1
                    },
                    {
                      "text": "cystoscopy,",
                      "level": 1
                    },
                    {
                      "text": "transurethral surgery,",
                      "level": 1
                    },
                    {
                      "text": "prostate surgery,",
                      "level": 1
                    },
                    {
                      "text": "hypospadias repair.",
                      "level": 1
                    },
                    {
                      "text": "Infective/inflammatory:",
                      "level": 0
                    },
                    {
                      "text": "Gonococcal urethritis,",
                      "level": 1
                    },
                    {
                      "text": "chlamydial urethritis,",
                      "level": 1
                    },
                    {
                      "text": "recurrent urethritis.",
                      "level": 1
                    },
                    {
                      "text": "Inflammatory dermatoses:",
                      "level": 0
                    },
                    {
                      "text": "Lichen sclerosus (balanitis xerotica obliterans).",
                      "level": 1
                    },
                    {
                      "text": "Congenital:",
                      "level": 0
                    },
                    {
                      "text": "Congenital urethral narrowing (rare).",
                      "level": 1
                    },
                    {
                      "text": "Idiopathic",
                      "level": 0
                    },
                    {
                      "text": "Radiation-related:",
                      "level": 0
                    },
                    {
                      "text": "Pelvic radiotherapy.",
                      "level": 1
                    },
                    {
                      "text": "Postoperative: Urethral reconstruction or other urethral surgery.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_9_subsection_7",
          "subsection_title": "7. Types of Urethral Strictures and Treatment",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_9_group_7",
              "group_title": "A. Based on Location",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Meatal: External urethral meatus; lichen sclerosus, instrumentation.",
                      "level": 0
                    },
                    {
                      "text": "Fossa navicularis: Distal penile urethra; lichen sclerosus, instrumentation.",
                      "level": 0
                    },
                    {
                      "text": "Penile urethral: Penile urethra; inflammation, lichen sclerosus, instrumentation.",
                      "level": 0
                    },
                    {
                      "text": "Bulbar urethral: Bulbar urethra; straddle injury, idiopathic, instrumentation.",
                      "level": 0
                    },
                    {
                      "text": "Membranous urethral: Membranous urethra; pelvic fracture injury, prostate surgery.",
                      "level": 0
                    },
                    {
                      "text": "Prostatic urethral: Prostatic urethra; prostate surgery, radiotherapy, scarring.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "quick_revision_part_9_group_8",
              "group_title": "B. Based on Aetiology",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Traumatic.",
                      "level": 0
                    },
                    {
                      "text": "Iatrogenic.",
                      "level": 0
                    },
                    {
                      "text": "Inflammatory/infective.",
                      "level": 0
                    },
                    {
                      "text": "Lichen sclerosus-associated.",
                      "level": 0
                    },
                    {
                      "text": "Congenital.",
                      "level": 0
                    },
                    {
                      "text": "Idiopathic.",
                      "level": 0
                    },
                    {
                      "text": "Radiation-induced.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "quick_revision_part_9_group_9",
              "group_title": "C. Based on Length",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Short: Less than 2 cm.",
                      "level": 0
                    },
                    {
                      "text": "Long: 2 cm or longer.",
                      "level": 0
                    },
                    {
                      "text": "Panurethral: Involves most or all of the anterior urethra.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Length cut-offs are descriptive; treatment also depends on location, fibrosis and previous interventions."
                }
              ]
            },
            {
              "group_id": "quick_revision_part_9_group_10",
              "group_title": "D. Based on Severity",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Mild: Narrowing with minimal obstruction.",
                      "level": 0
                    },
                    {
                      "text": "Moderate: Significant narrowing with obstructive symptoms.",
                      "level": 0
                    },
                    {
                      "text": "Severe: Marked narrowing with poor urinary flow or retention.",
                      "level": 0
                    },
                    {
                      "text": "Near-obliterative/obliterative: Minimal or no patent urethral lumen.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "quick_revision_part_9_group_11",
              "group_title": "E. Treatment",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Observation: Selected asymptomatic or minimally symptomatic cases.",
                      "level": 0
                    },
                    {
                      "text": "Urethral dilatation: Selected short, uncomplicated strictures.",
                      "level": 0
                    },
                    {
                      "text": "Direct vision internal urethrotomy (DVIU): Selected primary, short, non-obliterative bulbar strictures.",
                      "level": 0
                    },
                    {
                      "text": "Meatotomy/meatoplasty: Meatal stenosis.",
                      "level": 0
                    },
                    {
                      "text": "Urethroplasty: Definitive reconstruction for recurrent, long, complex or obliterative strictures.",
                      "level": 0
                    },
                    {
                      "text": "Excision and primary anastomosis.",
                      "level": 1
                    },
                    {
                      "text": "Augmentation urethroplasty using buccal mucosal graft.",
                      "level": 1
                    },
                    {
                      "text": "Substitution urethroplasty.",
                      "level": 1
                    },
                    {
                      "text": "Perineal urethrostomy: Selected complex or recurrent strictures.",
                      "level": 0
                    },
                    {
                      "text": "Suprapubic catheterisation: Urinary retention when urethral access is unsafe or unsuccessful.",
                      "level": 0
                    },
                    {
                      "text": "Treat underlying cause: Lichen sclerosus, infection, associated inflammation.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_9_subsection_8",
          "subsection_title": "8. Percutaneous Nephrostomy (PCN)",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_9_group_12",
              "group_title": "A. Indications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Obstructed urinary tract with hydronephrosis.",
                      "level": 0
                    },
                    {
                      "text": "Infected obstructed kidney/pyonephrosis — urgent decompression.",
                      "level": 0
                    },
                    {
                      "text": "Obstructive uropathy causing acute kidney injury.",
                      "level": 0
                    },
                    {
                      "text": "Ureteric obstruction from calculi.",
                      "level": 0
                    },
                    {
                      "text": "Malignant ureteric obstruction.",
                      "level": 0
                    },
                    {
                      "text": "Ureteric stricture.",
                      "level": 0
                    },
                    {
                      "text": "Failed or impossible retrograde ureteric stenting.",
                      "level": 0
                    },
                    {
                      "text": "Urinary diversion after selected urinary tract injuries.",
                      "level": 0
                    },
                    {
                      "text": "Access for percutaneous nephrolithotomy.",
                      "level": 0
                    },
                    {
                      "text": "Selected urinary leaks or fistulae.",
                      "level": 0
                    },
                    {
                      "text": "Selected cases of upper urinary tract drainage before definitive treatment.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "quick_revision_part_9_group_13",
              "group_title": "B. Contraindications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Absolute or major procedural contraindications"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Uncorrectable severe coagulopathy.",
                      "level": 0
                    },
                    {
                      "text": "No safe percutaneous access route.",
                      "level": 0
                    },
                    {
                      "text": "Patient refusal where consent is required.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Relative"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Correctable coagulopathy or thrombocytopenia.",
                      "level": 0
                    },
                    {
                      "text": "Uncontrolled hypertension.",
                      "level": 0
                    },
                    {
                      "text": "Active infection without appropriate antibiotic coverage (except urgent drainage of an infected obstruction, where drainage is essential).",
                      "level": 0
                    },
                    {
                      "text": "Interposed bowel or other organs.",
                      "level": 0
                    },
                    {
                      "text": "Severe anatomical distortion.",
                      "level": 0
                    },
                    {
                      "text": "Pregnancy, depending on urgency and imaging strategy.",
                      "level": 0
                    },
                    {
                      "text": "Severe cardiopulmonary instability.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "quick_revision_part_9_group_14",
              "group_title": "C. Complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Haematuria.",
                      "level": 0
                    },
                    {
                      "text": "Perirenal haematoma.",
                      "level": 0
                    },
                    {
                      "text": "Significant haemorrhage.",
                      "level": 0
                    },
                    {
                      "text": "Septicaemia/urosepsis.",
                      "level": 0
                    },
                    {
                      "text": "Injury to adjacent organs — bowel, liver, spleen, pleura.",
                      "level": 0
                    },
                    {
                      "text": "Pneumothorax or haemothorax.",
                      "level": 0
                    },
                    {
                      "text": "Urinary leakage.",
                      "level": 0
                    },
                    {
                      "text": "Catheter blockage.",
                      "level": 0
                    },
                    {
                      "text": "Catheter displacement.",
                      "level": 0
                    },
                    {
                      "text": "Infection at the insertion site.",
                      "level": 0
                    },
                    {
                      "text": "Urine extravasation.",
                      "level": 0
                    },
                    {
                      "text": "Persistent urinary fistula.",
                      "level": 0
                    },
                    {
                      "text": "Failure to drain the collecting system.",
                      "level": 0
                    },
                    {
                      "text": "Rarely, loss of renal function or nephrectomy following major injury.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_9_subsection_9",
          "subsection_title": "9. Features of Acute Kidney Injury (AKI)",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_9_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Clinical features"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Oliguria or anuria",
                      "level": 0
                    },
                    {
                      "text": "Reduced urine output",
                      "level": 0
                    },
                    {
                      "text": "Peripheral oedema",
                      "level": 0
                    },
                    {
                      "text": "Facial puffiness",
                      "level": 0
                    },
                    {
                      "text": "Hypertension or hypotension",
                      "level": 0
                    },
                    {
                      "text": "Pulmonary oedema and dyspnoea",
                      "level": 0
                    },
                    {
                      "text": "Nausea and vomiting",
                      "level": 0
                    },
                    {
                      "text": "Anorexia",
                      "level": 0
                    },
                    {
                      "text": "Fatigue and weakness",
                      "level": 0
                    },
                    {
                      "text": "Confusion, seizures or reduced consciousness in severe uraemia",
                      "level": 0
                    },
                    {
                      "text": "Asterixis",
                      "level": 0
                    },
                    {
                      "text": "Pericardial friction rub in uraemic pericarditis",
                      "level": 0
                    },
                    {
                      "text": "Features of underlying cause: dehydration, sepsis, shock, urinary obstruction",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Laboratory features"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Rising serum creatinine",
                      "level": 0
                    },
                    {
                      "text": "Elevated serum urea",
                      "level": 0
                    },
                    {
                      "text": "Hyperkalaemia",
                      "level": 0
                    },
                    {
                      "text": "Metabolic acidosis",
                      "level": 0
                    },
                    {
                      "text": "Hyperphosphataemia",
                      "level": 0
                    },
                    {
                      "text": "Hypocalcaemia (may occur)",
                      "level": 0
                    },
                    {
                      "text": "Dilutional hyponatraemia",
                      "level": 0
                    },
                    {
                      "text": "Abnormal urinalysis: proteinuria, haematuria, casts",
                      "level": 0
                    },
                    {
                      "text": "Muddy brown granular casts in acute tubular injury",
                      "level": 0
                    },
                    {
                      "text": "RBC casts in glomerulonephritis",
                      "level": 0
                    },
                    {
                      "text": "Urine electrolytes and indices may help distinguish pre-renal from intrinsic AKI",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Diagnostic criteria — KDIGO"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Serum creatinine rise ≥ 0.3 mg/dL (26.5 µmol/L) within 48 hours; or",
                      "level": 0
                    },
                    {
                      "text": "Serum creatinine ≥ 1.5 times baseline within 7 days; or",
                      "level": 0
                    },
                    {
                      "text": "Urine output < 0.5 mL/kg/hour for at least 6 hours.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_9_subsection_10",
