        {
          "subsection_id": "quick_revision_part_9_subsection_3",
          "subsection_title": "RIFLE Criteria for Acute Kidney Injury (AKI)",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_9_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "| Category | Serum creatinine/GFR criteria | Urine output criteria | |---|---|---| | R — Risk | Creatinine ×1.5 baseline or GFR decrease >25% | 50% | 75% | 4 weeks | Persistent kidney failure | | E — End-stage kidney disease | Kidney failure lasting >3 months | Persistent kidney failure |"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_9_subsection_4",
          "subsection_title": "Common Causes of Chronic Kidney Disease (CKD)",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_9_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Diabetic: Diabetic kidney disease."
                },
                {
                  "type": "paragraph",
                  "text": "Hypertensive: Hypertensive nephrosclerosis."
                },
                {
                  "type": "paragraph",
                  "text": "Glomerular: Chronic glomerulonephritis, IgA nephropathy, lupus nephritis."
                },
                {
                  "type": "paragraph",
                  "text": "Hereditary/congenital: Autosomal dominant polycystic kidney disease (ADPKD), congenital renal abnormalities, Alport syndrome."
                },
                {
                  "type": "paragraph",
                  "text": "Obstructive: Benign prostatic hyperplasia, urethral stricture, recurrent obstructive uropathy, urinary calculi."
                },
                {
                  "type": "paragraph",
                  "text": "Tubulointerstitial: Chronic pyelonephritis, reflux nephropathy, chronic interstitial nephritis, analgesic nephropathy."
                },
                {
                  "type": "paragraph",
                  "text": "Systemic: Multiple myeloma, amyloidosis, systemic lupus erythematosus, vasculitis."
                },
                {
                  "type": "paragraph",
                  "text": "Vascular: Renal artery stenosis, chronic renal ischaemia."
                },
                {
                  "type": "paragraph",
                  "text": "Infectious: Recurrent renal infections, HIV-associated nephropathy."
                },
                {
                  "type": "paragraph",
                  "text": "Other: Reflux nephropathy, sickle cell nephropathy, chronic nephrotoxic drug exposure, unknown/idiopathic causes."
                }
              ]
            }
          ]
        },
