        {
          "subsection_id": "cusco_speculum_subsection_2",
          "subsection_title": "1. Introduction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cusco_speculum_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Cusco's vaginal speculum is a self-retaining, bivalve gynaecological instrument used to separate the vaginal walls and expose the cervix for examination, diagnostic sampling and selected minor procedures."
                },
                {
                  "type": "paragraph",
                  "text": "It is one of the most frequently encountered instruments in gynaecology OSCE stations."
                },
                {
                  "type": "paragraph",
                  "text": "Key identifying feature: Two opposing blades that open apart using a hinge mechanism and can be maintained in position by a locking device."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cusco_speculum_subsection_3",
          "subsection_title": "2. Classification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cusco_speculum_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Specialty: Gynaecology and obstetrics.",
                      "level": 0
                    },
                    {
                      "text": "Function: Examination, visualisation and procedural access.",
                      "level": 0
                    },
                    {
                      "text": "Mechanical classification: Self-retaining retractor.",
                      "level": 0
                    },
                    {
                      "text": "Blade configuration: Bivalve.",
                      "level": 0
                    },
                    {
                      "text": "Material: Reusable stainless steel or single-use plastic.",
                      "level": 0
                    },
                    {
                      "text": "Mechanism: Hinged blades with a locking or adjustment mechanism.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cusco_speculum_subsection_4",
          "subsection_title": "3. Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cusco_speculum_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/cusco_speculum_04.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Description and function"
                  ],
                  "rows": [
                    [
                      "Upper blade",
                      "Retracts one vaginal wall."
                    ],
                    [
                      "Lower blade",
                      "Retracts the opposing vaginal wall."
                    ],
                    [
                      "Hinge/pivot",
                      "Allows the blades to separate and come together."
                    ],
                    [
                      "Handles",
                      "Allow the operator to grip and manipulate the instrument."
                    ],
                    [
                      "Locking screw or ratchet",
                      "Maintains blade separation at the desired position."
                    ],
                    [
                      "Adjustment mechanism",
                      "Controls opening and release, depending on the design."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Labelling tip: The exact arrangement of the screw, handles and locking mechanism varies between manufacturers. Identify the actual components on the instrument in front of you rather than relying solely on a diagram."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cusco_speculum_subsection_5",
          "subsection_title": "4. Principle and mechanism of action",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cusco_speculum_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The instrument works through mechanical retraction."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "The blades are brought together before insertion.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "The closed instrument is inserted gently into the vagina.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "The blades are opened gradually.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "The vaginal walls separate, exposing the cervix.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "The locking mechanism maintains the selected opening when required.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "The lock is released and the blades are brought together under control before withdrawal.",
                      "level": 0,
                      "label": "6."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The instrument does not routinely dilate the cervical canal. Its purpose is to provide visual access."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cusco_speculum_subsection_6",
          "subsection_title": "5. Types and variations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cusco_speculum_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/cusco_speculum_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A. Reusable metal Cusco speculum"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Usually made of medical-grade stainless steel.",
                      "level": 0
                    },
                    {
                      "text": "Durable and suitable for repeated use.",
                      "level": 0
                    },
                    {
                      "text": "Requires validated cleaning and sterilisation between patients.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/cusco_speculum_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "B. Disposable plastic Cusco speculum"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Usually supplied sterile for single-patient use.",
                      "level": 0
                    },
                    {
                      "text": "Avoids reprocessing between patients.",
                      "level": 0
                    },
                    {
                      "text": "Must not be reused; its strength and locking performance depend on the design.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/cusco_speculum_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "C. Different sizes"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Available in different blade lengths and widths.",
                      "level": 0
                    },
                    {
                      "text": "The appropriate size depends on the patient's anatomy and the purpose of examination.",
                      "level": 0
                    },
                    {
                      "text": "The smallest suitable size that provides adequate visualisation is generally preferred.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cusco_speculum_subsection_7",
          "subsection_title": "6. Uses and procedures",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cusco_speculum_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "The Cusco speculum is used for:",
                  "items": [
                    {
                      "text": "Cervical screening: Obtaining cervical cytology or HPV samples according to the screening protocol.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Vaginal and cervical swabs: Collecting samples for microbiological investigation.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "IUCD insertion and removal: Visualising the cervix to facilitate access to the cervical os.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Colposcopy: Exposing the cervix for examination with magnification.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Cervical biopsy: Providing visual access for targeted tissue sampling.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Assessment of abnormal bleeding: Helping identify a cervical or vaginal source.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Examination of vaginal discharge: Assessing its characteristics and possible source.",
                      "level": 0,
                      "label": "7."
                    },
                    {
                      "text": "Selected minor procedures: Providing access to the cervix and vaginal canal.",
                      "level": 0,
                      "label": "8."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "It is not a substitute for bimanual pelvic examination, which assesses uterine size, adnexal masses and cervical motion tenderness."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cusco_speculum_subsection_8",
          "subsection_title": "7. Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cusco_speculum_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Self-retaining, allowing the operator to use both hands for sampling or procedures.",
                      "level": 0
                    },
                    {
                      "text": "Rapid application once the technique is mastered.",
                      "level": 0
                    },
                    {
                      "text": "Provides simultaneous exposure of opposing vaginal walls.",
                      "level": 0
                    },
                    {
                      "text": "Suitable for routine cervical examination and screening.",
                      "level": 0
                    },
                    {
                      "text": "Available in several sizes and materials.",
                      "level": 0
                    },
                    {
                      "text": "Reusable models are durable and cost-effective over repeated use.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cusco_speculum_subsection_9",
          "subsection_title": "8. Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cusco_speculum_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "May cause discomfort during insertion or opening.",
                      "level": 0
                    },
                    {
                      "text": "May provide inadequate exposure in some patients with anatomical distortion, vaginal stenosis or prolapse.",
                      "level": 0
                    },
                    {
                      "text": "Can pinch vaginal tissue if opened or withdrawn carelessly.",
                      "level": 0
                    },
                    {
                      "text": "The locking mechanism may slip or malfunction.",
                      "level": 0
                    },
                    {
                      "text": "Reusable models require appropriate reprocessing.",
                      "level": 0
                    },
                    {
                      "text": "A self-retaining design does not eliminate the need to monitor patient comfort and tissue position.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cusco_speculum_subsection_10",
          "subsection_title": "9. Complications and prevention",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cusco_speculum_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Prevention"
                  ],
                  "rows": [
                    [
                      "Vaginal mucosal injury",
                      "Insert gently and avoid forceful opening."
                    ],
                    [
                      "Pain or discomfort",
                      "Explain each step, select an appropriate size and stop if significant pain occurs."
                    ],
                    [
                      "Minor bleeding",
                      "Avoid unnecessary contact and assess unexpected bleeding."
                    ],
                    [
                      "Tissue pinching",
                      "Keep the blades under control during opening and withdrawal."
                    ],
                    [
                      "Cross-infection",
                      "Follow standard precautions and validated reprocessing protocols."
                    ],
                    [
                      "Poor visualisation",
                      "Adjust position, size or instrument choice as appropriate."
                    ],
                    [
                      "Mechanical failure",
                      "Inspect the blades, hinge and locking mechanism before use."
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cusco_speculum_subsection_11",
          "subsection_title": "10. How to use it in an OSCE",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cusco_speculum_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/cusco_speculum_08.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 1 — Preparation"
                },
                {
                  "type": "paragraph",
                  "text": "Introduce yourself, confirm the patient's identity, explain the examination, obtain consent and arrange privacy and a chaperone according to local policy. Perform hand hygiene and prepare the appropriate instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Step 2 — Inspection and positioning"
                },
                {
                  "type": "paragraph",
                  "text": "Check that the instrument is intact, the blades close correctly and the lock releases. Position the patient appropriately, usually in the dorsal lithotomy position when suitable."
                },
                {
                  "type": "paragraph",
                  "text": "Step 3 — Insertion"
                },
                {
                  "type": "paragraph",
                  "text": "Separate the labia and insert the closed blades gently along the vaginal axis, avoiding unnecessary pressure on sensitive structures."
                },
                {
                  "type": "paragraph",
                  "text": "Step 4 — Opening and examination"
                },
                {
                  "type": "paragraph",
                  "text": "Open the blades gradually until the cervix is adequately visualised. Lock only as needed. Inspect the cervix and vaginal walls systematically and obtain any indicated samples."
                },
                {
                  "type": "paragraph",
                  "text": "Step 5 — Withdrawal and aftercare"
                },
                {
                  "type": "paragraph",
                  "text": "Release the lock, close the blades under control while ensuring no tissue is trapped, and withdraw gently. Ensure the patient's comfort, dispose of or reprocess the instrument appropriately, and document the findings."
                },
                {
                  "type": "paragraph",
                  "text": "Important clinical point: Use a lubricant compatible with the intended specimen collection method. Follow local laboratory guidance, especially for cervical cytology."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cusco_speculum_subsection_12",
          "subsection_title": "11. High-yield viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cusco_speculum_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. Why is Cusco's speculum called self-retaining?"
                },
                {
                  "type": "paragraph",
                  "text": "Because its locking mechanism can maintain separation of the blades without continuous manual holding."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Why is it called a bivalve instrument?"
                },
                {
                  "type": "paragraph",
                  "text": "Because it has two opposing blades that separate to expose the vaginal canal and cervix."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What is the difference between Cusco's and Sims' specula?"
                },
                {
                  "type": "paragraph",
                  "text": "Cusco's is generally bivalve and self-retaining; Sims' is a non-self-retaining retractor that requires manual support."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Why should the blades be closed before insertion?"
                },
                {
                  "type": "paragraph",
                  "text": "To minimise trauma and discomfort during introduction."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. Why must the lock be released before withdrawal?"
                },
                {
                  "type": "paragraph",
                  "text": "To allow the blades to close in a controlled manner and reduce the risk of trapping vaginal mucosa."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Can the Cusco speculum diagnose cervical cancer?"
                },
                {
                  "type": "paragraph",
                  "text": "It can reveal suspicious lesions, but visual inspection alone cannot confirm or exclude cancer. Appropriate diagnostic investigation, including biopsy where indicated, is required."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. How is a reusable metal speculum processed between patients?"
                },
                {
                  "type": "paragraph",
                  "text": "It requires appropriate cleaning followed by a validated sterilisation process in accordance with local infection-prevention policy and the manufacturer's instructions."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "cusco_speculum_subsection_13",
          "subsection_title": "12. High-yield exam traps",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "cusco_speculum_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Self-retaining does not mean self-inserting. The clinician controls insertion and positioning.",
                      "level": 0
                    },
                    {
                      "text": "Bivalve means two blades, not two separate instruments.",
                      "level": 0
                    },
                    {
                      "text": "The speculum exposes the cervix; it does not perform a bimanual examination.",
                      "level": 0
                    },
                    {
                      "text": "A normal-looking cervix does not eliminate the need for recommended cervical screening.",
                      "level": 0
                    },
                    {
                      "text": "Never force insertion or opening against pain or resistance.",
                      "level": 0
                    },
                    {
                      "text": "Always inspect the actual locking mechanism, as designs differ between models.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}