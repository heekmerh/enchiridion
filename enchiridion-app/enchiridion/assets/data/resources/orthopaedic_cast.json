        {
          "subsection_id": "orthopaedic_cast_subsection_15",
          "subsection_title": "Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "orthopaedic_cast_group_20",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is an orthopaedic cast, a rigid external immobilisation device made from plaster of Paris or synthetic casting material. It is used to immobilise suitable fractures, maintain reduction and protect injured structures. Its main components include stockinette, padding and a rigid outer casting layer. Advantages include effective immobilisation and avoidance of surgery in selected fractures. Complications include pressure sores, neurovascular compromise, compartment syndrome, skin injury and loss of fracture reduction. Proper padding, appropriate cast selection, neurovascular monitoring and patient education are essential.”"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
