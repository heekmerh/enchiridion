      "section_id": "sims_speculum_section_1",
      "section_title": "Sims’ speculum",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "sims_speculum_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sims_speculum_group_1",
              "group_title": "Sims' Vaginal Speculum",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/sims_speculum_01.webp",
                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sims_speculum_subsection_2",
          "subsection_title": "1. Introduction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sims_speculum_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Sims' vaginal speculum is a non-self-retaining vaginal retractor used to retract the vaginal wall, particularly the posterior wall, to expose the cervix and vaginal canal during gynaecological examination and procedures."
                },
                {
                  "type": "paragraph",
                  "text": "It is commonly used in gynaecology, especially when examination of the posterior vaginal wall, vaginal prolapse or the cervix requires manual retraction."
                },
                {
                  "type": "paragraph",
                  "text": "Key identifying feature: A curved, spoon-shaped blade attached to a handle. Many models are double-ended, with blades of different sizes at opposite ends."
                },
                {
                  "type": "paragraph",
                  "text": "Unlike Cusco's speculum, Sims' speculum does not usually have a locking mechanism that holds the blades apart."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sims_speculum_subsection_3",
          "subsection_title": "2. Classification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sims_speculum_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Specialty: Obstetrics and gynaecology.",
                      "level": 0
                    },
                    {
                      "text": "Function: Retractor and examination instrument.",
                      "level": 0
                    },
                    {
                      "text": "Mechanical classification: Non-self-retaining.",
                      "level": 0
                    },
                    {
                      "text": "Design: Usually a single-bladed retractor at the working end; commonly double-ended.",
                      "level": 0
                    },
                    {
                      "text": "Material: Typically stainless steel, although other designs exist.",
                      "level": 0
                    },
                    {
                      "text": "Primary action: Retraction of the vaginal wall to improve visualisation.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sims_speculum_subsection_4",
          "subsection_title": "3. Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sims_speculum_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/sims_speculum_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "healthandcare.co.uk"
                },
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Description and function"
                  ],
                  "rows": [
                    [
                      "Curved blade",
                      "Retracts the vaginal wall and provides exposure."
                    ],
                    [
                      "Blade tip",
                      "Usually rounded to minimise trauma during careful insertion."
                    ],
                    [
                      "Blade surface",
                      "Smooth surface that rests against the vaginal wall."
                    ],
                    [
                      "Shaft or neck",
                      "Connects the blade to the handle."
                    ],
                    [
                      "Handle",
                      "Allows the examiner to grip and control the instrument."
                    ],
                    [
                      "Opposite blade",
                      "On double-ended models, provides an alternative blade size or curvature."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "OSCE labelling tip: Point out the curved blade, handle and opposite blade if present. Do not label a locking screw as a standard component of Sims' speculum."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sims_speculum_subsection_5",
          "subsection_title": "4. Principle of operation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sims_speculum_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Sims' speculum works by manual retraction of the vaginal wall."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "The examiner selects an appropriate blade size.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "The instrument is introduced gently into the vagina.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "The curved blade is positioned to retract the vaginal wall, usually the posterior wall.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "The examiner maintains the instrument's position manually.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "The exposed vaginal canal and cervix are inspected, or a procedure is performed.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "The instrument is withdrawn gently while avoiding mucosal trauma.",
                      "level": 0,
                      "label": "6."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "An assistant may help maintain exposure or perform another task, depending on the procedure."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sims_speculum_subsection_6",
          "subsection_title": "5. Types and variations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sims_speculum_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
