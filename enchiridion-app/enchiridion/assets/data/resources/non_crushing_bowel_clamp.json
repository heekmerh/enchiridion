                  ]
                }
              ]
            },
            {
              "group_id": "non_crushing_bowel_clamp_group_18",
              "group_title": "Final high-yield summary",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Identification: Atraumatic clamp for temporary occlusion of the intestinal lumen."
                },
                {
                  "type": "paragraph",
                  "text": "Main parts: Handles, shanks, joint, jaws, and ratchet if present."
                },
                {
                  "type": "paragraph",
                  "text": "Principle: Controlled, distributed pressure."
                },
                {
                  "type": "paragraph",
                  "text": "Main uses: Bowel resection, transection, and anastomosis."
                },
                {
                  "type": "paragraph",
                  "text": "Major risks: Bowel injury, ischaemia, and leakage."
                },
                {
                  "type": "paragraph",
                  "text": "Key distinction: A Doyen clamp is one example of a non-crushing intestinal clamp."
                }
              ]
            }
          ]
        }
      ]
    }
