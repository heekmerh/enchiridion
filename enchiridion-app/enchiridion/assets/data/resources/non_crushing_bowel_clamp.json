      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "non_crushing_bowel_clamp_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "non_crushing_bowel_clamp_group_1",
              "group_title": "",
              "group_subtitle": null,
