                }
              ]
            }
          ]
        },
        {
          "subsection_id": "non_crushing_bowel_clamp_subsection_2",
          "subsection_title": "Introduction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "non_crushing_bowel_clamp_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A non-crushing bowel clamp is a surgical instrument used to temporarily occlude the intestinal lumen while minimizing damage to the bowel wall."
                },
                {
                  "type": "paragraph",
                  "text": "It is designed to limit the passage of intestinal contents during gastrointestinal surgery without applying the excessive pressure associated with crushing clamps."
                },
                {
                  "type": "paragraph",
                  "text": "Non-crushing bowel clamps are used in intestinal resection, bowel anastomosis, and other gastrointestinal procedures where temporary occlusion is required."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“This is a non-crushing bowel clamp, an atraumatic intestinal occlusion instrument used to temporarily control the passage of bowel contents during gastrointestinal surgery while minimizing compression injury to the intestinal wall.”"
                },
                {
                  "type": "paragraph",
                  "text": "Important distinction: The Doyen intestinal clamp covered previously is itself a type of atraumatic or non-crushing intestinal clamp. In an OSCE, the term non-crushing bowel clamp may refer to the broader category or to a particular model, so identify the exact instrument from its design."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "non_crushing_bowel_clamp_subsection_3",
          "subsection_title": "Labelling and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "non_crushing_bowel_clamp_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/non_crushing_bowel_clamp_02.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Label",
                    "Component",
                    "Function"
                  ],
                  "rows": [
                    [
                      "A",
                      "Finger rings or handles",
                      "Allow gripping and manipulation"
                    ],
                    [
                      "B",
                      "Shanks",
                      "Transmit force from the handles to the jaws"
                    ],
                    [
                      "C",
