        {
          "subsection_id": "doyen_intestinal_clamp_subsection_2",
          "subsection_title": "Introduction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "doyen_intestinal_clamp_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A Doyen intestinal clamp is a long surgical clamp designed to temporarily occlude a segment of intestine while minimizing trauma to the bowel wall."
                },
                {
                  "type": "paragraph",
                  "text": "It is an example of an atraumatic intestinal occlusion clamp. Its long, relatively broad jaws distribute pressure over the bowel to reduce the risk of crushing the intestinal tissue."
                },
                {
                  "type": "paragraph",
                  "text": "It is used in gastrointestinal surgery, particularly during bowel resection and anastomosis."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“This is a Doyen intestinal clamp, an atraumatic bowel-clamping instrument used to temporarily occlude the intestinal lumen during gastrointestinal surgery. Its long jaws are designed to minimize crushing injury to the bowel wall.”"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "doyen_intestinal_clamp_subsection_3",
          "subsection_title": "Labelling and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "doyen_intestinal_clamp_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/doyen_intestinal_clamp_03.webp",
                  "caption": null
                },
