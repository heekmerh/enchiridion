        {
          "subsection_id": "colostomy_bag_subsection_13",
          "subsection_title": "12. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "colostomy_bag_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a colostomy bag, an ostomy appliance used to collect faeces from a surgically created opening of the colon. Its components include the collection pouch, adhesive skin barrier, and, depending on the design, a coupling flange, closure and gas filter. It may be a one-piece or two-piece system and may be closed-ended or drainable. It is used following procedures such as Hartmann's procedure, abdominoperineal resection and selected loop colostomy formations. Advantages include effective faecal diversion and protection of selected distal bowel segments. Complications include leakage, peristomal dermatitis, stoma retraction, prolapse, parastomal hernia and stoma ischaemia. Proper care involves inspection of the stoma and surrounding skin, accurate measurement, correct appliance fitting and patient education.”",
                  "style": "quote"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
