      "section_id": "abg_analyser_section_1",
      "section_title": "ABG analyser",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "abg_analyser_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "abg_analyser_group_1",
              "group_title": "Arterial Blood Gas (ABG) Analyzer",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/abg_analyser_01.webp",
                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "abg_analyser_subsection_2",
          "subsection_title": "1. Identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "abg_analyser_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "An arterial blood gas (ABG) analyzer is a diagnostic laboratory or point-of-care instrument that measures blood gas parameters and acid–base status from a blood sample, usually arterial blood."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Classification: Clinical chemistry and critical-care diagnostic equipment.",
                      "level": 0
                    },
                    {
                      "text": "Principle: Uses electrochemical sensors and, depending on the model, optical or other analytical technologies to measure selected blood parameters.",
                      "level": 0
                    },
                    {
                      "text": "Key identifying features: Analyzer display, sample inlet or cartridge port, internal analytical system and printed or electronic results.",
                      "level": 0
                    },
                    {
                      "text": "Common settings: Intensive care units, emergency departments, operating theatres, neonatal units and clinical laboratories.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "OSCE distinction: The ABG syringe collects the specimen; the ABG analyzer measures its parameters and generates the results."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "abg_analyser_subsection_3",
          "subsection_title": "2. Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "abg_analyser_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Assessing acid–base disturbances.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Evaluating oxygenation and ventilation in selected patients.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Supporting assessment of respiratory failure and severe respiratory illness.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Monitoring patients receiving oxygen therapy or mechanical ventilation when ABG testing is indicated.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Assessing lactate in selected patients with suspected tissue hypoperfusion or critical illness.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Measuring additional parameters, such as electrolytes, glucose, haemoglobin or co-oximetry measurements, when the specific analyzer supports them.",
                      "level": 0,
                      "label": "6."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The exact tests available depend on the model, sensor configuration, cartridge and local laboratory validation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "abg_analyser_subsection_4",
          "subsection_title": "3. Parts and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "abg_analyser_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/abg_analyser_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A. Display and control panel"
                },
                {
                  "type": "paragraph",
                  "text": "Allows the operator to select tests, follow operating instructions, view results and identify error messages."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/abg_analyser_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "B. Sample inlet or cartridge port"
                },
                {
                  "type": "paragraph",
                  "text": "Receives the blood sample or a compatible single-use cartridge, depending on the analyzer design."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/abg_analyser_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "C. Analytical sensors"
                },
                {
                  "type": "paragraph",
                  "text": "Measure parameters such as pH, partial pressure of carbon dioxide and partial pressure of oxygen. Other sensors may measure electrolytes, glucose or lactate."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/abg_analyser_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "D. Result output system"
                },
                {
                  "type": "paragraph",
                  "text": "Displays, prints or transmits results for clinical interpretation and documentation."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/abg_analyser_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "E. Calibration and quality-control system"
                },
                {
                  "type": "paragraph",
                  "text": "Helps verify analytical accuracy through calibration, internal quality control and performance checks according to the manufacturer's instructions."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "abg_analyser_subsection_5",
          "subsection_title": "4. Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "abg_analyser_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Provides rapid results, often within minutes.",
                      "level": 0
                    },
                    {
                      "text": "Supports time-critical decisions in emergency and critical care.",
                      "level": 0
                    },
                    {
                      "text": "Measures acid–base and respiratory parameters together.",
                      "level": 0
                    },
                    {
                      "text": "Some models measure additional parameters such as lactate and electrolytes.",
                      "level": 0
                    },
                    {
                      "text": "Point-of-care models can provide results near the patient.",
                      "level": 0
                    },
                    {
                      "text": "Enables serial assessment when repeated testing is clinically justified.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "abg_analyser_subsection_6",
          "subsection_title": "5. Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "abg_analyser_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Instruments and consumables can be expensive.",
                      "level": 0
                    },
                    {
                      "text": "Results may be affected by air contamination, clots, unsuitable sample handling or delays.",
                      "level": 0
                    },
                    {
                      "text": "Calibration errors, sensor deterioration and cartridge problems can affect reliability.",
                      "level": 0
                    },
                    {
                      "text": "Not every analyzer measures the same parameters.",
                      "level": 0
                    },
                    {
                      "text": "A calculated parameter is not equivalent to a directly measured parameter.",
                      "level": 0
                    },
                    {
                      "text": "Results require clinical interpretation; an analyzer does not independently diagnose the cause of an abnormality.",
                      "level": 0
                    },
                    {
                      "text": "Some models require specialized maintenance, trained operators and reliable quality-control procedures.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "abg_analyser_subsection_7",
          "subsection_title": "6. Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "abg_analyser_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Before analyzing a sample:",
                  "items": [
                    {
                      "text": "Confirm the analyzer is suitable for the intended test and sample type.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Check the instrument’s operational status and any error messages.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Verify that calibration and quality-control requirements have been met.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Check cartridge, reagent or sensor availability and expiry where applicable.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Confirm patient identification and specimen labelling.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Inspect the sample for clots, visible air contamination or other reasons it may be unsuitable.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Follow the manufacturer's instructions for sample introduction and mixing.",
                      "level": 0,
                      "label": "7."
                    },
                    {
                      "text": "Wear appropriate personal protective equipment and follow infection-prevention procedures.",
                      "level": 0,
                      "label": "8."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important precautions"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Use only the sample types and collection devices approved for that analyzer.",
                      "level": 0
                    },
                    {
                      "text": "Do not analyze a visibly clotted or otherwise unsuitable specimen.",
                      "level": 0
                    },
                    {
                      "text": "Do not bypass calibration, quality-control locks or error messages.",
                      "level": 0
                    },
                    {
                      "text": "Verify the patient's oxygen therapy or ventilator settings when interpreting oxygenation.",
                      "level": 0
                    },
                    {
                      "text": "Handle blood and used cartridges as potentially infectious material.",
                      "level": 0
                    },
                    {
                      "text": "Escalate critical results according to local policy rather than relying solely on the printed report.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "abg_analyser_subsection_8",
          "subsection_title": "7. How to use it — step-by-step OSCE demonstration",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "abg_analyser_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The precise workflow differs between cartridge-based point-of-care analyzers and larger laboratory analyzers. Follow the model-specific instructions."
                },
                {
                  "type": "paragraph",
                  "text": "Step 1: Check the analyzer"
                },
                {
                  "type": "paragraph",
                  "text": "Confirm that the analyzer is operational and that required calibration and quality-control checks are satisfactory."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/abg_analyser_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 2: Verify the specimen"
                },
                {
                  "type": "paragraph",
                  "text": "Confirm patient identifiers, sample type and collection time. Check that the specimen is suitable for analysis."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/abg_analyser_08.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 3: Prepare the sample"
                },
                {
                  "type": "paragraph",
                  "text": "Handle and mix the sample according to the syringe and analyzer instructions. Remove air contamination using the approved procedure, and do not introduce clots into the instrument."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/abg_analyser_09.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 4: Introduce the sample"
                },
                {
                  "type": "paragraph",
                  "text": "Load the syringe or cartridge using the instrument's prescribed method. Avoid contaminating the sample inlet."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/abg_analyser_10.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 5: Run the analysis"
                },
                {
                  "type": "paragraph",
                  "text": "Select the appropriate test or patient record and allow the analyzer to complete the measurement. Respond to error messages according to the operating instructions."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/abg_analyser_11.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 6: Review the results"
                },
                {
                  "type": "paragraph",
                  "text": "Check patient identification, pH, PaCO₂, PaO₂ and other reported parameters. Review any flags, reference intervals and sample-quality warnings."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/abg_analyser_12.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 7: Report and document"
                },
                {
                  "type": "paragraph",
                  "text": "Communicate critical findings promptly, document the results and relevant oxygen or ventilator settings, and dispose of used consumables safely."
                }
              ]
            },
            {
              "group_id": "abg_analyser_group_9",
              "group_title": "Common ABG parameters and what they mean",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Parameter",
                    "Clinical significance"
                  ],
                  "rows": [
                    [
                      "pH",
                      "Indicates acidaemia or alkalaemia"
                    ],
                    [
                      "PaCO₂",
                      "Reflects the respiratory component of acid–base balance and ventilation"
                    ],
                    [
                      "PaO₂",
                      "Reflects arterial oxygenation"
                    ],
                    [
                      "HCO₃⁻",
                      "Reflects the metabolic component of acid–base balance"
                    ],
                    [
                      "Base excess",
                      "Helps assess the metabolic component of an acid–base disturbance"
                    ],
                    [
                      "Lactate",
                      "May help assess impaired tissue perfusion or other causes of elevated lactate"
                    ],
                    [
                      "Electrolytes",
                      "May help identify electrolyte disturbances when measured by the analyzer"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Some values, including bicarbonate and base excess, may be calculated rather than directly measured. Always check the analyzer's reporting conventions."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "abg_analyser_subsection_9",
          "subsection_title": "8. Contraindications and complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "abg_analyser_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The analyzer itself has no patient-level contraindication, but an unsuitable specimen must not be processed as though it were valid."
                },
                {
                  "type": "table",
                  "columns": [
                    "Problem",
                    "Potential consequence"
                  ],
                  "rows": [
                    [
                      "Air-contaminated specimen",
                      "Misleading gas measurements"
                    ],
                    [
                      "Clotted sample",
                      "Sampling failure, blocked components or unreliable results"
                    ],
                    [
                      "Incorrect sample type",
                      "Inappropriate interpretation, particularly of oxygenation"
                    ],
                    [
                      "Failed calibration or quality control",
                      "Results may be unreliable"
                    ],
                    [
                      "Expired or damaged cartridge",
                      "Analytical error or test failure"
                    ],
                    [
                      "Mislabelled specimen",
                      "Results assigned to the wrong patient"
                    ],
                    [
                      "Analyzer malfunction",
                      "Delayed or unavailable results"
                    ],
                    [
                      "Incorrect clinical interpretation",
                      "Inappropriate treatment decisions"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "If the result conflicts with the patient's clinical condition: Check patient and sample identity, oxygen settings, sample handling, analyzer flags and quality-control status. Obtain a repeat or alternative assessment when clinically indicated, without delaying urgent treatment."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "abg_analyser_subsection_10",
          "subsection_title": "9. Normal and abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "abg_analyser_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Typical adult reference values for common ABG parameters are shown below. Exact ranges vary by laboratory, age, altitude and clinical circumstances."
                },
                {
                  "type": "table",
                  "columns": [
                    "Parameter",
                    "Typical adult reference range"
                  ],
                  "rows": [
                    [
                      "pH",
                      "7.35–7.45"
                    ],
                    [
                      "PaCO₂",
                      "35–45 mmHg"
                    ],
                    [
                      "HCO₃⁻",
                      "22–26 mmol/L"
                    ],
                    [
                      "PaO₂",
                      "Approximately 80–100 mmHg in healthy adults breathing room air at sea level"
                    ],
                    [
                      "Base excess",
                      "Approximately −2 to +2 mmol/L"
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "abg_analyser_group_12",
              "group_title": "Basic interpretation examples",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Example A: Respiratory acidosis"
                },
                {
                  "type": "paragraph",
                  "text": "pH 7.25, PaCO₂ 60 mmHg, HCO₃⁻ 25 mmol/L."
                },
                {
                  "type": "paragraph",
                  "text": "The low pH with elevated PaCO₂ suggests primary respiratory acidosis. Assess the patient for inadequate ventilation and investigate the cause."
                },
                {
                  "type": "paragraph",
                  "text": "Example B: Metabolic acidosis"
                },
                {
                  "type": "paragraph",
                  "text": "pH 7.25, PaCO₂ 25 mmHg, HCO₃⁻ 12 mmol/L."
                },
                {
                  "type": "paragraph",
                  "text": "The low pH with reduced bicarbonate suggests primary metabolic acidosis, with a low PaCO₂ that may represent respiratory compensation."
                },
                {
                  "type": "paragraph",
                  "text": "Example C: Hypoxaemia"
                },
                {
                  "type": "paragraph",
                  "text": "PaO₂ is lower than expected for the patient's age and inspired oxygen concentration."
                },
                {
                  "type": "paragraph",
                  "text": "Assess the patient's respiratory status and oxygen delivery immediately. Interpret the value in context rather than using one universal PaO₂ threshold."
                },
                {
                  "type": "paragraph",
                  "text": "These are illustrative examples, not patient-specific treatment instructions. Full interpretation requires consideration of compensation, mixed disorders, oxygenation and the clinical picture."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "abg_analyser_subsection_11",
          "subsection_title": "10. Pediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "abg_analyser_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Use age-appropriate reference ranges, particularly for neonates.",
                      "level": 0
                    },
                    {
                      "text": "Minimize sample volume and unnecessary repeat testing in small infants.",
                      "level": 0
                    },
                    {
                      "text": "Confirm whether the sample is arterial, venous or capillary before interpreting it.",
                      "level": 0
                    },
                    {
                      "text": "Do not interpret a venous or capillary oxygen tension as interchangeable with arterial PaO₂.",
                      "level": 0
                    },
                    {
                      "text": "Consider the child's oxygen delivery device, inspired oxygen concentration and respiratory support.",
                      "level": 0
                    },
                    {
                      "text": "Ensure that pediatric and neonatal quality-control procedures are followed.",
                      "level": 0
                    },
                    {
                      "text": "Escalate critical results promptly and correlate them with the child's clinical condition.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "abg_analyser_subsection_12",
