  "sections": [
    {
      "section_id": "blood_collection_tubes_section_1",
      "section_title": "Blood collection tubes",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "blood_collection_tubes_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "blood_collection_tubes_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/blood_collection_tubes_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Blood collection tubes are sterile or appropriately prepared specimen containers used to collect, preserve and transport blood for laboratory investigations."
                },
                {
                  "type": "paragraph",
                  "text": "In an OSCE, one of the most frequently tested skills is identifying tube colours, matching additives to laboratory tests, and stating the correct order of draw."
                },
                {
                  "type": "paragraph",
                  "text": "Your aim is to understand why each tube is used, not merely memorize the colours."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "blood_collection_tubes_subsection_2",
          "subsection_title": "Identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "blood_collection_tubes_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Name: Blood collection tube, commonly called a Vacutainer tube."
                },
                {
                  "type": "paragraph",
                  "text": "Classification: Laboratory specimen collection container."
                },
                {
                  "type": "paragraph",
                  "text": "Principle: Blood is collected into a tube that contains a specific additive, or no additive, depending on the investigation."
                },
                {
                  "type": "paragraph",
                  "text": "Common system: Evacuated blood collection system, consisting of a collection needle, holder and vacuum tube."
                },
                {
                  "type": "paragraph",
                  "text": "The vacuum draws a specified volume of blood into the tube. The additive then helps preserve the sample or prepare it for a particular laboratory test."
                }
              ]
            },
            {
              "group_id": "blood_collection_tubes_group_3",
              "group_title": "Common blood collection tubes",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/blood_collection_tubes_02.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Purple / lavender top — EDTA (ethylenediamine tetra acetic acid)",
                    "High yield",
                    "Contains an anticoagulant that binds calcium. Commonly used for a",
                    "full blood count (FBC/CBC),",
                    "blood film and selected haematological investigations.",
                    "ESR",
                    "HbA1c"
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/blood_collection_tubes_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Light blue top — sodium citrate",
                    "Used for coagulation studies such as",
                    "PT/INR and aPTT. The tube must be filled to its specified mark to preserve the correct blood-to-anticoagulant ratio.",
                    "PTTK",
                    "D-dimer",
                    "Coagulation factor assay"
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/blood_collection_tubes_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Green top — heparin"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Commonly used for selected plasma chemistry tests, including many electrolyte investigations, depending on the laboratory's requirements."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Ammonia levels",
                    "Electrolyte levels",
                    "Arterial blood gases"
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/blood_collection_tubes_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Red top — plain or serum tube"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "May contain no additive or a clot activator, depending on the manufacturer. Used for selected serum tests."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Serum chemistry",
                    "Grouping and crossmatching",
                    "Immunology and serology",
                    "Electrolytes",
                    "LFT",
                    "Thyroid function test"
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/blood_collection_tubes_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "5. Gold / tiger top — serum separator tube (SST) – Lithium flouride"
                },
                {
                  "type": "paragraph",
                  "text": "Typically contains a clot activator and separation gel. Used for many chemistry and serology tests requiring serum."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Serum chemistry",
                    "Endocrine studies",
                    "Serology test",
                    "Basic metabolic panel",
                    "Lipid panel",
                    "Hormone levels"
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/blood_collection_tubes_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "6. Grey top — fluoride-based tube ( sodium fluoride + potassium oxalate)"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Commonly used for",
                    "glucose testing because the additive helps limit glycolysis.",
                    "Lactate levels"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Exact formulations vary by manufacturer."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/blood_collection_tubes_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "7. Blood culture bottles"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Special culture bottles contain media that support the detection of microorganisms in blood. Bottle design and cap colours vary, so identify them by their labels and intended use rather than colour alone."
                },
                {
                  "type": "paragraph",
                  "text": "Important: Tube colours are not completely universal. Always check the tube label, additive, manufacturer's instructions and your laboratory's specimen collection guide."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "blood_collection_tubes_subsection_3",
          "subsection_title": "Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "blood_collection_tubes_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Blood collection tubes are selected according to the investigation requested."
                },
                {
                  "type": "table",
                  "columns": [
                    "Investigation",
                    "Common tube",
                    "Specimen"
                  ],
                  "rows": [
                    [
                      "Full blood count (FBC/CBC)",
                      "Purple — EDTA",
                      "Whole blood"
                    ],
                    [
                      "Peripheral blood film",
                      "Purple — EDTA, or a fresh film prepared as specified",
                      "Whole blood"
                    ],
                    [
                      "PT/INR",
                      "Light blue — citrate",
                      "Citrated plasma"
                    ],
                    [
                      "aPTT",
                      "Light blue — citrate",
                      "Citrated plasma"
                    ],
                    [
                      "Urea, electrolytes and creatinine",
                      "Green — heparin, or another locally approved tube",
                      "Usually plasma or serum"
                    ],
                    [
                      "Liver function tests",
                      "Gold/SST or another approved serum/plasma tube",
                      "Serum or plasma"
                    ],
                    [
                      "Lipid profile",
                      "Gold/SST or another approved tube",
                      "Serum or plasma"
                    ],
                    [
                      "Glucose",
                      "Grey — fluoride-based, or an approved alternative",
                      "Plasma"
                    ],
                    [
                      "Blood culture",
                      "Blood culture bottles",
                      "Blood for microbiological culture"
                    ],
                    [
                      "Blood grouping and crossmatching",
                      "Locally approved blood bank tube",
                      "Whole blood"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These are common examples, not universal rules. Some laboratories use different tube types for particular tests."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "blood_collection_tubes_subsection_4",
          "subsection_title": "Parts and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "blood_collection_tubes_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/blood_collection_tubes_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Stopper or cap"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Seals the tube, identifies its additive by colour in many systems, and helps prevent leakage or contamination."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/blood_collection_tubes_10.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Tube body"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Holds the specimen and provides the required collection volume."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/blood_collection_tubes_11.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Additive"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Prevents clotting, activates clot formation, inhibits glycolysis or separates serum and plasma, depending on the tube."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/blood_collection_tubes_12.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Label and identification area"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Allows patient identification, collection time, specimen details and laboratory tracking information to be recorded."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "blood_collection_tubes_subsection_5",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "blood_collection_tubes_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Enables standardized specimen collection."
                },
                {
                  "type": "paragraph",
                  "text": "Additives preserve specimens for particular investigations."
                },
                {
                  "type": "paragraph",
                  "text": "Vacuum tubes help collect a specified volume."
                },
                {
                  "type": "paragraph",
                  "text": "Colour coding makes tube selection quicker."
                },
                {
                  "type": "paragraph",
                  "text": "Supports collection of several specimens during one venepuncture."
                },
                {
                  "type": "paragraph",
                  "text": "Closed collection systems can reduce exposure to blood when used correctly."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "blood_collection_tubes_subsection_6",
          "subsection_title": "Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "blood_collection_tubes_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Incorrect tube selection can invalidate a test."
                },
                {
                  "type": "paragraph",
                  "text": "Underfilling or overfilling may affect results."
                },
                {
                  "type": "paragraph",
                  "text": "Contamination between additives can cause misleading laboratory values."
                },
                {
                  "type": "paragraph",
                  "text": "Haemolysis can interfere with selected biochemical investigations."
                },
                {
                  "type": "paragraph",
                  "text": "Incorrect mixing may result in clotting or other specimen problems."
                },
                {
                  "type": "paragraph",
                  "text": "Samples may deteriorate if transported or processed incorrectly."
                },
                {
                  "type": "paragraph",
                  "text": "Colour coding varies between manufacturers and laboratories."
                },
                {
                  "type": "paragraph",
                  "text": "High-yield example: EDTA contamination of a chemistry specimen can cause falsely increased potassium and decreased calcium. This may mimic a serious electrolyte disorder."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "blood_collection_tubes_subsection_7",
          "subsection_title": "Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "blood_collection_tubes_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Before collecting blood, you should:"
                },
                {
                  "type": "paragraph",
                  "text": "Verify the investigation requested and the patient's identity."
                },
                {
                  "type": "paragraph",
                  "text": "Explain the procedure and obtain consent."
                },
                {
                  "type": "paragraph",
                  "text": "Perform hand hygiene and wear appropriate PPE."
                },
                {
                  "type": "paragraph",
                  "text": "Prepare the correct tubes, needle, holder and other equipment."
                },
                {
                  "type": "paragraph",
                  "text": "Check tube expiry, integrity and appropriate fill volume."
                },
                {
                  "type": "paragraph",
                  "text": "Apply the tourniquet and select a suitable vein."
                },
                {
                  "type": "paragraph",
                  "text": "Clean the collection site according to local protocol and allow it to dry."
                },
                {
                  "type": "paragraph",
                  "text": "Collect tubes in the appropriate order of draw."
                },
                {
                  "type": "paragraph",
                  "text": "Gently invert additive-containing tubes according to manufacturer instructions; do not shake vigorously."
                },
                {
                  "type": "paragraph",
                  "text": "Release the tourniquet at the appropriate stage of collection."
                },
                {
                  "type": "paragraph",
                  "text": "Label specimens accurately at the point of collection, following local policy."
                },
                {
                  "type": "paragraph",
                  "text": "Dispose of sharps immediately and transport specimens according to laboratory requirements."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "blood_collection_tubes_subsection_8",
          "subsection_title": "How to collect blood using collection tubes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "blood_collection_tubes_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Step 1 — Verify and prepare"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Match the laboratory request to the patient. Select the correct tubes and check the labels, additives and expiry dates."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 2 — Select the vein"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Apply a tourniquet appropriately, identify a suitable vein and prepare the site using the required infection-control technique."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/blood_collection_tubes_13.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 3 — Collect the sample"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Insert the needle using appropriate venepuncture technique and attach the tubes to the holder in the correct order. Allow each tube to fill to its intended volume."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/blood_collection_tubes_14.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 4 — Mix where required"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Gently invert additive-containing tubes according to the manufacturer's instructions. Do not shake, and do not assume every tube requires the same number of inversions."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 5 — Label and transport"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Confirm patient identifiers, collection details and specimen requirements. Send the samples promptly under the appropriate transport conditions."
                }
              ]
            },
            {
              "group_id": "blood_collection_tubes_group_10",
              "group_title": "Order of draw — a high-yield OSCE topic",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "For a typical evacuated venous blood collection system, the commonly taught order is:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Blood culture bottles",
                    "Light blue — citrate",
                    "Red — serum tube",
                    "Gold — serum separator",
                    "Green — heparin",
                    "Purple — EDTA",
                    "Grey — fluoride-based"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "This is a common reference sequence; exact placement of additional tube types depends on the local laboratory's protocol. For example, some specialized tubes have specific collection requirements."
                },
                {
                  "type": "paragraph",
                  "text": "Why is order of draw important? It reduces the risk of carryover of additives from one tube into another, which could alter test results."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "blood_collection_tubes_subsection_9",
          "subsection_title": "Contraindications and complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "blood_collection_tubes_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Blood collection tubes themselves have few direct contraindications, but venepuncture requires assessment of the patient and collection site."
                }
              ]
            },
            {
              "group_id": "blood_collection_tubes_group_12",
              "group_title": "Common collection problems",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Problem",
                    "Consequence"
                  ],
                  "rows": [
                    [
                      "Haemolysis",
                      "Can interfere with potassium, LDH and other test results"
                    ],
                    [
                      "Clotted EDTA sample",
                      "May make the FBC unreliable or unsuitable"
                    ],
                    [
                      "Underfilled citrate tube",
                      "Incorrect blood-to-anticoagulant ratio can distort coagulation results"
                    ],
                    [
                      "Wrong tube",
                      "Additive may interfere with the requested investigation"
                    ],
                    [
                      "Mislabelled sample",
                      "Results may be assigned to the wrong patient"
                    ],
                    [
                      "Contaminated specimen",
                      "May produce misleading results"
                    ],
                    [
                      "Delayed processing",
                      "Some analytes change over time"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "If a sample is unsuitable, follow laboratory policy regarding rejection, recollection and urgent communication. Do not relabel a specimen based on an assumption about its identity."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "blood_collection_tubes_subsection_10",
          "subsection_title": "Normal and abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "blood_collection_tubes_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Blood collection tubes are used to obtain specimens; they do not independently determine whether a patient is healthy."
                },
                {
                  "type": "paragraph",
                  "text": "During an OSCE, assess whether the specimen is suitable for analysis."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Acceptable specimen"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Correct patient identification, appropriate tube, adequate fill, correct mixing where required, no obvious leakage and proper transport."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Potentially unsuitable specimen"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Incorrect tube, clotting in an anticoagulated sample, marked haemolysis, insufficient volume, leakage, missing identifiers or incorrect blood-to-additive ratio."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "blood_collection_tubes_subsection_11",
          "subsection_title": "Pediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "blood_collection_tubes_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Small blood volumes: Select pediatric tubes or microcollection containers when appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Blood conservation: Avoid unnecessary repeated sampling, especially in neonates and critically ill children."
                },
                {
                  "type": "paragraph",
                  "text": "Weight and age: Consider the child's size and physiological reserve when planning investigations."
                },
                {
                  "type": "paragraph",
                  "text": "Pain reduction: Use age-appropriate comfort measures, distraction and caregiver support."
                },
                {
                  "type": "paragraph",
                  "text": "Correct identification: Confirm the child's identity using the approved identification process, including neonatal identification procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Microcollection: Capillary specimens may be appropriate for selected tests, but not every test can be performed reliably using capillary blood."
                },
                {
                  "type": "paragraph",
                  "text": "Order of draw: Follow the microcollection device manufacturer's and laboratory's specified sequence, which may differ from the standard venous order."
                },
                {
                  "type": "paragraph",
                  "text": "Sample volume: Underfilling a tube may be particularly problematic for coagulation studies and other tests with strict specimen requirements."
                },
                {
                  "type": "paragraph",
                  "text": "High-yield pediatric point: The volume of blood collected must be clinically justified, particularly in neonates, because repeated or excessive sampling can contribute to iatrogenic anaemia."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "blood_collection_tubes_subsection_12",
          "subsection_title": "Mnemonics and memory aids",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "blood_collection_tubes_group_15",
              "group_title": "Mnemonic: “Blue, Red, Green, Purple, Grey”",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "For rapid recall of commonly tested tube uses:"
                },
                {
                  "type": "paragraph",
                  "text": "Blue — coagulation."
                },
                {
                  "type": "paragraph",
                  "text": "Red — serum."
                },
                {
                  "type": "paragraph",
                  "text": "Green — heparin plasma."
                },
                {
                  "type": "paragraph",
                  "text": "Purple — haematology."
                },
                {
                  "type": "paragraph",
                  "text": "Grey — glucose."
                },
                {
                  "type": "paragraph",
                  "text": "Add these two essential reminders:"
                },
                {
                  "type": "paragraph",
                  "text": "Gold — serum separator."
                },
                {
                  "type": "paragraph",
                  "text": "Blood culture bottles — microbiology."
                }
              ]
            },
            {
              "group_id": "blood_collection_tubes_group_16",
              "group_title": "Order-of-draw mnemonic",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A commonly taught abbreviated sequence is:"
                },
                {
                  "type": "paragraph",
                  "text": "Cultures → Citrate → Serum → Heparin → EDTA → Fluoride"
                },
                {
                  "type": "paragraph",
                  "text": "Remember that serum tubes may include plain red and serum separator tubes, and local protocols determine the handling of additional specialty tubes."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "blood_collection_tubes_subsection_13",
          "subsection_title": "Common OSCE questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "blood_collection_tubes_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. Which tube is used for a full blood count?"
                },
                {
                  "type": "paragraph",
                  "text": "A purple or lavender-top EDTA tube is commonly used."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Which tube is used for PT/INR?"
                },
                {
                  "type": "paragraph",
                  "text": "A light blue-top tube containing sodium citrate, filled to its specified volume."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Why must a citrate tube be filled correctly?"
                },
                {
                  "type": "paragraph",
                  "text": "The blood-to-anticoagulant ratio is important for reliable coagulation testing. Underfilling can produce inaccurate results."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Which tube is commonly used for glucose?"
                },
                {
                  "type": "paragraph",
                  "text": "A grey-top fluoride-based tube is a common option, although approved alternatives are available in some laboratories."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What is the purpose of EDTA?"
                },
                {
                  "type": "paragraph",
                  "text": "EDTA binds calcium and prevents clotting, preserving blood cells for many haematological investigations."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Why should blood collection tubes not be shaken vigorously?"
                },
                {
                  "type": "paragraph",
                  "text": "Vigorous shaking can cause haemolysis or other specimen damage. Tubes containing additives should be gently inverted as instructed."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What is haemolysis?"
                },
                {
                  "type": "paragraph",
                  "text": "The breakdown of red blood cells, releasing intracellular contents into the surrounding specimen. It can interfere with several laboratory measurements."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. Why are blood cultures collected before many other tubes?"
                },
                {
                  "type": "paragraph",
                  "text": "They are collected first in the standard order to reduce contamination from additives or other collection components, while maintaining the required culture collection technique."
                },
                {
                  "type": "paragraph",
                  "text": "Q9. What is the purpose of the gold-top tube's gel?"
                },
                {
                  "type": "paragraph",
                  "text": "It forms a barrier between serum and the cellular components after centrifugation, depending on the tube design."
                },
                {
                  "type": "paragraph",
                  "text": "Q10. What would you do if you discovered that a sample was mislabelled?"
                },
                {
                  "type": "paragraph",
                  "text": "I would follow the laboratory's specimen identification and rejection policy, communicate with the relevant clinical team and arrange recollection if required. I would not guess or independently alter the patient's identity."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "blood_collection_tubes_subsection_14",
          "subsection_title": "Common mistakes and examiner tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "blood_collection_tubes_group_18",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Memorizing cap colours without learning the additives."
                },
                {
                  "type": "paragraph",
                  "text": "Confusing serum with plasma."
                },
                {
                  "type": "paragraph",
                  "text": "Underfilling citrate tubes."
                },
                {
                  "type": "paragraph",
                  "text": "Shaking tubes vigorously."
                },
                {
                  "type": "paragraph",
                  "text": "Using the wrong tube for a requested test."
                },
                {
                  "type": "paragraph",
                  "text": "Forgetting that tube colours vary between manufacturers."
                },
                {
                  "type": "paragraph",
                  "text": "Failing to label the specimen correctly."
                },
                {
                  "type": "paragraph",
                  "text": "Ignoring haemolysis or clotting."
                },
                {
                  "type": "paragraph",
                  "text": "Applying the standard venous order of draw indiscriminately to every microcollection system."
                },
                {
                  "type": "paragraph",
                  "text": "Forgetting the importance of pediatric blood conservation."
                },
                {
                  "type": "paragraph",
                  "text": "Examiner tip: When shown a tube, state three things in order: its colour, its additive and its common use. For example: “Purple-top tube, containing EDTA, used for a full blood count.”"
                }
              ]
            }
          ]
        },
        {
