                },
                {
                  "type": "paragraph",
                  "text": "States pre-use inspection requirements"
                },
                {
                  "type": "paragraph",
                  "text": "Explains appropriate cleaning and sterilization"
                }
              ]
            },
            {
              "group_id": "mallet_group_17",
              "group_title": "Final high-yield summary",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Identification: Hand-held instrument used to deliver controlled impact.",
                      "level": 0
                    },
                    {
                      "text": "Main parts: Head, striking face, neck, and handle.",
                      "level": 0
                    },
                    {
                      "text": "Principle: Transfer of kinetic energy through impact.",
                      "level": 0
                    },
                    {
                      "text": "Main uses: Driving osteotomes, chisels, and compatible punches; selected bone-shaping and impaction procedures.",
                      "level": 0
                    },
                    {
                      "text": "Major risks: Unintended fracture, soft-tissue injury, and damage to instruments.",
                      "level": 0
                    },
                    {
                      "text": "Safety priority: Inspect the mallet and use controlled blows with compatible instruments.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
