        {
          "subsection_id": "retractor_subsection_13",
          "subsection_title": "12. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "retractor_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a surgical retractor, an instrument used to retract tissues and wound edges to improve visibility and access to the operative field. It may be handheld or self-retaining. Its working end may consist of a flat blade, curved blade, hook or prongs, depending on the type. Examples include Langenbeck, Volkmann, Deaver and Balfour retractors. They are used across general surgery, orthopaedics and other specialties. Complications of improper use include tissue trauma, pressure ischaemia and nerve or vascular injury. Before use, I would inspect the working end, joints and locking mechanism where present, as well as cleanliness and sterility.”",
                  "style": "quote"
                }
              ]
            }
          ]
