        {
          "subsection_id": "retractor_subsection_2",
          "subsection_title": "1. Introduction and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "retractor_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A retractor is a surgical instrument used to hold back tissues, organs or wound edges to improve visibility and provide access to the operative field."
                },
                {
                  "type": "paragraph",
                  "text": "Retractors are essential in general surgery, orthopaedics, gynaecology, neurosurgery, cardiothoracic surgery and many other specialties."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification card"
                },
                {
                  "type": "paragraph",
                  "text": "Name: Surgical retractor"
                },
                {
                  "type": "paragraph",
                  "text": "Classification: Retraction and exposure instrument"
                },
                {
                  "type": "paragraph",
                  "text": "Primary function: Retracting tissues and maintaining surgical exposure."
                },
                {
                  "type": "paragraph",
                  "text": "Characteristic feature: A blade, hook or other working end designed to hold tissue away from the operative site."
                },
                {
                  "type": "paragraph",
                  "text": "Mechanism: Handheld or self-retaining."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE principle: A retractor generally does not cut, clamp blood vessels or hold a suture needle. Its primary role is to maintain exposure by moving tissue away from the surgeon's working area."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "retractor_subsection_3",
          "subsection_title": "2. Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "retractor_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/retractor_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "quizlet.com"
                },
                {
                  "type": "paragraph",
                  "text": "The precise parts depend on the type of retractor, but a typical handheld retractor has the following components."
                },
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Description and function"
                  ],
                  "rows": [
                    [
                      "Handle",
                      "Allows the operator to hold and manipulate the instrument."
                    ],
                    [
                      "Shaft or neck",
                      "Connects the handle to the working end."
                    ],
                    [
                      "Blade",
                      "Broad working surface that retracts tissue."
                    ],
                    [
                      "Tip or lip",
                      "The end that engages or supports the tissue."
                    ],
                    [
                      "Curvature",
                      "Helps the blade follow the required anatomical contour."
                    ],
                    [
                      "Prongs or teeth, if present",
                      "Engage tissue to improve the grip."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Self-retaining retractors may additionally have a ratchet, locking mechanism, adjustable arms, blades and a frame or spreader."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "retractor_subsection_4",
          "subsection_title": "3. Classification of retractors",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "retractor_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The main classification is based on the mechanism of action."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/retractor_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A. Handheld retractors"
                },
                {
                  "type": "paragraph",
                  "text": "Must be held by the surgeon or an assistant to maintain retraction. Examples include Langenbeck, Deaver and Richardson retractors."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/retractor_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "B. Self-retaining retractors"
                },
                {
                  "type": "paragraph",
                  "text": "Use a locking or spreading mechanism to maintain retraction without continuous manual holding. Examples include Balfour and Weitlaner retractors."
                }
              ]
            },
            {
              "group_id": "retractor_group_5",
              "group_title": "Other ways to classify retractors",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Classification",
                    "Types or examples"
                  ],
                  "rows": [
                    [
                      "By working end",
                      "Flat-bladed, curved, hooked, toothed or fenestrated"
                    ],
                    [
                      "By operative depth",
                      "Superficial or deep"
                    ],
                    [
                      "By surgical specialty",
                      "Abdominal, orthopaedic, thoracic, neurosurgical or gynaecological"
                    ],
                    [
                      "By function",
                      "Skin-edge, muscle, organ or cavity retraction"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These categories overlap. For example, a Deaver retractor is handheld, curved and commonly used for deep abdominal retraction."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "retractor_subsection_5",
          "subsection_title": "4. Common retractors you must recognize",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "retractor_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/retractor_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Langenbeck retractor"
                },
                {
                  "type": "paragraph",
                  "text": "Has a broad, angled blade and is commonly used for retracting superficial or moderately deep wound edges."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/retractor_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Volkmann retractor"
                },
                {
                  "type": "paragraph",
                  "text": "A rake-like retractor with several prongs, used to retract skin and superficial tissues."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/retractor_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Deaver retractor"
                },
                {
                  "type": "paragraph",
                  "text": "A long, curved, broad-bladed retractor designed for deep abdominal or cavity retraction."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/retractor_08.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Weitlaner retractor"
                },
                {
                  "type": "paragraph",
                  "text": "A self-retaining, rake-like retractor with opposing pronged blades, often used for superficial or moderately deep exposure."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/retractor_09.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Balfour retractor"
                },
                {
                  "type": "paragraph",
                  "text": "A self-retaining abdominal retractor with a frame and adjustable blades for maintaining exposure during laparotomy."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "retractor_subsection_6",
          "subsection_title": "5. Uses and clinical applications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "retractor_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Application",
                    "Purpose"
                  ],
                  "rows": [
                    [
                      "Wound exposure",
                      "Holds incision edges apart."
                    ],
                    [
                      "Abdominal surgery",
                      "Retracts abdominal wall, bowel or other structures as appropriate."
                    ],
                    [
                      "Orthopaedic surgery",
                      "Provides access to bone, joints and surrounding structures."
                    ],
                    [
                      "Plastic surgery",
                      "Maintains exposure during precise tissue dissection and reconstruction."
                    ],
                    [
                      "Gynaecological surgery",
                      "Retracts tissues to expose the operative field."
                    ],
                    [
                      "Thoracic surgery",
                      "Helps maintain exposure within the chest during selected procedures."
                    ],
                    [
                      "Deep cavity surgery",
                      "Provides access to structures that would otherwise be obscured by overlying tissue."
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "retractor_subsection_7",
          "subsection_title": "6. Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "retractor_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Improves visibility of the operative field.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Provides access to deeper anatomical structures.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Helps maintain separation of tissue planes.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Reduces the need to use fingers to hold tissue continuously.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Self-retaining types free the surgeon's and assistant's hands.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Different blade shapes and sizes permit retraction of different tissues and cavities.",
                      "level": 0,
                      "label": "6."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "retractor_subsection_8",
          "subsection_title": "7. Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "retractor_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Excessive pressure can cause tissue injury.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Handheld retractors require an assistant or operator to maintain position.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Self-retaining devices may exert sustained pressure if incorrectly positioned.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Bulky retractors can obstruct access in confined spaces.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Incorrect blade selection may damage tissue or provide inadequate exposure.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Some designs require careful positioning to prevent slipping.",
                      "level": 0,
                      "label": "6."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "retractor_subsection_9",
          "subsection_title": "8. Complications of improper use",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "retractor_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Mechanism",
                    "Prevention"
                  ],
                  "rows": [
                    [
                      "Tissue bruising or tearing",
                      "Excessive force or incorrect blade placement",
                      "Apply controlled retraction."
                    ],
                    [
                      "Ischaemia or pressure necrosis",
                      "Sustained pressure on tissue",
                      "Avoid excessive tension and prolonged focal pressure."
                    ],
                    [
                      "Nerve injury",
                      "Compression or stretching of nerves",
                      "Identify vulnerable structures and position blades carefully."
                    ],
                    [
                      "Vascular injury",
                      "Compression, traction or direct trauma",
                      "Use appropriate blade placement and force."
                    ],
                    [
                      "Muscle injury",
                      "Excessive stretching or pressure",
                      "Use an appropriately sized retractor."
                    ],
                    [
                      "Poor exposure",
                      "Wrong blade shape or inadequate positioning",
                      "Select the retractor suited to the operative depth and anatomy."
                    ],
                    [
                      "Instrument slippage",
                      "Poor positioning or excessive traction",
                      "Maintain secure placement and inspect the instrument."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "High-yield point: Retractors improve exposure but can injure tissues when excessive force is applied. The aim is adequate exposure with the least force necessary."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "retractor_subsection_10",
          "subsection_title": "9. Principles of proper handling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "retractor_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Select the correct retractor"
                },
                {
                  "type": "paragraph",
                  "text": "Match the blade shape, width and depth to the tissue and operative site."
                },
                {
                  "type": "paragraph",
                  "text": "Position under direct vision"
                },
                {
                  "type": "paragraph",
                  "text": "Avoid trapping nerves, vessels or other vulnerable structures beneath the blade."
                },
                {
                  "type": "paragraph",
                  "text": "Apply controlled traction"
                },
                {
                  "type": "paragraph",
                  "text": "Use only the amount of force required for adequate exposure."
                },
                {
                  "type": "paragraph",
                  "text": "Reassess and release when appropriate"
                },
                {
                  "type": "paragraph",
                  "text": "Check tissue tension and perfusion during prolonged retraction. Reposition if necessary."
                }
              ]
            }
          ]
        },
