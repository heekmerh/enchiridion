        {
          "subsection_id": "sigmoidoscope_subsection_2",
          "subsection_title": "1. Introduction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sigmoidoscope_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A sigmoidoscope is an endoscopic instrument used to examine the rectum and sigmoid colon, the distal part of the large intestine."
                },
                {
                  "type": "paragraph",
                  "text": "It is used in colorectal surgery, gastroenterology and diagnostic medicine to investigate rectal bleeding, altered bowel habits, suspected distal colonic lesions and inflammatory bowel disease."
                },
                {
                  "type": "list",
                  "title": "The two main types are:",
                  "items": [
                    {
                      "text": "Flexible sigmoidoscope: A flexible endoscope with a camera, illumination and channels for irrigation, suction and compatible instruments.",
                      "level": 0
                    },
                    {
                      "text": "Rigid sigmoidoscope: A rigid tube used for direct examination of the rectum and, in suitable circumstances, the distal sigmoid colon.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Key OSCE distinction: A sigmoidoscope examines farther into the bowel than a standard anoscope or proctoscope. It does not examine the entire colon, unlike a complete colonoscopy."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "sigmoidoscope_subsection_3",
          "subsection_title": "2. Classification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sigmoidoscope_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Specialty: Gastroenterology and colorectal surgery.",
                      "level": 0
                    },
                    {
                      "text": "Function: Diagnostic and therapeutic endoscopy.",
                      "level": 0
                    },
                    {
                      "text": "Design: Rigid or flexible.",
                      "level": 0
                    },
                    {
                      "text": "Viewing system: Direct optical viewing in some rigid systems; camera-based video imaging in flexible systems.",
                      "level": 0
                    },
                    {
                      "text": "Accessories: Light source, irrigation and suction systems, biopsy forceps and other compatible accessories.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
