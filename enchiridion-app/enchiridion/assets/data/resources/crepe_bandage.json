      "section_id": "crepe_bandage_section_1",
      "section_title": "Crepe bandage",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "crepe_bandage_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "crepe_bandage_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
