                }
              ]
            }
          ]
        },
        {
          "subsection_id": "crepe_bandage_subsection_15",
          "subsection_title": "Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "crepe_bandage_group_19",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a crepe bandage, a woven, stretchable bandage used for support, light compression and retention of wound dressings. It is available in different widths and degrees of elasticity. Its advantages include low cost, flexibility, ease of application and removal, and conformity to body contours. Its disadvantages include variable compression, loosening during movement and the risk of neurovascular compromise if applied too tightly. Complications include pressure sores, skin irritation and nerve compression. Safe application requires assessment of distal neurovascular status, even overlap, avoidance of excessive tension and reassessment after application.”"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}