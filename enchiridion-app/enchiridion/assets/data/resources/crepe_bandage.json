                }
              ]
            }
          ]
        },
        {
          "subsection_id": "crepe_bandage_subsection_2",
          "subsection_title": "Introduction and definition",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "crepe_bandage_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A crepe bandage is a woven, stretchable bandage, commonly made from cotton or a cotton blend, used to provide support, light compression and retention of wound dressings."
                },
                {
                  "type": "paragraph",
                  "text": "It is frequently used in emergency medicine, orthopaedics, sports medicine, first aid and general wound care."
                },
                {
                  "type": "paragraph",
                  "text": "Key identifying feature: A soft, woven, usually beige or white bandage with a slightly crinkled texture that stretches when applied."
                },
                {
                  "type": "paragraph",
                  "text": "A crepe bandage is not the same as a Plaster of Paris bandage. A crepe bandage remains flexible after application, whereas POP hardens to form a rigid structure."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "crepe_bandage_subsection_3",
          "subsection_title": "Identification in an OSCE station",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "crepe_bandage_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/crepe_bandage_01.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Model identification"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "“This is a crepe bandage, a stretchable woven bandage used to provide support, light compression and secure dressings.”"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Key properties"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Flexible and stretchable."
                },
                {
                  "type": "paragraph",
                  "text": "Conforms to body contours."
                },
                {
                  "type": "paragraph",
                  "text": "Reusable if designed and permitted for reuse."
                },
                {
                  "type": "paragraph",
                  "text": "Does not harden."
                },
                {
                  "type": "paragraph",
                  "text": "Provides variable compression depending on application technique."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "crepe_bandage_subsection_4",
          "subsection_title": "Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "crepe_bandage_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A conventional crepe bandage is a simple device without complex mechanical components."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/crepe_bandage_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Bandage roll"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The rolled length of fabric, which is unwound during application."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/crepe_bandage_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Woven fabric"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The crimped or textured fabric provides stretch and conformity."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/crepe_bandage_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Fixation clips or fastening system, if supplied"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Secure the end of the bandage and prevent unwinding. Some products use cohesive fastening instead."
                },
                {
                  "type": "paragraph",
                  "text": "The packaging may indicate width, length, composition, washing instructions, manufacturer and whether the bandage is intended for single or repeated use."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "crepe_bandage_subsection_5",
          "subsection_title": "Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "crepe_bandage_group_5",
              "group_title": "A. According to width",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Common widths include approximately 5 cm, 7.5 cm, 10 cm, 15 cm and 20 cm."
                },
                {
                  "type": "table",
                  "columns": [
                    "Width",
                    "Typical application"
                  ],
                  "rows": [
                    [
                      "5 cm",
                      "Fingers and small areas"
                    ],
                    [
                      "7.5 cm",
                      "Wrist and smaller limbs"
                    ],
                    [
                      "10 cm",
                      "Forearm, ankle or similar areas"
                    ],
                    [
                      "15 cm",
                      "Larger limbs and thighs"
                    ],
                    [
                      "20 cm",
                      "Selected broad body areas"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These are illustrative sizes. Select the width according to the body part, bandage design and clinical purpose."
                }
              ]
            },
            {
              "group_id": "crepe_bandage_group_6",
              "group_title": "B. According to construction",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/crepe_bandage_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Standard crepe bandage"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Provides support, light compression and dressing retention. It is not designed to provide the same controlled compression as a purpose-made medical compression system."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/crepe_bandage_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Elasticated crepe bandage"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Contains elastic fibres or an elastic construction to provide greater stretch and recoil."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/crepe_bandage_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Cohesive bandage"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Adheres to itself without necessarily sticking to the skin. It is a related support-bandage type, but not all cohesive bandages are technically crepe bandages."
                }
              ]
            },
            {
              "group_id": "crepe_bandage_group_7",
              "group_title": "C. According to clinical function",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Support bandage."
                },
                {
                  "type": "paragraph",
                  "text": "Dressing-retention bandage."
                },
                {
                  "type": "paragraph",
                  "text": "Light compression bandage."
                },
                {
                  "type": "paragraph",
                  "text": "Temporary support for selected soft-tissue injuries."
                },
                {
                  "type": "paragraph",
                  "text": "Exam point: A conventional crepe bandage should not automatically be described as a high-compression bandage."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "crepe_bandage_subsection_6",
          "subsection_title": "Indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "crepe_bandage_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Crepe bandages are used for:"
                },
                {
                  "type": "paragraph",
                  "text": "Supporting selected sprains and strains."
                },
                {
                  "type": "paragraph",
                  "text": "Providing light compression for selected soft-tissue injuries."
                },
                {
                  "type": "paragraph",
                  "text": "Securing wound dressings."
                },
                {
                  "type": "paragraph",
                  "text": "Supporting joints during recovery."
                },
                {
                  "type": "paragraph",
                  "text": "Holding padding or a suitable splint in place."
                },
                {
                  "type": "paragraph",
                  "text": "Providing temporary support for selected muscle injuries."
                },
                {
                  "type": "paragraph",
                  "text": "Managing some cases of swelling when compression is clinically appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Securing cold packs briefly during first aid, provided skin and circulation are protected and the pack is not tightly compressed."
                }
              ]
            },
            {
              "group_id": "crepe_bandage_group_9",
              "group_title": "Common clinical examples",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Ankle sprains."
                },
                {
                  "type": "paragraph",
                  "text": "Wrist sprains."
                },
                {
                  "type": "paragraph",
                  "text": "Minor soft-tissue injuries."
                },
                {
                  "type": "paragraph",
                  "text": "Securing a dressing after wound treatment."
                },
                {
                  "type": "paragraph",
                  "text": "Supporting a limb after selected orthopaedic procedures."
                },
                {
                  "type": "paragraph",
                  "text": "A crepe bandage alone does not provide reliable rigid immobilisation for an unstable fracture."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "crepe_bandage_subsection_7",
          "subsection_title": "Principles of application",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "crepe_bandage_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The aim is to provide appropriate support or compression without compromising circulation, sensation or skin integrity."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 1 — Assess the limb"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the skin, identify wounds and assess distal circulation, sensation and movement. Check whether compression is appropriate for the patient."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 2 — Position the limb"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Place the limb in a comfortable, appropriate position. Apply any required dressing or protective padding first."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 3 — Begin distally where appropriate"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "For limb support or compression, start near the distal part and progress proximally, using even tension and overlap. The exact technique depends on the indication and anatomical site."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 4 — Apply evenly"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Use overlapping turns, commonly covering about half the width of the preceding layer. Avoid wrinkles, bunching and focal pressure."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 5 — Secure and reassess"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Secure the end without creating a tight constricting point. Recheck distal circulation, sensation, movement and comfort."
                }
              ]
            },
            {
              "group_id": "crepe_bandage_group_11",
              "group_title": "Important application principles",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Do not apply excessive tension."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid tight circumferential turns, particularly around a swollen limb."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure that the bandage does not bunch over bony prominences."
                },
                {
                  "type": "paragraph",
                  "text": "Leave digits visible when appropriate so circulation can be monitored."
                },
                {
                  "type": "paragraph",
                  "text": "Remove or loosen the bandage promptly if new pain, numbness, tingling, pallor, cyanosis or coldness develops, and obtain appropriate assessment."
                },
                {
                  "type": "paragraph",
                  "text": "Do not use a crepe bandage as a substitute for urgent evaluation of a suspected fracture, compartment syndrome or vascular injury."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "crepe_bandage_subsection_8",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "crepe_bandage_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Inexpensive and widely available."
                },
                {
                  "type": "paragraph",
                  "text": "Easy to apply and remove."
                },
                {
                  "type": "paragraph",
                  "text": "Flexible and conformable."
                },
                {
                  "type": "paragraph",
                  "text": "Useful for securing dressings."
                },
                {
                  "type": "paragraph",
                  "text": "Provides adjustable light support."
                },
                {
                  "type": "paragraph",
                  "text": "Allows inspection of the skin when removed."
                },
                {
                  "type": "paragraph",
                  "text": "Does not require water or a chemical setting process."
                },
                {
                  "type": "paragraph",
                  "text": "Some varieties can be washed and reused according to their instructions."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "crepe_bandage_subsection_9",
          "subsection_title": "Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "crepe_bandage_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Does not provide rigid immobilisation."
                },
                {
                  "type": "paragraph",
                  "text": "Compression depends heavily on application technique."
                },
                {
                  "type": "paragraph",
                  "text": "May loosen as the patient moves."
                },
                {
                  "type": "paragraph",
                  "text": "Excessive tension can impair circulation."
                },
                {
                  "type": "paragraph",
                  "text": "May cause skin irritation or pressure injury."
                },
                {
                  "type": "paragraph",
                  "text": "Can retain moisture beneath the bandage."
                },
                {
                  "type": "paragraph",
                  "text": "May be unsuitable for patients who require carefully prescribed compression."
                },
                {
                  "type": "paragraph",
                  "text": "An ordinary crepe bandage does not necessarily provide graduated therapeutic compression."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "crepe_bandage_subsection_10",
          "subsection_title": "Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "crepe_bandage_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Explanation"
                  ],
                  "rows": [
                    [
                      "Neurovascular compromise",
                      "Excessive tightness reduces blood flow or compresses nerves"
                    ],
                    [
                      "Skin irritation",
                      "Friction, sweating or sensitivity to the fabric"
                    ],
                    [
                      "Pressure sores",
                      "Folds or concentrated pressure over bony areas"
                    ],
                    [
                      "Swelling beyond the bandage",
                      "Poor application or inadequate assessment of the injury"
                    ],
                    [
                      "Distal oedema",
                      "Compression or bandage configuration may impede venous return"
                    ],
                    [
                      "Reduced sensation",
                      "Compression of superficial nerves"
                    ],
                    [
                      "Skin maceration",
                      "Moisture trapped under the bandage"
                    ],
                    [
                      "Delayed recognition of injury",
                      "The bandage may obscure worsening symptoms if monitoring is inadequate"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "High-yield safety point: A patient who develops increasing pain, numbness, tingling or cold, discoloured digits after bandaging needs prompt reassessment. Do not assume that the bandage is merely uncomfortable."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "crepe_bandage_subsection_11",
          "subsection_title": "Contraindications and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "crepe_bandage_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Compression requires particular caution in patients with:"
                },
                {
                  "type": "paragraph",
                  "text": "Suspected acute limb ischaemia."
                },
                {
                  "type": "paragraph",
                  "text": "Significant peripheral arterial disease."
                },
                {
                  "type": "paragraph",
                  "text": "Severe sensory impairment."
                },
                {
                  "type": "paragraph",
                  "text": "Fragile skin or open wounds requiring a different dressing strategy."
                },
                {
                  "type": "paragraph",
                  "text": "Suspected compartment syndrome."
                },
                {
                  "type": "paragraph",
                  "text": "Significant unexplained limb swelling."
                },
                {
                  "type": "paragraph",
                  "text": "Conditions requiring specialist-directed compression therapy."
                },
                {
                  "type": "paragraph",
                  "text": "Compression may still be appropriate in some of these patients after assessment, but the type and pressure must be selected carefully."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "crepe_bandage_subsection_12",
          "subsection_title": "Crepe bandage versus elastic bandage",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "crepe_bandage_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The terminology can overlap because some crepe bandages are elasticated."
                },
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Crepe bandage",
                    "Purpose-made elastic support bandage"
                  ],
                  "rows": [
                    [
                      "Construction",
                      "Usually woven, crinkled fabric",
                      "Elastic fibres or engineered elastic construction"
                    ],
                    [
                      "Stretch",
                      "Variable, often moderate",
                      "Depends on the product; may have greater recoil"
                    ],
                    [
                      "Main use",
                      "Dressing retention and light support",
                      "Support and, for appropriate products, compression"
                    ],
                    [
                      "Pressure control",
                      "Usually limited",
                      "Varies by design and application"
                    ],
                    [
                      "Reusability",
                      "Product-dependent",
                      "Product-dependent"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A purpose-made compression bandage system should be distinguished from an ordinary elastic support bandage. The terms should not be treated as exact synonyms in every clinical setting."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "crepe_bandage_subsection_13",
          "subsection_title": "Crepe bandage versus POP bandage",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "crepe_bandage_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Crepe bandage",
                    "POP bandage"
                  ],
                  "rows": [
                    [
                      "Appearance",
                      "Usually beige or white woven stretch fabric",
                      "Gauze impregnated with white plaster"
                    ],
                    [
                      "Setting",
                      "Remains flexible",
                      "Hardens after wetting"
                    ],
                    [
                      "Function",
                      "Support, light compression and dressing retention",
                      "Rigid immobilisation"
                    ],
                    [
                      "Application",
                      "Wrapped around the required area",
                      "Wetted, layered and moulded"
                    ],
                    [
                      "Removal",
                      "Unwound",
                      "Often requires appropriate cast-cutting equipment"
                    ],
                    [
                      "Main risk",
                      "Excessive compression",
                      "Pressure injury, thermal burns and constriction within a cast"
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "crepe_bandage_subsection_14",
          "subsection_title": "High-yield OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "crepe_bandage_group_18",
