        {
          "subsection_id": "sinus_forceps_subsection_12",
          "subsection_title": "11. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "sinus_forceps_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a sinus forceps, a surgical instrument used in selected wound and sinus-related procedures. It has a long, slender working end that permits access to confined areas; the exact jaw and locking mechanism depend on the model. Its role may include controlled exploration, separation or manipulation, depending on the design. It should not be used for blind or forceful probing because this may cause tissue trauma, bleeding or a false passage. Before use, I would inspect the working end, joint, locking mechanism if present, cleanliness and sterility.”",
                  "style": "quote"
                }
              ]
            }
          ]
        },
        {
