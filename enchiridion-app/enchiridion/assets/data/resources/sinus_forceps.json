                  "columns": [
                    "Feature",
                    "Sinus forceps",
                    "Sinus probe",
                    "Artery forceps"
                  ],
                  "rows": [
                    [
                      "Primary function",
                      "Depends on pattern; may explore, spread or grasp",
                      "Trace or assess an accessible tract",
                      "Clamp vessels or tissue"
                    ],
                    [
                      "Working end",
                      "Long, narrow jaws",
                      "Slender probe-like tip",
                      "Clamping jaws"
                    ],
                    [
                      "Moving jaws",
                      "Present in forceps designs",
                      "Usually absent",
                      "Present"
                    ],
                    [
                      "Ratchet",
