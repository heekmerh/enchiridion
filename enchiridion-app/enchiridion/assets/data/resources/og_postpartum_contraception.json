  "sections": [
    {
      "section_id": "og_postpartum_contraception_section_1",
      "section_title": "Postpartum contraception",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "og_postpartum_contraception_subsection_1",
          "subsection_title": "1. Common OSCE station scenarios",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "og_postpartum_contraception_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "You may be asked to:",
                  "items": [
                    {
                      "text": "Counsel a woman who has just delivered and wants to avoid another pregnancy.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Advise a breastfeeding mother on safe contraceptive options.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Explain when contraception can be started after vaginal delivery or caesarean section.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Counsel a woman who wants an implant, injectable contraception, or an intrauterine contraceptive device after delivery.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Explain the relationship between breastfeeding, lactational amenorrhoea and fertility.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Advise a woman who wants to space pregnancies for two to three years.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Counsel a postpartum woman with risk factors for venous thromboembolism (VTE).",
                      "level": 0,
                      "label": "7."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Main OSCE objective: provide individualised contraceptive counselling that accounts for time since delivery, breastfeeding, medical eligibility, patient preference and the risk of an unintended pregnancy."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "og_postpartum_contraception_subsection_2",
          "subsection_title": "2. Introduction, consent and communication",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "og_postpartum_contraception_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Begin by introducing yourself, confirming the patient's identity and ensuring privacy."
                },
                {
                  "type": "paragraph",
                  "text": "Example opening:"
                },
                {
                  "type": "paragraph",
                  "text": "“Hello, my name is Dr ____. Congratulations on your delivery. I understand you would like advice about contraception after childbirth. I will explain the available methods, when they can be started, how they affect breastfeeding and their benefits and risks. We can then choose an option that suits your plans. Is that okay?”",
                  "style": "quote"
                },
                {
                  "type": "paragraph",
                  "text": "Reassure the patient that the decision is hers and that she can change methods if her circumstances or preferences change."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "og_postpartum_contraception_subsection_3",
          "subsection_title": "3. Focused postpartum history",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "og_postpartum_contraception_group_3",
              "group_title": "A. Obstetric history",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Ask about:",
                  "items": [
                    {
                      "text": "Date and mode of delivery: vaginal delivery or caesarean section.",
                      "level": 0
                    },
                    {
                      "text": "Any postpartum haemorrhage, infection or other complications.",
                      "level": 0
                    },
                    {
                      "text": "Whether the placenta has been completely delivered.",
                      "level": 0
                    },
                    {
                      "text": "Whether there are ongoing complications that may affect method choice.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "og_postpartum_contraception_group_4",
              "group_title": "B. Breastfeeding history",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Establish whether she is:",
                  "items": [
                    {
                      "text": "Exclusively breastfeeding.",
                      "level": 0
                    },
                    {
                      "text": "Partially breastfeeding.",
                      "level": 0
                    },
                    {
                      "text": "Formula feeding.",
                      "level": 0
                    },
                    {
                      "text": "Planning to breastfeed.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Ask about the baby's age and feeding frequency where relevant."
                }
              ]
            },
            {
              "group_id": "og_postpartum_contraception_group_5",
              "group_title": "C. Menstrual and sexual history",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Has menstruation returned?",
                      "level": 0
                    },
                    {
                      "text": "Has she resumed sexual intercourse?",
                      "level": 0
                    },
                    {
                      "text": "Has she had unprotected intercourse since delivery?",
                      "level": 0
                    },
                    {
                      "text": "Does she want to avoid pregnancy, and for how long?",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important: ovulation may occur before the first postpartum menstrual period. A woman can become pregnant before menstruation returns."
                }
              ]
            },
            {
              "group_id": "og_postpartum_contraception_group_6",
              "group_title": "D. Medical history",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Ask about:",
                  "items": [
                    {
                      "text": "Previous VTE or thrombophilia.",
                      "level": 0
                    },
                    {
                      "text": "Hypertension, migraine with aura or cardiovascular disease.",
                      "level": 0
                    },
                    {
                      "text": "Breast cancer or significant liver disease.",
                      "level": 0
                    },
                    {
                      "text": "Smoking, particularly in older women.",
                      "level": 0
                    },
                    {
                      "text": "Current medicines and any relevant contraindications.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "og_postpartum_contraception_group_7",
              "group_title": "E. Preferences and reproductive plans",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Ask whether she prefers:",
                  "items": [
                    {
                      "text": "A long-acting reversible method.",
                      "level": 0
                    },
                    {
                      "text": "A daily pill.",
                      "level": 0
                    },
                    {
                      "text": "An injectable method.",
                      "level": 0
                    },
                    {
                      "text": "Condoms.",
                      "level": 0
                    },
                    {
                      "text": "A hormone-free option.",
                      "level": 0
                    },
                    {
                      "text": "Permanent contraception, if her family is complete.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Clarify whether she wants to space pregnancies or does not desire future pregnancies."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "og_postpartum_contraception_subsection_4",
          "subsection_title": "4. Overview of postpartum contraceptive options",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "og_postpartum_contraception_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A. Progestogen implant"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Highly effective and long-acting.",
                      "level": 0
                    },
                    {
                      "text": "Can generally be inserted immediately after delivery or before discharge, subject to local guidance and informed choice.",
                      "level": 0
                    },
                    {
                      "text": "Compatible with breastfeeding.",
                      "level": 0
                    },
                    {
                      "text": "Does not require daily adherence.",
                      "level": 0
                    },
                    {
                      "text": "Irregular bleeding is a common reason for discontinuation.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "B. Intrauterine contraception"
                },
                {
                  "type": "paragraph",
                  "text": "Options include the copper IUD and levonorgestrel-releasing intrauterine system (LNG-IUS)."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Highly effective and long-acting.",
                      "level": 0
                    },
                    {
                      "text": "Can be inserted immediately after placental delivery or during the early postpartum period in appropriately selected patients.",
                      "level": 0
                    },
                    {
                      "text": "Immediate postpartum insertion has a higher expulsion risk than interval insertion.",
                      "level": 0
                    },
                    {
                      "text": "If not inserted immediately, timing depends on the method, delivery circumstances and local guidance.",
                      "level": 0
                    },
                    {
                      "text": "Avoid insertion in relevant situations such as puerperal sepsis.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/og_postpartum_contraception_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "C. Progestogen-only pill (POP)"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Generally suitable during breastfeeding.",
                      "level": 0
                    },
                    {
                      "text": "Can usually be started immediately postpartum.",
                      "level": 0
                    },
                    {
                      "text": "Requires regular daily use.",
                      "level": 0
                    },
                    {
                      "text": "Explain the timing requirements for missed pills, which vary by formulation.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "D. Injectable contraception"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Provides contraception for several weeks to months, depending on the product.",
                      "level": 0
                    },
                    {
                      "text": "Can generally be considered postpartum, including during breastfeeding, subject to individual medical eligibility and local recommendations.",
                      "level": 0
                    },
                    {
                      "text": "May cause irregular bleeding or amenorrhoea.",
                      "level": 0
                    },
                    {
                      "text": "Return to fertility can be delayed after the last injection.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "E. Condoms"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Can be used whenever sexual intercourse resumes.",
                      "level": 0
                    },
                    {
                      "text": "Do not affect breastfeeding.",
                      "level": 0
                    },
                    {
                      "text": "Provide protection against many STIs when used correctly.",
                      "level": 0
                    },
                    {
                      "text": "Less effective at preventing pregnancy in typical use than long-acting methods.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "F. Combined hormonal contraception"
                },
                {
                  "type": "paragraph",
                  "text": "Includes the combined pill, patch and vaginal ring."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Contains oestrogen and progestogen.",
                      "level": 0
                    },
                    {
                      "text": "Generally avoided in the early postpartum period because of increased VTE risk.",
                      "level": 0
                    },
                    {
                      "text": "Breastfeeding and other medical factors influence when it can be started.",
                      "level": 0
                    },
                    {
                      "text": "It is not the usual first choice immediately after childbirth.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "og_postpartum_contraception_subsection_5",
          "subsection_title": "5. When can contraception be started?",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "og_postpartum_contraception_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The timing depends on the method, breastfeeding status, medical eligibility and local guidelines."
                },
                {
                  "type": "table",
                  "columns": [
                    "Method",
                    "General postpartum approach"
                  ],
                  "rows": [
                    [
                      "Condoms",
                      "Whenever intercourse resumes"
                    ],
                    [
                      "Progestogen-only pill",
                      "Usually immediately postpartum"
                    ],
                    [
                      "Implant",
                      "Can generally be inserted immediately postpartum"
                    ],
                    [
                      "Injectable progestogen",
                      "Consider postpartum according to individual eligibility and local guidance"
                    ],
                    [
                      "Copper IUD / LNG-IUS",
                      "Immediately after placental delivery in suitable cases, or later at an appropriate interval"
                    ],
                    [
                      "Combined hormonal contraception",
                      "Delay in the early postpartum period because of VTE risk; breastfeeding affects eligibility and timing"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Clinical caution: do not treat all postpartum patients as having the same eligibility. For example, a woman with previous VTE or several thrombotic risk factors requires careful assessment before an oestrogen-containing method is considered."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "og_postpartum_contraception_subsection_6",
          "subsection_title": "6. Breastfeeding and contraception",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "og_postpartum_contraception_group_10",
              "group_title": "Methods generally compatible with breastfeeding",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Progestogen-only pill.",
                      "level": 0
                    },
                    {
                      "text": "Implant.",
                      "level": 0
                    },
                    {
                      "text": "Injectable progestogen, subject to individual eligibility and guidance.",
                      "level": 0
                    },
                    {
                      "text": "Copper IUD.",
                      "level": 0
                    },
                    {
                      "text": "LNG-IUS.",
                      "level": 0
                    },
                    {
                      "text": "Condoms.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "og_postpartum_contraception_group_11",
              "group_title": "Why is combined hormonal contraception treated differently?",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Oestrogen-containing methods can increase VTE risk, which is already elevated after childbirth. They may also affect milk supply in some women."
                },
                {
                  "type": "paragraph",
                  "text": "Therefore, combined hormonal contraception should not be prescribed automatically to a woman who is breastfeeding or recently delivered. Follow the applicable medical eligibility criteria."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "og_postpartum_contraception_subsection_7",
          "subsection_title": "7. Lactational amenorrhoea method (LAM)",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "og_postpartum_contraception_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "LAM can provide temporary contraception, but all three criteria must be satisfied:"
                },
                {
                  "type": "paragraph",
                  "text": "1. The baby is younger than 6 months."
                },
                {
                  "type": "paragraph",
                  "text": "2. The mother has not resumed menstruation."
                },
                {
                  "type": "paragraph",
                  "text": "3. Breastfeeding is exclusive or nearly exclusive, frequent by day and night."
                },
                {
                  "type": "paragraph",
                  "text": "If any criterion is no longer met, the woman should use another contraceptive method if she wishes to avoid pregnancy."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE point: breastfeeding alone is not reliable contraception."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "og_postpartum_contraception_subsection_8",
          "subsection_title": "8. Counselling a woman who wants another pregnancy in 2–3 years",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "og_postpartum_contraception_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A strong answer should compare options based on effectiveness, convenience, adverse effects and return to fertility."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Implant: highly effective, reversible and rapidly reversible after removal.",
                      "level": 0
                    },
                    {
                      "text": "IUD/IUS: highly effective and reversible.",
                      "level": 0
                    },
                    {
                      "text": "POP: suitable for breastfeeding but requires daily adherence.",
                      "level": 0
                    },
                    {
                      "text": "Injectable contraception: effective, but return to fertility may be delayed after discontinuation.",
                      "level": 0
                    },
                    {
                      "text": "Condoms: useful for STI protection and additional pregnancy prevention.",
                      "level": 0
                    },
                    {
                      "text": "LAM: temporary and only appropriate while all three criteria are met.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A suitable counselling statement is:"
                },
                {
                  "type": "paragraph",
                  "text": "“Because you want to delay pregnancy for two to three years, an implant or an intrauterine method would be worth considering. Both are highly effective and reversible. If you prefer a method you can stop yourself without a procedure, we can discuss pills or other options.”",
                  "style": "quote"
                },
                {
                  "type": "paragraph",
                  "text": "Do not assume that the most effective method is automatically the patient's preferred method."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "og_postpartum_contraception_subsection_9",
          "subsection_title": "9. Postpartum contraception after caesarean section",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "og_postpartum_contraception_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Caesarean delivery does not rule out most contraceptive methods."
                },
                {
                  "type": "list",
                  "title": "However, consider:",
                  "items": [
                    {
                      "text": "Postoperative recovery and complications.",
                      "level": 0
                    },
                    {
                      "text": "VTE risk, particularly when considering oestrogen-containing contraception.",
                      "level": 0
                    },
                    {
                      "text": "Whether immediate postpartum IUD insertion was performed.",
                      "level": 0
                    },
                    {
                      "text": "Whether infection or other contraindications are present.",
                      "level": 0
                    },
                    {
                      "text": "The patient's breastfeeding plans and preferences.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "An implant or progestogen-only pill can often be started early. An IUD can be inserted at an appropriate time if there is no contraindication, but immediate postpartum insertion carries a higher expulsion risk."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "og_postpartum_contraception_subsection_10",
          "subsection_title": "10. Postpartum emergency contraception",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "og_postpartum_contraception_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "If a postpartum woman has already had unprotected intercourse, assess whether emergency contraception is indicated rather than assuming that breastfeeding or amenorrhoea prevents pregnancy."
                },
                {
                  "type": "list",
                  "title": "Options include:",
                  "items": [
                    {
                      "text": "Copper IUD, when suitable and within the relevant timing criteria.",
                      "level": 0
                    },
                    {
                      "text": "Levonorgestrel emergency contraception.",
                      "level": 0
                    },
                    {
                      "text": "Ulipristal acetate, with consideration of breastfeeding recommendations and local guidance.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "For breastfeeding patients, recommendations regarding interruption or continuation of breastfeeding after ulipristal acetate differ between product information and some professional guidance. Check the applicable local recommendation and explain the options accurately."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "og_postpartum_contraception_subsection_11",
          "subsection_title": "11. Examiner questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "og_postpartum_contraception_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. When can fertility return after childbirth?"
                },
                {
                  "type": "paragraph",
                  "text": "Ovulation can occur before the first postpartum menstrual period, so pregnancy is possible even when menstruation has not resumed."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Which contraceptive methods are generally suitable during breastfeeding?"
                },
                {
                  "type": "paragraph",
                  "text": "Progestogen-only pills, implants, intrauterine methods and condoms are generally suitable. Injectable methods can also be considered according to individual eligibility and local guidance."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What are the three criteria for LAM?"
                },
                {
                  "type": "paragraph",
                  "text": "The infant is younger than six months, menstruation has not resumed, and breastfeeding is exclusive or nearly exclusive and frequent during the day and night."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Why should combined hormonal contraception be avoided in the early postpartum period?"
                },
                {
                  "type": "paragraph",
                  "text": "Because postpartum VTE risk is increased, and oestrogen-containing contraception can increase that risk further."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What is the main disadvantage of immediate postpartum IUD insertion?"
                },
                {
                  "type": "paragraph",
                  "text": "The risk of expulsion is higher than with insertion later in the postpartum period."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Which methods are long-acting and reversible?"
                },
                {
                  "type": "paragraph",
                  "text": "The contraceptive implant, copper IUD and LNG-IUS."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. Which method may delay return to fertility after discontinuation?"
                },
                {
                  "type": "paragraph",
                  "text": "Injectable progestogen contraception, particularly depot medroxyprogesterone acetate."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. Does a caesarean section prevent future IUD use?"
                },
                {
                  "type": "paragraph",
                  "text": "No. An IUD can be used if the woman is eligible and insertion is appropriately timed."
                },
                {
                  "type": "paragraph",
                  "text": "Q9. What should you discuss before choosing a method?"
                },
                {
                  "type": "paragraph",
                  "text": "Effectiveness, timing, breastfeeding, side effects, contraindications, reversibility, STI protection, patient preference and follow-up."
                },
                {
                  "type": "paragraph",
                  "text": "Q10. What if the patient declines contraception?"
                },
                {
                  "type": "paragraph",
                  "text": "Respect her decision, provide clear information, offer condoms if desired, and invite her to return whenever she wishes. Counselling must be voluntary and non-coercive."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "og_postpartum_contraception_subsection_12",
          "subsection_title": "12. Common OSCE mistakes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "og_postpartum_contraception_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Assuming that breastfeeding always prevents pregnancy.",
                      "level": 0
                    },
                    {
                      "text": "Forgetting that ovulation may precede the first period.",
                      "level": 0
                    },
                    {
                      "text": "Recommending combined hormonal contraception without assessing postpartum VTE risk.",
                      "level": 0
                    },
                    {
                      "text": "Failing to discuss long-acting reversible contraception.",
