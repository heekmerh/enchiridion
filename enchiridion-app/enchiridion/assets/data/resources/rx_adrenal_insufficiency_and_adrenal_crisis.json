  "sections": [
    {
      "section_id": "rx_adrenal_insufficiency_and_adrenal_crisis_section_1",
      "section_title": "Adrenal insufficiency and adrenal crisis",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "rx_adrenal_insufficiency_and_adrenal_crisis_subsection_1",
          "subsection_title": "1. Classification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Type",
                    "Underlying defect",
                    "Cortisol",
                    "Aldosterone"
                  ],
                  "rows": [
                    [
                      "Primary adrenal insufficiency (Addison disease)",
                      "Adrenal gland failure",
                      "Low",
                      "Often low"
                    ],
                    [
                      "Secondary adrenal insufficiency",
                      "Pituitary ACTH deficiency",
                      "Low",
                      "Usually preserved"
                    ],
                    [
                      "Tertiary adrenal insufficiency",
                      "Hypothalamic suppression, commonly after glucocorticoid exposure",
                      "Low",
                      "Usually preserved"
                    ],
                    [
                      "Adrenal crisis",
                      "Acute, severe cortisol deficiency with haemodynamic or metabolic compromise",
                      "Critically inadequate for physiological stress",
                      "May also be deficient"
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_2",
              "group_title": "Common causes",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "**Primary adrenal insufficiency:** autoimmune adrenalitis, tuberculosis, adrenal haemorrhage, infiltrative disease, bilateral adrenalectomy and selected genetic disorders."
                },
                {
                  "type": "paragraph",
                  "text": "**Secondary adrenal insufficiency:** pituitary tumours, pituitary surgery or radiotherapy, apoplexy and hypopituitarism."
                },
                {
                  "type": "paragraph",
                  "text": "**Tertiary adrenal insufficiency:** suppression of the hypothalamic–pituitary–adrenal axis following prolonged systemic glucocorticoid therapy or substantial exposure to other glucocorticoid formulations."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "rx_adrenal_insufficiency_and_adrenal_crisis_subsection_2",
          "subsection_title": "2. Diagnosis and severity classification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_3",
              "group_title": "Diagnostic investigations",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Investigation",
                    "Typical interpretation"
                  ],
                  "rows": [
                    [
                      "8–9 AM serum cortisol",
                      "Very low concentrations support adrenal insufficiency; intermediate results require further testing"
                    ],
                    [
                      "Plasma ACTH",
                      "Markedly elevated in primary disease; low or inappropriately normal in central disease"
                    ],
                    [
                      "Short ACTH stimulation test",
                      "Inadequate cortisol response supports adrenal insufficiency; assay-specific thresholds apply"
                    ],
                    [
                      "Serum sodium",
                      "Hyponatraemia may occur"
                    ],
                    [
                      "Serum potassium",
                      "Hyperkalaemia suggests mineralocorticoid deficiency, particularly primary disease"
                    ],
                    [
                      "Blood glucose",
                      "Hypoglycaemia may occur, especially in children"
                    ],
                    [
                      "Plasma renin and aldosterone",
                      "Assess mineralocorticoid deficiency in primary disease"
                    ],
                    [
                      "21-hydroxylase antibodies",
                      "Support autoimmune primary adrenal insufficiency"
                    ],
                    [
                      "Adrenal imaging or pituitary MRI",
                      "Used when indicated by the suspected cause"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A commonly used traditional stimulated peak cortisol threshold is approximately 500 nmol/L (18 µg/dL), but modern assays often require lower cutoffs. Always interpret results using the laboratory's validated assay threshold."
                },
                {
                  "type": "paragraph",
                  "text": "Recent or ongoing glucocorticoid exposure can interfere with cortisol testing. Early central adrenal insufficiency can also produce a misleadingly normal ACTH stimulation test."
                }
              ]
            },
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_4",
              "group_title": "Severity",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Severity",
                    "Clinical significance",
                    "Treatment"
                  ],
                  "rows": [
                    [
                      "Stable chronic insufficiency",
                      "Patient stable and tolerating oral therapy",
                      "Oral hormone replacement"
                    ],
                    [
                      "Intercurrent illness without shock",
                      "Increased cortisol requirements",
                      "Sick-day stress dosing"
                    ],
                    [
                      "Suspected adrenal crisis",
                      "Hypotension, collapse, severe vomiting, altered consciousness, hypoglycaemia or significant dehydration",
                      "Immediate parenteral hydrocortisone and IV fluids"
                    ],
                    [
                      "Refractory adrenal crisis",
                      "Persistent shock or major metabolic instability",
                      "Critical care management"
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "rx_adrenal_insufficiency_and_adrenal_crisis_subsection_3",
          "subsection_title": "3. Chronic adrenal insufficiency: first-line treatment",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_5",
              "group_title": "A. Hydrocortisone — preferred glucocorticoid replacement",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "**Adults: 15–25 mg orally daily**, usually divided into two or three doses, with the largest dose in the morning."
                },
                {
                  "type": "paragraph",
                  "text": "Illustrative adult prescription — chronic primary adrenal insufficiency"
                },
                {
                  "type": "paragraph",
                  "text": "**Rx: Hydrocortisone 10 mg tablets**"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Take 10 mg orally at 7–8 AM.",
                      "level": 0
                    },
                    {
                      "text": "Take 5 mg orally at 12–1 PM.",
                      "level": 0
                    },
                    {
                      "text": "Take 5 mg orally at 4–5 PM.",
                      "level": 0
                    },
                    {
                      "text": "Total daily dose: 20 mg.",
                      "level": 0
                    },
                    {
                      "text": "Duration: continuous replacement, with regular review.",
                      "level": 0
                    },
                    {
                      "text": "Quantity for 30 days: **60 tablets of 10 mg**, if tablets can be accurately split.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Where splitting is unsuitable, use an appropriate 5 mg formulation. The prescribed regimen should reflect individual cortisol requirements."
                },
                {
                  "type": "paragraph",
                  "text": "**Administration:** Give with or after food if gastrointestinal irritation occurs. Avoid unnecessarily large evening doses because they may interfere with sleep."
                },
                {
                  "type": "paragraph",
                  "text": "**Alternative: Prednisolone**"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Adults: commonly 3–5 mg orally daily, individualized.",
                      "level": 0
                    },
                    {
                      "text": "May be considered when adherence to multiple daily hydrocortisone doses is difficult.",
                      "level": 0
                    },
                    {
                      "text": "Long-acting dexamethasone is generally avoided for routine physiological replacement because of the risk of overtreatment.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_6",
              "group_title": "B. Fludrocortisone — mineralocorticoid replacement",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Required for most patients with **primary adrenal insufficiency**, but generally not for secondary or tertiary adrenal insufficiency."
                },
                {
                  "type": "paragraph",
                  "text": "Illustrative adult prescription — mineralocorticoid replacement"
                },
                {
                  "type": "paragraph",
                  "text": "**Rx: Fludrocortisone acetate 100 microgram tablets**"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Dose: 100 micrograms (0.1 mg).",
                      "level": 0
                    },
                    {
                      "text": "Route: oral.",
                      "level": 0
                    },
                    {
                      "text": "Frequency: once every morning.",
                      "level": 0
                    },
                    {
                      "text": "Duration: continuous replacement.",
                      "level": 0
                    },
                    {
                      "text": "Quantity for 30 days: **30 tablets**.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Typical adjustment range: 50–200 micrograms daily, guided by specialist review, blood pressure, electrolytes and renin."
                },
                {
                  "type": "paragraph",
                  "text": "Fludrocortisone is not a substitute for glucocorticoid replacement."
                }
              ]
            },
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_7",
              "group_title": "C. Other treatment options",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "DHEA may be considered in selected adult women with primary adrenal insufficiency who continue to experience impaired well-being despite optimized replacement, after specialist evaluation. It is not routine therapy."
                },
                {
                  "type": "paragraph",
                  "text": "Underlying causes, associated autoimmune disease and other pituitary hormone deficiencies should be addressed where relevant."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "rx_adrenal_insufficiency_and_adrenal_crisis_subsection_4",
          "subsection_title": "4. Adrenal crisis: emergency treatment",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "**Emergency adult protocol**"
                },
                {
                  "type": "paragraph",
                  "text": "For suspected adrenal crisis in an adult. Follow local resuscitation protocols and seek senior or critical care support."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "**Hydrocortisone 100 mg IV immediately**, or IM if IV access is unavailable.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "**0.9% sodium chloride 1 litre IV during the first hour**, with rate and volume adjusted for cardiac failure, renal impairment, age and haemodynamic response.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Continue **hydrocortisone 200 mg over 24 hours by continuous IV infusion**, or **50 mg IV/IM every 6 hours**.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Check and correct hypoglycaemia promptly with IV glucose according to the local emergency protocol.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Monitor blood pressure, pulse, mental status, urine output, sodium, potassium, glucose and renal function.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Identify and treat the precipitating cause, including infection, dehydration or missed glucocorticoid therapy.",
                      "level": 0,
                      "label": "6."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "**Important:** Blood samples for cortisol and ACTH may be taken before hydrocortisone if this can be done immediately, but sampling must never delay emergency treatment."
                }
              ]
            },
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_9",
              "group_title": "Example hospital medication orders",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Medication",
                    "Dose and route",
                    "Frequency or duration"
                  ],
                  "rows": [
                    [
                      "Hydrocortisone sodium succinate",
                      "100 mg IV stat",
                      "Immediately"
                    ],
                    [
                      "Hydrocortisone sodium succinate",
                      "200 mg IV infusion",
                      "Over 24 hours, reassessed daily"
                    ],
                    [
                      "Alternative hydrocortisone schedule",
                      "50 mg IV/IM",
                      "Every 6 hours"
                    ],
                    [
                      "Sodium chloride 0.9%",
                      "1 L IV initially",
                      "First hour if appropriate, then guided by response"
                    ],
                    [
                      "IV glucose",
                      "According to measured glucose and hypoglycaemia protocol",
                      "As needed"
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_10",
              "group_title": "Reconstitution and infusion",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Hydrocortisone sodium succinate is supplied in different vial and diluent presentations. Reconstitute strictly according to the specific product label, inspect the solution and use the manufacturer's recommended diluent, final concentration, storage conditions and administration time."
                },
                {
                  "type": "paragraph",
                  "text": "For continuous infusion, pharmacy or institutional guidance should specify the compatible diluent, concentration, infusion device and stability period. Do not assume that all hydrocortisone brands have identical preparation instructions."
                },
                {
                  "type": "paragraph",
                  "text": "**Transition to oral therapy:** Once haemodynamically stable, the precipitating illness is controlled and oral absorption is reliable, transition to an appropriate oral stress-dose regimen, then gradually return to maintenance replacement under clinical supervision."
                },
                {
                  "type": "paragraph",
                  "text": "Fludrocortisone is usually unnecessary while the total hydrocortisone dose exceeds approximately 50 mg/day because high-dose hydrocortisone provides substantial mineralocorticoid activity."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "rx_adrenal_insufficiency_and_adrenal_crisis_subsection_5",
          "subsection_title": "5. Sick-day rules and stress-dose therapy",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Patients with adrenal insufficiency must receive an individualized written plan for increasing glucocorticoid replacement during illness, surgery or significant physiological stress."
                }
              ]
            },
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_12",
              "group_title": "Adult sick-day dosing",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Situation",
                    "Recommended approach"
                  ],
                  "rows": [
                    [
                      "Mild illness without fever or systemic symptoms",
                      "Usually continue maintenance dose"
                    ],
                    [
                      "Fever, infection or illness requiring bed rest",
                      "Increase oral hydrocortisone to at least 40 mg/day in 2–4 divided doses, or prednisolone at least 10 mg/day, while significantly unwell"
                    ],
                    [
                      "Repeated vomiting or inability to absorb oral medication",
                      "Emergency hydrocortisone 100 mg IM/IV and urgent hospital assessment"
                    ],
                    [
                      "Severe infection, sepsis or shock",
                      "Parenteral adrenal crisis protocol"
                    ],
                    [
                      "Major surgery under general anaesthesia",
                      "Perioperative parenteral stress-dose hydrocortisone"
                    ],
                    [
                      "Recovery from acute illness",
                      "Return to maintenance dosing when clinically recovered, following the individualized plan"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Some established protocols use doubling or tripling of the usual daily dose. NICE NG243 specifies minimum adult sick-day doses during significant physiological stress; a patient already receiving more than these amounts requires individualized instructions."
                },
                {
                  "type": "paragraph",
                  "text": "NICE"
                }
              ]
            },
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_13",
              "group_title": "Emergency hydrocortisone injection",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Patients at risk of adrenal crisis should have access to an emergency injection kit and receive practical training, along with family members or caregivers."
                },
                {
                  "type": "paragraph",
                  "text": "**Emergency medication**"
                },
                {
                  "type": "paragraph",
                  "text": "Hydrocortisone sodium succinate 100 mg injection."
                },
                {
                  "type": "paragraph",
                  "text": "**Adult emergency dose:** 100 mg IM, or IV when administered by a qualified professional."
                },
                {
                  "type": "paragraph",
                  "text": "**Indication:** Suspected adrenal crisis, collapse or inability to retain oral glucocorticoids."
                },
                {
                  "type": "paragraph",
                  "text": "**After administration:** Arrange immediate emergency medical assessment. The injection does not replace hospital resuscitation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "rx_adrenal_insufficiency_and_adrenal_crisis_subsection_6",
          "subsection_title": "6. Paediatric adrenal insufficiency",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Children require specialist paediatric endocrine supervision. Dosing depends on body surface area, growth, developmental stage and the underlying disorder."
                }
              ]
            },
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_15",
              "group_title": "Maintenance treatment",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Medication",
                    "Usual paediatric approach"
                  ],
                  "rows": [
                    [
                      "Hydrocortisone",
                      "Approximately 8–10 mg/m²/day orally in 3–4 divided doses for primary adrenal insufficiency"
                    ],
                    [
                      "Fludrocortisone",
                      "Often 50–200 micrograms/day orally when mineralocorticoid replacement is required"
                    ],
                    [
                      "Sodium chloride supplementation",
                      "May be needed in infancy, particularly with salt-wasting disease"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Dose adjustment must account for growth, weight gain, blood pressure and signs of underreplacement or overreplacement."
                }
              ]
            },
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_16",
              "group_title": "Worked maintenance-dose example",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A child has a body surface area of 0.8 m² and a prescribed hydrocortisone dose of 10 mg/m²/day."
                },
                {
                  "type": "paragraph",
                  "text": "\\[ 10\\text{ mg/m}^2/\\text{day}\\times0.8\\text{ m}^2=8\\text{ mg/day} \\]"
                },
                {
                  "type": "paragraph",
                  "text": "An appropriately compounded or licensed paediatric formulation can be used to divide this dose into three or four administrations."
                }
              ]
            },
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_17",
              "group_title": "Paediatric adrenal crisis",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The BSPED emergency guidance provides the following initial age-based hydrocortisone doses:"
                },
                {
                  "type": "table",
                  "columns": [
                    "Age",
                    "Initial hydrocortisone IM/IV"
                  ],
                  "rows": [
                    [
                      "Under 1 year",
                      "25 mg"
                    ],
                    [
                      "1–5 years",
                      "50 mg"
                    ],
                    [
                      "6 years and older",
                      "100 mg"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Subsequent hydrocortisone dosing is determined by the hospital's paediatric adrenal crisis protocol, age, weight and severity."
                },
                {
                  "type": "paragraph",
                  "text": "For circulatory compromise, administer 0.9% sodium chloride using paediatric resuscitation guidance, commonly in reassessed 10 mL/kg boluses. Treat hypoglycaemia promptly with weight-based IV glucose."
                },
                {
                  "type": "paragraph",
                  "text": "**Neonates require a separate neonatal protocol**, particularly premature infants and infants younger than 28 days."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "rx_adrenal_insufficiency_and_adrenal_crisis_subsection_7",
          "subsection_title": "7. Pregnancy and breastfeeding",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_18",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Hydrocortisone remains the preferred glucocorticoid replacement during pregnancy."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Continue essential replacement throughout pregnancy.",
                      "level": 0
                    },
                    {
                      "text": "Review glucocorticoid requirements regularly; an increase may be required during later pregnancy.",
                      "level": 0
                    },
                    {
                      "text": "Adjust fludrocortisone clinically in primary adrenal insufficiency, using blood pressure and electrolytes rather than relying on renin alone.",
                      "level": 0
                    },
                    {
                      "text": "Avoid routine dexamethasone replacement because it crosses the placenta more readily.",
                      "level": 0
                    },
                    {
                      "text": "Provide stress-dose glucocorticoids during active labour, caesarean delivery and major obstetric complications.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "An illustrative adult delivery regimen is hydrocortisone 100 mg IV at the onset of active labour or induction of anaesthesia, followed by 200 mg IV over 24 hours or 50 mg IV every 6 hours. Postpartum doses are reduced according to recovery, generally over the next 24–48 hours."
                },
                {
                  "type": "paragraph",
                  "text": "Hydrocortisone and prednisolone are generally compatible with breastfeeding at replacement doses."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "rx_adrenal_insufficiency_and_adrenal_crisis_subsection_8",
          "subsection_title": "8. Contraindications, precautions and interactions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_19",
              "group_title": "Hydrocortisone",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "In established adrenal insufficiency, necessary replacement should not be withheld because of concerns about routine glucocorticoid adverse effects."
                },
                {
                  "type": "table",
                  "columns": [
                    "Issue",
                    "Clinical implication"
                  ],
                  "rows": [
                    [
                      "Active infection",
                      "Treat infection; increase steroid coverage during significant illness"
                    ],
                    [
                      "Diabetes mellitus",
                      "Monitor glucose, especially during stress dosing"
                    ],
                    [
                      "Osteoporosis",
                      "Avoid chronic overreplacement; assess bone health"
                    ],
                    [
                      "Hypertension or heart failure",
                      "Monitor fluid retention and blood pressure"
                    ],
                    [
                      "Rifampicin",
                      "May accelerate glucocorticoid metabolism"
                    ],
                    [
                      "Phenytoin, carbamazepine, phenobarbital",
                      "May reduce steroid exposure"
                    ],
                    [
                      "Strong CYP3A4 inhibitors",
                      "May increase exposure to certain glucocorticoids"
                    ],
                    [
                      "Warfarin",
                      "Anticoagulant response may change; monitor INR"
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_20",
              "group_title": "Fludrocortisone",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Potential adverse effects include hypertension, peripheral oedema, hypokalaemia and worsening fluid overload."
                },
                {
                  "type": "paragraph",
                  "text": "Use additional caution with diuretics, digoxin and medications affecting potassium balance."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "rx_adrenal_insufficiency_and_adrenal_crisis_subsection_9",
          "subsection_title": "9. Renal and hepatic impairment",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_21",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "**Renal impairment:** Physiological hydrocortisone replacement does not ordinarily require a fixed renal dose reduction. However, fluid therapy and mineralocorticoid dosing require closer monitoring, particularly in advanced chronic kidney disease or heart failure."
                },
                {
                  "type": "paragraph",
                  "text": "**Hepatic impairment:** Changes in steroid metabolism and cortisol-binding proteins may complicate interpretation of laboratory results. Adjust replacement clinically and obtain specialist advice in significant liver disease."
                },
                {
                  "type": "paragraph",
                  "text": "During adrenal crisis, immediate hydrocortisone treatment remains essential even when renal or hepatic dysfunction is present."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "rx_adrenal_insufficiency_and_adrenal_crisis_subsection_10",
          "subsection_title": "10. Monitoring and treatment response",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_22",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Parameter",
                    "Purpose"
                  ],
                  "rows": [
                    [
                      "Blood pressure, including postural readings",
                      "Assess volume status and replacement adequacy"
                    ],
                    [
                      "Weight and symptoms",
                      "Detect underreplacement or overreplacement"
                    ],
                    [
                      "Serum sodium and potassium",
                      "Assess electrolyte and mineralocorticoid balance"
                    ],
                    [
                      "Plasma renin, where appropriate",
                      "Support fludrocortisone titration"
                    ],
                    [
                      "Glucose or HbA1c when indicated",
                      "Detect steroid-associated dysglycaemia"
                    ],
                    [
                      "Bone health",
                      "Identify long-term glucocorticoid complications"
                    ],
                    [
                      "Growth and pubertal development in children",
                      "Avoid underreplacement and growth suppression"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Routine ACTH normalization is **not** an appropriate treatment target for hydrocortisone replacement in primary adrenal insufficiency; attempting to normalize ACTH can result in excessive glucocorticoid dosing."
                }
              ]
            },
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_23",
              "group_title": "Signs of inadequate replacement",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Fatigue, weight loss, salt craving, postural dizziness, hypotension and recurrent illness-related deterioration."
                }
              ]
            },
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_24",
              "group_title": "Signs of excessive replacement",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Weight gain, hypertension, easy bruising, impaired glucose tolerance, insomnia and osteoporosis."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "rx_adrenal_insufficiency_and_adrenal_crisis_subsection_11",
          "subsection_title": "11. Treatment failure and escalation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_25",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Persistent hypotension after initial hydrocortisone and fluid resuscitation requires urgent reassessment for:",
                  "items": [
                    {
                      "text": "Sepsis or septic shock.",
                      "level": 0
                    },
                    {
                      "text": "Ongoing haemorrhage or fluid loss.",
                      "level": 0
                    },
                    {
                      "text": "Cardiac dysfunction.",
                      "level": 0
                    },
                    {
                      "text": "Severe electrolyte or glucose abnormalities.",
                      "level": 0
                    },
                    {
                      "text": "Inadequate drug delivery or infusion interruption.",
                      "level": 0
                    },
                    {
                      "text": "Additional causes of shock.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Critical care admission may be required for vasopressor support, invasive monitoring or persistent organ dysfunction."
                },
                {
                  "type": "paragraph",
                  "text": "Do not delay investigation and treatment of concurrent causes of shock while treating adrenal insufficiency."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "rx_adrenal_insufficiency_and_adrenal_crisis_subsection_12",
          "subsection_title": "12. Patient counselling and discharge prescription",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_26",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Every patient should understand that adrenal replacement is essential medication and that missed doses during illness can be dangerous."
                }
              ]
            },
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_27",
              "group_title": "Illustrative adult discharge prescription",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Drug",
                    "Instructions",
                    "30-day quantity"
                  ],
                  "rows": [
                    [
                      "Hydrocortisone 10 mg tablets",
                      "10 mg at 8 AM, 5 mg at 1 PM, 5 mg at 5 PM",
                      "60 tablets, if suitable for splitting"
                    ],
                    [
                      "Fludrocortisone 100 microgram tablets",
                      "100 micrograms orally every morning, for primary adrenal insufficiency when indicated",
                      "30 tablets"
                    ],
                    [
                      "Emergency hydrocortisone injection",
                      "100 mg IM for suspected adrenal crisis, as instructed",
                      "Emergency kit with appropriate supplies"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "This represents a maintenance example, not a universal discharge regimen. A patient recovering from adrenal crisis may require temporary higher oral glucocorticoid doses before returning to maintenance treatment."
                },
                {
                  "type": "paragraph",
                  "text": "Provide a written sick-day plan, emergency injection training, a steroid emergency card or medical alert identification and follow-up arrangements."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "rx_adrenal_insufficiency_and_adrenal_crisis_subsection_13",
          "subsection_title": "13. High-yield clinical pearls",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "rx_adrenal_insufficiency_and_adrenal_crisis_group_28",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "**Primary adrenal insufficiency** commonly causes cortisol and aldosterone deficiency.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "**Secondary and tertiary insufficiency** usually preserve aldosterone secretion.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Hyperkalaemia strongly suggests mineralocorticoid deficiency but is not present in every case.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "In suspected adrenal crisis, **give hydrocortisone immediately**.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Hydrocortisone 100 mg IV/IM stat followed by 200 mg/day is a standard adult emergency regimen.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Fludrocortisone is generally not required during high-dose hydrocortisone treatment.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Do not abruptly stop long-term glucocorticoid therapy in a patient at risk of adrenal suppression.",
                      "level": 0,
                      "label": "7."
                    },
                    {
                      "text": "Patients must know when to increase oral doses and when to use emergency injectable hydrocortisone.",
                      "level": 0,
                      "label": "8."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}