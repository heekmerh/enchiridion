      "section_id": "ryles_tube_section_1",
      "section_title": "Ryle’s tube",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "ryles_tube_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
