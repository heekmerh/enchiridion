        },
        {
          "subsection_id": "ryles_tube_subsection_2",
          "subsection_title": "Introduction and definition",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ryles_tube_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A Ryle’s tube is a nasogastric tube passed through the nose, down the oesophagus, and into the stomach. It is traditionally a relatively large-bore tube used primarily for gastric aspiration, drainage and decompression, although some types may also be used for enteral feeding when appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "It is named after the British physician Sir William Ryle."
                },
                {
                  "type": "paragraph",
                  "text": "Key OSCE distinction:"
                },
                {
                  "type": "paragraph",
                  "text": "Ryle’s tube: Traditionally associated with gastric aspiration and decompression."
                },
                {
                  "type": "paragraph",
                  "text": "Fine-bore feeding tube: Generally preferred for routine enteral feeding because it is more comfortable and less traumatic."
                },
                {
                  "type": "paragraph",
                  "text": "Levin tube: A single-lumen nasogastric tube."
                },
                {
                  "type": "paragraph",
                  "text": "Salem sump tube: A double-lumen tube with a separate air vent that helps facilitate gastric drainage and reduce mucosal suction injury."
                },
                {
                  "type": "paragraph",
                  "text": "These devices overlap in their uses, so always describe the actual device presented."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ryles_tube_subsection_3",
          "subsection_title": "Identification and characteristic features",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ryles_tube_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/ryles_tube_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Identification: Ryle’s tube (nasogastric tube)."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Characteristic features"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Long, flexible, hollow tube."
                },
                {
                  "type": "paragraph",
                  "text": "Usually made of PVC or another medical-grade polymer."
                },
                {
                  "type": "paragraph",
                  "text": "Graduated markings along the shaft."
                },
                {
                  "type": "paragraph",
                  "text": "Proximal funnel-shaped connector in many traditional designs."
                },
                {
                  "type": "paragraph",
                  "text": "Distal tip with drainage openings or side holes."
                },
                {
                  "type": "paragraph",
                  "text": "May have a radiopaque stripe to aid radiographic identification."
                },
                {
                  "type": "paragraph",
                  "text": "Available in different lengths, diameters and configurations."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ryles_tube_subsection_4",
          "subsection_title": "Labelling of parts",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ryles_tube_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/ryles_tube_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "aarogyaabharat.com"
                  ]
                },
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Function"
                  ],
                  "rows": [
                    [
                      "Proximal funnel/connector",
                      "Connects to a drainage bag, suction system or compatible syringe."
                    ],
                    [
                      "Tube shaft",
                      "Provides the passage between the nose and stomach."
                    ],
                    [
                      "Graduations",
                      "Indicate insertion depth and help monitor external tube length."
                    ],
                    [
                      "Distal tip",
                      "Enters the stomach when correctly positioned."
                    ],
                    [
                      "Side holes",
                      "Permit aspiration or drainage of gastric contents."
                    ],
                    [
                      "Radiopaque stripe, if present",
                      "Helps identify the tube on radiographs."
                    ],
                    [
                      "External fixation",
                      "Secures the tube at the nostril to reduce displacement."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The precise connector and tip design vary between manufacturers."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ryles_tube_subsection_5",
          "subsection_title": "Classification and sizes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ryles_tube_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Ryle’s tubes are commonly classified by:"
                },
                {
                  "type": "paragraph",
                  "text": "Calibre: Small-, medium- or large-bore."
                },
                {
                  "type": "paragraph",
                  "text": "Material: PVC, polyurethane or other medical-grade materials."
                },
                {
                  "type": "paragraph",
                  "text": "Lumen configuration: Single-lumen or, in other NG drainage designs, double-lumen."
                },
                {
                  "type": "paragraph",
                  "text": "Purpose: Gastric aspiration/decompression or a device specifically designed and approved for enteral feeding."
                },
                {
                  "type": "paragraph",
                  "text": "Tube diameter is commonly expressed in French gauge (Fr or FG)."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/ryles_tube_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Examples:"
                },
                {
                  "type": "table",
                  "columns": [
                    "Size",
                    "Approximate external diameter"
                  ],
                  "rows": [
                    [
                      "10 Fr",
                      "3.3 mm"
                    ],
                    [
                      "12 Fr",
                      "4.0 mm"
                    ],
                    [
                      "14 Fr",
                      "4.7 mm"
                    ],
                    [
                      "16 Fr",
                      "5.3 mm"
                    ],
                    [
                      "18 Fr",
                      "6.0 mm"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Traditional Ryle’s tubes are often encountered in sizes around 12–18 Fr, although available sizes vary. Larger sizes may be selected when thicker gastric contents need to be aspirated."
                },
                {
                  "type": "paragraph",
                  "text": "Exam pearl: French gauge measures the tube’s external diameter, not its internal diameter."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ryles_tube_subsection_6",
          "subsection_title": "Principle of operation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ryles_tube_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Ryle’s tube provides access to the stomach through the nasal passage and oesophagus."
                },
                {
                  "type": "paragraph",
                  "text": "Its relatively wide lumen facilitates:"
                },
                {
                  "type": "paragraph",
                  "text": "Aspiration of gastric contents using a syringe or appropriate suction system."
                },
                {
                  "type": "paragraph",
                  "text": "Decompression of a distended stomach."
                },
                {
                  "type": "paragraph",
                  "text": "Drainage of gastric secretions and swallowed air."
                },
                {
                  "type": "paragraph",
                  "text": "Collection of gastric aspirate for selected investigations."
                },
                {
                  "type": "paragraph",
                  "text": "Important: A single-lumen Ryle’s tube connected to suction can cause gastric mucosa to be drawn against its openings. Appropriate suction settings and clinical monitoring are essential."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ryles_tube_subsection_7",
          "subsection_title": "Indications and uses",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ryles_tube_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/ryles_tube_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Gastric decompression"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Relieves accumulation of gas and fluid in selected patients with intestinal obstruction, postoperative ileus, or marked gastric distension."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/ryles_tube_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Gastric aspiration"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Removes gastric contents when clinically indicated, such as in selected cases of bowel obstruction or severe gastric distension."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/ryles_tube_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Perioperative gastric drainage"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "May be used during selected abdominal surgical admissions when decompression is indicated. Routine use after every abdominal operation is not necessary."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/ryles_tube_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Gastric sampling"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Allows collection of gastric contents for selected diagnostic purposes."
                }
              ]
            },
            {
              "group_id": "ryles_tube_group_8",
              "group_title": "Surgical procedures where it may be used",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Laparotomy for intestinal obstruction."
                },
                {
                  "type": "paragraph",
                  "text": "Management of postoperative ileus."
                },
                {
                  "type": "paragraph",
                  "text": "Selected emergency abdominal operations."
                },
                {
                  "type": "paragraph",
                  "text": "Selected upper gastrointestinal surgical procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Management of acute gastric dilatation."
                },
                {
                  "type": "paragraph",
                  "text": "It is an adjunct to treatment, not a substitute for definitive management of an underlying obstruction, perforation, or other surgical pathology."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ryles_tube_subsection_8",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ryles_tube_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Relatively inexpensive and widely available."
                },
                {
                  "type": "paragraph",
                  "text": "Can be inserted at the bedside by trained personnel when appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Wide lumen allows drainage of thicker gastric contents compared with many fine-bore feeding tubes."
                },
                {
                  "type": "paragraph",
                  "text": "Can be connected to a drainage bag or an appropriate suction system."
                },
                {
                  "type": "paragraph",
                  "text": "Provides a means of monitoring the quantity and appearance of gastric drainage."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ryles_tube_subsection_9",
          "subsection_title": "Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ryles_tube_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Causes nasal and pharyngeal discomfort."
                },
                {
                  "type": "paragraph",
                  "text": "May provoke gagging, coughing, or vomiting during insertion."
                },
                {
                  "type": "paragraph",
                  "text": "Can cause mucosal injury and epistaxis."
                },
                {
                  "type": "paragraph",
                  "text": "May be poorly tolerated if left in place for prolonged periods."
                },
                {
                  "type": "paragraph",
                  "text": "A single lumen may become blocked or adhere to the gastric mucosa during suction."
                },
                {
                  "type": "paragraph",
                  "text": "Does not reliably prevent aspiration."
                },
                {
                  "type": "paragraph",
                  "text": "Is not generally the preferred device for prolonged enteral feeding."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ryles_tube_subsection_10",
          "subsection_title": "Contraindications and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ryles_tube_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Before insertion, assess the indication and potential risks."
                },
                {
                  "type": "table",
                  "columns": [
                    "Condition",
                    "OSCE consideration"
                  ],
                  "rows": [
                    [
                      "Suspected basilar skull fracture or major midface trauma",
                      "Avoid blind nasal insertion; seek an appropriate alternative and specialist advice."
                    ],
                    [
                      "Suspected oesophageal perforation or obstruction",
                      "Do not proceed blindly without specialist assessment."
                    ],
                    [
                      "Recent oesophageal or upper gastrointestinal surgery",
                      "Follow the operating surgeon's instructions."
                    ],
                    [
                      "Oesophageal varices or significant bleeding risk",
                      "Individual risk assessment and specialist advice may be necessary."
                    ],
                    [
                      "Severe facial or nasal anatomical abnormalities",
                      "Alternative or guided placement may be required."
                    ],
                    [
                      "Patient refusal",
                      "Explain the indication and alternatives; do not proceed without valid consent unless a lawful emergency exception applies."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These conditions do not all represent absolute contraindications in every clinical circumstance."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ryles_tube_subsection_11",
          "subsection_title": "Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ryles_tube_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Misplacement into the respiratory tract"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Can cause serious injury, particularly if fluid or feed is administered. Initial position must be confirmed before use."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Nasal and upper gastrointestinal trauma"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Epistaxis, nasal ulceration, pharyngitis, oesophagitis and, rarely, perforation."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Aspiration"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Gastric contents may enter the respiratory tract despite the presence of the tube."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Suction-related injury"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Excessive or prolonged suction can injure gastric mucosa, causing bleeding or ulceration."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Fluid and electrolyte depletion"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Prolonged drainage can lead to loss of water, hydrogen ions, chloride and potassium, potentially causing dehydration, hypochloraemic metabolic alkalosis and hypokalaemia."
                },
                {
                  "type": "paragraph",
                  "text": "Other problems include tube blockage, accidental removal, sinusitis, pressure injury, and discomfort."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ryles_tube_subsection_12",
          "subsection_title": "Insertion and management: OSCE sequence",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ryles_tube_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This is a practical examination framework. In clinical practice, insertion and management must follow supervised training, the manufacturer's instructions and the local protocol."
                },
                {
                  "type": "paragraph",
                  "text": "Preparation: Confirm the indication, check contraindications, explain the procedure, obtain consent, perform hand hygiene and assemble the tube, lubricant, appropriate syringe, fixation materials and drainage equipment."
                },
                {
                  "type": "paragraph",
                  "text": "Positioning: Sit the patient upright if clinically possible and assess nasal patency."
                },
                {
                  "type": "paragraph",
                  "text": "Measurement: Estimate the required insertion length using the locally approved method."
                },
                {
                  "type": "paragraph",
                  "text": "Insertion: Lubricate appropriately and advance gently through the selected nostril. Never force the tube against resistance."
                },
                {
                  "type": "paragraph",
                  "text": "Monitoring: Observe for persistent coughing, respiratory distress, cyanosis or other concerning symptoms. Stop and reassess if these occur."
                },
                {
                  "type": "paragraph",
                  "text": "Confirmation: Confirm initial placement using an accepted method, generally aspirate pH testing and/or radiography according to the local protocol. Do not use the whoosh test."
                },
                {
                  "type": "paragraph",
                  "text": "Connection: Once placement is confirmed, connect to the prescribed drainage or suction system. Verify the prescribed suction setting and whether intermittent or continuous drainage is intended."
                },
                {
                  "type": "paragraph",
                  "text": "Ongoing care: Secure the tube, monitor the external length, drainage volume and appearance, fluid balance, electrolytes and patient comfort."
                },
                {
                  "type": "paragraph",
                  "text": "Documentation: Record the indication, tube size, insertion details, position-confirmation result, suction settings where applicable, drainage and complications."
                },
                {
                  "type": "paragraph",
                  "text": "For initial NG tube placement, NHS safety guidance identifies appropriately interpreted aspirate pH in the accepted range or radiography as confirmation methods; local protocols determine the pathway. Never flush or introduce feed, medication or fluid before initial placement has been confirmed."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ryles_tube_subsection_13",
          "subsection_title": "Ryle’s tube versus other nasogastric tubes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ryles_tube_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Ryle’s tube",
                    "Fine-bore feeding tube",
                    "Salem sump tube"
                  ],
                  "rows": [
                    [
                      "Typical design",
                      "Relatively large bore",
                      "Narrow bore",
                      "Large bore, double lumen"
                    ],
                    [
                      "Main use",
                      "Gastric drainage and decompression",
                      "Enteral feeding",
                      "Gastric drainage and decompression"
                    ],
                    [
                      "Lumen",
                      "Usually single",
                      "Usually single",
                      "Two lumens, including an air vent"
                    ],
                    [
                      "Patient comfort",
                      "Generally less comfortable",
                      "Generally more comfortable",
                      "Generally less comfortable"
                    ],
                    [
                      "Suction",
                      "Appropriate when prescribed",
                      "Not generally intended for routine gastric suction",
                      "Designed for gastric drainage with a vent lumen"
                    ],
                    [
                      "Feeding",
                      "Only if the specific device is suitable and approved",
                      "Commonly used",
                      "Not its primary purpose"
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ryles_tube_subsection_14",
          "subsection_title": "High-yield OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ryles_tube_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is the primary use of a Ryle’s tube?"
                },
                {
                  "type": "paragraph",
                  "text": "Gastric aspiration, drainage and decompression in appropriately selected patients."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Why is a wide-bore tube useful in intestinal obstruction?"
                },
                {
                  "type": "paragraph",
                  "text": "It facilitates drainage of gastric fluid and accumulated secretions, helping relieve proximal gastrointestinal distension and vomiting."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Why is the Salem sump tube different?"
                },
                {
                  "type": "paragraph",
                  "text": "It has a second vent lumen that admits air and helps prevent the gastric mucosa from being continuously drawn against the drainage openings during suction."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. What electrolyte disturbance may follow prolonged gastric aspiration?"
                },
                {
                  "type": "paragraph",
                  "text": "Hypochloraemic metabolic alkalosis, often accompanied by hypokalaemia and volume depletion."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. How do you know the tube is correctly positioned?"
                },
                {
                  "type": "paragraph",
                  "text": "Use the approved initial confirmation protocol, commonly aspirate pH testing and/or a properly interpreted radiograph. Never rely on air insufflation and auscultation alone."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What would you monitor in a patient on continuous gastric drainage?"
                },
                {
                  "type": "paragraph",
                  "text": "Drainage volume and appearance, fluid input and output, hydration, electrolyte levels, abdominal signs, tube patency and suction function."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ryles_tube_subsection_15",
          "subsection_title": "Examiner's high-yield tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ryles_tube_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Recognise that a Ryle’s tube is a nasogastric tube, not a urinary catheter."
                },
                {
                  "type": "paragraph",
                  "text": "Identify the proximal connector, graduated shaft, distal tip and side holes."
                },
                {
                  "type": "paragraph",
                  "text": "State its principal role as gastric drainage and decompression."
                },
                {
                  "type": "paragraph",
                  "text": "Mention intestinal obstruction and selected postoperative situations as indications."
                },
                {
                  "type": "paragraph",
                  "text": "Identify respiratory misplacement and aspiration as major safety hazards."
                },
                {
                  "type": "paragraph",
                  "text": "Mention fluid and electrolyte losses during prolonged drainage."
                },
                {
                  "type": "paragraph",
                  "text": "Do not confuse a Ryle’s tube with a Salem sump tube, which has a separate vent lumen."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid stating that all Ryle’s tubes are suitable for feeding; device design and local policy matter."
                }
              ]
            },
            {
              "group_id": "ryles_tube_group_17",
              "group_title": "Model OSCE presentation",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a Ryle’s tube, a nasogastric tube traditionally used for gastric aspiration and decompression. It consists of a flexible hollow shaft with graduated markings, a proximal connector and a distal tip with drainage openings. It is indicated in selected cases of intestinal obstruction, postoperative ileus and gastric distension. Advantages include low cost and effective gastric drainage. Complications include respiratory misplacement, aspiration, mucosal injury, blockage and fluid-electrolyte depletion. Its position must be confirmed by an approved method before use.”"
                }
              ]
            }
          ]
        }
      ]
    }
