      "section_id": "tracheostomy_tube_section_1",
      "section_title": "Tracheostomy tube",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "tracheostomy_tube_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "tracheostomy_tube_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
