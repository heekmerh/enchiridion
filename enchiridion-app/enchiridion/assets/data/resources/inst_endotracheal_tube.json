  "sections": [
    {
      "section_id": "inst_endotracheal_tube_section_1",
      "section_title": "Endotracheal tube",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "inst_endotracheal_tube_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_endotracheal_tube_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "An endotracheal tube (ETT) is a flexible tube inserted through the mouth or nose into the trachea to establish an airway and facilitate ventilation and oxygenation."
                },
                {
                  "type": "paragraph",
                  "text": "It is commonly used during general anaesthesia, resuscitation, and management of patients who cannot maintain or protect their airway adequately."
                },
                {
                  "type": "paragraph",
                  "text": "Key OSCE principle: An ETT provides access to the trachea for ventilation, but correct placement must be confirmed. Seeing the tube pass through the vocal cords is helpful, but waveform capnography is the preferred method for confirming tracheal placement when available."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_endotracheal_tube_subsection_2",
          "subsection_title": "1. Identification and definition",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Name: Endotracheal tube.",
                      "level": 0
                    },
                    {
                      "text": "Abbreviation: ETT.",
                      "level": 0
                    },
                    {
                      "text": "Route: Usually oral; nasal intubation is used in selected situations.",
                      "level": 0
                    },
                    {
                      "text": "Main function: To provide a conduit for ventilation and oxygen delivery.",
                      "level": 0
                    },
                    {
                      "text": "Common types: Cuffed and uncuffed tubes.",
                      "level": 0
                    },
                    {
                      "text": "Common materials: Medical-grade PVC or other suitable materials, depending on the tube design.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_endotracheal_tube_subsection_3",
          "subsection_title": "2. Types of endotracheal tubes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_endotracheal_tube_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A. Cuffed ETT"
                },
                {
                  "type": "paragraph",
                  "text": "Has an inflatable cuff near its distal end. When appropriately inflated, it helps create a seal within the trachea, reducing gas leakage and helping limit gross aspiration of secretions, although it does not eliminate aspiration risk."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_endotracheal_tube_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "B. Uncuffed ETT"
                },
                {
                  "type": "paragraph",
                  "text": "Has no inflatable cuff. It may be used in selected pediatric or neonatal situations according to the applicable protocol and available equipment."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_endotracheal_tube_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "C. Reinforced ETT"
                },
                {
                  "type": "paragraph",
                  "text": "Contains reinforcement to resist kinking. Used in selected procedures where tube bending is a concern."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_endotracheal_tube_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "D. Preformed or specialised ETT"
                },
                {
                  "type": "paragraph",
                  "text": "Includes tubes designed for particular surgical positions or airway-management needs. The appropriate type depends on the clinical indication."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_endotracheal_tube_subsection_4",
          "subsection_title": "3. Parts of an ETT and their functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_endotracheal_tube_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "1. Proximal connector"
                },
                {
                  "type": "paragraph",
                  "text": "Usually a standard 15 mm connector that attaches to a bag-valve-mask or breathing circuit."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_endotracheal_tube_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "2. Tube shaft and depth markings"
                },
                {
                  "type": "paragraph",
                  "text": "Conducts gas to and from the trachea. Markings help estimate insertion depth and monitor tube position."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_endotracheal_tube_08.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "3. Cuff and pilot balloon"
                },
                {
                  "type": "paragraph",
                  "text": "The cuff helps seal the trachea. The pilot balloon indicates cuff inflation and provides access for inflation or deflation."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_endotracheal_tube_09.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "4. Bevelled distal tip"
                },
                {
                  "type": "paragraph",
                  "text": "The angled opening at the end of the tube facilitates passage into the trachea."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_endotracheal_tube_10.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "5. Murphy eye"
                },
                {
                  "type": "paragraph",
                  "text": "A side opening near the distal end that may permit some gas flow if the main tip opening becomes obstructed."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_endotracheal_tube_subsection_5",
          "subsection_title": "4. Indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "An ETT may be required for:",
                  "items": [
                    {
                      "text": "Failure to maintain airway patency: When basic airway measures are inadequate.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Respiratory failure: When the patient requires invasive mechanical ventilation.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Airway protection: In selected patients with severely impaired consciousness or a high risk of losing airway protection.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Cardiac arrest and resuscitation: When advanced airway management is indicated and performed by a trained clinician.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "General anaesthesia: When a secured airway is needed for surgery.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Severe airway or respiratory compromise: When a definitive airway is required as part of emergency management.",
                      "level": 0,
                      "label": "6."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Intubation is not automatically indicated by a particular Glasgow Coma Scale score alone; the overall clinical condition, airway reflexes, ventilation, oxygenation, and anticipated course matter."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_endotracheal_tube_subsection_6",
          "subsection_title": "5. Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Provides a reliable route for positive-pressure ventilation when correctly positioned.",
                      "level": 0
                    },
                    {
                      "text": "Can be connected to a ventilator or manual resuscitation device.",
                      "level": 0
                    },
                    {
                      "text": "A cuffed tube can reduce gross leakage and help limit aspiration of secretions.",
                      "level": 0
                    },
                    {
                      "text": "Permits tracheal suctioning when required.",
                      "level": 0
                    },
                    {
                      "text": "Facilitates controlled ventilation during anaesthesia and critical illness.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_endotracheal_tube_subsection_7",
          "subsection_title": "6. Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Insertion requires appropriate training and equipment.",
                      "level": 0
                    },
                    {
                      "text": "Placement can fail or enter the oesophagus or a main bronchus.",
                      "level": 0
                    },
                    {
                      "text": "May cause trauma to the teeth, vocal cords, larynx, or trachea.",
                      "level": 0
                    },
                    {
                      "text": "Cuff pressure that is too high can injure the tracheal mucosa.",
                      "level": 0
                    },
                    {
                      "text": "Requires ongoing monitoring, tube security, and appropriate airway care.",
                      "level": 0
                    },
                    {
                      "text": "Can cause discomfort and often requires sedation or anaesthesia outside cardiac arrest situations.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_endotracheal_tube_subsection_8",
          "subsection_title": "7. ETT sizes — high-yield OSCE knowledge",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The size is usually labelled by internal diameter (ID) in millimetres."
                }
              ]
            },
            {
              "group_id": "inst_endotracheal_tube_group_9",
              "group_title": "Common adult sizes",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Patient",
                    "Common starting size"
                  ],
                  "rows": [
                    [
                      "Adult female",
                      "7.0–7.5 mm ID"
                    ],
                    [
                      "Adult male",
                      "7.5–8.5 mm ID"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These are starting estimates, not rigid rules. Anatomy, indication, available equipment, and the clinician's assessment determine the final choice."
                }
              ]
            },
            {
              "group_id": "inst_endotracheal_tube_group_10",
              "group_title": "Common pediatric sizing estimates",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "For children beyond the neonatal period, traditional age-based estimates are:",
                  "items": [
                    {
                      "text": "Uncuffed ETT: internal diameter (mm) ≈ age in years ÷ 4 + 4",
                      "level": 0
                    },
                    {
                      "text": "Cuffed ETT: internal diameter (mm) ≈ age in years ÷ 4 + 3.5",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These formulas are estimates only. Use a validated local reference chart and have smaller and larger tubes available. Cuffed tubes are widely used in pediatric practice when appropriately selected and managed."
                },
                {
                  "type": "paragraph",
                  "text": "Neonates: Tube size is selected mainly using gestational age, birth weight, and neonatal resuscitation guidance—not the childhood age formula."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_endotracheal_tube_subsection_9",
          "subsection_title": "8. Preparation before intubation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Before an intubation attempt, a trained clinician should:",
                  "items": [
                    {
                      "text": "Assess the airway and anticipate difficulty.",
                      "level": 0
                    },
                    {
                      "text": "Call for help when needed and formulate a failed-airway plan.",
                      "level": 0
                    },
                    {
                      "text": "Select an appropriate ETT and check its integrity.",
                      "level": 0
                    },
                    {
                      "text": "Test the cuff for leaks if the tube has one, then ensure the cuff is deflated before insertion.",
                      "level": 0
                    },
                    {
                      "text": "Prepare a laryngoscope with a functioning light or video system.",
                      "level": 0
                    },
                    {
                      "text": "Prepare suction, oxygen, a bag-valve-mask, and appropriate rescue airway equipment.",
                      "level": 0
                    },
                    {
                      "text": "Prepare a stylet or introducer if indicated, ensuring it does not protrude dangerously beyond the tube tip.",
                      "level": 0
                    },
                    {
                      "text": "Establish appropriate monitoring, including oxygen saturation and waveform capnography when available.",
                      "level": 0
                    },
                    {
                      "text": "Preoxygenate when indicated and feasible.",
                      "level": 0
                    },
                    {
                      "text": "Ensure equipment for securing the tube is ready.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_endotracheal_tube_subsection_10",
          "subsection_title": "9. Endotracheal intubation — overview for OSCE",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_endotracheal_tube_11.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_endotracheal_tube_12.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_endotracheal_tube_13.webp",
                  "caption": "8"
                },
                {
                  "type": "paragraph",
                  "text": "Intubation is an advanced procedure that should be performed by trained personnel with appropriate supervision and rescue equipment."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Position and preoxygenate: Optimise the patient's position and oxygenation as clinically appropriate.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Prepare and check equipment: Confirm the correct tube, functioning laryngoscope, suction, and ventilation equipment.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Visualise the larynx: Use the laryngoscope to identify the epiglottis and vocal cords.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Pass the ETT: Under direct or video visualisation, guide the tube through the vocal cords.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Inflate the cuff if present: Use the minimum appropriate inflation to achieve a seal, then assess cuff pressure with a manometer when available.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Confirm tracheal placement: Use continuous waveform capnography where available. Assess chest movement and breath sounds as supporting checks.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Secure the tube: Record the depth at the teeth or lips and secure the tube appropriately.",
                      "level": 0,
                      "label": "7."
                    },
                    {
                      "text": "Reassess continuously: Monitor ventilation, oxygenation, tube position, and clinical response.",
                      "level": 0,
                      "label": "8."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Never rely on misting in the tube or chest rise alone to confirm tracheal placement. If oesophageal placement is suspected, act immediately according to the emergency airway protocol."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_endotracheal_tube_subsection_11",
          "subsection_title": "10. Confirming correct ETT placement",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This is one of the most important examiner questions."
                },
                {
                  "type": "table",
                  "columns": [
                    "Check",
                    "What it tells you"
                  ],
                  "rows": [
                    [
                      "Continuous waveform capnography",
                      "Preferred method for confirming and monitoring tracheal placement in patients with circulation"
                    ],
                    [
                      "Bilateral chest rise",
                      "Supports assessment of ventilation"
                    ],
                    [
                      "Bilateral breath sounds",
                      "Supports assessment, though auscultation can be misleading"
                    ],
                    [
                      "Absence of prominent epigastric sounds",
                      "May support the assessment but is not definitive"
                    ],
                    [
                      "Oxygen saturation",
                      "Helps monitor oxygenation but may remain normal briefly despite incorrect placement"
                    ],
                    [
                      "Tube depth and clinical reassessment",
                      "Helps identify displacement or endobronchial intubation"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A tube may enter the trachea but advance too far, commonly into the right main bronchus, resulting in reduced ventilation of the left lung. Confirm placement initially and reassess after movement or transfer."
                },
                {
                  "type": "paragraph",
                  "text": "If waveform capnography is unavailable, use the locally recommended combination of confirmation methods and urgently obtain appropriate equipment or expert assistance. Clinical signs alone cannot reliably exclude oesophageal intubation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_endotracheal_tube_subsection_12",
          "subsection_title": "11. Cuff pressure and tube depth",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_14",
              "group_title": "Cuff pressure",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Use a cuff manometer when available.",
                      "level": 0
                    },
                    {
                      "text": "A commonly targeted adult cuff pressure is approximately 20–30 cmH₂O, subject to the tube manufacturer's guidance and clinical protocol.",
                      "level": 0
                    },
                    {
                      "text": "Avoid excessive inflation because it can impair tracheal mucosal blood flow.",
                      "level": 0
                    },
                    {
                      "text": "An underinflated cuff may allow gas leakage and passage of secretions.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "inst_endotracheal_tube_group_15",
              "group_title": "Tube depth",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Depth is estimated from the patient's size, age, anatomy, and tube markings. Adult oral insertion depth is often around 21 cm in many women and 23 cm in many men at the teeth, but these are only rough starting estimates."
                },
                {
                  "type": "paragraph",
                  "text": "Do not treat a standard depth as proof of correct placement. Confirm the position using recommended methods and adjust according to clinical findings and local protocol."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_endotracheal_tube_subsection_13",
          "subsection_title": "12. Contraindications and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "There is no simple absolute contraindication to lifesaving intubation when it is necessary. Important precautions include:"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Anticipated difficult airway or restricted mouth opening.",
                      "level": 0
                    },
                    {
                      "text": "Significant facial, laryngeal, or cervical spine trauma.",
                      "level": 0
                    },
                    {
                      "text": "Severe hypoxia or haemodynamic instability.",
                      "level": 0
                    },
                    {
                      "text": "Airway swelling, blood, vomit, or secretions that impair visualisation.",
                      "level": 0
                    },
                    {
                      "text": "Limited operator experience or lack of rescue equipment.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "In an anticipated difficult airway, seek expert assistance and consider an alternative airway strategy rather than persisting with repeated unsuccessful attempts."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_endotracheal_tube_subsection_14",
          "subsection_title": "13. Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Explanation"
                  ],
                  "rows": [
                    [
                      "Oesophageal intubation",
                      "Tube enters the oesophagus rather than the trachea"
                    ],
                    [
                      "Right mainstem intubation",
                      "Tube advances too far into the right main bronchus"
                    ],
                    [
                      "Dental or oral trauma",
                      "Injury during laryngoscopy or tube passage"
                    ],
                    [
                      "Hypoxia",
                      "Prolonged or unsuccessful attempts"
                    ],
                    [
                      "Aspiration",
                      "Gastric contents enter the respiratory tract"
                    ],
                    [
                      "Laryngeal or tracheal injury",
                      "Trauma during insertion or from excessive cuff pressure"
                    ],
                    [
                      "Vocal cord injury",
                      "Direct trauma or pressure-related injury"
                    ],
                    [
                      "Infection",
                      "Risk associated with prolonged invasive ventilation"
                    ],
                    [
                      "Accidental extubation",
                      "Tube displacement after insertion"
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_endotracheal_tube_subsection_15",
          "subsection_title": "14. Pediatric and neonatal considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_18",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_endotracheal_tube_14.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/inst_endotracheal_tube_15.webp",
                  "caption": null
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Use age- and size-appropriate equipment.",
                      "level": 0
                    },
                    {
                      "text": "Neonatal ETT selection depends on gestational age and birth weight, using neonatal guidance.",
                      "level": 0
                    },
                    {
                      "text": "Children have smaller airways, so small changes in tube diameter can significantly affect resistance.",
                      "level": 0
                    },
                    {
                      "text": "Confirm placement and reassess after any movement.",
                      "level": 0
                    },
                    {
                      "text": "Use cuffed tubes only with appropriate sizing and cuff-pressure monitoring.",
                      "level": 0
                    },
                    {
                      "text": "Follow pediatric or neonatal resuscitation protocols, including limits on attempts and strategies to maintain oxygenation.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_endotracheal_tube_subsection_16",
          "subsection_title": "15. Memory aid: TUBE",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_19",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "T"
                },
                {
                  "type": "paragraph",
                  "text": "Tube size: Select the correct internal diameter."
                },
                {
                  "type": "paragraph",
                  "text": "U"
                },
                {
                  "type": "paragraph",
                  "text": "Under vision: Pass the tube through the vocal cords."
                },
                {
                  "type": "paragraph",
                  "text": "B"
                },
                {
                  "type": "paragraph",
                  "text": "Breathing confirmation: Use waveform capnography and assess ventilation."
                },
                {
                  "type": "paragraph",
                  "text": "E"
                },
                {
                  "type": "paragraph",
                  "text": "Ensure security: Secure the tube and reassess its position."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_endotracheal_tube_subsection_17",
          "subsection_title": "16. Common OSCE examiner questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_20",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is the main function of an ETT?"
                },
                {
                  "type": "paragraph",
                  "text": "To establish a route into the trachea for ventilation and oxygen delivery."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is the difference between a cuffed and an uncuffed ETT?"
                },
                {
                  "type": "paragraph",
                  "text": "A cuffed ETT has an inflatable cuff to help seal the trachea. An uncuffed ETT does not have this cuff."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What does the Murphy eye do?"
                },
                {
                  "type": "paragraph",
                  "text": "It provides a secondary opening for gas flow if the main distal opening becomes obstructed."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. What is the most reliable routine method for confirming tracheal placement?"
                },
                {
                  "type": "paragraph",
                  "text": "Continuous waveform capnography, when available and appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What happens if the tube is advanced too far?"
                },
                {
                  "type": "paragraph",
                  "text": "It may enter a main bronchus, commonly the right, causing unequal ventilation and potentially hypoxia."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Why must cuff pressure be monitored?"
                },
                {
                  "type": "paragraph",
                  "text": "Excessive pressure can damage the tracheal mucosa, while insufficient pressure may allow leakage."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What would you do if capnography suggests oesophageal intubation?"
                },
                {
                  "type": "paragraph",
                  "text": "Treat it as an emergency: immediately assess and correct the airway according to the applicable airway-rescue protocol, including removing a misplaced tube when indicated and restoring oxygenation and ventilation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "inst_endotracheal_tube_subsection_18",
          "subsection_title": "17. Mini OSCE station",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "inst_endotracheal_tube_group_21",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Scenario: You are shown an endotracheal tube and asked to identify its parts and explain how correct placement is confirmed."
                },
                {
                  "type": "list",
                  "title": "Expected response:",
                  "items": [
                    {
                      "text": "Identify the ETT and state its purpose.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Identify the connector, shaft and depth markings, cuff and pilot balloon if present, bevelled tip, and Murphy eye.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Explain cuffed versus uncuffed tubes.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Describe appropriate tube selection and preparation.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Explain that the tube is passed through the vocal cords under visual guidance by a trained clinician.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "State that waveform capnography is the preferred confirmation method when available.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Mention complications such as oesophageal intubation, mainstem intubation, hypoxia, and airway trauma.",
                      "level": 0,
                      "label": "7."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}