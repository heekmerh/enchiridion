        {
          "subsection_id": "pen_torch_subsection_2",
          "subsection_title": "1. Identification and definition",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pen_torch_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A pen torch (penlight) is a small, portable light source used during clinical examination to illuminate body cavities and assess responses to light, particularly the pupils."
                },
                {
                  "type": "paragraph",
                  "text": "In OSCEs, it is commonly used during the cranial nerve examination, eye examination, oral examination and assessment of consciousness."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pen_torch_subsection_3",
          "subsection_title": "2. Parts and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pen_torch_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/pen_torch_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "bvmedical.com"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Light source: Usually an LED or bulb.",
                      "level": 0
                    },
                    {
                      "text": "Switch: Turns the light on and off.",
                      "level": 0
                    },
                    {
                      "text": "Body or handle: Houses the battery and electronics.",
                      "level": 0
                    },
                    {
                      "text": "Pocket clip: Allows attachment to a uniform or coat.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Common types include battery-powered LED pen torches, rechargeable penlights and disposable examination lights."
                }
              ]
            }
          ]
        },
        {
