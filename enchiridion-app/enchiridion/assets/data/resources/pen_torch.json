        {
          "subsection_id": "pen_torch_subsection_5",
          "subsection_title": "4. Advantages and disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pen_torch_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Advantages",
                    "Disadvantages"
                  ],
                  "rows": [
                    [
                      "Portable and inexpensive",
                      "Does not magnify structures"
                    ],
                    [
                      "Quick bedside assessment",
                      "Brightness varies between devices"
                    ],
                    [
                      "Useful in emergency and routine examinations",
                      "Cannot replace an ophthalmoscope or slit lamp"
                    ],
                    [
                      "Requires little equipment",
                      "Pupil findings can be affected by drugs, ambient light and eye disease"
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pen_torch_subsection_6",
          "subsection_title": "5. Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pen_torch_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Before using a pen torch:",
                  "items": [
                    {
                      "text": "Introduce yourself, confirm the patient's identity and explain the examination.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Obtain consent and wash your hands.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Check that the torch works and produces adequate light.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Reduce ambient lighting when assessing pupils, if appropriate.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Ask the patient to look at a distant target during the light-reflex examination to minimize accommodation.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Avoid shining a bright light directly into the eyes for unnecessarily long periods.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Clean the device between patients according to local infection-control policy.",
                      "level": 0,
                      "label": "7."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important: If a patient has a painful red eye, suspected penetrating eye injury or chemical injury, do not delay urgent assessment and management merely to complete a routine pen-torch examination."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pen_torch_subsection_7",
          "subsection_title": "6. Pupillary examination — step by step",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pen_torch_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/pen_torch_07.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/pen_torch_08.webp",
                  "caption": null
                }
              ]
            },
            {
              "group_id": "pen_torch_group_8",
              "group_title": "A. Inspect the pupils before shining the light",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Observe and document:",
                  "items": [
                    {
                      "text": "Size: Small, normal-sized or dilated.",
                      "level": 0
                    },
                    {
                      "text": "Shape: Round or irregular.",
                      "level": 0
                    },
                    {
                      "text": "Symmetry: Equal or unequal.",
                      "level": 0
                    },
                    {
                      "text": "Position: Central or displaced, if relevant.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Measure pupil diameter in millimetres when possible, in both bright and dim lighting."
                }
              ]
            },
            {
              "group_id": "pen_torch_group_9",
              "group_title": "B. Test the direct light reflex",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The direct response is constriction of the pupil in the eye receiving the light."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Ask the patient to look at a distant object.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Approach from the side rather than shining the torch directly from the front.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Illuminate one eye briefly.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Observe that same pupil for constriction.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Repeat on the other eye.",
                      "level": 0,
                      "label": "5."
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "pen_torch_group_10",
              "group_title": "C. Test the consensual light reflex",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The consensual response is constriction of the opposite pupil when light is shone into one eye."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Illuminate the right eye.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Observe the left pupil for constriction.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Illuminate the left eye.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Observe the right pupil.",
                      "level": 0,
                      "label": "4."
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "pen_torch_group_11",
              "group_title": "D. Record your findings",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A normal finding may be reported as:"
                },
                {
                  "type": "paragraph",
                  "text": "“Both pupils are equal, round and reactive to light, with intact direct and consensual light reflexes.”",
                  "style": "quote"
                },
                {
                  "type": "paragraph",
                  "text": "If pupils are unequal or a reflex is absent, document the exact finding and assess it in the context of the full neurological and ocular examination."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pen_torch_subsection_8",
          "subsection_title": "7. Understanding the pupillary light reflex",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pen_torch_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The reflex pathway is a common OSCE viva topic."
                },
                {
                  "type": "paragraph",
                  "text": "Light enters the retina"
                },
                {
                  "type": "paragraph",
                  "text": "Optic nerve — CN II (afferent limb)"
                },
                {
                  "type": "paragraph",
                  "text": "Pretectal area and bilateral Edinger–Westphal nuclei"
                },
                {
                  "type": "paragraph",
                  "text": "Oculomotor nerves — CN III (efferent limbs)"
                },
                {
                  "type": "paragraph",
                  "text": "Pupillary constriction in both eyes"
                },
                {
                  "type": "paragraph",
                  "text": "Memory tip: II detects, III constricts."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Cranial nerve II carries the sensory signal from the retina.",
                      "level": 0
                    },
                    {
                      "text": "Cranial nerve III carries the parasympathetic motor output that constricts the pupil.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pen_torch_subsection_9",
          "subsection_title": "8. Abnormal pupillary findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pen_torch_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Finding",
                    "Possible significance"
                  ],
                  "rows": [
                    [
                      "Pinpoint pupils",
                      "Opioid toxicity, pontine lesions or other causes"
                    ],
                    [
                      "Dilated, poorly reactive pupil",
                      "Drugs, ocular disease or neurological pathology"
                    ],
                    [
                      "Unequal pupils (anisocoria)",
                      "May be physiological; new anisocoria can indicate serious pathology"
                    ],
                    [
                      "No direct response in one eye when either eye is illuminated",
                      "May suggest an efferent defect in that eye, depending on the complete response pattern"
                    ],
                    [
                      "Reduced responses in both eyes",
                      "May reflect drug effects, ocular disease or neurological dysfunction"
                    ],
                    [
                      "One pupil dilates when light is swung onto that eye, relative to the other eye's response",
                      "May indicate a relative afferent pupillary defect"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Emergency warning: A newly dilated pupil with reduced consciousness, severe headache, recent head trauma or focal neurological deficits requires urgent assessment. Do not assume that an abnormal pupil is caused by medication without evaluating the clinical context."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pen_torch_subsection_10",
          "subsection_title": "9. The swinging flashlight test",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pen_torch_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/pen_torch_09.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "quizlet.com"
                },
                {
                  "type": "paragraph",
                  "text": "This test helps identify a relative afferent pupillary defect (RAPD), often associated with asymmetric optic nerve or severe retinal disease."
                }
              ]
            },
            {
              "group_id": "pen_torch_group_15",
              "group_title": "Procedure",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Ask the patient to look at a distant target.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Shine the torch into one eye for a few seconds.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Move the light promptly to the other eye.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Alternate between eyes while observing both pupils.",
                      "level": 0,
                      "label": "4."
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "pen_torch_group_16",
              "group_title": "Interpretation",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Normal: Both pupils remain constricted or constrict similarly as the light alternates.",
                      "level": 0
                    },
                    {
                      "text": "RAPD: When the light is moved from the better eye to the affected eye, both pupils may appear to dilate relatively because the afferent light signal is weaker.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A RAPD is not the same as an isolated third-nerve palsy. Interpret the findings with visual acuity, visual fields, eye movements and the rest of the examination."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pen_torch_subsection_11",
          "subsection_title": "10. Other common OSCE applications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pen_torch_group_17",
              "group_title": "Oral cavity and throat",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Use the pen torch to inspect:",
                  "items": [
                    {
                      "text": "Lips and oral mucosa.",
                      "level": 0
                    },
                    {
                      "text": "Tongue and floor of the mouth.",
                      "level": 0
                    },
                    {
                      "text": "Teeth and gums.",
                      "level": 0
                    },
                    {
                      "text": "Tonsils and posterior pharynx.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Ask the patient to open their mouth and say “ah” when examining the oropharynx. Use a tongue depressor if needed and appropriate."
                }
              ]
            },
            {
              "group_id": "pen_torch_group_18",
              "group_title": "Nose",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The torch may help illuminate the anterior nasal cavity during basic inspection. It does not provide the magnification or illumination control of dedicated ENT instruments."
                }
              ]
            },
            {
              "group_id": "pen_torch_group_19",
              "group_title": "Skin and superficial lesions",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A pen torch can improve visibility when inspecting superficial lesions, rashes or wounds. It does not establish a diagnosis on its own."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pen_torch_subsection_12",
          "subsection_title": "11. Pediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pen_torch_group_20",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Explain the examination in child-friendly language.",
                      "level": 0
                    },
                    {
                      "text": "Demonstrate the light on your own hand first if the child is anxious.",
                      "level": 0
                    },
                    {
                      "text": "Keep the examination brief and allow the child to look at a distant object or caregiver.",
                      "level": 0
                    },
                    {
                      "text": "Avoid forcing the examination if the child is distressed unless an urgent assessment is necessary.",
                      "level": 0
                    },
                    {
                      "text": "In infants, interpret pupil findings alongside age-appropriate neurological and general examinations.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pen_torch_subsection_13",
          "subsection_title": "12. Common examiner questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pen_torch_group_21",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is a pen torch used for?"
                },
                {
                  "type": "paragraph",
                  "text": "It provides illumination during clinical examination, especially for assessing pupils, the oral cavity and other accessible areas."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is the difference between direct and consensual light reflexes?"
                },
                {
                  "type": "paragraph",
                  "text": "The direct reflex is constriction of the illuminated pupil; the consensual reflex is constriction of the opposite pupil."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Which cranial nerves mediate the pupillary light reflex?"
                },
                {
                  "type": "paragraph",
                  "text": "CN II is the afferent limb and CN III is the efferent limb."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Why should the patient look at a distant target?"
                },
                {
                  "type": "paragraph",
                  "text": "To minimize accommodation and its associated pupillary constriction."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What is anisocoria?"
                },
                {
                  "type": "paragraph",
                  "text": "Unequal pupil size. It can be physiological, but new or symptomatic anisocoria may indicate significant ocular or neurological disease."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What is the swinging flashlight test used for?"
                },
                {
                  "type": "paragraph",
                  "text": "To assess for a relative afferent pupillary defect, which can suggest asymmetric optic nerve or retinal dysfunction."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. Can a pen torch replace an ophthalmoscope?"
                },
                {
                  "type": "paragraph",
                  "text": "No. A pen torch provides basic illumination, whereas an ophthalmoscope allows examination of internal ocular structures such as the optic disc and retina."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "pen_torch_subsection_14",
          "subsection_title": "13. Mini OSCE station",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "pen_torch_group_22",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Station: Examine the pupils of a patient presenting with headache."
                },
                {
                  "type": "list",
                  "title": "A strong candidate should:",
                  "items": [
                    {
                      "text": "Introduce themselves, explain the procedure and obtain consent.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Inspect pupil size, shape and symmetry.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Test the direct and consensual light reflexes in both eyes.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Perform the swinging flashlight test when indicated.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Document findings clearly.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Identify concerning findings and explain the need for further neurological or ophthalmic assessment.",
                      "level": 0,
                      "label": "6."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Example normal report:"
                },
                {
                  "type": "paragraph",
                  "text": "“Both pupils are equal and round. Direct and consensual light reflexes are present bilaterally. There is no relative afferent pupillary defect on swinging flashlight testing.”",
                  "style": "quote"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}