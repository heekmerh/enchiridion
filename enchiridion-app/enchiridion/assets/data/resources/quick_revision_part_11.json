        {
          "subsection_id": "quick_revision_part_11_subsection_3",
          "subsection_title": "EXCHANGE BLOOD TRANSFUSION",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_11_group_3",
              "group_title": "A. Types of exchange blood transfusion",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Double-volume exchange transfusion: Replaces approximately twice the infant’s estimated circulating blood volume; standard method for severe neonatal hyperbilirubinaemia."
                },
                {
                  "type": "paragraph",
                  "text": "Single-volume exchange transfusion: Replaces approximately one estimated circulating blood volume; less effective at removing bilirubin."
                },
                {
                  "type": "paragraph",
                  "text": "Isovolumetric exchange transfusion: Blood is withdrawn and replaced in equal volumes to maintain circulating volume."
                },
                {
                  "type": "paragraph",
                  "text": "Partial exchange transfusion: Replaces only part of the circulating blood; used for selected conditions such as symptomatic neonatal polycythaemia."
                },
                {
                  "type": "paragraph",
                  "text": "Manual exchange transfusion: Small aliquots of blood are withdrawn and replaced sequentially."
                },
                {
                  "type": "paragraph",
                  "text": "Automated exchange transfusion: Uses an apheresis machine; commonly used for selected haemoglobinopathies, including sickle cell disease."
                }
              ]
            },
            {
              "group_id": "quick_revision_part_11_group_4",
              "group_title": "B. Indications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "A. Neonatal hyperbilirubinaemia"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Total serum bilirubin at or above the exchange-transfusion threshold for the infant’s age in hours, gestational age and neurotoxicity risk factors."
                },
                {
                  "type": "paragraph",
                  "text": "Bilirubin rising despite intensive phototherapy when exchange is indicated by the applicable guideline."
                },
                {
                  "type": "paragraph",
                  "text": "Signs of acute bilirubin encephalopathy, such as:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Hypertonia",
                    "Arching of the neck or back",
                    "High-pitched cry",
                    "Recurrent apnoea",
                    "Seizures",
                    "Reduced consciousness",
                    "B. Haemolytic disease of the newborn"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Severe Rh or ABO incompatibility with significant hyperbilirubinaemia."
                },
                {
                  "type": "paragraph",
                  "text": "Severe haemolytic anaemia with an appropriate exchange indication."
                },
                {
                  "type": "checklist",
                  "items": [
                    "C. Neonatal polycythaemia",
                    "Selected symptomatic infants requiring partial exchange transfusion.",
                    "D. Haematological indications"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Severe sickle cell complications requiring red-cell exchange, e.g. selected cases of acute stroke or severe acute chest syndrome."
                },
                {
                  "type": "paragraph",
                  "text": "Selected severe parasitaemia cases under specialist protocols."
                }
              ]
            },
            {
              "group_id": "quick_revision_part_11_group_5",
              "group_title": "C. Procedure: neonatal double-volume exchange transfusion",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "1. Confirm indication"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Review total serum bilirubin, age in hours, gestational age and neurotoxicity risk factors."
                },
                {
                  "type": "paragraph",
                  "text": "Obtain informed consent from the parent or guardian."
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Prepare the infant"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Perform the procedure in a neonatal intensive care setting."
                },
                {
                  "type": "paragraph",
                  "text": "Maintain temperature and cardiorespiratory monitoring."
                },
                {
                  "type": "paragraph",
                  "text": "Keep the infant nil by mouth as locally indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Establish reliable vascular access."
                },
                {
                  "type": "paragraph",
                  "text": "Continue intensive phototherapy before, during and after the procedure as appropriate."
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Prepare blood"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Use compatible, appropriately screened and crossmatched blood prepared according to neonatal transfusion policy."
                },
                {
                  "type": "paragraph",
                  "text": "Select blood components and compatibility requirements based on the cause of haemolysis and local transfusion-service protocol."
                },
                {
                  "type": "paragraph",
                  "text": "Warm blood using an approved blood warmer."
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Calculate exchange volume"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Estimated blood volume in a term neonate: approximately 80–90 mL/kg."
                },
                {
                  "type": "paragraph",
                  "text": "Double-volume exchange: approximately 160–180 mL/kg."
                },
                {
                  "type": "paragraph",
                  "text": "Use the neonatal unit’s prescribed estimate and protocol."
                },
                {
                  "type": "checklist",
                  "items": [
                    "5. Perform the exchange"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Usually through an umbilical venous catheter, using an approved single-catheter push–pull method, or a validated alternative access technique."
                },
                {
                  "type": "paragraph",
                  "text": "Withdraw a small, prescribed aliquot of the infant’s blood."
                },
                {
                  "type": "paragraph",
                  "text": "Replace it with an equal volume of donor blood."
                },
                {
                  "type": "paragraph",
                  "text": "Repeat sequentially until the calculated exchange volume is completed."
                },
                {
                  "type": "paragraph",
                  "text": "Maintain strict aseptic technique and accurate input/output records."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid rapid volume changes and haemodynamic instability."
                },
                {
                  "type": "checklist",
                  "items": [
                    "6. Monitor throughout"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Heart rate, respiratory rate, oxygen saturation, blood pressure and temperature."
                },
                {
                  "type": "paragraph",
                  "text": "Blood glucose, calcium, potassium and acid–base status as indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Observe for arrhythmias, bleeding and transfusion reactions."
                },
                {
                  "type": "checklist",
                  "items": [
                    "7. After the procedure"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Recheck bilirubin, full blood count, glucose, electrolytes and other tests as clinically indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Continue phototherapy when indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Monitor for rebound hyperbilirubinaemia."
                },
                {
                  "type": "paragraph",
                  "text": "Observe for delayed complications and catheter-related problems."
                },
                {
                  "type": "paragraph",
                  "text": "Important: Exchange transfusion is a high-risk procedure performed by a trained neonatal team. Exact aliquot volumes, blood specifications, vascular access and monitoring must follow the institutional neonatal transfusion protocol."
                }
              ]
            },
