        {
          "subsection_id": "mayo_scissors_subsection_2",
          "subsection_title": "1. Introduction and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mayo_scissors_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Mayo scissors are heavy-duty surgical scissors used primarily for cutting dense tissues, fascia, sutures and other materials, depending on their design."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Category: Cutting and dissecting instrument.",
                      "level": 0
                    },
                    {
                      "text": "Primary function: Cutting relatively tough tissues and surgical materials.",
                      "level": 0
                    },
                    {
                      "text": "Material: Usually stainless steel.",
                      "level": 0
                    },
                    {
                      "text": "Construction: Two blades joined by a pivot, with finger rings and shanks.",
                      "level": 0
                    },
                    {
                      "text": "Design: Available in straight and curved forms.",
                      "level": 0
                    },
                    {
                      "text": "Sterility: Reusable instruments must be appropriately cleaned, inspected and sterilised before use.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "mayo_scissors_group_3",
              "group_title": "How to identify Mayo scissors in an OSCE",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Look for:",
                  "items": [
                    {
                      "text": "Two relatively broad, robust blades.",
                      "level": 0
                    },
                    {
                      "text": "A substantial, sturdy construction compared with finer dissecting scissors.",
                      "level": 0
                    },
                    {
                      "text": "Two finger rings.",
                      "level": 0
                    },
                    {
                      "text": "A central pivot or screw joint.",
                      "level": 0
                    },
                    {
                      "text": "Either straight or curved blades.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Model identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“These are Mayo scissors, heavy-duty surgical scissors used for cutting dense tissues such as fascia and, depending on the design, surgical sutures and other materials.”",
                  "style": "quote"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mayo_scissors_subsection_3",
          "subsection_title": "2. Labelling of Mayo scissors",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mayo_scissors_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/mayo_scissors_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "The main parts to label are"
                },
                {
                  "type": "paragraph",
                  "text": "1. Finger rings"
                },
                {
                  "type": "paragraph",
                  "text": "Rings through which the operator places the fingers and thumb to control opening and closing."
                },
                {
                  "type": "paragraph",
                  "text": "2. Shanks"
                },
                {
                  "type": "paragraph",
                  "text": "The sections connecting the finger rings to the blades and transmitting movement."
                },
                {
                  "type": "paragraph",
                  "text": "3. Pivot or joint"
                },
                {
                  "type": "paragraph",
                  "text": "The point around which the two halves rotate."
                },
                {
                  "type": "paragraph",
                  "text": "4. Blades"
                },
                {
                  "type": "paragraph",
                  "text": "The robust cutting portions that meet during closure."
                },
                {
                  "type": "paragraph",
                  "text": "5. Tips"
                },
                {
                  "type": "paragraph",
                  "text": "The terminal ends of the blades. Depending on the model, they may be pointed or blunt."
                },
                {
                  "type": "paragraph",
                  "text": "6. Cutting edges"
                },
                {
                  "type": "paragraph",
                  "text": "The sharpened inner edges that cut material as the blades close."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE tip: Do not confuse the pivot with the tips. The pivot is the joint near the middle; the tips are at the distal ends."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mayo_scissors_subsection_4",
          "subsection_title": "3. Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mayo_scissors_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/mayo_scissors_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A. Straight Mayo scissors"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Blades follow a straight profile.",
                      "level": 0
                    },
                    {
                      "text": "Commonly used for cutting sutures, dressings and surgical materials.",
                      "level": 0
                    },
                    {
                      "text": "May also be used for suitable superficial tissues when appropriate.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/mayo_scissors_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "B. Curved Mayo scissors"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Blades have a curved profile.",
                      "level": 0
                    },
                    {
                      "text": "Commonly used for cutting dense tissues, particularly fascia, during open surgery.",
                      "level": 0
                    },
                    {
                      "text": "The curve can help the operator follow tissue planes.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Mayo scissors can also vary by length, tip design and intended application."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mayo_scissors_subsection_5",
          "subsection_title": "4. Principles of use",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mayo_scissors_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The principle is to cut the intended tissue or material with controlled closure of the blades while minimising injury to surrounding structures."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Select the appropriate scissors: Choose the design according to the material or tissue.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Maintain visual control: Know what lies between the blades before closing them.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Use controlled movements: Avoid forceful closure if the scissors meet resistance.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Respect tissue planes: When dissecting, follow the intended anatomical plane.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Preserve instrument integrity: Ensure the blades are aligned, the pivot is secure and the cutting edges are functional.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Maintain asepsis: Use an appropriately processed instrument in the operative field.",
                      "level": 0,
                      "label": "6."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important: Do not use tissue scissors indiscriminately to cut sutures, dressings or other materials. Follow the instrument's intended use to avoid damaging its cutting edges or contaminating the operative field."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mayo_scissors_subsection_6",
          "subsection_title": "5. Uses and surgeries",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mayo_scissors_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Clinical setting",
                    "Application"
                  ],
                  "rows": [
                    [
                      "General surgery",
                      "Cutting fascia and dense connective tissue"
                    ],
                    [
                      "Abdominal surgery",
                      "Dividing appropriate fibrous tissue during laparotomy"
                    ],
                    [
                      "Hernia repair",
                      "Cutting or trimming suitable tissue and materials"
                    ],
                    [
                      "Orthopaedic surgery",
                      "Selected soft-tissue and fascial cutting"
                    ],
                    [
                      "Caesarean delivery",
                      "Selected tissue-cutting steps, according to the operative technique"
                    ],
                    [
                      "Wound closure",
                      "Cutting sutures, particularly with suitable straight scissors"
                    ],
                    [
                      "Dressing procedures",
                      "Cutting dressings or other materials with an appropriate designated instrument"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Mayo scissors are not primarily designed for delicate dissection immediately adjacent to fragile structures such as nerves and small vessels."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mayo_scissors_subsection_7",
          "subsection_title": "6. Advantages and disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mayo_scissors_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Advantages"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Strong construction suitable for relatively dense tissues.",
                      "level": 0
                    },
                    {
                      "text": "Versatile straight and curved designs.",
                      "level": 0
                    },
                    {
                      "text": "Reusable when designed for reprocessing.",
                      "level": 0
                    },
                    {
                      "text": "Good cutting capability for appropriate surgical materials.",
                      "level": 0
                    },
                    {
                      "text": "Simple mechanical operation without a power source.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Disadvantages"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Bulkier and less delicate than Metzenbaum scissors.",
                      "level": 0
                    },
                    {
                      "text": "May cause unnecessary tissue trauma if used for fine dissection.",
                      "level": 0
                    },
                    {
                      "text": "Blunt or misaligned blades may crush rather than cut tissue cleanly.",
                      "level": 0
                    },
                    {
                      "text": "Poor technique can injure adjacent structures.",
                      "level": 0
                    },
                    {
                      "text": "Reusable instruments require appropriate cleaning, inspection and sterilisation.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mayo_scissors_subsection_8",
          "subsection_title": "7. Complications and risks",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mayo_scissors_group_9",
              "group_title": "Patient-related complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Injury to adjacent vessels, nerves or organs.",
                      "level": 0
                    },
                    {
                      "text": "Unintended tissue division.",
                      "level": 0
                    },
                    {
                      "text": "Bleeding from cut vessels.",
                      "level": 0
                    },
                    {
                      "text": "Excessive tissue trauma or crushing from defective blades.",
                      "level": 0
                    },
                    {
                      "text": "Wound contamination if aseptic technique is breached.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "mayo_scissors_group_10",
              "group_title": "Instrument-related problems",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Blunt or damaged cutting edges.",
                      "level": 0
                    },
                    {
                      "text": "Loose or defective pivot.",
                      "level": 0
                    },
                    {
                      "text": "Poor blade alignment.",
                      "level": 0
                    },
                    {
                      "text": "Stiff movement or excessive friction.",
                      "level": 0
                    },
                    {
                      "text": "Corrosion or other damage from inadequate maintenance.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Before use, the instrument should be inspected for smooth movement, secure construction, proper alignment and effective cutting action."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mayo_scissors_subsection_9",
          "subsection_title": "8. Mayo scissors versus Metzenbaum scissors",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mayo_scissors_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This is one of the most important surgical instrument OSCE distinctions."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/mayo_scissors_07.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Mayo scissors",
                    "Metzenbaum scissors"
                  ],
                  "rows": [
                    [
                      "Construction",
                      "Heavy-duty, robust",
                      "Slender, delicate"
                    ],
                    [
                      "Blades",
                      "Relatively broad",
                      "Narrow and fine"
                    ],
                    [
                      "Main purpose",
                      "Dense tissue, fascia and suitable materials",
                      "Delicate soft-tissue dissection"
                    ],
                    [
                      "Typical application",
                      "Fascial division",
                      "Fine dissection around delicate structures"
                    ],
                    [
                      "Tissue handling",
                      "Less suitable for delicate dissection",
                      "Better suited to delicate tissue planes"
                    ],
                    [
                      "Suture cutting",
                      "Commonly used in suitable straight designs",
                      "Generally avoided to preserve fine cutting edges"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Memory aid: Mayo = More robust; Metzenbaum = More delicate."
                },
                {
                  "type": "paragraph",
                  "text": "Do not assume every straight Mayo scissor is exclusively for sutures or every curved Mayo scissor exclusively for fascia. These are common associations, not absolute restrictions."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mayo_scissors_subsection_10",
          "subsection_title": "9. Common OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mayo_scissors_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is this instrument?"
                },
                {
                  "type": "paragraph",
                  "text": "Mayo scissors, a heavy-duty surgical cutting instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What are the two main types?"
                },
                {
                  "type": "paragraph",
                  "text": "Straight Mayo scissors and curved Mayo scissors."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Which type is commonly used for fascia?"
                },
                {
                  "type": "paragraph",
                  "text": "Curved Mayo scissors are commonly used for cutting fascia."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Which scissors are better suited to delicate tissue dissection?"
                },
                {
                  "type": "paragraph",
                  "text": "Metzenbaum scissors."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What is the pivot?"
                },
                {
                  "type": "paragraph",
                  "text": "The joint around which the two halves of the scissors rotate."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Why should blunt scissors be removed from service?"
                },
                {
                  "type": "paragraph",
                  "text": "They may crush or damage tissue rather than produce a clean cut."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What complications may occur?"
                },
                {
                  "type": "paragraph",
                  "text": "Haemorrhage, unintended tissue injury, damage to adjacent structures and wound contamination."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. What should you inspect before use?"
                },
                {
                  "type": "paragraph",
                  "text": "Blade sharpness and alignment, pivot integrity, smooth movement and overall cleanliness and condition."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "mayo_scissors_subsection_11",
          "subsection_title": "10. High-yield revision card",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "mayo_scissors_group_13",
              "group_title": "Mayo scissors — must know",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Category: Cutting instrument.",
                      "level": 0
                    },
                    {
                      "text": "Identifying feature: Robust blades and finger rings.",
                      "level": 0
                    },
                    {
                      "text": "Straight type: Commonly used for sutures and suitable materials.",
                      "level": 0
                    },
                    {
                      "text": "Curved type: Commonly used for dense tissues such as fascia.",
                      "level": 0
                    },
                    {
                      "text": "Main comparison: More robust than Metzenbaum scissors.",
                      "level": 0
                    },
                    {
                      "text": "Major risk: Unintended tissue injury.",
                      "level": 0
                    },
                    {
                      "text": "Safety principle: Select the correct scissors for the intended tissue or material.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "**Model 30-second OSCE presentation**",
                  "style": "heading"
                },
                {
                  "type": "paragraph",
                  "text": "“These are Mayo scissors, heavy-duty surgical scissors used for cutting dense tissues such as fascia and, depending on their design, sutures and other materials. They have two finger rings, shanks, a pivot, blades and tips. They are available in straight and curved forms. They are robust and versatile but are less suitable than Metzenbaum scissors for delicate tissue dissection. Complications include unintended tissue injury, haemorrhage and damage caused by blunt or misaligned blades.”",
                  "style": "quote"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}