        {
          "subsection_id": "metzenbaum_scissors_subsection_2",
          "subsection_title": "1. Introduction and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "metzenbaum_scissors_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Metzenbaum scissors are delicate surgical scissors designed primarily for dissecting and cutting soft tissues. They are commonly used when precision is required and unnecessary trauma to surrounding structures must be minimised."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Category: Cutting and dissecting instrument.",
                      "level": 0
                    },
                    {
                      "text": "Primary function: Dissection and division of delicate soft tissues.",
                      "level": 0
                    },
                    {
                      "text": "Material: Usually stainless steel.",
                      "level": 0
                    },
                    {
                      "text": "Construction: Two slender blades, long shanks, finger rings and a pivot joint.",
                      "level": 0
                    },
                    {
                      "text": "Types: Straight and curved.",
                      "level": 0
                    },
                    {
                      "text": "Sterility: Reusable instruments must be appropriately cleaned, inspected and sterilised before use.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "metzenbaum_scissors_group_3",
              "group_title": "How to identify them in an OSCE",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Look for:",
                  "items": [
                    {
                      "text": "Long, slender shanks.",
                      "level": 0
                    },
                    {
                      "text": "Relatively delicate, narrow blades.",
                      "level": 0
                    },
                    {
                      "text": "Finger rings and a central pivot.",
                      "level": 0
                    },
                    {
                      "text": "A fine cutting profile compared with the more robust Mayo scissors.",
                      "level": 0
                    },
                    {
                      "text": "Straight or curved blades, with curved versions commonly encountered in operating theatres.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Model identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“These are Metzenbaum scissors, delicate surgical scissors used primarily for dissecting and cutting soft tissues during surgical procedures.”",
                  "style": "quote"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "metzenbaum_scissors_subsection_3",
          "subsection_title": "2. Labelling of Metzenbaum scissors",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "metzenbaum_scissors_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/metzenbaum_scissors_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "slideshare.net"
                },
                {
                  "type": "paragraph",
                  "text": "The main parts to label are:"
                },
                {
                  "type": "paragraph",
                  "text": "1. Finger rings"
                },
                {
                  "type": "paragraph",
                  "text": "The rings through which the thumb and finger are placed to control opening and closing."
                },
                {
                  "type": "paragraph",
                  "text": "2. Shanks"
                },
                {
                  "type": "paragraph",
                  "text": "The elongated sections between the rings and the blades. Their length helps provide reach during dissection."
                },
                {
                  "type": "paragraph",
                  "text": "3. Pivot joint"
                },
                {
                  "type": "paragraph",
                  "text": "The joint around which the two halves rotate."
                },
                {
                  "type": "paragraph",
                  "text": "4. Blades"
                },
                {
                  "type": "paragraph",
                  "text": "The slender cutting portions designed for delicate tissue dissection."
                },
                {
                  "type": "paragraph",
                  "text": "5. Tips"
                },
                {
                  "type": "paragraph",
                  "text": "The distal ends of the blades. Many common models have blunt or rounded tips, although designs vary."
                },
                {
                  "type": "paragraph",
                  "text": "6. Cutting edges"
                },
                {
                  "type": "paragraph",
                  "text": "The inner sharpened edges that divide tissue when the blades close."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE tip: When asked to label the instrument, identify the finger rings, shanks, pivot, blades, tips and cutting edges. Do not assume every model has identical tip geometry."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "metzenbaum_scissors_subsection_4",
          "subsection_title": "3. Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "metzenbaum_scissors_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/metzenbaum_scissors_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A. Straight Metzenbaum scissors"
                },
                {
                  "type": "paragraph",
                  "text": "Used for selected superficial soft-tissue dissection and cutting when a straight instrument is appropriate."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/metzenbaum_scissors_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "B. Curved Metzenbaum scissors"
                },
                {
                  "type": "paragraph",
                  "text": "Commonly used for dissection in soft-tissue planes, particularly where a curved profile assists access and controlled tissue separation."
                },
                {
                  "type": "paragraph",
                  "text": "They are also available in different lengths and tip configurations to suit different surgical requirements."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "metzenbaum_scissors_subsection_5",
          "subsection_title": "4. Principles of use",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "metzenbaum_scissors_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The fundamental principle is to divide or dissect soft tissue with controlled movements while minimising trauma to adjacent anatomical structures."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Select the correct instrument: Use Metzenbaum scissors for suitable delicate tissue work.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Maintain visualisation: Know which tissues lie between the blades.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Use controlled movements: Avoid forceful or blind closure.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Follow tissue planes: Dissect along the intended anatomical plane.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Protect adjacent structures: Take particular care around nerves, vessels and organs.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Preserve the instrument: Avoid using delicate scissors on dense materials that may damage their cutting edges.",
                      "level": 0,
                      "label": "6."
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "metzenbaum_scissors_group_7",
              "group_title": "Important safety point",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Metzenbaum scissors are not intended to be universal cutting scissors. Using them to cut sutures, wires, thick fascia or other unsuitable materials may blunt or damage their delicate blades. Use a more appropriate instrument for those tasks."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "metzenbaum_scissors_subsection_6",
          "subsection_title": "5. Uses and surgeries",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "metzenbaum_scissors_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Specialty or procedure",
