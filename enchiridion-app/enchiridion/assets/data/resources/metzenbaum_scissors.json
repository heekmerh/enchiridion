                    ],
                    [
                      "Breast surgery",
                      "Soft-tissue dissection during selected breast procedures"
                    ],
                    [
                      "Thyroid surgery",
                      "Selected delicate tissue dissection, with appropriate protection of adjacent structures"
                    ],
                    [
                      "Vascular surgery",
                      "Selected soft-tissue dissection around operative structures"
                    ],
                    [
                      "Plastic surgery",
                      "Delicate tissue dissection during reconstructive procedures"
                    ],
                    [
                      "Gynaecological surgery",
                      "Dissection of suitable soft tissues during open operations"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The instrument is chosen according to the tissue and operative step. Its presence does not mean that it should be used directly against every delicate structure."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "metzenbaum_scissors_subsection_7",
          "subsection_title": "6. Advantages and disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "metzenbaum_scissors_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Advantages"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Fine blades allow precise soft-tissue dissection.",
                      "level": 0
                    },
                    {
                      "text": "Slender construction improves access to narrow operative spaces.",
                      "level": 0
                    },
                    {
                      "text": "Long shanks provide reach into deeper surgical fields.",
                      "level": 0
                    },
                    {
                      "text": "Curved models can help follow tissue planes.",
                      "level": 0
                    },
                    {
                      "text": "Reusable versions can be reprocessed according to their instructions for use.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Disadvantages"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Delicate blades may be damaged by inappropriate use.",
                      "level": 0
                    },
                    {
                      "text": "Less suitable for dense tissues and heavy-duty cutting.",
                      "level": 0
                    },
                    {
                      "text": "Can injure vessels, nerves or organs if used carelessly.",
                      "level": 0
                    },
                    {
                      "text": "Blunt blades may crush tissue rather than cut cleanly.",
                      "level": 0
                    },
                    {
                      "text": "Require inspection and appropriate reprocessing between procedures.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "metzenbaum_scissors_subsection_8",
          "subsection_title": "7. Complications and instrument-related problems",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "metzenbaum_scissors_group_10",
              "group_title": "Patient-related complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Haemorrhage from inadvertent vessel injury.",
                      "level": 0
                    },
                    {
                      "text": "Injury to nerves, tendons or adjacent organs.",
                      "level": 0
                    },
                    {
                      "text": "Unintended tissue division.",
                      "level": 0
                    },
                    {
                      "text": "Excessive tissue trauma or crushing.",
                      "level": 0
                    },
                    {
                      "text": "Wound contamination or infection if aseptic technique is breached.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "metzenbaum_scissors_group_11",
              "group_title": "Instrument-related problems",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Blunted or damaged cutting edges.",
                      "level": 0
                    },
                    {
                      "text": "Misalignment of the blades.",
                      "level": 0
                    },
                    {
                      "text": "A loose or damaged pivot.",
                      "level": 0
                    },
                    {
                      "text": "Stiff movement or corrosion.",
                      "level": 0
                    },
                    {
                      "text": "Damage caused by using the scissors to cut unsuitable materials.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Before use, inspect the instrument for proper alignment, smooth movement, intact tips and effective cutting action."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "metzenbaum_scissors_subsection_9",
          "subsection_title": "8. Metzenbaum scissors versus Mayo scissors",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "metzenbaum_scissors_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This comparison is particularly important in instrument identification stations."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/metzenbaum_scissors_06.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Metzenbaum scissors",
                    "Mayo scissors"
                  ],
                  "rows": [
                    [
                      "Construction",
                      "Delicate and slender",
                      "Robust and heavy-duty"
                    ],
                    [
                      "Blades",
                      "Narrow, fine",
                      "Relatively broad"
                    ],
                    [
                      "Main purpose",
                      "Delicate soft-tissue dissection",
                      "Dense tissue, fascia and suitable materials"
                    ],
                    [
                      "Typical use",
                      "Dissecting soft-tissue planes",
                      "Cutting fascia"
                    ],
                    [
                      "Sutures",
                      "Generally avoid using them to preserve their fine edges",
                      "Commonly cut with suitable straight Mayo scissors"
                    ],
                    [
                      "Key distinction",
                      "Precision",
                      "Strength"
                    ]
                  ]
                },
                {
                  "type": "list",
                  "title": "Memory aid:",
                  "items": [
                    {
                      "text": "Metzenbaum = meticulous dissection.",
                      "level": 0
                    },
                    {
                      "text": "Mayo = more muscular scissors.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These are useful examination associations rather than absolute rules for every instrument design."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "metzenbaum_scissors_subsection_10",
          "subsection_title": "9. Common OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "metzenbaum_scissors_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is this instrument?"
                },
                {
                  "type": "paragraph",
                  "text": "Metzenbaum scissors, a delicate surgical instrument used primarily for soft-tissue dissection."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. How do you distinguish Metzenbaum from Mayo scissors?"
                },
                {
                  "type": "paragraph",
                  "text": "Metzenbaum scissors have a more slender, delicate construction, whereas Mayo scissors have more robust blades."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What are the main types?"
                },
                {
                  "type": "paragraph",
                  "text": "Straight and curved Metzenbaum scissors."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Why should you not routinely use them to cut sutures?"
                },
                {
                  "type": "paragraph",
                  "text": "Cutting unsuitable materials may damage or blunt the delicate cutting edges."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. Why are they useful for delicate dissection?"
                },
                {
                  "type": "paragraph",
                  "text": "Their slender construction and fine blades permit controlled dissection in suitable soft-tissue planes."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What complications may occur?"
                },
                {
                  "type": "paragraph",
                  "text": "Bleeding, injury to adjacent structures, unintended tissue division and wound contamination."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What should you check before using them?"
                },
                {
                  "type": "paragraph",
                  "text": "Blade alignment, sharpness, tip integrity, smooth movement and the condition of the pivot."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "metzenbaum_scissors_subsection_11",
          "subsection_title": "10. High-yield revision card",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "metzenbaum_scissors_group_14",
              "group_title": "Metzenbaum scissors — must know",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Category: Cutting and dissecting instrument.",
                      "level": 0
                    },
                    {
                      "text": "Identifying feature: Long, slender shanks and delicate blades.",
                      "level": 0
                    },
                    {
                      "text": "Primary use: Soft-tissue dissection.",
                      "level": 0
                    },
                    {
                      "text": "Types: Straight and curved.",
                      "level": 0
                    },
                    {
                      "text": "Main comparison: More delicate than Mayo scissors.",
                      "level": 0
                    },
                    {
                      "text": "Major risk: Injury to adjacent structures during dissection.",
                      "level": 0
                    },
                    {
                      "text": "Safety principle: Use only for appropriate tissues and inspect before use.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "**Model 30-second OSCE presentation**",
                  "style": "heading"
                },
                {
                  "type": "paragraph",
                  "text": "“These are Metzenbaum scissors, delicate surgical scissors used primarily for dissecting and cutting soft tissues. They consist of finger rings, shanks, a pivot joint, slender blades and tips. They are available in straight and curved forms. Their main advantage is precision during soft-tissue dissection, but they are less suitable for dense tissues or cutting materials that may damage their fine edges. Complications include bleeding, injury to adjacent structures and tissue trauma.”",
                  "style": "quote"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}