{
  "chapter_metadata": {
    "chapter_id": "joints_examination",
    "chapter_title": "Joints examination",
    "chapter_icon": null,
    "description": null,
    "position_in_book": 1,
    "tags": [
      "Joints examination"
    ],
    "chapter_color": null
  },
  "sections": [
    {
      "section_id": "joints_examination_section_1",
      "section_title": "Joints examination",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "joints_examination_subsection_1",
          "subsection_title": "Objectives of the examination",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "joints_examination_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "By the end of this guide, you should be able to:"
                },
                {
                  "type": "paragraph",
                  "text": "Examine joints systematically using inspection, palpation, movement and special tests."
                },
                {
                  "type": "paragraph",
                  "text": "Identify inflammatory, degenerative, traumatic and infective joint pathology."
                },
                {
                  "type": "paragraph",
                  "text": "Distinguish normal from abnormal findings."
                },
                {
                  "type": "paragraph",
                  "text": "Recognise joint effusions, deformities, instability and restricted movement."
                },
                {
                  "type": "paragraph",
                  "text": "Present findings in a structured OSCE format."
                },
                {
                  "type": "paragraph",
                  "text": "Identify red flags requiring urgent assessment."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "joints_examination_subsection_2",
          "subsection_title": "The general approach: Look, Feel, Move, Function",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "joints_examination_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/medical/joints_examination_01.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Look"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the joint for swelling, redness, deformity, scars, muscle wasting and asymmetry."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/medical/joints_examination_02.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Feel"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Assess temperature, tenderness, swelling, effusion and relevant bony landmarks."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/medical/joints_examination_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Move"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Assess active and passive range of motion, pain, crepitus and any mechanical restriction."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/medical/joints_examination_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Function"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Assess strength, stability and relevant activities such as walking, gripping, standing or climbing stairs."
                },
                {
                  "type": "paragraph",
                  "text": "Important: Always compare both sides, examine the joint above and below when relevant, and adapt the examination to the joint and suspected pathology."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "joints_examination_subsection_3",
          "subsection_title": "Preparation and introduction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "joints_examination_group_3",
              "group_title": "Equipment",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Depending on the joint and station, you may need:"
                },
                {
                  "type": "paragraph",
                  "text": "Examination couch."
                },
                {
                  "type": "paragraph",
                  "text": "Goniometer for measuring range of motion."
                },
                {
                  "type": "paragraph",
                  "text": "Measuring tape."
                },
                {
                  "type": "paragraph",
                  "text": "Reflex hammer where neurological assessment is relevant."
                },
                {
                  "type": "paragraph",
                  "text": "Appropriate examination gloves if a wound is present."
                }
              ]
            },
            {
              "group_id": "joints_examination_group_4",
              "group_title": "Introduction",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“Good morning. My name is … I have been asked to examine your joint. I will inspect it, feel around it, assess its movements and perform some specific tests if necessary. Some movements may cause discomfort, so please let me know if you experience pain. Is that alright?”"
                },
                {
                  "type": "paragraph",
                  "text": "Then:"
                },
                {
                  "type": "paragraph",
                  "text": "Confirm the patient's identity."
                },
                {
                  "type": "paragraph",
                  "text": "Explain the procedure and obtain consent."
                },
                {
                  "type": "paragraph",
                  "text": "Ask about pain before beginning."
                },
                {
                  "type": "paragraph",
                  "text": "Expose the joint adequately while maintaining privacy."
                },
                {
                  "type": "paragraph",
                  "text": "Position the patient comfortably."
                },
                {
                  "type": "paragraph",
                  "text": "Wash your hands."
                },
                {
                  "type": "paragraph",
                  "text": "Offer a chaperone if appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "If the joint is acutely painful, severely swollen or suspected to be fractured or infected, avoid forceful movements or provocative tests."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "joints_examination_subsection_4",
          "subsection_title": "History you should know before examining",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "joints_examination_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Although this is an examination station, the examiner may ask what history you would obtain."
                },
                {
                  "type": "paragraph",
                  "text": "Ask about:"
                },
                {
                  "type": "paragraph",
                  "text": "Onset: sudden or gradual."
                },
                {
                  "type": "paragraph",
                  "text": "Duration and progression."
                },
                {
                  "type": "paragraph",
                  "text": "Site and number of joints involved."
                },
                {
                  "type": "paragraph",
                  "text": "Pain severity and character."
                },
                {
                  "type": "paragraph",
                  "text": "Morning stiffness and its duration."
                },
                {
                  "type": "paragraph",
                  "text": "Swelling, redness and warmth."
                },
                {
                  "type": "paragraph",
                  "text": "Restriction of movement."
                },
                {
                  "type": "paragraph",
                  "text": "Trauma or repetitive use."
                },
                {
                  "type": "paragraph",
                  "text": "Fever or systemic symptoms."
                },
                {
                  "type": "paragraph",
                  "text": "Previous episodes."
                },
                {
                  "type": "paragraph",
                  "text": "Other joint symptoms."
                },
                {
                  "type": "paragraph",
                  "text": "Functional limitations."
                },
                {
                  "type": "paragraph",
                  "text": "Relevant medical history, medications and family history."
                }
              ]
            },
            {
              "group_id": "joints_examination_group_6",
              "group_title": "Clinical clues",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Possible interpretation"
                  ],
                  "rows": [
                    [
                      "Morning stiffness lasting over 30–60 minutes",
                      "Suggests inflammatory arthritis"
                    ],
                    [
                      "Pain worse with activity and relieved by rest",
                      "Often associated with osteoarthritis"
                    ],
                    [
                      "Acute hot, swollen, painful joint",
                      "Septic arthritis or crystal arthritis must be considered"
                    ],
                    [
                      "Symmetrical small-joint involvement",
                      "May suggest rheumatoid arthritis"
                    ],
                    [
                      "Joint pain after trauma",
                      "Consider fracture, ligament injury or haemarthrosis"
                    ],
                    [
                      "Joint locking",
                      "May indicate a mechanical problem, such as a loose body or meniscal pathology in the knee"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These features guide the differential diagnosis but are not diagnostic on their own."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "joints_examination_subsection_5",
          "subsection_title": "Step-by-step joint examination",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "joints_examination_group_7",
              "group_title": "Step 1: General inspection",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Before examining an individual joint, observe the patient generally."
                },
                {
                  "type": "paragraph",
                  "text": "Look for:"
                },
                {
                  "type": "paragraph",
                  "text": "Difficulty walking or transferring."
                },
                {
                  "type": "paragraph",
                  "text": "Use of walking aids or splints."
                },
                {
                  "type": "paragraph",
                  "text": "Abnormal posture."
                },
                {
                  "type": "paragraph",
                  "text": "Multiple joint deformities."
                },
                {
                  "type": "paragraph",
                  "text": "Muscle wasting."
                },
                {
                  "type": "paragraph",
                  "text": "Skin lesions, rashes or nodules that may suggest systemic disease."
                },
                {
                  "type": "paragraph",
                  "text": "For a lower-limb joint, assess gait if safe. For an upper-limb joint, observe how the patient uses the limb during ordinary activities."
                }
              ]
            },
            {
              "group_id": "joints_examination_group_8",
              "group_title": "Step 2: Inspection of the joint",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Inspect the joint from the front, sides and back where possible. Compare it with the opposite side."
                },
                {
                  "type": "paragraph",
                  "text": "Look for:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "A. Swelling"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Determine whether it is:"
                },
                {
                  "type": "paragraph",
                  "text": "Intra-articular, involving the joint itself."
                },
                {
                  "type": "paragraph",
                  "text": "Periarticular, involving surrounding soft tissues."
                },
                {
                  "type": "paragraph",
                  "text": "Localised to a bursa, tendon sheath or cyst."
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Skin changes"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Look for:"
                },
                {
                  "type": "paragraph",
                  "text": "Redness."
                },
                {
                  "type": "paragraph",
                  "text": "Scars from previous surgery."
                },
                {
                  "type": "paragraph",
                  "text": "Sinuses or wounds."
                },
                {
                  "type": "paragraph",
                  "text": "Bruising."
                },
                {
                  "type": "paragraph",
                  "text": "Psoriatic plaques."
                },
                {
                  "type": "paragraph",
                  "text": "Rheumatoid nodules or other relevant lesions."
                },
                {
                  "type": "checklist",
                  "items": [
                    "C. Deformity"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Examples include:"
                },
                {
                  "type": "paragraph",
                  "text": "Varus or valgus alignment at the knee."
                },
                {
                  "type": "paragraph",
                  "text": "Ulnar deviation at the metacarpophalangeal joints."
                },
                {
                  "type": "paragraph",
                  "text": "Boutonnière or swan-neck deformities in the fingers."
                },
                {
                  "type": "paragraph",
                  "text": "Fixed flexion deformity."
                },
                {
                  "type": "paragraph",
                  "text": "Joint subluxation or dislocation."
                },
                {
                  "type": "checklist",
                  "items": [
                    "D. Muscle wasting"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Compare the muscle bulk on both sides. Wasting may indicate chronic disuse, pain-related inhibition, neurological disease or longstanding joint pathology."
                },
                {
                  "type": "paragraph",
                  "text": "Normal finding: No swelling, redness, scars, deformity, muscle wasting or asymmetry."
                },
                {
                  "type": "paragraph",
                  "text": "Abnormal finding: Document the precise location and character of each abnormality rather than simply stating that the joint looks abnormal."
                }
              ]
            },
            {
              "group_id": "joints_examination_group_9",
              "group_title": "Step 3: Palpation",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Ask permission before touching the patient and begin gently."
                }
              ]
            },
            {
              "group_id": "joints_examination_group_10",
              "group_title": "A. Temperature",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Use the dorsum of your hand to compare the temperature of corresponding joints."
                },
                {
                  "type": "paragraph",
                  "text": "Normal: similar temperature on both sides."
                },
                {
                  "type": "paragraph",
                  "text": "Abnormal: increased warmth may indicate inflammation, infection or recent injury."
                },
                {
                  "type": "paragraph",
                  "text": "A hot joint is particularly concerning when accompanied by acute pain, swelling and restricted movement."
                }
              ]
            },
            {
              "group_id": "joints_examination_group_11",
              "group_title": "B. Tenderness",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Palpate relevant anatomical landmarks, joint lines and surrounding soft tissues."
                },
                {
                  "type": "paragraph",
                  "text": "Ask the patient whether the area is painful and note the exact location."
                },
                {
                  "type": "paragraph",
                  "text": "Joint-line tenderness may indicate intra-articular pathology."
                },
                {
                  "type": "paragraph",
                  "text": "Tendon tenderness may suggest tendinopathy or tenosynovitis."
                },
                {
                  "type": "paragraph",
                  "text": "Bony tenderness after trauma may raise concern for fracture."
                },
                {
                  "type": "paragraph",
                  "text": "Do not apply unnecessary pressure to an acutely inflamed joint."
                }
              ]
            },
            {
              "group_id": "joints_examination_group_12",
              "group_title": "C. Swelling and effusion",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Assess whether the swelling is diffuse, localised, soft, firm or fluctuant."
                },
                {
                  "type": "paragraph",
                  "text": "An effusion is excess fluid within the joint cavity. The methods used to detect it depend on the joint."
                },
                {
                  "type": "paragraph",
                  "text": "For example, in the knee, you may use the bulge sign or patellar tap when appropriate."
                }
              ]
            },
            {
              "group_id": "joints_examination_group_13",
              "group_title": "D. Crepitus",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Crepitus is a grating, crackling or clicking sensation during joint movement."
                },
                {
                  "type": "paragraph",
                  "text": "It may occur in osteoarthritis, but it is not specific to osteoarthritis and can occur in other conditions."
                },
                {
                  "type": "paragraph",
                  "text": "Normal finding: No abnormal warmth, focal tenderness, significant swelling or pathological crepitus."
                },
                {
                  "type": "paragraph",
                  "text": "Abnormal finding: Describe the location, severity and nature of the tenderness or swelling and correlate it with the movement examination."
                }
              ]
            },
            {
              "group_id": "joints_examination_group_14",
              "group_title": "Step 4: Assess range of motion",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Assess both active and passive movement."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/medical/joints_examination_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Active range of motion"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Ask the patient to move the joint independently. This assesses movement, pain, functional ability and the combined effects of muscles, tendons and the joint."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/medical/joints_examination_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Passive range of motion"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Gently move the relaxed joint yourself. This helps assess joint restriction, pain, capsular limitation and mechanical obstruction."
                }
              ]
            },
            {
              "group_id": "joints_examination_group_15",
              "group_title": "Movements to assess",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The movements depend on the joint. Common examples include:"
                },
                {
                  "type": "table",
                  "columns": [
                    "Joint",
                    "Movements"
                  ],
                  "rows": [
                    [
                      "Shoulder",
                      "Flexion, extension, abduction, adduction, internal and external rotation"
                    ],
                    [
                      "Elbow",
                      "Flexion, extension, pronation and supination"
                    ],
                    [
                      "Wrist",
                      "Flexion, extension, radial and ulnar deviation"
                    ],
                    [
                      "Fingers",
                      "Flexion, extension, abduction, adduction and opposition where relevant"
                    ],
                    [
                      "Hip",
                      "Flexion, extension, abduction, adduction, internal and external rotation"
                    ],
                    [
                      "Knee",
                      "Flexion and extension"
                    ],
                    [
                      "Ankle",
                      "Dorsiflexion, plantar flexion, inversion and eversion"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Record whether movements are full or restricted, painful or painless, and whether restriction occurs actively, passively or both."
                }
              ]
            },
            {
              "group_id": "joints_examination_group_16",
              "group_title": "Interpreting movement",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Active movement restricted, passive movement relatively preserved: Consider muscle weakness, tendon injury, pain inhibition or neurological dysfunction."
                },
                {
                  "type": "paragraph",
                  "text": "Both active and passive movement restricted: Consider joint disease, capsular restriction, effusion or mechanical obstruction."
                },
                {
                  "type": "paragraph",
                  "text": "Pain during movement: May reflect inflammation, injury or degenerative pathology."
                },
                {
                  "type": "paragraph",
                  "text": "Painful restriction with a hot, swollen joint: Requires urgent consideration of infection."
                },
                {
                  "type": "paragraph",
                  "text": "These patterns are clues rather than definitive diagnostic rules."
                }
              ]
            },
            {
              "group_id": "joints_examination_group_17",
              "group_title": "Step 5: Assess strength",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Test relevant muscle groups against resistance, using the movements appropriate to the joint."
                },
                {
                  "type": "paragraph",
                  "text": "Use the Medical Research Council (MRC) power scale where appropriate:"
                },
                {
                  "type": "table",
                  "columns": [
                    "Grade",
                    "Meaning"
                  ],
                  "rows": [
                    [
                      "0",
                      "No contraction"
                    ],
                    [
                      "1",
                      "Flicker of contraction"
                    ],
                    [
                      "2",
                      "Movement with gravity eliminated"
                    ],
                    [
                      "3",
                      "Movement against gravity"
                    ],
                    [
                      "4",
                      "Movement against resistance, but reduced strength"
                    ],
                    [
                      "5",
                      "Normal power"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Pain may inhibit effort and produce apparent weakness. Document this when relevant."
                }
              ]
            },
            {
              "group_id": "joints_examination_group_18",
              "group_title": "Step 6: Assess stability and special tests",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Perform special tests only when indicated by the history and initial examination."
                },
                {
                  "type": "paragraph",
                  "text": "Examples include:"
                },
                {
                  "type": "paragraph",
                  "text": "Knee: Lachman test, anterior and posterior drawer tests, varus and valgus stress tests."
                },
                {
                  "type": "paragraph",
                  "text": "Shoulder: selected rotator cuff and instability tests."
                },
                {
                  "type": "paragraph",
                  "text": "Hip: tests for hip pathology and relevant gait abnormalities."
                },
                {
                  "type": "paragraph",
                  "text": "Wrist and hand: selected tendon, ligament and nerve-compression tests."
                },
                {
                  "type": "paragraph",
                  "text": "A positive special test should be interpreted alongside the history, general examination and other findings. Avoid performing forceful tests on an acutely injured or potentially fractured joint."
                }
              ]
            },
            {
              "group_id": "joints_examination_group_19",
              "group_title": "Step 7: Functional assessment",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Assess function appropriate to the joint:"
                },
                {
                  "type": "paragraph",
                  "text": "Shoulder: reaching overhead or behind the back."
                },
                {
                  "type": "paragraph",
                  "text": "Hand: making a fist, picking up an object or performing a grip."
                },
                {
                  "type": "paragraph",
                  "text": "Hip and knee: standing from a chair, walking and climbing steps."
                },
                {
                  "type": "paragraph",
                  "text": "Ankle: walking and heel or toe raises if safe."
                },
                {
                  "type": "paragraph",
                  "text": "Do not ask a patient with severe pain, instability or suspected fracture to perform unsafe functional manoeuvres."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "joints_examination_subsection_6",
          "subsection_title": "Important patterns of joint disease",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "joints_examination_group_20",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/medical/joints_examination_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Osteoarthritis"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Often associated with activity-related pain, brief morning stiffness, crepitus, bony enlargement and restricted movement."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/medical/joints_examination_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Rheumatoid arthritis"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "May produce symmetrical inflammatory polyarthritis, soft joint swelling, prolonged morning stiffness and characteristic hand deformities in established disease."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/medical/joints_examination_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Gout"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "May present with abrupt, severe pain, warmth, redness and swelling, commonly affecting the first metatarsophalangeal joint."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/medical/joints_examination_10.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Septic arthritis"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "May cause a hot, swollen, severely painful joint with marked restriction of both active and passive movement. Fever may be absent."
                },
                {
                  "type": "paragraph",
                  "text": "Critical clinical point: A suspected septic joint is an emergency. Arrange urgent assessment, joint aspiration and appropriate treatment. Do not delay escalation while completing routine examination manoeuvres."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "joints_examination_subsection_7",
          "subsection_title": "How to present normal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "joints_examination_group_21",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Use the following template, adapting it to the joint examined."
                },
                {
                  "type": "paragraph",
                  "text": "Normal joint examination:"
                },
                {
                  "type": "paragraph",
                  "text": "“On examination, the joint is symmetrical with the contralateral side. There is no swelling, erythema, deformity, muscle wasting or abnormal skin change. The joint is not warm or tender, and there is no clinically detectable effusion. Active and passive ranges of motion are full and painless, with no abnormal crepitus. Muscle power is preserved, and the relevant stability tests are normal."
                },
                {
                  "type": "paragraph",
                  "text": "Overall, there are no significant abnormalities detected on examination of this joint.”"
                },
                {
                  "type": "paragraph",
                  "text": "Only report effusion, stability and special tests as normal if you have actually assessed them."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "joints_examination_subsection_8",
          "subsection_title": "How to present abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "joints_examination_group_22",
              "group_title": "Scenario A: Osteoarthritis",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“There is bony enlargement of the joint with crepitus and restricted movement. The joint is not markedly warm or erythematous. These findings are suggestive of osteoarthritis, subject to the clinical context.”"
                }
              ]
            },
            {
              "group_id": "joints_examination_group_23",
              "group_title": "Scenario B: Inflammatory arthritis",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“There is symmetrical joint swelling, warmth and tenderness, with restriction of movement. The findings suggest an inflammatory arthropathy, such as rheumatoid arthritis, depending on the distribution and associated clinical features.”"
                }
              ]
            },
            {
              "group_id": "joints_examination_group_24",
              "group_title": "Scenario C: Septic arthritis",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“The joint is acutely swollen, warm and severely tender, with marked restriction of active and passive movement. Septic arthritis must be excluded urgently. I would arrange immediate clinical assessment and joint aspiration as appropriate.”"
                }
              ]
            },
            {
              "group_id": "joints_examination_group_25",
              "group_title": "Scenario D: Joint effusion",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“There is visible swelling with evidence of an intra-articular effusion. I would correlate this with the history and other examination findings and consider imaging or joint aspiration depending on the suspected cause.”"
                }
              ]
            },
            {
              "group_id": "joints_examination_group_26",
              "group_title": "Scenario E: Joint deformity",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“There is a fixed deformity with restricted range of movement and associated muscle wasting. I would document the type and degree of deformity, assess functional impairment and investigate the underlying cause.”"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "joints_examination_subsection_9",
          "subsection_title": "Additional information examiners expect",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "joints_examination_group_27",
              "group_title": "A. When should you consider joint aspiration?",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Joint aspiration may be indicated when there is:"
                },
                {
                  "type": "paragraph",
                  "text": "Suspected septic arthritis."
                },
                {
                  "type": "paragraph",
                  "text": "An unexplained acute monoarthritis."
                },
                {
                  "type": "paragraph",
                  "text": "A suspected crystal arthritis when the diagnosis is uncertain."
                },
                {
                  "type": "paragraph",
                  "text": "A significant effusion requiring diagnostic or therapeutic aspiration."
                },
                {
                  "type": "paragraph",
                  "text": "Synovial fluid may be assessed for cell count, Gram stain, culture and crystals. Finding crystals does not exclude a concurrent joint infection."
                }
              ]
            },
            {
              "group_id": "joints_examination_group_28",
              "group_title": "B. When is imaging appropriate?",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Plain radiographs: suspected fracture, established osteoarthritis or structural abnormalities."
                },
                {
                  "type": "paragraph",
                  "text": "Ultrasound: selected effusions, synovitis, tendon pathology and image-guided aspiration."
                },
                {
                  "type": "paragraph",
                  "text": "MRI: selected ligament, meniscal, cartilage, bone marrow or soft-tissue pathology."
                },
                {
                  "type": "paragraph",
                  "text": "Investigation choice depends on the joint, clinical question and urgency."
                }
              ]
            },
            {
              "group_id": "joints_examination_group_29",
              "group_title": "C. Red flags",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Arrange urgent assessment for:"
                },
                {
                  "type": "paragraph",
                  "text": "A hot, swollen joint with suspected infection."
                },
                {
                  "type": "paragraph",
                  "text": "Acute severe joint pain with systemic illness."
                },
                {
                  "type": "paragraph",
                  "text": "Significant trauma with deformity or inability to bear weight."
                },
                {
                  "type": "paragraph",
                  "text": "A suspected fracture or dislocation."
                },
                {
                  "type": "paragraph",
                  "text": "A rapidly progressive neurological or vascular deficit affecting the limb."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "joints_examination_subsection_10",
          "subsection_title": "Common OSCE mistakes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "joints_examination_group_30",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Failing to compare both sides."
                },
                {
                  "type": "paragraph",
                  "text": "Forgetting to expose the joint adequately."
                },
                {
                  "type": "paragraph",
                  "text": "Starting with painful passive movements before inspection and gentle palpation."
                },
                {
                  "type": "paragraph",
                  "text": "Not distinguishing active from passive range of motion."
                },
                {
                  "type": "paragraph",
                  "text": "Failing to examine adjacent joints when indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Performing special tests without understanding their purpose."
                },
                {
                  "type": "paragraph",
                  "text": "Ignoring functional limitations."
                },
                {
                  "type": "paragraph",
                  "text": "Declaring a joint normal without assessing tenderness, movement and relevant stability."
                },
                {
                  "type": "paragraph",
                  "text": "Missing a hot joint that may represent septic arthritis."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "joints_examination_subsection_11",
          "subsection_title": "Final practice checklist",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "joints_examination_group_31",
              "group_title": "Joint examination tracker",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "0 of 12",
                    "Introduce yourself, obtain consent and assess pain",
                    "Observe posture, gait and general joint involvement",
                    "Inspect both sides for swelling, deformity and muscle wasting",
                    "Palpate temperature, tenderness and relevant anatomical landmarks",
                    "Assess effusion when appropriate",
                    "Test active range of motion",
                    "Test passive range of motion gently",
                    "Assess muscle power",
                    "Perform indicated stability and special tests",
                    "Assess relevant functional movements safely",
                    "Identify red flags and state the next steps",
                    "Present findings in a structured clinical summary"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Key takeaway: The core of every joint examination is Look, Feel, Move, Function. Your final presentation should describe the abnormalities objectively, interpret their likely significance and identify any urgent condition that must not be missed."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}