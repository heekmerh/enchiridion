  "sections": [
    {
      "section_id": "external_fixator_section_1",
      "section_title": "External fixator",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "external_fixator_subsection_1",
          "subsection_title": "Introduction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "external_fixator_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/external_fixator_01.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/external_fixator_02.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/external_fixator_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "An external fixator is an orthopaedic device used to stabilise fractured bones by inserting pins or wires through the skin into the bone and connecting them to an external frame."
                },
                {
                  "type": "paragraph",
                  "text": "It maintains bone alignment and stability while allowing access to the surrounding soft tissues."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“This is an external fixator, an orthopaedic fracture-stabilisation device consisting of percutaneous bone pins or wires connected to an external frame by clamps and connecting rods. It is used for temporary or definitive stabilisation of fractures, particularly when there is significant soft-tissue injury, open fracture, or a need for staged orthopaedic management.”"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "external_fixator_subsection_2",
          "subsection_title": "Classification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "external_fixator_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "External fixators can be classified according to their configuration, the method of fixation, and their intended purpose."
                }
              ]
            },
            {
              "group_id": "external_fixator_group_3",
              "group_title": "A. According to frame configuration",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/external_fixator_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Unilateral external fixator"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Pins are inserted from one side of the bone and attached to a frame on that side."
                },
                {
                  "type": "paragraph",
                  "text": "Relatively simple and quick to apply."
                },
                {
                  "type": "paragraph",
                  "text": "Commonly used for tibial shaft fractures."
                },
                {
                  "type": "paragraph",
                  "text": "May provide less multidirectional stability than more complex frames."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/external_fixator_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Bilateral or biplanar external fixator"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Pins and connecting elements are arranged in two planes or on opposing sides, depending on the system."
                },
                {
                  "type": "paragraph",
                  "text": "Can provide greater stability."
                },
                {
                  "type": "paragraph",
                  "text": "May be bulkier and more difficult to manage."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/external_fixator_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Circular external fixator"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Uses rings connected by rods, with tensioned wires and/or half-pins."
                },
                {
                  "type": "paragraph",
                  "text": "Examples include the Ilizarov system."
                },
                {
                  "type": "paragraph",
                  "text": "Useful for complex fractures, deformity correction, limb lengthening and non-union."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/external_fixator_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Hexapod external fixator"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Uses two rings connected by six adjustable struts in systems such as the Taylor Spatial Frame."
                },
                {
                  "type": "paragraph",
                  "text": "Allows computer-assisted correction of complex multiplanar deformities."
                },
                {
                  "type": "paragraph",
                  "text": "Can assist with gradual correction and limb reconstruction."
                }
              ]
            },
            {
              "group_id": "external_fixator_group_4",
              "group_title": "B. According to purpose",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Temporary external fixation: used for initial stabilisation, often in severely injured patients or open fractures."
                },
                {
                  "type": "paragraph",
                  "text": "Definitive external fixation: serves as the principal method of fracture treatment until healing."
                },
                {
                  "type": "paragraph",
                  "text": "Circular fixation for reconstruction: used for limb lengthening, deformity correction, bone transport and selected non-unions."
                }
              ]
            },
            {
              "group_id": "external_fixator_group_5",
              "group_title": "C. According to pin or wire design",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Half-pin systems."
                },
                {
                  "type": "paragraph",
                  "text": "Tensioned-wire systems."
                },
                {
                  "type": "paragraph",
                  "text": "Hybrid systems combining wires and half-pins."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "external_fixator_subsection_3",
          "subsection_title": "Labelled components",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "external_fixator_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/external_fixator_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "quizlet.com"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "In an OSCE station, you may be asked to identify the following parts."
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Schanz pins / half-pins"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Rigid pins inserted into the bone through small skin incisions. They anchor the frame to the skeleton."
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Pin clamps"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Secure the pins to the connecting rods or frame."
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Connecting rods or bars"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Link the clamps and maintain the relative position of the bone fragments."
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Rings or circular frames"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Present in circular fixators; provide a frame for wires, pins and adjustable struts."
                },
                {
                  "type": "checklist",
                  "items": [
                    "5. Adjustable struts"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Found in hexapod systems. Adjusting their lengths changes the spatial relationship between the rings."
                },
                {
                  "type": "paragraph",
                  "text": "Important distinction: Not every external fixator has rings or struts. A basic unilateral frame usually has pins, clamps and connecting bars."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "external_fixator_subsection_4",
          "subsection_title": "Principles of operation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "external_fixator_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "External fixation works by transmitting stabilising forces from the bone through the pins or wires to an external frame."
                },
                {
                  "type": "paragraph",
                  "text": "The principal aims are to:"
                },
                {
                  "type": "paragraph",
                  "text": "Maintain fracture alignment and length."
                },
                {
                  "type": "paragraph",
                  "text": "Reduce excessive movement at the fracture site."
                },
                {
                  "type": "paragraph",
                  "text": "Protect injured soft tissues."
                },
                {
                  "type": "paragraph",
                  "text": "Allow wound inspection, dressing changes and selected soft-tissue procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Permit mobilisation or rehabilitation when the injury and construct allow it."
                },
                {
                  "type": "paragraph",
                  "text": "The stability of the construct depends on pin placement, pin-bone interface, frame geometry, the number and distribution of fixation points, and the stiffness of the connecting components."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "external_fixator_subsection_5",
          "subsection_title": "Indications and clinical uses",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "external_fixator_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/external_fixator_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Open fractures"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Particularly useful when extensive soft-tissue damage makes immediate internal fixation unsuitable or when rapid stabilisation is required."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/external_fixator_10.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Damage-control orthopaedics"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Temporary stabilisation in selected severely injured patients before definitive surgery."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/external_fixator_11.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Complex periarticular fractures"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "For example, selected high-energy tibial plateau or pilon fractures, especially when swelling and soft-tissue injury are substantial."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/external_fixator_12.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Limb reconstruction"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Circular fixators can be used for limb lengthening, bone transport, deformity correction and selected non-unions."
                },
                {
                  "type": "paragraph",
                  "text": "Other indications include selected pelvic fractures, infected non-unions, severe burns with associated fractures, and fractures where internal implants are undesirable or unsuitable."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "external_fixator_subsection_6",
          "subsection_title": "Procedures and surgeries in which it is used",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "external_fixator_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Temporary stabilisation of open tibial fractures."
                },
                {
                  "type": "paragraph",
                  "text": "Staged management of high-energy lower-limb fractures."
                },
                {
                  "type": "paragraph",
                  "text": "Selected pelvic fracture stabilisation."
                },
                {
                  "type": "paragraph",
                  "text": "Management of selected infected fractures and non-unions."
                },
                {
                  "type": "paragraph",
                  "text": "Limb lengthening and bone transport."
                },
                {
                  "type": "paragraph",
                  "text": "Correction of complex bone deformities."
                },
                {
                  "type": "paragraph",
                  "text": "Selected paediatric fractures, depending on fracture pattern and the risk to growth plates and nearby structures."
                },
                {
                  "type": "paragraph",
                  "text": "The choice depends on the fracture, soft-tissue condition, patient physiology and the surgeon's treatment plan."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "external_fixator_subsection_7",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "external_fixator_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Can be applied relatively quickly in appropriate circumstances."
                },
                {
                  "type": "paragraph",
                  "text": "Provides stability without placing a large implant directly at the fracture site."
                },
                {
                  "type": "paragraph",
                  "text": "Facilitates wound access and repeated soft-tissue assessment."
                },
                {
                  "type": "paragraph",
                  "text": "Useful in contaminated or severely damaged soft tissues."
                },
                {
                  "type": "paragraph",
                  "text": "Can be temporary or definitive."
                },
                {
                  "type": "paragraph",
                  "text": "Circular systems allow gradual correction of some deformities and limb-length discrepancies."
                },
                {
                  "type": "paragraph",
                  "text": "May permit early mobilisation when appropriate."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "external_fixator_subsection_8",
          "subsection_title": "Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "external_fixator_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Pin-site infection is common enough to require active monitoring."
                },
                {
                  "type": "paragraph",
                  "text": "The frame may be bulky and uncomfortable."
                },
                {
                  "type": "paragraph",
                  "text": "Pin loosening and loss of fixation can occur."
                },
                {
                  "type": "paragraph",
                  "text": "Requires ongoing pin-site care and follow-up."
                },
                {
                  "type": "paragraph",
                  "text": "Can interfere with clothing, sleep and daily activities."
                },
                {
                  "type": "paragraph",
                  "text": "Incorrect pin placement may injure nerves, vessels, tendons or joints."
                },
                {
                  "type": "paragraph",
                  "text": "Prolonged use may be associated with joint stiffness and delayed rehabilitation."
                },
                {
                  "type": "paragraph",
                  "text": "Some patients find the appearance and maintenance of the frame difficult."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "external_fixator_subsection_9",
          "subsection_title": "Contraindications and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "external_fixator_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "There are few absolute contraindications when external fixation is necessary to save a limb or stabilise a major injury. However, important considerations include:"
                },
                {
                  "type": "paragraph",
                  "text": "Pin placement through injured or contaminated tissue: plan the pin sites carefully, taking definitive surgical incisions and future implants into account."
                },
                {
                  "type": "paragraph",
                  "text": "Nearby neurovascular structures: avoid injury through careful anatomical planning and appropriate imaging."
                },
                {
                  "type": "paragraph",
                  "text": "Fracture configuration: ensure the selected frame can provide adequate stability."
                },
                {
                  "type": "paragraph",
                  "text": "Poor bone quality: may compromise pin purchase and fixation."
                },
                {
                  "type": "paragraph",
                  "text": "Patient factors: inability to maintain pin-site care or attend follow-up can complicate treatment, although these factors do not automatically exclude its use."
                },
                {
                  "type": "paragraph",
                  "text": "High-yield point: External fixation is often chosen because of the patient's soft-tissue condition or physiological status, not simply because the fracture is severe."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "external_fixator_subsection_10",
          "subsection_title": "Basic application principles",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "external_fixator_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "For OSCE understanding; actual application requires appropriate training, sterile technique and orthopaedic supervision."
                },
                {
                  "type": "paragraph",
                  "text": "Assess the patient, fracture, skin, soft tissues and neurovascular status."
                },
                {
                  "type": "paragraph",
                  "text": "Obtain appropriate imaging and plan safe pin corridors."
                },
                {
                  "type": "paragraph",
                  "text": "Prepare the limb using the required sterile technique."
                },
                {
                  "type": "paragraph",
                  "text": "Insert pins or wires into appropriate bone segments, avoiding joints and vulnerable anatomical structures."
                },
                {
                  "type": "paragraph",
                  "text": "Attach pins or wires to clamps, bars or rings."
                },
                {
                  "type": "paragraph",
                  "text": "Reduce the fracture and adjust the frame to restore appropriate alignment and length."
                },
                {
                  "type": "paragraph",
                  "text": "Secure the clamps and verify the construct."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm alignment with imaging and repeat neurovascular assessment."
                },
                {
                  "type": "paragraph",
                  "text": "Apply appropriate pin-site dressings and establish a follow-up plan."
                },
                {
                  "type": "paragraph",
                  "text": "The exact sequence and technique vary with the device and injury. Definitive fixation may be required later."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "external_fixator_subsection_11",
          "subsection_title": "Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "external_fixator_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Key point"
                  ],
                  "rows": [
                    [
                      "Pin-site infection",
                      "Redness, tenderness, discharge or loosening may occur."
                    ],
                    [
                      "Pin loosening",
                      "Can cause pain, instability or loss of reduction."
                    ],
                    [
                      "Neurovascular injury",
                      "May occur during pin insertion or from swelling or displacement."
                    ],
                    [
                      "Tendon or muscle injury",
                      "Can result from poorly planned pin placement."
                    ],
                    [
                      "Joint penetration",
                      "May cause cartilage injury, infection or stiffness."
                    ],
                    [
                      "Malalignment",
                      "Incorrect reduction or subsequent loss of alignment."
                    ],
                    [
                      "Delayed union or non-union",
                      "Depends on the injury, biology and stability."
                    ],
                    [
                      "Refracture",
                      "Can occur after frame removal before adequate healing."
                    ],
                    [
                      "Pressure injury",
                      "Can result from frame contact with skin or poor positioning."
                    ],
                    [
                      "Compartment syndrome",
                      "May arise from the original injury; external fixation does not eliminate this risk."
                    ],
                    [
                      "Thermal injury",
                      "Excessive heat during drilling can damage bone."
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "external_fixator_group_15",
              "group_title": "Red flags during follow-up",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Urgent assessment is needed for new severe pain, increasing swelling, a cold or pale limb, new numbness or weakness, absent or deteriorating pulses, fever with spreading redness, or sudden frame instability."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "external_fixator_subsection_12",
          "subsection_title": "Aftercare and monitoring",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "external_fixator_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Document distal pulses, capillary refill, sensation and motor function."
                },
                {
                  "type": "paragraph",
                  "text": "Monitor pin sites for infection and loosening."
                },
                {
                  "type": "paragraph",
                  "text": "Maintain pin-site care according to the local protocol and device instructions."
                },
                {
                  "type": "paragraph",
                  "text": "Review radiographs to assess alignment and fracture healing."
                },
                {
                  "type": "paragraph",
                  "text": "Monitor pain, swelling, skin integrity and joint movement."
                },
                {
                  "type": "paragraph",
                  "text": "Encourage appropriate physiotherapy and mobilisation."
                },
                {
                  "type": "paragraph",
                  "text": "Assess for venous thromboembolism risk and provide prophylaxis when indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Educate the patient on frame care, safe movement and warning signs."
                },
                {
                  "type": "paragraph",
                  "text": "Remove the frame only when clinically and radiographically appropriate, under the treating team's direction."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "external_fixator_subsection_13",
          "subsection_title": "Common OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "external_fixator_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is an external fixator?"
                },
                {
                  "type": "paragraph",
                  "text": "A device that stabilises bone using percutaneous pins or wires connected to an external frame."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Name four components of a basic external fixator."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Schanz pins or half-pins",
                    "Pin clamps",
                    "Connecting rods or bars",
                    "Locking mechanisms"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Why is external fixation useful in open fractures?"
                },
                {
                  "type": "paragraph",
                  "text": "It can stabilise the fracture while allowing access to injured soft tissues for wound assessment, debridement and reconstruction."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. What is the difference between temporary and definitive external fixation?"
                },
                {
                  "type": "paragraph",
                  "text": "Temporary fixation provides initial stabilisation before another treatment stage. Definitive fixation remains in place as the main method of stabilisation until healing or completion of reconstruction."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What is an Ilizarov fixator?"
                },
                {
                  "type": "paragraph",
                  "text": "A circular external fixation system that uses rings and tensioned wires and/or half-pins. It can be used for complex fracture management, bone transport, limb lengthening and deformity correction."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What is the common complication you must monitor for?"
                },
                {
                  "type": "paragraph",
                  "text": "Pin-site infection. Other important complications include pin loosening, neurovascular injury, malalignment and delayed union."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What must you assess after application?"
                },
                {
                  "type": "paragraph",
                  "text": "Distal neurovascular status, fracture alignment, pain, swelling, pin sites and frame stability."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. Why must pin placement be planned carefully?"
                },
                {
                  "type": "paragraph",
                  "text": "To avoid nerves, vessels, tendons, joints and areas needed for future incisions or definitive fixation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "external_fixator_subsection_14",
          "subsection_title": "High-yield OSCE tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "external_fixator_group_18",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Identify: external fixator."
                },
                {
                  "type": "paragraph",
                  "text": "Function: stabilises bone through pins or wires attached to an external frame."
                },
                {
                  "type": "paragraph",
                  "text": "Classic indication: selected open fractures with substantial soft-tissue injury."
                },
                {
                  "type": "paragraph",
                  "text": "Classic complication: pin-site infection."
                },
                {
                  "type": "paragraph",
                  "text": "Circular system: Ilizarov fixator."
                },
                {
                  "type": "paragraph",
                  "text": "Reconstructive use: bone transport and limb lengthening."
                },
                {
                  "type": "paragraph",
                  "text": "Immediate post-application priority: document and reassess neurovascular status."
                },
                {
                  "type": "paragraph",
                  "text": "Safety point: the presence of a fixator does not rule out compartment syndrome."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "external_fixator_subsection_15",
          "subsection_title": "How to present the instrument to the examiner",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "external_fixator_group_19",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is an external fixator used for orthopaedic stabilisation of fractures. It consists of pins or wires inserted into bone and connected to external rods, clamps or rings. It is indicated in selected open fractures, severe soft-tissue injuries, damage-control orthopaedics and reconstructive procedures. Its advantages include rapid stabilisation and access to the soft tissues. Complications include pin-site infection, loosening, neurovascular injury, malalignment and delayed union. Regular neurovascular assessment, pin-site care and radiographic follow-up are essential.”"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}