  "sections": [
    {
      "section_id": "early_pregnancy_ultrasound_section_1",
      "section_title": "Early pregnancy ultrasound",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "early_pregnancy_ultrasound_subsection_1",
          "subsection_title": "1. What the OSCE station may say",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "early_pregnancy_ultrasound_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A 29-year-old woman at approximately 7 weeks' gestation presents with mild vaginal bleeding. You are shown a transvaginal ultrasound image and asked to interpret the findings."
                },
                {
                  "type": "list",
                  "title": "Your tasks:",
                  "items": [
                    {
                      "text": "Identify the type of ultrasound examination.",
                      "level": 0
                    },
                    {
                      "text": "Describe the structures visible.",
                      "level": 0
                    },
                    {
                      "text": "Determine pregnancy location and viability.",
                      "level": 0
                    },
                    {
                      "text": "Identify features of miscarriage and ectopic pregnancy.",
                      "level": 0
                    },
                    {
                      "text": "Explain when repeat ultrasound is required before diagnosing pregnancy loss.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Key OSCE principle: Interpret early pregnancy ultrasound systematically. Establish the pregnancy location, assess the structures and cardiac activity, look at the adnexa and pelvis, and avoid diagnosing miscarriage before accepted criteria are met."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "early_pregnancy_ultrasound_subsection_2",
          "subsection_title": "2. Types of early pregnancy ultrasound",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "early_pregnancy_ultrasound_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/early_pregnancy_ultrasound_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Transabdominal ultrasound"
                },
                {
                  "type": "paragraph",
                  "text": "The probe is placed on the abdomen. It provides a wider overview but may be less sensitive in very early pregnancy."
                },
                {
                  "type": "paragraph",
                  "text": "Transvaginal ultrasound (TVUS)"
                },
                {
                  "type": "paragraph",
                  "text": "The probe is inserted into the vagina with consent and appropriate preparation. It usually provides better detail in early pregnancy."
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_3",
              "group_title": "Transabdominal versus transvaginal ultrasound",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Transabdominal",
                    "Transvaginal"
                  ],
                  "rows": [
                    [
                      "Probe position",
                      "On the abdomen",
                      "Within the vagina"
                    ],
                    [
                      "Early pregnancy detail",
                      "Generally lower",
                      "Generally higher"
                    ],
                    [
                      "Bladder",
                      "Often full",
                      "Usually emptied"
                    ],
                    [
                      "Typical role",
                      "Wider pelvic overview",
                      "Early pregnancy location and viability"
                    ],
                    [
                      "Limitations",
                      "Maternal habitus, bowel gas and early gestation",
                      "Requires informed consent and may be unacceptable to some patients"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A transvaginal scan should be offered with a clear explanation, consent and respect for the patient's preferences. If declined, transabdominal scanning may be used, recognizing its limitations."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "early_pregnancy_ultrasound_subsection_3",
          "subsection_title": "3. The systematic approach to interpreting early pregnancy ultrasound",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "early_pregnancy_ultrasound_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Use the mnemonic L-V-A-F."
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_5",
              "group_title": "L",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Location"
                },
                {
                  "type": "paragraph",
                  "text": "Is the pregnancy intrauterine, extrauterine or of unknown location?"
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_6",
              "group_title": "V",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Viability"
                },
                {
                  "type": "paragraph",
                  "text": "Is an embryo present? Is cardiac activity visible? Are accepted diagnostic criteria for pregnancy loss met?"
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_7",
              "group_title": "A",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Adnexa"
                },
                {
                  "type": "paragraph",
                  "text": "Assess both ovaries and adnexal regions for masses suggestive of ectopic pregnancy."
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_8",
              "group_title": "F",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Free fluid"
                },
                {
                  "type": "paragraph",
                  "text": "Assess the pelvis for free fluid, particularly moderate or large amounts or echogenic fluid that may represent blood."
                },
                {
                  "type": "paragraph",
                  "text": "Also document the number of gestational sacs, embryo measurements, gestational age estimates and any relevant uterine or ovarian abnormalities."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "early_pregnancy_ultrasound_subsection_4",
          "subsection_title": "4. Normal structures seen in early pregnancy",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "early_pregnancy_ultrasound_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/early_pregnancy_ultrasound_02.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/early_pregnancy_ultrasound_03.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/early_pregnancy_ultrasound_04.webp",
                  "caption": null
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_10",
              "group_title": "A. Gestational sac",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The gestational sac is often the first visible ultrasound structure in an intrauterine pregnancy."
                },
                {
                  "type": "list",
                  "title": "Features to assess:",
                  "items": [
                    {
                      "text": "Location within the endometrial cavity.",
                      "level": 0
                    },
                    {
                      "text": "Shape and appearance.",
                      "level": 0
                    },
                    {
                      "text": "Mean sac diameter (MSD), measured in three orthogonal internal dimensions.",
                      "level": 0
                    },
                    {
                      "text": "Presence or absence of a yolk sac and embryo.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "An intrauterine fluid collection alone is not always definitive proof of an intrauterine pregnancy. A yolk sac or embryo within an intrauterine gestational sac provides stronger confirmation."
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_11",
              "group_title": "B. Yolk sac",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The yolk sac is a small rounded structure within the gestational sac."
                },
                {
                  "type": "paragraph",
                  "text": "It supports the diagnosis of an intrauterine pregnancy and is normally seen before the embryo becomes clearly visible."
                },
                {
                  "type": "paragraph",
                  "text": "An abnormal appearance may raise concern but should not, by itself, be used to diagnose pregnancy loss."
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_12",
              "group_title": "C. Embryo or fetal pole",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The embryo is identified within the gestational sac. Its length is measured using the crown-rump length (CRL)."
                },
                {
                  "type": "paragraph",
                  "text": "CRL is the preferred ultrasound measurement for early pregnancy dating when the embryo is visible and can be measured appropriately."
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_13",
              "group_title": "D. Cardiac activity",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Cardiac activity may become visible during early first-trimester development. Its visibility depends on gestational age, imaging technique and measurement quality."
                },
                {
                  "type": "paragraph",
                  "text": "If cardiac activity is not seen very early, this does not automatically mean that the pregnancy is nonviable."
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_14",
              "group_title": "E. Amnion",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The amnion is a membrane surrounding the embryo. It may become visible as the pregnancy develops."
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_15",
              "group_title": "F. Corpus luteum",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The corpus luteum is commonly visible in an ovary during early pregnancy. It supports early pregnancy hormone production and should not be confused automatically with an ectopic pregnancy."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "early_pregnancy_ultrasound_subsection_5",
          "subsection_title": "5. Gestational age and ultrasound measurements",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "early_pregnancy_ultrasound_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The last menstrual period (LMP) provides an estimated gestational age, but this can be inaccurate with irregular cycles, delayed ovulation or uncertain dates."
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_17",
              "group_title": "Key measurements",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "CRL: Crown-rump length, used for early pregnancy dating.",
                      "level": 0
                    },
                    {
                      "text": "MSD: Mean sac diameter, the average of three internal gestational sac measurements.",
                      "level": 0
                    },
                    {
                      "text": "Fetal heart rate: Assessed when cardiac activity is identified.",
                      "level": 0
                    },
                    {
                      "text": "Adnexal mass dimensions: Documented if an abnormality is present.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Do not use an estimated gestational age alone to diagnose miscarriage. Ultrasound measurements and accepted diagnostic criteria are more important."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "early_pregnancy_ultrasound_subsection_6",
          "subsection_title": "6. Diagnosing early pregnancy loss",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "early_pregnancy_ultrasound_group_18",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This is one of the highest-yield OSCE topics."
                },
                {
                  "type": "paragraph",
                  "text": "The objective is to avoid both missing a nonviable pregnancy and mistakenly ending a potentially viable pregnancy."
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_19",
              "group_title": "Conservative diagnostic criteria on transvaginal ultrasound",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The following are widely used conservative criteria for diagnosing early pregnancy loss:"
                },
                {
                  "type": "table",
                  "columns": [
                    "Finding",
                    "Interpretation"
                  ],
                  "rows": [
                    [
                      "CRL ≥7 mm with no cardiac activity",
                      "Diagnostic of pregnancy loss when the scan and measurement are technically adequate."
                    ],
                    [
                      "MSD ≥25 mm with no embryo",
                      "Diagnostic of pregnancy loss when the scan and measurement are technically adequate."
                    ],
                    [
                      "CRL below 7 mm with no cardiac activity",
                      "Pregnancy viability remains uncertain; repeat assessment is required."
                    ],
                    [
                      "MSD below 25 mm with no embryo",
                      "Pregnancy viability remains uncertain; repeat assessment is required."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "If measurements are close to diagnostic thresholds, image quality is limited or there is any uncertainty, obtain a second opinion and/or repeat the scan according to the local protocol before making an irreversible diagnosis."
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_20",
              "group_title": "Time-based criteria",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Depending on the initial scan findings and the guideline used, absence of an embryo with cardiac activity may establish pregnancy loss when sufficient time has elapsed on repeat ultrasound:"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "At least 11 days after a scan showing a gestational sac with a yolk sac.",
                      "level": 0
                    },
                    {
                      "text": "At least 14 days after a scan showing a gestational sac without a yolk sac.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These criteria must be applied to the actual scan history and relevant guideline. They are not a reason to ignore symptoms or clinical deterioration."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE phrase:"
                },
                {
                  "type": "paragraph",
                  "text": "“The ultrasound findings do not yet meet definitive criteria for pregnancy loss. I would explain the uncertainty and arrange repeat ultrasound at the appropriate interval, with earlier review if symptoms worsen.”",
                  "style": "quote"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "early_pregnancy_ultrasound_subsection_7",
          "subsection_title": "7. Ultrasound findings in miscarriage",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "early_pregnancy_ultrasound_group_21",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/early_pregnancy_ultrasound_05.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/early_pregnancy_ultrasound_06.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/early_pregnancy_ultrasound_07.webp",
                  "caption": null
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_22",
              "group_title": "A. Threatened miscarriage",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Vaginal bleeding may be present.",
                      "level": 0
                    },
                    {
                      "text": "The cervix is usually closed clinically.",
                      "level": 0
                    },
                    {
                      "text": "An intrauterine pregnancy may show an embryo with cardiac activity.",
                      "level": 0
                    },
                    {
                      "text": "A subchorionic haematoma may be visible.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Bleeding alone does not mean that the pregnancy will be lost."
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_23",
              "group_title": "B. Missed miscarriage",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "An intrauterine pregnancy is present but nonviable.",
                      "level": 0
                    },
                    {
                      "text": "The embryo may be present without cardiac activity, meeting accepted diagnostic criteria.",
                      "level": 0
                    },
                    {
                      "text": "Alternatively, an empty gestational sac may meet accepted criteria for pregnancy loss.",
                      "level": 0
                    },
                    {
                      "text": "The cervix is commonly closed clinically.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_24",
              "group_title": "C. Incomplete miscarriage",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Some pregnancy tissue has been expelled and some remains.",
                      "level": 0
                    },
                    {
                      "text": "Ultrasound may show intrauterine tissue or an endometrial mass.",
                      "level": 0
                    },
                    {
                      "text": "The clinical history and symptoms are essential because blood clot and normal pregnancy-related tissue can resemble retained products.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_25",
              "group_title": "D. Complete miscarriage",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The uterus may appear empty after the pregnancy tissue has been expelled."
                },
                {
                  "type": "paragraph",
                  "text": "Important: If a definite intrauterine pregnancy was never previously documented, an empty uterus after bleeding does not establish complete miscarriage. Ectopic pregnancy must still be considered."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "early_pregnancy_ultrasound_subsection_8",
          "subsection_title": "8. Ultrasound findings in ectopic pregnancy",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "early_pregnancy_ultrasound_group_26",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/early_pregnancy_ultrasound_08.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/early_pregnancy_ultrasound_09.webp",
                  "caption": null
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_27",
              "group_title": "Important findings",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Extrauterine gestational sac containing a yolk sac or embryo.",
                      "level": 0
                    },
                    {
                      "text": "An adnexal mass that moves separately from the ovary.",
                      "level": 0
                    },
                    {
                      "text": "A tubal ring or other suspicious adnexal lesion.",
                      "level": 0
                    },
                    {
                      "text": "Moderate or large amounts of free fluid, especially echogenic fluid suggestive of blood.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_28",
              "group_title": "Pregnancy of unknown location (PUL)",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A PUL is diagnosed when a pregnancy test is positive but ultrasound shows neither a definite intrauterine nor a definite extrauterine pregnancy."
                },
                {
                  "type": "paragraph",
                  "text": "PUL is a temporary classification, not a final diagnosis."
                },
                {
                  "type": "paragraph",
                  "text": "Management of a stable patient usually involves clinical review, serial quantitative β-hCG and repeat ultrasound as appropriate. A single β-hCG value or an empty uterus must not be used in isolation to diagnose ectopic pregnancy or miscarriage."
                },
                {
                  "type": "paragraph",
                  "text": "If the patient is haemodynamically unstable or has concerning pain and signs of internal bleeding, urgent treatment takes priority over routine follow-up."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "early_pregnancy_ultrasound_subsection_9",
          "subsection_title": "9. Molar pregnancy on ultrasound",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "early_pregnancy_ultrasound_group_29",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/early_pregnancy_ultrasound_10.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/early_pregnancy_ultrasound_11.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/early_pregnancy_ultrasound_12.webp",
                  "caption": null
                },
                {
                  "type": "list",
                  "title": "Possible findings include:",
                  "items": [
                    {
                      "text": "Heterogeneous intrauterine tissue with multiple cystic spaces.",
                      "level": 0
                    },
                    {
                      "text": "A characteristic vesicular or “snowstorm” appearance in some complete moles.",
                      "level": 0
                    },
                    {
                      "text": "Absence of a normal embryo or fetus in a classic complete mole.",
                      "level": 0
                    },
                    {
                      "text": "An abnormal placenta and possibly abnormal fetal tissue in a partial mole.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Early molar pregnancy may not show the classic appearance. Clinical findings, β-hCG and histopathology may be required to establish the diagnosis."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "early_pregnancy_ultrasound_subsection_10",
          "subsection_title": "10. Other important ultrasound findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "early_pregnancy_ultrasound_group_30",
              "group_title": "A. Subchorionic haematoma",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A collection of blood between the chorion and uterine wall may be seen in a patient with early pregnancy bleeding."
                },
                {
                  "type": "paragraph",
                  "text": "Document its location and size when possible. Its presence does not automatically mean that miscarriage will occur."
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_31",
              "group_title": "B. Multiple pregnancy",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Identify the number of gestational sacs and embryos. Assess chorionicity and amnionicity at the appropriate stage, as these influence antenatal management."
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_32",
              "group_title": "C. Ovarian cysts",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A corpus luteum cyst is common in early pregnancy. Assess the morphology and clinical context before deciding that an ovarian lesion is pathological."
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_33",
              "group_title": "D. Uterine abnormalities",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Fibroids, congenital uterine abnormalities or other pelvic findings may affect interpretation or require additional assessment."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "early_pregnancy_ultrasound_subsection_11",
          "subsection_title": "11. How to report an early pregnancy ultrasound",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "early_pregnancy_ultrasound_group_34",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Use a systematic report."
                },
                {
                  "type": "paragraph",
                  "text": "1. Technique"
                },
                {
                  "type": "paragraph",
                  "text": "State whether the examination was transabdominal, transvaginal or both."
                },
                {
                  "type": "paragraph",
                  "text": "2. Uterus and gestational sac"
                },
                {
                  "type": "paragraph",
                  "text": "Document the location, number of sacs, appearance and MSD if applicable."
                },
                {
                  "type": "paragraph",
                  "text": "3. Yolk sac and embryo"
                },
                {
                  "type": "paragraph",
                  "text": "State whether they are seen."
                },
                {
                  "type": "paragraph",
                  "text": "4. Viability"
                },
                {
                  "type": "paragraph",
                  "text": "If an embryo is present, document CRL and whether cardiac activity is seen. Do not diagnose nonviability unless accepted criteria are met."
                },
                {
                  "type": "paragraph",
                  "text": "5. Adnexa"
                },
                {
                  "type": "paragraph",
                  "text": "Describe both ovaries and adnexal regions, including any mass."
                },
                {
                  "type": "paragraph",
                  "text": "6. Free fluid"
                },
                {
                  "type": "paragraph",
                  "text": "State whether it is absent, small, moderate or large and whether it appears suspicious for haemorrhage."
                },
                {
                  "type": "paragraph",
                  "text": "7. Impression and plan"
                },
                {
                  "type": "paragraph",
                  "text": "State the most likely interpretation, whether pregnancy location and viability are established, and any required follow-up."
                }
              ]
            },
            {
              "group_id": "early_pregnancy_ultrasound_group_35",
              "group_title": "Example reports",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Example 1 — Viable intrauterine pregnancy"
                },
                {
                  "type": "paragraph",
                  "text": "“Transvaginal ultrasound demonstrates a single intrauterine gestational sac containing a yolk sac and embryo. Crown-rump length corresponds to the estimated gestational age, and cardiac activity is demonstrated. No suspicious adnexal mass or significant free pelvic fluid is identified. Findings are consistent with a viable intrauterine pregnancy at the time of examination.”",
                  "style": "quote"
                },
                {
                  "type": "paragraph",
                  "text": "Example 2 — Pregnancy of uncertain viability"
                },
                {
                  "type": "paragraph",
                  "text": "“An intrauterine gestational sac is demonstrated, but the embryo is not yet visualized. The current findings do not meet definitive criteria for pregnancy loss. Repeat transvaginal ultrasound at the appropriate interval is recommended.”",
                  "style": "quote"
                },
                {
                  "type": "paragraph",
                  "text": "Example 3 — Suspected ectopic pregnancy"
                },
                {
                  "type": "paragraph",
                  "text": "“No definite intrauterine pregnancy is identified. A suspicious right adnexal mass is present, with free pelvic fluid. The findings raise concern for ectopic pregnancy. Urgent clinical correlation and senior gynaecological assessment are required.”",
                  "style": "quote"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "early_pregnancy_ultrasound_subsection_12",
          "subsection_title": "12. Common examiner questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "early_pregnancy_ultrasound_group_36",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is the best ultrasound technique for early pregnancy assessment?"
                },
                {
                  "type": "paragraph",
                  "text": "Transvaginal ultrasound generally provides the best detail in early pregnancy, provided the patient gives informed consent."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is the CRL threshold for diagnosing pregnancy loss when no cardiac activity is seen?"
                },
                {
                  "type": "paragraph",
                  "text": "A CRL of 7 mm or more without cardiac activity is a widely used conservative diagnostic threshold on a technically adequate transvaginal scan. If uncertainty remains, seek confirmation before irreversible management."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What is the MSD threshold when no embryo is seen?"
                },
                {
                  "type": "paragraph",
                  "text": "An MSD of 25 mm or more without an embryo is a widely used conservative diagnostic threshold."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Does an empty uterus prove ectopic pregnancy?"
                },
                {
                  "type": "paragraph",
                  "text": "No. It may represent an early intrauterine pregnancy, a completed miscarriage or a pregnancy of unknown location. The patient requires appropriate clinical follow-up unless urgent intervention is indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. Can a viable intrauterine pregnancy coexist with ectopic pregnancy?"
                },
                {
                  "type": "paragraph",
                  "text": "Yes. This is heterotopic pregnancy, which is more likely following assisted reproductive treatment."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What is the role of β-hCG?"
                },
                {
                  "type": "paragraph",
                  "text": "It supports assessment and follow-up but does not independently establish pregnancy location or viability. Interpret it alongside symptoms and ultrasound findings."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "early_pregnancy_ultrasound_subsection_13",
          "subsection_title": "13. Common OSCE mistakes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "early_pregnancy_ultrasound_group_37",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Reporting an ultrasound without stating the pregnancy location.",
                      "level": 0
                    },
                    {
                      "text": "Assuming an empty uterus means ectopic pregnancy.",
                      "level": 0
                    },
                    {
                      "text": "Diagnosing miscarriage using uncertain or borderline measurements.",
                      "level": 0
                    },
                    {
                      "text": "Failing to assess the adnexa and free fluid.",
                      "level": 0
                    },
                    {
                      "text": "Ignoring the possibility of heterotopic pregnancy.",
                      "level": 0
                    },
                    {
                      "text": "Using a single β-hCG result to determine viability.",
                      "level": 0
                    },
                    {
                      "text": "Forgetting to explain repeat scanning and safety-net advice.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "early_pregnancy_ultrasound_subsection_14",
          "subsection_title": "14. Memory aid: L-V-A-F",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "early_pregnancy_ultrasound_group_38",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "L — Location of pregnancy.",
                      "level": 0
                    },
                    {
                      "text": "V — Viability and cardiac activity.",
                      "level": 0
                    },
                    {
                      "text": "A — Adnexa and ovaries.",
                      "level": 0
                    },
                    {
                      "text": "F — Free fluid.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "early_pregnancy_ultrasound_subsection_15",
          "subsection_title": "15. Quick self-test",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "early_pregnancy_ultrasound_group_39",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "1. On a technically adequate transvaginal scan, which finding meets a widely used conservative criterion for early pregnancy loss?"
                },
                {
                  "type": "paragraph",
                  "text": "CRL 4 mm without cardiac activity"
                },
                {
                  "type": "paragraph",
                  "text": "MSD 15 mm without an embryo"
                },
                {
                  "type": "paragraph",
                  "text": "CRL 8 mm without cardiac activity"
                },
                {
                  "type": "paragraph",
                  "text": "An empty uterus without prior confirmation of an intrauterine pregnancy"
                },
                {
                  "type": "paragraph",
                  "text": "2. A positive pregnancy test is present, but ultrasound shows neither a definite intrauterine nor extrauterine pregnancy. What is the correct classification?"
                },
                {
                  "type": "paragraph",
                  "text": "Confirmed ectopic pregnancy"
                },
                {
                  "type": "paragraph",
                  "text": "Pregnancy of unknown location"
                },
                {
                  "type": "paragraph",
                  "text": "Confirmed complete miscarriage"
                },
                {
                  "type": "paragraph",
                  "text": "Confirmed molar pregnancy"
                },
                {
                  "type": "paragraph",
                  "text": "3. Which finding provides strong definitive evidence of an intrauterine pregnancy?"
                },
                {
                  "type": "paragraph",
                  "text": "An isolated central fluid collection"
                },
                {
                  "type": "paragraph",
                  "text": "A positive urine pregnancy test"
                },
                {
                  "type": "paragraph",
                  "text": "A yolk sac within an intrauterine gestational sac"
                },
                {
                  "type": "paragraph",
                  "text": "A thickened endometrium"
                },
                {
                  "type": "paragraph",
                  "text": "4. What should be assessed in addition to the uterus during an early pregnancy scan?"
                },
                {
                  "type": "paragraph",
                  "text": "Only the bladder"
                },
                {
                  "type": "paragraph",
                  "text": "Both adnexa and free pelvic fluid"
                },
                {
                  "type": "paragraph",
                  "text": "Only the fetal heart rate"
                },
                {
                  "type": "paragraph",
                  "text": "Only the endometrial thickness"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}