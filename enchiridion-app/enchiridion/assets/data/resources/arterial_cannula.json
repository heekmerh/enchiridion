      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "arterial_cannula_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "arterial_cannula_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/arterial_cannula_01.webp",
                  "caption": null
                },
                {
                  "type": "image",
