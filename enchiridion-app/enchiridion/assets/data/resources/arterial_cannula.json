                    {
                      "text": "Common site: Radial artery.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Main functions: Continuous invasive blood pressure monitoring and repeated arterial blood sampling.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Major limb-threatening complication: Arterial thrombosis with distal ischaemia.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Dicrotic notch: Associated with aortic valve closure.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Critical safety rule: Never use an arterial cannula as a routine intravenous medication line.",
                      "level": 0,
