                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "arterial_cannula_subsection_2",
          "subsection_title": "1. Introduction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "arterial_cannula_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "An arterial cannula is a small catheter inserted into an artery to provide continuous invasive blood pressure monitoring and repeated arterial blood sampling."
                },
                {
                  "type": "paragraph",
                  "text": "It is commonly used in operating theatres, intensive care units, emergency departments and other settings where accurate, beat-to-beat blood pressure measurement or frequent arterial blood gas analysis is required."
                },
                {
                  "type": "paragraph",
                  "text": "The radial artery at the wrist is a common insertion site. Other sites include the femoral, brachial and dorsalis pedis arteries, selected according to the clinical situation."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“This is an arterial cannula, used to obtain arterial access for continuous invasive blood pressure monitoring and repeated arterial blood sampling, including arterial blood gas analysis. It is commonly inserted into the radial artery and connected to a pressure transducer and monitoring system.”",
                  "style": "quote"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "arterial_cannula_subsection_3",
          "subsection_title": "2. Identification and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "arterial_cannula_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/arterial_cannula_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "dsc-medical.com.vn"
                },
                {
                  "type": "paragraph",
                  "text": "The precise components depend on the cannula design. A standard peripheral arterial cannulation device may include the following:"
                },
                {
                  "type": "table",
                  "columns": [
                    "Component",
                    "Function"
                  ],
                  "rows": [
                    [
                      "Catheter",
                      "Flexible tube that remains within the artery after insertion."
                    ],
                    [
                      "Introducer needle",
                      "Punctures the arterial wall to facilitate access."
                    ],
                    [
                      "Needle tip",
                      "Penetrates the skin and arterial wall."
                    ],
                    [
                      "Hub",
                      "Connects the catheter to compatible tubing or sampling equipment."
                    ],
                    [
                      "Flashback chamber, if present",
                      "Allows visual confirmation of blood entry during insertion."
                    ],
                    [
                      "Guidewire, if applicable",
                      "Facilitates catheter placement in a guidewire-based system."
                    ],
                    [
                      "Injection-free connector or sampling port",
                      "Provides a connection for blood sampling and compatible equipment."
                    ],
                    [
                      "Fixation device or wings",
                      "Helps secure the cannula to the skin."
                    ],
                    [
                      "Protective cap",
                      "Maintains a closed system before connection, according to the device design."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important distinction: The introducer needle is removed after successful placement; the flexible arterial catheter remains in the artery."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "arterial_cannula_subsection_4",
          "subsection_title": "3. Properties and characteristics",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "arterial_cannula_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Material: Commonly medical-grade polyurethane, Teflon-type fluoropolymer or another suitable biocompatible material.",
                      "level": 0
                    },
                    {
                      "text": "Design: Short, flexible catheter designed for arterial placement.",
                      "level": 0
                    },
                    {
                      "text": "Gauge: Commonly 20G or 22G for adult radial arterial cannulation, although other sizes are used.",
                      "level": 0
                    },
                    {
                      "text": "Length: Selected according to the artery, patient anatomy and device.",
                      "level": 0
                    },
                    {
                      "text": "Sterility: Usually supplied sterile and intended for single use.",
                      "level": 0
                    },
                    {
                      "text": "Pressure compatibility: Designed to connect to an appropriate invasive pressure-monitoring system.",
                      "level": 0
                    },
                    {
                      "text": "Fixation: Requires securement to prevent accidental displacement.",
                      "level": 0
                    },
                    {
                      "text": "Connection: Must be connected to a correctly primed, closed monitoring system when used for continuous pressure monitoring.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "arterial_cannula_subsection_5",
          "subsection_title": "4. Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "arterial_cannula_group_5",
              "group_title": "A. According to insertion technique",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/arterial_cannula_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "1. Over-the-needle cannula"
                },
                {
                  "type": "paragraph",
                  "text": "The catheter is advanced over a needle positioned within the vessel."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Commonly used for peripheral arterial access.",
                      "level": 0
                    },
                    {
                      "text": "The needle is withdrawn once the catheter is appropriately placed.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/arterial_cannula_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "2. Guidewire-assisted arterial catheter"
                },
                {
                  "type": "paragraph",
                  "text": "Uses a guidewire to facilitate catheter insertion."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Useful for selected arterial access procedures.",
                      "level": 0
                    },
                    {
                      "text": "Requires careful control of the wire and adherence to the device instructions.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "arterial_cannula_group_6",
              "group_title": "B. According to anatomical site",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Radial arterial cannula.",
                      "level": 0
                    },
                    {
                      "text": "Femoral arterial cannula.",
                      "level": 0
                    },
                    {
                      "text": "Brachial arterial cannula.",
                      "level": 0
                    },
                    {
                      "text": "Dorsalis pedis arterial cannula.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The radial artery is commonly preferred because it is relatively superficial and accessible. The optimal site depends on the patient's circulation, anatomy, clinical condition and procedural risks."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "arterial_cannula_subsection_6",
          "subsection_title": "5. Principle of operation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "arterial_cannula_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "An arterial cannula provides direct communication between the arterial lumen and an external pressure-monitoring system."
                },
                {
                  "type": "paragraph",
                  "text": "When connected to a fluid-filled pressure transducer, arterial pulsations are transmitted through the tubing to the transducer, which converts pressure changes into an electrical signal displayed as a waveform and numerical blood pressure."
                },
                {
                  "type": "list",
                  "title": "It also allows direct sampling of arterial blood for investigations such as:",
                  "items": [
                    {
                      "text": "pH and blood gases.",
                      "level": 0
                    },
                    {
                      "text": "Oxygenation and ventilation assessment.",
                      "level": 0
                    },
                    {
                      "text": "Electrolytes and selected metabolic measurements, depending on the analyser.",
                      "level": 0
                    },
                    {
                      "text": "Lactate measurement when clinically indicated.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Unlike a central venous catheter, an arterial cannula is not intended for routine administration of intravenous medications or fluids."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "arterial_cannula_subsection_7",
          "subsection_title": "6. Indications and uses",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "arterial_cannula_group_8",
              "group_title": "A. Continuous blood pressure monitoring",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Haemodynamic instability or shock.",
                      "level": 0
                    },
                    {
                      "text": "Major surgery with anticipated blood pressure fluctuations.",
                      "level": 0
                    },
                    {
                      "text": "Use of vasopressors in critically ill patients.",
                      "level": 0
                    },
                    {
                      "text": "Severe illness requiring close blood pressure monitoring.",
                      "level": 0
                    },
                    {
                      "text": "Situations in which non-invasive blood pressure readings are unreliable or insufficient.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "arterial_cannula_group_9",
              "group_title": "B. Repeated arterial blood sampling",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Frequent arterial blood gas analysis.",
                      "level": 0
                    },
                    {
                      "text": "Assessment of oxygenation and ventilation in selected patients.",
                      "level": 0
                    },
                    {
                      "text": "Monitoring acid–base disturbances.",
                      "level": 0
                    },
                    {
                      "text": "Serial lactate assessment in selected critically ill patients.",
                      "level": 0
                    },
                    {
                      "text": "Monitoring response to respiratory or haemodynamic treatment.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "High-yield distinction: An arterial cannula is used for continuous arterial pressure monitoring and arterial blood sampling. A central venous catheter is primarily for central venous access, selected infusions and other specialised indications."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "arterial_cannula_subsection_8",
          "subsection_title": "7. Anatomical sites and their considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "arterial_cannula_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/arterial_cannula_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "emultrasound.ucsd.edu"
                },
                {
                  "type": "table",
                  "columns": [
                    "Site",
                    "Advantages",
                    "Disadvantages and risks"
                  ],
                  "rows": [
                    [
                      "Radial artery",
                      "Superficial, accessible and relatively easy to secure",
                      "Haematoma, thrombosis, hand ischaemia and nerve irritation"
                    ],
                    [
                      "Femoral artery",
                      "Large vessel; useful in selected emergencies and difficult peripheral access",
                      "Bleeding, haematoma, infection and limb ischaemia"
                    ],
                    [
                      "Brachial artery",
                      "May provide access when other sites are unsuitable",
                      "Limited collateral circulation compared with the hand; ischaemic complications can be serious"
                    ],
                    [
                      "Dorsalis pedis artery",
                      "Useful in selected patients when other sites are unsuitable",
                      "Smaller vessel, difficult access and possible distal perfusion complications"
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "arterial_cannula_group_11",
              "group_title": "Allen test and collateral circulation",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The modified Allen test may be used in some settings to assess hand collateral circulation before radial artery cannulation. However, its predictive accuracy is limited, and it should not be treated as an infallible test. Local protocols may use other assessments, including Doppler or ultrasound, where indicated."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "arterial_cannula_subsection_9",
          "subsection_title": "8. Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "arterial_cannula_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Provides continuous, beat-to-beat blood pressure monitoring.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Enables repeated arterial blood sampling without repeated arterial punctures.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Provides useful information during major surgery and critical illness.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Allows rapid recognition of changes in arterial pressure.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Facilitates serial assessment of blood gases and selected metabolic parameters.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Can be connected to a monitor that displays the arterial waveform.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "May be particularly useful when frequent measurements are required.",
                      "level": 0,
                      "label": "7."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "arterial_cannula_subsection_10",
          "subsection_title": "9. Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "arterial_cannula_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Invasive and requires trained personnel.",
                      "level": 0
                    },
                    {
                      "text": "Can cause pain and discomfort.",
                      "level": 0
                    },
                    {
                      "text": "Requires careful sterile insertion and ongoing site care.",
                      "level": 0
                    },
                    {
                      "text": "May thrombose or become blocked.",
                      "level": 0
                    },
                    {
                      "text": "Can produce inaccurate readings if the transducer is improperly levelled or the system is inadequately maintained.",
                      "level": 0
                    },
                    {
                      "text": "Carries a risk of bleeding and distal ischaemia.",
                      "level": 0
                    },
                    {
                      "text": "Limits movement at the cannulated site.",
                      "level": 0
                    },
                    {
                      "text": "Requires regular assessment of distal circulation and catheter necessity.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "arterial_cannula_subsection_11",
          "subsection_title": "10. Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "arterial_cannula_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "1. Haematoma and bleeding"
                },
                {
                  "type": "paragraph",
                  "text": "May occur during insertion, following accidental disconnection or if the catheter becomes displaced."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/arterial_cannula_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "2. Thrombosis and distal ischaemia"
                },
                {
                  "type": "paragraph",
                  "text": "Catheter-related arterial obstruction can compromise blood supply to the hand or limb. This is a serious complication requiring prompt assessment."
                },
                {
                  "type": "paragraph",
                  "text": "3. Infection"
                },
                {
                  "type": "paragraph",
                  "text": "Risk is reduced by appropriate aseptic technique, secure dressings and regular review of the insertion site."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/arterial_cannula_08.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "4. Nerve irritation or injury"
                },
                {
                  "type": "paragraph",
                  "text": "May cause pain, tingling or altered sensation near the insertion site."
                },
                {
                  "type": "paragraph",
                  "text": "5. Monitoring errors"
                },
                {
                  "type": "paragraph",
                  "text": "Incorrect transducer height, air bubbles, clots, kinks or excessive damping can produce misleading blood pressure readings."
                }
              ]
            },
            {
              "group_id": "arterial_cannula_group_15",
              "group_title": "Warning signs of impaired distal perfusion",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "A pale, cool or cyanotic hand or foot.",
                      "level": 0
                    },
                    {
                      "text": "Delayed capillary refill.",
                      "level": 0
                    },
                    {
                      "text": "Increasing pain or paraesthesia.",
                      "level": 0
                    },
                    {
                      "text": "Reduced distal Doppler signal or pulse, where assessed.",
                      "level": 0
                    },
                    {
                      "text": "New weakness or sensory loss.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These findings require urgent clinical assessment. Do not assume that a palpable distal pulse excludes an arterial complication."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "arterial_cannula_subsection_12",
          "subsection_title": "11. Arterial line setup and waveform interpretation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "arterial_cannula_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/arterial_cannula_09.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "jaypeedigital.com"
                },
                {
                  "type": "list",
                  "title": "A typical arterial pressure monitoring system consists of:",
                  "items": [
                    {
                      "text": "Arterial cannula.",
                      "level": 0
                    },
                    {
                      "text": "Pressure tubing.",
                      "level": 0
                    },
                    {
                      "text": "Pressure transducer.",
                      "level": 0
                    },
                    {
                      "text": "Flush solution and pressurised flushing system appropriate to the setup.",
                      "level": 0
                    },
                    {
                      "text": "Monitor and display.",
                      "level": 0
                    },
                    {
                      "text": "Secure connections and a correctly positioned transducer.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "arterial_cannula_group_17",
              "group_title": "Arterial waveform components",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Component",
                    "Meaning"
                  ],
                  "rows": [
                    [
                      "Systolic pressure",
                      "Peak arterial pressure during ventricular systole"
                    ],
                    [
                      "Diastolic pressure",
                      "Lowest arterial pressure before the next systolic upstroke"
                    ],
                    [
                      "Dicrotic notch",
                      "Reflects aortic valve closure and associated pressure changes"
                    ],
                    [
                      "Mean arterial pressure (MAP)",
                      "Average arterial pressure over the cardiac cycle"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A commonly used approximation is:"
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/arterial_cannula_10.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "This approximation is most useful at ordinary heart rates and is not a substitute for the monitor's calculated MAP or clinical assessment."
                }
              ]
            },
            {
              "group_id": "arterial_cannula_group_18",
              "group_title": "Common waveform problems",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Overdamping: Blunted waveform, falsely low systolic pressure and falsely high diastolic pressure.",
                      "level": 0
                    },
                    {
                      "text": "Underdamping: Exaggerated waveform, falsely high systolic pressure and falsely low diastolic pressure.",
                      "level": 0
                    },
                    {
                      "text": "Incorrect transducer height: Produces a hydrostatic measurement error.",
                      "level": 0
                    },
                    {
                      "text": "Air bubbles, clots or kinks: May distort the waveform and impair system function.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The transducer should be levelled at the appropriate reference point, commonly the phlebostatic axis for standard haemodynamic monitoring, and zeroed according to local protocol."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "arterial_cannula_subsection_13",
          "subsection_title": "12. Contraindications and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "arterial_cannula_group_19",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "An arterial cannula may be necessary in urgent situations, so most contraindications are relative and site-specific."
                },
                {
                  "type": "list",
                  "title": "Precautions include:",
                  "items": [
                    {
                      "text": "Infection at the intended insertion site.",
                      "level": 0
                    },
                    {
                      "text": "Severe peripheral vascular disease.",
                      "level": 0
                    },
                    {
                      "text": "Suspected arterial occlusion or inadequate distal circulation.",
                      "level": 0
                    },
                    {
                      "text": "Significant bleeding tendency.",
                      "level": 0
                    },
                    {
                      "text": "Previous vascular surgery or altered anatomy.",
                      "level": 0
                    },
                    {
                      "text": "Arterial grafts, fistulas or other access that should be protected.",
                      "level": 0
                    },
                    {
                      "text": "A site where safe insertion or monitoring cannot be achieved.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Select an alternative site when the risks of the proposed site outweigh its benefits."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "arterial_cannula_subsection_14",
          "subsection_title": "13. Care and maintenance",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "arterial_cannula_group_20",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Secure the catheter and maintain an appropriate sterile dressing.",
                      "level": 0
                    },
                    {
                      "text": "Maintain a closed, properly connected monitoring system.",
                      "level": 0
                    },
                    {
                      "text": "Check the waveform and blood pressure readings for plausibility.",
                      "level": 0
                    },
                    {
                      "text": "Assess distal circulation regularly.",
                      "level": 0
                    },
                    {
                      "text": "Inspect for bleeding, swelling, redness, pain or discharge.",
                      "level": 0
                    },
                    {
                      "text": "Maintain the flushing system according to institutional protocol.",
                      "level": 0
                    },
                    {
                      "text": "Use aseptic technique for sampling and system access.",
                      "level": 0
                    },
                    {
                      "text": "Remove the cannula when it is no longer necessary or when a complication warrants removal.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Safety warning: Arterial lines are high-pressure systems. Accidental disconnection can cause rapid blood loss, so connections must remain secure and the site must be observed."
                }
              ]
            }
          ]
        },
        {
