        {
          "subsection_id": "towel_clip_subsection_13",
          "subsection_title": "12. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "towel_clip_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a Backhaus towel clip, a surgical draping instrument used to secure sterile towels and drapes around the operative field. It typically has ring handles, a ratchet-locking mechanism, a box joint and two sharp, pointed, curved tips. It is used in procedures such as laparotomy and caesarean section to help maintain the position of surgical drapes. Its principal risk is puncture injury if the tips are incorrectly applied. Before use, I would inspect the tips, alignment, ratchet, cleanliness and sterility.”",
                  "style": "quote"
                }
              ]
            },
