        },
        {
          "subsection_id": "towel_clip_subsection_2",
          "subsection_title": "1. Introduction and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "towel_clip_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A towel clip is a surgical instrument used to secure sterile surgical drapes or towels around the operative field. It helps maintain the sterile field by preventing drapes from shifting during surgery."
                },
                {
                  "type": "paragraph",
                  "text": "The classic towel clip encountered in OSCEs is the Backhaus towel clamp, which has two pointed, curved tips that pierce and grip the drapes."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification card"
                },
                {
                  "type": "paragraph",
                  "text": "Name: Backhaus towel clip (towel clamp)"
                },
                {
                  "type": "paragraph",
                  "text": "Classification: Draping and securing instrument"
                },
                {
                  "type": "paragraph",
                  "text": "Primary function: Securing surgical towels and drapes."
                },
                {
                  "type": "paragraph",
                  "text": "Characteristic feature: Two sharp, pointed, curved jaws that engage the drape material."
                },
                {
                  "type": "paragraph",
                  "text": "Mechanism: Usually ring handles, a box joint and a ratchet lock."
                },
                {
                  "type": "paragraph",
                  "text": "Exam tip: The most distinctive feature is the pair of sharp, pointed tips. Do not confuse them with the broad, rounded jaws of Babcock forceps or the oval jaws of sponge-holding forceps."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "towel_clip_subsection_3",
          "subsection_title": "2. Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "towel_clip_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/towel_clip_02.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/towel_clip_03.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Description and function"
                  ],
                  "rows": [
                    [
                      "Ring handles",
                      "Allow the operator to grip and manipulate the instrument."
                    ],
                    [
                      "Ratchet lock",
                      "Keeps the instrument closed once engaged."
                    ],
                    [
                      "Box joint",
                      "Connects the two halves and permits opening and closing."
                    ],
                    [
                      "Shanks",
                      "Connect the handles to the working end."
                    ],
                    [
                      "Curved jaws",
                      "Direct the tips towards one another to engage the material."
                    ],
                    [
                      "Pointed tips",
                      "Pierce and grip towels or drapes to prevent movement."
                    ],
                    [
                      "Ratchet teeth",
                      "Allow the degree of closure to be maintained."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The precise curvature, number of ratchet positions and tip configuration vary by model."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "towel_clip_subsection_4",
          "subsection_title": "3. Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "towel_clip_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/towel_clip_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A. Backhaus towel clamp"
                },
                {
                  "type": "paragraph",
                  "text": "The classic pointed, curved, ratcheted towel clip. Commonly used to secure surgical drapes and towels."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/towel_clip_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "B. Non-perforating towel clamp"
                },
                {
                  "type": "paragraph",
                  "text": "Designed to secure draping material without piercing it. Useful where puncturing the material or underlying surface should be avoided."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/towel_clip_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "C. Edna-pattern or other blunt-jawed drape clamps"
                },
                {
                  "type": "paragraph",
                  "text": "Certain drape-clamp designs use broader or less penetrating jaws. The name and exact construction vary across manufacturers and clinical settings."
                },
                {
                  "type": "paragraph",
                  "text": "Classification note: In some hospitals, “towel clip” refers specifically to the Backhaus pattern. In others, it is used more broadly for several types of drape-securing devices."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "towel_clip_subsection_5",
          "subsection_title": "4. Uses and clinical applications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "towel_clip_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The main purpose is to hold sterile towels and drapes in position around the surgical site."
                },
                {
                  "type": "table",
                  "columns": [
                    "Use",
                    "Explanation"
                  ],
                  "rows": [
                    [
                      "Securing surgical towels",
                      "Holds towels together around the operative field."
                    ],
                    [
                      "Fixing sterile drapes",
                      "Helps prevent drapes from shifting during the procedure."
                    ],
                    [
                      "Maintaining the sterile field",
                      "Reduces movement of properly positioned draping material."
                    ],
                    [
                      "Securing drapes to one another",
                      "Provides a stable arrangement around the operative site."
                    ],
                    [
                      "Selected procedural setups",
                      "May secure suitable draping material during different surgical procedures."
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "towel_clip_group_6",
              "group_title": "Surgeries in which towel clips are used",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Towel clips may be encountered in:",
                  "items": [
                    {
                      "text": "General surgery, including laparotomy and appendicectomy.",
                      "level": 0
                    },
                    {
                      "text": "Obstetrics and gynaecology, including caesarean section.",
                      "level": 0
                    },
                    {
                      "text": "Orthopaedic surgery.",
                      "level": 0
                    },
                    {
                      "text": "Urological surgery.",
                      "level": 0
                    },
                    {
                      "text": "Plastic and reconstructive surgery.",
                      "level": 0
                    },
                    {
                      "text": "Other operations requiring sterile draping.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important distinction: The Backhaus towel clip is primarily a draping instrument, not a haemostatic clamp. It should not be used indiscriminately to grasp delicate organs or vulnerable tissue."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "towel_clip_subsection_6",
          "subsection_title": "5. Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "towel_clip_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Secure fixation: The pointed tips can hold towels firmly.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Prevents drape displacement: Helps maintain the position of draping material.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Quick application: Can be applied and released efficiently.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Locking mechanism: Maintains closure without continuous hand pressure.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Reusable design: Stainless-steel versions can be reprocessed according to validated protocols.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Simple construction: Relatively straightforward to inspect and operate.",
                      "level": 0,
                      "label": "6."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "towel_clip_subsection_7",
          "subsection_title": "6. Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "towel_clip_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "The sharp tips pierce the material, leaving holes.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "They can injure the patient if applied to skin or tissue.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Excessive closure force may damage towels or drapes.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "The sharp tips pose a puncture risk to staff.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "The joint and ratchet require appropriate cleaning and inspection.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "A towel clip may not be suitable for delicate, thin or easily damaged draping materials.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "It can dislodge if applied incorrectly or if excessive tension is placed on the drapes.",
                      "level": 0,
                      "label": "7."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "towel_clip_subsection_8",
          "subsection_title": "7. Complications and risks of improper use",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "towel_clip_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Mechanism",
                    "Prevention"
                  ],
                  "rows": [
                    [
                      "Skin puncture",
                      "Tips penetrate the patient's skin.",
                      "Keep the tips confined to appropriate draping material."
                    ],
                    [
                      "Bleeding",
                      "Accidental penetration of vascular tissue.",
                      "Avoid patient tissue and vulnerable anatomical structures."
                    ],
                    [
                      "Infection risk",
                      "Skin injury or contamination of the operative field.",
                      "Maintain sterile technique and appropriate placement."
                    ],
                    [
                      "Draping damage",
                      "Excessive force tears the material.",
                      "Apply only the necessary closure force."
                    ],
                    [
                      "Staff puncture injury",
                      "Accidental contact with sharp tips.",
                      "Handle deliberately and maintain awareness of the tips."
                    ],
                    [
                      "Drape displacement",
                      "Poor placement or inadequate grip.",
                      "Check fixation and avoid excessive tension."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "High-yield safety point: A sharp towel clip should not be applied through the patient's skin simply to anchor the drapes. Its use must follow the procedure's draping protocol and avoid injury to the patient."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "towel_clip_subsection_9",
          "subsection_title": "8. Principles of proper handling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "towel_clip_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/towel_clip_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 1 — Inspect"
                },
                {
                  "type": "paragraph",
                  "text": "Check the pointed tips for damage, confirm alignment, and test that the ratchet opens and closes correctly."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/towel_clip_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 2 — Position the drapes"
                },
                {
                  "type": "paragraph",
                  "text": "Arrange the sterile towels or drapes to establish the intended operative field before securing them."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/towel_clip_08.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 3 — Secure the material"
                },
                {
                  "type": "paragraph",
                  "text": "Engage an appropriate portion of draping material and apply enough closure to hold it securely without unnecessary tearing or tension."
                },
                {
                  "type": "paragraph",
                  "text": "Step 4 — Release and reprocess"
                },
                {
                  "type": "paragraph",
                  "text": "Release the ratchet carefully when removing the clip, keeping the sharp points under control. Reprocess reusable instruments according to protocol."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "towel_clip_subsection_10",
          "subsection_title": "9. Maintenance, cleaning and sterilization",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "towel_clip_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "For reusable towel clips:",
                  "items": [
                    {
                      "text": "Remove visible contamination promptly after use.",
                      "level": 0
                    },
                    {
                      "text": "Clean the hinge, box joint and ratchet thoroughly.",
                      "level": 0
                    },
                    {
                      "text": "Inspect the tips for bending, bluntness, corrosion or misalignment.",
                      "level": 0
                    },
                    {
                      "text": "Check that the ratchet engages and releases smoothly.",
                      "level": 0
                    },
                    {
                      "text": "Protect the sharp tips during handling and transport.",
                      "level": 0
                    },
                    {
                      "text": "Sterilize using a validated method compatible with the manufacturer's instructions.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A damaged or misaligned towel clip may fail to hold drapes securely and should be removed from service."
                }
              ]
            }
          ]
        },
