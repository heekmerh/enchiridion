  "sections": [
    {
      "section_id": "oropharyngeal_airway_guedel_airway_section_1",
      "section_title": "Oropharyngeal airway (Guedel airway)",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "oropharyngeal_airway_guedel_airway_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oropharyngeal_airway_guedel_airway_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/oropharyngeal_airway_guedel_airway_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "The oropharyngeal airway (OPA), commonly called a Guedel airway, is a curved airway adjunct inserted through the mouth to help keep the upper airway open in an unconscious patient who lacks an intact gag reflex."
                },
                {
                  "type": "paragraph",
                  "text": "It is a common OSCE instrument because examiners may ask you to identify it, select the correct size, demonstrate insertion, explain contraindications, and recognise complications."
                },
                {
                  "type": "paragraph",
                  "text": "Key principle: The OPA helps prevent the tongue and soft tissues from obstructing the upper airway. It does not provide a definitive airway, protect reliably against aspiration, or replace ventilation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oropharyngeal_airway_guedel_airway_subsection_2",
          "subsection_title": "Identification and definition",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oropharyngeal_airway_guedel_airway_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Name: Oropharyngeal airway."
                },
                {
                  "type": "paragraph",
                  "text": "Alternative name: Guedel airway."
                },
                {
                  "type": "paragraph",
                  "text": "Route: Through the mouth into the oropharynx."
                },
                {
                  "type": "paragraph",
                  "text": "Main purpose: To maintain upper-airway patency in a suitably unconscious patient."
                },
                {
                  "type": "paragraph",
                  "text": "Typical material: Medical-grade plastic, usually curved, with a flange and a central airway channel."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oropharyngeal_airway_guedel_airway_subsection_3",
          "subsection_title": "Types and sizes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oropharyngeal_airway_guedel_airway_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/oropharyngeal_airway_guedel_airway_02.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Adult OPAs"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Larger devices designed for adult anatomy. Select by measuring the patient's anatomy rather than assuming size from age alone."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Pediatric and infant OPAs"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Smaller devices for children and infants. Correct sizing and insertion technique are particularly important because the airway is smaller and more easily obstructed."
                },
                {
                  "type": "paragraph",
                  "text": "Sizes vary by manufacturer. Many Guedel airways are colour-coded, but colour is not universal; check the printed size or the manufacturer's chart."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oropharyngeal_airway_guedel_airway_subsection_4",
          "subsection_title": "Parts and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oropharyngeal_airway_guedel_airway_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/oropharyngeal_airway_guedel_airway_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Flange"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Rests outside the mouth and helps prevent the device from being inserted too far."
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Curved body"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Follows the shape of the oral cavity and oropharynx."
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Distal end and lumen"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The distal end sits in the oropharynx; the central channel allows air to pass through the device."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oropharyngeal_airway_guedel_airway_subsection_5",
          "subsection_title": "Indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oropharyngeal_airway_guedel_airway_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "An OPA may be used to:"
                },
                {
                  "type": "paragraph",
                  "text": "Maintain airway patency in an unconscious patient without an intact gag reflex."
                },
                {
                  "type": "paragraph",
                  "text": "Prevent the tongue from falling backward and obstructing the upper airway."
                },
                {
                  "type": "paragraph",
                  "text": "Assist bag-valve-mask ventilation."
                },
                {
                  "type": "paragraph",
                  "text": "Support airway management during resuscitation."
                },
                {
                  "type": "paragraph",
                  "text": "Facilitate suctioning of the oropharynx when clinically appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Important: If the patient is conscious or has an intact gag reflex, an OPA can provoke gagging, vomiting, laryngospasm, or aspiration. Consider an alternative airway adjunct when indicated."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oropharyngeal_airway_guedel_airway_subsection_6",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oropharyngeal_airway_guedel_airway_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Simple, inexpensive, and readily available."
                },
                {
                  "type": "paragraph",
                  "text": "Quick to insert when appropriately indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Helps relieve tongue-related upper-airway obstruction."
                },
                {
                  "type": "paragraph",
                  "text": "Can improve the effectiveness of bag-valve-mask ventilation."
                },
                {
                  "type": "paragraph",
                  "text": "Does not require electricity or a gas supply."
                },
                {
                  "type": "paragraph",
                  "text": "Available in a range of sizes for adults and children."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "oropharyngeal_airway_guedel_airway_subsection_7",
          "subsection_title": "Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "oropharyngeal_airway_guedel_airway_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Cannot be tolerated reliably by a conscious patient or one with an intact gag reflex."
                },
                {
                  "type": "paragraph",
                  "text": "Does not prevent aspiration of vomit or secretions."
                },
                {
                  "type": "paragraph",
                  "text": "Incorrect sizing can worsen airway obstruction."
                },
                {
                  "type": "paragraph",
                  "text": "Incorrect insertion can cause oral or pharyngeal trauma."
                },
                {
                  "type": "paragraph",
                  "text": "May trigger vomiting, laryngospasm, or airway obstruction if poorly selected or positioned."
                },
                {
                  "type": "paragraph",
                  "text": "Does not replace definitive airway management when required."
                }
              ]
            }
          ]
        },
        {
