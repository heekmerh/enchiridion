        {
          "subsection_id": "quick_revision_part_16_subsection_5",
          "subsection_title": "Causes of Bulging Fontanelle",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_16_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Meningitis",
                    "Encephalitis",
                    "Hydrocephalus",
                    "Raised intracranial pressure",
                    "Intracranial haemorrhage",
                    "Cerebral oedema",
                    "Brain abscess",
                    "Intracranial tumour",
                    "Severe hypoxic-ischaemic encephalopathy",
                    "Cerebral venous sinus thrombosis",
                    "Important distinction"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A fontanelle may transiently appear full when an infant is crying, coughing or lying flat."
                },
                {
                  "type": "paragraph",
                  "text": "Persistent bulging when the infant is calm and upright, especially with fever, vomiting, lethargy or seizures, requires urgent assessment."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_16_subsection_6",
          "subsection_title": "Causes of Delayed and Early Fontanelle Closure",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_16_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Delayed closure",
                    "Rickets / vitamin D deficiency",
                    "Hypothyroidism",
                    "Hydrocephalus",
                    "Raised intracranial pressure",
                    "Down syndrome",
                    "Prematurity",
                    "Osteogenesis imperfecta",
                    "Achondroplasia",
                    "Malnutrition",
                    "Familial variation",
                    "Early closure",
                    "Craniosynostosis",
                    "Microcephaly",
                    "Hyperthyroidism (rare)"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Severe dehydration may make the fontanelle appear sunken, but does not cause true premature suture fusion"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Normal variation"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Exam pearl: Fontanelle closure timing varies. Assess head circumference, skull shape, growth and development rather than relying on closure alone."
                }
              ]
            }
          ]
