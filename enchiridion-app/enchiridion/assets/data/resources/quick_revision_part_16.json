        {
          "subsection_id": "quick_revision_part_16_subsection_3",
          "subsection_title": "National Programme on Immunization (NPI) Schedule",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_16_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Routine childhood immunization schedule; vaccine timing and eligibility should be checked against the current Nigerian national schedule."
                },
                {
                  "type": "table",
                  "columns": [
                    "Age",
                    "Vaccine",
                    "Protection against"
                  ],
                  "rows": [
                    [
                      "At birth",
                      "BCG",
                      "Severe childhood tuberculosis"
                    ],
                    [
                      "At birth",
                      "OPV 0",
                      "Poliomyelitis"
                    ],
                    [
                      "At birth",
                      "Hepatitis B birth dose (HepB-BD)",
                      "Hepatitis B"
                    ],
                    [
                      "6 weeks",
                      "OPV 1, Pentavalent 1, PCV 1, Rotavirus 1",
                      "Polio, diphtheria, pertussis, tetanus, hepatitis B, Hib, pneumococcal disease, rotavirus"
                    ],
                    [
                      "6 weeks",
                      "IPV, according to current national schedule",
                      "Poliomyelitis"
                    ],
                    [
                      "10 weeks",
                      "OPV 2, Pentavalent 2, PCV 2, Rotavirus 2",
                      "Same diseases as above"
                    ],
                    [
                      "14 weeks",
                      "OPV 3, Pentavalent 3, PCV 3, IPV, Rotavirus 3 where applicable",
                      "Same diseases as above"
                    ],
                    [
                      "6 months",
                      "Vitamin A supplementation, according to programme guidance",
                      "Prevention of vitamin A deficiency"
                    ],
                    [
                      "9 months",
                      "Measles-containing vaccine 1, Yellow fever",
                      "Measles and yellow fever"
                    ],
                    [
                      "9 months",
                      "MenA vaccine, according to national schedule",
                      "Meningococcal disease"
                    ],
                    [
                      "12 months",
                      "Vitamin A supplementation, according to programme guidance",
                      "Prevention of vitamin A deficiency"
                    ],
                    [
                      "15 months",
                      "Measles-containing vaccine 2, where included in the current schedule",
                      "Measles"
                    ],
                    [
                      "18 months",
                      "Second-year-of-life immunisation contacts and catch-up vaccines, according to current national guidance",
                      "Depends on national schedule"
                    ]
                  ]
                },
                {
                  "type": "checklist",
                  "items": [
                    "Other important points"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "HPV vaccine: routine vaccination for eligible girls, generally in the 9–14-year age group, according to Nigeria’s programme."
                },
                {
                  "type": "paragraph",
                  "text": "Tetanus-containing vaccines: during pregnancy, according to prior vaccination history and national guidance."
                },
                {
                  "type": "paragraph",
                  "text": "Missed doses: provide catch-up vaccination; do not routinely restart a vaccine series."
                },
                {
                  "type": "paragraph",
                  "text": "Vitamin A is a supplement, not a vaccine."
                }
              ]
            }
          ]
        },
