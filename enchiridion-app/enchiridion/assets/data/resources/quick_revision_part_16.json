        {
          "subsection_id": "quick_revision_part_16_subsection_8",
          "subsection_title": "ReSoMal and ORS: constituents and osmolality",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_16_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Constituent",
                    "ReSoMal (approx. mmol/L)",
                    "WHO low-osmolarity ORS (mmol/L)"
                  ],
                  "rows": [
                    [
                      "Sodium",
                      "45",
                      "75"
                    ],
                    [
                      "Potassium",
                      "40",
                      "20"
                    ],
                    [
                      "Chloride",
                      "70",
                      "65"
                    ],
                    [
                      "Glucose",
                      "125",
                      "75"
                    ],
                    [
                      "Citrate",
                      "7",
                      "10"
                    ],
                    [
                      "Magnesium",
                      "3",
                      "—"
                    ],
                    [
                      "Zinc",
                      "0.3",
                      "—"
                    ],
                    [
                      "Copper",
                      "0.045",
                      "—"
                    ],
                    [
                      "Total osmolarity",
                      "~300 mOsm/L",
                      "245 mOsm/L"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "ReSoMal: Special rehydration solution for selected children with severe acute malnutrition; use under clinical supervision."
                },
                {
                  "type": "paragraph",
                  "text": "WHO low-osmolarity ORS: Standard oral rehydration solution for diarrhoeal dehydration."
                },
                {
                  "type": "paragraph",
                  "text": "Important: Avoid ReSoMal in suspected cholera or profuse watery diarrhoea because its sodium content is low; use appropriate standard ORS and follow the clinical protocol."
                }
              ]
            }
          ]
