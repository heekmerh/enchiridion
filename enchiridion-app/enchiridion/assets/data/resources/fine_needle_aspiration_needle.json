        {
          "subsection_id": "fine_needle_aspiration_needle_subsection_2",
          "subsection_title": "Introduction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "fine_needle_aspiration_needle_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A fine-needle aspiration (FNA) needle is a thin, hollow needle used to aspirate cells, cellular material or fluid from a lump, cyst, lymph node, organ or other tissue for cytological examination."
                },
                {
                  "type": "paragraph",
                  "text": "It is commonly used to investigate breast lumps, thyroid nodules, enlarged lymph nodes and selected salivary gland lesions."
                },
                {
                  "type": "paragraph",
                  "text": "The needle is usually attached to a syringe, either directly or through a needle holder. Negative pressure may be applied to draw material into the needle, although some techniques use capillary action without suction."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“This is a fine-needle aspiration needle, used to obtain cells or fluid from a lesion for cytological examination. It is commonly attached to a syringe and may be used with palpation or image guidance.”"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "fine_needle_aspiration_needle_subsection_3",
          "subsection_title": "Identification and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "fine_needle_aspiration_needle_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/fine_needle_aspiration_needle_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "communities.springernature.com"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The components depend on whether the needle is presented alone or as part of an FNA assembly."
                },
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Function"
                  ],
                  "rows": [
                    [
                      "Needle tip",
                      "Penetrates the tissue to be sampled."
                    ],
                    [
                      "Needle shaft",
                      "Provides a passage for cells and fluid."
                    ],
                    [
                      "Needle lumen",
                      "Hollow channel through which aspirated material passes."
                    ],
                    [
                      "Needle hub",
                      "Connects the needle to the syringe or needle holder."
                    ],
                    [
                      "Syringe barrel",
                      "Holds the aspirated material."
                    ],
                    [
                      "Syringe plunger",
                      "Creates negative pressure when withdrawn."
                    ],
                    [
                      "Needle holder, if present",
                      "Allows controlled movement of the needle and syringe."
                    ],
                    [
                      "Specimen slide or container",
                      "Receives the collected material for laboratory examination."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Exam tip: If the station presents only the needle, label its tip, shaft, lumen and hub. Do not label a syringe or needle holder as part of the needle itself."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "fine_needle_aspiration_needle_subsection_4",
          "subsection_title": "Properties and characteristics",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "fine_needle_aspiration_needle_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Material: Usually stainless steel or another suitable medical-grade material."
                },
                {
                  "type": "paragraph",
                  "text": "Design: Thin, hollow and sharp."
                },
                {
                  "type": "paragraph",
                  "text": "Gauge: Commonly approximately 22–25G for many FNA procedures, although other gauges are used."
                },
                {
                  "type": "paragraph",
                  "text": "Length: Varies according to the target tissue and depth."
                },
                {
                  "type": "paragraph",
                  "text": "Sterility: Usually supplied sterile and intended for single use."
                },
                {
                  "type": "paragraph",
                  "text": "Sampling mechanism: Aspiration with a syringe, capillary sampling or a combination of techniques."
                },
                {
                  "type": "paragraph",
                  "text": "Specimen type: Primarily cells and fluid rather than an intact tissue core."
                },
                {
                  "type": "paragraph",
                  "text": "Guidance: May be performed using palpation, ultrasound or other suitable imaging methods."
                },
                {
                  "type": "paragraph",
                  "text": "Remember that gauge selection depends on the lesion, the site and the intended specimen."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "fine_needle_aspiration_needle_subsection_5",
          "subsection_title": "Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "fine_needle_aspiration_needle_group_5",
              "group_title": "A. According to sampling technique",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/fine_needle_aspiration_needle_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Aspiration FNA"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A syringe generates negative pressure to draw cells or fluid into the needle."
                },
                {
                  "type": "paragraph",
                  "text": "Use: Selected breast lumps, lymph nodes and thyroid nodules."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/fine_needle_aspiration_needle_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Non-aspiration FNA"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Material enters the needle mainly by capillary action as the needle is moved gently within the lesion."
                },
                {
                  "type": "paragraph",
                  "text": "Use: Selected superficial lesions, particularly where reduced suction may be helpful."
                }
              ]
            },
            {
              "group_id": "fine_needle_aspiration_needle_group_6",
              "group_title": "B. According to guidance",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Palpation-guided FNA."
                },
                {
                  "type": "paragraph",
                  "text": "Ultrasound-guided FNA."
                },
                {
                  "type": "paragraph",
                  "text": "CT-guided FNA for selected deep lesions."
                },
                {
                  "type": "paragraph",
                  "text": "Other image-guided techniques where clinically appropriate."
                }
              ]
            },
            {
              "group_id": "fine_needle_aspiration_needle_group_7",
              "group_title": "C. According to needle size",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Needles vary in gauge and length. A fine-bore needle is selected to balance cellular yield, ease of penetration and patient comfort."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "fine_needle_aspiration_needle_subsection_6",
          "subsection_title": "Principle of operation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "fine_needle_aspiration_needle_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "FNA uses a thin needle to collect cellular material from a target lesion without removing a core of tissue."
                },
                {
                  "type": "paragraph",
                  "text": "The general principle is:"
                },
                {
                  "type": "paragraph",
                  "text": "Identify the lesion and select an appropriate needle."
                },
                {
                  "type": "paragraph",
                  "text": "Prepare the skin using aseptic technique."
                },
                {
                  "type": "paragraph",
                  "text": "Position the needle in the target, using image guidance when indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Move the needle gently within the lesion."
                },
                {
                  "type": "paragraph",
                  "text": "Apply negative pressure when using an aspiration technique."
                },
                {
                  "type": "paragraph",
                  "text": "Release suction before withdrawing the needle, according to the technique used."
                },
                {
                  "type": "paragraph",
                  "text": "Expel the collected material onto a slide or into an appropriate specimen container."
                },
                {
                  "type": "paragraph",
                  "text": "Prepare and send the specimen for cytological assessment."
                },
                {
                  "type": "paragraph",
                  "text": "The precise technique depends on the target, the operator's training and local protocol."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "fine_needle_aspiration_needle_subsection_7",
          "subsection_title": "Indications and uses",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "fine_needle_aspiration_needle_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "FNA may be used for:"
                },
                {
                  "type": "paragraph",
                  "text": "Initial assessment of selected palpable breast lumps."
                },
                {
                  "type": "paragraph",
                  "text": "Aspiration of breast cysts."
                },
                {
                  "type": "paragraph",
                  "text": "Investigation of enlarged lymph nodes."
                },
                {
                  "type": "paragraph",
                  "text": "Assessment of thyroid nodules."
                },
                {
                  "type": "paragraph",
                  "text": "Sampling of selected salivary gland lesions."
                },
                {
                  "type": "paragraph",
                  "text": "Evaluation of superficial soft-tissue masses."
                },
                {
                  "type": "paragraph",
                  "text": "Sampling selected deep lesions under imaging guidance."
                },
                {
                  "type": "paragraph",
                  "text": "Obtaining material for cytology or selected microbiological tests."
                },
                {
                  "type": "paragraph",
                  "text": "Breast-specific point: FNA can help assess a breast cyst or selected solid lesion, but core needle biopsy is generally preferred when a suspicious breast mass requires histological architecture and assessment of invasion."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "fine_needle_aspiration_needle_subsection_8",
          "subsection_title": "Procedures in which it is used",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "fine_needle_aspiration_needle_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "FNA is a sampling procedure rather than an open surgical instrument. Examples include:"
                },
                {
                  "type": "paragraph",
                  "text": "Breast FNA cytology."
                },
                {
                  "type": "paragraph",
                  "text": "Thyroid nodule aspiration."
                },
                {
                  "type": "paragraph",
                  "text": "Fine-needle aspiration of lymph nodes."
                },
                {
                  "type": "paragraph",
                  "text": "Selected salivary gland lesion sampling."
                },
                {
                  "type": "paragraph",
                  "text": "Image-guided aspiration of selected masses or collections."
                },
                {
                  "type": "paragraph",
                  "text": "Aspiration of appropriate cystic lesions."
                },
                {
                  "type": "paragraph",
                  "text": "It may help guide decisions about further biopsy, surveillance or definitive surgery."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "fine_needle_aspiration_needle_subsection_9",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "fine_needle_aspiration_needle_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Minimally invasive: Requires only a small puncture."
                },
                {
                  "type": "paragraph",
                  "text": "Relatively inexpensive: Equipment is usually simple and widely available."
                },
                {
                  "type": "paragraph",
                  "text": "Rapid: Sampling often takes only a short time."
                },
                {
                  "type": "paragraph",
                  "text": "Usually outpatient: Hospital admission is generally unnecessary."
                },
                {
                  "type": "paragraph",
                  "text": "Often requires only local anaesthesia or none: Depending on the site and procedure."
                },
                {
                  "type": "paragraph",
                  "text": "Low tissue trauma: The small needle usually causes limited disruption."
                },
                {
                  "type": "paragraph",
                  "text": "Useful for cyst aspiration: Can remove fluid for symptom relief and investigation."
                },
                {
                  "type": "paragraph",
                  "text": "Repeatable: Additional sampling can be performed when clinically indicated."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "fine_needle_aspiration_needle_subsection_10",
          "subsection_title": "Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "fine_needle_aspiration_needle_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "It does not usually preserve tissue architecture."
                },
                {
                  "type": "paragraph",
                  "text": "The specimen may contain too few cells for diagnosis."
                },
                {
                  "type": "paragraph",
                  "text": "Blood contamination may obscure cellular detail."
                },
                {
                  "type": "paragraph",
                  "text": "Results can be indeterminate or non-diagnostic."
                },
                {
                  "type": "paragraph",
                  "text": "Some lesions are difficult to sample accurately without imaging."
                },
                {
                  "type": "paragraph",
                  "text": "Cytology may not reliably distinguish in-situ from invasive breast carcinoma."
                },
                {
                  "type": "paragraph",
                  "text": "A benign cytology result may not exclude malignancy when clinical or imaging findings remain suspicious."
                },
                {
                  "type": "paragraph",
                  "text": "Additional core biopsy or surgical biopsy may be required."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "fine_needle_aspiration_needle_subsection_11",
          "subsection_title": "Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "fine_needle_aspiration_needle_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Bleeding and haematoma"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Usually minor but more significant bleeding can occur in patients with bleeding risks or in vascular lesions."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Pain and bruising"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Usually mild and temporary."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Infection"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Uncommon when aseptic technique is followed."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Vasovagal reaction"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Some patients may experience dizziness, sweating or fainting during the procedure."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Sampling error"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The needle may fail to obtain representative cells, potentially resulting in a false-negative or non-diagnostic result."
                },
                {
                  "type": "paragraph",
                  "text": "Site-specific complications are also possible. For example, FNA of a deep lesion near the lung can carry a risk of pneumothorax."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "fine_needle_aspiration_needle_subsection_12",
          "subsection_title": "Contraindications and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "fine_needle_aspiration_needle_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "There are few absolute contraindications, but precautions include:"
                },
                {
                  "type": "paragraph",
                  "text": "Significant uncorrected bleeding disorders."
                },
                {
                  "type": "paragraph",
                  "text": "Anticoagulant use requiring individual assessment."
                },
                {
                  "type": "paragraph",
                  "text": "Infection at the proposed puncture site."
                },
                {
                  "type": "paragraph",
                  "text": "Inability to cooperate or remain safely positioned."
                },
                {
                  "type": "paragraph",
                  "text": "Lesions close to major vessels or vulnerable structures."
                },
                {
                  "type": "paragraph",
                  "text": "Inadequate access to a deep lesion without appropriate imaging."
                },
                {
                  "type": "paragraph",
                  "text": "The risks and benefits should be assessed individually. Anticoagulant medication should not be stopped automatically."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "fine_needle_aspiration_needle_subsection_13",
          "subsection_title": "Specimen preparation and handling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "fine_needle_aspiration_needle_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Specimen handling is an important OSCE topic because an adequate sample may still be rendered non-diagnostic by poor preparation."
                },
                {
                  "type": "paragraph",
                  "text": "For cytological examination:"
                },
                {
                  "type": "paragraph",
                  "text": "Expel the aspirated material onto a clean glass slide or into an appropriate collection medium."
                },
                {
                  "type": "paragraph",
                  "text": "Prepare smears according to the laboratory's protocol."
                },
                {
                  "type": "paragraph",
                  "text": "Air-dry or immediately fix the smears as required by the intended staining method."
                },
                {
                  "type": "paragraph",
                  "text": "Place any remaining material into the specified cytology medium if required."
                },
                {
                  "type": "paragraph",
                  "text": "Label all slides and containers accurately with patient identifiers and the anatomical site."
                },
                {
                  "type": "paragraph",
                  "text": "Provide clinical details and relevant imaging findings."
                },
                {
                  "type": "paragraph",
                  "text": "Send the specimen promptly to the laboratory."
                },
                {
                  "type": "paragraph",
                  "text": "Important: Do not routinely place all FNA material in formalin. Cytology samples require preparation appropriate to the laboratory's intended analysis."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "fine_needle_aspiration_needle_subsection_14",
          "subsection_title": "FNA versus core needle biopsy",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "fine_needle_aspiration_needle_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "FNA",
                    "Core needle biopsy"
                  ],
                  "rows": [
                    [
                      "Needle",
                      "Fine-bore",
                      "Usually larger-bore"
                    ],
                    [
