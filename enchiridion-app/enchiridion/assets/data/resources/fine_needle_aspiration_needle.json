      "subsections": [
        {
          "subsection_id": "fine_needle_aspiration_needle_subsection_1",
          "subsection_title": "Fine-Needle Aspiration (FNA) Needle",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "fine_needle_aspiration_needle_group_1",
