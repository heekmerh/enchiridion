        {
          "subsection_id": "quick_revision_part_4_subsection_4",
          "subsection_title": "Causes of Umbilical Hernia and Differential Diagnosis",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_4_group_13",
              "group_title": "Causes and Predisposing Factors",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Congenital:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Failure of closure of the umbilical ring;",
                    "prematurity;"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "low birth weight."
                },
                {
                  "type": "paragraph",
                  "text": "Increased intra-abdominal pressure:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Pregnancy,",
                    "obesity,",
                    "ascites,",
                    "chronic cough,",
                    "chronic constipation,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "urinary obstruction."
                },
                {
                  "type": "paragraph",
                  "text": "Hepatic:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Cirrhosis with ascites,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "portal hypertension."
                },
                {
                  "type": "paragraph",
                  "text": "Respiratory:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "COPD,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "chronic cough."
                },
                {
                  "type": "paragraph",
                  "text": "Gastrointestinal:"
                },
                {
