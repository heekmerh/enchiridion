          "content_groups": [
            {
              "group_id": "quick_revision_part_4_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Indications",
                    "Irreversible limb ischaemia",
                    "Severe peripheral arterial disease with non-salvageable limb",
                    "Diabetic foot with uncontrolled infection or gangrene",
                    "Severe trauma with irreparable damage",
                    "Malignant tumours involving the limb",
                    "Necrotising soft-tissue infection",
                    "Uncontrolled chronic osteomyelitis",
                    "Congenital limb abnormalities in selected cases",
                    "Severe frostbite with non-viable tissue",
                    "Contraindications / reasons to defer",
                    "No absolute contraindication when amputation is life-saving",
                    "Uncorrected shock, where stabilisation is possible before definitive surgery",
                    "Uncorrected coagulopathy, where correction is feasible",
                    "Uncontrolled metabolic derangements, where optimisation is feasible",
                    "Inadequate perfusion at the proposed stump level",
                    "Unclear viability of tissue when reassessment is safe"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Inadequate consent or decision-making authority, except in emergencies under applicable law"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Complications",
                    "Immediate",
                    "Haemorrhage",
                    "Shock",
                    "Anaesthetic complications",
                    "Wound infection",
                    "Skin flap necrosis",
                    "Deep vein thrombosis/pulmonary embolism",
                    "Early",
                    "Wound dehiscence",
                    "Haematoma",
                    "Seroma",
                    "Delayed wound healing",
                    "Residual limb oedema",
                    "Contractures",
                    "Late",
                    "Phantom limb sensation",
                    "Phantom limb pain",
                    "Neuroma",
                    "Chronic residual limb pain",
                    "Stump ulceration",
                    "Prosthesis-related problems",
                    "Depression and psychological distress",
                    "Heterotopic ossification",
                    "Re-amputation"
                  ]
                },
                {
                  "type": "checklist",
                  "items": [
                    "6. Grading of Pressure Ulcers (Stages 1–4)"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Stage 1:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Intact skin;",
                    "non-blanchable erythema.",
                    "Skin is red",
                    "Does not turn white when pressed"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Stage 2:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Partial-thickness skin loss (epidermis &/or dermis)",
                    "exposed dermis;",
                    "shallow open ulcer or blister.",
                    "Abrasion",
                    "Shallow crater"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Stage 3:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Full-thickness skin loss;",
                    "subcutaneous fat may be visible;",
                    "no exposed muscle, tendon or bone.",
                    "Deep crater",
                    "Necrosis of subcutaneous tissue"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Stage 4:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Full-thickness skin and tissue loss;",
                    "tissue necrosis",
                    "exposed or directly palpable fascia, muscle, tendon, cartilage or bone.",
                    "7. Cushing's Triad"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Hypertension — often with widened pulse pressure."
                },
                {
                  "type": "paragraph",
                  "text": "Bradycardia."
                },
                {
                  "type": "paragraph",
                  "text": "Irregular respiration — e.g. Cheyne–Stokes or ataxic breathing."
                }
              ]
            }
          ]
        }
