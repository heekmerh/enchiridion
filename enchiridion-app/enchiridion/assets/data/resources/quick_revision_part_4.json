      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "quick_revision_part_4_subsection_1",
          "subsection_title": "Colostomy",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_4_group_1",
              "group_title": "A. Types",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "By anatomical location"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Ascending colostomy."
                },
                {
                  "type": "paragraph",
                  "text": "Transverse colostomy."
                },
                {
                  "type": "paragraph",
                  "text": "Descending colostomy."
                },
                {
                  "type": "paragraph",
                  "text": "Sigmoid colostomy."
                },
                {
                  "type": "checklist",
                  "items": [
                    "By construction",
                    "Loop colostomy (diverticulitis, bowel obstruction)",
                    "End colostomy (rectal ca, trauma)"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Double-barrel colostomy."
                },
                {
                  "type": "paragraph",
                  "text": "Divided colostomy."
                },
                {
                  "type": "checklist",
                  "items": [
                    "By duration"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Temporary."
                },
                {
                  "type": "paragraph",
                  "text": "Permanent."
                }
              ]
            },
            {
              "group_id": "quick_revision_part_4_group_2",
              "group_title": "B. Indications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Colorectal cancer."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Anal cancer",
                    "Rectal cancer",
                    "Diverticulitis",
                    "Trauma to the colon or rectum",
                    "Inflammatory bowel dx"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Intestinal obstruction."
                },
                {
                  "type": "paragraph",
                  "text": "Colonic perforation."
                },
                {
                  "type": "paragraph",
                  "text": "Bowel trauma."
                },
                {
                  "type": "paragraph",
                  "text": "Complicated diverticulitis."
                },
                {
                  "type": "paragraph",
                  "text": "Faecal peritonitis."
                },
                {
                  "type": "paragraph",
                  "text": "Volvulus with compromised bowel."
                },
                {
                  "type": "paragraph",
                  "text": "Hirschsprung disease."
                },
                {
                  "type": "paragraph",
                  "text": "Anorectal malformations."
                },
                {
                  "type": "paragraph",
                  "text": "Faecal diversion for selected perineal wounds."
                },
                {
                  "type": "paragraph",
                  "text": "Complex perianal fistula or severe perineal sepsis in selected cases."
                },
                {
                  "type": "paragraph",
                  "text": "Protection of a distal anastomosis in selected patients."
                }
              ]
            },
            {
              "group_id": "quick_revision_part_4_group_3",
              "group_title": "C. Contraindications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "No absolute contraindication when a colostomy is lifesaving or clinically necessary."
                },
                {
                  "type": "paragraph",
                  "text": "Relative/technical contraindications:"
                },
                {
                  "type": "paragraph",
                  "text": "Severe uncorrected coagulopathy."
                },
                {
                  "type": "paragraph",
                  "text": "Haemodynamic instability requiring initial resuscitation."
                },
                {
                  "type": "paragraph",
                  "text": "Severe abdominal wall infection at the proposed site."
                },
                {
                  "type": "paragraph",
                  "text": "Inadequate bowel length or blood supply."
                },
                {
                  "type": "paragraph",
                  "text": "Severe skin disease at the intended stoma site."
                },
                {
                  "type": "paragraph",
                  "text": "Anatomical constraints preventing safe stoma formation."
                },
                {
                  "type": "paragraph",
                  "text": "Poor general health."
                }
              ]
            },
            {
              "group_id": "quick_revision_part_4_group_4",
              "group_title": "D. Complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Stoma-related"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Ischaemia and necrosis."
                },
                {
                  "type": "paragraph",
                  "text": "Retraction."
                },
                {
                  "type": "paragraph",
                  "text": "Prolapse."
                },
                {
                  "type": "paragraph",
                  "text": "Parastomal hernia."
                },
                {
                  "type": "paragraph",
                  "text": "Stomal stenosis."
                },
                {
                  "type": "paragraph",
                  "text": "Mucocutaneous separation."
                },
                {
                  "type": "paragraph",
                  "text": "Peristomal dermatitis."
                },
                {
                  "type": "paragraph",
                  "text": "Peristomal infection."
                },
                {
                  "type": "paragraph",
                  "text": "Bleeding."
                },
                {
                  "type": "paragraph",
                  "text": "High-output losses (more typical of ileostomy than colostomy)."
                },
                {
                  "type": "paragraph",
                  "text": "Obstruction."
                },
                {
                  "type": "paragraph",
                  "text": "Stoma outlet stenosis."
                },
                {
                  "type": "paragraph",
                  "text": "Poor appliance fit and leakage."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Other complications"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Wound infection."
                },
                {
                  "type": "paragraph",
                  "text": "Intra-abdominal abscess."
                },
                {
                  "type": "paragraph",
                  "text": "Peritonitis."
                },
                {
                  "type": "paragraph",
                  "text": "Bowel obstruction/adhesions."
                },
                {
                  "type": "paragraph",
                  "text": "Anastomotic leak if a bowel anastomosis is also performed."
                },
                {
                  "type": "paragraph",
                  "text": "Incisional hernia."
                },
                {
                  "type": "paragraph",
                  "text": "Venous thromboembolism."
                },
                {
                  "type": "paragraph",
                  "text": "Psychological distress and body-image concerns."
                },
                {
                  "type": "paragraph",
                  "text": "Dehydration and electrolyte disturbances, particularly with proximal/high-output stomas."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Skin irritation"
                  ]
                }
              ]
            },
            {
              "group_id": "quick_revision_part_4_group_5",
              "group_title": "E. Commonly Used Part and Why",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Sigmoid colon: Commonly used for permanent end colostomy."
                },
                {
                  "type": "paragraph",
                  "text": "Transverse colon: Commonly used for loop colostomy and temporary diversion."
                },
                {
                  "type": "paragraph",
                  "text": "Reasons:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Adequate mobility,",
                    "suitable mesentery,",
                    "accessible abdominal wall,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "generally reliable blood supply and formation of a protruding stoma."
                },
                {
                  "type": "paragraph",
                  "text": "Stoma site: Usually marked preoperatively through the rectus abdominis muscle, away from scars, skin folds, bony prominences and the beltline."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_4_subsection_2",
          "subsection_title": "Types of Gangrene",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_4_group_6",
              "group_title": "A. Dry Gangrene (due to decreased blood flow leading to necrosis without bacteria infection)",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Cause:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Chronic arterial insufficiency,",
                    "atherosclerosis,",
                    "peripheral arterial disease,",
                    "diabetes,",
                    "thromboangiitis obliterans,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "frostbite."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Severe burns"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Features:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Dry,",
                    "shrivelled,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "black tissue; clear line of demarcation; usually slow progression; minimal infection initially."
                },
                {
                  "type": "paragraph",
                  "text": "Common sites:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Toes,",
                    "feet,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "fingers."
                },
                {
                  "type": "paragraph",
                  "text": "Treatment:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Restore perfusion when feasible;",
                    "vascular assessment;",
                    "analgesia;",
                    "wound care;",
                    "surgical debridement or amputation when indicated."
                  ]
                }
              ]
            },
            {
              "group_id": "quick_revision_part_4_group_7",
              "group_title": "B. Wet Gangrene (due to decreased blood flow and bacterial infection)",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Cause:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Severe ischaemia with superimposed infection;",
                    "diabetic foot infection; infected wounds;"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "acute limb ischaemia with tissue necrosis."
                },
                {
                  "type": "paragraph",
                  "text": "Features:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Swollen,",
                    "moist,",
                    "discoloured tissue;",
                    "blisters;",
                    "foul-smelling discharge;",
                    "spreading necrosis;"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "systemic toxicity."
                },
                {
                  "type": "paragraph",
                  "text": "Common sites:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Feet,",
                    "limbs,",
                    "bowel,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "gallbladder."
                },
                {
                  "type": "paragraph",
                  "text": "Treatment:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Emergency surgical assessment;",
                    "broad-spectrum IV antibiotics;",
                    "urgent debridement or amputation;",
                    "resuscitation and treatment of sepsis;",
                    "revascularisation when appropriate.",
                    "hyperbaric oxygen therapy"
                  ]
                }
              ]
            },
            {
              "group_id": "quick_revision_part_4_group_8",
              "group_title": "C. Gas Gangrene (Clostridial Myonecrosis)",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Cause:"
                },
                {
                  "type": "paragraph",
                  "text": "Clostridium perfringens and other clostridial species, usually after contaminated traumatic or surgical wounds."
                },
                {
                  "type": "paragraph",
                  "text": "Features:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Severe pain,",
                    "Pale",
                    "Gas bubbles",
                    "rapidly progressive swelling,",
                    "bronze/purple skin,",
                    "bullae, crepitus,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "foul discharge, systemic toxicity."
                },
                {
                  "type": "paragraph",
                  "text": "Common sites:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Thigh,",
                    "limbs,",
                    "deep muscle groups,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "postoperative wounds."
                },
                {
                  "type": "paragraph",
                  "text": "Treatment:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Immediate surgical exploration and radical debridement;",
                    "IV antibiotics (including clindamycin plus broad-spectrum cover according to protocol);",
                    "resuscitation;",
                    "repeat surgery as needed.",
                    "Hyperbaric oxygen is an adjunct only if it does not delay surgery."
                  ]
                }
              ]
            },
            {
              "group_id": "quick_revision_part_4_group_9",
              "group_title": "D. Fournier's Gangrene",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Cause:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Polymicrobial necrotising infection of the perineum and genital region;",
                    "risk increased by diabetes,",
                    "immunosuppression and"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "obesity."
                },
                {
                  "type": "paragraph",
                  "text": "Features:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Severe perineal pain,",
                    "oedema,",
                    "erythema,",
                    "skin necrosis,",
                    "crepitus,",
                    "foul discharge,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "systemic toxicity."
                },
                {
                  "type": "paragraph",
                  "text": "Common sites:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Scrotum,",
                    "penis,",
                    "perineum,",
                    "vulva,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "perianal region."
                },
                {
                  "type": "paragraph",
                  "text": "Treatment:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Immediate broad-spectrum IV antibiotics,",
                    "urgent extensive surgical debridement,",
                    "resuscitation,",
                    "repeat debridement and",
                    "critical care as needed."
                  ]
                }
              ]
            },
            {
              "group_id": "quick_revision_part_4_group_10",
              "group_title": "E. Internal Gangrene (decreased blood supply to internal organs)",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Cause:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Ischaemia,",
                    "vascular occlusion,",
                    "volvulus,",
                    "intussusception",
                    "strangulated hernia,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "severe infection."
                },
                {
                  "type": "paragraph",
                  "text": "Features:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Severe abdominal pain,",
                    "tenderness,",
                    "abdominal distension,",
                    "vomiting,",
                    "gastrointestinal bleeding,",
                    "fever,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "shock."
                },
                {
                  "type": "paragraph",
                  "text": "Common sites:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Bowel,",
                    "gallbladder,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "appendix."
                },
                {
                  "type": "checklist",
                  "items": [
                    "intestine"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Treatment:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Emergency surgical assessment,",
                    "resuscitation,",
                    "IV antibiotics when indicated,",
                    "urgent surgery or other definitive source control."
                  ]
                }
              ]
            },
            {
              "group_id": "quick_revision_part_4_group_11",
              "group_title": "F. Diabetic Gangrene",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Cause:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Peripheral arterial disease,",
                    "neuropathy,",
                    "infection and"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "impaired wound healing."
                },
                {
                  "type": "paragraph",
                  "text": "Features:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Ulceration,",
                    "tissue necrosis,",
                    "reduced sensation,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "possible purulence or systemic infection."
                },
                {
                  "type": "paragraph",
                  "text": "Common sites:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Toes,",
                    "forefoot,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "heel."
                },
                {
                  "type": "paragraph",
                  "text": "Treatment:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Glycaemic control,",
                    "infection management,",
                    "off-loading,",
                    "vascular assessment and revascularisation when feasible,",
                    "debridement or amputation when indicated."
                  ]
                }
              ]
            }
          ]
        },
