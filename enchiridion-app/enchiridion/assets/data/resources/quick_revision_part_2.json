      "subsections": [
        {
          "subsection_id": "quick_revision_part_2_subsection_1",
          "subsection_title": "HbA1c Is Unreliable in These Conditions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_2_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Haemolytic anaemia",
                    "Acute blood loss",
                    "Recent blood transfusion",
                    "Iron-deficiency anaemia (may falsely elevate HbA1c)",
                    "Vitamin B12 or folate deficiency",
                    "Haemoglobin variants: sickle cell disease, HbC, HbE, depending on assay",
                    "Pregnancy, especially later pregnancy",
                    "Chronic kidney disease, especially advanced disease or dialysis",
                    "Erythropoietin therapy",
                    "Shortened red-cell lifespan",
                    "Recent initiation or major change in diabetes treatment",
                    "G6PD deficiency",
                    "Conditions causing rapid red-cell turnover",
                    "Some chronic liver diseases"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Alternatives: plasma glucose, fasting plasma glucose, oral glucose tolerance test; fructosamine or glycated albumin in selected situations."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_2_subsection_2",
          "subsection_title": "Whipple’s Triad: Signs, Symptoms and Treatment",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_2_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Whipple’s triad",
                    "Symptoms consistent with hypoglycaemia",
                    "Documented low plasma glucose during symptoms (<3.9mmol/l or 70mg/dl)",
                    "Relief of symptoms after glucose correction",
                    "Symptoms",
                    "Sweating",
                    "Tremor",
                    "Palpitations",
                    "Hunger",
                    "Anxiety",
                    "Dizziness",
                    "Headache",
                    "Confusion",
                    "Visual disturbance",
                    "Seizures",
                    "Loss of consciousness",
                    "Signs",
                    "Diaphoresis",
                    "Tachycardia",
                    "Pallor",
                    "Tremor",
                    "Altered mental status",
                    "Focal neurological deficits",
                    "Seizures or coma in severe cases",
                    "Treatment"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Conscious and able to swallow: 15–20 g rapid-acting oral glucose; recheck glucose after 15 minutes and repeat if still low"
                },
                {
                  "type": "paragraph",
                  "text": "Unconscious or unable to swallow: IV dextrose according to local protocol"
                },
                {
                  "type": "checklist",
                  "items": [
                    "No IV access: glucagon IM/SC or intranasal where available",
                    "Recheck glucose and provide longer-acting carbohydrate once safe",
                    "Identify and treat underlying cause",
                    "Suspected sulfonylurea-induced hypoglycaemia: urgent medical assessment; octreotide may be indicated"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Recurrent or unexplained episodes: investigate medications, insulinoma, adrenal insufficiency, liver disease and critical illness"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_2_subsection_3",
          "subsection_title": "Hyperglycaemia and Hypoglycaemia: Causes, Classification and Treatment",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_2_group_3",
              "group_title": "A. Hyperglycaemia",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Classification",
                    "Normal fasting plasma glucose: < 100 mg/dL (< 5.6 mmol/L)",
                    "Prediabetes: 100–125 mg/dL (5.6–6.9 mmol/L)"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Diabetes: fasting glucose ≥ 126 mg/dL (≥ 7.0 mmol/L), usually confirmed on another day if asymptomatic"
                },
                {
                  "type": "paragraph",
                  "text": "Random plasma glucose ≥ 200 mg/dL (≥ 11.1 mmol/L) with classic symptoms or hyperglycaemic crisis supports diagnosis of diabetes"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Hyperglycaemic crisis: diabetic ketoacidosis (DKA) or hyperosmolar hyperglycaemic state (HHS)",
                    "Causes",
                    "Diabetes mellitus type 1 or type 2",
                    "Infection or sepsis",
                    "Myocardial infarction",
                    "Stroke",
                    "Surgery, trauma or physiological stress",
                    "Corticosteroids",
                    "Thiazides, atypical antipsychotics and selected other medications",
                    "Excess carbohydrate intake",
                    "Missed insulin or inadequate medication",
                    "Pancreatic disease",
                    "Endocrine disorders: Cushing syndrome, acromegaly, thyrotoxicosis",
                    "Clinical features",
                    "Polyuria",
                    "Polydipsia",
                    "Polyphagia",
                    "Weight loss",
                    "Blurred vision",
                    "Dehydration",
                    "Weakness",
                    "DKA: abdominal pain, vomiting, Kussmaul breathing, fruity breath",
                    "HHS: profound dehydration, confusion, seizures or coma",
                    "Treatment",
                    "Assess",
                    "ABCs,",
                    "hydration,",
                    "vital signs,",
                    "glucose,",
                    "electrolytes,",
                    "ketones",
                    "renal function"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Uncomplicated hyperglycaemia:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "fluids where appropriate,",
                    "medication review,",
                    "insulin adjustment and",
                    "treatment of precipitating cause"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "DKA:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "IV fluids,",
                    "insulin,",
                    "potassium-guided electrolyte replacement and",
                    "treatment of trigger"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "HHS:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "controlled fluid replacement,",
                    "electrolyte management,",
                    "insulin when appropriate and",
                    "treatment of trigger"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Check potassium before insulin in DKA/HHS; if potassium is severely low, replace potassium before starting insulin"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Monitor glucose, potassium, sodium, ketones, renal function and osmolality",
                    "Avoid rapid osmotic shifts during treatment"
                  ]
                }
              ]
            },
            {
              "group_id": "quick_revision_part_2_group_4",
              "group_title": "B. Hypoglycaemia",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Classification — commonly used in diabetes care"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Level 1: glucose < 70 mg/dL (3.9 mmol/L) but ≥ 54 mg/dL (3.0 mmol/L)"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Level 2: glucose < 54 mg/dL (< 3.0 mmol/L)"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Level 3: severe event requiring assistance from another person, irrespective of measured glucose"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Causes",
                    "Insulin overdose",
                    "Sulfonylureas",
                    "Missed or delayed meals",
                    "Excessive exercise",
                    "Alcohol use",
                    "Renal failure",
                    "Liver failure",
                    "Sepsis or critical illness",
                    "Adrenal insufficiency",
                    "Insulinoma",
                    "Hypopituitarism",
                    "Neonatal hypoglycaemia",
                    "Post-bariatric surgery hypoglycaemia",
                    "Clinical features",
                    "Sweating",
                    "Tremor",
                    "Palpitations",
                    "Hunger",
                    "Anxiety",
                    "Headache",
                    "Dizziness",
                    "Confusion",
                    "Behavioural changes",
                    "Seizures",
                    "Coma",
                    "Treatment"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Conscious and able to swallow: give 15–20 g rapid-acting oral glucose"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Mild – moderate hypogycaemia (15-15 rule)",
                    "15g of ccarbohydrate/ 1 tablespoon of sugar or honey",
                    "check blood glucose after 15 minutes",
                    "Severe hypoglycaemia",
                    "25-50 mls of 50% Dextrose water",
                    "Recheck glucose after 15 minutes; repeat if still low",
                    "Once corrected, provide a meal or longer-acting carbohydrate if appropriate"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Unconscious, seizing or unable to swallow: do not give oral food or fluid"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Give IV dextrose according to emergency protocol"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "If IV access is unavailable: glucagon IM/SC or intranasal where available"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Recheck glucose and monitor for recurrence",
                    "Sulfonylurea-associated hypoglycaemia: urgent assessment; octreotide may be required",
                    "Identify and treat the underlying cause"
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_2_subsection_4",
          "subsection_title": "Classification of Obesity",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_2_group_5",
              "group_title": "A. By Body Mass Index (BMI) — Adults",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Classification",
                    "BMI (kg/m²)"
                  ],
                  "rows": [
                    [
                      "Underweight",
                      "Less than 18.5"
                    ],
                    [
                      "Normal weight",
                      "18.5–24.9"
                    ],
                    [
                      "Overweight",
                      "25.0–29.9"
                    ],
                    [
                      "Obesity class I",
                      "30.0–34.9"
                    ],
                    [
                      "Obesity class II",
                      "35.0–39.9"
                    ],
                    [
                      "Obesity class III",
                      "40 or above"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "For many Asian populations, lower BMI thresholds are used for increased metabolic risk."
                }
              ]
            },
            {
              "group_id": "quick_revision_part_2_group_6",
              "group_title": "B. By Fat Distribution",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Central/android obesity: Abdominal/visceral fat; associated with insulin resistance and cardiovascular risk."
                },
                {
                  "type": "paragraph",
                  "text": "Peripheral/gynoid obesity: Gluteofemoral fat distribution."
                },
                {
                  "type": "paragraph",
                  "text": "Generalised obesity: Excess adiposity throughout the body."
                }
              ]
            },
            {
              "group_id": "quick_revision_part_2_group_7",
              "group_title": "C. By Aetiology",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Primary/common obesity: Multifactorial, including genetic, behavioural and environmental factors."
                },
                {
                  "type": "paragraph",
                  "text": "Secondary obesity:"
                },
                {
                  "type": "paragraph",
                  "text": "Endocrine: Cushing syndrome, hypothyroidism (usually modest contribution), hypothalamic disorders."
                },
                {
                  "type": "paragraph",
                  "text": "Genetic/syndromic: Prader–Willi syndrome and other genetic conditions."
                },
                {
                  "type": "paragraph",
                  "text": "Hypothalamic lesions."
                },
                {
                  "type": "paragraph",
                  "text": "Drug-induced: Glucocorticoids, some antipsychotics, some antidepressants, valproate, insulin and sulfonylureas."
                }
              ]
            },
            {
              "group_id": "quick_revision_part_2_group_8",
              "group_title": "D. By Age of Onset",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Childhood-onset obesity."
                },
                {
                  "type": "paragraph",
                  "text": "Adolescent-onset obesity."
                },
                {
                  "type": "paragraph",
                  "text": "Adult-onset obesity."
                }
              ]
            },
            {
              "group_id": "quick_revision_part_2_group_9",
              "group_title": "E. By Complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Uncomplicated obesity."
                },
                {
                  "type": "paragraph",
                  "text": "Obesity with metabolic complications."
                },
                {
                  "type": "paragraph",
                  "text": "Severe/complicated obesity."
                }
              ]
            }
          ]
        },
