        {
          "subsection_id": "quick_revision_part_2_subsection_1",
          "subsection_title": "1. HbA1c Is Unreliable in These Conditions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_2_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Haemolytic anaemia",
                      "level": 0
                    },
                    {
                      "text": "Acute blood loss",
                      "level": 0
                    },
                    {
                      "text": "Recent blood transfusion",
                      "level": 0
                    },
                    {
                      "text": "Iron-deficiency anaemia (may falsely elevate HbA1c)",
                      "level": 0
                    },
                    {
                      "text": "Vitamin B12 or folate deficiency",
                      "level": 0
                    },
                    {
                      "text": "Haemoglobin variants: sickle cell disease, HbC, HbE, depending on assay",
                      "level": 0
                    },
                    {
                      "text": "Pregnancy, especially later pregnancy",
                      "level": 0
                    },
                    {
                      "text": "Chronic kidney disease, especially advanced disease or dialysis",
                      "level": 0
                    },
                    {
                      "text": "Erythropoietin therapy",
                      "level": 0
                    },
                    {
                      "text": "Shortened red-cell lifespan",
                      "level": 0
                    },
                    {
                      "text": "Recent initiation or major change in diabetes treatment",
                      "level": 0
                    },
                    {
                      "text": "G6PD deficiency",
                      "level": 0
                    },
                    {
                      "text": "Conditions causing rapid red-cell turnover",
                      "level": 0
                    },
                    {
                      "text": "Some chronic liver diseases",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Alternatives: plasma glucose, fasting plasma glucose, oral glucose tolerance test; fructosamine or glycated albumin in selected situations."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_2_subsection_2",
          "subsection_title": "2. Whipple’s Triad: Signs, Symptoms and Treatment",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_2_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Whipple’s triad"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Symptoms consistent with hypoglycaemia",
                      "level": 0
                    },
                    {
                      "text": "Documented low plasma glucose during symptoms (<3.9mmol/l or 70mg/dl)",
                      "level": 0
                    },
                    {
                      "text": "Relief of symptoms after glucose correction",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Symptoms"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Sweating",
                      "level": 0
                    },
                    {
                      "text": "Tremor",
                      "level": 0
                    },
                    {
                      "text": "Palpitations",
                      "level": 0
                    },
                    {
                      "text": "Hunger",
                      "level": 0
                    },
                    {
                      "text": "Anxiety",
                      "level": 0
                    },
                    {
                      "text": "Dizziness",
                      "level": 0
                    },
                    {
                      "text": "Headache",
                      "level": 0
                    },
                    {
                      "text": "Confusion",
                      "level": 0
                    },
                    {
                      "text": "Visual disturbance",
                      "level": 0
                    },
                    {
                      "text": "Seizures",
                      "level": 0
                    },
                    {
                      "text": "Loss of consciousness",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Signs"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Diaphoresis",
                      "level": 0
                    },
                    {
                      "text": "Tachycardia",
                      "level": 0
                    },
                    {
                      "text": "Pallor",
                      "level": 0
                    },
                    {
                      "text": "Tremor",
                      "level": 0
                    },
                    {
                      "text": "Altered mental status",
                      "level": 0
                    },
                    {
                      "text": "Focal neurological deficits",
                      "level": 0
                    },
                    {
                      "text": "Seizures or coma in severe cases",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Treatment"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Conscious and able to swallow: 15–20 g rapid-acting oral glucose; recheck glucose after 15 minutes and repeat if still low",
                      "level": 0
                    },
                    {
                      "text": "Unconscious or unable to swallow: IV dextrose according to local protocol",
                      "level": 0
                    },
                    {
                      "text": "No IV access: glucagon IM/SC or intranasal where available",
                      "level": 0
                    },
                    {
                      "text": "Recheck glucose and provide longer-acting carbohydrate once safe",
                      "level": 0
                    },
                    {
                      "text": "Identify and treat underlying cause",
                      "level": 0
                    },
                    {
                      "text": "Suspected sulfonylurea-induced hypoglycaemia: urgent medical assessment; octreotide may be indicated",
                      "level": 0
                    },
                    {
                      "text": "Recurrent or unexplained episodes: investigate medications, insulinoma, adrenal insufficiency, liver disease and critical illness",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_2_subsection_3",
          "subsection_title": "3. Hyperglycaemia and Hypoglycaemia: Causes, Classification and Treatment",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_2_group_3",
              "group_title": "A. Hyperglycaemia",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Classification"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Normal fasting plasma glucose: < 100 mg/dL (< 5.6 mmol/L)",
                      "level": 0
                    },
                    {
                      "text": "Prediabetes: 100–125 mg/dL (5.6–6.9 mmol/L)",
                      "level": 0
                    },
                    {
                      "text": "Diabetes: fasting glucose ≥ 126 mg/dL (≥ 7.0 mmol/L), usually confirmed on another day if asymptomatic",
                      "level": 0
                    },
                    {
                      "text": "Random plasma glucose ≥ 200 mg/dL (≥ 11.1 mmol/L) with classic symptoms or hyperglycaemic crisis supports diagnosis of diabetes",
                      "level": 0
                    },
                    {
                      "text": "Hyperglycaemic crisis: diabetic ketoacidosis (DKA) or hyperosmolar hyperglycaemic state (HHS)",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Causes"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Diabetes mellitus type 1 or type 2",
                      "level": 0
                    },
                    {
                      "text": "Infection or sepsis",
                      "level": 0
                    },
                    {
                      "text": "Myocardial infarction",
                      "level": 0
                    },
                    {
                      "text": "Stroke",
                      "level": 0
                    },
                    {
                      "text": "Surgery, trauma or physiological stress",
                      "level": 0
                    },
                    {
                      "text": "Corticosteroids",
                      "level": 0
                    },
                    {
                      "text": "Thiazides, atypical antipsychotics and selected other medications",
                      "level": 0
                    },
                    {
                      "text": "Excess carbohydrate intake",
                      "level": 0
                    },
                    {
                      "text": "Missed insulin or inadequate medication",
                      "level": 0
                    },
                    {
                      "text": "Pancreatic disease",
                      "level": 0
                    },
                    {
                      "text": "Endocrine disorders: Cushing syndrome, acromegaly, thyrotoxicosis",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Clinical features"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Polyuria",
                      "level": 0
                    },
                    {
                      "text": "Polydipsia",
                      "level": 0
                    },
                    {
                      "text": "Polyphagia",
                      "level": 0
                    },
                    {
                      "text": "Weight loss",
                      "level": 0
                    },
                    {
                      "text": "Blurred vision",
                      "level": 0
                    },
                    {
                      "text": "Dehydration",
                      "level": 0
                    },
                    {
                      "text": "Weakness",
                      "level": 0
                    },
                    {
                      "text": "DKA: abdominal pain, vomiting, Kussmaul breathing, fruity breath",
                      "level": 0
                    },
                    {
                      "text": "HHS: profound dehydration, confusion, seizures or coma",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Treatment"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Assess",
                      "level": 0
                    },
                    {
                      "text": "ABCs,",
                      "level": 1
                    },
                    {
                      "text": "hydration,",
                      "level": 1
                    },
                    {
                      "text": "vital signs,",
                      "level": 1
                    },
                    {
                      "text": "glucose,",
                      "level": 1
                    },
                    {
                      "text": "electrolytes,",
                      "level": 1
                    },
                    {
                      "text": "ketones",
                      "level": 1
                    },
                    {
                      "text": "renal function",
                      "level": 1
                    },
                    {
                      "text": "Uncomplicated hyperglycaemia:",
                      "level": 0
                    },
                    {
                      "text": "fluids where appropriate,",
                      "level": 1
                    },
                    {
                      "text": "medication review,",
                      "level": 1
                    },
                    {
                      "text": "insulin adjustment and",
                      "level": 1
                    },
                    {
                      "text": "treatment of precipitating cause",
                      "level": 1
                    },
                    {
                      "text": "DKA:",
                      "level": 0
                    },
                    {
                      "text": "IV fluids,",
                      "level": 1
                    },
                    {
                      "text": "insulin,",
                      "level": 1
                    },
                    {
                      "text": "potassium-guided electrolyte replacement and",
                      "level": 1
                    },
                    {
                      "text": "treatment of trigger",
                      "level": 1
                    },
                    {
                      "text": "HHS:",
                      "level": 0
                    },
                    {
                      "text": "controlled fluid replacement,",
                      "level": 1
                    },
                    {
                      "text": "electrolyte management,",
                      "level": 1
                    },
                    {
                      "text": "insulin when appropriate and",
                      "level": 1
                    },
                    {
                      "text": "treatment of trigger",
                      "level": 1
                    },
                    {
                      "text": "Check potassium before insulin in DKA/HHS; if potassium is severely low, replace potassium before starting insulin",
                      "level": 0
                    },
                    {
                      "text": "Monitor glucose, potassium, sodium, ketones, renal function and osmolality",
                      "level": 0
                    },
                    {
                      "text": "Avoid rapid osmotic shifts during treatment",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "quick_revision_part_2_group_4",
              "group_title": "B. Hypoglycaemia",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Classification — commonly used in diabetes care"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Level 1: glucose < 70 mg/dL (3.9 mmol/L) but ≥ 54 mg/dL (3.0 mmol/L)",
                      "level": 0
                    },
                    {
                      "text": "Level 2: glucose < 54 mg/dL (< 3.0 mmol/L)",
                      "level": 0
                    },
                    {
                      "text": "Level 3: severe event requiring assistance from another person, irrespective of measured glucose",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Causes"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Insulin overdose",
                      "level": 0
                    },
                    {
                      "text": "Sulfonylureas",
                      "level": 0
                    },
                    {
                      "text": "Missed or delayed meals",
                      "level": 0
                    },
                    {
                      "text": "Excessive exercise",
                      "level": 0
                    },
                    {
                      "text": "Alcohol use",
                      "level": 0
                    },
                    {
                      "text": "Renal failure",
                      "level": 0
                    },
                    {
                      "text": "Liver failure",
                      "level": 0
                    },
                    {
                      "text": "Sepsis or critical illness",
                      "level": 0
                    },
                    {
                      "text": "Adrenal insufficiency",
                      "level": 0
                    },
                    {
                      "text": "Insulinoma",
                      "level": 0
                    },
                    {
                      "text": "Hypopituitarism",
                      "level": 0
                    },
                    {
                      "text": "Neonatal hypoglycaemia",
                      "level": 0
                    },
                    {
                      "text": "Post-bariatric surgery hypoglycaemia",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Clinical features"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Sweating",
                      "level": 0
                    },
                    {
                      "text": "Tremor",
                      "level": 0
                    },
                    {
                      "text": "Palpitations",
                      "level": 0
                    },
                    {
                      "text": "Hunger",
                      "level": 0
                    },
                    {
                      "text": "Anxiety",
                      "level": 0
                    },
                    {
                      "text": "Headache",
                      "level": 0
                    },
                    {
                      "text": "Dizziness",
                      "level": 0
                    },
                    {
                      "text": "Confusion",
                      "level": 0
                    },
                    {
                      "text": "Behavioural changes",
                      "level": 0
                    },
                    {
                      "text": "Seizures",
                      "level": 0
                    },
                    {
                      "text": "Coma",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Treatment"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Conscious and able to swallow: give 15–20 g rapid-acting oral glucose",
                      "level": 0
                    },
                    {
                      "text": "Mild – moderate hypogycaemia (15-15 rule)",
                      "level": 0
                    },
                    {
                      "text": "15g of ccarbohydrate/ 1 tablespoon of sugar or honey",
                      "level": 1
                    },
                    {
                      "text": "check blood glucose after 15 minutes",
                      "level": 1
                    },
                    {
                      "text": "Severe hypoglycaemia",
                      "level": 0
                    },
                    {
                      "text": "25-50 mls of 50% Dextrose water",
                      "level": 1
                    },
                    {
                      "text": "Recheck glucose after 15 minutes; repeat if still low",
                      "level": 0
                    },
                    {
                      "text": "Once corrected, provide a meal or longer-acting carbohydrate if appropriate",
                      "level": 0
                    },
                    {
                      "text": "Unconscious, seizing or unable to swallow: do not give oral food or fluid",
                      "level": 0
                    },
                    {
                      "text": "Give IV dextrose according to emergency protocol",
                      "level": 0
                    },
                    {
                      "text": "If IV access is unavailable: glucagon IM/SC or intranasal where available",
                      "level": 0
                    },
                    {
                      "text": "Recheck glucose and monitor for recurrence",
                      "level": 0
                    },
                    {
                      "text": "Sulfonylurea-associated hypoglycaemia: urgent assessment; octreotide may be required",
                      "level": 0
                    },
                    {
                      "text": "Identify and treat the underlying cause",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_2_subsection_4",
          "subsection_title": "4. Classification of Obesity",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_2_group_5",
              "group_title": "A. By Body Mass Index (BMI) — Adults",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Classification",
                    "BMI (kg/m²)"
                  ],
                  "rows": [
                    [
                      "Underweight",
                      "Less than 18.5"
                    ],
                    [
                      "Normal weight",
                      "18.5–24.9"
                    ],
                    [
                      "Overweight",
                      "25.0–29.9"
                    ],
                    [
                      "Obesity class I",
                      "30.0–34.9"
                    ],
                    [
                      "Obesity class II",
                      "35.0–39.9"
                    ],
                    [
                      "Obesity class III",
                      "40 or above"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "For many Asian populations, lower BMI thresholds are used for increased metabolic risk."
                }
              ]
            },
            {
              "group_id": "quick_revision_part_2_group_6",
              "group_title": "B. By Fat Distribution",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Central/android obesity: Abdominal/visceral fat; associated with insulin resistance and cardiovascular risk.",
                      "level": 0
                    },
                    {
                      "text": "Peripheral/gynoid obesity: Gluteofemoral fat distribution.",
                      "level": 0
                    },
                    {
                      "text": "Generalised obesity: Excess adiposity throughout the body.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "quick_revision_part_2_group_7",
              "group_title": "C. By Aetiology",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Primary/common obesity: Multifactorial, including genetic, behavioural and environmental factors.",
                      "level": 0
                    },
                    {
                      "text": "Secondary obesity:",
                      "level": 0
                    },
                    {
                      "text": "Endocrine: Cushing syndrome, hypothyroidism (usually modest contribution), hypothalamic disorders.",
                      "level": 1
                    },
                    {
                      "text": "Genetic/syndromic: Prader–Willi syndrome and other genetic conditions.",
                      "level": 1
                    },
                    {
                      "text": "Hypothalamic lesions.",
                      "level": 1
                    },
                    {
                      "text": "Drug-induced: Glucocorticoids, some antipsychotics, some antidepressants, valproate, insulin and sulfonylureas.",
                      "level": 1
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "quick_revision_part_2_group_8",
              "group_title": "D. By Age of Onset",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
