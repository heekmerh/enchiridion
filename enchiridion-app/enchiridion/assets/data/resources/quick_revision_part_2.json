                  "items": [
                    {
                      "text": "Childhood-onset obesity.",
                      "level": 0
                    },
                    {
                      "text": "Adolescent-onset obesity.",
                      "level": 0
                    },
                    {
                      "text": "Adult-onset obesity.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "quick_revision_part_2_group_9",
              "group_title": "E. By Complications",
              "group_subtitle": null,
