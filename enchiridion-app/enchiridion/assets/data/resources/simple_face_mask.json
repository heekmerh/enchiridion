  "sections": [
    {
      "section_id": "simple_face_mask_section_1",
      "section_title": "Simple face mask",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "simple_face_mask_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "simple_face_mask_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The goal of this station is to identify the simple face mask, explain how it delivers oxygen, demonstrate correct application, state the appropriate flow rate, recognize its limitations, and identify complications in adults and children."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "simple_face_mask_subsection_2",
          "subsection_title": "1. Identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "simple_face_mask_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/simple_face_mask_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Name: Simple face mask (Hudson mask)."
                },
                {
                  "type": "paragraph",
                  "text": "Classification: Low-flow oxygen delivery device."
                },
                {
                  "type": "paragraph",
                  "text": "Principle: Oxygen flows through tubing into a mask covering the nose and mouth. It mixes with room air inside and around the mask during inspiration, producing a variable inspired oxygen concentration (FiO₂)."
                },
                {
                  "type": "paragraph",
                  "text": "Typical adult oxygen flow: 5–10 L/min."
                },
                {
                  "type": "paragraph",
                  "text": "Critical safety rule: A simple face mask should generally not be operated below 5 L/min because insufficient flow can allow carbon dioxide (CO₂) to accumulate inside the mask."
                },
                {
                  "type": "paragraph",
                  "text": "Examiner's expected answer:"
                },
                {
                  "type": "paragraph",
                  "text": "\"This is a simple face mask used to deliver supplemental oxygen to spontaneously breathing patients who require more oxygen than may be provided by a conventional nasal cannula. It covers the nose and mouth and delivers a variable oxygen concentration.\"",
                  "style": "quote"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "simple_face_mask_subsection_3",
          "subsection_title": "2. Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "simple_face_mask_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Clinical situation",
                    "Purpose"
                  ],
                  "rows": [
                    [
                      "Moderate hypoxaemia",
                      "Provides supplemental oxygen when a nasal cannula is insufficient or unsuitable."
                    ],
                    [
                      "Pneumonia",
                      "Supports oxygenation when clinically indicated."
                    ],
                    [
                      "Postoperative recovery",
                      "Corrects hypoxaemia according to the prescribed target."
                    ],
                    [
                      "Acute medical illness",
                      "Provides temporary oxygen support while the patient is assessed and treated."
                    ],
                    [
                      "Emergency care",
                      "Offers a readily available means of oxygen delivery in spontaneously breathing patients."
                    ],
                    [
                      "Patients unable to tolerate nasal prongs",
                      "Provides an alternative oxygen interface if appropriate."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A simple mask is not suitable as the sole treatment for apnoea, severe ventilatory failure, or impending respiratory arrest. Such patients need urgent assessment and potentially bag-mask ventilation or advanced respiratory support."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "simple_face_mask_subsection_4",
          "subsection_title": "3. Parts and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "simple_face_mask_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/simple_face_mask_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A. Mask body"
                },
                {
                  "type": "paragraph",
                  "text": "Covers the nose and mouth, creating a space in which oxygen mixes with room air."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/simple_face_mask_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "B. Elastic strap and nose clip"
                },
                {
                  "type": "paragraph",
                  "text": "Secure the mask and help it fit comfortably around the face."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/simple_face_mask_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "C. Side openings"
                },
                {
                  "type": "paragraph",
                  "text": "Permit entrainment of room air and allow exhaled gas to escape."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/simple_face_mask_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "D. Oxygen inlet connector"
                },
                {
                  "type": "paragraph",
                  "text": "Connects the mask to the oxygen tubing."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/simple_face_mask_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "E. Oxygen tubing and flowmeter"
                },
                {
                  "type": "paragraph",
                  "text": "Deliver oxygen from the source and control the prescribed flow rate."
                },
                {
                  "type": "paragraph",
                  "text": "Exam distinction: Unlike a non-rebreather mask, a standard simple face mask does not have a reservoir bag or a one-way valve system designed to reduce rebreathing."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "simple_face_mask_subsection_5",
          "subsection_title": "4. Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "simple_face_mask_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Simple and quick to apply.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Covers both the nose and mouth.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Can provide a higher oxygen concentration than a conventional nasal cannula in some circumstances.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Widely available and relatively inexpensive.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Useful for short-term oxygen therapy in acute care.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Does not require an airtight seal.",
                      "level": 0,
                      "label": "6."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "simple_face_mask_subsection_6",
          "subsection_title": "5. Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "simple_face_mask_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "FiO₂ is variable and depends on respiratory rate, tidal volume, mask fit, and oxygen flow.",
                      "level": 0
                    },
                    {
                      "text": "The mask must not generally be used below 5 L/min because of the risk of CO₂ rebreathing.",
                      "level": 0
                    },
                    {
                      "text": "It may interfere with eating, drinking, and speaking.",
                      "level": 0
                    },
                    {
                      "text": "Some patients find it claustrophobic or uncomfortable.",
                      "level": 0
                    },
                    {
                      "text": "Vomiting or reduced consciousness increases concerns about airway protection and aspiration.",
                      "level": 0
                    },
                    {
                      "text": "It may be displaced by coughing, movement, or agitation.",
                      "level": 0
                    },
                    {
                      "text": "It does not provide reliable positive airway pressure or ventilatory assistance.",
                      "level": 0
                    },
                    {
                      "text": "It is not the preferred device when a precisely controlled FiO₂ is required.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Exam tip: If the examiner asks for a device that delivers a more controlled oxygen concentration, consider the Venturi mask rather than the simple face mask."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "simple_face_mask_subsection_7",
          "subsection_title": "6. Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "simple_face_mask_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Before application:",
                  "items": [
                    {
                      "text": "Perform hand hygiene and explain the procedure.",
                      "level": 0
                    },
                    {
                      "text": "Assess respiratory rate, work of breathing, mental state, and oxygen saturation.",
                      "level": 0
                    },
                    {
                      "text": "Establish the appropriate target saturation and prescribed oxygen flow.",
                      "level": 0
                    },
                    {
                      "text": "Inspect the mask, tubing, connector, and oxygen source.",
                      "level": 0
                    },
                    {
                      "text": "Connect the mask securely to the oxygen tubing.",
                      "level": 0
                    },
                    {
                      "text": "Set the flowmeter to at least 5 L/min, or the prescribed flow within the device's recommended range.",
                      "level": 0
                    },
                    {
                      "text": "Check that oxygen is flowing.",
                      "level": 0
                    },
                    {
                      "text": "Ensure the mask is correctly sized and positioned.",
                      "level": 0
                    },
                    {
                      "text": "Monitor the patient's response and inspect the skin around the nose and ears.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Oxygen is not flammable itself, but it supports combustion. Keep the device away from smoking, open flames, and ignition sources."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "simple_face_mask_subsection_8",
          "subsection_title": "7. How to use it — step-by-step OSCE demonstration",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "simple_face_mask_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Step 1: Assess the patient"
                },
                {
                  "type": "paragraph",
                  "text": "Introduce yourself, confirm the patient's identity, explain the procedure, and assess oxygenation and respiratory distress."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/simple_face_mask_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 2: Prepare the device"
                },
                {
                  "type": "paragraph",
                  "text": "Check the mask, tubing, flowmeter, and oxygen source. Connect the mask tubing securely."
                },
                {
                  "type": "paragraph",
                  "text": "Step 3: Set the flow rate"
                },
                {
                  "type": "paragraph",
                  "text": "Set the flow to at least 5 L/min, typically 5–10 L/min in adults, according to the clinical indication and prescribed target."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/simple_face_mask_08.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 4: Apply the mask"
                },
                {
                  "type": "paragraph",
                  "text": "Position it over the nose and mouth. Place the strap behind the head and adjust the nose clip gently to improve fit."
                },
                {
                  "type": "paragraph",
                  "text": "Step 5: Reassess"
                },
                {
                  "type": "paragraph",
                  "text": "Check comfort, mask position, oxygen saturation, respiratory effort, and mental status."
                },
                {
                  "type": "paragraph",
                  "text": "Step 6: Monitor and document"
                },
                {
                  "type": "paragraph",
                  "text": "Record the oxygen delivery device, flow rate, oxygen saturation, target, and clinical response. Escalate if the patient fails to improve."
                }
              ]
            },
            {
              "group_id": "simple_face_mask_group_9",
              "group_title": "What to say during the OSCE",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "\"I would assess the patient's oxygenation, select the prescribed flow, check the equipment, position the mask over the nose and mouth, secure it comfortably, and monitor the patient's response. I would ensure that the flow is not below 5 L/min and escalate if hypoxaemia persists.\"",
                  "style": "quote"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "simple_face_mask_subsection_9",
          "subsection_title": "8. Contraindications and complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "simple_face_mask_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "There is no general absolute contraindication to oxygen therapy when indicated, but a simple face mask may be unsuitable in certain situations."
                }
              ]
            },
            {
              "group_id": "simple_face_mask_group_11",
              "group_title": "Situations requiring caution or an alternative",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Apnoea or inadequate ventilation.",
                      "level": 0
                    },
                    {
                      "text": "Severe respiratory distress requiring immediate ventilatory support.",
                      "level": 0
                    },
                    {
                      "text": "Vomiting or a substantially impaired ability to protect the airway.",
                      "level": 0
                    },
                    {
                      "text": "Facial injury that prevents appropriate mask placement.",
                      "level": 0
                    },
                    {
                      "text": "A need for precisely controlled oxygen concentration.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "simple_face_mask_group_12",
              "group_title": "Complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Prevention or response"
                  ],
                  "rows": [
                    [
                      "CO₂ rebreathing",
                      "Maintain an appropriate flow, generally at least 5 L/min."
                    ],
                    [
                      "Persistent hypoxaemia",
                      "Reassess the patient and equipment; escalate oxygen delivery and respiratory support."
                    ],
                    [
                      "Skin pressure injury",
                      "Check the bridge of the nose, cheeks, and areas under the strap."
                    ],
                    [
                      "Anxiety or claustrophobia",
                      "Explain the procedure and consider a suitable alternative if clinically safe."
                    ],
                    [
                      "Aspiration risk",
                      "Assess airway protection and consider a safer airway strategy when indicated."
                    ],
                    [
                      "Oxygen-associated hypercapnia",
                      "Use an appropriate target saturation and assess blood gases when indicated."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important: Never allow concern about oxygen-associated hypercapnia to delay emergency oxygen in a critically hypoxaemic patient. Administer oxygen appropriately and titrate it to the required target while assessing the cause."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "simple_face_mask_subsection_10",
          "subsection_title": "9. Normal and abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "simple_face_mask_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The mask is a delivery device, so the main assessment is the patient's response."
                },
                {
                  "type": "table",
                  "columns": [
                    "Finding",
                    "Interpretation"
                  ],
                  "rows": [
                    [
                      "SpO₂ reaches the prescribed target",
                      "Oxygenation is responding appropriately."
                    ],
                    [
                      "SpO₂ remains below target",
                      "Check flow, connections, mask fit, and the patient's condition; escalate if necessary."
                    ],
                    [
                      "Reduced respiratory effort",
                      "May indicate clinical improvement."
                    ],
                    [
                      "Persistent tachypnoea or accessory muscle use",
                      "Ongoing respiratory distress."
                    ],
                    [
                      "New confusion or drowsiness",
                      "Possible deterioration, hypoxaemia, hypercapnia, or another cause."
                    ],
                    [
                      "Cyanosis, exhaustion, or declining consciousness",
                      "Emergency warning signs requiring immediate assessment and escalation."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Always interpret pulse oximetry alongside the clinical examination. A normal saturation does not rule out hypercapnia or inadequate ventilation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "simple_face_mask_subsection_11",
          "subsection_title": "10. Pediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "simple_face_mask_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Children have smaller airways, different oxygen requirements, and less respiratory reserve than adults. Device selection and flow must be age-appropriate."
                }
              ]
            },
            {
              "group_id": "simple_face_mask_group_15",
              "group_title": "Important precautions",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Use a properly sized pediatric mask that covers the nose and mouth without excessive pressure.",
                      "level": 0
                    },
                    {
                      "text": "Avoid unnecessarily tight straps.",
                      "level": 0
                    },
                    {
                      "text": "Monitor oxygen saturation, respiratory rate, work of breathing, and mental status.",
                      "level": 0
                    },
                    {
                      "text": "Use pediatric protocols to determine oxygen flow and target saturation.",
                      "level": 0
                    },
                    {
                      "text": "Do not assume adult flow settings are suitable for an infant or neonate.",
                      "level": 0
                    },
                    {
                      "text": "Escalate promptly if the child remains hypoxaemic or develops fatigue, apnoea, or altered consciousness.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "High-yield neonatal point: A simple face mask is generally not the preferred interface for neonatal resuscitation. If a newborn needs respiratory support, use appropriate neonatal resuscitation equipment and provide effective ventilation when indicated."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "simple_face_mask_subsection_12",
          "subsection_title": "11. Mnemonics and memory aids",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "simple_face_mask_group_16",
              "group_title": "MASK — safe application",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "**M**"
                },
                {
                  "type": "paragraph",
                  "text": "Measure"
                },
                {
                  "type": "paragraph",
                  "text": "Assess oxygen saturation and respiratory distress."
                }
              ]
            },
            {
              "group_id": "simple_face_mask_group_17",
              "group_title": "A",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Attach"
                },
                {
                  "type": "paragraph",
                  "text": "Connect the mask securely to the oxygen source."
                }
              ]
            },
            {
              "group_id": "simple_face_mask_group_18",
              "group_title": "S",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Set"
                },
                {
                  "type": "paragraph",
                  "text": "Set the appropriate flow, generally at least 5 L/min."
                }
              ]
            },
            {
              "group_id": "simple_face_mask_group_19",
              "group_title": "K",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Keep checking"
                },
                {
                  "type": "paragraph",
                  "text": "Monitor the patient, mask fit, and response."
                },
                {
                  "type": "paragraph",
                  "text": "**Oxygen devices: quick recall**",
                  "style": "heading"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Nasal cannula: Usually 1–6 L/min in adults.",
                      "level": 0
                    },
                    {
                      "text": "Simple face mask: Usually 5–10 L/min in adults.",
                      "level": 0
                    },
                    {
                      "text": "Venturi mask: More controlled FiO₂.",
                      "level": 0
                    },
                    {
                      "text": "Non-rebreather mask: Reservoir bag and one-way valves for high-concentration oxygen delivery when correctly assembled and operated.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These are conventional teaching ranges; the clinical situation, manufacturer instructions, and local protocols determine actual use."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "simple_face_mask_subsection_13",
          "subsection_title": "12. Common OSCE questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "simple_face_mask_group_20",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is the usual oxygen flow rate for a simple face mask?"
                },
                {
                  "type": "paragraph",
                  "text": "Usually 5–10 L/min in adults."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Why should it not generally be used below 5 L/min?"
                },
                {
                  "type": "paragraph",
                  "text": "Low flow may not adequately flush exhaled gas from the mask, increasing the risk of CO₂ rebreathing."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Does a simple face mask deliver a fixed FiO₂?"
                },
                {
                  "type": "paragraph",
                  "text": "No. FiO₂ is variable because oxygen mixes with room air and depends on the patient's breathing pattern, flow rate, and mask fit."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. What is the difference between a simple face mask and a non-rebreather mask?"
                },
                {
                  "type": "paragraph",
                  "text": "A non-rebreather mask has a reservoir bag and one-way valves designed to reduce room-air entrainment and rebreathing. It can deliver a higher oxygen concentration when properly fitted and supplied with adequate flow."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What is the difference between a simple face mask and a Venturi mask?"
                },
                {
                  "type": "paragraph",
                  "text": "A simple mask delivers a variable oxygen concentration, while a Venturi mask uses a controlled air-entrainment system to deliver a more predictable FiO₂."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What would you do if the patient's SpO₂ remains low?"
                },
                {
                  "type": "paragraph",
                  "text": "Reassess airway, breathing, circulation, and the pulse oximeter signal. Check the oxygen source, flow, tubing, and mask fit, then escalate oxygen delivery and respiratory support according to the patient's condition."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. Can a simple face mask be used for an apnoeic patient?"
                },
                {
                  "type": "paragraph",
                  "text": "Not as the sole means of respiratory support. An apnoeic patient requires immediate airway management and effective ventilation with appropriate equipment."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. What complications may occur during prolonged use?"
                },
                {
                  "type": "paragraph",
                  "text": "Skin irritation, pressure injury, discomfort, and—in susceptible patients—oxygen-associated hypercapnia."
                },
                {
                  "type": "paragraph",
                  "text": "Q9. Why might a simple face mask be unsuitable for a patient who is vomiting?"
                },
                {
                  "type": "paragraph",
                  "text": "The mask may complicate access to the mouth and increase practical concerns about aspiration if the patient cannot protect their airway."
                },
                {
                  "type": "paragraph",
                  "text": "Q10. What is the priority in a deteriorating patient despite oxygen?"
                },
                {
                  "type": "paragraph",
                  "text": "Immediate reassessment, escalation of care, and support of airway and ventilation as required. Do not delay emergency intervention while adjusting the mask repeatedly."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "simple_face_mask_subsection_14",
          "subsection_title": "13. Common mistakes and examiner tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "simple_face_mask_group_21",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Mistake: Setting the flow below 5 L/min"
                },
                {
                  "type": "paragraph",
                  "text": "Remember the minimum conventional flow for a simple face mask."
                },
                {
                  "type": "paragraph",
                  "text": "Mistake: Claiming the mask delivers a fixed FiO₂"
                },
                {
                  "type": "paragraph",
                  "text": "Explain that the inspired oxygen concentration varies."
                },
                {
                  "type": "paragraph",
                  "text": "Mistake: Ignoring deterioration"
                },
                {
                  "type": "paragraph",
                  "text": "Persistent hypoxaemia, exhaustion, or reduced consciousness requires urgent escalation."
                },
                {
                  "type": "paragraph",
                  "text": "Mistake: Applying an adult mask to a child"
                },
                {
                  "type": "paragraph",
                  "text": "Use an appropriate pediatric size and monitor the response."
                },
                {
                  "type": "paragraph",
                  "text": "What impresses the examiner"
                },
                {
                  "type": "paragraph",
                  "text": "Identify the device, state the 5–10 L/min adult range, explain CO₂ rebreathing risk at low flow, demonstrate correct application, and describe monitoring and escalation."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}