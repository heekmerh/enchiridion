        {
          "subsection_id": "needle_holder_subsection_13",
          "subsection_title": "12. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "needle_holder_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a Mayo-Hegar needle holder, a surgical suturing instrument used to hold and manipulate a surgical needle during wound closure and other suturing procedures. It typically has ring handles, a ratchet-locking mechanism, a box joint and short, sturdy jaws with gripping surfaces. It is used in general surgery, orthopaedic surgery, gynaecology and other surgical specialties. Its advantages include secure needle control and precision. Complications of improper use include needle slippage, needle breakage, needle-stick injury and tissue trauma. Before use, I would inspect the jaws, ratchet, joint, cleanliness and sterility.”",
                  "style": "quote"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "needle_holder_subsection_14",
          "subsection_title": "13. Last-minute revision checklist",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "needle_holder_group_16",
