        {
          "subsection_id": "needle_holder_subsection_2",
          "subsection_title": "1. Introduction and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "needle_holder_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A needle holder is a surgical instrument designed to grasp, control and manipulate a surgical needle during suturing. It allows the surgeon to drive the needle through tissue with precision while maintaining control of its angle and direction."
                },
                {
                  "type": "paragraph",
                  "text": "The Mayo-Hegar needle holder is a common general-purpose pattern encountered in surgical instrument OSCEs."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification card"
                },
                {
                  "type": "paragraph",
                  "text": "Name: Needle holder (commonly Mayo-Hegar)"
                },
                {
                  "type": "paragraph",
                  "text": "Classification: Suturing instrument"
                },
                {
                  "type": "paragraph",
                  "text": "Primary function: Holding and driving a surgical needle during suturing."
                },
                {
                  "type": "paragraph",
                  "text": "Characteristic feature: Short, sturdy jaws with gripping surfaces designed to secure a needle."
                },
                {
                  "type": "paragraph",
                  "text": "Mechanism: Usually ring handles, a box joint and a ratchet lock in the Mayo-Hegar pattern."
                },
                {
                  "type": "paragraph",
                  "text": "Exam tip: A needle holder resembles artery forceps at first glance, but its jaws are specifically designed to grip a surgical needle securely. Look for short, robust jaws and their gripping surfaces."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "needle_holder_subsection_3",
          "subsection_title": "2. Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "needle_holder_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/needle_holder_02.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/needle_holder_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "hospitalstore.com"
                },
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Description and function"
                  ],
                  "rows": [
                    [
                      "Ring handles",
                      "Provide a secure grip and allow controlled manipulation."
                    ],
                    [
                      "Ratchet lock",
                      "Maintains the jaws in the selected closed position."
                    ],
                    [
                      "Box joint",
                      "Connects the two halves and allows controlled movement."
                    ],
                    [
                      "Shanks",
                      "Transfer hand movement to the working jaws."
                    ],
                    [
                      "Jaws",
                      "Grip the needle during suturing."
                    ],
                    [
                      "Gripping surfaces",
                      "Often cross-hatched or patterned to resist needle slippage."
                    ],
                    [
                      "Jaw tips",
                      "Contact and stabilize the needle; their size and shape depend on the model."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Some needle holders have tungsten-carbide inserts for improved grip and wear resistance. These inserts may be identified by gold-coloured handles on many, but not all, instrument designs."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "needle_holder_subsection_4",
          "subsection_title": "3. Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "needle_holder_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/needle_holder_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A. Mayo-Hegar needle holder"
                },
                {
                  "type": "paragraph",
                  "text": "A common general-purpose needle holder with ring handles, a ratchet and short, sturdy jaws. Used in many open surgical procedures."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/needle_holder_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "B. Mathieu needle holder"
                },
                {
                  "type": "paragraph",
                  "text": "Has spring-action handles and a distinctive locking mechanism operated by squeezing the handles. Commonly used in selected suturing applications."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/needle_holder_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "C. Olsen-Hegar needle holder"
                },
                {
                  "type": "paragraph",
                  "text": "Combines a needle-holding function with scissors near the jaws, allowing sutures to be cut without changing instruments."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/needle_holder_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "D. Crile-Wood needle holder"
                },
                {
                  "type": "paragraph",
                  "text": "A commonly described fine needle holder used where controlled handling of smaller needles is required."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/needle_holder_08.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "E. Castroviejo needle holder"
                },
                {
                  "type": "paragraph",
                  "text": "A fine, often spring-handled instrument used in microsurgery and ophthalmic procedures, where precision is essential."
                },
                {
                  "type": "paragraph",
                  "text": "Other patterns exist, including specialist needle holders for cardiovascular, plastic and microsurgical procedures."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "needle_holder_subsection_5",
          "subsection_title": "4. Uses and clinical applications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "needle_holder_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The main function is to hold a surgical needle securely and guide it through tissue during wound closure or surgical reconstruction."
                },
                {
                  "type": "table",
                  "columns": [
                    "Use",
                    "Explanation"
                  ],
                  "rows": [
                    [
                      "Skin suturing",
                      "Drives the needle through the skin during wound closure."
                    ],
                    [
                      "Subcutaneous closure",
                      "Helps place sutures in the subcutaneous tissues."
                    ],
                    [
                      "Fascial closure",
                      "Holds suitable needles used to close fascia."
                    ],
                    [
                      "Bowel anastomosis",
                      "Used for needle manipulation during selected sutured intestinal procedures."
                    ],
                    [
                      "Vascular surgery",
                      "Specialist needle holders help place fine sutures in blood vessels."
                    ],
                    [
                      "Plastic surgery",
                      "Fine needle holders support precise suturing and wound closure."
                    ],
                    [
                      "Ophthalmic surgery",
                      "Microsurgical needle holders control very small needles and delicate sutures."
                    ],
                    [
                      "Gynaecological surgery",
                      "Used for suturing tissue during appropriate operative procedures."
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "needle_holder_group_6",
              "group_title": "Surgeries in which needle holders are used",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Hernia repair.",
                      "level": 0
                    },
                    {
                      "text": "Appendicectomy and laparotomy, particularly during wound closure.",
                      "level": 0
                    },
                    {
                      "text": "Caesarean section.",
                      "level": 0
                    },
                    {
                      "text": "Bowel resection and anastomosis.",
                      "level": 0
                    },
                    {
                      "text": "Vascular anastomosis.",
                      "level": 0
                    },
                    {
                      "text": "Plastic and reconstructive surgery.",
                      "level": 0
                    },
                    {
                      "text": "Ophthalmic and microsurgical procedures.",
                      "level": 0
                    },
                    {
                      "text": "General wound repair.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important: Needle holders are not cutting instruments, except for combination designs such as the Olsen-Hegar, which incorporate scissors. Even then, the cutting component is intended for sutures, not for general tissue dissection."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "needle_holder_subsection_6",
          "subsection_title": "5. Principles of needle loading and use",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "needle_holder_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/needle_holder_09.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 1 — Select the appropriate needle holder"
                },
                {
                  "type": "paragraph",
                  "text": "Match its size and jaw design to the needle, suture and tissue. A fine needle requires a suitably fine holder."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/needle_holder_10.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 2 — Grip the needle correctly"
                },
                {
                  "type": "paragraph",
                  "text": "For a curved needle, a common starting position is around the junction of the middle and posterior thirds, away from the swaged end and the needle tip. The exact position depends on needle design and the procedure."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/needle_holder_11.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 3 — Orient the needle"
                },
                {
                  "type": "paragraph",
                  "text": "Position the needle at an appropriate angle to the holder so that its curvature can be followed through the tissue. Avoid an unstable or excessively oblique grip."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/needle_holder_12.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 4 — Drive the needle"
                },
                {
                  "type": "paragraph",
                  "text": "Rotate the wrist and needle holder in a controlled arc that follows the curvature of the needle, rather than forcing the needle straight through tissue."
                }
              ]
            },
            {
              "group_id": "needle_holder_group_8",
              "group_title": "Why should the needle be gripped away from its tip?",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "It preserves the sharp point needed for tissue penetration.",
                      "level": 0
                    },
                    {
                      "text": "It gives the operator control over the needle's curve.",
                      "level": 0
                    },
                    {
                      "text": "It reduces the risk of damaging the needle tip.",
                      "level": 0
                    },
                    {
                      "text": "It helps prevent needle slippage during passage.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Avoid crushing the needle with excessive pressure. The ratchet should secure it without deforming or damaging the needle."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "needle_holder_subsection_7",
          "subsection_title": "6. Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "needle_holder_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Precise control: Helps guide a needle through tissue accurately.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Improved safety: Keeps the operator's fingers away from the sharp needle during passage.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Secure grip: Textured jaws reduce needle slippage.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Better suturing ergonomics: Ring handles allow controlled manipulation.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Ratchet mechanism: Maintains the grip without continuous hand pressure.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Specialist options: Different patterns support fine, deep or microsurgical suturing.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Combination functionality: Olsen-Hegar models can hold needles and cut sutures.",
                      "level": 0,
                      "label": "7."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "needle_holder_subsection_8",
          "subsection_title": "7. Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "needle_holder_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Excessive pressure can damage or deform a needle.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Worn or damaged jaws may allow the needle to slip.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "A bulky holder may be unsuitable for very fine sutures or restricted spaces.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "The ratchet can lock too tightly, making needle release difficult.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Combination models may accidentally cut a suture if used carelessly.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "The instrument requires regular inspection and careful reprocessing.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Using an incorrectly sized holder may compromise precision or damage delicate needles.",
                      "level": 0,
                      "label": "7."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "needle_holder_subsection_9",
          "subsection_title": "8. Complications of improper use",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "needle_holder_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Mechanism",
                    "Prevention"
                  ],
                  "rows": [
                    [
                      "Needle slippage",
                      "Poor grip, worn jaws or incorrect needle loading",
                      "Check jaw condition and grip stability."
                    ],
                    [
                      "Needle breakage",
                      "Excessive pressure or bending forces",
                      "Use the correct holder and avoid forcing the needle."
                    ],
                    [
                      "Tissue trauma",
                      "Incorrect needle angle or forceful passage",
                      "Follow the needle's curvature and use controlled movements."
                    ],
                    [
                      "Needle-stick injury",
                      "Loss of control during loading, passage or handover",
                      "Maintain a controlled field and follow sharps-safety procedures."
                    ],
                    [
                      "Suture damage",
                      "Gripping or cutting the suture unintentionally",
                      "Keep the suture away from the jaws and scissors when appropriate."
                    ],
                    [
                      "Needle deformation",
                      "Excessive clamping pressure",
                      "Use the minimum pressure necessary for a stable grip."
                    ],
                    [
                      "Delayed wound healing",
                      "Poor suturing technique or inappropriate tissue handling",
                      "Use appropriate technique, needle and suture selection."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "OSCE safety point: A needle holder must securely grip the needle without damaging it. A loose needle can cause needle-stick injury, tissue damage or loss of the needle in the operative field."
                }
              ]
            }
          ]
        },
