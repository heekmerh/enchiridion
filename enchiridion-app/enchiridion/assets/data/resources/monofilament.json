  "sections": [
    {
      "section_id": "monofilament_section_1",
      "section_title": "Monofilament",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "monofilament_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "monofilament_group_1",
              "group_title": "Monofilament (10-g Semmes–Weinstein Monofilament)",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/monofilament_01.webp",
                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "monofilament_subsection_2",
          "subsection_title": "1. Identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "monofilament_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A 10-g Semmes–Weinstein monofilament is a simple sensory-testing instrument used to assess protective sensation, particularly in the feet of patients at risk of peripheral neuropathy and diabetic foot ulceration."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Classification: Neurological sensory examination instrument.",
                      "level": 0
                    },
                    {
                      "text": "Principle: A calibrated flexible filament applies a reproducible approximate force to the skin.",
                      "level": 0
                    },
                    {
                      "text": "Key identifying feature: A thin nylon filament attached to a handle, designed to bend when the intended force is reached.",
                      "level": 0
                    },
                    {
                      "text": "Common clinical application: Screening for loss of protective sensation in people with diabetes.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "OSCE distinction: The 10-g monofilament assesses pressure sensation and protective sensation. It does not, by itself, assess every sensory modality or diagnose the cause of neuropathy."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "monofilament_subsection_3",
          "subsection_title": "2. Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "monofilament_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Screening for loss of protective sensation in patients with diabetes mellitus.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Assessing risk of diabetic foot ulceration.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Evaluating peripheral sensory neuropathy.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Supporting foot-risk assessment alongside examination of pulses, skin integrity, deformities and other sensory modalities.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Monitoring sensory findings over time when the same validated technique is used.",
                      "level": 0,
                      "label": "5."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "It may be used in other peripheral neuropathy assessments, but interpretation depends on the clinical context."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "monofilament_subsection_4",
          "subsection_title": "3. Parts and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "monofilament_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/monofilament_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A. Nylon filament"
                },
                {
                  "type": "paragraph",
                  "text": "Contacts the skin and bends when the intended force is reached. The filament should not be damaged or permanently bent."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/monofilament_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "B. Handle"
                },
                {
                  "type": "paragraph",
                  "text": "Allows the examiner to hold and position the filament accurately without touching the testing tip."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/monofilament_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "C. Protective storage case"
                },
                {
                  "type": "paragraph",
                  "text": "Protects the filament from bending, contamination and damage between examinations."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "monofilament_subsection_5",
          "subsection_title": "4. Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "monofilament_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Inexpensive, portable and easy to use.",
                      "level": 0
                    },
                    {
                      "text": "Requires no electricity or complex equipment.",
                      "level": 0
                    },
                    {
                      "text": "Provides a standardized assessment of protective pressure sensation.",
                      "level": 0
                    },
                    {
                      "text": "Useful for routine diabetic foot screening.",
                      "level": 0
                    },
                    {
                      "text": "Can help identify patients requiring closer foot surveillance and preventive care.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "monofilament_subsection_6",
          "subsection_title": "5. Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "monofilament_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "It assesses only a limited aspect of sensation.",
                      "level": 0
                    },
                    {
                      "text": "Results depend on the patient’s understanding and cooperation.",
                      "level": 0
                    },
                    {
                      "text": "Damaged or repeatedly overused filaments may not deliver the intended force.",
                      "level": 0
                    },
                    {
                      "text": "Incorrect application can produce misleading results.",
                      "level": 0
                    },
                    {
                      "text": "A normal result does not exclude all forms of peripheral neuropathy.",
                      "level": 0
                    },
                    {
                      "text": "It cannot reliably predict every future foot ulcer or replace a comprehensive foot assessment.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "monofilament_subsection_7",
          "subsection_title": "6. Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "monofilament_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Before starting:",
                  "items": [
                    {
                      "text": "Explain the test and obtain consent.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Wash your hands and follow local infection-prevention procedures.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Position the patient comfortably, with the feet accessible.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Inspect the skin for ulcers, wounds, infection or other areas where pressure should be avoided.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Demonstrate the sensation on an unaffected area, such as the forearm, so the patient understands what to expect.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Ask the patient to close their eyes or look away during testing.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Check that the filament is intact and appropriate for the examination.",
                      "level": 0,
                      "label": "7."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important: Do not apply the filament directly to an ulcer, callus, scar, necrotic area or other unsuitable site. Avoid sliding it across the skin."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "monofilament_subsection_8",
          "subsection_title": "7. How to use it — step-by-step OSCE demonstration",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "monofilament_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/monofilament_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 1: Introduce and explain"
                },
                {
                  "type": "paragraph",
                  "text": "Introduce yourself, confirm the patient’s identity, explain that you will test pressure sensation on the feet, and obtain consent."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/monofilament_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 2: Demonstrate the sensation"
                },
                {
                  "type": "paragraph",
                  "text": "Apply the filament briefly to an unaffected area. Ask the patient to tell you whenever they feel the pressure."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/monofilament_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 3: Position the filament"
                },
                {
                  "type": "paragraph",
                  "text": "With the patient’s eyes closed, place the filament perpendicular to a suitable plantar testing site. Common sites include the plantar surface of the great toe and the first, third and fifth metatarsal heads, depending on the protocol."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/monofilament_08.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 4: Apply the filament"
                },
                {
                  "type": "paragraph",
                  "text": "Press gently until the filament bends, then hold briefly—typically about 1–2 seconds—and lift it away. Do not jab, drag or repeatedly press at the same site."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/monofilament_09.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 5: Ask and repeat"
                },
                {
                  "type": "paragraph",
                  "text": "Ask the patient whether they felt the pressure and, if required by the protocol, where they felt it. Test the prescribed sites on both feet in a non-predictable sequence, including occasional sham applications if appropriate."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/monofilament_10.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Step 6: Interpret and document"
                },
                {
                  "type": "paragraph",
                  "text": "Record which sites were correctly perceived and which were not. Interpret the findings using the applicable screening protocol and complete the rest of the foot-risk assessment."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "monofilament_subsection_9",
          "subsection_title": "8. Contraindications and complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "monofilament_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "There are few absolute contraindications, but the technique should be adapted to the condition of the foot."
                },
                {
                  "type": "table",
                  "columns": [
                    "Situation",
                    "Precaution"
                  ],
                  "rows": [
                    [
                      "Open ulcer or wound",
                      "Do not test directly over it."
                    ],
                    [
                      "Painful or inflamed skin",
                      "Avoid the affected area and assess appropriately."
                    ],
                    [
                      "Severe callus",
                      "Avoid testing directly over the callus because sensation may be misrepresented."
                    ],
                    [
                      "Damaged filament",
                      "Replace it; do not rely on an unreliable instrument."
                    ],
                    [
                      "Patient unable to understand or cooperate",
                      "Use an appropriate alternative assessment and interpret results cautiously."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The examination is generally painless. Improper technique may cause discomfort, and contaminated equipment may contribute to cross-infection if cleaning and handling procedures are not followed."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "monofilament_subsection_10",
          "subsection_title": "9. Normal and abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "monofilament_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Normal finding"
                },
                {
                  "type": "paragraph",
                  "text": "The patient consistently perceives the stimulus at the required testing sites according to the screening protocol."
                },
                {
                  "type": "paragraph",
                  "text": "Abnormal finding"
                },
                {
                  "type": "paragraph",
                  "text": "The patient fails to perceive the stimulus at one or more required sites, suggesting possible loss of protective sensation."
                },
                {
                  "type": "paragraph",
                  "text": "An abnormal result should be interpreted in the context of the full examination. It may indicate peripheral neuropathy and increased risk of unnoticed trauma and foot ulceration."
                },
                {
                  "type": "paragraph",
                  "text": "Example of OSCE reporting:"
                },
                {
                  "type": "paragraph",
                  "text": "“Protective sensation is reduced over the plantar surface of the right great toe and third metatarsal head, with preserved sensation at the remaining tested sites. These findings suggest possible loss of protective sensation in the right foot. I would complete the diabetic foot assessment and follow the relevant risk-stratification protocol.”",
                  "style": "quote"
                },
                {
                  "type": "paragraph",
                  "text": "Do not diagnose diabetic neuropathy from the monofilament result alone."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "monofilament_subsection_11",
          "subsection_title": "10. Pediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "monofilament_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Although the 10-g monofilament is primarily associated with adult diabetic foot screening:",
                  "items": [
                    {
                      "text": "Children and adolescents with diabetes may require sensory screening according to age, clinical history and local guidelines.",
                      "level": 0
                    },
                    {
                      "text": "The child must understand the instructions and be able to report the sensation reliably.",
                      "level": 0
                    },
                    {
                      "text": "Use an age-appropriate explanation and demonstrate the stimulus first.",
                      "level": 0
                    },
                    {
                      "text": "Interpret results cautiously if cooperation or comprehension is limited.",
                      "level": 0
                    },
                    {
                      "text": "Do not assume that adult screening thresholds and protocols apply to every child.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "monofilament_subsection_12",
          "subsection_title": "11. Mnemonic — FEEL",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "monofilament_group_12",
              "group_title": "F",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Find suitable sites"
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the foot and avoid unsuitable skin."
                }
              ]
            },
            {
              "group_id": "monofilament_group_13",
              "group_title": "E",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Explain the test"
                },
                {
                  "type": "paragraph",
                  "text": "Demonstrate the sensation and ask the patient to close their eyes."
                }
              ]
            },
            {
              "group_id": "monofilament_group_14",
              "group_title": "E",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Exert calibrated pressure"
                },
                {
                  "type": "paragraph",
                  "text": "Apply perpendicular pressure until the filament bends."
                }
              ]
            },
            {
              "group_id": "monofilament_group_15",
              "group_title": "L",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Log the findings"
                },
                {
                  "type": "paragraph",
                  "text": "Record perceived and missed stimuli and assess overall foot risk."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "monofilament_subsection_13",
          "subsection_title": "12. Common OSCE questions and model answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "monofilament_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is the instrument used for?"
                },
                {
                  "type": "paragraph",
                  "text": "It assesses protective pressure sensation, particularly during diabetic foot screening."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Why is it called a 10-g monofilament?"
                },
                {
                  "type": "paragraph",
                  "text": "It is designed to bend at a calibrated force corresponding approximately to 10 grams-force under the specified testing conditions."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Which sites are commonly tested?"
                },
                {
                  "type": "paragraph",
                  "text": "Common sites include the plantar great toe and the first, third and fifth metatarsal heads. The exact sites and number of applications depend on the screening protocol."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Why should the patient close their eyes?"
                },
                {
                  "type": "paragraph",
                  "text": "This reduces visual cues and allows the examiner to assess reported sensation rather than the patient’s ability to see where the stimulus is applied."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What does failure to perceive the filament suggest?"
                },
                {
                  "type": "paragraph",
                  "text": "It suggests possible loss of protective sensation, which is associated with increased risk of unnoticed foot injury and ulceration."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Can a normal monofilament test exclude peripheral neuropathy?"
                },
                {
                  "type": "paragraph",
                  "text": "No. Other sensory modalities and clinical findings may be abnormal even when protective sensation is preserved."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. Why should you avoid sliding the filament?"
                },
                {
                  "type": "paragraph",
                  "text": "Sliding creates a different stimulus from calibrated pressure, potentially making the result unreliable."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "monofilament_subsection_14",
          "subsection_title": "13. Common mistakes and examiner tips",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "monofilament_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Common mistakes"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Applying the filament over an ulcer or thick callus.",
                      "level": 0
                    },
                    {
                      "text": "Allowing the patient to watch the examination.",
                      "level": 0
                    },
                    {
                      "text": "Pressing too hard or not enough to bend the filament.",
                      "level": 0
                    },
                    {
                      "text": "Sliding the filament over the skin.",
                      "level": 0
                    },
                    {
                      "text": "Testing only one foot.",
                      "level": 0
                    },
                    {
                      "text": "Using a damaged filament.",
                      "level": 0
                    },
                    {
                      "text": "Treating the test as a complete neurological examination.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Examiner tips"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "State the purpose clearly: assessment of protective sensation.",
                      "level": 0
                    },
                    {
                      "text": "Demonstrate the technique on the forearm before testing the feet.",
                      "level": 0
                    },
                    {
                      "text": "Apply the filament perpendicular to the skin until it bends.",
                      "level": 0
                    },
                    {
                      "text": "Use the sites specified by the relevant protocol.",
                      "level": 0
                    },
                    {
                      "text": "Report the actual sites where sensation is present or absent.",
                      "level": 0
                    },
                    {
                      "text": "Link an abnormal finding to diabetic foot-risk assessment and preventive care.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "monofilament_subsection_15",
          "subsection_title": "14. Mini-OSCE practice station",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "monofilament_group_18",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Practice station"
                },
                {
                  "type": "paragraph",
                  "text": "Scenario"
                },
                {
                  "type": "paragraph",
                  "text": "A 55-year-old patient with type 2 diabetes attends a clinic for a routine foot examination. You are given a 10-g monofilament."
                },
                {
                  "type": "paragraph",
                  "text": "Your tasks"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Identify the instrument and state its purpose.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Explain how you would prepare the patient.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Demonstrate the correct application technique.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Describe how you would interpret an absent response.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "State two limitations of the test.",
                      "level": 0,
                      "label": "5."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}