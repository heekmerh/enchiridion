{
  "chapter_metadata": {
    "chapter_id": "ruptured_ectopic_pregnancy",
    "chapter_title": "Ruptured ectopic pregnancy",
    "chapter_icon": null,
    "description": null,
    "position_in_book": 1,
    "tags": [
      "Ruptured ectopic pregnancy"
    ],
    "chapter_color": null
