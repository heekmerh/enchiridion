  "sections": [
    {
      "section_id": "ruptured_ectopic_pregnancy_section_1",
      "section_title": "Ruptured ectopic pregnancy",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "ruptured_ectopic_pregnancy_subsection_1",
          "subsection_title": "1. What the OSCE station may say",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ruptured_ectopic_pregnancy_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A 27-year-old woman is brought to the emergency department with sudden severe lower abdominal pain, vaginal spotting and collapse. She is approximately 7 weeks pregnant by her last menstrual period."
                },
                {
                  "type": "paragraph",
                  "text": "On examination, she is pale, cold and clammy. Her pulse is 132 beats/min and blood pressure is 78/46 mmHg."
                },
                {
                  "type": "list",
                  "title": "Your tasks:",
                  "items": [
                    {
                      "text": "Recognize the emergency and state your immediate priorities.",
                      "level": 0
                    },
                    {
                      "text": "Demonstrate the initial management of haemorrhagic shock.",
                      "level": 0
                    },
                    {
                      "text": "Outline investigations and definitive treatment.",
                      "level": 0
                    },
                    {
                      "text": "Explain potential complications and postoperative care.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The key diagnosis is ruptured ectopic pregnancy causing intra-abdominal haemorrhage and haemorrhagic shock until proven otherwise."
                },
                {
                  "type": "paragraph",
                  "text": "This is a time-critical emergency. Resuscitation and urgent operative management must proceed in parallel."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ruptured_ectopic_pregnancy_subsection_2",
          "subsection_title": "2. Definition and pathophysiology",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ruptured_ectopic_pregnancy_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A ruptured ectopic pregnancy occurs when an ectopic gestation breaches or tears the surrounding tissue, resulting in bleeding into the peritoneal cavity."
                },
                {
                  "type": "paragraph",
                  "text": "Tubal ectopic pregnancy is the commonest form. The tube cannot accommodate a growing pregnancy indefinitely, and rupture can cause rapid, life-threatening blood loss."
                }
              ]
            },
            {
              "group_id": "ruptured_ectopic_pregnancy_group_3",
              "group_title": "Sequence of events",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Ectopic pregnancy"
                },
                {
                  "type": "paragraph",
                  "text": "Tubal damage or rupture"
                },
                {
                  "type": "paragraph",
                  "text": "Intraperitoneal haemorrhage"
                },
                {
                  "type": "paragraph",
                  "text": "Reduced circulating blood volume"
                },
                {
                  "type": "paragraph",
                  "text": "Haemorrhagic shock → organ hypoperfusion → cardiac arrest if untreated"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ruptured_ectopic_pregnancy_subsection_3",
          "subsection_title": "3. Clinical features",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ruptured_ectopic_pregnancy_group_4",
              "group_title": "Symptoms",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Sudden or worsening lower abdominal pain, often unilateral initially.",
                      "level": 0
                    },
                    {
                      "text": "Vaginal spotting or bleeding.",
                      "level": 0
                    },
                    {
                      "text": "Amenorrhoea or a positive pregnancy test.",
                      "level": 0
                    },
                    {
                      "text": "Dizziness, fainting or collapse.",
                      "level": 0
                    },
                    {
                      "text": "Shoulder-tip pain due to diaphragmatic irritation by intraperitoneal blood.",
                      "level": 0
                    },
                    {
                      "text": "Weakness, palpitations and breathlessness.",
                      "level": 0
                    },
                    {
                      "text": "Nausea, vomiting or pain on defecation.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important: Vaginal bleeding may be minimal even when internal bleeding is severe."
                }
              ]
            },
            {
              "group_id": "ruptured_ectopic_pregnancy_group_5",
              "group_title": "Signs",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Finding",
                    "Clinical significance"
                  ],
                  "rows": [
                    [
                      "Tachycardia",
                      "Often an early sign of circulatory compromise."
                    ],
                    [
                      "Hypotension",
                      "Suggests significant blood loss or advanced shock."
                    ],
                    [
                      "Pallor",
                      "May indicate blood loss."
                    ],
                    [
                      "Cold, clammy extremities",
                      "Peripheral vasoconstriction due to shock."
                    ],
                    [
                      "Delayed capillary refill",
                      "Poor peripheral perfusion."
                    ],
                    [
                      "Abdominal tenderness or guarding",
                      "Peritoneal irritation from blood."
                    ],
                    [
                      "Abdominal distension",
                      "May occur with substantial haemoperitoneum."
                    ],
                    [
                      "Reduced consciousness",
                      "Severe hypoperfusion or other critical illness."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A patient may initially maintain a near-normal blood pressure despite considerable blood loss. Do not wait for hypotension before escalating treatment."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ruptured_ectopic_pregnancy_subsection_4",
          "subsection_title": "4. Immediate management: the first few minutes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ruptured_ectopic_pregnancy_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "In the OSCE, verbalize that you would call for help immediately and manage the patient using an ABCDE approach."
                },
                {
                  "type": "paragraph",
                  "text": "Step 1 — Call for emergency assistance"
                },
                {
                  "type": "paragraph",
                  "text": "Alert the senior obstetrician, anaesthetist, theatre team and blood bank. Activate the major haemorrhage protocol if indicated by the degree of bleeding and local criteria."
                },
                {
                  "type": "paragraph",
                  "text": "Step 2 — ABCDE assessment"
                },
                {
                  "type": "paragraph",
                  "text": "Assess airway, breathing, circulation, consciousness and exposure. Keep the patient warm and maintain dignity."
                },
                {
                  "type": "paragraph",
                  "text": "Step 3 — Establish IV access"
                },
                {
                  "type": "paragraph",
                  "text": "Insert two large-bore peripheral IV cannulas, usually 14–16G if feasible. Take blood samples immediately."
                },
                {
                  "type": "paragraph",
                  "text": "Step 4 — Restore circulating volume"
                },
                {
                  "type": "paragraph",
                  "text": "Begin appropriate resuscitation while urgently arranging blood products. Do not rely on large volumes of crystalloid in place of blood when major haemorrhage is occurring."
                },
                {
                  "type": "paragraph",
                  "text": "Step 5 — Definitive haemorrhage control"
                },
                {
                  "type": "paragraph",
                  "text": "Arrange emergency surgery without waiting for nonessential investigations or a formal ultrasound report when the clinical picture strongly indicates rupture and shock."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ruptured_ectopic_pregnancy_subsection_5",
          "subsection_title": "5. ABCDE assessment in detail",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ruptured_ectopic_pregnancy_group_7",
              "group_title": "A — Airway",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Check airway patency.",
                      "level": 0
                    },
                    {
                      "text": "Assess whether the patient can speak.",
                      "level": 0
                    },
                    {
                      "text": "Protect the airway if consciousness is impaired.",
                      "level": 0
                    },
                    {
                      "text": "Prepare for advanced airway management with anaesthetic assistance if required.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "ruptured_ectopic_pregnancy_group_8",
              "group_title": "B — Breathing",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Assess respiratory rate, oxygen saturation and respiratory effort.",
                      "level": 0
                    },
                    {
                      "text": "Give supplemental oxygen if hypoxaemic, critically ill or otherwise clinically indicated.",
                      "level": 0
                    },
                    {
                      "text": "Prepare for ventilatory support if required.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "ruptured_ectopic_pregnancy_group_9",
              "group_title": "C — Circulation",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This is the principal immediate concern."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Check pulse, blood pressure, capillary refill and peripheral temperature.",
                      "level": 0
                    },
                    {
                      "text": "Establish two large-bore IV lines.",
                      "level": 0
                    },
                    {
                      "text": "Send urgent blood samples.",
                      "level": 0
                    },
                    {
                      "text": "Begin blood-product resuscitation when major haemorrhage is suspected.",
                      "level": 0
                    },
                    {
                      "text": "Monitor ECG, oxygen saturation, blood pressure and temperature.",
                      "level": 0
                    },
                    {
                      "text": "Insert a urinary catheter when appropriate to monitor urine output, provided this does not delay definitive treatment.",
                      "level": 0
                    },
                    {
                      "text": "Reassess frequently for ongoing blood loss and response to treatment.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "ruptured_ectopic_pregnancy_group_10",
              "group_title": "D — Disability",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Assess:",
                  "items": [
                    {
                      "text": "Conscious level using AVPU or Glasgow Coma Scale.",
                      "level": 0
                    },
                    {
                      "text": "Confusion or agitation.",
                      "level": 0
                    },
                    {
                      "text": "Blood glucose, particularly if consciousness is altered.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "ruptured_ectopic_pregnancy_group_11",
              "group_title": "E — Exposure",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Examine the abdomen for tenderness, guarding and distension.",
                      "level": 0
                    },
                    {
                      "text": "Look for vaginal bleeding.",
                      "level": 0
                    },
                    {
                      "text": "Assess for other sources of bleeding or injury.",
                      "level": 0
                    },
                    {
                      "text": "Prevent hypothermia with warm blankets and warmed fluids or blood products as appropriate.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ruptured_ectopic_pregnancy_subsection_6",
          "subsection_title": "6. Investigations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ruptured_ectopic_pregnancy_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Investigations support treatment but must not delay emergency haemorrhage control."
                }
              ]
            },
            {
              "group_id": "ruptured_ectopic_pregnancy_group_13",
              "group_title": "Blood investigations",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Request urgently:",
                  "items": [
                    {
                      "text": "Full blood count.",
                      "level": 0
                    },
                    {
                      "text": "Blood group, antibody screen and crossmatch.",
                      "level": 0
                    },
                    {
                      "text": "Quantitative serum β-hCG if useful and immediately available.",
                      "level": 0
                    },
                    {
                      "text": "Coagulation profile, including fibrinogen when major haemorrhage is suspected.",
                      "level": 0
                    },
                    {
                      "text": "Renal function and electrolytes.",
                      "level": 0
                    },
                    {
                      "text": "Liver function when clinically relevant.",
                      "level": 0
                    },
                    {
                      "text": "Blood gas and lactate where available to assess perfusion and metabolic consequences of shock.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "An initially normal haemoglobin concentration does not exclude major acute blood loss."
                }
              ]
            },
            {
              "group_id": "ruptured_ectopic_pregnancy_group_14",
              "group_title": "Imaging",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Bedside ultrasound or FAST-type assessment, where available and performed by a trained clinician, may rapidly identify free intraperitoneal fluid."
                },
                {
                  "type": "paragraph",
                  "text": "Transvaginal ultrasound may help confirm the diagnosis if the patient is stable enough and imaging can be obtained without delaying treatment."
                },
                {
                  "type": "paragraph",
                  "text": "In an unstable patient with suspected ruptured ectopic pregnancy, do not delay operative management to obtain a definitive scan."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ruptured_ectopic_pregnancy_subsection_7",
          "subsection_title": "7. Fluid and blood-product resuscitation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ruptured_ectopic_pregnancy_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The aim is to restore oxygen delivery and circulating volume while achieving definitive control of bleeding."
                }
              ]
            },
            {
              "group_id": "ruptured_ectopic_pregnancy_group_16",
              "group_title": "Crystalloid fluids",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Use warmed isotonic crystalloid as a bridge while blood products are obtained when necessary. Avoid excessive crystalloid administration, which can worsen dilutional coagulopathy and tissue oedema."
                }
              ]
            },
            {
              "group_id": "ruptured_ectopic_pregnancy_group_17",
              "group_title": "Blood transfusion",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Blood products are essential when significant haemorrhage is ongoing or strongly suspected."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Use emergency-release blood according to hospital policy if crossmatched blood is not yet available and transfusion is urgently required.",
                      "level": 0
                    },
                    {
                      "text": "Use crossmatched blood when available.",
                      "level": 0
                    },
                    {
                      "text": "Activate a major haemorrhage protocol for severe bleeding according to local criteria.",
                      "level": 0
                    },
                    {
                      "text": "Replace platelets, plasma and fibrinogen when indicated by the clinical situation, laboratory results and local protocol.",
                      "level": 0
                    },
                    {
                      "text": "Monitor for hypothermia, coagulopathy, electrolyte disturbances and transfusion reactions.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "ruptured_ectopic_pregnancy_group_18",
              "group_title": "Monitoring response to resuscitation",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Monitor:",
                  "items": [
                    {
                      "text": "Pulse and blood pressure.",
                      "level": 0
                    },
                    {
                      "text": "Mental status.",
                      "level": 0
                    },
                    {
                      "text": "Capillary refill and peripheral perfusion.",
                      "level": 0
                    },
                    {
                      "text": "Urine output.",
                      "level": 0
                    },
                    {
                      "text": "Lactate or blood gas trends when available.",
                      "level": 0
                    },
                    {
                      "text": "Ongoing bleeding and response to surgery.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "OSCE pearl: A transient improvement in blood pressure does not mean the bleeding has stopped."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ruptured_ectopic_pregnancy_subsection_8",
          "subsection_title": "8. Definitive treatment: emergency surgery",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ruptured_ectopic_pregnancy_group_19",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The definitive treatment for a ruptured ectopic pregnancy with haemodynamic instability is urgent operative management, usually involving laparoscopy when feasible and safe, or laparotomy when necessary."
                }
              ]
            },
            {
              "group_id": "ruptured_ectopic_pregnancy_group_20",
              "group_title": "A. Laparotomy",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "May be required when:",
                  "items": [
                    {
                      "text": "The patient is profoundly unstable.",
                      "level": 0
                    },
                    {
                      "text": "There is massive haemoperitoneum.",
                      "level": 0
                    },
                    {
                      "text": "Rapid access and haemorrhage control are needed.",
                      "level": 0
                    },
                    {
                      "text": "Laparoscopy is unavailable or unsuitable.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "ruptured_ectopic_pregnancy_group_21",
              "group_title": "B. Laparoscopy",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "May be appropriate when the patient can be stabilized sufficiently and the surgical team, facilities and circumstances permit safe laparoscopic management."
                }
              ]
            },
            {
              "group_id": "ruptured_ectopic_pregnancy_group_22",
              "group_title": "C. Salpingectomy versus salpingotomy",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/ruptured_ectopic_pregnancy_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Salpingectomy"
                },
                {
                  "type": "paragraph",
                  "text": "Removal of the affected fallopian tube. It is often preferred when the tube is severely damaged or bleeding substantially, especially if the opposite tube is healthy."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/ruptured_ectopic_pregnancy_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Salpingotomy"
                },
                {
                  "type": "paragraph",
                  "text": "The ectopic pregnancy is removed while preserving the tube. It may be considered in selected cases, particularly if the other tube is damaged, but persistent trophoblastic tissue is a risk and follow-up β-hCG is essential."
                },
                {
                  "type": "paragraph",
                  "text": "Methotrexate is not the treatment for a ruptured ectopic pregnancy with shock. It cannot provide the immediate haemorrhage control this patient needs."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ruptured_ectopic_pregnancy_subsection_9",
          "subsection_title": "9. Postoperative management",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ruptured_ectopic_pregnancy_group_23",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "After surgery, continue close monitoring and treat complications."
                }
              ]
            },
            {
              "group_id": "ruptured_ectopic_pregnancy_group_24",
              "group_title": "Immediate postoperative care",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Monitor vital signs, consciousness and peripheral perfusion.",
                      "level": 0
                    },
                    {
                      "text": "Review haemoglobin, coagulation status and other investigations as indicated.",
                      "level": 0
                    },
                    {
                      "text": "Monitor urine output and renal function.",
                      "level": 0
                    },
                    {
                      "text": "Assess for ongoing bleeding.",
                      "level": 0
                    },
                    {
                      "text": "Manage pain and nausea.",
                      "level": 0
                    },
                    {
                      "text": "Provide thromboprophylaxis when safe, taking account of bleeding risk and local protocol.",
                      "level": 0
                    },
                    {
                      "text": "Review operative findings and histopathology when available.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "ruptured_ectopic_pregnancy_group_25",
              "group_title": "Follow-up",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Confirm whether the ectopic pregnancy was removed and whether further β-hCG monitoring is required.",
                      "level": 0
                    },
                    {
                      "text": "After salpingotomy, serial β-hCG is particularly important because persistent trophoblastic tissue may remain.",
                      "level": 0
                    },
                    {
                      "text": "Discuss future fertility and the increased risk of another ectopic pregnancy.",
                      "level": 0
                    },
                    {
                      "text": "Arrange early ultrasound assessment in a subsequent pregnancy.",
                      "level": 0
                    },
                    {
                      "text": "Offer emotional support, particularly if the pregnancy was wanted.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Discuss RhD status and anti-D prophylaxis according to the applicable local guideline and circumstances of management."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ruptured_ectopic_pregnancy_subsection_10",
          "subsection_title": "10. Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ruptured_ectopic_pregnancy_group_26",
              "group_title": "Maternal complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Haemorrhagic shock.",
                      "level": 0
                    },
                    {
                      "text": "Severe anaemia.",
                      "level": 0
                    },
                    {
                      "text": "Acute kidney injury from hypoperfusion.",
                      "level": 0
                    },
                    {
                      "text": "Coagulopathy.",
                      "level": 0
                    },
                    {
                      "text": "Cardiac arrest and maternal death.",
                      "level": 0
                    },
                    {
                      "text": "Complications of emergency surgery and blood transfusion.",
                      "level": 0
                    },
                    {
                      "text": "Reduced fertility, especially if both tubes are damaged or removed.",
                      "level": 0
                    },
                    {
                      "text": "Recurrent ectopic pregnancy.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "ruptured_ectopic_pregnancy_group_27",
              "group_title": "Psychological consequences",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The patient may experience grief, anxiety, guilt or fear about future pregnancy. Acknowledge the loss and offer support without minimizing the experience."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ruptured_ectopic_pregnancy_subsection_11",
          "subsection_title": "11. Example OSCE emergency handover",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ruptured_ectopic_pregnancy_group_28",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Use a concise SBAR structure."
                },
                {
                  "type": "paragraph",
                  "text": "S — Situation"
                },
                {
                  "type": "paragraph",
                  "text": "“I am calling about a 27-year-old woman with suspected ruptured ectopic pregnancy and haemorrhagic shock.”",
                  "style": "quote"
                },
                {
                  "type": "paragraph",
                  "text": "B — Background"
                },
                {
                  "type": "paragraph",
                  "text": "“She is approximately seven weeks pregnant and presented with sudden severe lower abdominal pain, vaginal spotting and collapse.”",
                  "style": "quote"
                },
                {
                  "type": "paragraph",
                  "text": "A — Assessment"
                },
                {
                  "type": "paragraph",
                  "text": "“Her pulse is 132 beats/min and blood pressure is 78/46 mmHg. She is pale and clammy, with suspected significant internal haemorrhage.”",
                  "style": "quote"
                },
                {
                  "type": "paragraph",
                  "text": "R — Recommendation"
                },
                {
                  "type": "paragraph",
                  "text": "“I need immediate senior obstetric and anaesthetic review, emergency blood products and urgent operative management. Resuscitation is underway, with two large-bore IV lines and blood samples sent.”",
                  "style": "quote"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ruptured_ectopic_pregnancy_subsection_12",
          "subsection_title": "12. Common examiner questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ruptured_ectopic_pregnancy_group_29",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is the most important immediate action?"
                },
                {
                  "type": "paragraph",
                  "text": "Recognize shock, call for emergency assistance, initiate ABCDE resuscitation and arrange urgent definitive haemorrhage control in parallel."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Why can haemoglobin initially be normal?"
                },
                {
                  "type": "paragraph",
                  "text": "Acute whole-blood loss removes plasma and red cells together. The measured concentration may not fall immediately until redistribution or fluid administration occurs."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Should you wait for ultrasound before operating?"
                },
                {
                  "type": "paragraph",
                  "text": "Not when the patient is unstable and the clinical picture strongly suggests rupture. Imaging must not delay life-saving treatment."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Why are two large-bore IV cannulas used?"
                },
                {
                  "type": "paragraph",
                  "text": "They allow rapid administration of fluids and blood products and provide reliable access during resuscitation."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. Why is methotrexate contraindicated in this emergency?"
                },
                {
                  "type": "paragraph",
                  "text": "It does not stop active internal bleeding quickly enough and is inappropriate for a ruptured ectopic pregnancy with haemodynamic instability."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What should be discussed before discharge?"
                },
                {
                  "type": "paragraph",
                  "text": "Recovery, warning symptoms, any required β-hCG monitoring, future fertility, early assessment in the next pregnancy and emotional support."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ruptured_ectopic_pregnancy_subsection_13",
          "subsection_title": "13. Common OSCE mistakes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ruptured_ectopic_pregnancy_group_30",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Taking a lengthy history before assessing circulation.",
                      "level": 0
                    },
                    {
                      "text": "Waiting for hypotension before recognizing shock.",
                      "level": 0
                    },
                    {
                      "text": "Assuming minimal vaginal bleeding means minimal blood loss.",
                      "level": 0
                    },
                    {
                      "text": "Waiting for haemoglobin to fall before arranging blood.",
                      "level": 0
                    },
                    {
                      "text": "Delaying surgery for nonessential investigations.",
                      "level": 0
                    },
                    {
                      "text": "Giving methotrexate to a patient with suspected rupture and shock.",
                      "level": 0
                    },
                    {
                      "text": "Forgetting to monitor response to resuscitation.",
                      "level": 0
                    },
                    {
                      "text": "Omitting postoperative follow-up and counselling.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ruptured_ectopic_pregnancy_subsection_14",
          "subsection_title": "14. Memory aid: RUPTURE",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ruptured_ectopic_pregnancy_group_31",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "R — Recognize haemorrhagic shock.",
                      "level": 0
                    },
                    {
                      "text": "U — Urgent senior help and theatre activation.",
                      "level": 0
                    },
                    {
                      "text": "P — Prepare two large-bore IV lines and blood samples.",
                      "level": 0
                    },
                    {
                      "text": "T — Transfuse blood products when indicated.",
                      "level": 0
                    },
                    {
                      "text": "U — Use ABCDE resuscitation and continuous reassessment.",
                      "level": 0
                    },
                    {
                      "text": "R — Rapid definitive surgical management.",
                      "level": 0
                    },
                    {
                      "text": "E — Evaluate postoperative recovery and future fertility.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "ruptured_ectopic_pregnancy_subsection_15",
          "subsection_title": "15. Quick self-test",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "ruptured_ectopic_pregnancy_group_32",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "1. A woman with suspected ruptured ectopic pregnancy has a BP of 78/46 mmHg. What is the priority?"
                },
                {
                  "type": "paragraph",
                  "text": "Wait for the β-hCG result"
                },
                {
                  "type": "paragraph",
                  "text": "Start methotrexate"
                },
                {
                  "type": "paragraph",
                  "text": "Resuscitate immediately and arrange urgent operative management"
                },
                {
                  "type": "paragraph",
                  "text": "Perform a lengthy pelvic examination first"
                },
                {
                  "type": "paragraph",
                  "text": "2. Why may the initial haemoglobin be normal despite major acute blood loss?"
                },
                {
                  "type": "paragraph",
                  "text": "Ectopic pregnancy does not cause anaemia"
                },
                {
                  "type": "paragraph",
                  "text": "The concentration may not fall immediately after acute whole-blood loss"
                },
                {
                  "type": "paragraph",
                  "text": "Haemoglobin is always elevated in pregnancy"
                },
                {
                  "type": "paragraph",
                  "text": "The blood is confined to the uterus"
                },
                {
                  "type": "paragraph",
                  "text": "3. Which treatment is inappropriate for a ruptured ectopic pregnancy with haemorrhagic shock?"
                },
                {
                  "type": "paragraph",
                  "text": "Urgent senior review"
                },
                {
                  "type": "paragraph",
                  "text": "Blood-product resuscitation"
                },
                {
                  "type": "paragraph",
                  "text": "Emergency surgery"
                },
                {
                  "type": "paragraph",
                  "text": "Methotrexate as definitive emergency treatment"
                },
                {
                  "type": "paragraph",
                  "text": "4. After salpingotomy, what follow-up is especially important?"
                },
                {
                  "type": "paragraph",
                  "text": "Serial β-hCG until resolution"
                },
                {
                  "type": "paragraph",
                  "text": "No follow-up if pain resolves"
                },
                {
                  "type": "paragraph",
                  "text": "Routine CT scanning for every patient"
                },
                {
                  "type": "paragraph",
                  "text": "Daily methotrexate for all patients"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}