                    ],
                    [
                      "Abdominal surgery",
                      "Manipulating selected tissue edges during open procedures"
                    ],
                    [
                      "Skin suturing",
                      "Holding skin edges with suitable toothed forceps"
                    ],
                    [
                      "Plastic surgery",
                      "Fine tissue handling and wound-edge alignment"
                    ],
                    [
                      "Orthopaedic surgery",
                      "Handling suitable soft tissues during procedures"
                    ],
                    [
                      "Gynaecological surgery",
                      "Grasping and manipulating appropriate tissues"
                    ],
                    [
                      "Dressing procedures",
                      "Handling dressings when a designated, appropriately processed instrument is used"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The choice of forceps depends on the tissue, the procedure and the required degree of grip."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dissecting_forceps_subsection_7",
          "subsection_title": "6. Advantages and disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dissecting_forceps_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Advantages"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Simple to operate with one hand.",
                      "level": 0
                    },
                    {
                      "text": "Provide precise control of tissue handling.",
                      "level": 0
                    },
                    {
                      "text": "Available in many tip shapes and sizes.",
                      "level": 0
                    },
                    {
                      "text": "Do not require electricity or a locking mechanism.",
                      "level": 0
                    },
                    {
                      "text": "Toothed variants provide a secure grip on suitable tissues.",
                      "level": 0
                    },
                    {
                      "text": "Reusable models can be reprocessed according to their instructions for use.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Disadvantages"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Excessive pressure may crush tissue.",
                      "level": 0
                    },
                    {
                      "text": "Toothed tips may puncture or tear delicate structures.",
                      "level": 0
                    },
                    {
                      "text": "Plain tips may slip if the grip is inadequate.",
                      "level": 0
                    },
                    {
                      "text": "Fine tips may bend or become misaligned.",
                      "level": 0
                    },
                    {
                      "text": "Poor technique can damage tissue or contaminate the operative field.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dissecting_forceps_subsection_8",
          "subsection_title": "7. Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dissecting_forceps_group_12",
              "group_title": "Patient-related complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Tissue crushing or bruising.",
                      "level": 0
                    },
                    {
                      "text": "Puncture or tearing from toothed tips.",
                      "level": 0
                    },
                    {
                      "text": "Damage to small vessels, nerves or other structures.",
                      "level": 0
                    },
                    {
                      "text": "Bleeding from traumatic grasping.",
                      "level": 0
                    },
                    {
                      "text": "Wound contamination or infection if aseptic technique is breached.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "dissecting_forceps_group_13",
              "group_title": "Instrument-related problems",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Bent or misaligned tips.",
                      "level": 0
                    },
                    {
                      "text": "Damaged teeth or serrations.",
                      "level": 0
                    },
                    {
                      "text": "Corrosion or other instrument damage.",
                      "level": 0
                    },
                    {
                      "text": "Reduced grip from worn surfaces.",
                      "level": 0
                    },
                    {
                      "text": "Failure to meet accurately at the tips.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the instrument before use, particularly for alignment, tip integrity and the ability to grasp without excessive force."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dissecting_forceps_subsection_9",
          "subsection_title": "8. Plain versus toothed dissecting forceps",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dissecting_forceps_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/dissecting_forceps_01.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Plain forceps",
                    "Toothed forceps"
                  ],
                  "rows": [
                    [
                      "Tip design",
                      "No prominent teeth; may have fine serrations",
                      "Interlocking teeth"
                    ],
                    [
                      "Grip",
                      "Relies on surface contact and controlled pressure",
                      "Teeth provide a more secure grip"
                    ],
                    [
                      "Typical application",
                      "Suitable delicate tissue handling",
                      "Skin edges and tougher tissues"
                    ],
                    [
                      "Main risk",
                      "Slipping and crushing from excessive pressure",
                      "Puncture or tearing"
                    ],
                    [
                      "Key principle",
                      "Gentle, controlled grip",
                      "Secure grip with minimal necessary force"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Memory aid: Plain protects when appropriate; teeth grip securely but can puncture."
                },
                {
                  "type": "paragraph",
                  "text": "This is a guide, not an absolute rule. The suitability of either type depends on the tissue and task."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dissecting_forceps_subsection_10",
          "subsection_title": "9. Common OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dissecting_forceps_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is this instrument?"
                },
                {
                  "type": "paragraph",
                  "text": "Dissecting forceps, used to grasp and manipulate tissues during surgery."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What are the main types?"
                },
                {
                  "type": "paragraph",
                  "text": "Plain or non-toothed forceps and toothed forceps."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What does 1 × 2 teeth mean?"
                },
                {
                  "type": "paragraph",
                  "text": "One tooth on one tip engages between two teeth on the opposing tip."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Which type is commonly used to hold skin edges during suturing?"
                },
                {
                  "type": "paragraph",
                  "text": "Toothed dissecting forceps, such as Adson toothed forceps."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. Do dissecting forceps have a ratchet?"
                },
                {
                  "type": "paragraph",
                  "text": "No. They are spring-operated thumb forceps, unlike ring-handled locking forceps."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What complications may occur?"
                },
                {
                  "type": "paragraph",
                  "text": "Tissue crushing, puncture, tearing, bleeding, damage to adjacent structures and contamination."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What should you inspect before use?"
                },
                {
                  "type": "paragraph",
                  "text": "Tip alignment, integrity of the teeth or serrations, spring action and overall instrument condition."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dissecting_forceps_subsection_11",
          "subsection_title": "10. High-yield revision card",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dissecting_forceps_group_16",
              "group_title": "Dissecting forceps — must know",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Category: Grasping and tissue-manipulating instrument.",
                      "level": 0
                    },
                    {
                      "text": "Identifying feature: Spring-operated arms without finger rings or a ratchet.",
                      "level": 0
                    },
                    {
                      "text": "Main types: Plain and toothed.",
                      "level": 0
                    },
                    {
                      "text": "Common toothed configuration: 1 × 2.",
                      "level": 0
                    },
                    {
                      "text": "Important use: Holding skin edges during suturing.",
                      "level": 0
                    },
                    {
                      "text": "Main complications: Crushing, puncture and tissue tearing.",
                      "level": 0
                    },
                    {
                      "text": "Safety principle: Select the correct tip and apply only the necessary pressure.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "**Model 30-second OSCE presentation**",
                  "style": "heading"
                },
                {
                  "type": "paragraph",
                  "text": "“These are dissecting forceps, spring-operated instruments used to grasp and manipulate tissues during surgery. They consist of two resilient arms and opposing tips, which may be plain or toothed. Plain forceps are used for suitable tissue handling, while toothed forceps provide a more secure grip on skin and tougher tissues. They are useful in dissection and suturing but may cause tissue crushing, puncture or tearing if used incorrectly. Before use, I would inspect the tips, alignment and spring action.”",
                  "style": "quote"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}