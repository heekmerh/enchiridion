    {
      "section_id": "dissecting_forceps_section_1",
      "section_title": "Dissecting forceps",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "dissecting_forceps_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dissecting_forceps_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/dissecting_forceps_01.webp",
                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dissecting_forceps_subsection_2",
          "subsection_title": "1. Introduction and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dissecting_forceps_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Dissecting forceps are hand-held surgical instruments used to grasp, hold, retract and manipulate tissues during surgical procedures. They are commonly called thumb forceps because they are operated by squeezing their spring-like arms between the thumb and fingers."
                },
                {
                  "type": "paragraph",
                  "text": "They are not the same as ring-handled artery forceps, which have a locking mechanism."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Category: Grasping and tissue-manipulating instrument.",
                      "level": 0
                    },
                    {
                      "text": "Primary function: Holding and manipulating tissues during dissection, suturing and other operative steps.",
                      "level": 0
                    },
                    {
                      "text": "Material: Usually stainless steel.",
                      "level": 0
                    },
                    {
                      "text": "Construction: Two spring arms joined at one end, with grasping tips at the other.",
                      "level": 0
                    },
                    {
                      "text": "Main classification: Toothed and non-toothed (plain) forceps.",
                      "level": 0
                    },
                    {
                      "text": "Sterility: Reusable instruments must be cleaned, inspected and sterilised appropriately before use.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "dissecting_forceps_group_3",
              "group_title": "How to identify dissecting forceps in an OSCE",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Look for:",
                  "items": [
                    {
                      "text": "Two opposing spring arms.",
                      "level": 0
                    },
                    {
                      "text": "No finger rings.",
                      "level": 0
                    },
                    {
                      "text": "No ratchet or locking mechanism.",
                      "level": 0
                    },
                    {
                      "text": "A pair of opposing tips that meet when the arms are squeezed.",
                      "level": 0
                    },
                    {
                      "text": "Fine serrations or teeth at the tips, depending on the design.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Model identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“These are dissecting forceps, a hand-held surgical instrument used to grasp and manipulate tissues. They may be toothed or non-toothed, depending on the tissue and the degree of secure grip required.”",
                  "style": "quote"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dissecting_forceps_subsection_3",
          "subsection_title": "2. Labelling of dissecting forceps",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dissecting_forceps_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/dissecting_forceps_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "The main parts are:"
                },
                {
                  "type": "paragraph",
                  "text": "1. Arms or handles"
                },
                {
                  "type": "paragraph",
                  "text": "The two elongated sections held between the fingers and thumb. They transmit the squeezing force to the tips."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/dissecting_forceps_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "2. Spring or resilient portion"
                },
                {
                  "type": "paragraph",
                  "text": "The joined end allows the arms to separate again when pressure is released."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/dissecting_forceps_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "3. Gripping surfaces"
                },
                {
                  "type": "paragraph",
                  "text": "The opposing surfaces may have transverse serrations or teeth to improve grip."
                },
                {
                  "type": "paragraph",
                  "text": "4. Tips or jaws"
                },
                {
                  "type": "paragraph",
                  "text": "The distal ends that contact and hold the tissue. They may be pointed, rounded, broad or fine."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE tip: Dissecting forceps do not have a ratchet lock. If the instrument has finger rings and a ratchet, it is more likely a ring-handled forceps such as an artery forceps or tissue-holding forceps."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dissecting_forceps_subsection_4",
          "subsection_title": "3. Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dissecting_forceps_group_5",
              "group_title": "A. Plain or non-toothed dissecting forceps",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/dissecting_forceps_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "daraz.com.bd"
                },
                {
                  "type": "paragraph",
                  "text": "These have opposing tips without prominent interlocking teeth. They commonly have fine serrations to improve grip."
                },
                {
                  "type": "list",
                  "title": "Uses:",
                  "items": [
                    {
                      "text": "Handling delicate tissues.",
                      "level": 0
                    },
                    {
                      "text": "Holding blood vessels or other structures gently when appropriate.",
                      "level": 0
                    },
                    {
                      "text": "Manipulating dressings and materials when the instrument is designated for that purpose.",
                      "level": 0
                    },
                    {
                      "text": "Assisting with suturing and tissue handling.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Key principle: Use the minimum pressure needed to hold the tissue securely. Excessive pressure can still cause crushing injury, even with plain forceps."
                }
              ]
            },
            {
              "group_id": "dissecting_forceps_group_6",
              "group_title": "B. Toothed dissecting forceps",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/dissecting_forceps_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "alfamedic.com.hk"
                },
                {
                  "type": "paragraph",
                  "text": "These have teeth that interlock or engage when the tips are brought together. A common configuration is 1 × 2 teeth, meaning one tooth on one tip engages between two teeth on the opposing tip."
                },
                {
                  "type": "list",
                  "title": "Uses:",
                  "items": [
                    {
                      "text": "Grasping skin during suturing.",
                      "level": 0
                    },
                    {
                      "text": "Holding tougher tissues that require a secure grip.",
                      "level": 0
                    },
                    {
                      "text": "Manipulating tissue edges during wound closure.",
                      "level": 0
                    },
                    {
                      "text": "Assisting with selected superficial surgical procedures.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Key principle: Teeth improve grip but can puncture tissue. Select the forceps according to the tissue's fragility and the task."
                }
              ]
            },
            {
              "group_id": "dissecting_forceps_group_7",
              "group_title": "C. Specialised dissecting forceps",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Examples include:",
                  "items": [
                    {
                      "text": "Adson forceps: Short forceps with a broad grip, commonly used in superficial surgery and wound closure.",
                      "level": 0
                    },
                    {
                      "text": "Adson toothed forceps: Frequently used to grasp skin edges during suturing.",
                      "level": 0
                    },
                    {
                      "text": "Fine microsurgical forceps: Used for delicate structures under magnification.",
                      "level": 0
                    },
                    {
                      "text": "Long dissecting forceps: Used where greater reach is needed in deeper operative fields.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These are specialised designs within the broader forceps family; not all should be treated as interchangeable."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dissecting_forceps_subsection_5",
          "subsection_title": "4. Principles of use",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dissecting_forceps_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The aim is to obtain a secure grip without unnecessary tissue trauma."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Choose the correct tip: Plain tips may be preferred for suitable delicate tissues, while toothed tips can provide a more secure grip on skin and tougher tissues.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Use controlled pressure: Squeeze only enough to maintain the required hold.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Grasp the appropriate tissue: Avoid unnecessarily crushing or puncturing adjacent structures.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Maintain visual control: Know exactly what is being grasped.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Avoid prolonged unnecessary compression: Sustained pressure may compromise tissue integrity or perfusion.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Maintain asepsis: Use appropriately sterile instruments in the operative field.",
                      "level": 0,
                      "label": "6."
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "dissecting_forceps_group_9",
              "group_title": "Important distinction",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Forceps are used to grasp and manipulate tissue; they are not designed primarily to cut tissue or clamp blood vessels shut. Those functions require other instruments."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "dissecting_forceps_subsection_6",
          "subsection_title": "5. Uses and surgeries",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "dissecting_forceps_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Clinical setting",
                    "Application"
                  ],
                  "rows": [
                    [
                      "General surgery",
