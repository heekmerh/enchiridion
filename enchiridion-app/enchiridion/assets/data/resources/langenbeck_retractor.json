        {
          "subsection_id": "langenbeck_retractor_subsection_12",
          "subsection_title": "11. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "langenbeck_retractor_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a Langenbeck retractor. It is a handheld surgical instrument used to retract wound edges and soft tissues to improve exposure. It consists of a handle, shaft and a broad, flat blade angled approximately at a right angle to the shaft. It is used in general surgery, hernia repair and other procedures requiring superficial or moderately deep retraction. Complications of improper use include tissue bruising, tearing, pressure ischaemia and injury to nearby nerves or vessels. Before use, I would inspect the blade, handle, surface condition, cleanliness and sterility.”",
                  "style": "quote"
                }
              ]
            }
          ]
