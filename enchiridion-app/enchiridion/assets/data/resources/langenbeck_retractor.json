        {
          "subsection_id": "langenbeck_retractor_subsection_2",
          "subsection_title": "1. Introduction and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "langenbeck_retractor_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A Langenbeck retractor is a handheld surgical retractor used to hold back wound edges and soft tissues to improve visibility and access to the operative field."
                },
                {
                  "type": "paragraph",
                  "text": "It is commonly used in general surgery, orthopaedics and other operations where superficial or moderately deep tissue retraction is required."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification card"
                },
                {
                  "type": "paragraph",
                  "text": "Name: Langenbeck retractor"
                },
                {
                  "type": "paragraph",
                  "text": "Classification: Handheld, non-self-retaining retractor"
                },
                {
                  "type": "paragraph",
                  "text": "Primary function: Retracting wound edges and soft tissues."
                },
                {
                  "type": "paragraph",
                  "text": "Characteristic feature: A flat, usually right-angled blade attached to a handle."
                },
                {
                  "type": "paragraph",
                  "text": "Mechanism: Manually held; no locking mechanism in the standard pattern."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification clue: Look for a simple handle with a broad, flat blade bent approximately at a right angle to the shaft. The blade engages the tissue while the operator holds the instrument."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "langenbeck_retractor_subsection_3",
          "subsection_title": "2. Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "langenbeck_retractor_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
