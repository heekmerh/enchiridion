      "section_id": "allis_tissue_forceps_section_1",
      "section_title": "Allis tissue forceps",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "allis_tissue_forceps_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "allis_tissue_forceps_group_1",
              "group_title": "Allis Tissue Forceps (Allis Tissue-Holding Forceps)",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/allis_tissue_forceps_01.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/allis_tissue_forceps_02.webp",
                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "allis_tissue_forceps_subsection_2",
          "subsection_title": "Introduction and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "allis_tissue_forceps_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Allis tissue forceps are ring-handled, ratcheted surgical instruments used to grasp, hold and manipulate tissues during surgical procedures. Their characteristic feature is a set of multiple interlocking teeth at the tip, designed to provide a secure grip."
                },
                {
                  "type": "paragraph",
                  "text": "They are generally considered traumatic tissue-holding instruments because their teeth can penetrate or damage tissue."
                },
                {
                  "type": "paragraph",
                  "text": "Category: Grasping and tissue-holding instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Primary function: Securely holding suitable tissues during dissection, excision and surgical manipulation."
                },
                {
                  "type": "paragraph",
                  "text": "Material: Usually stainless steel."
                },
                {
                  "type": "paragraph",
                  "text": "Construction: Finger rings, shanks, a box joint, a ratchet and toothed jaws."
                },
                {
                  "type": "paragraph",
                  "text": "Common design: Multiple interlocking teeth, often described as 4 × 5 in commonly encountered patterns."
                },
                {
                  "type": "paragraph",
                  "text": "Operation: The jaws close around tissue, and the ratchet maintains the grip."
                }
              ]
            },
            {
              "group_id": "allis_tissue_forceps_group_3",
              "group_title": "How to identify it in an OSCE",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Look for:"
                },
                {
                  "type": "paragraph",
                  "text": "Two finger rings."
                },
                {
                  "type": "paragraph",
                  "text": "A ratchet locking mechanism."
                },
                {
                  "type": "paragraph",
                  "text": "A box joint."
                },
                {
                  "type": "paragraph",
                  "text": "Short, relatively robust jaws."
                },
                {
                  "type": "paragraph",
                  "text": "Multiple interlocking teeth at the tip."
                },
                {
                  "type": "paragraph",
                  "text": "Model identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“This is an Allis tissue forceps, a ratcheted, toothed instrument used to grasp and hold suitable tissues during surgery. Its characteristic feature is the multiple interlocking teeth at the tips.”"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "allis_tissue_forceps_subsection_3",
          "subsection_title": "Labelling of Allis forceps",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "allis_tissue_forceps_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/allis_tissue_forceps_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "The important parts to label are:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Finger rings"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Allow the operator to hold and control the instrument using the thumb and a finger."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/allis_tissue_forceps_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Ratchet"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Locks the jaws in a selected closed position without continuous hand pressure."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/allis_tissue_forceps_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Box joint"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The articulation point that allows the two halves to open and close."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/allis_tissue_forceps_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Shanks"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Transmit force from the handles to the jaws."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/allis_tissue_forceps_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "5. Jaws and interlocking teeth"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The working ends that engage tissue and provide a firm grip."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/allis_tissue_forceps_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "6. Tips"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The distal ends of the jaws that contact the tissue."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE tip: The multiple teeth at the distal end are the most useful identifying feature. Do not confuse the tips with the ratchet, which is near the handles."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "allis_tissue_forceps_subsection_4",
          "subsection_title": "Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "allis_tissue_forceps_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Allis forceps are available in different lengths, sizes and jaw configurations."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/allis_tissue_forceps_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "A. Straight Allis forceps"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The jaws follow a straight line."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: Grasping suitable tissue during superficial or open surgical procedures."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/allis_tissue_forceps_10.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Curved or angled variants"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The jaw profile is altered to improve access in selected operative fields."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: Tissue manipulation where the shape offers better access."
                },
                {
                  "type": "paragraph",
                  "text": "The exact jaw shape and tooth count depend on the particular model. Do not assume every Allis forceps has the same number of teeth."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "allis_tissue_forceps_subsection_5",
          "subsection_title": "Principles of use",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "allis_tissue_forceps_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The principle is to hold suitable tissue securely while allowing the surgeon to manipulate it for the intended operative step."
                },
                {
                  "type": "paragraph",
                  "text": "Identify the tissue to be grasped."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm that the tissue can tolerate a toothed, traumatic instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Position the jaws under direct vision."
                },
                {
                  "type": "paragraph",
                  "text": "Apply only the pressure needed to obtain a secure grip."
                },
                {
                  "type": "paragraph",
                  "text": "Engage the ratchet as appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid including nearby nerves, vessels or other vulnerable structures."
                },
                {
                  "type": "paragraph",
                  "text": "Release the grip when it is no longer needed."
                }
              ]
            },
            {
              "group_id": "allis_tissue_forceps_group_7",
              "group_title": "Important clinical distinction",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Allis forceps are not atraumatic. Their multiple teeth provide a firm grip but may cause puncture, crushing or tearing."
                },
                {
                  "type": "paragraph",
                  "text": "They are generally unsuitable for indiscriminate grasping of fragile hollow organs, delicate vessels or tissue that must remain intact and undamaged."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "allis_tissue_forceps_subsection_6",
          "subsection_title": "Uses and surgeries",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "allis_tissue_forceps_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Clinical setting",
                    "Application"
                  ],
                  "rows": [
                    [
                      "General surgery",
                      "Grasping suitable tissue during dissection"
                    ],
                    [
                      "Abdominal surgery",
                      "Holding selected tissue edges during operative manipulation"
                    ],
                    [
                      "Breast surgery",
                      "Grasping suitable tissue during selected procedures"
                    ],
                    [
                      "Gynaecological surgery",
                      "Holding appropriate tissue during selected operations"
                    ],
                    [
                      "Skin and superficial surgery",
                      "Grasping suitable tissue where a firm grip is required"
                    ],
                    [
                      "Tissue excision",
                      "Holding tissue that is being removed or manipulated"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The instrument is selected according to the tissue and procedure. Its secure grip is useful, but tissue trauma must be considered."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "allis_tissue_forceps_subsection_7",
          "subsection_title": "Advantages and disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "allis_tissue_forceps_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Advantages"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Multiple teeth provide a secure grip."
                },
                {
                  "type": "paragraph",
                  "text": "Reduces slippage when grasping suitable tissues."
                },
                {
                  "type": "paragraph",
                  "text": "Ratchet maintains the grip without continuous hand pressure."
                },
                {
                  "type": "paragraph",
                  "text": "Available in different sizes for different operative fields."
                },
                {
                  "type": "paragraph",
                  "text": "Useful for controlled tissue traction and manipulation."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Disadvantages"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Can puncture, crush or tear tissue."
                },
                {
                  "type": "paragraph",
                  "text": "May leave visible marks at the grasping site."
                },
                {
                  "type": "paragraph",
                  "text": "Unsuitable for many delicate structures."
                },
                {
                  "type": "paragraph",
                  "text": "Excessive or prolonged compression may worsen tissue injury."
                },
                {
                  "type": "paragraph",
                  "text": "May cause bleeding when applied traumatically."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "allis_tissue_forceps_subsection_8",
          "subsection_title": "Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "allis_tissue_forceps_group_10",
              "group_title": "Patient-related complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Puncture wounds at the grasping site."
                },
                {
                  "type": "paragraph",
                  "text": "Tissue crushing or tearing."
                },
                {
                  "type": "paragraph",
                  "text": "Bleeding due to traumatic grasping."
                },
                {
                  "type": "paragraph",
                  "text": "Damage to adjacent structures."
                },
                {
                  "type": "paragraph",
                  "text": "Local tissue injury from excessive compression."
                },
                {
                  "type": "paragraph",
                  "text": "Wound contamination or infection if aseptic technique is breached."
                }
              ]
            },
            {
              "group_id": "allis_tissue_forceps_group_11",
              "group_title": "Instrument-related problems",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Bent or damaged teeth."
                },
                {
                  "type": "paragraph",
                  "text": "Misaligned jaws."
                },
                {
                  "type": "paragraph",
                  "text": "Defective ratchet or box joint."
                },
                {
                  "type": "paragraph",
                  "text": "Stiff movement or difficulty releasing the tissue."
                },
                {
                  "type": "paragraph",
                  "text": "Corrosion or damage from inadequate reprocessing."
                },
                {
                  "type": "paragraph",
                  "text": "Before use, inspect the jaw alignment, tooth integrity, ratchet and joint."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "allis_tissue_forceps_subsection_9",
          "subsection_title": "Allis versus Kocher versus Babcock forceps",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "allis_tissue_forceps_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This is a particularly important OSCE comparison."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/allis_tissue_forceps_11.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Feature",
                    "Allis forceps",
                    "Kocher forceps",
                    "Babcock forceps"
                  ],
                  "rows": [
                    [
                      "Primary function",
                      "Grasping suitable tissue",
                      "Grasping suitable tough tissue",
                      "Atraumatic grasping of delicate tubular structures"
                    ],
                    [
                      "Jaw design",
                      "Multiple interlocking teeth",
                      "Usually prominent 1 × 2 teeth",
                      "Rounded, often fenestrated jaws"
                    ],
                    [
                      "Grip",
                      "Firm and traumatic",
                      "Firm and traumatic",
                      "Designed to minimise crushing"
                    ],
                    [
                      "Typical use",
                      "Suitable tissue traction",
                      "Suitable tough tissue traction",
                      "Bowel, appendix or other suitable delicate structures"
                    ],
                    [
                      "Key distinction",
                      "Multiple teeth",
                      "Prominent terminal teeth",
                      "Rounded, atraumatic jaws"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Memory aid:"
                },
                {
                  "type": "paragraph",
                  "text": "Allis: multiple teeth."
                },
                {
                  "type": "paragraph",
                  "text": "Kocher: prominent terminal tooth."
                },
                {
                  "type": "paragraph",
                  "text": "Babcock: gentle grasp for delicate tubular structures."
                },
                {
                  "type": "paragraph",
                  "text": "These instruments are not interchangeable simply because they all grasp tissue."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "allis_tissue_forceps_subsection_10",
          "subsection_title": "Common OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "allis_tissue_forceps_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. Identify this instrument."
                },
                {
                  "type": "paragraph",
                  "text": "This is an Allis tissue forceps, used to grasp and hold suitable tissues during surgery."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is its characteristic feature?"
                },
                {
                  "type": "paragraph",
                  "text": "Multiple interlocking teeth at the tips."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What is the function of the ratchet?"
                },
                {
                  "type": "paragraph",
                  "text": "It maintains jaw closure without continuous hand pressure."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. Is Allis forceps traumatic or atraumatic?"
                },
                {
                  "type": "paragraph",
                  "text": "Traumatic, because its teeth may puncture or damage tissue."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. How does it differ from Babcock forceps?"
                },
                {
                  "type": "paragraph",
                  "text": "Allis forceps have toothed jaws for a firm grip, whereas Babcock forceps have rounded, usually fenestrated jaws designed for more atraumatic handling."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What are the complications?"
                },
                {
                  "type": "paragraph",
                  "text": "Tissue puncture, crushing, tearing, bleeding and injury to adjacent structures."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What should you inspect before use?"
                },
                {
                  "type": "paragraph",
                  "text": "Tooth integrity, jaw alignment, ratchet function, joint integrity and overall condition."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "allis_tissue_forceps_subsection_11",
          "subsection_title": "High-yield revision card",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "allis_tissue_forceps_group_14",
              "group_title": "Allis forceps — must know",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Category: Tissue-holding instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Identifying feature: Multiple interlocking teeth."
                },
                {
                  "type": "paragraph",
                  "text": "Construction: Finger rings, ratchet, box joint and toothed jaws."
                },
                {
                  "type": "paragraph",
                  "text": "Primary use: Grasping suitable tissues securely."
                },
                {
                  "type": "paragraph",
                  "text": "Major disadvantage: Tissue trauma."
                },
                {
                  "type": "paragraph",
                  "text": "Key comparison: Babcock forceps are designed for more atraumatic grasping."
                },
                {
                  "type": "paragraph",
                  "text": "Safety principle: Do not use on delicate structures that may be damaged by toothed grasping."
                }
              ]
            },
            {
              "group_id": "allis_tissue_forceps_group_15",
              "group_title": "Model 30-second OSCE presentation",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is an Allis tissue forceps, a ratcheted surgical instrument used to grasp and hold suitable tissues during surgery. It consists of finger rings, a ratchet, shanks, a box joint and multiple interlocking teeth at the tips. Its main advantage is a secure grip, but it is a traumatic instrument that may cause puncture, crushing or tearing. I would select it only for suitable tissues, inspect the teeth and locking mechanism, and avoid using it indiscriminately on delicate structures.”"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}