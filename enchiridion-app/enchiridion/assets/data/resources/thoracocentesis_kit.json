      "section_id": "thoracocentesis_kit_section_1",
      "section_title": "Thoracocentesis kit",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "thoracocentesis_kit_subsection_1",
          "subsection_title": "Thoracocentesis Kit (Pleural Aspiration Kit)",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "thoracocentesis_kit_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/thoracocentesis_kit_01.webp",
                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "thoracocentesis_kit_subsection_2",
          "subsection_title": "Identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "thoracocentesis_kit_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A thoracocentesis kit, also called a thoracentesis or pleural aspiration kit, contains the equipment needed to aspirate air or fluid from the pleural space using a needle or catheter."
                },
                {
                  "type": "paragraph",
                  "text": "The procedure is commonly performed to investigate or relieve a pleural effusion. Ultrasound guidance is recommended for pleural fluid aspiration because it helps identify a suitable site and reduces complications."
                },
                {
                  "type": "paragraph",
                  "text": "Classification: Invasive diagnostic and therapeutic procedure equipment."
                },
                {
                  "type": "paragraph",
                  "text": "Principle: Accessing the pleural space with a needle or catheter to remove fluid, or in selected circumstances air."
                },
                {
                  "type": "paragraph",
                  "text": "Common indications: Diagnostic sampling of pleural effusion and therapeutic drainage of symptomatic pleural fluid."
                },
                {
                  "type": "paragraph",
                  "text": "Key identifying features: Sterile needle or catheter, syringe, tubing and often a three-way stopcock or drainage collection system."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE distinction: Thoracocentesis is pleural aspiration. A chest drain is generally used when ongoing or continuous drainage is required."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "thoracocentesis_kit_subsection_3",
          "subsection_title": "Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "thoracocentesis_kit_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Diagnostic aspiration: Obtaining pleural fluid for laboratory analysis to investigate infection, malignancy or other causes of effusion."
                },
                {
                  "type": "paragraph",
                  "text": "Therapeutic aspiration: Relieving breathlessness caused by a suitable pleural effusion."
                },
                {
                  "type": "paragraph",
                  "text": "Pleural fluid assessment: Obtaining samples for cell count, biochemistry, microbiology and other tests as clinically indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Selected air aspiration: In particular circumstances, aspiration may be considered for pneumothorax under an appropriate protocol, although needle aspiration is not suitable for every patient or situation."
                },
                {
                  "type": "paragraph",
                  "text": "The choice of procedure depends on the underlying condition, the size and location of the collection, patient stability and local guidance."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "thoracocentesis_kit_subsection_4",
          "subsection_title": "Parts and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "thoracocentesis_kit_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/thoracocentesis_kit_02.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "A. Needle or catheter"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Provides access to the pleural space. Catheter-based systems allow aspiration while reducing the need to leave a rigid needle in place."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/thoracocentesis_kit_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Syringe"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Aspirates pleural fluid and may be used to collect a diagnostic sample."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/thoracocentesis_kit_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "C. Three-way stopcock and connecting tubing"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Direct fluid flow between the patient, syringe and collection system. The stopcock controls which pathway is open."
                },
                {
                  "type": "checklist",
                  "items": [
                    "D. Specimen containers"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Collect samples for laboratory investigations. The required containers depend on the requested tests."
                },
                {
                  "type": "checklist",
                  "items": [
                    "E. Sterile preparation materials"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Include sterile gloves, drapes, skin antiseptic, gauze and dressings to support aseptic technique."
                },
                {
                  "type": "checklist",
                  "items": [
                    "F. Ultrasound equipment"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Helps identify the fluid collection, diaphragm, lung and nearby structures, and guides selection of a safe aspiration site."
                },
                {
                  "type": "paragraph",
                  "text": "Note: The exact contents vary between manufacturers and kits."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "thoracocentesis_kit_subsection_5",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "thoracocentesis_kit_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Provides diagnostic material to help establish the cause of pleural effusion."
                },
                {
                  "type": "paragraph",
                  "text": "Can relieve breathlessness associated with symptomatic fluid accumulation."
                },
                {
                  "type": "paragraph",
                  "text": "Usually requires less equipment than a continuous drainage system."
                },
                {
                  "type": "paragraph",
                  "text": "Ultrasound guidance improves site selection and procedural safety."
                },
                {
                  "type": "paragraph",
                  "text": "Catheter-based systems can facilitate controlled aspiration."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "thoracocentesis_kit_subsection_6",
          "subsection_title": "Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "thoracocentesis_kit_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "It is an invasive procedure with risks of bleeding, infection and organ injury."
                },
                {
                  "type": "paragraph",
                  "text": "Pneumothorax can occur despite appropriate technique."
                },
                {
                  "type": "paragraph",
                  "text": "Small or loculated effusions may be difficult to access."
                },
                {
                  "type": "paragraph",
                  "text": "A single aspiration may not adequately manage recurrent or continuously accumulating fluid."
                },
                {
                  "type": "paragraph",
                  "text": "The procedure may be unsuitable for some patients because of anatomy, clinical instability or bleeding risk."
                },
                {
                  "type": "paragraph",
                  "text": "Laboratory analysis may not identify the underlying cause, requiring further investigation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "thoracocentesis_kit_subsection_7",
          "subsection_title": "Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "thoracocentesis_kit_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Before the procedure, the clinician should:"
                },
                {
                  "type": "paragraph",
                  "text": "Confirm the indication and review relevant imaging."
                },
                {
                  "type": "paragraph",
                  "text": "Explain the procedure, benefits, risks and alternatives, and obtain informed consent."
                },
                {
                  "type": "paragraph",
                  "text": "Check relevant allergies, medication history, bleeding risk and clinical stability."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm that ultrasound is available and use it to identify a suitable site."
                },
                {
                  "type": "paragraph",
                  "text": "Check the kit’s integrity, sterility and expiry date."
                },
                {
                  "type": "paragraph",
                  "text": "Prepare the patient in an appropriate position, commonly sitting upright and leaning forward when tolerated."
                },
                {
                  "type": "paragraph",
                  "text": "Use appropriate skin antisepsis, sterile gloves and draping."
                },
                {
                  "type": "paragraph",
                  "text": "Arrange specimen containers and confirm the laboratory tests required."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure that monitoring and appropriate support are available for the patient’s condition."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Important safety points"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Pleural aspiration should be performed by a trained clinician using the appropriate local protocol."
                },
                {
                  "type": "paragraph",
                  "text": "Ultrasound guidance is recommended for pleural fluid aspiration; blind landmark-based site selection should not be substituted for appropriate imaging."
                },
                {
                  "type": "paragraph",
                  "text": "The puncture site must be selected with attention to the diaphragm, lung and nearby organs."
                },
                {
                  "type": "paragraph",
                  "text": "Drain fluid in a controlled manner. Stop if the patient develops concerning symptoms such as chest pain, chest tightness, persistent cough or worsening breathlessness."
                },
                {
                  "type": "paragraph",
                  "text": "The volume removed should follow the applicable guideline and clinical circumstances. Many guidelines advise stopping after approximately 1.5 litres in a single attempt unless a specialist protocol supports a different approach with appropriate monitoring."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "thoracocentesis_kit_subsection_8",
          "subsection_title": "How to use it — step-by-step OSCE demonstration",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "thoracocentesis_kit_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Step 1: Confirm and explain"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Confirm the patient’s identity, indication and relevant imaging. Explain the procedure, obtain consent and assess baseline observations."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/thoracocentesis_kit_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 2: Position the patient"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Position the patient to provide safe access to the selected pleural collection. An upright, forward-leaning position is commonly used if tolerated."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/thoracocentesis_kit_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 3: Identify a safe site"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Use thoracic ultrasound to locate the fluid and identify relevant structures. Confirm a suitable site and follow the local protocol."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/thoracocentesis_kit_01.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 4: Prepare the sterile field"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Perform hand hygiene, prepare the skin with the recommended antiseptic, use sterile equipment and drape the area. Provide local anaesthesia as appropriate."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/thoracocentesis_kit_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 5: Aspirate under appropriate guidance"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A trained clinician introduces the needle or catheter using the selected technique and aspirates the fluid in a controlled manner, observing the patient throughout."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/thoracocentesis_kit_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 6: Collect and label samples"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Place the required samples in appropriate containers, label them correctly and send them for the requested investigations. Therapeutic aspiration may also require a suitable collection system."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/thoracocentesis_kit_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 7: Complete and monitor"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Remove the equipment safely, apply a dressing and reassess the patient. Document the volume and appearance of fluid, symptoms, complications and follow-up plan."
                }
              ]
            },
            {
              "group_id": "thoracocentesis_kit_group_9",
              "group_title": "What should be documented?",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Indication and consent."
                },
                {
                  "type": "paragraph",
                  "text": "Ultrasound findings and selected site."
                },
                {
                  "type": "paragraph",
                  "text": "Procedure details and any difficulties."
                },
                {
                  "type": "paragraph",
                  "text": "Volume and appearance of aspirated fluid."
                },
                {
                  "type": "paragraph",
                  "text": "Specimens collected and tests requested."
                },
                {
                  "type": "paragraph",
                  "text": "Patient tolerance, observations and any complications."
                },
                {
                  "type": "paragraph",
                  "text": "Follow-up imaging or other assessment when clinically indicated."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "thoracocentesis_kit_subsection_9",
          "subsection_title": "Contraindications and complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "thoracocentesis_kit_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Contraindications are often relative and depend on the urgency of the procedure, anatomy and patient condition. Examples requiring particular assessment include an inaccessible or very small collection, infection at the proposed puncture site, uncorrected significant bleeding risk and inability to cooperate safely."
                },
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Key features"
                  ],
                  "rows": [
                    [
                      "Pneumothorax",
                      "New breathlessness, chest pain or reduced oxygen saturation"
                    ],
                    [
                      "Bleeding or haemothorax",
                      "Increasing pain, haemodynamic instability or evidence of internal bleeding"
                    ],
                    [
                      "Infection",
                      "Fever or local signs of infection"
                    ],
                    [
                      "Organ injury",
                      "Potential injury to the lung, diaphragm, liver or spleen"
                    ],
                    [
                      "Re-expansion pulmonary oedema",
                      "New respiratory distress or hypoxaemia after fluid removal"
                    ],
                    [
                      "Vasovagal reaction",
                      "Pallor, sweating, nausea, dizziness or hypotension"
                    ],
                    [
                      "Incomplete aspiration",
                      "Persistent fluid due to loculation, poor access or another technical limitation"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "New or worsening breathlessness, hypoxaemia, chest pain or haemodynamic instability after aspiration requires urgent clinical assessment."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "thoracocentesis_kit_subsection_10",
          "subsection_title": "Normal and abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "thoracocentesis_kit_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Thoracocentesis provides a fluid sample and may relieve symptoms; it does not itself generate a single normal or abnormal reading."
                },
                {
                  "type": "table",
                  "columns": [
                    "Finding",
                    "Possible interpretation"
                  ],
                  "rows": [
                    [
                      "Straw-coloured fluid",
                      "May occur with several types of effusion; appearance alone is not diagnostic."
                    ],
                    [
                      "Turbid or purulent fluid",
                      "Raises concern for pleural infection or empyema."
                    ],
                    [
                      "Bloody fluid",
                      "May occur with malignancy, trauma, pulmonary embolism or haemothorax; interpretation depends on context."
                    ],
                    [
                      "Milky fluid",
                      "May suggest chylothorax, requiring appropriate laboratory analysis."
                    ],
                    [
                      "Persistent breathlessness after aspiration",
                      "May reflect residual fluid, lung disease, a complication or another cause."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "OSCE reporting example:"
                },
                {
                  "type": "paragraph",
                  "text": "“Pleural aspiration yielded approximately 500 mL of straw-coloured fluid. The specimen was labelled and sent for the indicated investigations. The patient’s respiratory status was reassessed after the procedure. The cause of the effusion would be determined from the clinical context, fluid analysis and any further investigations.”"
                },
                {
                  "type": "paragraph",
                  "text": "The volume in this example is illustrative, not a recommended target."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "thoracocentesis_kit_subsection_11",
          "subsection_title": "Pediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "thoracocentesis_kit_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The procedure requires particular care because children have smaller anatomical margins and may deteriorate rapidly."
                },
                {
                  "type": "paragraph",
                  "text": "Use age-appropriate equipment and ultrasound guidance."
                },
                {
                  "type": "paragraph",
                  "text": "Involve a clinician experienced in pediatric pleural procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Provide appropriate analgesia, explanation and monitoring."
                },
                {
                  "type": "paragraph",
                  "text": "Interpret the volume and appearance of aspirated fluid according to the child’s size and condition."
                },
                {
                  "type": "paragraph",
                  "text": "Use pediatric-specific fluid investigation and management protocols."
                },
                {
                  "type": "paragraph",
                  "text": "Reassess respiratory status promptly and monitor for pneumothorax, bleeding and other complications."
                }
              ]
            }
          ]
        },
