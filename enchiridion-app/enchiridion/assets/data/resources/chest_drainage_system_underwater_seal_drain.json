  "sections": [
    {
      "section_id": "chest_drainage_system_underwater_seal_drain_section_1",
      "section_title": "Chest drainage system (underwater seal drain)",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "chest_drainage_system_underwater_seal_drain_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/chest_drainage_system_underwater_seal_drain_01.webp",
                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drainage_system_underwater_seal_drain_subsection_2",
          "subsection_title": "Identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A chest drainage system, commonly called an underwater seal drain (UWSD), is a closed drainage apparatus connected to a chest tube to remove air, blood, pus or other fluid from the pleural cavity."
                },
                {
                  "type": "paragraph",
                  "text": "Its purpose is to help restore the normal negative pressure relationship between the pleural cavity and the lung, allowing the lung to re-expand when the underlying condition permits."
                },
                {
                  "type": "paragraph",
                  "text": "Classification: Thoracic drainage and respiratory support equipment."
                },
                {
                  "type": "paragraph",
                  "text": "Principle: A one-way water seal permits air to escape from the pleural space while preventing atmospheric air from flowing back into the chest."
                },
                {
                  "type": "paragraph",
                  "text": "Common indications: Pneumothorax, haemothorax, pleural effusion and empyema, depending on the clinical situation."
                },
                {
                  "type": "paragraph",
                  "text": "Key identifying features: Drainage tubing, a collection chamber and a water-seal chamber; some systems also include a suction-control chamber."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drainage_system_underwater_seal_drain_subsection_3",
          "subsection_title": "Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Pneumothorax: Evacuation of air from the pleural space."
                },
                {
                  "type": "paragraph",
                  "text": "Haemothorax: Drainage of blood following trauma or another cause."
                },
                {
                  "type": "paragraph",
                  "text": "Pleural effusion: Drainage of pleural fluid when chest-tube drainage is indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Empyema: Drainage of infected pleural fluid as part of appropriate treatment."
                },
                {
                  "type": "paragraph",
                  "text": "Postoperative thoracic care: Drainage of air and fluid following selected thoracic or cardiac procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Monitoring: Assessment of drainage volume, character and trends, as well as relevant air-leak indicators."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE distinction: The chest tube enters the pleural space; the underwater seal drainage system remains outside the patient and connects to the tube."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drainage_system_underwater_seal_drain_subsection_4",
          "subsection_title": "Parts and functions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/chest_drainage_system_underwater_seal_drain_02.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "A. Collection chamber"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Collects drained blood, fluid or other pleural contents. Graduated markings allow measurement of drainage volume."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/chest_drainage_system_underwater_seal_drain_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "B. Water-seal chamber"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Acts as a one-way valve. It allows air to leave the pleural space while preventing atmospheric air from returning through the drainage system."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/chest_drainage_system_underwater_seal_drain_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "C. Suction-control chamber"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Present in some systems. In a traditional wet-suction system, the prescribed water level helps regulate suction. Dry-suction systems use a mechanical regulator instead."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/chest_drainage_system_underwater_seal_drain_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "D. Connecting tubing"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Carries air and fluid from the chest tube to the drainage unit. It should remain securely connected and free from kinks or obstruction."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/chest_drainage_system_underwater_seal_drain_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "E. Stand or hanger"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Keeps the drainage unit upright and below the level of the patient’s chest, reducing the risk of backflow."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drainage_system_underwater_seal_drain_subsection_5",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Provides continuous drainage of air and fluid."
                },
                {
                  "type": "paragraph",
                  "text": "The water seal reduces the risk of air re-entering the pleural space through the drain."
                },
                {
                  "type": "paragraph",
                  "text": "Allows monitoring of fluid volume and appearance."
                },
                {
                  "type": "paragraph",
                  "text": "Water-seal movement and bubbling may provide useful information about respiratory mechanics and air leaks."
                },
                {
                  "type": "paragraph",
                  "text": "Can facilitate lung re-expansion when drainage is effective and the underlying condition allows."
                },
                {
                  "type": "paragraph",
                  "text": "Portable systems can allow patient mobility when clinically appropriate."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drainage_system_underwater_seal_drain_subsection_6",
          "subsection_title": "Disadvantages and limitations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Incorrect setup can compromise drainage or allow air to enter the pleural space."
                },
                {
                  "type": "paragraph",
                  "text": "Tubing may kink, become blocked or become disconnected."
                },
                {
                  "type": "paragraph",
                  "text": "Infection, bleeding, pain and organ injury can occur from chest-tube insertion or maintenance."
                },
                {
                  "type": "paragraph",
                  "text": "Excessive or inappropriate suction may be harmful."
                },
                {
                  "type": "paragraph",
                  "text": "Drainage volume alone does not establish whether the lung has re-expanded."
                },
                {
                  "type": "paragraph",
                  "text": "Bubbling and fluid movement must be interpreted in context; neither finding alone confirms that the drain is functioning correctly."
                },
                {
                  "type": "paragraph",
                  "text": "The system requires regular observation and appropriate documentation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drainage_system_underwater_seal_drain_subsection_7",
          "subsection_title": "Preparation and precautions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Before handling or checking the system:"
                },
                {
                  "type": "paragraph",
                  "text": "Perform hand hygiene and use appropriate personal protective equipment."
                },
                {
                  "type": "paragraph",
                  "text": "Explain the procedure to the patient where possible."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm the prescribed drainage arrangement and whether suction is required."
                },
                {
                  "type": "paragraph",
                  "text": "Check the integrity of the unit, connections and tubing."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure the unit is upright and below chest level."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm the water-seal and suction settings against the manufacturer’s instructions and prescription."
                },
                {
                  "type": "paragraph",
                  "text": "Assess the patient’s respiratory rate, oxygen saturation, work of breathing, chest movement and haemodynamic status."
                },
                {
                  "type": "paragraph",
                  "text": "Check the insertion site and dressing for bleeding, leakage, infection or displacement."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Critical safety precautions"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Do not routinely clamp a chest drain. Clamping can trap air and precipitate or worsen a tension pneumothorax, particularly when an air leak is present."
                },
                {
                  "type": "paragraph",
                  "text": "Do not routinely strip or aggressively milk the tubing; these actions may generate excessive negative pressure and should only be performed under a specific protocol."
                },
                {
                  "type": "paragraph",
                  "text": "Do not lift the collection unit above chest level."
                },
                {
                  "type": "paragraph",
                  "text": "Do not disconnect the system casually or manipulate the tube without appropriate clinical justification."
                },
                {
                  "type": "paragraph",
                  "text": "If the patient deteriorates, assess the patient immediately and escalate urgently rather than focusing only on the apparatus."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drainage_system_underwater_seal_drain_subsection_8",
          "subsection_title": "How to use it — step-by-step OSCE demonstration",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This is a guide to demonstrating the equipment and checking an established drain. Insertion of a chest tube is a separate invasive procedure performed by appropriately trained clinicians."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 1: Introduce and assess"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Introduce yourself, confirm the patient’s identity, explain your assessment and obtain consent if possible. Assess the patient’s respiratory and haemodynamic status."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/chest_drainage_system_underwater_seal_drain_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 2: Inspect the drainage unit"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Identify the collection chamber, water seal and suction-control mechanism if present. Confirm that the unit is upright and configured according to the manufacturer’s instructions."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/chest_drainage_system_underwater_seal_drain_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 3: Check the tubing"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Trace the tubing from the patient to the unit. Look for disconnections, kinks, dependent loops, compression or visible obstruction. Do not manipulate the tube unnecessarily."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 4: Observe the water seal"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Look for respiratory fluctuation, sometimes called tidaling. Bubbling may occur when air is escaping through the system. Interpret these findings according to the clinical context and drain type."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 5: Measure the drainage"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Record the volume, colour and character of the drainage and compare it with previous observations. Escalate sudden large-volume drainage or fresh blood according to the clinical situation and local protocol."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 6: Inspect the patient and insertion site"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Assess the dressing, surrounding skin, respiratory effort, chest movement and oxygen saturation. Look for signs of infection, subcutaneous emphysema or worsening pneumothorax."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/instrumentation/chest_drainage_system_underwater_seal_drain_09.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Step 7: Document and escalate"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Record the observations, drainage output, water-seal findings, suction settings where applicable and the patient’s clinical condition. Escalate any abnormal findings promptly."
                }
              ]
            },
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_9",
              "group_title": "Interpreting the water seal",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Finding",
                    "Possible interpretation"
                  ],
                  "rows": [
                    [
                      "Fluid level fluctuates with respiration",
                      "Respiratory transmission of pressure changes; may be expected in a patent system."
                    ],
                    [
                      "Intermittent bubbling",
                      "May occur as air escapes, particularly with pneumothorax."
                    ],
                    [
                      "Continuous bubbling in the water seal",
                      "May indicate an ongoing air leak from the patient or a leak in the system; assess promptly."
                    ],
                    [
                      "No fluctuation",
                      "May occur after lung re-expansion or with certain drainage systems, but may also reflect obstruction, kinking or disconnection."
                    ],
                    [
                      "Sudden cessation of previously observed bubbling",
                      "May indicate that the leak has resolved, but obstruction or another system problem must also be considered."
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Examiner’s point: Never interpret a single observation in isolation. Assess the patient first and check the entire drainage system."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drainage_system_underwater_seal_drain_subsection_9",
          "subsection_title": "Contraindications and complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The drainage system itself has no simple universal contraindication; the decision to insert a chest tube depends on the underlying condition and clinical circumstances."
                },
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Recognition"
                  ],
                  "rows": [
                    [
                      "Tube blockage or kinking",
                      "Reduced drainage, altered water-seal behaviour or clinical deterioration"
                    ],
                    [
                      "Disconnection or system leak",
                      "Loss of system integrity, possible air entry"
                    ],
                    [
                      "Tube displacement",
                      "Change in external tube position, leakage or reduced effectiveness"
                    ],
                    [
                      "Infection",
                      "Fever, erythema, discharge or increasing local pain"
                    ],
                    [
                      "Bleeding",
                      "Fresh blood, rapidly increasing output or haemodynamic instability"
                    ],
                    [
                      "Subcutaneous emphysema",
                      "Crackling sensation under the skin"
                    ],
                    [
                      "Tension pneumothorax",
                      "Sudden respiratory or cardiovascular deterioration; an emergency"
                    ],
                    [
                      "Re-expansion pulmonary oedema",
                      "New respiratory distress and hypoxaemia after re-expansion in susceptible patients"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Large or rapidly increasing bloody drainage, sudden respiratory deterioration, suspected tension pneumothorax or major system disruption requires immediate clinical assessment and escalation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drainage_system_underwater_seal_drain_subsection_10",
          "subsection_title": "Normal and abnormal findings",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Potentially reassuring findings"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Secure connections and patent, unkinked tubing."
                },
                {
                  "type": "paragraph",
                  "text": "Drainage consistent with the patient’s condition and clinical trajectory."
                },
                {
                  "type": "paragraph",
                  "text": "Appropriate water-seal and suction settings."
                },
                {
                  "type": "paragraph",
                  "text": "Respiratory findings and oxygenation that are stable or improving."
                },
                {
                  "type": "paragraph",
                  "text": "No new signs of infection, bleeding or subcutaneous emphysema."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Concerning findings"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Sudden increase in fresh blood drainage."
                },
                {
                  "type": "paragraph",
                  "text": "New or worsening breathlessness, hypoxaemia or haemodynamic instability."
                },
                {
                  "type": "paragraph",
                  "text": "Continuous water-seal bubbling suggesting an air leak."
                },
                {
                  "type": "paragraph",
                  "text": "Sudden cessation of drainage when obstruction is suspected."
                },
                {
                  "type": "paragraph",
                  "text": "Disconnection, displacement or a damaged drainage unit."
                },
                {
                  "type": "paragraph",
                  "text": "New subcutaneous emphysema or signs of infection."
                }
              ]
            },
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_12",
              "group_title": "Example of OSCE reporting",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“The patient has a chest drain connected to an underwater seal drainage system. The unit is upright and below chest level, and the tubing is connected without visible kinking. I would assess the water-seal behaviour, prescribed suction settings and drainage volume and character, then correlate these findings with the patient’s respiratory status. I would escalate any suspected air leak, obstruction, bleeding or clinical deterioration.”"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drainage_system_underwater_seal_drain_subsection_11",
          "subsection_title": "Pediatric considerations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Use appropriately sized chest tubes and drainage equipment for the child’s clinical indication and body size."
                },
                {
                  "type": "paragraph",
                  "text": "Secure the tube carefully because children may inadvertently pull or displace it."
                },
                {
                  "type": "paragraph",
                  "text": "Provide age-appropriate pain relief and explain the equipment to the child and caregiver."
                },
                {
                  "type": "paragraph",
                  "text": "Monitor respiratory status closely; children may deteriorate rapidly."
                },
                {
                  "type": "paragraph",
                  "text": "Record drainage carefully and interpret output according to the child’s size, condition and clinical trajectory."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure any suction setting is specifically prescribed and appropriate for the patient and device."
                },
                {
                  "type": "paragraph",
                  "text": "If a drain becomes disconnected or displaced, follow the emergency protocol and obtain urgent senior assistance. Do not improvise a repair or clamp the tube without appropriate direction."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drainage_system_underwater_seal_drain_subsection_12",
          "subsection_title": "D",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Drainage"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Measure and describe the output."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drainage_system_underwater_seal_drain_subsection_13",
          "subsection_title": "R",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Respiratory status"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Assess breathing, oxygenation and clinical stability."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drainage_system_underwater_seal_drain_subsection_14",
          "subsection_title": "A",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Air leak"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Observe bubbling and investigate unexpected changes."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drainage_system_underwater_seal_drain_subsection_15",
          "subsection_title": "I",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Integrity"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Check the tubing, connections and insertion site."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drainage_system_underwater_seal_drain_subsection_16",
          "subsection_title": "N",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drainage_system_underwater_seal_drain_group_18",
