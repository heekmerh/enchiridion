  "sections": [
    {
      "section_id": "chest_drain_bottle_section_1",
      "section_title": "Chest drain bottle",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "chest_drain_bottle_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drain_bottle_group_1",
              "group_title": "Chest Drain Bottle / Underwater Seal Drainage System",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": []
            }
          ]
        },
        {
          "subsection_id": "chest_drain_bottle_subsection_2",
          "subsection_title": "1. Introduction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drain_bottle_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A chest drain bottle is a component of an underwater seal drainage system used to drain air, blood, pus, or other fluid from the pleural cavity while preventing atmospheric air from flowing back into the chest."
                },
                {
                  "type": "paragraph",
                  "text": "It is connected to an intercostal chest drain (chest tube) inserted into the pleural space."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/chest_drain_bottle_01.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/chest_drain_bottle_02.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/chest_drain_bottle_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Common indications for chest drainage"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Pneumothorax — air in the pleural cavity.",
                      "level": 0
                    },
                    {
                      "text": "Haemothorax — blood in the pleural cavity.",
                      "level": 0
                    },
                    {
                      "text": "Pleural effusion — fluid in the pleural cavity.",
                      "level": 0
                    },
                    {
                      "text": "Empyema — infected pleural fluid or pus.",
                      "level": 0
                    },
                    {
                      "text": "Post-thoracic surgery drainage.",
                      "level": 0
                    },
                    {
                      "text": "Selected cases of chylothorax.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“This is a chest drainage bottle, also known as an underwater seal drainage system. It is used to drain air or fluid from the pleural cavity and prevent backflow of air into the pleural space.”",
                  "style": "quote"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drain_bottle_subsection_3",
          "subsection_title": "2. Principle of operation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drain_bottle_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The key principle is the one-way valve effect of an underwater seal."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/chest_drain_bottle_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Water seal"
                },
                {
                  "type": "paragraph",
                  "text": "The distal end of the drainage tubing is submerged in sterile water, commonly to the manufacturer-indicated depth (often approximately 2 cm). Air can bubble out through the water, but atmospheric air is prevented from freely travelling backward into the pleural cavity."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/chest_drain_bottle_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Collection chamber"
                },
                {
                  "type": "paragraph",
                  "text": "Receives and measures drained blood, fluid, or pus. Graduations help clinicians assess the volume and rate of drainage."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/chest_drain_bottle_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Suction control chamber"
                },
                {
                  "type": "paragraph",
                  "text": "Present in some systems to regulate applied suction. In wet-suction systems, the specified water level helps determine the suction pressure; the wall suction setting is adjusted according to the device and prescription."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drain_bottle_subsection_4",
          "subsection_title": "3. Types and classification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drain_bottle_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Type",
                    "Features",
                    "Key point"
                  ],
                  "rows": [
                    [
                      "One-bottle system",
                      "Collection and water seal combined",
                      "Simple, but collection can affect the seal"
                    ],
                    [
                      "Two-bottle system",
                      "Separate collection and water-seal bottles",
                      "Separates fluid collection from the seal"
                    ],
                    [
                      "Three-bottle system",
                      "Collection, water seal and suction control separated",
                      "Classic teaching model"
                    ],
                    [
                      "Disposable multi-chamber system",
                      "Integrated chambers in a single unit",
                      "Common in clinical practice"
                    ],
                    [
                      "Dry-suction system",
                      "Uses a mechanical regulator rather than a water column to control suction",
                      "Follow device-specific indicators"
                    ],
                    [
                      "Heimlich/flutter valve",
                      "Portable one-way valve, usually for selected air-leak cases",
                      "Not a conventional bottle system"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "High-yield distinction: The number of physical bottles is not necessarily the number of functional chambers. Modern disposable systems may combine several chambers in one unit."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drain_bottle_subsection_5",
          "subsection_title": "4. Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drain_bottle_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "At an OSCE station, you may be asked to label the system or identify its components."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/chest_drain_bottle_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "commons.wikimedia.org"
                },
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Function"
                  ],
                  "rows": [
                    [
                      "Patient connector",
                      "Connects to the intercostal chest drain tubing"
                    ],
                    [
                      "Connecting tubing",
                      "Carries air and fluid from the patient to the drainage unit"
                    ],
                    [
                      "Collection chamber",
                      "Collects and measures drainage"
                    ],
                    [
                      "Graduated markings",
                      "Allow measurement of drainage volume"
                    ],
                    [
                      "Water-seal chamber",
                      "Provides the one-way valve mechanism"
                    ],
                    [
                      "Suction-control chamber or regulator",
                      "Controls suction in systems designed for suction"
                    ],
                    [
                      "Suction port",
                      "Connects the unit to a prescribed suction source"
                    ],
                    [
                      "Air-leak indicator",
                      "Helps detect air passing through the water seal"
                    ],
                    [
                      "Drainage outlet or sampling port",
                      "Allows drainage handling or sampling where the device provides one"
                    ],
                    [
                      "Vent or atmospheric outlet",
                      "Allows air to escape from the system as designed"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The precise layout varies between manufacturers. Always identify components using the markings and instructions on the actual device."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drain_bottle_subsection_6",
          "subsection_title": "5. How the system works physiologically",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drain_bottle_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Normally, the pleural space maintains a pressure relationship that helps keep the lungs expanded. Air or excess fluid in this space can interfere with lung expansion."
                },
                {
                  "type": "paragraph",
                  "text": "The chest drain provides a route for air or fluid to leave the pleural cavity."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "During expiration or coughing: Air may be expelled through the drain, depending on the patient's condition and the system.",
                      "level": 0
                    },
                    {
                      "text": "During inspiration: Pressure changes may cause movement of the water column, known as swinging or tidaling.",
                      "level": 0
                    },
                    {
                      "text": "With an air leak: Air may pass through the water seal and appear as bubbles.",
                      "level": 0
                    },
                    {
                      "text": "As the pneumothorax resolves: Bubbling may decrease or stop, and the water column may stop swinging.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "These observations must be interpreted together with the patient's condition, the drain's patency and the clinical indication. No single observation proves that the lung has fully re-expanded."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drain_bottle_subsection_7",
          "subsection_title": "6. Interpretation of bubbling and swinging",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drain_bottle_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "This is one of the most frequently tested aspects of the chest drainage system."
                },
                {
                  "type": "table",
                  "columns": [
                    "Observation",
                    "Possible interpretation",
                    "What to check"
                  ],
                  "rows": [
                    [
                      "Intermittent bubbling in water seal",
                      "Air escaping, for example during coughing or expiration in a pneumothorax",
                      "Clinical context and whether the air leak is expected"
                    ],
                    [
                      "Continuous bubbling in water seal",
                      "Persistent air leak from the patient or leakage in the drainage circuit",
                      "Connections, tubing and patient; inform the clinical team"
                    ],
                    [
                      "Swinging or tidaling of water column",
                      "Pressure changes transmitted through a patent system",
                      "Usually an expected observation"
                    ],
                    [
                      "Swinging stops",
                      "Lung re-expansion is one possibility; obstruction, kinking or disconnection are others",
                      "Inspect the entire system and assess the patient"
                    ],
                    [
                      "No drainage",
                      "May reflect resolution, or blockage/malposition",
                      "Assess symptoms, tubing and prescribed monitoring"
                    ],
                    [
                      "Bubbling in a wet suction-control chamber",
                      "May be expected when suction is operating",
                      "Check prescribed suction level and manufacturer guidance"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Exam trap: Do not automatically interpret cessation of swinging as a sign of recovery. A blocked or kinked tube can also stop the movement."
                },
                {
                  "type": "paragraph",
                  "text": "Another exam trap: Bubbling in the water-seal chamber is different from bubbling in a wet suction-control chamber. Bubbling in the latter may be normal during suction operation."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drain_bottle_subsection_8",
          "subsection_title": "7. Advantages and disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drain_bottle_group_8",
              "group_title": "Advantages",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Provides continuous drainage of air and fluid.",
                      "level": 0
                    },
                    {
                      "text": "The underwater seal helps prevent air from returning to the pleural space.",
                      "level": 0
                    },
                    {
                      "text": "Allows drainage volume to be monitored.",
                      "level": 0
                    },
                    {
                      "text": "Air leaks and changes in drainage can be observed.",
                      "level": 0
                    },
                    {
                      "text": "Can be connected to prescribed suction where indicated.",
                      "level": 0
                    },
                    {
                      "text": "Disposable systems are often portable and relatively straightforward to monitor.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "chest_drain_bottle_group_9",
              "group_title": "Disadvantages",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Incorrect setup can compromise drainage or permit air entry.",
                      "level": 0
                    },
                    {
                      "text": "The bottle or unit can tip over, spill or become disconnected.",
                      "level": 0
                    },
                    {
                      "text": "Tubing may kink, become obstructed or develop leaks.",
                      "level": 0
                    },
                    {
                      "text": "Conventional systems can restrict mobility.",
                      "level": 0
                    },
                    {
                      "text": "Drainage measurements can be inaccurate if the unit is tilted or handled incorrectly.",
                      "level": 0
                    },
                    {
                      "text": "Suction, if incorrectly set, may cause harm.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drain_bottle_subsection_9",
          "subsection_title": "8. Correct setup and bedside management",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drain_bottle_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "In an OSCE, describe the steps systematically."
                }
              ]
            },
            {
              "group_id": "chest_drain_bottle_group_11",
              "group_title": "OSCE practical checklist",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "0 of 10"
                },
                {
                  "type": "paragraph",
                  "text": "Perform hand hygiene and use appropriate PPE."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm the patient, indication, prescription and prescribed suction settings."
                },
                {
                  "type": "paragraph",
                  "text": "Check that the drainage unit is intact and appropriate for the intended use."
                },
                {
                  "type": "paragraph",
                  "text": "Prepare the system exactly as instructed by its manufacturer; fill the water-seal and wet-suction chambers to their specified levels if applicable."
                },
                {
                  "type": "paragraph",
                  "text": "Connect the patient's chest drain tubing securely using aseptic technique as appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Position the drainage unit upright and below chest level."
                },
                {
                  "type": "paragraph",
                  "text": "Ensure the tubing is not kinked, compressed, disconnected or trapped beneath the patient."
                },
                {
                  "type": "paragraph",
                  "text": "Check the prescribed suction connection and setting, if suction is ordered."
                },
                {
                  "type": "paragraph",
                  "text": "Observe and document drainage amount, colour, bubbling, swinging and any air leak."
                },
                {
                  "type": "paragraph",
                  "text": "Assess the patient's respiratory status, oxygen saturation, pain and overall clinical condition."
                },
                {
                  "type": "paragraph",
                  "text": "Important: A chest drainage unit should remain below chest level to reduce the risk of fluid flowing back toward the patient. Avoid unnecessary disconnection or clamping. Clamping can be dangerous, particularly in a patient with an ongoing air leak, because it may precipitate tension pneumothorax. Follow the responsible team's instructions and local protocol."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drain_bottle_subsection_10",
          "subsection_title": "9. Complications and troubleshooting",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drain_bottle_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Problem",
                    "Possible cause",
                    "Appropriate response"
                  ],
                  "rows": [
                    [
                      "Drainage stops unexpectedly",
                      "Kink, obstruction, displacement or resolution",
                      "Assess the patient, inspect tubing and obtain clinical review"
                    ],
                    [
                      "Sudden respiratory distress",
                      "Drain malfunction, worsening pneumothorax, tension pneumothorax or another complication",
                      "Emergency assessment and urgent escalation"
                    ],
                    [
                      "Persistent bubbling",
                      "Patient air leak or system leak",
                      "Check connections and tubing; escalate persistent leakage"
                    ],
                    [
                      "Bottle or unit tips over",
                      "Accidental movement",
                      "Restore the unit upright and follow the manufacturer's procedure to re-establish the seal if necessary"
                    ],
                    [
                      "Tube disconnects",
                      "Accidental disconnection",
                      "Call for urgent clinical assistance and follow the emergency reconnection protocol"
                    ],
                    [
                      "Tube comes out of the chest",
                      "Accidental displacement",
                      "Apply the locally recommended emergency dressing, obtain urgent assistance and assess breathing; do not reinsert blindly"
                    ],
                    [
                      "Excessive blood drainage",
                      "Ongoing haemorrhage",
                      "Urgent surgical review; assess haemodynamics and quantify drainage"
                    ],
                    [
                      "Drainage system cracks or breaks",
                      "Equipment damage",
                      "Urgently replace or manage the system according to local emergency protocol"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Do not routinely clamp a chest drain to troubleshoot bubbling, transport a patient or change a bottle unless specifically directed under an appropriate clinical protocol. Unplanned clamping in the presence of an air leak can be dangerous."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drain_bottle_subsection_11",
          "subsection_title": "10. Common OSCE viva questions and answers",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drain_bottle_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is the purpose of the water seal?"
                },
                {
                  "type": "paragraph",
                  "text": "To act as a one-way valve that allows air to escape from the pleural cavity while preventing atmospheric air from returning."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. Why is the drainage unit kept below chest level?"
                },
                {
                  "type": "paragraph",
                  "text": "To reduce the risk of backflow of drainage into the pleural cavity and to support effective drainage."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What does continuous bubbling in the water-seal chamber suggest?"
                },
                {
                  "type": "paragraph",
                  "text": "A continuing air leak, which may originate from the patient or from a leak in the drainage circuit. The system and patient must be assessed."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. What does swinging mean?"
                },
                {
                  "type": "paragraph",
                  "text": "Movement of the water column with respiratory pressure changes. It may indicate transmission of pressure through a patent system."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. Why might swinging stop?"
                },
                {
                  "type": "paragraph",
                  "text": "The lung may have re-expanded, but obstruction, kinking, disconnection or other system problems must also be considered."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. Why is suction applied?"
                },
                {
                  "type": "paragraph",
                  "text": "When clinically indicated, prescribed suction can assist evacuation of air or fluid and help achieve lung re-expansion. It is not required in every patient."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What is the difference between the water seal and suction-control chamber?"
                },
                {
                  "type": "paragraph",
                  "text": "The water seal prevents backflow of air. The suction-control chamber or regulator controls the suction applied to the drainage system."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. What should you do if the patient suddenly becomes breathless and the drain stops swinging?"
                },
                {
                  "type": "paragraph",
                  "text": "Immediately assess airway, breathing and circulation, check oxygen saturation and vital signs, summon urgent assistance, and inspect the system for kinking, obstruction or disconnection. Do not assume the lung has re-expanded."
                },
                {
                  "type": "paragraph",
                  "text": "Q9. Should a chest drain be routinely clamped before transport?"
                },
                {
                  "type": "paragraph",
                  "text": "No. Routine clamping is unsafe in many circumstances, particularly with an ongoing air leak. Follow the treating team's instructions and local protocol."
                },
                {
                  "type": "paragraph",
                  "text": "Q10. What should be documented?"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Drainage volume and rate.",
                      "level": 0
                    },
                    {
                      "text": "Drainage character, such as serous, bloody or purulent.",
                      "level": 0
                    },
                    {
                      "text": "Bubbling and swinging observations.",
                      "level": 0
                    },
                    {
                      "text": "Suction settings, if applicable.",
                      "level": 0
                    },
                    {
                      "text": "Tube and connection integrity.",
                      "level": 0
                    },
                    {
                      "text": "Patient's respiratory status, vital signs, symptoms and interventions.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "chest_drain_bottle_subsection_12",
          "subsection_title": "11. High-yield exam summary",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "chest_drain_bottle_group_14",
              "group_title": "Remember: “C-W-S”",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "**C**"
                },
                {
                  "type": "paragraph",
                  "text": "Collection"
                },
                {
                  "type": "paragraph",
                  "text": "Collects and measures the fluid or blood drained from the patient."
                }
              ]
            },
            {
              "group_id": "chest_drain_bottle_group_15",
              "group_title": "W",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Water seal"
                },
                {
                  "type": "paragraph",
                  "text": "One-way valve mechanism that prevents backflow of air."
                }
              ]
            },
            {
              "group_id": "chest_drain_bottle_group_16",
              "group_title": "S",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Suction control"
                },
                {
                  "type": "paragraph",
                  "text": "Regulates prescribed suction when the system is designed to provide it."
                },
                {
                  "type": "paragraph",
                  "text": "Must-know points"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Keep the unit upright and below chest level.",
                      "level": 0
                    },
                    {
                      "text": "Water-seal bubbling can indicate an air leak.",
                      "level": 0
                    },
                    {
                      "text": "Swinging reflects pressure changes, but its absence is not diagnostic by itself.",
                      "level": 0
                    },
                    {
                      "text": "Continuous bubbling in a wet suction chamber may be expected.",
                      "level": 0
                    },
                    {
                      "text": "Never ignore sudden respiratory deterioration or unexpectedly stopped drainage.",
                      "level": 0
                    },
                    {
                      "text": "Avoid routine clamping.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}