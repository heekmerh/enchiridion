      "section_id": "deaver_retractor_section_1",
      "section_title": "Deaver retractor",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "deaver_retractor_subsection_1",
          "subsection_title": "1. Introduction and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "deaver_retractor_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/deaver_retractor_01.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/deaver_retractor_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A Deaver retractor is a handheld, non-self-retaining surgical retractor with a long handle and a broad, deeply curved blade. It is used to retract and protect deep tissues and abdominal organs during surgery."
                },
                {
                  "type": "paragraph",
                  "text": "It is particularly useful when the surgeon needs to hold back the abdominal wall or gently displace organs to improve access to deeper structures."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“This is a Deaver retractor, a handheld surgical retractor with a long handle and a broad, curved blade. It is used for deep retraction, especially during abdominal and pelvic operations, to improve surgical exposure while protecting surrounding tissues.”",
                  "style": "quote"
                }
              ]
            },
            {
              "group_id": "deaver_retractor_group_2",
              "group_title": "Identification card",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Instrument class"
                },
                {
                  "type": "paragraph",
                  "text": "Handheld retractor"
                },
                {
                  "type": "paragraph",
                  "text": "Retraction"
                },
                {
                  "type": "paragraph",
                  "text": "Manual; requires an assistant or surgeon to maintain position"
                },
                {
                  "type": "paragraph",
                  "text": "Blade"
                },
                {
                  "type": "paragraph",
                  "text": "Broad, smooth and deeply curved"
                },
                {
                  "type": "paragraph",
                  "text": "Common material"
                },
                {
                  "type": "paragraph",
                  "text": "Stainless steel"
                },
                {
                  "type": "paragraph",
                  "text": "Key function"
                },
                {
                  "type": "paragraph",
                  "text": "Deep tissue and organ retraction"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "deaver_retractor_subsection_2",
          "subsection_title": "2. Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "deaver_retractor_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/deaver_retractor_03.webp",
                  "caption": null
                },
                {
                  "type": "list",
                  "title": "The main parts are:",
                  "items": [
                    {
                      "text": "Handle — the portion held by the operator; provides grip and leverage.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Shaft or neck — connects the handle to the blade and allows the blade to reach deeper operative areas.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Curved blade — the broad, smooth portion placed against tissue or an organ to retract it.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Blade tip or edge — the terminal margin of the blade; should be smooth and free of damage.",
                      "level": 0,
                      "label": "4."
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "deaver_retractor_group_4",
              "group_title": "What to point out in an OSCE",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "The blade is broad and curved, rather than narrow and pronged.",
                      "level": 0
                    },
                    {
                      "text": "Its curvature allows it to follow body contours and reach deep spaces.",
                      "level": 0
                    },
                    {
                      "text": "It has no ratchet or locking mechanism.",
                      "level": 0
                    },
                    {
                      "text": "Unlike a Volkmann retractor, it does not have multiple sharp teeth.",
                      "level": 0
                    },
                    {
                      "text": "Unlike a Langenbeck retractor, its blade is typically longer and more deeply curved.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "deaver_retractor_subsection_3",
          "subsection_title": "3. Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "deaver_retractor_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "The Deaver belongs to the following categories:",
                  "items": [
                    {
                      "text": "Retractor: separates or holds tissues away from the operative field.",
                      "level": 0
                    },
                    {
                      "text": "Handheld retractor: requires continuous manual control.",
                      "level": 0
                    },
                    {
                      "text": "Non-self-retaining retractor: does not lock itself in position.",
                      "level": 0
                    },
                    {
                      "text": "Deep retractor: designed to reach deeper operative spaces.",
                      "level": 0
                    },
                    {
                      "text": "Non-cutting instrument: its intended function is retraction, not incision.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "deaver_retractor_group_6",
              "group_title": "Design variations",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Deaver retractors may vary in:",
                  "items": [
                    {
                      "text": "Blade width and length.",
                      "level": 0
                    },
                    {
                      "text": "Degree of curvature.",
                      "level": 0
                    },
                    {
                      "text": "Overall length of the instrument.",
                      "level": 0
                    },
                    {
                      "text": "Size suited to adult or paediatric surgery.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The exact dimensions and design depend on the manufacturer and surgical specialty."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "deaver_retractor_subsection_4",
          "subsection_title": "4. Uses and clinical applications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "deaver_retractor_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/deaver_retractor_04.webp",
                  "caption": null
                },
                {
                  "type": "list",
                  "title": "The Deaver retractor is used to:",
                  "items": [
                    {
                      "text": "Retract the abdominal wall during open abdominal surgery.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Displace abdominal organs to expose deeper structures.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Improve access to the upper abdomen and subcostal operative field.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Assist exposure during pelvic operations when an appropriate size and blade shape are selected.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Hold soft tissues away from the surgical field while the operator works.",
                      "level": 0,
                      "label": "5."
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "deaver_retractor_group_8",
              "group_title": "Operations where it may be used",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Operation",
                    "Purpose of retraction"
                  ],
                  "rows": [
                    [
                      "Open cholecystectomy",
                      "Help expose the gallbladder and upper abdominal operative field"
                    ],
                    [
                      "Gastrectomy",
                      "Retract the abdominal wall or adjacent viscera to improve access"
                    ],
                    [
                      "Open splenectomy",
                      "Assist exposure of the left upper quadrant"
                    ],
                    [
                      "Open liver surgery",
                      "Help retract the abdominal wall or selected tissues"
                    ],
                    [
                      "Open nephrectomy through an abdominal approach",
                      "Assist deep exposure, depending on the operative approach"
                    ],
                    [
                      "Major open abdominal surgery",
                      "Maintain access to deeper structures"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important: The Deaver does not have one exclusive operation. Its use depends on the operative approach, anatomy, blade size and surgeon's preference."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "deaver_retractor_subsection_5",
          "subsection_title": "5. Principles of use and handling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "deaver_retractor_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/deaver_retractor_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Correct handling is essential because a broad blade can transmit substantial pressure to organs and soft tissues."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Select a blade size appropriate to the depth and operative field.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Place the curved blade carefully against the tissue intended for retraction.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Retract in the direction needed for exposure, using controlled and steady force.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Avoid placing excessive pressure on delicate organs, major vessels, nerves or compressed tissue.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Maintain communication with the operating surgeon and adjust the retractor when requested.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Release or reposition the retractor periodically when appropriate to avoid prolonged focal pressure.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Inspect the instrument for damage and ensure it is appropriately cleaned and sterilised before use.",
                      "level": 0,
                      "label": "7."
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "deaver_retractor_group_10",
              "group_title": "Why must excessive force be avoided?",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "Excessive or prolonged retraction can cause:",
                  "items": [
                    {
                      "text": "Tissue bruising and oedema.",
                      "level": 0
                    },
                    {
                      "text": "Serosal tears or injury to hollow viscera.",
                      "level": 0
                    },
                    {
                      "text": "Organ laceration.",
                      "level": 0
                    },
                    {
                      "text": "Compression of vessels, resulting in impaired perfusion.",
                      "level": 0
                    },
                    {
                      "text": "Nerve injury from sustained pressure.",
                      "level": 0
                    },
                    {
                      "text": "Postoperative pain or delayed tissue healing.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The aim is adequate exposure with the least force necessary."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "deaver_retractor_subsection_6",
          "subsection_title": "6. Advantages and disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "deaver_retractor_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Advantages",
                    "Disadvantages"
                  ],
                  "rows": [
                    [
                      "Broad blade distributes pressure over a larger area than a narrow point",
                      "Excessive force can still injure tissue"
                    ],
                    [
                      "Curved design permits access to deeper operative spaces",
                      "Requires an assistant or operator to hold it"
                    ],
                    [
                      "Available in different sizes",
                      "May occupy space in the operative field"
                    ],
                    [
                      "Useful for retracting the abdominal wall and selected organs",
                      "A blade that is too large may obstruct access or compress adjacent structures"
                    ],
                    [
                      "Smooth blade is less likely to puncture tissue than a toothed retractor",
                      "Prolonged retraction can compromise tissue perfusion"
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "deaver_retractor_subsection_7",
          "subsection_title": "7. Complications and prevention",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "deaver_retractor_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Mechanism",
                    "Prevention"
                  ],
                  "rows": [
                    [
                      "Visceral injury",
                      "Excessive force or incorrect blade placement",
                      "Identify the tissue being retracted and apply controlled force"
                    ],
                    [
                      "Tissue bruising",
                      "Sustained pressure",
                      "Avoid unnecessary pressure and reposition when appropriate"
                    ],
                    [
                      "Vascular compression",
                      "Blade compresses a vessel or its surrounding tissue",
                      "Keep critical structures under observation and avoid prolonged compression"
                    ],
                    [
                      "Nerve injury",
                      "Compression or stretching",
                      "Retract in a controlled direction and avoid trapping nerves"
                    ],
                    [
                      "Poor surgical exposure",
                      "Incorrect size or direction",
                      "Select the appropriate blade and communicate with the surgeon"
                    ],
                    [
                      "Instrument damage",
                      "Bending, corrosion or rough edges",
                      "Inspect before use and remove defective instruments from service"
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "deaver_retractor_subsection_8",
          "subsection_title": "8. Comparison with other retractors",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "deaver_retractor_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/deaver_retractor_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Deaver retractor"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Broad, deeply curved blade.",
                      "level": 0
                    },
                    {
                      "text": "Commonly used for deep abdominal retraction.",
                      "level": 0
                    },
                    {
                      "text": "Particularly useful for retracting abdominal walls and selected viscera.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/deaver_retractor_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Langenbeck retractor"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Usually has a relatively narrow, right-angled blade.",
                      "level": 0
                    },
                    {
                      "text": "Used for superficial to moderately deep wound retraction.",
                      "level": 0
                    },
                    {
                      "text": "Often used in general, orthopaedic and soft-tissue surgery.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/deaver_retractor_08.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Volkmann retractor"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Has several prongs or teeth.",
                      "level": 0
                    },
                    {
                      "text": "Used mainly for retracting skin and superficial tissues.",
                      "level": 0
                    },
                    {
                      "text": "The prongs can injure tissue if applied incorrectly.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "High-yield distinction: Deaver = broad, curved, deep retraction; Langenbeck = right-angled blade; Volkmann = pronged or rake-like blade."
                }
              ]
            }
          ]
        },
