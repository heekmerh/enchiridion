        {
          "subsection_id": "balfour_retractor_subsection_10",
          "subsection_title": "Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "balfour_retractor_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a Balfour retractor, a self-retaining abdominal surgical retractor. It consists of a supporting frame, two lateral blades and commonly a central blade, with an adjustment and locking mechanism. It is used to maintain exposure during open abdominal procedures such as laparotomy and bowel surgery. Its advantages include sustained, hands-free retraction and adjustable wound separation. Complications include pressure-related tissue injury, tissue ischaemia and injury from poorly positioned blades. Before use, I would inspect the instrument, select the appropriate size, position the blades carefully and ensure that retraction is not excessive.”"
                }
              ]
            }
