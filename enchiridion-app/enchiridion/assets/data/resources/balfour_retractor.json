      "section_id": "balfour_retractor_section_1",
      "section_title": "Balfour retractor",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "balfour_retractor_subsection_1",
          "subsection_title": "Introduction and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "balfour_retractor_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/balfour_retractor_01.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/balfour_retractor_02.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/balfour_retractor_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "The Balfour retractor is a self-retaining abdominal surgical retractor used to maintain a wide operative opening during laparotomy and other open abdominal procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Its characteristic design consists of a frame with two lateral blades that retract the abdominal wall, often with a central blade that can be used to retract deeper tissues or organs. A ratchet or screw-adjustment mechanism maintains the selected degree of separation."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“This is a Balfour self-retaining abdominal retractor. It has a supporting frame, two lateral retractor blades and commonly a detachable or adjustable central blade. It is used to maintain exposure during open abdominal surgery without requiring continuous manual holding.”"
                }
              ]
            },
            {
              "group_id": "balfour_retractor_group_2",
              "group_title": "Identification card",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Instrument class",
                    "Self-retaining abdominal retractor",
                    "Main design",
                    "Frame with two lateral blades and an optional central blade",
                    "Retraction method",
                    "Mechanical adjustment and locking",
                    "Primary specialty",
                    "General and abdominal surgery"
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "balfour_retractor_subsection_2",
          "subsection_title": "Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "balfour_retractor_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/balfour_retractor_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "The main parts to identify are:"
                },
                {
                  "type": "paragraph",
                  "text": "Supporting frame or crossbar — connects and supports the lateral blades."
                },
                {
                  "type": "paragraph",
                  "text": "Lateral blades — two opposing blades that retract the sides of the abdominal incision."
                },
                {
                  "type": "paragraph",
                  "text": "Central blade — an additional blade, often removable or adjustable, that retracts tissue or organs away from the operative field."
                },
                {
                  "type": "paragraph",
                  "text": "Adjustment mechanism — allows the distance between the lateral blades to be increased or decreased."
                },
                {
                  "type": "paragraph",
                  "text": "Locking mechanism — maintains the selected opening."
                },
                {
                  "type": "paragraph",
                  "text": "Blade attachment points — allow blades to be positioned or removed, depending on the model."
                }
              ]
            },
            {
              "group_id": "balfour_retractor_group_4",
              "group_title": "OSCE labelling tip",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "If shown a Balfour instrument, point out the two opposing lateral blades first, then the central blade, and finally the frame and adjustment mechanism."
                },
                {
                  "type": "paragraph",
                  "text": "Not every model has an identical central blade or locking design, so describe the actual instrument presented."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "balfour_retractor_subsection_3",
          "subsection_title": "Mechanism of action",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "balfour_retractor_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The Balfour retracts the abdominal wall mechanically."
                },
                {
                  "type": "paragraph",
                  "text": "The lateral blades are positioned on opposing sides of the incision."
                },
                {
                  "type": "paragraph",
                  "text": "The adjustment mechanism spreads the blades apart."
                },
                {
                  "type": "paragraph",
                  "text": "The blades hold the wound edges away from one another."
                },
                {
                  "type": "paragraph",
                  "text": "The locking mechanism maintains the selected separation."
                },
                {
                  "type": "paragraph",
                  "text": "Where fitted, the central blade provides additional retraction of tissue or viscera."
                },
                {
                  "type": "paragraph",
                  "text": "This allows sustained exposure while the surgeon performs dissection, ligation, suturing or organ manipulation."
                },
                {
                  "type": "paragraph",
                  "text": "Important: The retractor maintains the opening; it does not guarantee that the deeper operative field is free of obstruction. Blade position must be checked throughout the procedure."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "balfour_retractor_subsection_4",
          "subsection_title": "Uses and surgical applications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "balfour_retractor_group_6",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/balfour_retractor_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "The Balfour is used mainly in open abdominal surgery, particularly when a relatively wide incision must remain open."
                },
                {
                  "type": "table",
                  "columns": [
                    "Operation",
                    "Purpose"
                  ],
                  "rows": [
                    [
                      "Laparotomy",
                      "Maintains separation of abdominal wound edges"
                    ],
                    [
                      "Open bowel surgery",
                      "Provides exposure for intestinal procedures"
                    ],
                    [
                      "Colectomy",
                      "Maintains access to the abdominal operative field"
                    ],
                    [
                      "Gastrectomy",
                      "Supports exposure during gastric surgery"
                    ],
                    [
                      "Open hysterectomy via an abdominal approach",
                      "Helps maintain abdominal incision exposure"
                    ],
                    [
                      "Other major abdominal operations",
                      "Provides sustained access for prolonged procedures"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The exact configuration and blade size depend on the incision, patient anatomy and operation. A Balfour is not necessary for every laparotomy; handheld or other self-retaining retractors may be more suitable in some cases."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "balfour_retractor_subsection_5",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "balfour_retractor_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Hands-free retraction: Does not require continuous manual holding."
                },
                {
                  "type": "paragraph",
                  "text": "Sustained exposure: Maintains a relatively stable operative opening."
                },
                {
                  "type": "paragraph",
                  "text": "Wide separation: Its lateral blades can retract both sides of an abdominal incision."
                },
                {
                  "type": "paragraph",
                  "text": "Additional central retraction: The central blade can improve exposure of selected deeper structures."
                },
                {
                  "type": "paragraph",
                  "text": "Adjustability: The opening can be modified to suit the operative field."
                },
                {
                  "type": "paragraph",
                  "text": "Improved workflow: Allows the surgical team to use their hands for other essential tasks."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "balfour_retractor_subsection_6",
          "subsection_title": "Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "balfour_retractor_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Can exert excessive pressure on the abdominal wall and underlying tissues."
                },
                {
                  "type": "paragraph",
                  "text": "May obstruct the surgeon's access if the frame or central blade is poorly positioned."
                },
                {
                  "type": "paragraph",
                  "text": "Can be cumbersome in a small operative field."
                },
                {
                  "type": "paragraph",
                  "text": "Requires correct sizing and positioning."
                },
                {
                  "type": "paragraph",
                  "text": "The locking mechanism and detachable components require careful inspection and cleaning."
                },
                {
                  "type": "paragraph",
                  "text": "Prolonged pressure can compromise tissue perfusion."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "balfour_retractor_subsection_7",
          "subsection_title": "Complications and prevention",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "balfour_retractor_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Mechanism",
                    "Prevention"
                  ],
                  "rows": [
                    [
                      "Abdominal wall injury",
                      "Excessive spreading force",
                      "Increase the opening gradually and only as much as necessary"
                    ],
                    [
                      "Muscle bruising or tearing",
                      "Concentrated blade pressure",
                      "Position blades correctly and avoid excessive tension"
                    ],
                    [
                      "Tissue ischaemia",
                      "Prolonged compression",
                      "Reassess retraction and relieve unnecessary pressure"
                    ],
                    [
                      "Visceral injury",
                      "Poorly positioned central blade",
                      "Confirm the location of underlying organs before adjusting the blade"
                    ],
                    [
                      "Poor exposure",
                      "Incorrect blade size or orientation",
                      "Choose the appropriate configuration for the incision"
                    ],
                    [
                      "Sudden loss of retraction",
                      "Locking mechanism slips or fails",
                      "Inspect the mechanism and verify secure locking before use"
                    ],
                    [
                      "Injury during removal",
                      "Releasing or withdrawing the retractor abruptly",
                      "Unlock carefully and remove under controlled conditions"
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "balfour_retractor_group_10",
              "group_title": "Why is excessive opening dangerous?",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The retractor can compress tissues against the blade and surrounding structures. Sustained pressure may impair local blood flow, causing ischaemia and tissue damage. The fact that the retractor is locked in position makes continued monitoring especially important."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "balfour_retractor_subsection_8",
          "subsection_title": "Balfour versus other retractors",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "balfour_retractor_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/balfour_retractor_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Balfour retractor"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Frame with opposing lateral blades."
                },
                {
                  "type": "paragraph",
                  "text": "Commonly includes a central blade."
                },
                {
                  "type": "paragraph",
                  "text": "Primarily used to maintain exposure during open abdominal surgery."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/balfour_retractor_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Bookwalter retractor"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Frame-supported system with separately adjustable blades."
                },
                {
                  "type": "paragraph",
                  "text": "Useful for extensive abdominal and pelvic operations."
                },
                {
                  "type": "paragraph",
                  "text": "Allows flexible placement of multiple retractors around the operative field."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/balfour_retractor_08.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Deaver retractor"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Handheld, broad and deeply curved blade."
                },
                {
                  "type": "paragraph",
                  "text": "Used for deep tissue or organ retraction."
                },
                {
                  "type": "paragraph",
                  "text": "Requires an operator or assistant to maintain its position."
                },
                {
                  "type": "paragraph",
                  "text": "High-yield distinction: Balfour = self-retaining abdominal frame; Bookwalter = frame-based system with adjustable blades; Deaver = handheld curved retractor."
                }
              ]
            }
          ]
        },
