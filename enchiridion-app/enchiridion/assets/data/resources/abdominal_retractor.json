        {
          "subsection_id": "abdominal_retractor_subsection_10",
          "subsection_title": "10. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "abdominal_retractor_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is an abdominal surgical retractor, an instrument used to retract abdominal wound edges or selected intra-abdominal tissues to improve exposure during surgery. Abdominal retractors include handheld types, such as Deaver, Richardson and Morris, and self-retaining types, such as Balfour. Their uses depend on the blade design and operative depth. Potential complications include wound trauma, tissue ischaemia and injury to underlying organs. Safe use requires appropriate instrument selection, correct positioning, controlled retraction and regular reassessment of tissue pressure.”",
                  "style": "quote"
                }
              ]
            }
          ]
