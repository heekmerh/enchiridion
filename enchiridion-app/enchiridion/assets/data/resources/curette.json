      "section_id": "curette_section_1",
      "section_title": "Curette",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "curette_subsection_1",
          "subsection_title": "Overview",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "curette_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/curette_01.webp",
                  "caption": null
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "curette_subsection_2",
          "subsection_title": "Introduction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "curette_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A curette is a surgical instrument with a scoop-shaped, loop-shaped, or ring-shaped working end used to scrape, scoop, or remove tissue from a surface or cavity."
                },
                {
                  "type": "paragraph",
                  "text": "Curettes are used in several specialties, including orthopaedics, gynaecology, dermatology, ENT, dentistry, and general surgery."
                },
                {
                  "type": "paragraph",
                  "text": "The working end may be sharp or blunt, depending on the intended use and the tissue being treated."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“This is a curette, a surgical instrument with a scoop-shaped or loop-shaped working end used to scrape or remove tissue from a cavity or surface. Its specific application depends on the type of curette and the surgical specialty.”"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "curette_subsection_3",
          "subsection_title": "Labelling and identification",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "curette_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/curette_02.webp",
                  "caption": null
                },
                {
                  "type": "table",
                  "columns": [
                    "Label",
                    "Component",
                    "Function"
                  ],
                  "rows": [
                    [
                      "A",
                      "Handle",
                      "Provides grip and control"
                    ],
                    [
                      "B",
                      "Shaft",
                      "Connects the handle to the working end"
                    ],
                    [
                      "C",
                      "Curette tip or blade",
                      "Scrapes or removes tissue"
                    ],
                    [
                      "D",
                      "Scoop or loop",
                      "Collects or removes tissue from the target area"
                    ],
                    [
                      "E",
                      "Cutting edge, if present",
                      "Allows controlled scraping of tissue"
                    ],
                    [
                      "F",
                      "Opposite working end, if double-ended",
                      "May provide a different size or shape for another application"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Important: Not every curette has a loop. A bone curette may have a spoon-shaped tip, a dermatological curette may have a ring-shaped blade, and a uterine curette may have a spoon-shaped or fenestrated working end."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "curette_subsection_4",
          "subsection_title": "Properties and construction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "curette_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A curette generally has the following characteristics:"
                },
                {
                  "type": "paragraph",
                  "text": "Material: Commonly surgical-grade stainless steel; some designs are disposable."
                },
                {
                  "type": "paragraph",
                  "text": "Handle: Provides a firm grip and controlled movement."
                },
                {
                  "type": "paragraph",
                  "text": "Shaft: Straight, curved, or angled to suit the anatomical site."
                },
                {
                  "type": "paragraph",
                  "text": "Working end: Scoop-shaped, spoon-shaped, loop-shaped, or ring-shaped."
                },
                {
                  "type": "paragraph",
                  "text": "Edge: Sharp or blunt depending on the intended function."
                },
                {
                  "type": "paragraph",
                  "text": "Size: Varies according to the cavity, tissue, and procedure."
                },
                {
                  "type": "paragraph",
                  "text": "Design: Single-ended or double-ended."
                },
                {
                  "type": "paragraph",
                  "text": "Reprocessing: Reusable models require validated cleaning and sterilization; single-use models must be discarded according to the manufacturer's instructions."
                },
                {
                  "type": "paragraph",
                  "text": "The tip design determines whether the instrument is intended for firm tissue, bone, skin lesions, or endometrial tissue."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "curette_subsection_5",
          "subsection_title": "Classification and types",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "curette_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/curette_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Bone curette"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Used to scrape or remove tissue, debris, or selected pathological material from bone cavities. Volkmann curettes are a commonly encountered example."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/curette_04.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Uterine curette"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Used in selected gynaecological procedures to obtain endometrial tissue or remove tissue from the uterine cavity. Designs include sharp and blunt varieties."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/curette_05.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Dermatological curette"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Has a small loop or ring-shaped cutting edge and is used to scrape selected skin lesions."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/curette_06.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Dental or periodontal curette"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Used to remove deposits and diseased tissue from periodontal pockets and root surfaces."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/curette_07.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "5. Ear curette"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Used by trained clinicians to remove selected material, such as impacted cerumen, from the external auditory canal under appropriate visualization."
                }
              ]
            },
            {
              "group_id": "curette_group_6",
              "group_title": "Other classification methods",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Curettes may also be classified according to:"
                },
                {
                  "type": "paragraph",
                  "text": "Edge: Sharp or blunt."
                },
                {
                  "type": "paragraph",
                  "text": "Working-end shape: Spoon, scoop, loop, or ring."
                },
                {
                  "type": "paragraph",
                  "text": "Design: Single-ended or double-ended."
                },
                {
                  "type": "paragraph",
                  "text": "Use: Bone, uterine, dermatological, dental, or ENT curette."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "curette_subsection_6",
          "subsection_title": "Principle of operation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "curette_group_7",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A curette works through controlled scraping or scooping."
                },
                {
                  "type": "paragraph",
                  "text": "The correct curette is selected for the target tissue and anatomical site."
                },
                {
                  "type": "paragraph",
                  "text": "The working end is positioned against or within the target area."
                },
                {
                  "type": "paragraph",
                  "text": "A controlled scraping or scooping movement is applied."
                },
                {
                  "type": "paragraph",
                  "text": "Tissue or debris is separated and collected by the working end."
                },
                {
                  "type": "paragraph",
                  "text": "The removed material may be sent for histopathological or microbiological examination when indicated."
                },
                {
                  "type": "paragraph",
                  "text": "The cutting or scraping action depends on the geometry and sharpness of the tip."
                },
                {
                  "type": "paragraph",
                  "text": "Key principle: Use the appropriate tip and controlled pressure to remove the intended material while minimizing injury to healthy tissue."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "curette_subsection_7",
          "subsection_title": "Uses and indications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "curette_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A curette may be used to:"
                },
                {
                  "type": "paragraph",
                  "text": "Remove tissue from a cavity."
                },
                {
                  "type": "paragraph",
                  "text": "Obtain tissue samples for histopathology."
                },
                {
                  "type": "paragraph",
                  "text": "Remove selected pathological material from bone."
                },
                {
                  "type": "paragraph",
                  "text": "Scrape selected skin lesions."
                },
                {
                  "type": "paragraph",
                  "text": "Remove endometrial tissue in appropriate gynaecological procedures."
                },
                {
                  "type": "paragraph",
                  "text": "Remove deposits and diseased tissue from periodontal pockets."
                },
                {
                  "type": "paragraph",
                  "text": "Remove selected debris from an anatomical cavity."
                }
              ]
            },
            {
              "group_id": "curette_group_9",
              "group_title": "Surgeries and procedures in which it is used",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Specialty",
                    "Procedure",
                    "Purpose"
                  ],
                  "rows": [
                    [
                      "Orthopaedics",
                      "Curettage of a benign bone lesion",
                      "Remove lesion tissue from a bone cavity"
                    ],
                    [
                      "Orthopaedics",
                      "Selected bone infection procedures",
                      "Remove pathological tissue or debris as part of surgical debridement"
                    ],
                    [
                      "Gynaecology",
                      "Endometrial sampling",
                      "Obtain tissue for histopathology"
                    ],
                    [
                      "Gynaecology",
                      "Selected uterine evacuation procedures",
                      "Remove intrauterine tissue when clinically indicated"
                    ],
                    [
                      "Dermatology",
                      "Curettage of selected skin lesions",
                      "Remove abnormal superficial tissue"
                    ],
                    [
                      "Dentistry",
                      "Periodontal curettage or root instrumentation",
                      "Remove deposits and selected diseased tissue"
                    ],
                    [
                      "ENT",
                      "Earwax removal",
                      "Remove cerumen under appropriate visualization"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Clinical note: The exact procedure depends on the curette type. A uterine curette should not be confused with a bone curette, and a sharp curette must not be used indiscriminately in delicate cavities."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "curette_subsection_8",
          "subsection_title": "Advantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "curette_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Targeted tissue removal: Allows removal of material from a defined cavity or surface."
                },
                {
                  "type": "paragraph",
                  "text": "Tissue sampling: Can provide specimens for histopathological diagnosis."
                },
                {
                  "type": "paragraph",
                  "text": "Variety of designs: Different tips suit different anatomical sites."
                },
                {
                  "type": "paragraph",
                  "text": "Controlled scraping: Can remove selected pathological tissue while preserving surrounding structures."
                },
                {
                  "type": "paragraph",
                  "text": "Relatively simple handling: Many manual curettes are straightforward to manipulate."
                },
                {
                  "type": "paragraph",
                  "text": "Versatility: Used across several surgical specialties."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "curette_subsection_9",
          "subsection_title": "Disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "curette_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Sharp curettes may damage healthy tissue if used incorrectly."
                },
                {
                  "type": "paragraph",
                  "text": "Small working ends may remove only limited quantities of material at a time."
                },
                {
                  "type": "paragraph",
                  "text": "The tip may be difficult to visualize in a deep or narrow cavity."
                },
                {
                  "type": "paragraph",
                  "text": "Excessive scraping may cause bleeding or tissue perforation."
                },
                {
                  "type": "paragraph",
                  "text": "Blunt curettes may be ineffective against dense or firmly adherent tissue."
                },
                {
                  "type": "paragraph",
                  "text": "A specimen may be fragmented, potentially limiting histopathological assessment."
                },
                {
                  "type": "paragraph",
                  "text": "Some procedures require imaging, endoscopic guidance, or other methods to ensure safe and complete removal."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "curette_subsection_10",
          "subsection_title": "Complications and risks",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "curette_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Complication",
                    "Explanation"
                  ],
                  "rows": [
                    [
                      "Bleeding",
                      "Scraping may injure blood vessels in the target tissue"
                    ],
                    [
                      "Perforation",
                      "Excessive force or inappropriate technique may perforate a cavity wall, such as the uterus"
                    ],
                    [
                      "Injury to healthy tissue",
                      "The curette may remove or damage tissue beyond the intended target"
                    ],
                    [
                      "Infection",
                      "Possible following tissue disruption or inadequate aseptic technique"
                    ],
                    [
                      "Incomplete removal",
                      "Pathological tissue or debris may remain"
                    ],
                    [
                      "Specimen damage",
                      "Excessive scraping may fragment tissue and complicate pathological interpretation"
                    ],
                    [
                      "Bone damage",
                      "Excessive curettage may weaken bone or damage adjacent structures"
                    ],
                    [
                      "Injury to adjacent structures",
                      "Risk depends on the anatomical site and depth of instrumentation"
                    ]
                  ]
                }
              ]
            },
            {
              "group_id": "curette_group_13",
              "group_title": "Prevention of complications",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Select the correct curette and tip size."
                },
                {
                  "type": "paragraph",
                  "text": "Use controlled movements and appropriate force."
                },
                {
                  "type": "paragraph",
                  "text": "Maintain visualization where required."
                },
                {
                  "type": "paragraph",
                  "text": "Understand the anatomy and depth limits of the operative site."
                },
                {
                  "type": "paragraph",
                  "text": "Follow appropriate aseptic technique."
                },
                {
                  "type": "paragraph",
                  "text": "Monitor bleeding and inspect the operative field."
                },
                {
                  "type": "paragraph",
                  "text": "Send specimens for the indicated investigations."
                },
                {
                  "type": "paragraph",
                  "text": "Follow procedure-specific precautions, especially for uterine and bone curettage."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "curette_subsection_11",
          "subsection_title": "Precautions and contraindications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "curette_group_14",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "There are no universal contraindications that apply to every curette. Its use depends on the procedure and the patient's condition."
                },
                {
                  "type": "paragraph",
                  "text": "Important precautions include:"
                },
                {
                  "type": "paragraph",
                  "text": "Avoid blind, forceful scraping in delicate cavities."
                },
                {
                  "type": "paragraph",
                  "text": "Use a sharp curette only when the intended procedure requires it."
                },
                {
                  "type": "paragraph",
                  "text": "Exercise particular care during uterine curettage because perforation and haemorrhage are important risks."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid excessive removal of bone, which may weaken it."
                },
                {
                  "type": "paragraph",
                  "text": "Use appropriate visualization and guidance for anatomically sensitive sites."
                },
                {
                  "type": "paragraph",
                  "text": "Follow the relevant clinical protocol for specimen collection and infection prevention."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "curette_subsection_12",
          "subsection_title": "Care, cleaning and sterilization",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "curette_group_15",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "For reusable curettes:"
                },
                {
                  "type": "paragraph",
                  "text": "Remove gross contamination promptly after use."
                },
                {
                  "type": "paragraph",
                  "text": "Clean the tip, shaft, handle, and any grooves or recesses."
                },
                {
                  "type": "paragraph",
                  "text": "Follow the manufacturer's instructions for cleaning products and methods."
                },
                {
                  "type": "paragraph",
                  "text": "Rinse and dry thoroughly."
                },
                {
                  "type": "paragraph",
                  "text": "Inspect the working edge for dullness, deformation, corrosion, or damage."
                },
                {
                  "type": "paragraph",
                  "text": "Confirm that the shaft and handle are intact."
                },
                {
                  "type": "paragraph",
                  "text": "Sterilize using a validated method compatible with the instrument."
                },
                {
                  "type": "paragraph",
                  "text": "Single-use curettes should not be reused unless the specific product is explicitly validated and authorized for reprocessing under applicable requirements."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "curette_subsection_13",
          "subsection_title": "High-yield OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "curette_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is a curette?"
                },
                {
                  "type": "paragraph",
                  "text": "A surgical instrument with a scoop-, spoon-, loop-, or ring-shaped working end used to scrape or remove tissue from a surface or cavity."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is its principle of operation?"
                },
                {
                  "type": "paragraph",
                  "text": "Controlled scraping or scooping to separate and remove the intended material."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. Mention four types of curette."
                },
                {
                  "type": "paragraph",
                  "text": "Bone curette, uterine curette, dermatological curette, and dental or periodontal curette."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. What is a bone curette used for?"
                },
                {
                  "type": "paragraph",
                  "text": "It is used to remove selected pathological tissue, debris, or material from bone cavities, such as during curettage of a bone lesion."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What is a uterine curette used for?"
                },
                {
                  "type": "paragraph",
                  "text": "It may be used for endometrial sampling or selected uterine evacuation procedures, depending on the clinical indication and instrument type."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What is the difference between a sharp and blunt curette?"
                },
                {
                  "type": "paragraph",
                  "text": "A sharp curette has a cutting edge for scraping or excising tissue. A blunt curette has a less cutting working edge and is selected for tasks where a less aggressive scraping action is appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. Mention four complications."
                },
                {
                  "type": "paragraph",
                  "text": "Bleeding, perforation, injury to healthy tissue, and incomplete removal."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. What is curettage?"
                },
                {
                  "type": "paragraph",
                  "text": "Curettage is the removal of tissue or material from a surface or cavity using a curette."
                },
                {
                  "type": "paragraph",
                  "text": "Q9. What is the difference between a curette and a rongeur?"
                },
                {
                  "type": "paragraph",
                  "text": "A curette scrapes or scoops tissue or material, while a rongeur uses biting jaws to remove small pieces of bone."
                },
                {
                  "type": "paragraph",
                  "text": "Q10. Why might tissue obtained with a curette be sent for histopathology?"
                },
                {
                  "type": "paragraph",
                  "text": "To examine its microscopic structure and help establish or confirm a diagnosis."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "curette_subsection_14",
          "subsection_title": "OSCE examiner's checklist",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "curette_group_17",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Revision checklist",
                    "0 of 10",
                    "Correctly identifies the curette",
                    "Labels the handle, shaft and working end",
                    "Explains its scraping or scooping action",
                    "Distinguishes sharp and blunt curettes",
                    "Names at least four types",
                    "States relevant procedures for different curettes",
                    "Explains advantages and disadvantages",
                    "Identifies important complications and prevention",
                    "Describes appropriate specimen handling",
                    "Explains cleaning, inspection and sterilization"
                  ]
                }
              ]
            },
            {
              "group_id": "curette_group_18",
              "group_title": "Final high-yield summary",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Identification: Scoop-, spoon-, loop-, or ring-ended instrument used for scraping and tissue removal."
                },
                {
                  "type": "paragraph",
                  "text": "Main parts: Handle, shaft, and working tip."
                },
                {
                  "type": "paragraph",
                  "text": "Principle: Controlled scraping or scooping."
                },
                {
                  "type": "paragraph",
                  "text": "Types: Bone, uterine, dermatological, dental, and ENT curettes."
                },
                {
                  "type": "paragraph",
                  "text": "Major uses: Tissue sampling, removal of selected pathological material, and curettage."
                },
                {
                  "type": "paragraph",
                  "text": "Major risks: Bleeding, perforation, and injury to healthy tissue."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}