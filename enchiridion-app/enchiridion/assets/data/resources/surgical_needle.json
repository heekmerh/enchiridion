              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is a surgical needle used to pass suture material through tissue during wound closure, ligation and anastomosis. Its main parts are the point, body, curvature and attachment end. Surgical needles are classified by curvature, point design and attachment, including taper-point, cutting, reverse-cutting, blunt-point, spatula, eyed and swaged needles. Needle selection depends on the tissue and procedure. Complications include tissue trauma, needle breakage, suture separation and needle-stick injury.”"
                }
              ]
            }
