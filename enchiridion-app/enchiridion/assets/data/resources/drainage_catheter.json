  "sections": [
    {
      "section_id": "drainage_catheter_section_1",
      "section_title": "Drainage catheter",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "drainage_catheter_subsection_1",
          "subsection_title": "1. Introduction",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "drainage_catheter_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A drainage catheter is a hollow, flexible tube inserted into a body cavity, organ or collection of fluid to allow the removal of urine, pus, blood, bile or other fluids."
                },
                {
                  "type": "paragraph",
                  "text": "Drainage catheters may be connected to a drainage bag, collection bottle, suction system or other specialised drainage apparatus."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/drainage_catheter_01.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/drainage_catheter_02.webp",
                  "caption": null
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/drainage_catheter_03.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "OSCE identification statement:"
                },
                {
                  "type": "paragraph",
                  "text": "“This is a drainage catheter. It is a hollow tube used to drain fluid from a body cavity or organ. Its type, size and design depend on the anatomical site, the nature of the fluid and the clinical indication.”",
                  "style": "quote"
                },
                {
                  "type": "paragraph",
                  "text": "Important distinction: A drainage catheter is a broad category of device. A urinary catheter, pigtail catheter, biliary catheter and abscess drainage catheter have different designs and indications."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "drainage_catheter_subsection_2",
          "subsection_title": "2. Parts and labelling",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "drainage_catheter_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The exact parts depend on the catheter type. A typical drainage catheter may have the following components."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/drainage_catheter_04.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "regionalhealth.com.au"
                },
                {
                  "type": "table",
                  "columns": [
                    "Part",
                    "Function"
                  ],
                  "rows": [
                    [
                      "Catheter shaft",
                      "Hollow tube through which fluid drains"
                    ],
                    [
                      "Distal tip",
                      "The end placed inside the cavity or organ"
                    ],
                    [
                      "Drainage eyes/side holes",
                      "Openings that allow fluid to enter the catheter"
                    ],
                    [
                      "Lumen",
                      "Internal channel through which fluid flows"
                    ],
                    [
                      "Proximal connector",
                      "Connects to drainage tubing, a bag or a collection device"
                    ],
                    [
                      "Fixation mechanism",
                      "Helps secure the catheter in position"
                    ],
                    [
                      "Locking mechanism",
                      "Present in some pigtail catheters to retain the curled tip"
                    ],
                    [
                      "Radiopaque marker",
                      "Helps identify the catheter under imaging, when included"
                    ],
                    [
                      "Depth markings",
                      "Help assess insertion depth, when provided"
                    ],
                    [
                      "Flush port or side arm",
                      "Allows flushing in selected designs when prescribed"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Not every catheter contains all these features. Identify only the components present on the device at your station."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "drainage_catheter_subsection_3",
          "subsection_title": "3. Classification of drainage catheters",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "drainage_catheter_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Drainage catheters can be classified by the site drained, their design and their method of insertion."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/drainage_catheter_05.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "A. Urinary drainage catheter"
                },
                {
                  "type": "paragraph",
                  "text": "Used to drain urine from the bladder. Examples include Foley and intermittent urethral catheters."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/drainage_catheter_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "B. Pigtail drainage catheter"
                },
                {
                  "type": "paragraph",
                  "text": "Has a curled distal tip that helps retain the catheter in the intended cavity. Used for selected pleural, abdominal and other image-guided drainage procedures."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/drainage_catheter_06.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "C. Abscess or collection drainage catheter"
                },
                {
                  "type": "paragraph",
                  "text": "Used to drain pus or infected fluid from a localised collection, commonly under ultrasound or CT guidance."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/surgical/drainage_catheter_07.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "D. Biliary drainage catheter"
                },
                {
                  "type": "paragraph",
                  "text": "Used in selected procedures to drain bile from the biliary system, for example in obstructive disease."
                },
                {
                  "type": "paragraph",
                  "text": "Other examples include nephrostomy catheters, ureteric catheters, vascular catheters designed for aspiration, and specialised postoperative drains."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "drainage_catheter_subsection_4",
          "subsection_title": "4. Principles of drainage",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "drainage_catheter_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Drainage occurs when fluid moves from the cavity or organ into the catheter and then into a collection system."
                },
                {
                  "type": "list",
                  "title": "The mechanism may involve:",
                  "items": [
                    {
                      "text": "Gravity: The collection bag or bottle is positioned appropriately below the drainage site.",
                      "level": 0
                    },
                    {
                      "text": "Pressure difference: Fluid moves from a higher-pressure area toward a lower-pressure area.",
                      "level": 0
                    },
                    {
                      "text": "Suction: A prescribed negative pressure assists drainage in compatible systems.",
                      "level": 0
                    },
                    {
                      "text": "Capillary or passive drainage: Some systems rely on fluid movement through a specialised drain.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The correct mechanism depends on the catheter and clinical indication. Not every drainage catheter should be connected to suction."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "drainage_catheter_subsection_5",
          "subsection_title": "5. Indications and uses",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "drainage_catheter_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Clinical indication",
                    "Example"
                  ],
                  "rows": [
                    [
                      "Urinary retention",
                      "Urinary catheterisation when clinically indicated"
                    ],
                    [
                      "Localised infected collection",
                      "Image-guided abscess drainage"
                    ],
                    [
                      "Pleural fluid or selected pneumothoraces",
                      "Pleural drainage catheter"
                    ],
                    [
                      "Ascites or other selected abdominal collections",
                      "Therapeutic drainage"
                    ],
                    [
                      "Biliary obstruction",
                      "Percutaneous biliary drainage"
                    ],
                    [
                      "Urinary obstruction involving the kidney",
                      "Nephrostomy drainage"
                    ],
                    [
                      "Postoperative fluid accumulation",
                      "A surgical drain or appropriate drainage catheter"
                    ],
                    [
                      "Diagnostic sampling",
                      "Collection of fluid for microbiology, cytology or biochemical analysis where appropriate"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The indication determines the catheter design, route of insertion, required imaging and monitoring."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "drainage_catheter_subsection_6",
          "subsection_title": "6. Advantages and disadvantages",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "drainage_catheter_group_6",
              "group_title": "Advantages",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Provides continuous or intermittent drainage.",
                      "level": 0
                    },
                    {
                      "text": "Can relieve pressure and symptoms caused by fluid accumulation.",
                      "level": 0
                    },
                    {
                      "text": "May reduce the need for open surgical drainage in selected patients.",
                      "level": 0
                    },
                    {
                      "text": "Some catheters can be inserted using minimally invasive, image-guided techniques.",
                      "level": 0
                    },
                    {
                      "text": "Allows fluid measurement and sampling.",
                      "level": 0
                    },
                    {
                      "text": "Specialised designs can be secured to reduce accidental displacement.",
                      "level": 0
                    }
                  ]
                }
              ]
            },
            {
              "group_id": "drainage_catheter_group_7",
              "group_title": "Disadvantages",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Can become blocked by thick fluid, clots or debris.",
                      "level": 0
                    },
                    {
                      "text": "May become displaced or disconnected.",
                      "level": 0
                    },
                    {
                      "text": "Can introduce infection.",
                      "level": 0
                    },
                    {
                      "text": "May cause pain, bleeding or tissue injury.",
                      "level": 0
                    },
                    {
                      "text": "Some catheters require flushing, dressing changes or specialised maintenance.",
                      "level": 0
                    },
                    {
                      "text": "Incorrect placement can cause injury to nearby structures or inadequate drainage.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "drainage_catheter_subsection_7",
          "subsection_title": "7. Complications",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "drainage_catheter_group_8",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Infection"
                },
                {
                  "type": "paragraph",
                  "text": "Infection may develop at the insertion site or within the drained organ or cavity."
                },
                {
                  "type": "paragraph",
                  "text": "Bleeding"
                },
                {
                  "type": "paragraph",
                  "text": "Trauma during insertion or catheter movement may cause bleeding."
                },
                {
                  "type": "paragraph",
                  "text": "Blockage or poor drainage"
                },
                {
                  "type": "paragraph",
                  "text": "Thick secretions, clots, kinking or malposition may prevent effective drainage."
                },
                {
                  "type": "paragraph",
                  "text": "Displacement or leakage"
                },
                {
                  "type": "paragraph",
                  "text": "The catheter may move out of position, disconnect or leak around the insertion site."
                },
                {
                  "type": "paragraph",
                  "text": "Other complications include pain, skin irritation, catheter breakage, injury to adjacent organs and complications specific to the anatomical site."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "drainage_catheter_subsection_8",
          "subsection_title": "8. General principles of catheter care",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "drainage_catheter_group_9",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "title": "At an OSCE station, demonstrate or describe the following:",
                  "items": [
                    {
                      "text": "Verify the patient's identity, indication and prescribed drainage plan.",
                      "level": 0,
                      "label": "1."
                    },
                    {
                      "text": "Explain the procedure or care and obtain consent where applicable.",
                      "level": 0,
                      "label": "2."
                    },
                    {
                      "text": "Perform hand hygiene and use appropriate personal protective equipment.",
                      "level": 0,
                      "label": "3."
                    },
                    {
                      "text": "Inspect the catheter, insertion site, tubing and collection device.",
                      "level": 0,
                      "label": "4."
                    },
                    {
                      "text": "Ensure tubing is not kinked, compressed or trapped.",
                      "level": 0,
                      "label": "5."
                    },
                    {
                      "text": "Keep the collection system appropriately positioned for the catheter type.",
                      "level": 0,
                      "label": "6."
                    },
                    {
                      "text": "Maintain secure connections and use aseptic technique when handling the system.",
                      "level": 0,
                      "label": "7."
                    },
                    {
                      "text": "Measure and document drainage volume, colour, consistency and any unusual odour.",
                      "level": 0,
                      "label": "8."
                    },
                    {
                      "text": "Monitor for pain, fever, leakage, bleeding or reduced drainage.",
                      "level": 0,
                      "label": "9."
                    },
                    {
                      "text": "Escalate suspected obstruction, displacement or deterioration promptly.",
                      "level": 0,
                      "label": "10."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Safety point: Do not flush, manipulate, remove or reinsert a catheter unless the device, clinical indication and prescribed protocol permit it and you are appropriately trained."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "drainage_catheter_subsection_9",
          "subsection_title": "9. How to assess a poorly draining catheter",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "drainage_catheter_group_10",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "A common OSCE scenario is a patient whose catheter has stopped draining."
                },
                {
                  "type": "list",
                  "title": "Use a systematic approach:",
                  "items": [
                    {
                      "text": "Patient: Assess vital signs, pain, abdominal distension and other symptoms.",
                      "level": 0
                    },
                    {
                      "text": "Tubing: Look for kinks, compression, dependent loops or disconnection.",
                      "level": 0
                    },
                    {
                      "text": "Position: Check whether the collection system is correctly positioned for that catheter.",
                      "level": 0
                    },
                    {
                      "text": "Catheter: Consider blockage, displacement or malposition.",
                      "level": 0
                    },
                    {
                      "text": "Collection system: Check for a full bag, closed clamp or defective connection where relevant.",
                      "level": 0
                    },
                    {
                      "text": "Escalation: Seek prompt clinical review, especially if the patient is symptomatic or drainage stops unexpectedly.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "The appropriate response differs between a urinary catheter, a pleural drain and an abscess catheter. Never assume that all drainage catheters can be managed in the same way."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "drainage_catheter_subsection_10",
          "subsection_title": "10. Common OSCE viva questions",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "drainage_catheter_group_11",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Q1. What is a drainage catheter?"
                },
                {
                  "type": "paragraph",
                  "text": "A hollow tube inserted into an organ or cavity to remove fluid."
                },
                {
                  "type": "paragraph",
                  "text": "Q2. What is the function of drainage holes?"
                },
                {
                  "type": "paragraph",
                  "text": "They allow fluid to enter the catheter lumen."
                },
                {
                  "type": "paragraph",
                  "text": "Q3. What is a pigtail catheter?"
                },
                {
                  "type": "paragraph",
                  "text": "A catheter with a curled distal tip designed to help retain it in position within a cavity."
                },
                {
                  "type": "paragraph",
                  "text": "Q4. What are common causes of catheter blockage?"
                },
                {
                  "type": "paragraph",
                  "text": "Clots, debris, thick secretions, kinking or catheter malposition."
                },
                {
                  "type": "paragraph",
                  "text": "Q5. What findings suggest catheter-related infection?"
                },
                {
                  "type": "paragraph",
                  "text": "Fever, increasing pain, redness, warmth, purulent discharge or systemic features of infection. Their significance depends on the catheter and clinical context."
                },
                {
                  "type": "paragraph",
                  "text": "Q6. What should be documented during drainage monitoring?"
                },
                {
                  "type": "paragraph",
                  "text": "Drainage volume, appearance, insertion-site condition, patency, symptoms and any interventions."
                },
                {
                  "type": "paragraph",
                  "text": "Q7. What is the difference between a surgical drain and a drainage catheter?"
                },
                {
                  "type": "paragraph",
                  "text": "A surgical drain is a broad category of device used to evacuate fluid or air after surgery or from a cavity. A drainage catheter is a tubular device that may be inserted through a natural opening or percutaneously for drainage. The terms can overlap in clinical practice."
                },
                {
                  "type": "paragraph",
                  "text": "Q8. Why should a displaced catheter not simply be pushed back in?"
                },
                {
                  "type": "paragraph",
                  "text": "Reinsertion may introduce infection, cause tissue injury or place the catheter in the wrong location. Management depends on the device and anatomical site."
                },
                {
                  "type": "paragraph",
                  "text": "Q9. What is the difference between passive and suction drainage?"
                },
                {
                  "type": "paragraph",
                  "text": "Passive drainage relies on gravity or pressure differences, whereas suction drainage uses a controlled negative-pressure system."
                },
                {
                  "type": "paragraph",
                  "text": "Q10. What are the key nursing or clinical observations?"
                },
                {
                  "type": "paragraph",
                  "text": "Patency, output, colour, leakage, insertion-site appearance, patient symptoms and signs of infection or deterioration."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "drainage_catheter_subsection_11",
          "subsection_title": "11. High-yield revision card",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "drainage_catheter_group_12",
              "group_title": "Drainage catheter — rapid recall",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Definition: Hollow tube for removing fluid from a body cavity or organ."
                },
                {
                  "type": "paragraph",
                  "text": "Parts: Shaft, lumen, distal tip, drainage holes and proximal connector; additional features vary."
                },
                {
                  "type": "paragraph",
                  "text": "Examples: Urinary, pigtail, abscess, biliary and nephrostomy catheters."
                },
                {
                  "type": "paragraph",
                  "text": "Uses: Drainage, decompression and selected diagnostic sampling."
                },
                {
                  "type": "paragraph",
                  "text": "Complications: Infection, bleeding, blockage, displacement and tissue injury."
                },
                {
                  "type": "paragraph",
                  "text": "Safety principle: Identify the catheter type before deciding how to position, flush, clamp or manipulate it."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}