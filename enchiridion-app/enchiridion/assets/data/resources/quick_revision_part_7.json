      "section_id": "quick_revision_part_7_section_1",
      "section_title": "Part 7: Nervous system",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "quick_revision_part_7_subsection_1",
          "subsection_title": "1. Erb's Palsy",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_7_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Definition"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Upper brachial plexus palsy involving predominantly C5–C6 nerve roots.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Causes"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Birth trauma due to excessive lateral traction on the head and neck.",
                      "level": 0
                    },
                    {
                      "text": "Shoulder dystocia.",
                      "level": 0
                    },
                    {
                      "text": "Difficult vaginal delivery.",
                      "level": 0
                    },
                    {
                      "text": "Fall onto the shoulder.",
                      "level": 0
                    },
                    {
                      "text": "Motorcycle or road traffic accidents.",
                      "level": 0
                    },
                    {
                      "text": "Traction injuries to the neck.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Clinical Features"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Arm held in the waiter's tip position.",
                      "level": 0
                    },
                    {
                      "text": "Shoulder adducted and internally rotated.",
                      "level": 0
                    },
                    {
                      "text": "Elbow extended.",
                      "level": 0
                    },
                    {
                      "text": "Forearm pronated.",
                      "level": 0
                    },
                    {
                      "text": "Wrist may be flexed.",
                      "level": 0
                    },
                    {
                      "text": "Weak shoulder abduction.",
                      "level": 0
                    },
                    {
                      "text": "Weak shoulder external rotation.",
                      "level": 0
                    },
                    {
                      "text": "Weak elbow flexion.",
                      "level": 0
                    },
                    {
                      "text": "Absent or reduced biceps reflex.",
                      "level": 0
                    },
                    {
                      "text": "Absent or reduced brachioradialis reflex.",
                      "level": 0
                    },
                    {
                      "text": "Sensory loss over the lateral arm and forearm.",
                      "level": 0
                    },
                    {
                      "text": "Hand grasp usually preserved.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_7_subsection_2",
          "subsection_title": "2. Klumpke's Paralysis",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_7_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Definition"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Lower brachial plexus palsy involving predominantly C8–T1 nerve roots.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Causes"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Excessive upward traction on the arm during difficult delivery.",
                      "level": 0
                    },
                    {
                      "text": "Breech delivery with arm traction.",
                      "level": 0
                    },
                    {
                      "text": "Traction injury to the abducted arm.",
                      "level": 0
                    },
                    {
                      "text": "Fall while grasping an object.",
                      "level": 0
                    },
                    {
                      "text": "Thoracic outlet lesions.",
                      "level": 0
                    },
                    {
                      "text": "Pancoast tumour involving the lower brachial plexus.",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Clinical Features"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Claw hand deformity.",
                      "level": 0
                    },
                    {
                      "text": "Weak intrinsic hand muscles.",
                      "level": 0
                    },
                    {
                      "text": "Weak finger abduction and adduction.",
                      "level": 0
                    },
                    {
                      "text": "Weak finger flexion, particularly of the distal phalanges.",
                      "level": 0
                    },
                    {
                      "text": "Weak grip.",
                      "level": 0
                    },
                    {
                      "text": "Sensory loss along the medial forearm and hand.",
                      "level": 0
                    },
                    {
                      "text": "Horner syndrome if T1 sympathetic fibres are involved:",
                      "level": 0
                    },
                    {
                      "text": "Ptosis.",
                      "level": 1
                    },
                    {
                      "text": "Miosis.",
                      "level": 1
                    },
                    {
                      "text": "Anhidrosis.",
                      "level": 1
                    },
                    {
                      "text": "Wrist and elbow movements may be relatively preserved.",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_7_subsection_3",
          "subsection_title": "3. Causes of Motor Aphasia (Broca's Aphasia)",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_7_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Vascular:",
                      "level": 0
                    },
                    {
                      "text": "Ischaemic stroke,",
                      "level": 1
                    },
                    {
                      "text": "intracerebral haemorrhage,",
                      "level": 1
                    },
                    {
                      "text": "cerebral venous thrombosis.",
                      "level": 1
                    },
                    {
                      "text": "Traumatic:",
                      "level": 0
                    },
                    {
                      "text": "Traumatic brain injury,",
                      "level": 1
                    },
                    {
                      "text": "cerebral contusion.",
                      "level": 1
                    },
                    {
                      "text": "Neoplastic:",
                      "level": 0
                    },
                    {
                      "text": "Primary brain tumour,",
                      "level": 1
                    },
                    {
                      "text": "metastatic brain tumour.",
                      "level": 1
                    },
                    {
                      "text": "Infectious:",
                      "level": 0
                    },
                    {
                      "text": "Encephalitis,",
                      "level": 1
                    },
                    {
                      "text": "brain abscess.",
                      "level": 1
                    },
                    {
                      "text": "Degenerative:",
                      "level": 0
                    },
                    {
                      "text": "Primary progressive aphasia,",
                      "level": 1
                    },
                    {
                      "text": "frontotemporal dementia.",
                      "level": 1
                    },
                    {
                      "text": "Epileptic:",
                      "level": 0
                    },
                    {
                      "text": "Postictal aphasia,",
                      "level": 1
                    },
                    {
                      "text": "focal seizures involving language areas.",
                      "level": 1
                    },
                    {
                      "text": "Other:",
                      "level": 0
                    },
                    {
                      "text": "Neurosurgical injury,",
                      "level": 1
                    },
                    {
                      "text": "inflammatory/demyelinating lesions,",
                      "level": 1
                    },
                    {
                      "text": "cerebral vasculitis.",
                      "level": 1
                    },
                    {
                      "text": "Typical lesion:",
                      "level": 0
                    },
                    {
                      "text": "Dominant inferior frontal gyrus (Broca area; usually left hemisphere).",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_7_subsection_4",
          "subsection_title": "4. Facial Nerve (CN VII): Branches, Lesions and Features",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_7_group_4",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/quick_revision/quick_revision_part_7_01.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Intracranial branches"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Greater petrosal nerve",
                      "level": 0
                    },
                    {
                      "text": "Nerve to stapedius",
                      "level": 0
                    },
                    {
                      "text": "Chorda tympani",
                      "level": 0
                    },
                    {
                      "text": "Sensory and parasympathetic components associated with the nervus intermedius",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/quick_revision/quick_revision_part_7_02.webp",
                  "caption": null
                },
                {
                  "type": "paragraph",
                  "text": "Extracranial branches"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Posterior auricular nerve",
                      "level": 0
                    },
                    {
                      "text": "Branch to posterior belly of digastric",
                      "level": 0
                    },
                    {
                      "text": "Branch to stylohyoid",
                      "level": 0
                    },
                    {
                      "text": "Five terminal branches:",
                      "level": 0
                    },
                    {
                      "text": "Temporal",
                      "level": 1
                    },
                    {
                      "text": "Zygomatic",
                      "level": 1
                    },
                    {
                      "text": "Buccal",
                      "level": 1
                    },
                    {
                      "text": "Marginal mandibular",
                      "level": 1
                    },
                    {
                      "text": "Cervical",
                      "level": 1
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Functions"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Muscles of facial expression",
                      "level": 0
                    },
                    {
                      "text": "Stapedius muscle",
                      "level": 0
                    },
                    {
                      "text": "Taste from anterior two-thirds of tongue",
                      "level": 0
                    },
                    {
                      "text": "Lacrimation",
                      "level": 0
                    },
                    {
                      "text": "Submandibular and sublingual salivation",
                      "level": 0
                    },
                    {
                      "text": "Small area of external ear sensation",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Upper motor neuron (UMN) lesion"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Contralateral lower facial weakness",
                      "level": 0
                    },
                    {
                      "text": "Forehead relatively spared",
                      "level": 0
                    },
                    {
                      "text": "Preserved ability to wrinkle forehead",
                      "level": 0
                    },
                    {
                      "text": "Preserved forceful eye closure, usually",
                      "level": 0
                    },
                    {
                      "text": "Possible limb weakness, aphasia or other cortical signs",
                      "level": 0
                    },
                    {
                      "text": "Causes: stroke, brain tumour, traumatic brain injury, demyelination",
                      "level": 0
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Lower motor neuron (LMN) lesion"
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Ipsilateral weakness of the entire half of the face",
                      "level": 0
                    },
                    {
                      "text": "Inability to wrinkle forehead",
                      "level": 0
                    },
                    {
                      "text": "Inability to close eye tightly",
                      "level": 0
                    },
                    {
                      "text": "Flattened nasolabial fold",
                      "level": 0
                    },
                    {
                      "text": "Drooping angle of mouth",
                      "level": 0
                    },
                    {
                      "text": "Food or saliva escaping from affected side",
                      "level": 0
                    },
                    {
                      "text": "Possible hyperacusis, loss of taste and reduced lacrimation depending on lesion location",
                      "level": 0
                    },
                    {
                      "text": "Causes: Bell palsy, Ramsay Hunt syndrome, parotid tumour, temporal bone fracture, otitis media, Lyme disease, facial nerve compression",
                      "level": 0
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}