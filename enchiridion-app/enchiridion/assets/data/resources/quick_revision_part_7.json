      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "quick_revision_part_7_subsection_1",
          "subsection_title": "Erb's Palsy",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_7_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Definition",
                    "Upper brachial plexus palsy involving predominantly C5–C6 nerve roots.",
                    "Causes"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Birth trauma due to excessive lateral traction on the head and neck."
                },
                {
                  "type": "paragraph",
                  "text": "Shoulder dystocia."
                },
                {
                  "type": "paragraph",
                  "text": "Difficult vaginal delivery."
                },
                {
                  "type": "paragraph",
                  "text": "Fall onto the shoulder."
                },
                {
                  "type": "paragraph",
                  "text": "Motorcycle or road traffic accidents."
                },
                {
                  "type": "paragraph",
                  "text": "Traction injuries to the neck."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Clinical Features"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Arm held in the waiter's tip position."
                },
                {
                  "type": "paragraph",
                  "text": "Shoulder adducted and internally rotated."
                },
                {
                  "type": "paragraph",
                  "text": "Elbow extended."
                },
                {
                  "type": "paragraph",
                  "text": "Forearm pronated."
                },
                {
                  "type": "paragraph",
                  "text": "Wrist may be flexed."
                },
                {
                  "type": "paragraph",
                  "text": "Weak shoulder abduction."
                },
                {
                  "type": "paragraph",
                  "text": "Weak shoulder external rotation."
                },
                {
                  "type": "paragraph",
                  "text": "Weak elbow flexion."
                },
                {
                  "type": "paragraph",
                  "text": "Absent or reduced biceps reflex."
                },
                {
                  "type": "paragraph",
                  "text": "Absent or reduced brachioradialis reflex."
                },
                {
                  "type": "paragraph",
                  "text": "Sensory loss over the lateral arm and forearm."
                },
                {
                  "type": "paragraph",
                  "text": "Hand grasp usually preserved."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_7_subsection_2",
          "subsection_title": "Klumpke's Paralysis",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_7_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Definition",
                    "Lower brachial plexus palsy involving predominantly C8–T1 nerve roots.",
                    "Causes"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Excessive upward traction on the arm during difficult delivery."
                },
                {
                  "type": "paragraph",
                  "text": "Breech delivery with arm traction."
                },
                {
                  "type": "paragraph",
                  "text": "Traction injury to the abducted arm."
                },
                {
                  "type": "paragraph",
                  "text": "Fall while grasping an object."
                },
                {
                  "type": "paragraph",
                  "text": "Thoracic outlet lesions."
                },
                {
                  "type": "paragraph",
                  "text": "Pancoast tumour involving the lower brachial plexus."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Clinical Features"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Claw hand deformity."
                },
                {
                  "type": "paragraph",
                  "text": "Weak intrinsic hand muscles."
                },
                {
                  "type": "paragraph",
                  "text": "Weak finger abduction and adduction."
                },
                {
                  "type": "paragraph",
                  "text": "Weak finger flexion, particularly of the distal phalanges."
                },
                {
                  "type": "paragraph",
                  "text": "Weak grip."
                },
                {
                  "type": "paragraph",
                  "text": "Sensory loss along the medial forearm and hand."
                },
                {
                  "type": "paragraph",
                  "text": "Horner syndrome if T1 sympathetic fibres are involved:"
                },
                {
                  "type": "paragraph",
                  "text": "Ptosis."
                },
                {
                  "type": "paragraph",
                  "text": "Miosis."
                },
                {
                  "type": "paragraph",
                  "text": "Anhidrosis."
                },
                {
                  "type": "paragraph",
                  "text": "Wrist and elbow movements may be relatively preserved."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "quick_revision_part_7_subsection_3",
          "subsection_title": "Causes of Motor Aphasia (Broca's Aphasia)",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_7_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Vascular:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Ischaemic stroke,",
                    "intracerebral haemorrhage,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "cerebral venous thrombosis."
                },
                {
                  "type": "paragraph",
                  "text": "Traumatic:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Traumatic brain injury,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "cerebral contusion."
                },
                {
                  "type": "paragraph",
                  "text": "Neoplastic:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Primary brain tumour,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "metastatic brain tumour."
                },
                {
                  "type": "paragraph",
                  "text": "Infectious:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Encephalitis,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "brain abscess."
                },
                {
                  "type": "paragraph",
                  "text": "Degenerative:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Primary progressive aphasia,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "frontotemporal dementia."
                },
                {
                  "type": "paragraph",
                  "text": "Epileptic:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Postictal aphasia,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "focal seizures involving language areas."
                },
                {
                  "type": "paragraph",
                  "text": "Other:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Neurosurgical injury,",
                    "inflammatory/demyelinating lesions,"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "cerebral vasculitis."
                },
                {
                  "type": "paragraph",
                  "text": "Typical lesion:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Dominant inferior frontal gyrus (Broca area; usually left hemisphere)."
                  ]
                }
              ]
            }
          ]
        },
