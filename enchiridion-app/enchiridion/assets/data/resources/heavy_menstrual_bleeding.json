  "sections": [
    {
      "section_id": "heavy_menstrual_bleeding_section_1",
      "section_title": "Heavy menstrual bleeding",
      "section_order": 1,
      "subsections": [
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_1",
          "subsection_title": "What the station may say",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_1",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Scenario A — History taking"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A 34-year-old woman complains of heavy periods for eight months. Take a focused history and suggest the likely causes."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Scenario B — Management"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A 39-year-old woman has heavy regular periods, normal vital signs and a normal pelvic examination. Discuss the investigations and treatment options."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Scenario C — Anaemia"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A 31-year-old woman presents with heavy menstruation, fatigue, palpitations and dizziness. Assess her and outline your management."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Scenario D — Treatment counselling"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A 36-year-old woman with uterine fibroids wants treatment for heavy periods but hopes to become pregnant within two years. Discuss her options."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_2",
          "subsection_title": "Definition",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_2",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Heavy menstrual bleeding is menstrual blood loss that interferes with a woman's physical, emotional, social or material quality of life."
                },
                {
                  "type": "paragraph",
                  "text": "Historically, it was defined as blood loss exceeding 80 mL per menstrual cycle. However, routine clinical practice does not require precise measurement of menstrual blood volume to diagnose HMB."
                },
                {
                  "type": "paragraph",
                  "text": "Ask how bleeding affects the patient's daily activities, sleep, work, relationships and wellbeing."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_3",
          "subsection_title": "History taking: the OSCE approach",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Begin with introduction, consent, confidentiality and an open-ended question."
                },
                {
                  "type": "paragraph",
                  "text": "“Can you tell me what your periods have been like recently, and how the bleeding has been affecting you?”"
                }
              ]
            },
            {
              "group_id": "heavy_menstrual_bleeding_group_4",
              "group_title": "A. Characterise the menstrual bleeding",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Ask:"
                },
                {
                  "type": "paragraph",
                  "text": "When did the heavy periods begin?"
                },
                {
                  "type": "paragraph",
                  "text": "Are your periods regular?"
                },
                {
                  "type": "paragraph",
                  "text": "How many days does each period last?"
                },
                {
                  "type": "paragraph",
                  "text": "How often do your periods occur?"
                },
                {
                  "type": "paragraph",
                  "text": "How many pads or tampons do you use each day?"
                },
                {
                  "type": "paragraph",
                  "text": "How frequently do you need to change them?"
                },
                {
                  "type": "paragraph",
                  "text": "Do you soak through protection in an hour?"
                },
                {
                  "type": "paragraph",
                  "text": "Do you need to change protection overnight?"
                },
                {
                  "type": "paragraph",
                  "text": "Do you use double protection?"
                },
                {
                  "type": "paragraph",
                  "text": "Do you pass large blood clots?"
                },
                {
                  "type": "paragraph",
                  "text": "Have you experienced flooding through clothes or bedsheets?"
                },
                {
                  "type": "paragraph",
                  "text": "Does bleeding prevent you from working, studying, exercising or socialising?"
                },
                {
                  "type": "paragraph",
                  "text": "Clarify the difference between heavy bleeding during otherwise regular periods and irregular or intermenstrual bleeding."
                }
              ]
            },
            {
              "group_id": "heavy_menstrual_bleeding_group_5",
              "group_title": "B. Assess symptoms of anaemia",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Ask about:"
                },
                {
                  "type": "paragraph",
                  "text": "Fatigue and reduced exercise tolerance."
                },
                {
                  "type": "paragraph",
                  "text": "Dizziness or light-headedness."
                },
                {
                  "type": "paragraph",
                  "text": "Fainting."
                },
                {
                  "type": "paragraph",
                  "text": "Palpitations."
                },
                {
                  "type": "paragraph",
                  "text": "Shortness of breath, particularly on exertion."
                },
                {
                  "type": "paragraph",
                  "text": "Chest pain."
                },
                {
                  "type": "paragraph",
                  "text": "Headaches and difficulty concentrating."
                },
                {
                  "type": "paragraph",
                  "text": "Severe breathlessness at rest, chest pain, syncope or marked dizziness requires urgent assessment, especially when bleeding is ongoing."
                }
              ]
            },
            {
              "group_id": "heavy_menstrual_bleeding_group_6",
              "group_title": "C. Identify the likely cause",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Ask about:"
                },
                {
                  "type": "table",
                  "columns": [
                    "Question or finding",
                    "Possible cause"
                  ],
                  "rows": [
                    [
                      "Painful periods and a bulky, tender uterus",
                      "Adenomyosis"
                    ],
                    [
                      "Pelvic pressure and an enlarged irregular uterus",
                      "Fibroids"
                    ],
                    [
                      "Bleeding between periods",
                      "Endometrial or cervical polyp, or other pathology"
                    ],
                    [
                      "Heavy periods since menarche",
                      "Inherited bleeding disorder"
                    ],
                    [
                      "Irregular periods, acne and hirsutism",
                      "PCOS or other ovulatory dysfunction"
                    ],
                    [
                      "Easy bruising, nosebleeds or excessive surgical bleeding",
                      "Coagulopathy"
                    ],
                    [
                      "Copper IUD use",
                      "Contraception-associated heavier bleeding"
                    ],
                    [
                      "New medication or anticoagulant use",
                      "Iatrogenic bleeding"
                    ],
                    [
                      "Persistent bleeding, obesity or other endometrial cancer risk factors",
                      "Endometrial pathology requiring assessment"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Also ask about pregnancy possibility, contraception, previous pregnancies, gynaecological procedures, cervical screening where relevant and family history of bleeding disorders or gynaecological cancers."
                }
              ]
            },
            {
              "group_id": "heavy_menstrual_bleeding_group_7",
              "group_title": "D. Fertility and quality-of-life assessment",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Ask whether the patient wants children in the future, whether she wishes to retain her uterus, and which outcomes matter most to her."
                },
                {
                  "type": "paragraph",
                  "text": "For example, a patient seeking pregnancy may prefer medical treatment or myomectomy over an intervention that prevents future pregnancy."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_4",
          "subsection_title": "Examination",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_8",
              "group_title": "A. General examination",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Assess general appearance and level of consciousness."
                },
                {
                  "type": "paragraph",
                  "text": "Look for pallor of the conjunctivae and palms."
                },
                {
                  "type": "paragraph",
                  "text": "Record pulse, blood pressure, respiratory rate and other observations as clinically indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Assess peripheral perfusion and hydration."
                },
                {
                  "type": "paragraph",
                  "text": "Look for bruises or petechiae if a bleeding disorder is suspected."
                },
                {
                  "type": "paragraph",
                  "text": "Assess BMI and look for signs of hyperandrogenism or thyroid disease where relevant."
                }
              ]
            },
            {
              "group_id": "heavy_menstrual_bleeding_group_9",
              "group_title": "B. Abdominal examination",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Inspect for distension, scars and visible masses. Palpate for tenderness, an enlarged uterus or a pelvic mass."
                },
                {
                  "type": "paragraph",
                  "text": "Examples of abnormal findings:"
                },
                {
                  "type": "paragraph",
                  "text": "Firm, irregular pelvic mass: suggests uterine fibroids."
                },
                {
                  "type": "paragraph",
                  "text": "Bulky, tender uterus: may suggest adenomyosis."
                },
                {
                  "type": "paragraph",
                  "text": "Lower abdominal tenderness and fever: raises concern for pelvic infection or another acute pathology."
                },
                {
                  "type": "paragraph",
                  "text": "Marked tenderness or guarding: requires urgent assessment for acute abdominal or pelvic disease."
                }
              ]
            },
            {
              "group_id": "heavy_menstrual_bleeding_group_10",
              "group_title": "C. Pelvic examination",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Explain the procedure and obtain consent. Offer a chaperone and ensure privacy."
                },
                {
                  "type": "paragraph",
                  "text": "Speculum examination may identify cervical polyps, cervicitis, suspicious cervical lesions or another source of bleeding."
                },
                {
                  "type": "paragraph",
                  "text": "Bimanual examination assesses uterine size, shape, mobility and tenderness, as well as adnexal masses or tenderness."
                },
                {
                  "type": "paragraph",
                  "text": "An examination is not mandatory in every uncomplicated presentation. The need for it depends on symptoms, history, examination findings and whether structural disease is suspected."
                }
              ]
            },
            {
              "group_id": "heavy_menstrual_bleeding_group_11",
              "group_title": "D. How to report findings",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Example 1 — No obvious structural abnormality"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "“The patient is haemodynamically stable, with no obvious pallor. The abdomen is soft and non-tender, without palpable masses. Pelvic examination reveals a normal-sized, non-tender uterus, with no palpable adnexal masses. I would investigate for anaemia and consider medical management after excluding pregnancy and assessing the clinical history.”"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Example 2 — Suspected fibroids"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "“The patient appears pale but is currently haemodynamically stable. Abdominal and bimanual examination suggest a firm, irregularly enlarged uterus, consistent with possible uterine leiomyomas. I would request a full blood count and pelvic ultrasound and discuss treatment based on the size and location of the fibroids and the patient's fertility plans.”"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_5",
          "subsection_title": "Differential diagnoses: PALM–COEIN",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Category",
                    "Examples"
                  ],
                  "rows": [
                    [
                      "P — Polyp",
                      "Endometrial or cervical polyp"
                    ],
                    [
                      "A — Adenomyosis",
                      "Endometrial tissue within the myometrium"
                    ],
                    [
                      "L — Leiomyoma",
                      "Uterine fibroids, especially submucosal fibroids"
                    ],
                    [
                      "M — Malignancy/hyperplasia",
                      "Endometrial hyperplasia or cancer"
                    ],
                    [
                      "C — Coagulopathy",
                      "von Willebrand disease, platelet disorders"
                    ],
                    [
                      "O — Ovulatory dysfunction",
                      "PCOS, perimenopause, thyroid disorders"
                    ],
                    [
                      "E — Endometrial",
                      "Abnormal local endometrial haemostasis"
                    ],
                    [
                      "I — Iatrogenic",
                      "Copper IUD, anticoagulants, hormonal contraception"
                    ],
                    [
                      "N — Not otherwise classified",
                      "Less common causes, including uterine vascular abnormalities"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Always consider pregnancy-related bleeding when pregnancy is possible, even though it falls outside the non-pregnant AUB classification."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_6",
          "subsection_title": "Investigations",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_13",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The aim is to identify anaemia, establish the likely cause and exclude important pathology."
                },
                {
                  "type": "checklist",
                  "items": [
                    "1. Full blood count (FBC)"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "NICE recommends an FBC for all women with HMB. It assesses haemoglobin and platelet count."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/heavy_menstrual_bleeding_01.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "2. Pregnancy test"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Perform when pregnancy is possible or clinically suspected. A positive result requires a pregnancy-specific diagnostic pathway."
                },
                {
                  "type": "checklist",
                  "items": [
                    "3. Pelvic ultrasound"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Consider when the uterus is palpable abdominally, a pelvic mass is suspected, or examination is difficult or inconclusive. It is useful for assessing fibroids, adenomyosis and adnexal pathology."
                },
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/heavy_menstrual_bleeding_02.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "4. Hysteroscopy"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Particularly useful when symptoms suggest an endometrial polyp, submucosal fibroid or other intracavitary abnormality."
                }
              ]
            },
            {
              "group_id": "heavy_menstrual_bleeding_group_14",
              "group_title": "Other investigations",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Ferritin: not routinely recommended for every patient with HMB under NICE guidance, but useful when iron deficiency is suspected or needs clarification."
                },
                {
                  "type": "paragraph",
                  "text": "Coagulation testing: consider if HMB has been present since menarche and there is a personal or family history suggestive of a bleeding disorder."
                },
                {
                  "type": "paragraph",
                  "text": "Thyroid function: request when there are symptoms or signs of thyroid disease; it is not a routine test for isolated HMB."
                },
                {
                  "type": "paragraph",
                  "text": "Endometrial sampling: consider according to age, risk factors and clinical findings, particularly persistent intermenstrual or irregular bleeding, unsuccessful treatment, or suspicion of endometrial pathology. Under NICE guidance, sampling for HMB is generally performed in the context of diagnostic hysteroscopy in selected high-risk patients."
                },
                {
                  "type": "paragraph",
                  "text": "Blood group and crossmatch: when significant acute blood loss or transfusion is anticipated."
                }
              ]
            },
            {
              "group_id": "heavy_menstrual_bleeding_group_15",
              "group_title": "Interpreting common results",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Result",
                    "Interpretation and next step"
                  ],
                  "rows": [
                    [
                      "Low haemoglobin with low MCV",
                      "Suggests microcytic anaemia, commonly iron deficiency; assess iron status and treat the cause"
                    ],
                    [
                      "Normal haemoglobin despite reported HMB",
                      "Does not exclude clinically significant HMB or early iron deficiency"
                    ],
                    [
                      "Low ferritin",
                      "Supports depleted iron stores"
                    ],
                    [
                      "Submucosal fibroid on ultrasound",
                      "May explain HMB; consider hysteroscopic treatment depending on size, location and suitability"
                    ],
                    [
                      "Intracavitary polyp",
                      "Consider hysteroscopy and polypectomy when indicated"
                    ],
                    [
                      "Endometrial abnormality with risk factors",
                      "Further endometrial assessment and histology may be required"
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_7",
          "subsection_title": "Management of heavy menstrual bleeding",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_16",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The best answer in an OSCE is not simply to list medications. Start with severity, investigate the cause when indicated, then offer treatment based on contraindications and patient preferences."
                }
              ]
            },
            {
              "group_id": "heavy_menstrual_bleeding_group_17",
              "group_title": "A. Acute severe bleeding",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "If the patient is unstable or has signs of significant haemorrhage:"
                },
                {
                  "type": "paragraph",
                  "text": "Call for urgent senior and gynaecological assistance."
                },
                {
                  "type": "paragraph",
                  "text": "Assess airway, breathing and circulation."
                },
                {
                  "type": "paragraph",
                  "text": "Monitor observations and establish IV access."
                },
                {
                  "type": "paragraph",
                  "text": "Send urgent blood tests, including FBC and blood group/crossmatch as appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "Resuscitate with appropriate fluids and blood products according to clinical need and local protocol."
                },
                {
                  "type": "paragraph",
                  "text": "Exclude pregnancy-related emergencies."
                },
                {
                  "type": "paragraph",
                  "text": "Initiate specialist-directed bleeding control, using appropriate medical or procedural measures."
                },
                {
                  "type": "paragraph",
                  "text": "Do not delay emergency resuscitation while waiting for a haemoglobin result."
                }
              ]
            },
            {
              "group_id": "heavy_menstrual_bleeding_group_18",
              "group_title": "B. Stable heavy menstrual bleeding",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The main treatment options are summarised below."
                }
              ]
            },
            {
              "group_id": "heavy_menstrual_bleeding_group_19",
              "group_title": "First-line option when suitable",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "image",
                  "assetPath": "assets/resources/content/og/heavy_menstrual_bleeding_03.webp",
                  "caption": null
                },
                {
                  "type": "checklist",
                  "items": [
                    "Levonorgestrel-releasing intrauterine system (LNG-IUS)"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "NICE recommends considering this first for HMB when there is no identified pathology, fibroids smaller than 3 cm that do not distort the uterine cavity, or suspected or diagnosed adenomyosis."
                },
                {
                  "type": "paragraph",
                  "text": "Explain that irregular bleeding or spotting can occur during the first months, and the full benefit may take several cycles to develop."
                }
              ]
            },
            {
              "group_id": "heavy_menstrual_bleeding_group_20",
              "group_title": "Non-hormonal treatments",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Tranexamic acid"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Reduces menstrual blood loss and is taken during menstruation. Consider thromboembolic history, renal impairment and relevant contraindications."
                },
                {
                  "type": "checklist",
                  "items": [
                    "NSAIDs"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Ibuprofen or naproxen can reduce bleeding and menstrual pain. Avoid or use cautiously in patients with relevant renal disease, peptic ulcer disease, bleeding disorders or other contraindications."
                }
              ]
            },
            {
              "group_id": "heavy_menstrual_bleeding_group_21",
              "group_title": "Hormonal treatments",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Combined hormonal contraception"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Can reduce bleeding, regulate cycles and provide contraception. Assess blood pressure, migraine with aura, thromboembolic risk and smoking-related risks before prescribing."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Progestogen therapy"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Cyclical or other appropriate regimens may be useful, especially when ovulatory dysfunction is involved or other treatments are unsuitable."
                },
                {
                  "type": "paragraph",
                  "text": "If medical treatment is unsuitable, ineffective or unacceptable, discuss specialist assessment and procedural options."
                }
              ]
            },
            {
              "group_id": "heavy_menstrual_bleeding_group_22",
              "group_title": "C. Surgical management",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "table",
                  "columns": [
                    "Procedure",
                    "Typical role"
                  ],
                  "rows": [
                    [
                      "Hysteroscopic polypectomy",
                      "Treating symptomatic endometrial polyps"
                    ],
                    [
                      "Hysteroscopic myomectomy",
                      "Selected submucosal fibroids"
                    ],
                    [
                      "Myomectomy",
                      "Removing fibroids while preserving the uterus"
                    ],
                    [
                      "Uterine artery embolisation",
                      "Selected patients with symptomatic fibroids"
                    ],
                    [
                      "Endometrial ablation",
                      "Selected patients who do not desire future pregnancy"
                    ],
                    [
                      "Hysterectomy",
                      "Definitive treatment when appropriate after informed counselling"
                    ]
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "For fibroids 3 cm or larger, NICE recommends specialist assessment to discuss the size, number, location and available treatment options. The appropriate choice depends on the clinical situation and local expertise."
                },
                {
                  "type": "paragraph",
                  "text": "Critical fertility point: Endometrial ablation and hysterectomy are not appropriate for someone planning a future pregnancy. Myomectomy may preserve fertility in selected patients, but outcomes depend on the fibroid characteristics and individual circumstances."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_8",
          "subsection_title": "Management of iron-deficiency anaemia",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_23",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Heavy menstrual bleeding can cause iron deficiency with or without anaemia."
                }
              ]
            },
            {
              "group_id": "heavy_menstrual_bleeding_group_24",
              "group_title": "How to manage it",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Assess the severity of anaemia and whether the patient has ongoing blood loss or concerning symptoms."
                },
                {
                  "type": "paragraph",
                  "text": "Start oral iron replacement in suitable patients with iron deficiency or iron-deficiency anaemia."
                },
                {
                  "type": "paragraph",
                  "text": "Consider intravenous iron if oral iron is not tolerated, ineffective, unlikely to be absorbed adequately or too slow for the clinical situation."
                },
                {
                  "type": "paragraph",
                  "text": "Consider transfusion based on haemodynamic status, symptoms, severity of anaemia and ongoing blood loss rather than a haemoglobin number alone."
                },
                {
                  "type": "paragraph",
                  "text": "Treat the underlying cause of HMB to prevent recurrence."
                },
                {
                  "type": "paragraph",
                  "text": "Reassess symptoms and repeat the FBC as clinically appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "OSCE pearl: Giving iron without addressing persistent heavy menstrual bleeding treats the consequence, not the underlying problem."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_9",
          "subsection_title": "Counselling a patient who wants future pregnancy",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_25",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Scenario: A 36-year-old woman has heavy menstrual bleeding due to fibroids and hopes to conceive in two years."
                },
                {
                  "type": "paragraph",
                  "text": "Your counselling should include:"
                },
                {
                  "type": "paragraph",
                  "text": "Explain how fibroids may contribute to bleeding and, depending on their location, may affect fertility."
                },
                {
                  "type": "paragraph",
                  "text": "Review the ultrasound findings, particularly whether fibroids distort the uterine cavity."
                },
                {
                  "type": "paragraph",
                  "text": "Discuss medical options to control bleeding and correct anaemia."
                },
                {
                  "type": "paragraph",
                  "text": "Explain that many hormonal treatments prevent pregnancy while being used or require discontinuation before attempting conception."
                },
                {
                  "type": "paragraph",
                  "text": "Discuss myomectomy when appropriate, including surgical risks, recurrence and the possible implications for future pregnancy and delivery."
                },
                {
                  "type": "paragraph",
                  "text": "Explain that uterine artery embolisation requires careful counselling when future fertility is desired."
                },
                {
                  "type": "paragraph",
                  "text": "Avoid endometrial ablation and hysterectomy when future pregnancy is planned."
                },
                {
                  "type": "paragraph",
                  "text": "Consider referral to a fertility specialist if appropriate."
                },
                {
                  "type": "paragraph",
                  "text": "A good closing statement is:"
                },
                {
                  "type": "paragraph",
                  "text": "“I would like us to choose a treatment that controls your bleeding while protecting your future fertility as much as possible. The best option will depend on the location and size of the fibroids, your blood count and your reproductive plans.”"
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_10",
          "subsection_title": "Does every woman with HMB need a pelvic ultrasound?",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_26",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "No. NICE recommends selecting investigations according to history and examination. Ultrasound is appropriate when a pelvic mass, enlarged uterus or other relevant pathology is suspected, or when examination is inconclusive."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_11",
          "subsection_title": "Should every patient have a ferritin test?",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_27",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "No. NICE recommends an FBC for all women with HMB but does not recommend routine ferritin testing for everyone. Ferritin is useful when iron deficiency is suspected or needs clarification."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_12",
          "subsection_title": "What is the first-line medical treatment for uncomplicated HMB?",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_28",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Consider the LNG-IUS when suitable. Tranexamic acid, NSAIDs, combined hormonal contraception and progestogens are alternatives based on clinical findings, contraindications and preferences."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_13",
          "subsection_title": "What if the patient refuses hormonal treatment?",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_29",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Discuss non-hormonal options such as tranexamic acid or NSAIDs, if appropriate, and consider specialist assessment if treatment fails."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_14",
          "subsection_title": "When should you suspect a bleeding disorder?",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_30",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Particularly when HMB has been present since menarche, or when there is a personal or family history of abnormal bleeding."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_15",
          "subsection_title": "Is hysterectomy always the best definitive treatment?",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_31",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "No. It is definitive but major surgery with permanent loss of fertility and potential complications. It should follow informed discussion of alternatives, benefits and risks."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_16",
          "subsection_title": "When should a patient with HMB be urgently referred?",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_32",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "With haemodynamic instability, severe symptomatic anaemia, ongoing significant haemorrhage, suspected pregnancy complications or findings concerning for malignancy."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_17",
          "subsection_title": "Common OSCE mistakes",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_33",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Failing to distinguish chronic HMB from acute severe haemorrhage."
                },
                {
                  "type": "paragraph",
                  "text": "Forgetting pregnancy testing when indicated."
                },
                {
                  "type": "paragraph",
                  "text": "Ordering thyroid tests and ferritin routinely without considering the clinical context."
                },
                {
                  "type": "paragraph",
                  "text": "Recommending an LNG-IUS without considering uterine cavity distortion or patient preference."
                },
                {
                  "type": "paragraph",
                  "text": "Prescribing tranexamic acid without checking contraindications."
                },
                {
                  "type": "paragraph",
                  "text": "Recommending ablation to someone who wants future pregnancy."
                },
                {
                  "type": "paragraph",
                  "text": "Treating anaemia but ignoring the ongoing blood loss."
                },
                {
                  "type": "paragraph",
                  "text": "Failing to explain the benefits, risks and alternatives of surgery."
                }
              ]
            }
          ]
        },
        {
          "subsection_id": "heavy_menstrual_bleeding_subsection_18",
          "subsection_title": "Rapid revision",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "heavy_menstrual_bleeding_group_34",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "1. According to NICE, which investigation should be performed for all women with HMB?"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Serum ferritin",
                    "Full blood count",
                    "Thyroid function tests",
                    "CT pelvis"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "2. Which treatment is commonly first-line when there is no identified pathology, no significant cavity distortion and the patient is suitable?"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Hysterectomy",
                    "Endometrial ablation",
                    "LNG-IUS",
                    "Myomectomy"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "3. Which procedure is unsuitable for a patient planning future pregnancy?"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Myomectomy",
                    "Endometrial ablation",
                    "Hysteroscopic polypectomy",
                    "Iron replacement"
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}