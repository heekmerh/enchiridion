        {
          "subsection_id": "diathermy_electrocautery_subsection_16",
          "subsection_title": "15. Model OSCE presentation",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "diathermy_electrocautery_group_20",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "“This is an electrosurgical diathermy unit used for cutting tissue and achieving haemostasis during surgery. It consists of a generator, active electrode or handpiece, connecting cables, and a patient return electrode for conventional monopolar use. It may operate in monopolar or bipolar mode. Its advantages include rapid tissue dissection, haemostasis and improved operative visibility. Complications include thermal injury, burns, surgical plume exposure, fire and electromagnetic interference with implanted electronic devices. Safe use requires equipment checks, correct electrode placement, appropriate power settings and smoke evacuation.”",
                  "style": "quote"
                }
              ]
            }
