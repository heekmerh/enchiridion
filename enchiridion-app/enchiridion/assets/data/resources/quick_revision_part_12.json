        {
          "subsection_id": "quick_revision_part_12_subsection_3",
          "subsection_title": "Causes of Chronic Liver Disease (CLD)",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_12_group_3",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "V — Vascular:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Budd–Chiari syndrome,",
                    "chronic hepatic venous congestion,",
                    "chronic portal vein thrombosis"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "I — Infectious / inflammatory:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "chronic hepatitis B,",
                    "chronic hepatitis C,",
                    "autoimmune hepatitis,",
                    "chronic parasitic disease"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "N — Neoplastic:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "hepatocellular carcinoma,",
                    "hepatic infiltration by lymphoma (may coexist with or complicate CLD)"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "D — Degenerative / drug-induced:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "alcohol-associated liver disease,",
                    "drug-induced chronic liver injury,",
                    "metabolic dysfunction-associated steatotic liver disease (MASLD/MASH)"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "I — Iatrogenic / idiopathic:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "chronic drug-induced liver injury,",
                    "cryptogenic cirrhosis"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "C — Congenital:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "biliary atresia,",
                    "congenital hepatic fibrosis,",
                    "choledochal disorders"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "A — Autoimmune / allergic:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "autoimmune hepatitis,",
                    "primary biliary cholangitis,",
                    "primary sclerosing cholangitis"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "T — Traumatic:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "chronic biliary injury or stricture following trauma or surgery"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "E — Endocrine / metabolic:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "Wilson disease,",
                    "haemochromatosis,",
                    "alpha-1 antitrypsin deficiency,",
                    "glycogen storage disorders,",
                    "metabolic syndrome-associated steatohepatitis"
                  ]
                }
              ]
            }
