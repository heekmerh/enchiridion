        {
          "subsection_id": "quick_revision_part_12_subsection_5",
          "subsection_title": "Signs and Symptoms of Chronic Liver Disease (CLD)",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_12_group_5",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "checklist",
                  "items": [
                    "Symptoms"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Fatigue and weakness."
                },
                {
                  "type": "paragraph",
                  "text": "Anorexia."
                },
                {
                  "type": "paragraph",
                  "text": "Weight loss."
                },
                {
                  "type": "paragraph",
                  "text": "Nausea."
                },
                {
                  "type": "paragraph",
                  "text": "Right upper quadrant discomfort."
                },
                {
                  "type": "paragraph",
                  "text": "Abdominal distension."
                },
                {
                  "type": "paragraph",
                  "text": "Jaundice."
                },
                {
                  "type": "paragraph",
                  "text": "Pruritus."
                },
                {
                  "type": "paragraph",
                  "text": "Dark urine and pale stools (in cholestasis)."
                },
                {
                  "type": "paragraph",
                  "text": "Easy bruising or bleeding."
                },
                {
                  "type": "paragraph",
                  "text": "Peripheral oedema."
                },
                {
                  "type": "paragraph",
                  "text": "Haematemesis or melaena."
                },
                {
                  "type": "paragraph",
                  "text": "Reduced libido, amenorrhoea or erectile dysfunction."
                },
                {
                  "type": "paragraph",
                  "text": "Confusion or altered sleep pattern (hepatic encephalopathy)."
                },
                {
                  "type": "checklist",
                  "items": [
                    "General/Peripheral Signs"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Jaundice."
                },
                {
                  "type": "paragraph",
                  "text": "Muscle wasting."
                },
                {
                  "type": "paragraph",
                  "text": "Temporal wasting."
                },
                {
                  "type": "paragraph",
                  "text": "Clubbing."
                },
                {
                  "type": "paragraph",
                  "text": "Leukonychia."
                },
                {
                  "type": "paragraph",
                  "text": "Terry nails."
                },
                {
                  "type": "paragraph",
                  "text": "Palmar erythema."
                },
                {
                  "type": "paragraph",
                  "text": "Dupuytren contracture."
                },
                {
                  "type": "paragraph",
                  "text": "Easy bruising."
                },
                {
                  "type": "paragraph",
                  "text": "Spider naevi."
                },
                {
                  "type": "paragraph",
                  "text": "Scratch marks."
                },
                {
                  "type": "paragraph",
                  "text": "Loss of body hair."
                },
                {
                  "type": "paragraph",
                  "text": "Gynaecomastia."
                },
                {
                  "type": "paragraph",
                  "text": "Testicular atrophy."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Abdominal Signs"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Hepatomegaly or a small, shrunken liver."
                },
                {
                  "type": "paragraph",
                  "text": "Splenomegaly."
                },
                {
                  "type": "paragraph",
                  "text": "Ascites."
                },
                {
                  "type": "paragraph",
                  "text": "Dilated abdominal wall veins."
                },
                {
                  "type": "paragraph",
                  "text": "Caput medusae."
                },
                {
                  "type": "paragraph",
                  "text": "Umbilical hernia."
                },
                {
                  "type": "paragraph",
                  "text": "Right upper quadrant tenderness in selected cases."
                },
                {
                  "type": "checklist",
                  "items": [
                    "Features of Decompensation"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Ascites."
                },
                {
                  "type": "paragraph",
                  "text": "Variceal haemorrhage."
                },
                {
                  "type": "paragraph",
                  "text": "Hepatic encephalopathy."
                },
                {
                  "type": "paragraph",
                  "text": "Jaundice."
                },
                {
                  "type": "paragraph",
                  "text": "Spontaneous bacterial peritonitis."
                },
                {
                  "type": "paragraph",
                  "text": "Hepatorenal syndrome."
                },
                {
                  "type": "paragraph",
                  "text": "Coagulopathy."
                },
                {
                  "type": "paragraph",
                  "text": "Severe hypoalbuminaemia and peripheral oedema."
                }
              ]
            }
          ]
        },
