        {
          "subsection_id": "quick_revision_part_12_subsection_12",
          "subsection_title": "Causes of Anasarca",
          "subsection_icon": null,
          "content_groups": [
            {
              "group_id": "quick_revision_part_12_group_12",
              "group_title": "",
              "group_subtitle": null,
              "group_icon": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Definition: Generalised severe oedema involving subcutaneous tissues, often with ascites and/or pleural effusions."
                },
                {
                  "type": "paragraph",
                  "text": "V — Vascular:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "congestive heart failure,",
                    "constrictive pericarditis,",
                    "venous obstruction,",
                    "systemic capillary leak syndrome"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "I — Infectious / inflammatory:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "sepsis,",
                    "severe malaria,",
                    "glomerulonephritis,",
                    "severe systemic inflammation"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "N — Neoplastic:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "lymphoma,",
                    "leukaemia,",
                    "malignancy-associated lymphatic obstruction"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "D — Degenerative / drug-induced:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "chronic organ failure,",
                    "NSAIDs,",
                    "calcium channel blockers,",
                    "corticosteroids,",
                    "thiazolidinediones"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "I — Iatrogenic / idiopathic:"
                },
                {
                  "type": "checklist",
                  "items": [
                    "excessive IV fluid administration,",
                    "idiopathic oedema"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "C — Congenital:"
