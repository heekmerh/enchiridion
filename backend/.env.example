# Supabase Dashboard > Connect > Transaction pooler (port 6543).
# URL-encode special characters in the database password. Backend only.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Verifies Supabase Auth sessions from the website and the Android app (JWKS signing keys).
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Only for projects still on the legacy shared HS256 JWT secret.
SUPABASE_JWT_SECRET=

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production: FRONTEND_URL=https://enchiridion.site
# CORS_ORIGINS=https://enchiridion.site,https://www.enchiridion.site

# Flutterwave sandbox keys for local testing. Never expose the secret key.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# Set the actual per-book price in naira before enabling checkout.
BOOK_PRICE_NGN=10000

# Google Play: the app's applicationId and a service account with "View financial data"
# and "Manage orders and subscriptions" in Play Console (raw JSON or base64).
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Pub/Sub push authentication for Real-time Developer Notifications.
GOOGLE_RTDN_AUDIENCE=
GOOGLE_RTDN_SERVICE_ACCOUNT=

# Vercel Cron sends this as a bearer token to /api/v1/internal/jobs.
CRON_SECRET=

# SMTP is required for billing notices and consented offer emails.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=admin@enchiridion.site
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Enchiridion
